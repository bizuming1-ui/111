        self.D = (len(self.h) - 1) // 2                                                                     # 线性相位群延迟(输入采样点)
        self.zi = np.zeros(len(self.h) - 1)
        self.pos = 0                                                                                        # 已送入滤波器的输入样本总数(含 flush 的补零)

    @staticmethod
    def for_rates(native, target):
        if int(native) == int(target):
            return None
        if int(native) % int(target) != 0:
            raise ValueError("模型采样率 %s 不是目标 %s 的整数倍:拒绝启动(不做非整数倍重采样,避免变速/变调)" % (native, target))
        return StreamDecimator(int(native) // int(target))

    def _run(self, x):
        from scipy.signal import lfilter
        y, self.zi = lfilter(self.h, [1.0], x.astype(np.float64), zi=self.zi)
        lo, hi = self.pos, self.pos + len(x)
        g0 = max(lo, self.D)
        g0 += (-(g0 - self.D)) % self.m                      # 第一个满足 (g-D)%m==0 且 g>=D 的全局下标
        self.pos = hi
        if g0 >= hi:
            return np.zeros(0, np.float32)
        return y[g0 - lo::self.m].astype(np.float32)

    def process(self, x):
        x = np.asarray(x, dtype=np.float32).reshape(-1)
        return self._run(x) if x.size else np.zeros(0, np.float32)

    def flush(self):
        """补 D 个零让滤波器把尾巴吐完(总输出 = ceil(N/m))。"""
        return self._run(np.zeros(self.D, np.float32))


class FrameCoalescer:
    """把小块合并成 sched 指定的帧数(1 帧=1920 样本@24k);用完 sched 后一直用最后一个值。不拆块、不丢样本。"""

    def __init__(self, sched, spf=SPF, slack=128):
        self.sched, self.spf, self.i, self.slack = list(sched) or [8], spf, 0, int(slack)
        self.buf, self.n = [], 0

    def _need(self):
        # slack:抽取器群延迟(161 阶 → 首块少 40 样本)会让「刚好 1 个 LM 步」的首块差一点点达不到阈值,从而白等一整个 LM 步(≈160ms);留 128 样本(≈5ms)容差
        return self.sched[min(self.i, len(self.sched) - 1)] * self.spf - self.slack

    def push(self, a):
        out = []
        if a.size:
            self.buf.append(a)
            self.n += a.size
        if self.n >= self._need():
            out.append(np.concatenate(self.buf))
            self.buf, self.n = [], 0
            self.i += 1
        return out

    def flush(self):
        if self.n:
            o = [np.concatenate(self.buf)]
            self.buf, self.n = [], 0
            return o
        return []


