    p = gw.payloads[0]
    check("规划请求:非思考模式 + JSON 模式 + 小输出 + temperature=0", p.get("thinking") == {"type": "disabled"} and p.get("response_format") == {"type": "json_object"} and p["max_tokens"] <= 400 and p["temperature"] == 0, p)
    check("规划请求的 system 在 system 消息,文本不含图片", p["messages"][0]["role"] == "system" and all(isinstance(m["content"], str) for m in p["messages"]))
    # 2) LLM 想改题 → 被拒绝
    gw = FakeGW([ok_reply({"intent": "search", "normalized_query": "今日热门新闻头条汇总", "confidence": 0.9})])
    r = run(I.IntentService(gw, s, CLOCK).understand("搜索 量子计算"))
    check("LLM 改写偏离原话 → 采用规则抽取", r["normalized_query"] == "量子计算", r)
    # 3) 天气:LLM 想猜城市也无效;无城市必须澄清
    gw = FakeGW([ok_reply({"intent": "search", "normalized_query": "上海天气预报", "location": "上海", "confidence": 0.95})])
    r = run(I.IntentService(gw, mk_settings(), CLOCK).understand("帮我搜索一下今天的天气"))
    check("LLM 猜出『上海』被否决 → 仍然询问城市", r["intent"] == "clarify" and r["needs_clarification"] and not r["normalized_query"], r)
    gw = FakeGW([ok_reply({"intent": "search", "normalized_query": "x", "confidence": 0.9})])
    r = run(I.IntentService(gw, s, CLOCK).understand("帮我搜索一下今天的天气"))
    check("天气:确定性策略生成搜索词与绝对日期(LLM 只分类)", r["normalized_query"] == "西雅图天气预报" and r["absolute_date"] == "2026-11-10" and r["planner"] == "llm", r)
    # 4) 失败类型
    cases = {"no_key": None, "timeout": I.LLMError("timeout"), "rate_limited": (429, {"error": {"message": "rate"}}), "model_not_found": (404, {"error": {"message": "model not exist"}}),
             "empty": ok_reply(""), "truncated": ok_reply('{"intent":"sea', finish="length"), "bad_json": ok_reply("我觉得应该搜索天气"), "bad_schema": ok_reply({"intent": "hack"}),
             "server_error": (503, {"error": "x"}), "auth": (401, {"error": "bad key"})}
    for kind, rep in cases.items():
        if kind == "no_key":
            r = run(I.IntentService(I.LLMGateway(key=""), s, CLOCK).understand("搜索 量子计算"))
            check("缺 Key → 明确标注规则回退", r["planner"] == "rules" and r["llm"]["status"] == "unavailable" and "规则回退" in r["llm"]["zh"] and r["normalized_query"] == "量子计算", r["llm"])
            continue
        reps = [rep] * (3 if kind in ("timeout", "server_error") else 1)
        if kind == "model_not_found":
            reps = [rep, rep]
        gw = FakeGW(reps)
        r = run(I.IntentService(gw, s, CLOCK).understand("搜索 量子计算"))
        check("%s → 规则回退且搜索仍可用" % kind, r["planner"] == "rules" and r["llm"]["status"] == kind and r["normalized_query"] == "量子计算", r["llm"])
    # 5) 模型名不存在 → 自动退回 deepseek-chat(并去掉 thinking)
    gw = FakeGW([(404, {"error": {"message": "Model Not Exist"}}), ok_reply({"intent": "search", "normalized_query": "量子计算", "confidence": 0.8})])
    r = run(I.IntentService(gw, s, CLOCK).understand("搜索 量子计算"))
    check("deepseek-flash 不存在时回退 deepseek-chat 且不带 thinking", r["planner"] == "llm" and gw.payloads[1]["model"] == "deepseek-chat" and "thinking" not in gw.payloads[1], gw.payloads)
    # 6) 超时有界
    async def slow(payload, timeout):
        await asyncio.sleep(5)
    gw = FakeGW([], plan_timeout=0.5)
    gw._post = slow
    t0 = asyncio.get_event_loop_policy().new_event_loop().time()
    import time as _t
    t1 = _t.time()
    r = run(I.IntentService(gw, s, CLOCK).understand("搜索 量子计算"))
    check("规划请求有界超时(约 0.5s 内回退,不卡界面)", _t.time() - t1 < 2.0 and r["planner"] == "rules" and r["llm"]["status"] == "timeout", (round(_t.time() - t1, 2), r["llm"]))
    # 7) 熔断
    gw = FakeGW([(401, {"error": "x"})])
    run(I.IntentService(gw, s, CLOCK).understand("搜索 a"))
    r = run(I.IntentService(gw, s, CLOCK).understand("搜索 b"))
    check("Key 无效后熔断,不再反复请求", gw.calls == 1 and r["llm"]["status"] == "unavailable", (gw.calls, r["llm"]))
