import math
import os
import re

import numpy as np

SR = 24000
FRAME_S = 0.08                       # 12.5 Hz 码本:每帧 80ms


def _flag(name, default="1"):
    if os.environ.get("VC_V13", "1") in ("0", "false", "False", ""):
        return False
    return os.environ.get("VC_V13_" + name, default) not in ("0", "false", "False", "")


def on(name):
