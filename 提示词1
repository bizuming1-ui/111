    assert fp == 0, "清洁语音红色误报 %d/20" % fp


def test_injected_defects_are_detected():
    b = speech()
    x = b.copy(); x[40000] += 0.5; assert "click" in kinds(x)
    for amp in (0.08, 0.12, 0.2, 0.4):
        x = b.copy(); x[44444] += amp; assert "click" in kinds(x), amp
    x = b.copy(); x[30000:30010] = 1.0; assert "clip" in kinds(x)
    x = b.copy(); x[1000] = np.nan; assert "nan_inf" in kinds(x)
    t = np.arange(6 * SR) / SR
    tone = (0.2 * np.sin(2 * np.pi * 180 * t)).astype(np.float32); tone[50000:50200] = 0
    assert "zero_run" in kinds(tone)
    z = tone.copy(); z[:3000] = 0; z[-3000:] = 0; z[50000:50200] = 0.1 * np.sin(np.arange(200))
    assert "zero_run" not in kinds(z), "开头/结尾的零不是语音内零段"


def test_hiss_relative_to_reference_floor():
    rng = np.random.default_rng(3); n = 8 * SR; t = np.arange(n) / SR
    gate = np.convolve((np.sin(2 * np.pi * 0.8 * t) > 0).astype(float), np.ones(2400) / 2400, "same")
    voice = (0.2 * np.sin(2 * np.pi * 170 * t) * gate).astype(np.float32)
    ref = voice + rng.normal(0, 0.00008, n).astype(np.float32)
    out = voice + rng.normal(0, 0.0006, n).astype(np.float32)
    hr = v17._v16.hf_noise_metrics(ref, SR)["hf_floor_dbfs"]
    assert "hiss" in kinds(out, ref_hf_db=hr) and "hiss" not in kinds(ref, ref_hf_db=hr)
    json.dumps(v17.detect_defects(out, ref_hf_db=hr))


