  ck("检测到说话", g.state === "speaking" && g.voiced);
  const last = t;
  r = g.tick(last + 1999); ck("最后一次语音后 1999ms 不触发结束", r.action === "none");
  r = g.tick(last + 2000); ck("2000ms 触发结束(进入 ASR)", r.action === "stop" && r.reason === "silence");
})();
(function () {
  let g = mk(), t = 0, r;
  for (let i = 0; i < 6; i++) { t += 100; g.feed(0.002, t); }
  for (let i = 0; i < 4; i++) { t += 100; g.feed(0.1, t); }
  const last = t; r = null;
  for (let i = 1; i <= 15; i++) { r = g.feed(0.006, last + i * 100); }      // 持续 1.5s 的环境噪声:高于噪声底、低于迟滞下限 → 不续命
  ck("背景噪声(低于迟滞下限)不会续命", r.action === "none" && g.lastVoice === last);
  r = g.tick(last + 1999); ck("噪声下 1999ms 仍未结束", r.action === "none");
  r = g.tick(last + 2000); ck("噪声下 2000ms 准时结束", r.action === "stop" && r.reason === "silence");
})();
(function () {
  let g = mk(), t = 0, r;
  for (let i = 0; i < 4; i++) { t += 100; g.feed(0.1, t); }
  const last = t;
  g.feed(0.1, last + 1800);                                                // 1.8s 后又说话 → 重新计时
  r = g.tick(last + 1800 + 1999); ck("中途继续说话会重新计时", r.action === "none");
  r = g.tick(last + 1800 + 2000); ck("重新计时后满 2000ms 结束", r.action === "stop");
})();
(function () {
  let g = mk(), t = 0, r;
  let stopAt = null;
  for (let i = 0; i < 100; i++) { t += 100; r = g.feed(0.002, t); if (r.action === "stop") { stopAt = [t, r.reason]; break; } }
