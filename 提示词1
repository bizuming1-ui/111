    return base


def next_steps(cur, rtf, target, lo):
    """返回下一档扩散步数;None=不用再降。每次降 2 步(LM/VAE 开销不随步数缩放,所以不奢望线性提速)。"""
    if rtf is None or rtf <= target or cur <= lo:
        return None
    return max(int(lo), int(cur) - 2)


def trim_at_quiet(a, sr, max_s, win_s=2.5):
    a = np.asarray(a, dtype=np.float32)
    n = int(max_s * sr)
    if len(a) <= n:
        return a
    f = max(1, int(0.02 * sr))
    lo = max(int(1.0 * sr), n - int(win_s * sr))
    best, bi = None, n
    for s in range(lo, n - f, f // 2 or 1):
        e = float(np.sqrt(np.mean(a[s:s + f] ** 2)))
        if best is None or e < best:
            best, bi = e, s + f // 2
    out = a[:bi].copy()
    k = min(len(out), int(0.01 * sr))
    if k > 1:
        out[-k:] *= np.linspace(1, 0, k, dtype=np.float32)       # 10ms 淡出,截断点不爆音
    return out


def check_probe(a, text, sr):
    """试合成体检:返回 (ok, 原因)。a 为 float32@sr。"""
    a = np.asarray(a, dtype=np.float32).reshape(-1)
    if a.size == 0:
        return False, "没有任何音频输出"
    if not np.all(np.isfinite(a)):
        return False, "输出含 NaN/Inf(精度溢出)"
    dur = len(a) / float(sr)
    rms = float(np.sqrt(np.mean(a ** 2)))
    if dur < 0.3:
        return False, "输出过短(%.2fs)" % dur
    if rms < 0.003:
        return False, "输出几乎无声(RMS %.5f)" % rms
    n = max(1, len((text or "").strip()))
    if dur > max(4.0, 1.2 * n):
        return False, "时长 %.1fs 与文字量 %d 字严重不符(疑似失控循环)" % (dur, n)
    return True, "ok"


def patched_model_dir(src, dtype, out):
    """src=HF 快照目录;out=目标目录。config.json 复制并把 dtype 改成指定值,其余文件软链到 src。幂等;不修改 src。"""
    import shutil
    cfg = os.path.join(out, "config.json")
    if os.path.exists(cfg):
        try:
            if json.load(open(cfg, encoding="utf-8")).get("dtype") == dtype:
                return out
        except Exception:  # noqa: BLE001
            pass
    tmp = "%s.tmp%d" % (out, os.getpid())
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp, exist_ok=True)
    for name in os.listdir(src):
        p = os.path.join(src, name)
        if name == "config.json":
            c = json.load(open(p, encoding="utf-8"))
            c["dtype"] = dtype
            json.dump(c, open(os.path.join(tmp, name), "w", encoding="utf-8"), ensure_ascii=False, indent=1)
        else:
            try:
                os.symlink(os.path.realpath(p), os.path.join(tmp, name))
            except OSError:
                shutil.copy2(p, os.path.join(tmp, name))
    if os.path.exists(out):
        shutil.rmtree(out, ignore_errors=True)
    try:
        os.replace(tmp, out)
    except OSError:                                                # 另一个 worker 抢先建好了(内容相同)
        shutil.rmtree(tmp, ignore_errors=True)
    return out


def cer(ref, hyp):
    """字符错误率(去标点/空白/大小写后的 Levenshtein / len(ref));用于「试合成 → ASR 复核」。ref 为空返回 1.0。"""
    import re
    norm = lambda t: re.sub(r"[\W_]+", "", (t or "").lower(), flags=re.UNICODE)
    a, b = norm(ref), norm(hyp)
    if not a:
        return 1.0
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i]
        for j, cb in enumerate(b, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
        prev = cur
    return prev[-1] / float(len(a))


class SampleRateContext:
    """v20(M6/M7): 单一来源采样率上下文,消除硬编码采样率耦合。
