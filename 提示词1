def _estimate_rt60(x: np.ndarray, sr: int) -> float:
    """用短时能量包络的 Schroeder 后向积分衰减斜率估计混响时间 RT60(秒)。"""
    hop = max(1, int(0.010 * sr))
    n = len(x) // hop
    if n < 25:
        return 0.15
    env = np.sqrt((x[: n * hop].reshape(n, hop) ** 2).mean(axis=1) + 1e-12)
    # Find local energy release tails aftervoiced peaks
    p90 = float(np.percentile(env, 90))
    if p90 < 1e-4:
        return 0.15
    # Measure how quickly energy drops from peak windows to floor
    env_db = 20.0 * np.log10(np.maximum(env / p90, 1e-6))
    # Count autocorrelation decay time of frame energy envelope
    ac = np.correlate(env - env.mean(), env - env.mean(), mode="full")
    ac = ac[len(ac) // 2:]
    if ac[0] <= 0:
        return 0.2
    ac = ac / ac[0]
    idx = np.where(ac < 0.25)[0]
    lag_frames = int(idx[0]) if idx.size else min(40, n // 2)
    rt60 = round(float(np.clip(lag_frames * 0.025, 0.08, 2.5)), 2)
    return rt60


def _detect_multi_speaker(x: np.ndarray, sr: int) -> tuple:
    """基于有声帧谱质心与过零率的双峰分布系数(Ashman's D 近似)检测是否混入多说话人。"""
    fr = max(64, int(0.025 * sr))
    nf = len(x) // fr
    if nf < 20:
        return 0.0, False
    frames = x[: nf * fr].reshape(nf, fr)
    rms = np.sqrt((frames ** 2).mean(axis=1))
    thr = max(float(np.percentile(rms, 85)) * 0.2, 0.008)
    voiced = frames[rms >= thr]
    if len(voiced) < 16:
        return 0.0, False
    win = np.hanning(fr).astype(np.float32)
    spec = np.abs(np.fft.rfft(voiced * win, axis=1)) + 1e-9
    freqs = np.fft.rfftfreq(fr, 1.0 / sr)
    # Focus on fundamental & low-formant region (80Hz - 1200Hz)
    mask = (freqs >= 80) & (freqs <= 1200)
    if not np.any(mask):
        return 0.0, False
    sub_spec = spec[:, mask]
    sub_f = freqs[mask]
    dom_f = sub_f[np.argmax(sub_spec, axis=1)]
    # Check bimodality between low-Half and high-Half of dominant pitch/formant frequencies
    med = float(np.median(dom_f))
    lo = dom_f[dom_f <= med]
    hi = dom_f[dom_f > med]
    if len(lo) < 5 or len(hi) < 5:
        return 0.0, False
    m1, m2 = float(lo.mean()), float(hi.mean())
    s1, s2 = float(lo.std() + 8.0), float(hi.std() + 8.0)
    sep = abs(m2 - m1) / math.sqrt(0.5 * (s1 ** 2 + s2 ** 2))
    # Also require both modes have substantial separation in Hz (> 95 Hz)
    prob = float(np.clip((sep - 2.2) / 3.0, 0.0, 1.0)) if abs(m2 - m1) > 95.0 else 0.0
    return round(prob, 3), bool(prob >= 0.55)


