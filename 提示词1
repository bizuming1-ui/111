(function () {
  let g = mk(), t = 0, r; g.feed(0.0, 0);
  for (let i = 0; i < 300; i++) { t += 100; r = g.feed(i % 15 === 0 ? 0.09 : 0.03, t); if (r.action === "stop") break; }
