            lib = P.store.get(lid)
            c = next((x for x in lib["checkpoints"]["candidates"] if x["candidate_id"] == cid), None)
            if not c:
                return err("候选模型不存在", 404)
            loaded = bool(G["SEC"].get("model_sha256") == c["model_sha256"] and P.workers_ready() and G.get("TRAINED"))
            turn = next((t for t in reversed(list(G["TURN_LOG"])) if t.get("library_id") == lid and not t.get("errors") and (t.get("audio_s") or 0) > 0.8), None)
            P.store.mark_candidate(lid, cid, loaded=loaded, trial_synth=bool(loaded and turn), evidence={"verified_at": libs.now_iso(), "loaded_hash": G["SEC"].get("model_sha256"), "turn": (turn or {}).get("turn")})
            P.mark()
            msg = []
            if not loaded:
                msg.append("未加载:服务当前模型哈希与候选不一致(请用 MODE=serve + USE_TRAINED_MODEL 重启后再验证)")
            elif not turn:
                msg.append("还没有该库的真实合成记录:请在「语音克隆」页合成一句话后再点验证")
            return {"ok": True, "loaded": loaded, "trial_synth": bool(loaded and turn), "message": ";".join(msg) or "证据齐全,可以升级", "candidate": {k: c[k] for k in ("validated",)}}

