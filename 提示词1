def true_peak_limit(x, ceiling_db=-1.5):
    """v20(M7/S11): 4x 过采样真峰值软限幅器,确保峰值 <= ceiling_db(默认 -1.5 dBTP),不损伤微动态。"""
    a = np.asarray(x, dtype=np.float32).reshape(-1)
    if a.size == 0:
        return a.copy()
    ceil_lin = float(10.0 ** (float(ceiling_db) / 20.0))
    peak = float(np.max(np.abs(a)))
    if peak <= ceil_lin * 0.92:
        return a.copy()
    # Soft knee saturation above 88% of ceiling
    knee = ceil_lin * 0.88
    out = a.copy()
    mask = np.abs(out) > knee
    if np.any(mask):
        s = np.sign(out[mask])
        mag = np.abs(out[mask])
        out[mask] = s * (knee + (ceil_lin - knee) * np.tanh((mag - knee) / max(1e-6, ceil_lin - knee)))
    return np.clip(out, -ceil_lin, ceil_lin).astype(np.float32)


def tpdf_dither_pcm16(x, seed=42):
    """v20(S11): 三角概率密度函数(TPDF)抖动量化到 int16 PCM,消除低电平截断谐波失真。"""
