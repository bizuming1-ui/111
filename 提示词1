    rng = np.random.default_rng(int(seed))
    dither = (rng.random(a.size, dtype=np.float32) - rng.random(a.size, dtype=np.float32)) / 32768.0
    y = np.clip((a + dither) * 32767.0, -32768.0, 32767.0)
    return np.round(y).astype(np.int16)
