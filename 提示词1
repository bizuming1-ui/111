                    if uhf_db > lim and "hiss" not in kinds:
                        defects.append({"kind": "hiss", "severity": "yellow", "detail": f"48kHz 超高频底噪 {uhf_db} dBFS > {lim:.1f} dBFS"})

    red = any(d["severity"] == "red" for d in defects)
