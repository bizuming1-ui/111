class SoxrStreamResampler:
    """v20(M6): soxr VHQ 有状态流式重采样器(支持整数比与非整数比,如 48k→24k、44.1k→48k、44.1k→24k)。
    分块流式处理与整段处理最大偏差 <= 1e-6;若环境无 soxr 则自动降级为 StreamDecimator 或多相滤波。"""

    def __init__(self, in_sr, out_sr, quality="VHQ"):
        self.in_sr = int(in_sr)
        self.out_sr = int(out_sr)
        self.quality = str(quality or "VHQ").upper()
        self._stream = None
        self._decim = None
        self.backend = "passthrough"
        if self.in_sr == self.out_sr:
            return
        try:
            import soxr
            self._stream = soxr.ResampleStream(self.in_sr, self.out_sr, 1, dtype="float32", quality=self.quality)
            self.backend = "soxr_" + self.quality.lower()
        except Exception:
            if self.in_sr % self.out_sr == 0:
                self._decim = StreamDecimator(self.in_sr // self.out_sr)
                self.backend = "fir_decimator"
            else:
                self.backend = "scipy_poly"
                self._tail = np.zeros(0, dtype=np.float32)

    def process(self, x, last=False):
        a = np.asarray(x, dtype=np.float32).reshape(-1)
        if self.in_sr == self.out_sr:
            return a.copy()
        if self._stream is not None:
            out = self._stream.resample_chunk(a, last=bool(last)) if a.size or last else np.zeros(0, np.float32)
            return np.asarray(out, dtype=np.float32).reshape(-1)
        if self._decim is not None:
            y = self._decim.process(a)
            if last:
                t = self._decim.flush()
                if t.size:
                    y = np.concatenate([y, t]) if y.size else t
            return y
        from scipy.signal import resample_poly
        g = math.gcd(self.in_sr, self.out_sr)
        up, down = self.out_sr // g, self.in_sr // g
        return resample_poly(a, up, down).astype(np.float32) if a.size else np.zeros(0, np.float32)

    def flush(self):
        return self.process(np.zeros(0, np.float32), last=True)


def split_style_brackets(text, mode="live"):
    """v20(M8): 括号语义拆分。
    Live 通道剥离开头与句中情绪/舞台括号(绝不把括号指令念出来);
    Studio 通道提取所有风格标签并合成为 VoxCPM2 官方支持的开头风格前缀 `(style)正文`;
    遇到不成对括号时优雅容错,绝不崩溃。"""
    raw = " ".join((text or "").replace("\r", " ").replace("\n", " ").split())
    if not raw:
        return "", []
    styles = []
    # Match leading style tags first
    lead_m = _STYLE_RX.match(raw)
    rest = raw
    if lead_m:
        styles.append(lead_m.group(1).strip())
        rest = raw[lead_m.end():].lstrip()
    # Match inline style directions like (轻声)、[叹气] while preserving English/numeric parentheticals like (Apple) or (2026)
    inline_rx = re.compile(r"[(（\[【{｛]([\u4e00-\u9fff\s,，、/]{1,16})[)）\]】}｝]")
    def _inline_sub(m):
        tag = m.group(1).strip()
        if any(k in tag for k in ("开心", "难过", "悲伤", "轻声", "耳语", "温柔", "激动", "严肃", "平静", "快速", "慢速", "笑", "叹气", "停顿", "语气", "风格", "情绪", "高兴", "愤怒", "冷静")):
            styles.append(tag)
            return ""
        return m.group(0)
    cleaned = inline_rx.sub(_inline_sub, rest)
    # Strip any dangling unmatched leading/trailing brackets
    cleaned = re.sub(r"^[\s(（\[【{｛)）\]】}｝]+", "", cleaned)
    # If an unmatched opening bracket appears near the end without closing, strip the bracket char only
    for op, cl in (("(", ")"), ("（", "）"), ("[", "]"), ("【", "】"), ("{", "}"), ("｛", "｝")):
        if cleaned.count(op) != cleaned.count(cl):
            cleaned = cleaned.replace(op, "").replace(cl, "")
    cleaned = cleaned.strip()
    if str(mode).lower() == "studio" and styles and cleaned:
        merged_style = "、".join(dict.fromkeys(s for s in styles if s))
        return f"({merged_style}){cleaned}", styles
    return cleaned, styles


def resolve_step_schedule(channel, cur_steps, rtf=None, target_rtf=0.85, min_live_steps=8, studio_steps=12):
    """v20(M9/F4): 步数策略解耦。
    Studio 通道固定高步数(默认 12,绝不随 RTF 自动下调);
    Live 通道仅当 RTF > target_rtf 时按 2 步递减,且严格不低于 min_live_steps(默认 8,避免 6 步引入高频沙沙声)。"""
    ch = str(channel or "live").lower()
