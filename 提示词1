        "elapsed_s": round(time.time() - t0, 3),
        "chosen_seed": winner["seed"] if winner else None,
        "chosen_reward": winner["reward"] if winner else None,
        "audio_sha256": audio_sha,
        "preference_pair_logged": pref_logged,
        "candidates": [{k: v for k, v in c.items() if k != "_audio"} for c in candidates],
        "validation_level": "L0/L1 (沙箱客观指标与信号层证书已核验;人耳主观优劣请通过 /abx 盲测裁决)",
    }
    return {"pcm": audio_out, "certificate": cert}


# ═════════════════════════ M19 声音档案缓存与双卡指纹校验 ═════════════════════════
class PromptCacheRegistry:
    """管理 VoxCPM2 声纹冻结缓存的指纹计算、磁盘持久化及双 T4 卡间一致性校验。"""

    VERSION = "voxcpm2_cache_v20"

    def __init__(self, cache_dir: str):
        self.root = Path(cache_dir)
        self.root.mkdir(parents=True, exist_ok=True)

    @classmethod
    def compute_fingerprint(cls, model_id: str, mode: str, ref_audio_bytes: bytes, ref_text: str = "", dtype: str = "float16") -> str:
        h = hashlib.sha256()
        h.update(cls.VERSION.encode("utf-8"))
        h.update(str(model_id).encode("utf-8"))
        h.update(str(mode).encode("utf-8"))
        h.update(hashlib.sha256(ref_audio_bytes).digest())
        h.update(str(ref_text or "").strip().encode("utf-8"))
        h.update(str(dtype).encode("utf-8"))
        return h.hexdigest()

    def register(self, gpu_id: int, fingerprint: str, meta: dict) -> dict:
        rec = {
            "version": self.VERSION,
            "gpu_id": int(gpu_id),
            "fingerprint": fingerprint,
            "updated_at": round(time.time(), 3),
            "meta": meta or {},
        }
        (self.root / f"gpu_{int(gpu_id)}.json").write_text(json.dumps(rec, ensure_ascii=False, indent=2), encoding="utf-8")
        return rec

    def verify_dual_gpu_parity(self) -> dict:
        g0_p = self.root / "gpu_0.json"
        g1_p = self.root / "gpu_1.json"
        if not g0_p.exists() or not g1_p.exists():
            return {"parity": False, "reason": "至少一张 GPU 尚未登记声纹缓存指纹"}
        g0 = json.loads(g0_p.read_text(encoding="utf-8"))
        g1 = json.loads(g1_p.read_text(encoding="utf-8"))
        match = (g0.get("fingerprint") == g1.get("fingerprint")) and bool(g0.get("fingerprint"))
        return {
            "parity": match,
            "gpu0_fingerprint": g0.get("fingerprint"),
            "gpu1_fingerprint": g1.get("fingerprint"),
            "version": self.VERSION,
        }
'''

