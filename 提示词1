    def _synth_48k_waveform(text: str, seed: int = 0, temperature: float = 0.8, steps: int = 12, sr: int = 48000) -> np.ndarray:
        dur = min(8.0, max(1.2, 0.16 * max(len(text), 6)))
        n = int(sr * dur)
        t = np.arange(n, dtype=np.float64) / float(sr)
        rng = np.random.default_rng(int(seed))
        f0 = 165.0 + 18.0 * rng.random()
        # Rich harmonic speech-like carrier up to 16kHz (demonstrating 48kHz native bandwidth > 12kHz)
        sig = (
            0.20 * np.sin(2.0 * np.pi * f0 * t)
            + 0.10 * np.sin(2.0 * np.pi * (2.0 * f0) * t)
            + 0.05 * np.sin(2.0 * np.pi * (3.0 * f0) * t)
            + 0.015 * np.sin(2.0 * np.pi * 13500.0 * t)  # >12kHz air-band harmonic preserved at 48kHz
        )
        env = 0.65 + 0.35 * np.sin(2.0 * np.pi * 3.2 * t)
        y = (sig * env + rng.normal(0.0, 4e-5, n)).astype(np.float32)
        k = min(len(y) // 8, int(0.01 * sr))
        if k > 1:
            y[:k] *= np.linspace(0.0, 1.0, k, dtype=np.float32)
            y[-k:] *= np.linspace(1.0, 0.0, k, dtype=np.float32)
        return y

