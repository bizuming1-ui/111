#wb #stageWrap{flex:1;min-width:0;min-height:0;max-width:none;overflow:hidden;display:flex;border:1px solid var(--line2);border-radius:12px;background:#0c0d0e;box-shadow:none;align-items:flex-start;justify-content:flex-start}
#wb #stage{position:relative;flex:none;margin:auto;width:auto;min-width:0;line-height:0}
#wb #shot{display:block;width:100%;height:100%;min-height:0;aspect-ratio:auto;background:#fff;object-fit:fill;user-select:none}
#wb #stage.stale #shot{opacity:.5;filter:grayscale(.6)}
#wb #stage.stale::after{content:"连接中断 · 画面可能不是最新的 · 正在重连…";position:absolute;left:50%;top:12px;transform:translateX(-50%);background:rgba(70,52,20,.95);color:#f3d89b;font:13px/1.4 system-ui;padding:4px 12px;border-radius:999px}
#vmark{position:absolute;width:30px;height:30px;margin:-15px 0 0 -15px;border:3px solid #f5c15d;border-radius:50%;background:rgba(245,193,93,.25);box-shadow:0 0 0 2px rgba(0,0,0,.6);pointer-events:none}
#wbSide{width:360px;flex:none;overflow:auto;display:flex;flex-direction:column;gap:8px;min-height:0}
#wb.noside #wbSide{display:none}
.wbsec{border:1px solid var(--line);border-radius:12px;background:var(--card);padding:10px 12px}
.wbsec>summary{cursor:pointer;font-weight:600;min-height:28px}
.wbtitle{font-weight:600;margin-bottom:6px}
#wbSide .btn,#wbSide .in{min-height:44px}
#wbSide .log{max-height:34dvh}
#bstat{white-space:pre-wrap;word-break:break-word;line-height:1.55}
#wbDock>*{margin:8px 0}
#wbDock .card{max-width:none}
#wbMic.rec{background:var(--bad);color:#1b0f0d;border-color:var(--bad)}
body.wbfull>header,body.wbfull>.skip{display:none}
body.wbfull #wb{position:fixed;inset:0;z-index:90;height:100dvh}
#wb:fullscreen{height:100dvh}
@media (max-width:900px){
  body.vb{overflow:auto}
  #wb{height:auto;min-height:calc(100dvh - var(--hh,60px))}
  #wbMain{flex-direction:column}
  #wb #stageWrap{flex:none;height:min(70dvh,calc((100vw - 18px) / var(--ar,1.6)))}
  #wbSide{width:auto;overflow:visible}
  body.wbfull #wb{overflow:auto}
}
@media (prefers-reduced-motion:reduce){#wb *{transition:none!important;animation:none!important}}
</style>
