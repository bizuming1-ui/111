        @app.post("/api/libs/{lid}/refs/retrain")
        @guard
        async def api_v16_retrain(lid: str, request: Request):
            """M3 增量再优化:新样本 + 旧样本回放 + 较低学习率 + 以当前已晋升模型为父。只排队,候选模型仍须 验证+加载+试合成 三项证据才能升级。"""
            if not v16_on("INCR"):
                return err("v16 增量再优化已关闭(VC_V16_INCR=0)", 404)
            j = await body(request)
            cur, old, elig = P.store.incremental_inputs(lid)
            plan = _v16.plan_incremental(old, elig, replay_ratio=float(j.get("replay_ratio", 1.0)), base_lr=float(j.get("base_lr", _v16.envf("VC_V16_BASE_LR", 1e-4))),
                                         lr_scale=float(j.get("lr_scale", 0.4)), parent=(cur or {}).get("candidate_id"), seed=int(j.get("seed", 0)))
            view = {k: plan[k] for k in ("mode", "reason", "lr", "parent")} | {"new": len(plan["new_ids"]), "replay": len(plan["replay_ids"]), "total": len(plan["train_ids"])}
            if j.get("dry_run") or plan["mode"] == "noop":
                return {"ok": True, "enqueued": False, "plan": view, "message": "仅预览" if j.get("dry_run") else "没有新增样本,无需增量优化"}
            params = {"v16": dict(view, parent_dir=(cur or {}).get("model_dir") if plan["mode"] == "incremental" else None)}
            job = P.store.create_job(lid, params, None, set(plan["train_ids"]) if plan["mode"] == "incremental" else None)
            P.v16c.inc("incremental_plans")
            P.mark()
            P.audit.event("train_enqueue_incremental", "queued", None, sid_of(request), mode=plan["mode"])
            return {"ok": True, "enqueued": True, "plan": view, "job": {k: v for k, v in job.items() if k != "log"}}

