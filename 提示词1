/* ═════════ v8 · 星河设计系统:深灰 / 雾蓝 · 克制 · 真实状态 ═════════ */
:root{color-scheme:dark;--bg:#141517;--bg2:#191a1d;--card:#1d1e22;--card2:#24262b;--line:#2e3036;--line2:#3b3e46;--fg:#ececef;--mut:#9b9ea8;--acc:#9cc4d6;--accfg:#0d1418;--ok:#7fd1a6;--warn:#e6b96a;--bad:#f09186;--sh:0 10px 40px rgba(0,0,0,.45);--r:14px;--ease:cubic-bezier(.2,.7,.2,1)}
