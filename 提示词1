                "sr": sr,
            }
            with open(pref_log_path, "a", encoding="utf-8") as f:
                f.write(json.dumps(pair_rec, ensure_ascii=False) + "\n")
            pref_logged = True

    audio_out = winner["_audio"] if winner is not None else None
    audio_sha = hashlib.sha256(audio_out.tobytes()).hexdigest() if audio_out is not None else None
    cert = {
