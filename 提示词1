def dtype_order(major, force=""):
    base = ["bfloat16", "float16", "float32"] if int(major) >= 8 else ["float16", "float32", "bfloat16"]
    f = (force or "").strip().lower()
    f = {"fp16": "float16", "bf16": "bfloat16", "fp32": "float32"}.get(f, f)
    if f in base:
        base.remove(f)
