def measure_lufs(x, sr):
    """集成响度(LUFS,ITU-R BS.1770 K 加权)。pyloudnorm 可用 → 真值;不可用 → 返回 (None, 'pyloudnorm 不可用'),绝不用 RMS 冒充。"""
    try:
        import pyloudnorm as pyln
    except Exception:  # noqa: BLE001
        return None, "pyloudnorm 不可用"
    a = np.asarray(x, dtype=np.float64).reshape(-1)
    if a.size < int(0.5 * sr) + 1:
        return None, "音频短于 0.5 秒,BS.1770 不适用"
    try:
        v = float(pyln.Meter(int(sr)).integrated_loudness(a))
    except Exception as e:  # noqa: BLE001
        return None, "%s: %s" % (type(e).__name__, str(e)[:60])
    return (v if np.isfinite(v) else None), ("" if np.isfinite(v) else "静音")


