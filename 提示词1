def preprocess_policy_engine(x, sr: int, eval_fn=None, enabled: bool = None) -> dict:
    """M12: 预处理策略引擎。
    - 默认保真: enabled=False (或 VC_V20_PREPROC=0) 时返回与原件逐样本一致的副本。
    - 当开启且体检发现 dc / noisy / low_snr 时,生成零相位去直流 + 轻度频谱底噪门限候选;
      必须通过 eval_fn 的 A/B 不降级闸门(SIM 不降 >0.005、UTMOS 不降、缺陷不增)才采用,否则退回原件。"""
    orig = np.asarray(x, dtype=np.float32).copy()
    if enabled is None:
        enabled = os.environ.get("VC_V20_PREPROC", "0") == "1"
    health = ref_health_v20(orig, int(sr))
    if not enabled:
        return {
            "audio": orig,
            "adopted": False,
            "policy": "passthrough_disabled",
            "health": health,
            "gate_report": None,
        }

    triggers = set(health["flags"]) & {"dc", "noisy", "low_snr"}
    if not triggers:
        return {
            "audio": orig,
            "adopted": False,
            "policy": "clean_keep_original",
            "health": health,
            "gate_report": None,
        }

    # Generate candidate without touching orig
    cand = orig - float(orig.mean())
    if "noisy" in triggers or "low_snr" in triggers:
        # Gentle frame-level spectral expansion on quiet frames only
        fr = max(64, int(0.010 * sr))
        n = len(cand) // fr
        if n >= 4:
            frames = cand[: n * fr].reshape(n, fr)
            rms = np.sqrt((frames ** 2).mean(axis=1, keepdims=True) + 1e-12)
            floor_thr = float(np.percentile(rms, 20)) * 1.35
            gain = np.where(rms < floor_thr, np.clip((rms / max(floor_thr, 1e-6)) ** 0.6, 0.25, 1.0), 1.0)
            cand[: n * fr] = (frames * gain).reshape(-1)
    # 5ms edge fade
    k = min(len(cand) // 4, int(0.005 * sr))
    if k > 1:
        cand[:k] *= np.linspace(0.0, 1.0, k, dtype=np.float32)
        cand[-k:] *= np.linspace(1.0, 0.0, k, dtype=np.float32)

    if eval_fn is None:
        return {
            "audio": orig,
            "adopted": False,
            "policy": "rejected_no_ab_evaluator",
            "health": health,
            "gate_report": {"passed": False, "reason": "未提供 A/B 评估器,按保真原则保留原件"},
        }

    m_orig = eval_fn(orig)
    m_cand = eval_fn(cand)
    sim_ok = (m_cand.get("sim", 0.0) - m_orig.get("sim", 0.0)) >= -0.005
    mos_ok = (m_cand.get("utmos", 0.0) - m_orig.get("utmos", 0.0)) >= 0.0
    def_ok = m_cand.get("defect_score", 999.0) <= m_orig.get("defect_score", 999.0)
    passed = bool(sim_ok and mos_ok and def_ok and (
        m_cand.get("utmos", 0.0) > m_orig.get("utmos", 0.0) + 0.02
        or m_cand.get("defect_score", 0.0) < m_orig.get("defect_score", 0.0)
        or abs(orig.mean()) > 0.01
    ))
    return {
        "audio": cand if passed else orig,
        "adopted": passed,
        "policy": "adopted_ab_verified" if passed else "fallback_to_original",
        "health": health,
        "gate_report": {
            "passed": passed,
            "orig_metrics": m_orig,
            "cand_metrics": m_cand,
            "triggers": sorted(triggers),
        },
    }


def mmr_select_clustered(segments: list, max_total_s: float = 20.0, max_k: int = 6, lam: float = 0.7, min_quality: float = 50.0, seed: int = 0) -> dict:
    """M13: 同录音条件聚类 + MMR 参考选段器。
    1. 不足 2 条有效片段时自动退回最佳单条;
    2. 先按录音环境特征(snr_db, hf_floor_dbfs, session/cluster)聚类,选质量最高的同条件簇,避免混用不同麦克风;
    3. 在最优簇内用固定种子 MMR 选出总时长 <= max_total_s(默认 20s)的代表性片段。"""
    valid = [dict(s) for s in (segments or []) if float(s.get("quality", 0.0)) >= min_quality and float(s.get("seconds", 0.0)) > 0.3]
    if not valid:
        return {"selected": [], "ids": [], "seconds": 0.0, "mode": "empty", "cluster_id": None}
    if len(valid) == 1:
        s0 = valid[0]
        if float(s0["seconds"]) <= max_total_s:
            return {"selected": [s0], "ids": [s0["id"]], "seconds": round(float(s0["seconds"]), 3), "mode": "single_fallback", "cluster_id": s0.get("cluster", "default")}

    # Group by explicit cluster or acoustic environment bucket (SNR & HF noise floor bucket)
    buckets = {}
    for s in valid:
        cid = s.get("cluster")
        if not cid:
            snr_b = int(round(float(s.get("snr_db", 30.0)) / 8.0))
            hf_b = int(round(float(s.get("hf_floor_dbfs", -65.0)) / 8.0))
            cid = f"env_{snr_b}_{hf_b}"
        s["_cid"] = cid
        buckets.setdefault(cid, []).append(s)

    # Pick cluster with highest top-3 average quality
    best_cid = max(
        buckets.keys(),
        key=lambda k: (
            np.mean(sorted([ float(x.get("quality", 0.0)) for x in buckets[k] ], reverse=True)[:3]),
            len(buckets[k]),
            str(k),
        ),
    )
    pool = buckets[best_cid]
    by_id = {}
    for x in pool:
        x["cond"] = best_cid
        by_id[x["id"]] = x
    ids = _v17.mmr_select(pool, max_total_s=max_total_s, max_k=max_k, lam=lam, min_quality=min_quality, seed=seed, cluster=best_cid)
    sel = [by_id[i] for i in ids if i in by_id]
    secs = round(sum(float(x.get("seconds", 0.0)) for x in sel), 3)
    return {
        "selected": sel,
        "ids": ids,
        "seconds": secs,
        "mode": "single_fallback" if len(ids) == 1 else "mmr_composite",
        "cluster_id": best_cid,
        "clusters_found": len(buckets),
    }


def detect_defects_48k(pcm, sr: int = 48000, ref_hf_db: float = None) -> dict:
    """M17: 面向 48kHz / 24kHz 双采样率重标定的客观缺陷检测器。
    对 NaN/Inf、削波、数字零段、click/pop、真峰值、DC 偏移、高频沙沙声(48kHz 下额外检测 10k~20kHz 异常底噪)、块间台阶全部精准召回。"""
    sr = int(sr)
    x = _v17.to_float(pcm)
    base = _v17.detect_defects(x, sr=sr, ref_hf_db=ref_hf_db)
    defects = list(base.get("defects", []))
    metrics = dict(base.get("metrics", {}))
    kinds = {d["kind"] for d in defects}

    # At 48kHz, check ultra-high band (10kHz - 20kHz) quiet-frame hiss specifically
    if sr >= 44100 and len(x) >= sr // 2 and np.all(np.isfinite(x)):
        fr = int(0.020 * sr)
        nf = len(x) // fr
        if nf >= 8:
            frames = x[: nf * fr].reshape(nf, fr)
            rms = np.sqrt((frames ** 2).mean(axis=1))
            quiet = frames[rms <= np.percentile(rms, 25)]
            if len(quiet) >= 2:
                sp = (np.abs(np.fft.rfft(quiet * np.hanning(fr), axis=1)) ** 2).mean(axis=0) / (fr ** 2)
                freqs = np.fft.rfftfreq(fr, 1.0 / sr)
                uhf = sp[(freqs >= 10000) & (freqs <= 20000)]
                if uhf.size:
                    uhf_db = round(10.0 * math.log10(max(float(uhf.mean()), 1e-18)), 2)
                    metrics["uhf_10k_20k_dbfs"] = uhf_db
