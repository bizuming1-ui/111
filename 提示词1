        from scipy.signal import resample_poly
        g = gcd(16000, int(sr))
        a = resample_poly(a, 16000 // g, int(sr) // g).astype(np.float32)
    a = a - float(np.mean(a))
    pk = float(np.max(np.abs(a))) if len(a) else 0.0
