/* /monitor: 训练进度 + GPU 利用率(WebSocket) */
function monitor() {
  let w; try { w = new WebSocket((location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/monitor"); } catch (e) { return; }
  w.onmessage = (e) => {
    let m; try { m = JSON.parse(e.data); } catch (_) { return; }
    if (m.event === "train_progress" && m.status && m.status !== "idle") {
      $("pTrain").style.display = ""; $("tTrain").textContent = (m.status === "finished" ? "完成 " : "第 " + (m.epoch ?? "?") + " 轮 ") + (m.val_loss != null ? "· val_loss " + (+m.val_loss).toFixed(3) : "");
    }
  };
  w.onclose = () => setTimeout(monitor, 5000);
  setInterval(() => { try { if (w.readyState === 1) w.send(JSON.stringify({ type: "ping" })); } catch (_) {} }, HEARTBEAT_INTERVAL);
}

