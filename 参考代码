def load_calibration(paths):
    """calibration.json: {"method":"logistic","a":..,"b":..,"n_pos":..,"n_neg":..,"auc":..,"condition":"speech","model":"microsoft/wavlm-base-plus-sv","note":"…"}
    必须来自【独立、代表目标场景的标注评测数据】。没有文件 = 未校准。"""
    for p in paths:
        try:
            if p and Path(p).exists():
                c = json.loads(Path(p).read_text(encoding="utf-8"))
                if c.get("method") == "logistic" and "a" in c and "b" in c and int(c.get("n_pos", 0)) + int(c.get("n_neg", 0)) >= 40:
                    c["_path"] = str(p)
                    return c
        except Exception:  # noqa: BLE001
            pass
    return None


def similarity_view(raw, model, cal=None, condition="speech"):
    v = {"raw_cosine": None if raw is None else round(float(raw), 4), "model": model, "range": [-1.0, 1.0], "condition": condition,
         "calibrated": False, "label": "未校准:仅为原始声纹余弦,不能换算成人耳相似度百分比", "probability": None}
    if raw is not None and cal and cal.get("condition", "speech") == condition:
        p = 1.0 / (1.0 + math.exp(-(float(cal["a"]) * float(raw) + float(cal["b"]))))
