def day_offset(t):
    if re.search(r"后天", t or ""):
        return 2
    if re.search(r"明天|明日|明早", t or ""):
        return 1
    return 0


_EN = {"西雅图": "Seattle", "纽约": "New York", "洛杉矶": "Los Angeles", "旧金山": "San Francisco", "芝加哥": "Chicago", "波士顿": "Boston", "华盛顿": "Washington DC", "伦敦": "London", "巴黎": "Paris",
