            self.stats["hit"] += 1
            return {"ok": True, "engine": eng, "items": hit[1], "cache": True, "age_s": int(now - hit[0])}
        if key in self.inflight:
            return await self.inflight[key]
        fut = asyncio.ensure_future(self._do(eng, q, key))
        self.inflight[key] = fut
        try:
            return await fut
        finally:
            self.inflight.pop(key, None)

    async def _do(self, eng, q, key):
        self.stats["miss"] += 1
