class LLMError(Exception):
    def __init__(self, kind, msg="", status=None):
        super().__init__(msg or kind)
        self.kind, self.status = kind, status


KIND_ZH = {"no_key": "没有配置 DEEPSEEK_API_KEY", "timeout": "请求超时", "rate_limited": "被限流(429)", "auth": "Key 无效/无权限", "balance": "账户余额不足", "model_not_found": "模型名无效",
           "server_error": "DeepSeek 服务端错误", "network": "网络不可用", "empty": "模型返回空内容", "truncated": "输出被截断", "bad_json": "输出不是合法 JSON", "breaker_open": "连续失败,暂时熔断",
           "vision_unsupported": "模型不支持图片输入", "cancelled": "已取消", "bad_schema": "JSON 字段不合法"}


class LLMGateway:
    def __init__(self, key="", base="https://api.deepseek.com", model="", vision_model="", max_concurrent=3, plan_timeout=None):
        self.key = (key or "").strip()
        self.base = (base or "https://api.deepseek.com").rstrip("/")
        self.model = model or DEFAULT_MODEL
        self.vision_model = vision_model or os.environ.get("DEEPSEEK_VISION_MODEL") or DEFAULT_MODEL
        self.plan_timeout = plan_timeout if plan_timeout is not None else float(os.environ.get("VC_LLM_PLAN_TIMEOUT", "4"))
        self.sem = None
        self.max_concurrent = max_concurrent
        self.fails = 0
        self.open_until = 0.0
        self.last_error = None
        self.vision_verified = None        # None=尚未实测 / True=成功过 / False=明确不支持
        self.text_verified = None
        self.inflight = {}
        self._cli = None

    # —— 状态:文字理解 / 视觉理解分别报告;没有实测就不说"已就绪" ——
    def status(self):
        br = time.time() < self.open_until
        t = "unconfigured" if not self.key else ("breaker_open" if br else ("ready" if self.text_verified else "configured_unverified"))
        v = "unconfigured" if not self.key else ("unsupported" if self.vision_verified is False else ("ready" if self.vision_verified else "configured_unverified"))
        zh = {"unconfigured": "未配置 Key:LLM 不可用,当前使用规则回退", "breaker_open": "连续失败,暂时熔断(规则回退)", "ready": "文字理解已实测可用", "configured_unverified": "已配置,尚未实测(首次请求后更新)",
              "unsupported": "模型不支持图片:视觉理解不可用"}
        return {"text": t, "text_zh": zh.get(t, t), "vision": v, "vision_zh": zh.get(v, v), "model": self.model, "vision_model": self.vision_model, "base": self.base.split("//")[-1],
                "last_error": self.last_error, "breaker_open": br, "timeout_s": self.plan_timeout}

    @property
    def available(self):
        return bool(self.key) and time.time() >= self.open_until

    def cancel(self, rid=None):
        for k, t in list(self.inflight.items()):
            if rid is None or k == rid:
                t.cancel()

    async def _post(self, payload, timeout):
        """真实 HTTP 调用(测试里被替换)。返回 (status_code, json_or_text)"""
        import httpx
        if self._cli is None:
            self._cli = httpx.AsyncClient(timeout=httpx.Timeout(20.0, connect=6.0), limits=httpx.Limits(max_connections=8, max_keepalive_connections=4))
        try:
            r = await self._cli.post(self.base + "/chat/completions", json=payload, headers={"Authorization": "Bearer " + self.key, "Content-Type": "application/json"}, timeout=timeout)
        except httpx.TimeoutException as e:
            raise LLMError("timeout", "timeout") from e
        except httpx.HTTPError as e:
            raise LLMError("network", type(e).__name__) from e
        try:
            return r.status_code, r.json()
        except Exception:  # noqa: BLE001
            return r.status_code, {"raw": r.text[:300]}

    @staticmethod
    def _kind_for(status, body):
        txt = json.dumps(body, ensure_ascii=False)[:400].lower() if body is not None else ""
        if status in (401, 403):
            return "auth"
        if status == 402:
            return "balance"
        if status == 429:
            return "rate_limited"
        if status in (400, 404, 422) and ("model" in txt and any(w in txt for w in ("not exist", "not found", "invalid", "unknown", "does not", "unsupported"))):
            return "model_not_found"
        if status >= 500:
            return "server_error"
        return "server_error" if status != 400 else "bad_schema"

    async def _call(self, purpose, payload, timeout, retries=1):
        """一次受控调用:并发上限 + 超时 + 对瞬时错误有限重试 + 熔断。返回 (choice_message_dict, meta)"""
        if not self.key:
            raise LLMError("no_key")
        if time.time() < self.open_until:
            raise LLMError("breaker_open")
        if self.sem is None:
            self.sem = asyncio.Semaphore(self.max_concurrent)
        rid = secrets.token_hex(4)
        t0 = time.time()
        deadline = t0 + timeout
        models = [payload.get("model") or self.model]
        tried = 0
        last = None
        async with self.sem:
            while True:
                left = deadline - time.time()
                if left <= 0.05:
                    last = last or LLMError("timeout", "timeout")
                    break
                p = dict(payload, model=models[-1])
                try:
                    task = asyncio.ensure_future(self._post(p, left))
                    self.inflight[rid] = task
                    try:
                        status, body = await asyncio.wait_for(task, left)
                    except asyncio.TimeoutError as e:
                        task.cancel()
                        raise LLMError("timeout", "timeout") from e
                    except asyncio.CancelledError:
                        raise LLMError("cancelled")
                    finally:
                        self.inflight.pop(rid, None)
                    if status != 200:
                        kind = self._kind_for(status, body)
                        if kind == "model_not_found" and models[-1] != FALLBACK_MODEL and purpose != "vision":
                            models.append(FALLBACK_MODEL)                         # 旧/新模型名不一致:退回 deepseek-chat(并去掉 thinking 参数)
                            payload = {k: v for k, v in payload.items() if k != "thinking"}
                            continue
                        raise LLMError(kind, "HTTP %s" % status, status)
                    ch = (body.get("choices") or [{}])[0]
                    msg = ch.get("message") or {}
                    meta = {"request_id": rid, "model": models[-1], "ms": int((time.time() - t0) * 1000), "finish": ch.get("finish_reason"), "purpose": purpose}
                    self.fails = 0
                    if models[-1] != self.model and purpose != "vision":
                        self.model = models[-1]
                    return msg, meta
                except LLMError as e:
                    last = e
                    tried += 1
                    if e.kind in ("timeout", "network", "server_error") and tried <= retries and (deadline - time.time()) > 0.8:
                        await asyncio.sleep(0.25)
                        continue
                    break
        # 失败:计入熔断
        self.fails += 1
        self.last_error = {"kind": last.kind, "zh": KIND_ZH.get(last.kind, last.kind), "at": datetime.now(timezone.utc).strftime("%H:%M:%SZ")}
        if last.kind in ("auth", "balance") or self.fails >= 4:
            self.open_until = time.time() + (60 if last.kind in ("auth", "balance") else 20)
        log.warning("LLM %s 失败 rid=%s kind=%s ms=%d", purpose, rid, last.kind, int((time.time() - t0) * 1000))
        raise last

    # —— 用途 1:意图解析(短输入 · 小 JSON · 非思考) ——
    async def parse_intent(self, system, user, timeout=None):
        payload = {"model": self.model, "messages": [{"role": "system", "content": system}, {"role": "user", "content": user[:600]}], "max_tokens": 320, "temperature": 0,
                   "response_format": {"type": "json_object"}, "thinking": {"type": "disabled"}, "stream": False}
        msg, meta = await self._call("intent", payload, timeout or self.plan_timeout)
        if meta.get("finish") == "length":
            raise LLMError("truncated")
        txt = (msg.get("content") or "").strip()
        if not txt:
            raise LLMError("empty")
        obj = parse_json_loose(txt)
        if not isinstance(obj, dict):
            raise LLMError("bad_json")
        self.text_verified = True
        return obj, meta

    # —— 用途 2:搜索总结 / 对话文字(非流式,独立于原 deepseek_stream) ——
    async def text(self, messages, max_tokens=600, timeout=20.0):
        payload = {"model": self.model, "messages": messages, "max_tokens": max_tokens, "temperature": 0.3, "thinking": {"type": "disabled"}, "stream": False}
        msg, meta = await self._call("text", payload, timeout)
        txt = (msg.get("content") or "").strip()
        if not txt:
            raise LLMError("empty")
        self.text_verified = True
        return txt, meta

    # —— 用途 3:页面视觉理解:图片只放在 user 消息的 image_url 内容块里 ——
    async def vision(self, system, question, jpeg_b64, timeout=25.0, detail="auto"):
        if self.vision_verified is False:
            raise LLMError("vision_unsupported")
        msgs = [{"role": "system", "content": system},
                {"role": "user", "content": [{"type": "text", "text": question[:1500]}, {"type": "image_url", "image_url": {"url": "data:image/jpeg;base64," + jpeg_b64, "detail": detail}}]}]
        payload = {"model": self.vision_model, "messages": msgs, "max_tokens": 700, "temperature": 0.2, "thinking": {"type": "disabled"}, "stream": False}
        try:
            msg, meta = await self._call("vision", payload, timeout, retries=0)
        except LLMError as e:
            if e.kind in ("model_not_found", "bad_schema"):
                self.vision_verified = False
                raise LLMError("vision_unsupported", "视觉请求被拒绝:" + e.kind, e.status)
            raise
        txt = (msg.get("content") or "").strip()
        if not txt:
            raise LLMError("empty")
        self.vision_verified = True
        return txt, meta


def parse_json_loose(txt):
    """容忍 ```json 围栏与前后多余文字;截断的 JSON 一律判失败(不修补猜测)"""
    t = txt.strip()
    t = re.sub(r"^```(?:json)?\s*|\s*```$", "", t, flags=re.I).strip()
    try:
        return json.loads(t)
    except Exception:  # noqa: BLE001
        pass
    m = re.search(r"\{.*\}", t, re.S)
    if m:
        try:
            return json.loads(m.group(0))
        except Exception:  # noqa: BLE001
            return None
    return None


