        print("  使用语音库训练任务 %s(库 %s,冻结数据集 v%s,留出验证 %d 条)" % (LIB_JOB["job_id"], LIB_JOB["library_id"], LIB_JOB["version"], LIB_JOB["val_n"]))
    if TRAIN_DATA_DIR and Path(TRAIN_DATA_DIR).exists():
        if FRESH_TRAIN or not (data_dir / "train_codes.jsonl").exists():
            cmd = [PY, str(APP / "data_prep.py"), "--src", TRAIN_DATA_DIR, "--out", str(data_dir), "--device", "cuda:0"]
            if TRAIN_LANGUAGE:
                cmd += ["--language", TRAIN_LANGUAGE]
            if stream(cmd, env=dict(senv), cwd=str(APP)) != 0:
                raise RuntimeError("数据预处理失败,见上方日志")
        else:
            print("  已有预处理好的数据 %s(想重做请把 FRESH_TRAIN 设为 True)" % data_dir)
    banner("训练 · LoRA 双卡微调 + 每轮自动评估(auto_train_loop.py)")
    print("  可随时中断(停止单元格);再次运行会自动从最近的 checkpoint 续训。\n", flush=True)
    cmd = [PY, str(APP / "auto_train_loop.py"), "--work", str(OUT), "--data_dir", str(data_dir), "--base", TTS_MODEL, "--target", str(TARGET_SIMILARITY),
           "--max_epochs", str(MAX_EPOCHS), "--patience", str(PATIENCE), "--lr", str(TRAIN_LR)]
    if FRESH_TRAIN:
        cmd.append("--fresh")
    rc = stream(cmd, env=dict(senv), cwd=str(APP))
    if rc != 0:
        if LIB_JOB:
            subprocess.run([PY, str(APP / "libctl.py"), "fail", "--lib-dir", str(OUT / "vc_data" / "libraries"), "--job", LIB_JOB["job_id"], "--lib", LIB_JOB["library_id"], "--note", "训练流程出错"], env=dict(senv))
        raise RuntimeError("训练流程出错,见上方日志")
    trained_dir = OUT / "best_model"
    if LIB_JOB:
        _f = subprocess.run([PY, str(APP / "libctl.py"), "finish", "--lib-dir", str(OUT / "vc_data" / "libraries"), "--job", LIB_JOB["job_id"], "--lib", LIB_JOB["library_id"], "--model-dir", str(trained_dir), "--train-state", str(OUT / "train_state.json")], capture_output=True, text=True, env=dict(senv))
        print("  语音库:候选模型已登记(尚未升级;需 验证+加载+试合成):" + (_f.stdout.strip().splitlines() or [_f.stderr[-200:]])[-1])
    _stop_server()
    if MODE == "train":
        banner("训练完成")
        print("  ✅ 模型已导出到 %s\n  → 把 MODE 改为 \"serve\" 再运行一次,服务会自动加载它。" % trained_dir)
