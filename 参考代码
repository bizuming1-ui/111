def start_server(env=None):
    p = subprocess.Popen([PY, str(APP / "app.py")], cwd=str(APP), env=env or senv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
    _VC_SRV["proc"] = p

    def pump():
        for line in p.stdout:
            line = line.rstrip()
            _VC_SRV["tail"].append(line)
            if re.search(r"Traceback|Error|error|ERROR|⚠|声音|首包|RTF|就绪|加载|捕获|检测到|模型|对话出错|合成失败|Warning|WARNING|增益|相似", line) and "DeprecationWarning" not in line:
                print("  [server] " + line[:200], flush=True)
    threading.Thread(target=pump, daemon=True).start()
    return p


