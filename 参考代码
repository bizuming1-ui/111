            """浏览器搜索较慢时,前端用短请求轮询,避免长连接被代理中断。"""
            sess = P.mgr.get(sid_of(request), create=False)
            if sess is None:
                return {"ok": False, "error": "没有进行中的浏览器搜索"}
            if sess.task and not sess.task.done():
                st = sess.status
                if st in ("waiting_human", "paused", "waiting_confirm"):
                    return {"ok": False, "needs_attention": True, "status": st, "message": sess.msg or "需要你在实时画面里处理", "results": list(sess.last_results)}
                return {"ok": False, "pending": True, "status": st, "message": sess.msg or "浏览器正在搜索…", "results": []}
            if sess.status == "done" and sess.last_results:
                res = list(sess.last_results)
                out = {"ok": True, "results": res, "mode": {"mode": "browser", "provider": "browser:" + (engine or "bing"), "label": "受控浏览器内的可见搜索", "cost": sp.BROWSER.cost}, "query": q, "page": 0,
