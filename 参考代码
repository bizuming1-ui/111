def new_stats():
    return {"F": 0.085, "D": 0.03, "PRE": 0.5, "rtf": 1.0, "ttfa": 0.9, "n": 0, "obs": deque(maxlen=90), "gaps": deque(maxlen=400)}


def W(idx):
    return WST.setdefault(idx, new_stats())


def _ema(old, new, a=0.35):
    return old * (1 - a) + new * a


def fit_cost(st):
    obs = st["obs"]
    if len(obs) < 5:
        return
    xs = np.array([o[0] for o in obs], dtype=np.float64)
    ys = np.array([o[1] for o in obs], dtype=np.float64)
    if xs.std() < 0.5:
        D = st["D"]
        F = float(np.median(np.maximum(ys - D, 0.01) / np.maximum(xs, 1)))
    else:
        F = float(((xs - xs.mean()) * (ys - ys.mean())).sum() / ((xs - xs.mean()) ** 2).sum())
        D = float(ys.mean() - F * xs.mean())
    st["F"] = min(0.2, max(0.03, F))
    st["D"] = min(0.25, max(0.0, D))


def ingest_chunks(idx, ch):
    st = W(idx)
    for ci, (dt, ns) in enumerate(ch or []):
        fr = ns / 1920.0
        if ci > 0 and fr >= 1:
            st["obs"].append((fr, float(dt)))
        if ci > 0:
            st["gaps"].append(float(dt))                      # 该 GPU 相邻块的到达间隔(秒)
    if ch:
        fit_cost(st)
        fr0 = ch[0][1] / 1920.0
        st["PRE"] = min(3.0, max(0.1, _ema(st["PRE"], ch[0][0] - fr0 * st["F"] - st["D"])))


def sim_arrivals(turn):
    """模拟 GPU(拉取式调度,每张卡用自己实测的 F/D/PRE)合成已知的所有句子: 返回按【播放顺序】排好的 [(到达时刻 s, 可播放时长 s)]。"""
    segs = turn.segs
    ws = POOL.usable() if POOL else []
    if turn.pinned is not None:
        ws = [w for w in ws if w.idx == turn.pinned] or ws
    ids = [w.idx for w in ws] or [0]
    free = {i: 0.0 for i in ids}
    ev, prev_pause = [], 0.0
    for k, sg in enumerate(segs):
        i = min(ids, key=lambda x: free[x])
        st = W(i)
        F, D, PRE = st["F"], st["D"], st["PRE"]
        prof = "first" if k == 0 else ("second" if k == 1 else "rest")
        sched = SCHED.get(prof, SCHED["rest"])
        raw = max(0.5, len(sg.text) * TEXT_STATS["spc"]) + TEXT_STATS["trim"]
        nfr = max(2, int(round(raw / FRAME_S)))
        lead, tail = TEXT_STATS["trim"] * 0.5, TEXT_STATS["trim"] * 0.5
        t, done, ci, raw_cum, deliv_prev = free[i] + PRE, 0, 0, 0.0, 0.0
        first = True
        while done < nfr:
            m = min(sched[min(ci, len(sched) - 1)], nfr - done)
            t += m * F + D
            done += m
            ci += 1
            raw_cum += m * FRAME_S
            deliv = max(0.0, raw_cum - lead) - (tail if done >= nfr else 0.0)
            deliv = max(deliv, deliv_prev)
            dur = deliv - deliv_prev
            deliv_prev = deliv
            if dur > 0 and first:
                dur += prev_pause
                first = False
            if dur > 0:
                ev.append((t, dur))
        free[i] = t + 0.02
        prev_pause = pause_ms(sg.end, turn.breath) / 1000.0
    return ev


def plan_prebuf(turn):
    """起播水位规划: 模拟全程每一块"什么时候到、能播多久",得出播放最少要晚开始多久 need,才能保证每一块在被播放到之前已经到达。
    连续优先: ms = need × 安全系数 + 余量,生成速度不足时会多等(上限 PLAN_CAP_MS);低延迟: 系数更小、封顶很低,更容易欠载。"""
    if not turn.segs:
        return {"ms": 0, "need_ms": 0, "reason": "", "extra_wait_ms": 0}
    ev = sim_arrivals(turn)
    if not ev:
        return {"ms": 0, "need_ms": 0, "reason": "", "extra_wait_ms": 0}
    t0, need, played = ev[0][0], 0.0, 0.0
    for arr, dur in ev:
        need = max(need, arr - t0 - played)
        played += dur
    need_ms = need * 1000.0
    ms = need_ms * PLAN_K + (0 if need <= 0 else 60 + 0.08 * need_ms)
    reason = "按实测速度模拟:生成速度足够,无需因生成而额外等待" if need <= 0 else "按实测速度模拟:后续句子会比播放更晚到达,需预留 %d ms" % need_ms
    llm_slow = False
    if not turn.say_only and not turn.text_done:                         # AI 对话:LLM 吐字速度也要算进去
        cps = turn.llm_cps()
        if cps is not None and cps < 1.5 / max(TEXT_STATS["spc"], 0.05):
            llm_slow = True
            ms = max(ms, min(PLAN_CAP_MS, 6000 if LATENCY_MODE == "continuous" else 1500))
            reason += ";LLM 文字到达速度(%.1f 字/秒)慢于朗读速度的 1.5 倍,先囤积音频" % cps
    ms = int(max(0.0, min(PLAN_CAP_MS, ms)))
    return {"ms": ms, "need_ms": int(need_ms), "reason": reason, "extra_wait_ms": int(max(0, ms - PLAN_FLOOR_MS)), "llm_slow": llm_slow,
            "capped": bool(need_ms * PLAN_K > PLAN_CAP_MS)}


def send_plan(turn):
    if turn.closed or turn.first_audio is not None or not turn.segs:
        return
    p = plan_prebuf(turn)
    turn.plan = p
    turn.window_ms = max(SEND_AHEAD_MS, p["ms"] + 8000)
    ws = POOL.usable() if POOL else []
    st = W(ws[0].idx) if ws else W(0)
    turn.sess.send({"type": "plan", "turn": turn.uid, "prebuf_ms": p["ms"], "need_ms": p["need_ms"], "reason": p["reason"], "extra_wait_ms": p["extra_wait_ms"],
                    "capped": p.get("capped", False), "llm_slow": p.get("llm_slow", False), "window_ms": turn.window_ms, "segs": len(turn.segs), "mode": LATENCY_MODE,
                    "rtf": round(st["rtf"], 2), "ttfa": round(st["ttfa"], 2), "floor_ms": PLAN_FLOOR_MS})
    log.info("[#%d] 播放计划: %d 句 · 起播水位 %dms(need %dms) · %s", turn.uid, len(turn.segs), p["ms"], p["need_ms"], p["reason"])


def pcts(xs):
    xs = [float(x) for x in xs]
    if not xs:
        return None
    return {"n": len(xs), "p50": round(aq.percentile(xs, 50), 1), "p95": round(aq.percentile(xs, 95), 1), "p99": round(aq.percentile(xs, 99), 1), "max": round(max(xs), 1)}


