    # ───────────────────────── 路由 ─────────────────────────
    def mount(self):
        app, G = self.app, self.G
        P = self

        from starlette.exceptions import HTTPException as _HTTPExc

        @app.exception_handler(_HTTPExc)
        async def _http_exc(request, exc):                           # 保持 FastAPI 的 detail 字段,同时补上 error,前端永远拿到可读 JSON
            return JSONResponse({"detail": exc.detail, "ok": False, "error": str(exc.detail)}, status_code=exc.status_code, headers=getattr(exc, "headers", None))

        @app.exception_handler(Exception)
        async def _any_exc(request, exc):
            rid = secrets.token_hex(4)
            G["log"].error("未处理异常 [%s] %s %s: %s", rid, request.method, request.url.path, exc)
            return JSONResponse({"ok": False, "error": "服务器内部错误(%s: %s)" % (type(exc).__name__, str(exc)[:120]), "request_id": rid}, status_code=500, headers={"X-Request-Id": rid})

        async def body(request):
            try:
                j = await request.json()
                return j if isinstance(j, dict) else {}
            except Exception:  # noqa: BLE001
                return {}

        def sid_of(request):
            return request.scope.get("vc_sid") or "open"

        def guard(fn):
            @functools.wraps(fn)
            async def inner(*a, **kw):
                try:
                    return await fn(*a, **kw)
                except StoreError as e:
                    return err(str(e), e.code)
                except ba.ActionError as e:
                    return err(str(e), 409)
            return inner

        # —— 页面与认证 ——
        @app.get("/", response_class=HTMLResponse)
        async def home():
            h = G["read_src"]("home.html")
            return HTMLResponse(h or "home.html 不存在", status_code=200 if h else 500, headers={"Cache-Control": "no-store"})

        @app.get("/login", response_class=HTMLResponse)
        async def login_page():
            return HTMLResponse(auth_mod.LOGIN_HTML, headers={"Cache-Control": "no-store"})

        @app.post("/api/login")
        async def api_login(request: Request):
            j = await body(request)
            ip = request.scope.get("vc_ip", "?")
            tok, msg = P.auth.login(str(j.get("password") or ""), ip)
            if not tok:
                P.audit.event("login", "denied")
                return err(msg, 429 if "次数" in msg else 401)
            proto = (request.headers.get("x-forwarded-proto") or request.url.scheme).split(",")[0]
            r = JSONResponse({"ok": True})
            r.set_cookie(auth_mod.COOKIE, tok, httponly=True, samesite="strict", secure=(proto == "https"), max_age=P.auth.ttl, path="/")
            P.audit.event("login", "ok")
            return r

        @app.post("/api/logout")
        async def api_logout(request: Request):
            await P.mgr.close_session(sid_of(request))
            P.auth.logout(request.scope.get("vc_token"))
            r = JSONResponse({"ok": True})
            r.delete_cookie(auth_mod.COOKIE, path="/")
            return r

        @app.get("/api/auth/info")
        async def auth_info(request: Request):
            return {"auth_enabled": P.auth.enabled, "logged_in": bool(request.scope.get("vc_sid"))}

        @app.get("/api/portal/status")
        async def api_status():
            return P.status()

        # —— 搜索 / 代理 ——
        @app.post("/api/search")
        @guard
        async def api_search(request: Request):
            j = await body(request)
            rid = secrets.token_hex(4)
            if not P.auth.lim.hit("search:" + sid_of(request), 40, 60):
                return JSONResponse({"ok": False, "error": "搜索过于频繁,请稍后再试", "kind": "rate_limited", "request_id": rid}, status_code=429, headers={"X-Request-Id": rid})
            try:
                r = await P.do_search(sid_of(request), j)
            except (StoreError, ba.ActionError) as e:
                return JSONResponse({"ok": False, "error": str(e), "request_id": rid}, status_code=getattr(e, "code", 409) or 400, headers={"X-Request-Id": rid})
            except RuntimeError as e:
                return JSONResponse({"ok": False, "error": str(e), "request_id": rid}, status_code=502, headers={"X-Request-Id": rid})
            except Exception as e:  # noqa: BLE001 —— 任何未预料的异常都返回 JSON(而不是让代理/框架吐出无法解析的页面)
                G["log"].warning("search 内部错误 [%s]: %s", rid, e)
                return JSONResponse({"ok": False, "error": "服务端搜索出错(%s: %s)" % (type(e).__name__, str(e)[:120]), "request_id": rid}, status_code=500, headers={"X-Request-Id": rid})
            code = r.pop("_status", 200) if isinstance(r, dict) else 200
            return JSONResponse(r, status_code=code, headers={"X-Request-Id": r.get("request_id", rid)})

        @app.get("/api/search/poll")
        @guard
        async def api_search_poll(request: Request, q: str = "", engine: str = "bing"):
            """浏览器搜索较慢时,前端用短请求轮询,避免长连接被代理中断。"""
            sess = P.mgr.get(sid_of(request), create=False)
            if sess is None:
                return {"ok": False, "error": "没有进行中的浏览器搜索"}
            if sess.task and not sess.task.done():
                st = sess.status
