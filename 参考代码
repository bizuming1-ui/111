# =============================================================================
#  文本切句:把长文本切成 <= MAX_SEG_CHARS 的段,保证 XTTS 不截断,并让第一句尽快出声
# =============================================================================
_SENT_END = re.compile(r"(?<=[。！？!?；;…])|(?<=\n)|(?<=[.])(?=\s|$)")
_SUB_END = re.compile(r"(?<=[，,、：:])")
_HAS_SPEECH = re.compile(r"\w", re.UNICODE)   # 至少含一个字母/数字/汉字,否则 XTTS 会因空 token 报错


def _join(a, b):
    """拼接两段文字:两侧都是英文/数字时补一个空格,中文直接相连"""
    if a[-1:].isascii() and a[-1:].isalnum() and b[:1].isascii() and b[:1].isalnum():
        return a + " " + b
    return a + b


def split_text(text, max_len=MAX_SEG_CHARS, min_len=MIN_SEG_CHARS):
    text = re.sub(r"[ \t\r\u3000]+", " ", text or "").strip()
    pieces = []
    for sent in _SENT_END.split(text):
        sent = sent.strip()
        if not sent:
            continue
        if len(sent) <= max_len:
            pieces.append(sent)
            continue
        cur = ""
        for part in _SUB_END.split(sent):          # 句子太长:按逗号再切并贪心合并
            while len(part) > max_len:             # 仍然太长:硬切
                if cur:
                    pieces.append(cur)
                    cur = ""
                pieces.append(part[:max_len])
                part = part[max_len:]
            if len(cur) + len(part) <= max_len:
                cur += part
            else:
                if cur:
                    pieces.append(cur)
                cur = part
        if cur:
            pieces.append(cur)
    segs, buf = [], ""                              # 合并过短的句子
    for p in pieces:
        if buf and len(buf) >= min_len:
            segs.append(buf)
            buf = ""
        if buf and len(buf) + len(p) > max_len:
            segs.append(buf)
            buf = ""
        buf = _join(buf, p) if buf else p
    if buf:
        segs.append(buf)
    return [s.strip() for s in segs if _HAS_SPEECH.search(s)]


def to_pcm16(chunk):
    """XTTS 输出的 float(-1..1) 张量/数组 -> 16-bit 小端 PCM 字节"""
    if hasattr(chunk, "detach"):
        chunk = chunk.detach().float().cpu().numpy()
    a = np.nan_to_num(np.asarray(chunk, dtype=np.float32).reshape(-1))
    return (np.clip(a, -1.0, 1.0) * 32767.0).round().astype("<i2").tobytes()


