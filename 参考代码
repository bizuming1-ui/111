def _wav(sec=6.0, seed=1):
    import numpy as np
    rng = np.random.default_rng(seed)
    t = np.arange(int(24000 * sec)) / 24000
    x = (0.3 * np.sin(2 * np.pi * (140 + 30 * seed) * t) * (0.6 + 0.4 * np.sin(2 * np.pi * 3 * t))).astype("float32") + rng.normal(0, 0.002, len(t)).astype("float32")
    import wave
    bio = io.BytesIO()
    with wave.open(bio, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(24000); w.writeframes((x * 32767).astype("<i2").tobytes())
    return bio.getvalue()


