async def _run(sess, actions, title="t", until=("done", "error", "cancelled", "paused", "waiting_confirm", "waiting_human"), timeout=40):
    sess.start(ba.validate_actions(actions), title)
    t0 = time.time()
    await asyncio.sleep(0.2)
    while time.time() - t0 < timeout:
        if sess.status in until and sess.status != "running":
            return sess.status
        await asyncio.sleep(0.15)
    return "timeout"


