async def deepseek_stream(messages, long_mode):
    if MOCK_LLM:
        txt = ("嗯，好的。这是一个用来测试的回答。我会先说一小句，然后再慢慢往下讲。" * (6 if long_mode else 1)) + "好啦，就说到这里。"
        for i in range(0, len(txt), 3):
            await asyncio.sleep(0.05)
            yield txt[i:i + 3]
        return
    if not DS_KEY:
        raise RuntimeError("没有配置 DEEPSEEK_API_KEY(在 Kaggle Secrets 里添加,或填到脚本顶部的 DEEPSEEK_API_KEY)")
    import httpx
    payload = {"model": DS_MODEL, "messages": messages, "stream": True, "temperature": 1.1,
               "max_tokens": 8000 if long_mode else 1200}
    headers = {"Authorization": "Bearer " + DS_KEY, "Content-Type": "application/json"}
    async with httpx.AsyncClient(timeout=httpx.Timeout(60.0, connect=15.0)) as cli:
        async with cli.stream("POST", DS_BASE + "/chat/completions", headers=headers, json=payload) as r:
            if r.status_code != 200:
                body = (await r.aread()).decode("utf-8", "ignore")[:300]
                raise RuntimeError("DeepSeek 返回 %d: %s" % (r.status_code, body))
            async for line in r.aiter_lines():
                if not line.startswith("data:"):
                    continue
                d = line[5:].strip()
                if d == "[DONE]":
                    break
                try:
                    obj = json.loads(d)
                    t = obj["choices"][0]["delta"].get("content")
                except Exception:  # noqa: BLE001
                    continue
                if t:
                    yield t


async def run_turn(sess, turn, user_text, opts, say_only):
    seg = Segmenter()
    try:
        sess.send({"type": "turn_start", "turn": turn.uid, "ref": turn.ref, "sr": SR, "tts": turn.tts})
        if say_only:
            turn.full_text = user_text
            for s in seg.push(user_text) + seg.finish():
                dispatch(turn, s)
        else:
            sysmsg = SYS_BASE + (SYS_LONG if opts.get("long") else SYS_SHORT) + (SYS_FILLER if opts.get("filler") else "")
            sess.history.append({"role": "user", "content": user_text})
            sess.history = sess.history[-24:]
            msgs = [{"role": "system", "content": sysmsg}] + sess.history
            first = True
            async for delta in deepseek_stream(msgs, bool(opts.get("long"))):
                if first:
                    first = False
                    sess.send({"type": "llm_first", "turn": turn.uid, "ms": int((time.time() - turn.t0) * 1000)})
                turn.full_text += delta
                sess.send({"type": "delta", "turn": turn.uid, "t": delta})
                for s in seg.push(delta):
                    dispatch(turn, s)
            for s in seg.finish():
                dispatch(turn, s)
        turn.text_done = True
        pump(turn)
    except asyncio.CancelledError:
        raise
    except Exception as e:  # noqa: BLE001
        log.error("对话出错: %s", e)
        sess.send({"type": "error", "turn": turn.uid, "msg": str(e)})
        for s in seg.finish():
            dispatch(turn, s)
        turn.text_done = True
        pump(turn)
    finally:
        if turn.full_text and not say_only:
            sess.history.append({"role": "assistant", "content": turn.full_text})


def cancel_turn(sess):
    if sess.task is not None and not sess.task.done():
        sess.task.cancel()
    if sess.turn is not None:
        sess.turn.closed = True
        ACTIVE.pop(sess.turn.uid, None)
    sess.task, sess.turn = None, None
    if POOL:
        POOL.bump()
        for w in POOL.workers:
            w.pending = 0


def start_turn(sess, text, opts, ref, say_only=False):
    cancel_turn(sess)
    t = Turn(sess, ref, float(opts.get("breath", 1.0)))
    t.tts = bool(opts.get("tts", True))
    ACTIVE[t.uid] = t
    sess.turn = t
    sess.task = asyncio.get_running_loop().create_task(run_turn(sess, t, text, opts, say_only))


