class MockEngine:
    """无 GPU 的自检引擎(VC_MOCK=1):合成正弦"语音",用来验证整条链路。"""
    name = "mock"

    def __init__(self, idx, send):
        self.idx, self.send = idx, send
        self.dtype = "mock"

    def load(self):
        time.sleep(0.5)

    def backend_info(self):
        return {"mock": True, "backend": "mock (正弦波合成, 非真实模型)", "device": "none", "model": "mock"}

    def spk_qc(self, path):
        return {"mock": True, "suspect": False, "p10": None, "mean": None, "n_windows": 0}

    def spk_cmp(self, gen_path, ref_paths):
        return {"mock": True, "scores": [None for _ in ref_paths], "model": "mock"}

    def set_voice(self, path, text, xvec):
        time.sleep(0.4)
        t0, first, n, ch, tp = time.time(), None, 0, [], time.time()
        for a, sr in self.stream("今天天气真好，我们一起出去走走吧。", "calib"):
            now = time.time()
            first = first or (now - t0)
            ch.append((round(now - tp, 4), len(a)))
            tp, n = now, n + len(a)
        wall = time.time() - t0
        return {"rtf": round(wall / (n / SR), 2), "ttfa": round(first, 2), "dtype": "mock", "sr": SR, "mode": "mock", "sim": 0.96, "rms": 3000.0, "ch": ch, "prompt_cached": True}

    def stream(self, text, profile, seed=None):
        """成本模型≈T4 + 1.7B(faster-qwen3-tts 官方数据 RTF≈0.93~1.07, TTFA≈1s):
        预填充 PRE;每帧生成 F;每次解码一个固定开销 D。可用环境变量调参来压测调度/播放器。"""
        _seed_all(seed)
        F = float(os.environ.get("VC_MOCK_FRAME_MS", "82")) / 1000
        D = float(os.environ.get("VC_MOCK_DEC_MS", "30")) / 1000
        PRE = float(os.environ.get("VC_MOCK_PREFILL_MS", "450")) / 1000
        sched = SCHED.get(profile, SCHED["rest"])
        dur = max(0.6, len(text) * 0.2)
        f0 = 140 + (sum(map(ord, text)) % 5) * 25
        lead, tail = 0.18, 0.22
        total = lead + dur + tail
        nfr = int(total * 12.5)
        time.sleep(PRE)
        done, i, t0 = 0, 0, 0.0
        while done < nfr:
            n = min(sched[min(i, len(sched) - 1)], nfr - done)
            time.sleep(n * F + D)
            d = n / 12.5
            t = np.arange(int(SR * d)) / SR + t0
            sig = sum(np.sin(2 * np.pi * f0 * h * t) / h for h in range(1, 6))
            env = ((t > lead) & (t < lead + dur)) * (0.6 + 0.4 * np.sin(2 * np.pi * 3 * t))
            if os.environ.get("VC_MOCK_FAIL") == "nan" and "NANTRIGGER" in text:
                yield np.full(int(SR * d), np.nan, np.float32), SR
                return
            yield (0.25 * sig * env).astype(np.float32), SR
            done += n
            i += 1
            t0 += d

    def score(self, pcm):
        return 0.95 + (len(pcm) % 7) / 200.0

    def asr(self, path):
        return "这是一段模拟识别的参考文本"


