function ping() { if (S.wsOk) S.ws.send(JSON.stringify({ type: "ping", t: performance.now() })); }
function send(o) { if (S.wsOk) { try { S.ws.send(JSON.stringify(o)); return true; } catch (e) {} } return false; }
document.addEventListener("visibilitychange", () => {
  if (curOk()) { CUR.tab_hidden++; send({ type: "event", name: "visibility" }); }
