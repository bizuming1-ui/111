class FakeGitHub(http.server.BaseHTTPRequestHandler):
    """最小 Git Data API 假服务:验证原子单 commit / 幂等 / 私有仓库校验 / Token 只在 Authorization 头"""
    state = {"commits": 0, "head": "c0", "tree": "t0", "blobs": {}, "trees": {}, "auth": set(), "urls": [], "private": {"o/pub": False, "o/priv": True}, "last_files": {}}

    def log_message(self, *a):
        pass

    def _send(self, code, obj):
        b = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def _handle(self, method):
        S = FakeGitHub.state
        S["auth"].add(self.headers.get("Authorization"))
        S["urls"].append(self.path)
        n = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(n)) if n else {}
        p = self.path
        import re
        m = re.match(r"/repos/(o/\w+)$", p)
        if m:
            return self._send(200, {"full_name": m.group(1), "private": S["private"][m.group(1)], "default_branch": "main", "permissions": {"push": True}})
        if "/git/ref/heads/" in p:
            return self._send(200, {"object": {"sha": S["head"]}})
        if "/git/commits/" in p and method == "GET":
            return self._send(200, {"tree": {"sha": S["tree"]}})
        if p.endswith("/git/blobs"):
            sha = "b%d" % len(S["blobs"])
            S["blobs"][sha] = body
            return self._send(201, {"sha": sha})
        if p.endswith("/git/trees"):
            key = json.dumps(sorted((e["path"], S["blobs"][e["sha"]]["content"]) for e in body["tree"]))
            if key == S.get("last_key"):
                return self._send(201, {"sha": S["tree"]})
            S["pending_key"] = key
            S["pending_tree"] = body["tree"]
            return self._send(201, {"sha": "t%d" % (S["commits"] + 1)})
        if p.endswith("/git/commits") and method == "POST":
            S["pending_commit"] = body
            return self._send(201, {"sha": "c%d" % (S["commits"] + 1)})
        if "/git/refs/heads/" in p and method == "PATCH":
            S["commits"] += 1
            S["head"], S["tree"], S["last_key"] = "c%d" % S["commits"], "t%d" % S["commits"], S["pending_key"]
            S["last_files"] = [e["path"] for e in S["pending_tree"]]
            return self._send(200, {"ok": True})
        return self._send(404, {"message": "nf"})

    do_GET = lambda self: self._handle("GET")  # noqa: E731
    do_POST = lambda self: self._handle("POST")  # noqa: E731
    do_PATCH = lambda self: self._handle("PATCH")  # noqa: E731


