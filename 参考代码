    · 每个 epoch 结束 → 保存 checkpoints/epoch_X/ → rank0 调用 evaluate.py 测声纹相似度 → 写 eval_log.jsonl
    · 相似度 ≥ 目标 → 全部进程一起停止;连续 patience 轮没有提升 → 视为收敛,停止并选最优轮;最多 max_epochs 轮
    (训练进程常驻,epoch 之间不重新加载 1.7B 模型,比"每轮重启一次"快得多;断点续训见 --resume)
"""
import argparse
import json
import math
import os
import random
import shutil
import subprocess
import sys
import time
from datetime import timedelta
from pathlib import Path

import torch
import torch.nn as nn

HERE = Path(__file__).resolve().parent
LORA_TARGET_REGEX = (r"talker\.(model|code_predictor\.model)\.layers\.\d+\."
                     r"(self_attn\.(q_proj|k_proj|v_proj|o_proj)|mlp\.(gate_proj|up_proj|down_proj))")


def build_lora(inner, r, alpha, dropout):
    """直接把 LoRA 注入原模型(不套 PeftModel 外壳,这样 model.talker / model.speaker_encoder 仍可直接调用)"""
    from peft import LoraConfig
    from peft.tuners.lora import LoraModel
    cfg = LoraConfig(r=r, lora_alpha=alpha, lora_dropout=dropout, target_modules=LORA_TARGET_REGEX, bias="none")
    lm = LoraModel(inner, cfg, "default")
    n = sum(1 for k, _ in inner.named_parameters() if "lora_A" in k)
    if n == 0:
        names = [k for k, _ in inner.named_modules()][:40]
        raise RuntimeError("没有匹配到任何 LoRA 目标层,请检查模块名。前 40 个模块: %s" % names)
    return lm, n


def lora_state(inner):
    return {k: v.detach().cpu().float() for k, v in inner.named_parameters() if "lora_" in k}


def load_base(path, dtype):
    from qwen_tts.inference.qwen3_tts_model import Qwen3TTSModel
    return Qwen3TTSModel.from_pretrained(path, torch_dtype=dtype, attn_implementation="sdpa")


def resolve_base(name):
    if os.path.isdir(name):
        return name
    from huggingface_hub import snapshot_download
    return snapshot_download(name)


class SFTModule(nn.Module):
    """整个前向 + loss 封装成一个 Module,DDP 才能正确同步梯度(官方脚本直接调子模块,只适用于单卡)"""

    def __init__(self, model):
        super().__init__()
        self.model = model

    def forward(self, input_ids, codec_ids, ref_mels, text_embedding_mask, codec_embedding_mask, attention_mask, codec_0_labels, codec_mask):
        m = self.model
        dtype = m.talker.model.text_embedding.weight.dtype
        with torch.no_grad():
            speaker_embedding = m.speaker_encoder(ref_mels.to(dtype)).detach()
        input_text_ids = input_ids[:, :, 0]
        input_codec_ids = input_ids[:, :, 1]
        input_text_embedding = m.talker.model.text_embedding(input_text_ids) * text_embedding_mask
        input_codec_embedding = m.talker.model.codec_embedding(input_codec_ids) * codec_embedding_mask
        input_codec_embedding[:, 6, :] = speaker_embedding
        input_embeddings = input_text_embedding + input_codec_embedding
        for i in range(1, 16):
            e = m.talker.code_predictor.get_input_embeddings()[i - 1](codec_ids[:, :, i])
            input_embeddings = input_embeddings + e * codec_mask.unsqueeze(-1)
        outputs = m.talker(inputs_embeds=input_embeddings[:, :-1, :], attention_mask=attention_mask[:, :-1],
                           labels=codec_0_labels[:, 1:], output_hidden_states=True)
        hidden = outputs.hidden_states[0][-1]
        talker_hidden = hidden[codec_mask[:, :-1]]
        talker_codec_ids = codec_ids[codec_mask]
        _, sub_loss = m.talker.forward_sub_talker_finetune(talker_codec_ids, talker_hidden)
        return outputs.loss + 0.3 * sub_loss


STOP_ON_TARGET = [False]


def eval_val_loss(module, vdl, acc, inner):
    """在【留出验证集】上算平均 loss(无梯度)。所有 rank 都必须调用。"""
    module.eval()
    tot, n = 0.0, 0
    with torch.no_grad():
        for batch in vdl:
            loss = module(**batch)
            g = acc.gather_for_metrics(loss.detach().float().reshape(1))
            if torch.isfinite(g).all():
                tot += float(g.sum())
                n += int(g.numel())
    module.train()
    inner.speaker_encoder.eval()
    return (tot / n) if n else None


def ddp_info(acc, trainable):
    """所有 rank 汇报设备号/显存/LoRA 参数校验和:证明两张卡确实参加了同一次同步训练"""
    cs = torch.stack([p.detach().double().sum() for p in trainable]).sum()
    t = torch.tensor([float(acc.process_index), float(acc.device.index or 0), torch.cuda.memory_allocated(acc.device) / 1e9, float(cs)], dtype=torch.float64, device=acc.device)
    g = acc.gather(t.unsqueeze(0)).cpu().tolist()
    sums = [r[3] for r in g]
    gpus = [{"rank": int(r[0]), "device_index": int(r[1]), "name": torch.cuda.get_device_name(int(r[1])), "mem_alloc_gb": round(r[2], 2)} for r in g]
    eq = (max(sums) - min(sums)) <= 1e-6 * (abs(sum(sums) / len(sums)) + 1.0)
    return {"world_size": acc.num_processes, "checksum_equal": bool(eq), "checksums": [round(x, 6) for x in sums]}, gpus


def decide_val(hist, patience, max_epochs):
    """按验证 loss 决定是否停止。hist: [(epoch, val_loss, train_loss)]。相对改善 <0.5% 不算提升。返回 (stop, reason, best_epoch, best_val, converged, overfit)"""
    best_e, best_v = hist[0][0], hist[0][1]
    for e, v, _ in hist[1:]:
        if v < best_v * 0.995:
            best_e, best_v = e, v
    last = hist[-1]
    since = last[0] - best_e
    overfit = len(hist) >= 3 and last[1] > best_v * 1.02 and last[2] < hist[-3][2]
    if since >= patience:
        return True, "早停:验证 loss 连续 %d 轮无提升(已收敛或开始过拟合)" % patience, best_e, best_v, True, overfit
    if last[0] >= max_epochs:
        return True, "达到最大轮数(未必收敛)", best_e, best_v, False, overfit
    return False, "", best_e, best_v, False, overfit


def read_jsonl(p):
    return [json.loads(x) for x in Path(p).read_text(encoding="utf-8").splitlines() if x.strip()]


def eval_rows(eval_log):
    p = Path(eval_log)
    if not p.exists():
        return []
    out = []
    for ln in p.read_text(encoding="utf-8").splitlines():
        try:
            out.append(json.loads(ln))
        except ValueError:
            pass
    return out


def decide(eval_log, epoch, target, patience, max_epochs):
    """返回 (stop, reason, best_epoch, best_sim)。只看 epoch>=1 的评估(0 是未微调基线)"""
    rows = [r for r in eval_rows(eval_log) if r.get("epoch", 0) >= 1 and r.get("similarity") is not None]
    if not rows:
        return epoch + 1 >= max_epochs, "达到最大轮数" if epoch + 1 >= max_epochs else "", None, None
    best = max(rows, key=lambda r: r["similarity"])
    cur = [r for r in rows if r["epoch"] == epoch + 1]
    if cur and cur[-1]["similarity"] >= target and STOP_ON_TARGET[0]:
        return True, "达标", best["epoch"], best["similarity"]
    since = (epoch + 1) - best["epoch"]
    if since >= patience:
        return True, "收敛(连续 %d 轮无提升)" % patience, best["epoch"], best["similarity"]
    if epoch + 1 >= max_epochs:
        return True, "达到最大轮数", best["epoch"], best["similarity"]
    return False, "", best["epoch"], best["similarity"]


def write_state(path, **kw):
    try:
        old = {}
        if Path(path).exists():
            old = json.loads(Path(path).read_text(encoding="utf-8"))
        old.update(kw)
        old["updated"] = time.strftime("%Y-%m-%d %H:%M:%S")
        tmp = str(path) + ".tmp"
        Path(tmp).write_text(json.dumps(old, ensure_ascii=False), encoding="utf-8")
        os.replace(tmp, path)
    except Exception:  # noqa: BLE001
        pass


# ────────────────────────────── 合并导出 ──────────────────────────────
def merge_export(args):
    """把 LoRA 合并进基座权重,导出成一个完整的 Qwen3-TTS-Base 模型目录(faster-qwen3-tts / qwen-tts 都能直接加载)"""
    from safetensors.torch import save_file
    base = resolve_base(args.base)
    ck = torch.load(args.adapter, map_location="cpu")
    cfg = ck["lora_cfg"]
    print("加载基座(CPU, fp16)…", flush=True)
    tts = load_base(base, torch.float16)
    inner = tts.model
    lm, n = build_lora(inner, cfg["r"], cfg["alpha"], 0.0)
    missing, unexpected = inner.load_state_dict(ck["lora"], strict=False)
    bad = [k for k in missing if "lora_" in k]
    if bad or unexpected:
        raise RuntimeError("LoRA 权重与模型不匹配: missing=%s unexpected=%s" % (bad[:5], list(unexpected)[:5]))
    merged = lm.merge_and_unload()
    out = Path(args.out)
    if out.exists():
        shutil.rmtree(out)
    root = os.path.abspath(base)

    def ignore(d, names):
        if os.path.abspath(d) != root:
            return [".git"] if ".git" in names else []
        return [x for x in names if x.endswith((".safetensors", ".bin", ".msgpack", ".h5")) or x == "model.safetensors.index.json" or x.startswith(".")]

    shutil.copytree(base, out, ignore=ignore)
    sd = {k: v.detach().to("cpu", torch.float16).contiguous() for k, v in merged.state_dict().items()}
    save_file(sd, str(out / "model.safetensors"), metadata={"format": "pt"})
    meta = dict(ck.get("meta", {}))
    meta.update(merged_from=str(args.adapter), lora_modules=n, time=time.strftime("%Y-%m-%d %H:%M:%S"), base=args.base)
    if args.ref_wav and Path(args.ref_wav).exists():
        shutil.copy(args.ref_wav, out / "speaker_ref.wav")
        meta["ref_text"] = Path(args.ref_text).read_text(encoding="utf-8").strip() if args.ref_text and Path(args.ref_text).exists() else ""
    import hashlib
    h = hashlib.sha256()
    with open(out / "model.safetensors", "rb") as fh:
        for blk in iter(lambda: fh.read(1 << 23), b""):
            h.update(blk)
    meta["model_sha256"] = h.hexdigest()
    (out / "trained.json").write_text(json.dumps(meta, ensure_ascii=False, indent=2), encoding="utf-8")
    print("✅ 已导出合并后的模型 → %s  (%.2f GB)" % (out, (out / "model.safetensors").stat().st_size / 1e9), flush=True)


# ────────────────────────────── 训练 ──────────────────────────────
def run_eval(args, epoch, adapter, local_rank):
    cmd = [sys.executable, str(HERE / "evaluate.py"), "--adapter", str(adapter), "--epoch", str(epoch), "--data_dir", args.data_dir,
           "--base", args.base, "--device", "cuda:%d" % local_rank, "--eval_log", args.eval_log, "--n", str(args.eval_n)]
    env = {k: v for k, v in os.environ.items() if k not in ("RANK", "WORLD_SIZE", "LOCAL_RANK", "MASTER_ADDR", "MASTER_PORT")}
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=args.eval_timeout)
    except Exception as e:  # noqa: BLE001
        print("⚠ 评估启动失败: %s" % e, flush=True)
        return None
    sim = None
    for ln in (r.stdout or "").splitlines():
        if ln.startswith("EVAL_RESULT "):
            try:
                sim = json.loads(ln[len("EVAL_RESULT "):]).get("similarity")
            except ValueError:
                pass
    if sim is None:
        print("⚠ 评估没有产出结果(训练继续)。stderr 尾部:\n%s" % "\n".join((r.stderr or r.stdout or "").splitlines()[-15:]), flush=True)
    return sim


def train(args):
    from accelerate import Accelerator
    from accelerate.utils import DistributedDataParallelKwargs, InitProcessGroupKwargs
    from torch.utils.data import DataLoader
    from transformers import AutoConfig
    from tts_dataset import TTSDataset

    dtype = torch.float16 if args.dtype == "fp16" else torch.bfloat16
    rows = read_jsonl(args.train_jsonl)
    world0 = int(os.environ.get("WORLD_SIZE", "1"))
    micro_per_epoch = math.ceil(len(rows) / (args.batch_size * world0))
    accum = args.grad_accum if args.grad_accum > 0 else max(1, min(8, micro_per_epoch // 8))
    ddp_kw = DistributedDataParallelKwargs(find_unused_parameters=True)
    pg_kw = InitProcessGroupKwargs(timeout=timedelta(hours=3))          # rank0 评估期间,其余 rank 在栅栏处等待
    acc = Accelerator(mixed_precision=args.dtype, gradient_accumulation_steps=accum, kwargs_handlers=[ddp_kw, pg_kw])
    main = acc.is_main_process
    world = acc.num_processes
    seed = args.seed
    random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)

    out_dir = Path(args.output_dir)
    ck_dir = out_dir / "checkpoints"
    ctrl_path = out_dir / "train_control.json"
    if main:
        ck_dir.mkdir(parents=True, exist_ok=True)
        if ctrl_path.exists():
            ctrl_path.unlink()
        (out_dir / "train_done.json").unlink(missing_ok=True)
    acc.wait_for_everyone()

    base = resolve_base(args.base)
    args.base = base
    acc.print("加载基座模型 %s (%s)…" % (args.base, args.dtype))
    tts = load_base(base, dtype)
    inner = tts.model
    config = AutoConfig.from_pretrained(base)
    for p in inner.parameters():
        p.requires_grad_(False)
    lm, n_lora = build_lora(inner, args.lora_r, args.lora_alpha, args.lora_dropout)
    for p in inner.parameters():
        if p.requires_grad:
            p.data = p.data.float()                                    # LoRA 权重用 fp32(配合 GradScaler)
    inner.to(acc.device)
    trainable = [p for p in inner.parameters() if p.requires_grad]
    acc.print("LoRA 层数: %d · 可训练参数: %.2fM · 世界大小(GPU 数): %d" % (n_lora, sum(p.numel() for p in trainable) / 1e6, world))

    ds = TTSDataset(rows, tts.processor, config)
    dl = DataLoader(ds, batch_size=args.batch_size, shuffle=True, collate_fn=ds.collate_fn, num_workers=args.workers, drop_last=False)
    vpath = Path(args.data_dir) / "val_codes.jsonl"
    vrows = read_jsonl(vpath) if vpath.exists() else []
    vdl = None
    if vrows:
        vds = TTSDataset(vrows, tts.processor, config)
        vdl = DataLoader(vds, batch_size=args.batch_size, shuffle=False, collate_fn=vds.collate_fn, num_workers=0, drop_last=False)
    acc.print("验证集(留出的原始录音)片段数: %d %s" % (len(vrows), "" if vrows else "—— 没有验证集,无法计算验证 loss,将退回相似度选择(可信度低)"))
    micro_per_epoch = math.ceil(len(rows) / (args.batch_size * world))
    steps_per_epoch = max(1, math.ceil(micro_per_epoch / accum))
    total_steps = steps_per_epoch * args.max_epochs
    warm = max(1, int(total_steps * args.warmup_ratio))
    acc.print("训练样本 %d · 每卡 batch %d × %d 卡 × 累积 %d = 等效 batch %d · 每轮 %d 个优化步" %
              (len(rows), args.batch_size, world, accum, args.batch_size * world * accum, steps_per_epoch))

    optimizer = torch.optim.AdamW(trainable, lr=args.lr, weight_decay=0.01)

    def lr_lambda(s):
        if s < warm:
            return (s + 1) / warm
        pr = (s - warm) / max(1, total_steps - warm)
        return 0.02 + 0.98 * 0.5 * (1 + math.cos(math.pi * min(1.0, pr)))

    sched = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)

    start_epoch, opt_steps, resume_state = 0, 0, None
    if args.resume:
        cands = sorted(ck_dir.glob("epoch_*/state.pt"), key=lambda p: int(p.parent.name.split("_")[1]))
        if cands:
            st = resume_state = torch.load(cands[-1], map_location="cpu")
            inner.load_state_dict(st["lora"], strict=False)
            optimizer.load_state_dict(st["opt"])
            sched.load_state_dict(st["sched"])
            start_epoch, opt_steps = st["epoch"], st["opt_steps"]
            acc.print("♻ 从 %s 恢复:已完成 %d 轮" % (cands[-1].parent, start_epoch))
    module = SFTModule(inner)
    module, optimizer, dl = acc.prepare(module, optimizer, dl)
    if vdl is not None:
        vdl = acc.prepare(vdl)
    STOP_ON_TARGET[0] = bool(args.stop_on_target)
    val_hist, ddp_chk, gpu_list = [], None, []
    if resume_state is not None and acc.scaler is not None and resume_state.get("scaler"):
        try:
            acc.scaler.load_state_dict(resume_state["scaler"])
        except Exception:  # noqa: BLE001
            pass

    state_file = out_dir / "train_state.json"
    t_start = time.time()
    nan_run = 0
    for epoch in range(start_epoch, args.max_epochs):
        module.train()
        inner.speaker_encoder.eval()                                   # 说话人编码器冻结:BatchNorm 统计量不能被训练数据改动
        run_loss, run_n, t_ep = 0.0, 0, time.time()
        for batch in dl:
            with acc.accumulate(module):
                loss = module(**batch)
                if not torch.isfinite(loss):
                    nan_run += 1
                    if nan_run > 30:
                        raise RuntimeError("连续 30 步 loss 为 NaN(fp16 数值溢出)。请降低 --lr(例如 1e-4)后重试。")
                acc.backward(loss)
                if acc.sync_gradients:
                    acc.clip_grad_norm_(trainable, 1.0)
                optimizer.step()
                optimizer.zero_grad(set_to_none=True)
            if torch.isfinite(loss):
                nan_run = 0
                run_loss += float(loss.detach()); run_n += 1
            if acc.sync_gradients:
                sched.step()
                opt_steps += 1
                if main and opt_steps % args.logging_steps == 0:
                    print("[epoch %d/%d] step %d · loss %.4f · lr %.2e · %.1f min" % (epoch + 1, args.max_epochs, opt_steps,
                          run_loss / max(1, run_n), sched.get_last_lr()[0], (time.time() - t_start) / 60), flush=True)
                    write_state(state_file, status="running", epoch=epoch + 1, step=opt_steps, loss=round(run_loss / max(1, run_n), 4))
                if main and opt_steps % args.save_steps == 0:                       # 每 10 个优化步存一次 LoRA(崩溃保险)
                    torch.save({"lora": lora_state(inner), "lora_cfg": {"r": args.lora_r, "alpha": args.lora_alpha}, "epoch": epoch, "step": opt_steps},
                               ck_dir / "last_step.pt")
        acc.wait_for_everyone()
        ep_loss = run_loss / max(1, run_n)
        val_loss = None
        if vdl is not None:
            try:
                val_loss = eval_val_loss(module, vdl, acc, inner)
            except Exception as e:  # noqa: BLE001
                acc.print("⚠ 验证 loss 计算失败(%s),退回相似度选择" % e)
        if ddp_chk is None:
            try:
                ddp_chk, gpu_list = ddp_info(acc, trainable)
                acc.print("双卡校验: %s · %s" % (ddp_chk, gpu_list))
            except Exception as e:  # noqa: BLE001
                acc.print("⚠ 双卡校验失败: %s" % e)
        if main:
            d = ck_dir / ("epoch_%d" % (epoch + 1))
            d.mkdir(parents=True, exist_ok=True)
            lc = {"r": args.lora_r, "alpha": args.lora_alpha}
            lo = lora_state(inner)
            torch.save({"lora": lo, "lora_cfg": lc, "meta": {"epoch": epoch + 1, "loss": ep_loss, "base": args.base}}, d / "adapter.pt")
            torch.save({"lora": lo, "lora_cfg": lc, "opt": optimizer.state_dict(), "sched": sched.state_dict(), "epoch": epoch + 1, "opt_steps": opt_steps,
                        "scaler": acc.scaler.state_dict() if acc.scaler is not None else None}, d / "state.pt")
            print("✔ 第 %d 轮完成 · 平均 loss %.4f · 用时 %.1f 分钟 → %s" % (epoch + 1, ep_loss, (time.time() - t_ep) / 60, d), flush=True)
            sim = None
            if (epoch + 1) % args.eval_every == 0:
                torch.cuda.empty_cache()
                sim = run_eval(args, epoch + 1, d / "adapter.pt", acc.local_process_index)
            conv, overfit, bvl = None, False, None
            if val_loss is not None:
                val_hist.append((epoch + 1, val_loss, ep_loss))
                stop, reason, be, bvl, conv, overfit = decide_val(val_hist, args.patience, args.max_epochs)
                _, _, _, bs = decide(args.eval_log, epoch, args.target, 10 ** 6, 10 ** 6)
                with open(out_dir / "val_log.jsonl", "a", encoding="utf-8") as vf:
                    vf.write(json.dumps({"epoch": epoch + 1, "val_loss": val_loss, "train_loss": ep_loss}) + "\n")
            else:
                stop, reason, be, bs = decide(args.eval_log, epoch, args.target, args.patience, args.max_epochs)
                conv = bool(stop and str(reason).startswith("收敛"))
            reached = (bs is not None and bs >= args.target) if bs is not None else None
            write_state(state_file, status="running", stage="LoRA 训练(双卡 DDP)" if world > 1 else "LoRA 训练(单卡!)", epoch=epoch + 1, max_epochs=args.max_epochs, loss=round(ep_loss, 4),
                        val_loss=None if val_loss is None else round(val_loss, 4), similarity=sim, best_epoch=be, best_val_loss=bvl, best_similarity=bs, converged=conv, reason=reason, overfit=overfit,
                        ddp_check=ddp_chk, gpus=gpu_list, target=args.target, target_reached=reached, selection="val_loss" if val_loss is not None else "similarity(无验证集,可信度低)")
            ctrl_path.write_text(json.dumps({"epoch": epoch + 1, "stop": bool(stop), "reason": reason, "best_epoch": be, "best_val": bvl, "best_sim": bs, "sim": sim, "converged": conv, "overfit": overfit}), encoding="utf-8")
            keep = {be, epoch + 1, epoch}                                               # 只保留最优 + 最近两轮,省磁盘
            for old in ck_dir.glob("epoch_*"):
                k = int(old.name.split("_")[1])
                if k not in keep:
                    shutil.rmtree(old, ignore_errors=True)
