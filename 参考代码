SR = 24000
FS16 = 32767.0

try:                                      # scipy 只是加速/更准;缺失时回退
    from scipy.signal import lfilter as _lfilter, medfilt as _medfilt
except Exception:  # noqa: BLE001
    _lfilter = _medfilt = None


# ───────────────────────── 开关 ─────────────────────────
def _flag(name, default="1"):
    return str(os.environ.get(name, default)).strip().lower() not in ("0", "false", "off", "no", "")


def on(name):
    return _flag("VC_V15") and _flag("VC_V15_" + name)


SWITCH_NAMES = ("STITCH", "COMFORT", "CLICK", "EXPAND", "LEVEL", "DITHER", "REFPREP", "FORENSICS")


def switches():
    return {k: on(k) for k in SWITCH_NAMES}


def any_audio_on():
    s = switches()
    return any(s[k] for k in ("STITCH", "COMFORT", "CLICK", "EXPAND", "LEVEL", "DITHER"))


def envf(name, default):
    try:
        return float(os.environ.get(name, default))
    except Exception:  # noqa: BLE001
        return float(default)


CEIL_DB = envf("VC_V15_CEIL_DB", -1.5)              # 限幅上限(dBFS,估计真峰值)
EXPAND_TH_DB = envf("VC_V15_EXPAND_TH_DB", -52.0)    # 扩展器阈值
EXPAND_MAX_DB = envf("VC_V15_EXPAND_MAX_DB", 6.0)    # 扩展器最大衰减
ZERO_MIN_RUN = int(envf("VC_V15_ZERO_MIN_RUN", 16))  # ≥ 这么多连续精确 0 才算「数字零段」(16 样本 = 0.67ms)
CLICK_TH = envf("VC_V15_CLICK_TH", 0.30)             # 点击:偏离 7 点中值 > 0.30 满量程
COMFORT_CAP_RMS = envf("VC_V15_COMFORT_CAP", 40.0)   # 舒适噪声 RMS 上限(int16 量纲,40 ≈ -58dBFS)


def db(x, floor=1e-9):
    return 20.0 * math.log10(max(float(x), floor))


# ───────────────────────── 噪声 / 抖动 ─────────────────────────
def colored_noise(rng, n, rms):
    """低通整形的平稳噪声(底噪主要集中在低频):白噪声 × [.5,.35,.15] FIR,再归一到给定 RMS(int16 量纲)。"""
    if n <= 0:
        return np.zeros(0, np.float32)
    w = rng.standard_normal(n + 2).astype(np.float32)
    y = 0.5 * w[2:] + 0.35 * w[1:-1] + 0.15 * w[:-2]
    s = float(np.sqrt(np.mean(y * y))) or 1.0
    return (y * (float(rms) / s)).astype(np.float32)


def tpdf(rng, n):
    return (rng.random(n) - rng.random(n)).astype(np.float32)           # 三角分布 ±1 LSB


def quantize(y, rng=None, dither=True):
    """float(int16 量纲) → int16:可选 TPDF 抖动,饱和(不回绕)。"""
    y = np.asarray(y, np.float32)
    if dither and rng is not None:
        y = y + tpdf(rng, len(y))
    return np.clip(np.round(y), -FS16, FS16).astype("<i2")


class FloorEst:
    """从「安静但非数字零」的 10ms 帧估计该说话人的静音底噪(int16 RMS)。取较低分位数,避免把语音当底噪。"""

    def __init__(self, maxn=300):
        self.v = deque(maxlen=maxn)

    def feed(self, y):
        y = np.asarray(y, np.float32)
        n = len(y) // 240
        if n <= 0:
            return
        r = np.sqrt((y[: n * 240].reshape(n, 240) ** 2).mean(axis=1))
        for x in r:
            if 0.5 <= x < 110.0:
                self.v.append(float(x))

    def rms(self):
        if len(self.v) < 5:
            return None
        return float(np.percentile(np.asarray(self.v), 30))


def comfort_rms(floor_rms):
    """停顿用的舒适噪声电平:约为实测静音底噪的一半(−6dB),夹在 [3, CAP];没有估计时取 6(≈ -75dBFS)。"""
    if not floor_rms:
        return 6.0
    return float(min(COMFORT_CAP_RMS, max(3.0, 0.5 * floor_rms)))


def pause_fill(n, rms, seed=0, fade_ms=8.0):
    """句间停顿:n 个样本的舒适噪声(int16 LE bytes),首尾余弦淡化,永远不输出数字零。"""
    if n <= 0:
        return b""
    rng = np.random.default_rng(seed)
    y = colored_noise(rng, n, rms)
    f = min(n // 2, int(SR * fade_ms / 1000.0))
    if f > 1:
        w = (0.5 * (1 - np.cos(np.pi * np.arange(f) / f))).astype(np.float32)
        y[:f] *= w
        y[-f:] *= w[::-1]
    return quantize(y, rng, True).tobytes()


# ───────────────────────── 真峰值估计 ─────────────────────────
def oversampled_peak(x):
    """4× Catmull-Rom 插值估计每个样本区间内的峰值(绝对值,与输入同量纲)。返回长度 = len(x) 的数组。"""
    x = np.asarray(x, np.float32)
    n = len(x)
    if n < 4:
        return np.abs(x)
    p = np.concatenate([[x[0]], x, [x[-1], x[-1]]])
    p0, p1, p2, p3 = p[:-3], p[1:-2], p[2:-1], p[3:]
    pk = np.abs(p1)
    for t in (0.25, 0.5, 0.75):
        v = 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t + (-p0 + 3 * p1 - 3 * p2 + p3) * t ** 3)
        pk = np.maximum(pk, np.abs(v))
    return pk[:n]


def true_peak_db(x):
    """x 为 float(±1 满量程)或 int16;返回估计真峰值 dBFS。"""
    x = np.asarray(x)
    if x.size == 0:
        return -120.0
    if x.dtype.kind in "iu":
        x = x.astype(np.float32) / 32768.0
    return db(float(oversampled_peak(x.astype(np.float32)).max()))


# ───────────────────────── 段内拼接 / 修复 / 限幅(流式,逐块调用) ─────────────────────────
class SegStitch:
    """每个句段一个实例。process(int16 块) → int16 块(样本数守恒);flush 只在句尾做淡出(样本数不变)。
    处理顺序:零段填充 → DC 高通 → 块边界跳变平滑 → 点击修复 → 下行扩展 → 软限幅 → TPDF 量化。
    所有步骤都是状态化的(跨块连续),并有独立开关;输入已干净时输出与输入的差值能量远低于 -60dB(见 tests)。"""
    HIST = 8

    def __init__(self, sw=None, seed=1234, floor=None):
        self.sw = sw or switches()
        self.rng = np.random.default_rng(seed)
        self.floor = floor if floor is not None else FloorEst()
        self.hist = np.zeros(self.HIST, np.float32)
        self.started = False
        self.in_zero = 0
        self.dc_zi = np.zeros(1, np.float64)
        self.dc_mean = 0.0
        self.exp_gdb = 0.0
        self.lim_g = 1.0
        self.last = 0.0
        self.n = 0
        self.st = {"zero_runs": 0, "zero_samples": 0, "joins_fixed": 0, "clicks": 0, "limited_db": 0.0, "expanded_frames": 0, "samples": 0}

    # --- ① 数字零段:填舒适噪声,两侧硬边做 2ms 余弦淡化 ---
    def _fill_zero(self, y):
        n = len(y)
        z = (y == 0)
        if not z.any() and self.in_zero == 0:
            return y
        e = np.diff(np.concatenate([[0], z.astype(np.int8), [0]]))
        starts, ends = np.where(e == 1)[0], np.where(e == -1)[0]
        lvl = comfort_rms(self.floor.rms())
        F = int(0.002 * SR)
        for s, t in zip(starts, ends):
            prior = self.in_zero if s == 0 else 0
            if prior + (t - s) < ZERO_MIN_RUN:
                continue
            y[s:t] = colored_noise(self.rng, t - s, lvl)
            if prior == 0:
                self.st["zero_runs"] += 1
            self.st["zero_samples"] += int(t - s)
            if s > 0 and abs(y[s - 1]) > 300:                         # 语音被硬截断为零 → 淡出
                m = min(F, s)
                y[s - m:s] *= (0.5 * (1 + np.cos(np.pi * np.arange(1, m + 1) / m))).astype(np.float32)
            if t < n and abs(y[t]) > 300:                             # 从数字零硬起到响亮语音 → 淡入
                m = min(F, n - t)
                y[t:t + m] *= (0.5 * (1 - np.cos(np.pi * np.arange(m) / m))).astype(np.float32)
        if z[-1]:
            nz = np.where(~z)[0]
            self.in_zero = int(n - (nz[-1] + 1)) if nz.size else n + self.in_zero
        else:
            self.in_zero = 0
        return y

    # --- ② 直流偏移:慢速 EMA(0.5s)估计,只有 |DC| > 40 LSB(≈0.0012 满量程)且已累计 0.25s 才扣除(干净语音完全不动;不用高通,避免低频相移) ---
    def _dc(self, y):
        m = float(y.mean())
        a = 1.0 if self.n == 0 else min(1.0, len(y) / (0.5 * SR))
        self.dc_mean += a * (m - self.dc_mean)
        if self.n >= SR // 4 and abs(self.dc_mean) > 40.0:
            return y - np.float32(self.dc_mean)
        return y

    # --- ③ 块边界跳变平滑:块首样本与线性外推预测差太大 → 3ms 衰减偏移修正 ---
    def _join(self, y):
        if not self.started or len(y) < 8:
            return y
        h = self.hist
        pred = 2 * h[-1] - h[-2]
        jump = float(y[0] - pred)
        thr = max(0.06 * FS16, 6.0 * float(np.std(np.diff(h))))
        if abs(jump) > thr:
            L = min(len(y), int(0.003 * SR))
            y[:L] -= (jump * 0.5 * (1 + np.cos(np.pi * np.arange(L) / L))).astype(np.float32)
            self.st["joins_fixed"] += 1
        return y

    # --- ④ 点击:孤立尖峰(≤3 样本),偏离 7 点中值 > CLICK_TH 满量程 ---
    def _clicks(self, y):
        ext = np.concatenate([self.hist, y]).astype(np.float64)
        if _medfilt is not None:
            m = _medfilt(ext, 7)
        else:
            from numpy.lib.stride_tricks import sliding_window_view
            pad = np.concatenate([np.full(3, ext[0]), ext, np.full(3, ext[-1])])
            m = np.median(sliding_window_view(pad, 7), axis=1)
        dev = np.abs(ext - m)[self.HIST:]
        bad = dev > CLICK_TH * FS16
        if not bad.any():
            return y
        idx = np.where(bad)[0]                                        # 只修孤立点(连续 > 3 个超限样本更像真实的大幅波形,不碰)
        runs, start = [], idx[0]
        for a, b in zip(idx[:-1], idx[1:]):
            if b != a + 1:
                runs.append((start, a))
                start = b
        runs.append((start, idx[-1]))
        for a, b in runs:
            if b - a + 1 <= 3:
                y[a:b + 1] = m[self.HIST + a:self.HIST + b + 1].astype(np.float32)
                self.st["clicks"] += 1
        return y

    # --- ⑤ 平滑下行扩展器(只动 < -52dBFS 的底噪;下行 30ms 缓慢,上行瞬时 = 不吃语音起音) ---
    def _expand(self, y):
        n = len(y)
        F = 120
        nf = (n + F - 1) // F
        pad = np.zeros(nf * F, np.float32)
        pad[:n] = y
        r = np.sqrt((pad.reshape(nf, F) ** 2).mean(axis=1)) / FS16
        lvl = 20 * np.log10(np.maximum(r, 1e-6))
        tgt = -EXPAND_MAX_DB * np.clip((EXPAND_TH_DB - lvl) / 6.0, 0.0, 1.0)
        ka = 1 - math.exp(-5.0 / 30.0)
        g, prev = np.empty(nf, np.float32), self.exp_gdb
        for i in range(nf):
            prev = (prev + (tgt[i] - prev) * ka) if tgt[i] < prev else tgt[i]
            g[i] = prev
        if not (g < -0.02).any() and abs(self.exp_gdb) < 0.02:
            self.exp_gdb = float(prev)
            return y
        if (g < -0.5).any():
            self.st["expanded_frames"] += int((g < -0.5).sum())
        gs = np.repeat(g, F)[:n].astype(np.float64)
        K = 24                                                       # 1ms 平滑,避免帧边界阶跃
        if n > K:                                                    # 块内前视 1ms:上行(开门)提前完成,不吃语音起音;下行不提前
            gs = np.maximum(gs, np.concatenate([gs[K:], np.full(K, gs[-1])]))
        ext = np.concatenate([np.full(K - 1, self.exp_gdb), gs])
        gs = np.convolve(ext, np.ones(K) / K, mode="valid")[:n]
        self.exp_gdb = float(prev)
        return (y * (10 ** (gs / 20.0)).astype(np.float32)).astype(np.float32)

    # --- ⑥ 真峰值前视软限幅(平滑增益衰减,禁止削顶) ---
    def _limit(self, y):
        ceil = 10 ** (CEIL_DB / 20.0) * FS16
        pk = oversampled_peak(y)
        if float(pk.max()) <= ceil and self.lim_g >= 0.9999:
            return y
        need = np.minimum(1.0, ceil / np.maximum(pk, 1.0)).astype(np.float32)
        w = int(0.003 * SR)
        from numpy.lib.stride_tricks import sliding_window_view
        mn = sliding_window_view(np.concatenate([np.full(w, self.lim_g, np.float32), need, np.ones(w, np.float32)]), 2 * w + 1).min(axis=1)
        k = np.hanning(2 * w + 1).astype(np.float32)
        k /= k.sum()
        sm = np.convolve(np.concatenate([np.full(w, self.lim_g, np.float32), mn, np.ones(w, np.float32)]), k, mode="same")[w:-w]
        sm = np.minimum(sm, need)
        if self.lim_g < 0.9999:                                       # 释放 60ms,跨块连续
            sm = np.minimum(sm, (1.0 - (1.0 - self.lim_g) * np.exp(-np.arange(len(y)) / (0.06 * SR))).astype(np.float32))
            sm = np.minimum(sm, need)
        self.st["limited_db"] = max(self.st["limited_db"], -db(float(sm.min()), 1e-3))
        self.lim_g = float(sm[-1])
        return (y * sm).astype(np.float32)

    def process(self, x):
        x = np.asarray(x)
        if x.size == 0:
            return x.astype("<i2")
        sw = self.sw
        if not any(sw.get(k) for k in ("STITCH", "CLICK", "EXPAND", "LEVEL", "DITHER")):
            return x.astype("<i2")
        y = x.astype(np.float32)
        self.st["samples"] += len(y)
        self.floor.feed(y)
        if sw.get("STITCH"):
            y = self._fill_zero(y)
            y = self._dc(y)
            y = self._join(y)
        if sw.get("CLICK"):
            y = self._clicks(y)
        if sw.get("EXPAND"):
            y = self._expand(y)
        if sw.get("LEVEL"):
            y = self._limit(y)
        out = quantize(y, self.rng, bool(sw.get("DITHER")))
        self.hist = np.concatenate([self.hist, out.astype(np.float32)])[-self.HIST:]
        self.started = True
        self.n += len(out)
        self.last = float(out[-1])
        return out

    def flush(self, tail_pcm=None):
        """句尾:如果最后一个样本还不接近 0,对 tail_pcm 的最后 12ms 做余弦淡出(样本数不变)。"""
        if tail_pcm is None or not len(tail_pcm) or not self.sw.get("STITCH"):
            return tail_pcm
        t = np.asarray(tail_pcm).astype("<i2")
        if abs(int(t[-1])) <= 100:
            return t
        m = min(len(t), int(0.012 * SR))
        t = t.copy()
        t[-m:] = np.round(t[-m:].astype(np.float32) * (0.5 * (1 + np.cos(np.pi * np.arange(1, m + 1) / m))).astype(np.float32)).astype("<i2")
        return t


# ───────────────────────── 取证(也是运行时质量守卫) ─────────────────────────
def _to_float(pcm):
    a = np.asarray(pcm)
    if a.dtype.kind in "iu":
        return a.astype(np.float32) / 32768.0
    return a.astype(np.float32)


def zero_runs(x, min_len=48):
    """返回 [(start, length)]:≥ min_len 的连续精确 0 且前后都有信号(不含开头/结尾的静音)。"""
    z = (np.asarray(x) == 0).astype(np.int8)
    e = np.diff(np.concatenate([[0], z, [0]]))
    s, t = np.where(e == 1)[0], np.where(e == -1)[0]
    return [(int(a), int(b - a)) for a, b in zip(s, t) if b - a >= min_len and a > 0 and b < len(z)]


def analyze(pcm, sr=SR):
    """客观取证指标(满量程 ±1)。每项都可单独复现;不含任何「听感」判断。"""
    x = _to_float(pcm)
    n = len(x)
    if n < 480:
        return {"n": n, "ok": True, "problems": [], "note": "太短,未分析"}
    pk = float(np.abs(x).max())
    fr = 480
    nf = n // fr
    f = x[: nf * fr].reshape(nf, fr)
    r = np.sqrt((f ** 2).mean(axis=1))
    rdb = 20 * np.log10(np.maximum(r, 1e-6))
    voiced = r > max(10 ** (-45 / 20), float(np.percentile(r, 90)) * 0.1)
    rms_v = float(np.sqrt((f[voiced] ** 2).mean())) if voiced.any() else 0.0
    floor = float(np.percentile(rdb, 5))
    d = np.abs(np.diff(x))
    zr = zero_runs(np.asarray(pcm) if np.asarray(pcm).dtype.kind in "iu" else np.round(x * 32768), min_len=int(0.002 * sr))
    from numpy.lib.stride_tricks import sliding_window_view
    pad = np.concatenate([np.full(3, x[0]), x, np.full(3, x[-1])])
    dev = np.abs(x - np.median(sliding_window_view(pad, 7), axis=1))
    w = 1200                                                                   # 50ms 窗 RMS 台阶(语音内):相邻窗 > 12dB
    nw = n // w
    steps = 0
    if nw > 2:
        rw = np.sqrt((x[: nw * w].reshape(nw, w) ** 2).mean(axis=1))
        ok = (rw[:-1] > 10 ** (-40 / 20)) & (rw[1:] > 10 ** (-40 / 20))
        if ok.any():
            steps = int((np.abs(20 * np.log10(np.maximum(rw[1:], 1e-9) / np.maximum(rw[:-1], 1e-9)))[ok] > 12.0).sum())
    rep = {
        "n": n, "seconds": round(n / sr, 2),
        "peak_dbfs": round(db(pk), 2),
        "true_peak_dbfs": round(true_peak_db(x), 2),
        "rms_voiced_dbfs": round(db(rms_v), 2),
        "clip_samples": int((np.abs(x) >= 0.999).sum()),
        "dc": round(float(x.mean()), 5),
        "zero_runs": len(zr), "zero_samples": int(sum(l for _, l in zr)),
        "jumps_gt_025": int((d > 0.25).sum()),
        "click_like": int((dev > CLICK_TH).sum()),
        "noise_floor_dbfs": round(floor, 1),
        "noise_rel_voiced_db": round(floor - db(rms_v), 1) if rms_v > 0 else None,
        "level_steps_gt_12db": steps,
        "head_rms_10ms": round(float(np.sqrt((x[:240] ** 2).mean())), 4),
        "tail_rms_10ms": round(float(np.sqrt((x[-240:] ** 2).mean())), 4),
        "nan_inf": int((~np.isfinite(x)).sum()),
    }
    bad = []
    if rep["zero_runs"]:
        bad.append("数字零段 %d 处" % rep["zero_runs"])
    if rep["clip_samples"]:
        bad.append("削波 %d 样本" % rep["clip_samples"])
    if rep["true_peak_dbfs"] > -0.5:
        bad.append("真峰值 %.1f dBFS 过高" % rep["true_peak_dbfs"])
    if rep["click_like"]:
        bad.append("疑似 click %d 处" % rep["click_like"])
    if rep["nan_inf"]:
        bad.append("NaN/Inf")
    rep["problems"] = bad
    rep["ok"] = not bad
    return rep


# ───────────────────────── 参考语音管线(方案 A) ─────────────────────────
def highpass_zero_phase(a, sr, fc=50.0):
    """零相位 2 阶 Butterworth 高通(去除房间隆隆声/直流,不改相位)。没有 scipy 时只去直流。"""
    a = np.asarray(a, np.float32)
    try:
        from scipy.signal import butter, sosfiltfilt
        sos = butter(2, fc / (sr / 2.0), btype="highpass", output="sos")
        return sosfiltfilt(sos, a.astype(np.float64)).astype(np.float32)
    except Exception:  # noqa: BLE001
        return (a - float(a.mean())).astype(np.float32)


def edge_fade(a, sr, ms=10.0):
    a = np.asarray(a, np.float32).copy()
    m = min(len(a) // 2, int(sr * ms / 1000.0))
    if m > 1:
        w = (0.5 * (1 - np.cos(np.pi * np.arange(m) / m))).astype(np.float32)
        a[:m] *= w
        a[-m:] *= w[::-1]
    return a


def ref_quality(a, sr):
    """参考语音质量评分(0~100)+ 明确的「建议重录」判断。SNR = P90 帧电平 − P10 帧电平(粗略,启发式)。"""
    a = np.asarray(a, np.float32)
    n = len(a)
    if n < sr:
        return {"score": 0, "redo": True, "reasons": ["参考语音短于 1 秒"], "seconds": round(n / sr, 2)}
    fr = sr // 50
    nf = n // fr
    r = np.sqrt((a[: nf * fr].reshape(nf, fr) ** 2).mean(axis=1))
    rdb = 20 * np.log10(np.maximum(r, 1e-6))
    blk = 150                                                                    # 3 秒一块:取「最吵的一块」的底噪(局部噪声也算)
    floors = [float(np.percentile(rdb[i:i + blk], 15)) for i in range(0, max(1, nf - blk // 3), blk)] or [float(np.percentile(rdb, 10))]
    snr = float(np.percentile(rdb, 90) - max(floors))
    pk = float(np.abs(a).max())
    clip = float((np.abs(a) >= 0.999).mean())
    seg = a[: min(n, sr * 20)]                                                   # 带宽:能量 99.5% 滚降频率
    sp = np.abs(np.fft.rfft(seg * np.hanning(len(seg)))) ** 2
    cum = np.cumsum(sp) / max(float(sp.sum()), 1e-12)
    roll = float(np.searchsorted(cum, 0.995)) / len(sp) * sr / 2.0
    score, why, sec = 100.0, [], n / sr
    if sec < 6:
        score -= 25
        why.append("时长 %.1f 秒偏短(建议 10~25 秒连续自然语音)" % sec)
    if snr < 25:
        score -= 45 if snr < 15 else 30
