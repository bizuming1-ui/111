            try:
                sim = eng.score(pcm_all)
            except Exception as e:  # noqa: BLE001
                log.warning("[GPU%d] 打分失败: %s", idx, e)
        send("sim", tuid, seg_i, sim, len(pcm_all) / SR)

    def run_tts(job):
        _, tuid, ep, seg, text, prof, seed = job
        if epoch.value != ep:
            send("seg_done", tuid, seg, idx, {"skipped": True})
            return
        max_new = min(MAX_NEW_TOKENS, max(120, int(len(text) * 7)))
        for attempt in range(2):                                    # 只有「还没送出任何音频」的失败才会用新种子重试一次(可复现:seed+attempt)
            cur = int(seed) + attempt
            t0, first, nsamp, sent_any, cancelled = time.time(), None, 0, False, False
            acc, ch, t_prev = [], [], t0                            # ch: 每块 (耗时, 样本数) —— 网关据此拟合「每帧生成时间 / 每块解码开销 / 预填充」
            qc = SegmentQC()
            err = None
            eng.last_frames = 0
            gen = eng.stream(text, prof, cur)
            try:
                for a, sr in gen:
                    if epoch.value != ep:                           # 用户已取消/重连:立刻停止生成,把 GPU 让给下一个任务
                        cancelled = True
                        break
                    if int(sr) != SR:
                        raise AudioCorrupt("块采样率 %s != %d" % (sr, SR))
                    pcm = _f2pcm(a)
                    if pcm.size == 0:
                        continue
