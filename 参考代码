  $("tag").textContent = m[0]; $("tag").className = "tag " + m[1]; $("sTxt").textContent = m[0]; $("sDot").className = "dot " + m[2];
}

/* ═════════ WebSocket(hello / 重连续传 / 帧校验 / ack) ═════════ */
const SID = (() => { let s = null; try { s = sessionStorage.getItem("vc_sid"); } catch (e) {} if (!s) { s = Math.random().toString(36).slice(2) + Date.now().toString(36); try { sessionStorage.setItem("vc_sid", s); } catch (e) {} } return s; })();
function wsUrl() { return WS_URL.indexOf("{{") < 0 && WS_URL ? WS_URL : (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws"; }
function connect() {
  clearTimeout(S.rcT); setPhase(S.phase === "idle" || S.phase === "bad" ? "conn" : S.phase);
  let ws; try { ws = new WebSocket(wsUrl()); } catch (e) { return retry(); }
  ws.binaryType = "arraybuffer"; S.ws = ws;
  ws.onopen = () => {
    S.wsOk = true; S.retry = 0; $("dConn").className = "dot ok"; $("tConn").textContent = "已连接"; log("WebSocket 已连接", "o");
    const hello = { type: "hello", sid: SID };
    if (curOk() && !CUR.ended && CUR.chk) { hello.resume = { turn: CUR.uid, next_seq: CUR.chk.expected }; CUR.reconnects++; }
    ws.send(JSON.stringify(hello));
    if (!curOk()) setPhase("idle"); ping(); clearInterval(S.pingT); S.pingT = setInterval(ping, 4000);
  };
