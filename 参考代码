        raise ActionError("所有可见搜索引擎都没有返回结果:" + ";".join("%s:%s" % (n, m[:50]) for n, m in fails) + "。可以改写关键词,或点「人工接管」自己查看页面")

    # —— 任务 ——
    async def run(self, actions, title):
        async with self.mgr.sem:
            self.mgr.queued = max(0, self.mgr.queued - 1)
            self.cancel_flag = False
            self.pause_ev.set()
            self.steps_done = 0
            self.task_title = title[:80]
            self.set_status("running", "")
            t0 = time.time()
            try:
                await self.ensure()
                for i, a in enumerate(actions):
                    await self._gate()
                    if time.time() - t0 > TASK_TIMEOUT_S:
                        raise ActionError("任务超时(%d 秒)" % TASK_TIMEOUT_S, fatal=True)
                    self.add_log("step", "步骤 %d/%d:%s" % (i + 1, len(actions), a["action"]))
                    self.emit({"type": "step", "i": i + 1, "n": len(actions), "action": a, "state": "start"})
                    while True:
                        try:
                            await asyncio.wait_for(self.do(a), STEP_TIMEOUT_S * 3)
                            break
                        except NeedHuman as e:
                            self.pause_ev.clear()
                            self.set_status("waiting_human", str(e))
                            await self._gate()
                            self.set_status("running", "")
                            self.add_log("control", "用户处理完毕,从当前步骤重试")
                        except asyncio.TimeoutError:
                            raise ActionError("单步超时")
                    self.steps_done = i + 1
                    self.emit({"type": "step", "i": i + 1, "n": len(actions), "action": a, "state": "ok"})
                self.set_status("done", "任务完成(%d 步,%.1f 秒)" % (len(actions), time.time() - t0))
                self.add_log("system", "任务完成:%d 步" % len(actions))
                self.mgr.audit_event("browser_task", "ok", (time.time() - t0) * 1000, self.sid, steps=len(actions))
            except asyncio.CancelledError:
                self.set_status("cancelled", "已取消")
                self.mgr.audit_event("browser_task", "cancelled", (time.time() - t0) * 1000, self.sid, steps=self.steps_done)
            except ActionError as e:
                self.add_log("error", str(e))
                if e.fatal:
                    self.set_status("error", str(e))
                else:
                    self.pause_ev.clear()
                    self.set_status("paused", "已暂停:%s。你可以点「继续」跳过、「人工接管」处理,或「取消」" % e)
                    try:
                        await self._gate()
                        self.set_status("done", "已按你的选择跳过失败步骤并结束")
                    except asyncio.CancelledError:
                        self.set_status("cancelled", "已取消")
                self.mgr.audit_event("browser_task", "error", (time.time() - t0) * 1000, self.sid, err="ActionError", steps=self.steps_done)
            except Exception as e:  # noqa: BLE001
                self.add_log("error", "%s: %s" % (type(e).__name__, str(e)[:150]))
                self.set_status("error", "%s: %s" % (type(e).__name__, str(e)[:120]))
                self.mgr.audit_event("browser_task", "error", (time.time() - t0) * 1000, self.sid, err=type(e).__name__, steps=self.steps_done)

    def start(self, actions, title):
        if self.task and not self.task.done():
            raise ActionError("当前会话已有任务在运行(请先取消或等待完成)")
        if self.mgr.queued >= MAX_QUEUED:
            raise ActionError("浏览器任务队列已满(%d),请稍后再试" % MAX_QUEUED)
        self.mgr.queued += 1
        self.task = asyncio.ensure_future(self.run(actions, title))
        if self.mgr.sem.locked():
            self.set_status("queued", "排队中(同时运行上限 %d)" % MAX_RUNNING)

    # —— 人工接管:用户亲自操作,键入内容不记录 ——
    async def human(self, m):
        if self.status in ("running", "waiting_confirm"):
            raise ActionError("请先点「暂停」再接管")
        await self.ensure()
        pg = self.page
        k = m.get("kind")
        if k == "click":
            x, y = max(0, min(VIEW[0], float(m["x"]))), max(0, min(VIEW[1], float(m["y"])))
            await self._mouse_to(x, y, "move")
            await pg.mouse.click(x, y)
            self.cursor = {"x": round(x), "y": round(y), "kind": "click", "t": time.time()}
            self.emit({"type": "cursor", **self.cursor, "vw": VIEW[0], "vh": VIEW[1]})
            self.add_log("user", "用户点击 (%d,%d)" % (x, y))
        elif k == "type":
            t = str(m.get("text", ""))[:200]
            await pg.keyboard.type(t, delay=15)
            self.add_log("user", "用户输入了 %d 个字符(内容不记录)" % len(t))
        elif k == "key" and m.get("key") in KEYS:
            await pg.keyboard.press(m["key"])
            self.add_log("user", "用户按键 %s" % m["key"])
        elif k == "scroll":
            await pg.mouse.wheel(0, max(-2000, min(2000, int(m.get("dy", 400)))))
        elif k == "goto":
            await self.do({"action": "goto", "url": str(m.get("url", ""))})
        else:
            raise ActionError("未知的接管操作")
        self.last_used = time.time()


class BrowserManager:
    def __init__(self, tts_busy=lambda: False, audit_event=None):
        self._pw = None
        self._br = None
        self.sessions = {}
        self.sem = asyncio.Semaphore(MAX_RUNNING)
        self.queued = 0
        self.tts_busy = tts_busy
        self._audit = audit_event
        self._lock = asyncio.Lock()
        self.error = None
        self.reaper = None
        self.proxy = None

    def proxy_blocked(self):
        return self.proxy.blocked if self.proxy else 0

    def audit_event(self, *a, **kw):
        if self._audit:
            try:
                self._audit(*a, **kw)
            except Exception:  # noqa: BLE001
                pass

    @staticmethod
    def available():
        try:
            import playwright  # noqa: F401
        except Exception as e:  # noqa: BLE001
            return False, "未安装 playwright(%s)" % e
        try:
            import search_providers
            if not search_providers.chromium_installed():
                return False, "playwright 已安装但没有找到 Chromium 可执行文件(请运行 playwright install chromium)"
        except Exception:  # noqa: BLE001
            pass
        return True, ""

    async def browser(self):
        async with self._lock:
            if self._br is not None and self._br.is_connected():
                return self._br
            ok, why = self.available()
            if not ok:
                self.error = why
                raise ActionError(why, fatal=True)
            from playwright.async_api import async_playwright
            try:
                if self._pw is None:
                    self._pw = await async_playwright().start()
                if self.proxy is None:
                    self.proxy = GuardProxy()
                    await self.proxy.start()
                self._br = await self._pw.chromium.launch(headless=True, proxy={"server": "http://127.0.0.1:%d" % self.proxy.port, "bypass": "<-loopback>"}, args=["--no-sandbox", "--disable-gpu", "--disable-dev-shm-usage", "--disable-extensions", "--mute-audio",
                                                                                "--disable-background-networking", "--disable-sync", "--no-first-run", "--disable-features=Translate"])
            except Exception as e:  # noqa: BLE001
                self.error = "Chromium 启动失败:%s(Kaggle 上请先运行 playwright install --with-deps chromium;缺系统库时 Chromium 会立刻退出)" % str(e).splitlines()[0][:150]
                raise ActionError(self.error, fatal=True)
            self.error = None
            if self.reaper is None:
                self.reaper = asyncio.ensure_future(self._reap())
            return self._br

    async def _reap(self):
        while True:
            await asyncio.sleep(30)
            for sid, s in list(self.sessions.items()):
                if time.time() - s.last_used > IDLE_TTL_S and not s.subs and not (s.task and not s.task.done()):
                    await s.close()
                    self.sessions.pop(sid, None)

    def get(self, sid, create=True):
        s = self.sessions.get(sid)
        if s is None and create:
            if len(self.sessions) >= MAX_SESSIONS:
                raise ActionError("浏览器会话数已达上限 %d(请先关闭其他会话)" % MAX_SESSIONS)
            s = self.sessions[sid] = BSession(self, sid)
        return s

    async def close_session(self, sid):
        s = self.sessions.pop(sid, None)
        if s:
            await s.close()

    async def shutdown(self):
        for sid in list(self.sessions):
            await self.close_session(sid)
        try:
            if self.proxy:
                await self.proxy.stop()
                self.proxy = None
            if self._br:
                await self._br.close()
            if self._pw:
                await self._pw.stop()
        except Exception:  # noqa: BLE001
            pass

    def status(self):
        ok, why = self.available()
        return {"available": ok, "reason": why or self.error, "browser_up": bool(self._br and self._br.is_connected()), "sessions": len(self.sessions), "max_sessions": MAX_SESSIONS,
                "max_pages": MAX_PAGES, "max_steps": MAX_STEPS, "running_limit": MAX_RUNNING, "queued": self.queued, "fps": FPS, "fps_when_tts": FPS_BUSY, "device": "CPU(不占用 GPU)",
                "step_timeout_s": STEP_TIMEOUT_S, "task_timeout_s": TASK_TIMEOUT_S,
                "network_guard": {"proxy_port": self.proxy.port if self.proxy else None, "blocked": self.proxy_blocked(), "recent": list(self.proxy.events)[-5:] if self.proxy else []},
                "bytes_sent": sum(s.bytes_sent for s in self.sessions.values()), "frames": sum(s.frames for s in self.sessions.values())}
'''

