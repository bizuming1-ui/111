            raise StoreError("磁盘空间不足:剩余 %.0fMB,需要至少 %.0fMB(原件+处理版+保留空间)。没有删除任何已有样本。" % (du.free / 1048576, need / 1048576), 507)
        if self.quota and self.usage()["used_bytes"] + incoming_bytes * 2 > self.quota:
            raise StoreError("超出存储配额 %dMB;没有删除任何已有样本" % (self.quota >> 20), 507)

    # ───────── 语音库 ─────────
    def create(self, name, consent=False, category="speech"):
        name = (name or "").strip()[:60]
        if not name:
            raise StoreError("请填写语音库名称")
        with self.lock:
            lib_id = _id("lib")
            lib = {"library_id": lib_id, "name": name, "category": category if category in ("speech", "singing") else "speech", "created_at": now_iso(), "updated_at": now_iso(),
                   "consent": {"confirmed": bool(consent), "at": now_iso() if consent else None, "statement": "声音属于本人或已获得所有者明确授权"},
                   "samples": [], "ref_sample_id": None, "datasets": [], "jobs": [], "checkpoints": {"current": None, "history": [], "candidates": []},
                   "eval": None, "eval_history": [], "schema": SCHEMA}
            (self._lp(lib_id) / "samples").mkdir(parents=True, exist_ok=True)
            self._save(lib)
            self.idx["order"].append(lib_id)
            if not self.idx.get("active"):
                self.idx["active"] = lib_id
            self._save_index()
            return lib

    def get(self, lib_id):
        return self._load(lib_id)

    def rename(self, lib_id, name):
        name = (name or "").strip()[:60]
        if not name:
            raise StoreError("名称不能为空")
        with self.lock:
            lib = self._load(lib_id)
            lib["name"] = name
            self._save(lib)
            return lib

    def set_consent(self, lib_id, confirmed):
        with self.lock:
            lib = self._load(lib_id)
            lib["consent"].update(confirmed=bool(confirmed), at=now_iso() if confirmed else None)
            self._save(lib)
            return lib

    def set_active(self, lib_id):
        with self.lock:
            self._load(lib_id)
            self.idx["active"] = lib_id
            self._save_index()

    @property
    def active_id(self):
        return self.idx.get("active")

    def impact(self, lib_id):
        lib = self._load(lib_id)
        size = sum(f.stat().st_size for f in self._lp(lib_id).rglob("*") if f.is_file())
        return {"library_id": lib_id, "name": lib["name"], "samples": len(lib["samples"]), "datasets": len(lib["datasets"]), "jobs": len(lib["jobs"]),
                "checkpoints": len(lib["checkpoints"]["candidates"]) + len(lib["checkpoints"]["history"]) + (1 if lib["checkpoints"]["current"] else 0),
                "bytes": size, "path": str(self._lp(lib_id)),
                "warning": "将永久删除本地的原始音频、处理版、转写、数据集与模型记录;Notebook 已保存的输出版本 / 导出的备份 / 私有仓库里的副本【不会】被自动删除,需要你另行清理。"}

    def delete(self, lib_id, confirm_name):
        with self.lock:
            lib = self._load(lib_id)
            if (confirm_name or "").strip() != lib["name"]:
                raise StoreError("确认名称与语音库名称不一致,未删除")
            imp = self.impact(lib_id)
            shutil.rmtree(self._lp(lib_id), ignore_errors=False)
            self.idx["order"] = [i for i in self.idx["order"] if i != lib_id]
            if self.idx["active"] == lib_id:
                self.idx["active"] = self.idx["order"][0] if self.idx["order"] else None
            self._save_index()
            return imp

    def list(self):
        return [self.public(self._load(i)) for i in self.idx["order"]]

    def public(self, lib):
        sm = lib["samples"]
        dur = lambda L: round(sum(s.get("duration_s", 0) for s in L), 1)  # noqa: E731
        sp = [s for s in sm if s.get("category") == "speech"]
        sg = [s for s in sm if s.get("category") == "singing"]
        ck = lib["checkpoints"]
        return {"library_id": lib["library_id"], "name": lib["name"], "created_at": lib["created_at"], "updated_at": lib["updated_at"], "active": lib["library_id"] == self.idx.get("active"),
                "consent": lib["consent"], "sample_count": len(sm), "total_seconds": dur(sm), "speech": {"n": len(sp), "seconds": dur(sp), "trusted_text": sum(1 for s in sp if s.get("text_trusted"))},
                "singing": {"n": len(sg), "seconds": dur(sg), "status": "已保存/已质检;歌声克隆:不支持/未验证"}, "ref_sample_id": lib.get("ref_sample_id"),
                "dataset_versions": [{"version": d["version"], "n": d["n_samples"], "frozen_at": d["frozen_at"], "split": d["split"]["mode"]} for d in lib["datasets"]],
                "jobs": [{k: j.get(k) for k in ("job_id", "state", "dataset_version", "created_at", "updated_at", "note", "candidate_id")} for j in lib["jobs"][-8:]],
                "checkpoint": {"current": ck["current"], "previous": ck["history"][-1] if ck["history"] else None,
                               "candidates": [{k: c.get(k) for k in ("candidate_id", "model_sha256", "dataset_version", "validated", "loaded", "trial_synth", "status", "created_at")} for c in ck["candidates"]]},
                "eval": lib.get("eval") or {"status": "not_evaluated", "label": "未评估"}, "samples": [self.public_sample(s) for s in sm]}

    @staticmethod
    def public_sample(s):
        keys = ("sample_id", "created_at", "duration_s", "sr_orig", "sr_proc", "channels", "category", "kind_zh", "text", "text_source", "text_trusted", "transcribe_state", "session",
                "orig_sha256", "proc_sha256", "qc_summary", "excluded_from_speech_training", "orig_ext", "orig_bytes", "notes", "enabled", "weight", "v16")
        return {k: s.get(k) for k in keys}

    # ───────── 样本 ─────────
    def add_sample(self, lib_id, orig_bytes, ext, proc_wav_bytes, duration_s, sr_orig, channels, qc, text="", text_source="", text_trusted=False, session=None, notes=None, sr_proc=24000):
        if not proc_wav_bytes or duration_s <= 0:
            raise StoreError("处理版音频为空,拒绝保存")
        if duration_s > self.max_seconds:
            raise StoreError("音频 %.0f 秒超过单条上限 %d 秒" % (duration_s, self.max_seconds), 413)
        with self.lock:
            lib = self._load(lib_id)
            self.check_capacity(len(orig_bytes) + len(proc_wav_bytes))
            sid = _id("smp")
            ext = re.sub(r"[^a-z0-9]", "", (ext or "bin").lower())[:5] or "bin"
            d = self._lp(lib_id) / "samples" / sid
            atomic_write_bytes(d / ("orig." + ext), orig_bytes)                  # 原件
            atomic_write_bytes(d / "proc.wav", proc_wav_bytes)                    # 处理版(另存)
            kind = (qc or {}).get("kind", "unknown")
            cat = "singing" if kind == "singing" else "speech"
            s = {"sample_id": sid, "created_at": now_iso(), "duration_s": round(float(duration_s), 2), "sr_orig": sr_orig, "sr_proc": sr_proc, "channels": channels,
                 "category": cat, "kind": kind, "kind_zh": (qc or {}).get("kind_zh", ""), "qc": qc, "orig_ext": ext, "orig_bytes": len(orig_bytes),
                 "orig_sha256": sha256_bytes(orig_bytes), "proc_sha256": sha256_bytes(proc_wav_bytes), "text": (text or "").strip(), "text_source": text_source,
                 "text_trusted": bool(text_trusted and (text or "").strip()), "transcribe_state": "user" if text_source == "user" else ("asr_unverified" if (text or "").strip() else "pending"),
                 "session": session or sid, "excluded_from_speech_training": cat != "speech" or bool((qc or {}).get("blocking")), "notes": notes or [],
                 "qc_summary": {"kind": kind, "blocking": bool((qc or {}).get("blocking")), "warnings": ((qc or {}).get("warnings") or [])[:6]}}
            lib["samples"].append(s)
            if not lib.get("ref_sample_id") and cat == "speech":
                lib["ref_sample_id"] = sid
            self._save(lib)
            return s

    def sample_paths(self, lib_id, sample_id):
        d = self._lp(lib_id) / "samples" / sample_id
        if not d.is_dir():
            raise StoreError("样本不存在", 404)
        orig = next((p for p in d.glob("orig.*")), None)
        return {"orig": orig, "proc": d / "proc.wav"}

    def update_sample_text(self, lib_id, sample_id, text, trusted=True):
        with self.lock:
            lib = self._load(lib_id)
            s = next((x for x in lib["samples"] if x["sample_id"] == sample_id), None)
            if not s:
                raise StoreError("样本不存在", 404)
            s.update(text=(text or "").strip(), text_source="user_corrected", text_trusted=bool(trusted and (text or "").strip()), transcribe_state="user_verified" if (text or "").strip() else "pending")
            self._save(lib)
            return s

    def set_sample_category(self, lib_id, sample_id, category):
        if category not in ("speech", "singing"):
            raise StoreError("分类只能是 speech / singing")
        with self.lock:
            lib = self._load(lib_id)
            s = next((x for x in lib["samples"] if x["sample_id"] == sample_id), None)
            if not s:
                raise StoreError("样本不存在", 404)
            s["category"] = category
            s["excluded_from_speech_training"] = category != "speech"
            self._save(lib)
            return s

    def update_sample_meta(self, lib_id, sample_id, enabled=None, weight=None, v16=None, asr_text=None):
        """v16:多参考管理(白名单字段):启用/停用、权重(0.1~3)、v16 质检信息。不改动音频与文字。"""
        with self.lock:
            lib = self._load(lib_id)
            s = next((x for x in lib["samples"] if x["sample_id"] == sample_id), None)
            if not s:
                raise StoreError("样本不存在", 404)
            if enabled is not None:
                s["enabled"] = bool(enabled)
            if weight is not None:
                s["weight"] = round(min(3.0, max(0.1, float(weight))), 3)
            if v16 is not None and isinstance(v16, dict):
                s["v16"] = dict(v16)
            if asr_text is not None and not s.get("text_trusted"):          # 自动转写只写【未核对】文字;已核对的文字永不被覆盖
                s.update(text=str(asr_text).strip(), text_source="asr_auto", text_trusted=False, transcribe_state="asr_unverified")
            self._save(lib)
            return s

    def incremental_inputs(self, lib_id):
        """v16 增量再优化的输入:当前已晋升模型(父) + 它训练时用过的样本 id(旧) + 当前所有合格样本 id(全部)。"""
        lib = self._load(lib_id)
        cur = lib["checkpoints"].get("current")
        elig = [s["sample_id"] for s in lib["samples"] if s["category"] == "speech" and s.get("text_trusted") and not (s.get("qc") or {}).get("blocking") and s.get("enabled") is not False]
        old = []
        if cur:
            ds = next((d for d in lib["datasets"] if d["version"] == cur.get("dataset_version")), None)
            keep = set(elig)
            old = [i["sample_id"] for i in (ds or {}).get("samples", []) if i["sample_id"] in keep]
        return cur, old, elig

    def set_ref(self, lib_id, sample_id):
        with self.lock:
            lib = self._load(lib_id)
            s = next((x for x in lib["samples"] if x["sample_id"] == sample_id), None)
            if not s:
                raise StoreError("样本不存在", 404)
            if s["category"] != "speech":
                raise StoreError("歌声/伴奏样本不能作为口语克隆的参考提示(未验证)")
            lib["ref_sample_id"] = sample_id
            self._save(lib)
            return s

    def sample_impact(self, lib_id, sample_id):
        lib = self._load(lib_id)
        s = next((x for x in lib["samples"] if x["sample_id"] == sample_id), None)
        if not s:
            raise StoreError("样本不存在", 404)
        used = [d["version"] for d in lib["datasets"] if any(x["sample_id"] == sample_id for x in d["samples"])]
        return {"sample_id": sample_id, "bytes": s["orig_bytes"], "is_reference": lib.get("ref_sample_id") == sample_id, "in_dataset_versions": used,
                "warning": "删除后:原件与处理版从本地移除;已冻结的数据集版本里的导出副本保留(它们属于历史训练记录);Notebook 输出/备份副本需另行清理。" + (" 这是当前参考提示,删除后会自动改选其他口语样本。" if lib.get("ref_sample_id") == sample_id else "")}

    def delete_sample(self, lib_id, sample_id):
        with self.lock:
            lib = self._load(lib_id)
            imp = self.sample_impact(lib_id, sample_id)
            lib["samples"] = [x for x in lib["samples"] if x["sample_id"] != sample_id]
            if lib.get("ref_sample_id") == sample_id:
                lib["ref_sample_id"] = next((x["sample_id"] for x in lib["samples"] if x["category"] == "speech"), None)
            shutil.rmtree(self._lp(lib_id) / "samples" / sample_id, ignore_errors=True)
            self._save(lib)
            return imp

    def choose_reference(self, lib):
        """参考提示:用户指定 > 口语 + 文字已核对 + 质检通过 + 时长 6~20 秒中最长的 > 任意口语样本"""
        sm = [s for s in lib["samples"] if s["category"] == "speech"]
        if not sm:
            return None
        sel = next((s for s in sm if s["sample_id"] == lib.get("ref_sample_id")), None)
        if sel:
            return sel
        good = [s for s in sm if s.get("text_trusted") and not (s.get("qc") or {}).get("blocking")]
        pool = [s for s in good if 6 <= s["duration_s"] <= 20] or good or sm
        return max(pool, key=lambda s: s["duration_s"])

    # ───────── 数据集版本(冻结) ─────────
    def freeze_dataset(self, lib_id, only_ids=None):
        """把【当前】口语 + 文字已核对 + 质检通过的样本冻结成新版本;之后新增样本只进入下一个版本。按录音场次(session)划分训练/验证,避免相邻切片泄漏。"""
        with self.lock:
            lib = self._load(lib_id)
            if not lib["consent"]["confirmed"]:
                raise StoreError("该语音库还没有声音授权确认,不能用于训练")
            elig = [s for s in lib["samples"] if s["category"] == "speech" and s.get("text_trusted") and not (s.get("qc") or {}).get("blocking")
                    and s.get("enabled") is not False and (only_ids is None or s["sample_id"] in only_ids)]       # v16:已停用样本不进训练;only_ids=增量集合(None=与 v15 完全一致)
            skipped = [{"sample_id": s["sample_id"], "reason": ("歌声/伴奏" if s["category"] != "speech" else "文字未核对" if not s.get("text_trusted") else "质检阻断" if (s.get("qc") or {}).get("blocking") else "已停用/不在本次增量集合")} for s in lib["samples"] if s not in elig]
            if not elig:
                raise StoreError("没有可训练的样本(需要口语 + 文字已核对 + 质检通过)。被排除:%d 条" % len(skipped))
            sessions = sorted({s["session"] for s in elig})
            if len(sessions) >= 4:
                nval = max(1, len(sessions) // 5)
                val_sessions = set(sorted(sessions, key=lambda x: sha256_bytes(x.encode()))[:nval])
                mode = "by_session"
            else:
                val_sessions, mode = set(), "no_holdout"
            ver = (lib["datasets"][-1]["version"] + 1) if lib["datasets"] else 1
            ddir = self._lp(lib_id) / "datasets" / ("v%d" % ver)
            data = ddir / "data"
            data.mkdir(parents=True, exist_ok=True)
            items = []
            for s in elig:
                src = self.sample_paths(lib_id, s["sample_id"])["proc"]
                base = "%s_%s" % (s["session"][-8:], s["sample_id"])
                shutil.copy2(src, data / (base + ".wav"))
                (data / (base + ".txt")).write_text(s["text"], encoding="utf-8")
                items.append({"sample_id": s["sample_id"], "file": base, "session": s["session"], "split": "val" if s["session"] in val_sessions else "train",
                              "proc_sha256": s["proc_sha256"], "seconds": s["duration_s"]})
            man = {"version": ver, "library_id": lib_id, "frozen_at": now_iso(), "n_samples": len(items), "seconds": round(sum(i["seconds"] for i in items), 1), "samples": items,
                   "split": {"mode": mode, "n_sessions": len(sessions), "val_sessions": len(val_sessions),
                             "note": ("按原始录音场次划分" if mode == "by_session" else "录音场次不足 4 个,没有留出验证集:训练无法做留出验证,评估不可信(建议 ≥ 4 条独立录音)")},
                   "skipped": skipped}
            man["manifest_sha256"] = sha256_bytes(json.dumps({k: v for k, v in man.items() if k != "manifest_sha256"}, sort_keys=True, ensure_ascii=False).encode())
            atomic_write_json(ddir / "manifest.json", man, backup=False)
            lib["datasets"].append({k: man[k] for k in ("version", "frozen_at", "n_samples", "seconds", "split", "manifest_sha256")} | {"samples": items, "dir": str(data)})
            self._save(lib)
            return lib["datasets"][-1]

    # ───────── 训练任务 ─────────
    def create_job(self, lib_id, params=None, dataset_version=None, only_ids=None):
        with self.lock:
            lib = self._load(lib_id)
            ds = next((d for d in lib["datasets"] if d["version"] == dataset_version), None) if dataset_version else None
            if ds is None:
                ds = self.freeze_dataset(lib_id, only_ids=only_ids)
                lib = self._load(lib_id)
            job = {"job_id": _id("job"), "state": "queued", "dataset_version": ds["version"], "dataset_manifest_sha256": ds["manifest_sha256"], "params": params or {},
                   "created_at": now_iso(), "updated_at": now_iso(), "note": "排队中:训练需要在 Kaggle 里以 MODE=\"train\" 运行(训练期间 TTS/ASR 不加载到 GPU,以免显存溢出)", "log": []}
            lib["jobs"].append(job)
            self._save(lib)
            return job

    def job_set(self, lib_id, job_id, state, note=None, **extra):
        legal = {"queued": {"running", "cancelled"}, "running": {"candidate_ready", "failed", "cancelled", "queued"}, "candidate_ready": {"promoted", "rejected"},
                 "failed": {"queued"}, "cancelled": {"queued"}, "promoted": set(), "rejected": set()}
        with self.lock:
            lib = self._load(lib_id)
            j = next((x for x in lib["jobs"] if x["job_id"] == job_id), None)
            if not j:
                raise StoreError("训练任务不存在", 404)
            if state != j["state"] and state not in legal.get(j["state"], set()):
                raise StoreError("训练任务状态不允许 %s → %s" % (j["state"], state), 409)
            j.update(state=state, updated_at=now_iso(), **extra)
            if note:
                j["note"] = note
            j["log"] = (j.get("log") or [])[-40:] + [{"t": now_iso(), "state": state, "note": note or ""}]
            self._save(lib)
            return j

    def next_queued_job(self):
        for i in self.idx["order"]:
            lib = self._load(i)
            for j in lib["jobs"]:
                if j["state"] == "queued":
                    return i, j
        return None, None

    def register_candidate(self, lib_id, job_id, model_dir, eval_summary=None):
        md = Path(model_dir)
        wf = md / "model.safetensors"
        if not wf.exists():
            raise StoreError("模型目录里没有 model.safetensors,不能登记候选模型")
        h = sha256_file(wf)
        meta = {}
        if (md / "trained.json").exists():
            meta = json.loads((md / "trained.json").read_text(encoding="utf-8"))
        with self.lock:
            lib = self._load(lib_id)
            j = next((x for x in lib["jobs"] if x["job_id"] == job_id), None)
            cand = {"candidate_id": _id("ckpt"), "model_dir": str(md), "model_sha256": h, "dataset_version": j["dataset_version"] if j else None, "job_id": job_id, "created_at": now_iso(),
                    "trained_meta": {k: meta.get(k) for k in ("base", "epochs", "best_val_loss", "lr", "ref_text") if k in meta}, "eval_summary": eval_summary,
                    "validated": bool(eval_summary and eval_summary.get("val_loss_finite") and eval_summary.get("holdout_n", 0) > 0), "loaded": False, "trial_synth": False, "status": "candidate",
                    "evidence": {}}
            lib["checkpoints"]["candidates"].append(cand)
            self._save(lib)
        if j:
            self.job_set(lib_id, job_id, "candidate_ready", "训练完成,候选模型已登记(尚未升级:需要 验证 + 加载 + 试合成 三项证据)", candidate_id=cand["candidate_id"])
        return cand

    def mark_candidate(self, lib_id, candidate_id, **flags):
        ok = {"validated", "loaded", "trial_synth"}
        with self.lock:
            lib = self._load(lib_id)
            c = next((x for x in lib["checkpoints"]["candidates"] if x["candidate_id"] == candidate_id), None)
            if not c:
                raise StoreError("候选模型不存在", 404)
            for k, v in flags.items():
                if k in ok:
                    c[k] = bool(v)
                elif k == "evidence":
                    c["evidence"].update(v)
            self._save(lib)
            return c

    def promote(self, lib_id, candidate_id):
        with self.lock:
            lib = self._load(lib_id)
            c = next((x for x in lib["checkpoints"]["candidates"] if x["candidate_id"] == candidate_id), None)
            if not c:
                raise StoreError("候选模型不存在", 404)
            missing = [n for k, n in (("validated", "留出验证通过"), ("loaded", "成功加载"), ("trial_synth", "真实试合成通过")) if not c.get(k)]
            if missing:
                raise StoreError("不能升级:缺少证据 → " + "、".join(missing) + "(旧模型保持不变)", 409)
            if not Path(c["model_dir"], "model.safetensors").exists() or sha256_file(Path(c["model_dir"], "model.safetensors")) != c["model_sha256"]:
                raise StoreError("模型文件缺失或哈希不一致,拒绝升级", 409)
            ck = lib["checkpoints"]
            if ck["current"]:
                ck["history"].append(ck["current"])
            c["status"] = "current"
            ck["current"] = {k: c[k] for k in ("candidate_id", "model_dir", "model_sha256", "dataset_version", "job_id")} | {"promoted_at": now_iso()}
            ck["candidates"] = [x for x in ck["candidates"] if x["candidate_id"] != candidate_id]
            self._save(lib)
            if c.get("job_id"):
                try:
                    self.job_set(lib_id, c["job_id"], "promoted", "已升级为当前模型")
                except StoreError:
                    pass
            return ck["current"]

    def rollback(self, lib_id):
        with self.lock:
