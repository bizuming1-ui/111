class Worker:
    def __init__(self, idx, gpu, proc, q):
        self.idx, self.gpu, self.proc, self.q = idx, gpu, proc, q
        self.status, self.msg = "loading", "启动中…"
        self.voice_vid = None
        self.voice_info = {}
        self.pending = 0
        self.mem = (0.0, 0.0, 0)

    def ready(self):
        return self.status in ("ready", "voice") and self.proc.is_alive()


class Pool:
    def __init__(self, ctx, gpus, cfg):
        self.ctx = ctx
        self.epoch = ctx.Value("i", 0)
        self.res_q = ctx.Queue()
        self.workers = []
        for i, g in enumerate(gpus):
            q = ctx.Queue()
            p = ctx.Process(target=worker_main, args=(i, g, q, self.res_q, self.epoch, cfg), daemon=True, name="tts-gpu%s" % g)
            p.start()
            self.workers.append(Worker(i, g, p, q))

    def pick(self):
        cand = [w for w in self.workers if w.ready() and w.voice_vid == VOICE["vid"] and VOICE["vid"] > 0]
        if not cand:
            return None
        return min(cand, key=lambda w: (w.pending, w.idx))

    def bump(self):
        with self.epoch.get_lock():
            self.epoch.value += 1

    def stop(self):
        for w in self.workers:
            try:
                w.q.put(("quit",))
            except Exception:  # noqa: BLE001
                pass


