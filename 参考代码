        es = torch.stack([self.embed(w) for w in wav16k_list])
        self.ref = torch.nn.functional.normalize(es.mean(0), dim=-1)
        return self.ref

    def score(self, wav16k):
        if self.ref is None:
            raise RuntimeError("先调用 set_ref")
        return float((self.embed(wav16k) * self.ref).sum().item())

