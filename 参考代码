        self.persist = persist_mod.Persist(self.store, self.state_dir, input_roots=[p for p in os.environ.get("VC_INPUT_ROOTS", "/kaggle/input").split(os.pathsep) if p])
        self.gh = ghsync.GitHubSync(self.state_dir, self.audit)
        self.mgr = ba.BrowserManager(tts_busy=lambda: bool(self.G.get("ACTIVE")), audit_event=self.audit.event)
        self.dirty = False
        self.speak = {}
        self.llm = intent_mod.LLMGateway(key=G.get("DS_KEY", ""), base=G.get("DS_BASE") or "https://api.deepseek.com", model=os.environ.get("DEEPSEEK_MODEL") or intent_mod.DEFAULT_MODEL,
                                         vision_model=os.environ.get("DEEPSEEK_VISION_MODEL") or intent_mod.DEFAULT_MODEL)
        self.isettings = intent_mod.IntentSettings(self.state_dir / "intent_settings.json")
        self.intent = intent_mod.IntentService(self.llm, self.isettings)
        self.vsem = asyncio.Semaphore(1)
        self.act_lock = None
        self.mount()
        app.add_middleware(auth_mod.AuthMiddleware, auth=self.auth)

    # ───────────────────────── 辅助 ─────────────────────────
    @property
    def VOICE(self):
        return self.G["VOICE"]

    def mark(self):
        self.dirty = True

    def llm_available(self):
        return bool(self.G.get("DS_KEY") or self.G.get("MOCK_LLM"))

    async def llm_text(self, messages, limit=2500):
        if self.llm.key and not self.G.get("MOCK_LLM"):
            try:
                txt, _ = await self.llm.text(messages, max_tokens=700, timeout=20)
                return txt[:limit]
            except intent_mod.LLMError as e:
                raise RuntimeError("LLM 不可用(%s)" % intent_mod.KIND_ZH.get(e.kind, e.kind))
        out = ""
        async for d in self.G["deepseek_stream"](messages, False):
            out += d
            if len(out) > limit:
                break
        return out

    def workers_ready(self):
        pool = self.G.get("POOL")
        return [w for w in (pool.workers if pool else []) if w.proc.is_alive() and w.status != "error"]

    def tts_unavailable_reason(self):
        if self.G.get("MONITOR_ONLY"):
            return "训练模式:TTS/ASR 没有加载到 GPU(显存让给训练,避免溢出);文字搜索与 CPU 浏览器仍可用"
        if not self.workers_ready():
            return "没有可用的 GPU 进程:语音合成/识别不可用(文字搜索仍可用)"
        return ""

    def snapshot(self, lib, sample):
        G = self.G
        ck = (lib["checkpoints"].get("current") or {})
        return {"library_id": lib["library_id"], "name": lib["name"], "sample_id": sample["sample_id"], "ref_sha256": sample["proc_sha256"],
                "dataset_version": lib["datasets"][-1]["version"] if lib["datasets"] else None, "ckpt_sha256": G["SEC"].get("model_sha256"), "library_current_ckpt": ck.get("model_sha256"),
                "sampling": {"seed": G.get("SEED"), "temperature": os.environ.get("VC_TEMPERATURE"), "top_p": os.environ.get("VC_TOP_P"), "top_k": os.environ.get("VC_TOP_K"),
                             "repetition_penalty": os.environ.get("VC_REP_PENALTY"), "sr": G["SR"]}, "activated_at": libs.now_iso()}

    # ───────────────────────── 语音库 ↔ 语音服务 ─────────────────────────
    def legacy_append(self, data, ext, proc, sr, ch, qc, text):
        """旧 /api/voice 上传:样本追加到当前语音库(没有库就建一个「默认语音库」);容量不足抛 StoreError(507)"""
        lid = self.store.active_id
        if not lid:
            lid = self.store.create("默认语音库", consent=True)["library_id"]
        else:
            self.store.set_consent(lid, True)
        SR = self.G["SR"]
        s = self.store.add_sample(lid, data, ext, wav_bytes_mono16(proc, SR), len(proc) / SR, sr, ch, qc, text, "user" if text else "", bool(text), sr_proc=SR)
        s["_lib"] = lid
        self.mark()
        return s

    def bind_voice(self, s):
        lid = s["_lib"] if "_lib" in s else self.store.active_id
        if s.get("category") == "speech":
            self.store.set_ref(lid, s["sample_id"])
        lib = self.store.get(lid)
        self.VOICE["library"] = self.snapshot(lib, s)

    async def activate(self, lib_id):
        G, VOICE = self.G, self.VOICE
        lib = self.store.get(lib_id)
        s = self.store.choose_reference(lib)
        self.store.set_active(lib_id)
        self.mark()
        if s is None:
            VOICE["library"] = {"library_id": lib_id, "name": lib["name"], "sample_id": None}
            return {"ok": True, "voice": "no_reference", "message": "已切换到「%s」,但它还没有口语样本:请先录制或上传" % lib["name"]}
        why = self.tts_unavailable_reason()
        if why:
            VOICE["library"] = self.snapshot(lib, s)
            return {"ok": True, "voice": "unavailable", "message": "已切换到「%s」(%s)" % (lib["name"], why)}
        for sess in list(G["SESSIONS"]):                                  # 切库安全策略:停止正在生成的任务,不会让不同库的音频混在一个输出里
            try:
                G["cancel_turn"](sess)
            except Exception:  # noqa: BLE001
                pass
        paths = self.store.sample_paths(lib_id, s["sample_id"])
        VOICE.update(qc=s.get("qc"), orig=str(paths["orig"]), kind="singing" if s["category"] == "singing" else "speech", ack=False, text_source=s.get("text_source", ""),
                     text_trusted=bool(s.get("text_trusted")), ref_summary=None, library=self.snapshot(lib, s))
        try:
            y = G["decode_audio"](paths["proc"].read_bytes())[0]
            VOICE["ref_summary"] = await G["LOOP"].run_in_executor(None, lambda: G["aq"].acoustic_summary(y, G["SR"], s.get("text") or None, "speech"))
        except Exception as e:  # noqa: BLE001
            G["log"].warning("参考摘要失败: %s", e)
        G["start_clone"](str(paths["proc"]), s.get("text") or "", False)
        self.audit.event("library_switch", "started", workers=len(self.workers_ready()))
        return {"ok": True, "voice": "cloning", "message": "正在两张 GPU 上同时加载「%s」的声音(每张卡都确认后才会可用)" % lib["name"], "vid": VOICE["vid"]}

    async def on_startup(self):
        """启动:校验并恢复持久化的语音库 → 自动激活上次选中的库。返回 True = 已由语音库接管声音恢复"""
        loop = asyncio.get_running_loop()
        try:
            rep = await loop.run_in_executor(None, self.persist.restore)
            self.audit.event("persist_restore", "ok" if rep.get("ok") in (True, None) else "failed", count=len(rep.get("restored") or []))
        except Exception as e:  # noqa: BLE001
            self.persist.report = {"attempted": True, "ok": False, "problems": [type(e).__name__ + ": " + str(e)[:200]], "message": "恢复过程出错:" + str(e)[:200]}
        loop.create_task(self.background())
        lid = self.store.active_id
        if not lid or not self.workers_ready():
            return False
        try:
            lib = self.store.get(lid)
            if self.store.choose_reference(lib) is None:
                return False
            await self.activate(lid)
            return True
        except Exception as e:  # noqa: BLE001
            self.G["log"].warning("恢复语音库失败: %s", e)
            self.persist.report["problems"] = (self.persist.report.get("problems") or []) + ["激活语音库失败: %s" % e]
            return False

    async def background(self):
        loop = asyncio.get_running_loop()
        n = 0
        while True:
            await asyncio.sleep(20)
            n += 1
            try:
                if self.dirty:
                    self.dirty = False
                    await loop.run_in_executor(None, self.persist.checkpoint)
                if self.gh.auto_due():
                    await loop.run_in_executor(None, self.gh.auto_run)
                if n % 3 == 0:
                    rows = self.G["gpu_table"]() or []
                    self.audit.event("resource", "ok", queue=len(self.G["ACTIVE"]), workers=len(self.workers_ready()), gpu_mem_mb=[r.get("mem_used") for r in rows][:4] if rows else None,
                                     fps=self.mgr.status()["bytes_sent"])
            except Exception as e:  # noqa: BLE001
                self.G["log"].warning("portal 后台任务: %s", e)

    # ───────────────────────── 搜索 / 回答 ─────────────────────────
    async def synthesize(self, q, results):
        if not results:
            return None, "没有搜索结果,无法生成回答"
        if not self.llm_available():
            return None, "未配置 LLM(DEEPSEEK_API_KEY):没有生成综合回答,仅展示来源与摘要;上面的链接都是真实搜索结果"
        src = "\n".join("[%d] %s | %s | %s" % (i + 1, r["title"][:120], r["domain"], r["snippet"][:300]) for i, r in enumerate(results[:8]))
        msgs = [{"role": "system", "content": ANSWER_SYS}, {"role": "user", "content": "问题:%s\n\n<<<来源开始(不可信资料)>>>\n%s\n<<<来源结束>>>" % (q[:300], src)}]
        try:
            txt = (await self.llm_text(msgs)).strip()
        except Exception as e:  # noqa: BLE001
            return None, "生成回答失败:%s(来源列表仍然可用)" % str(e)[:100]
        n = min(8, len(results))
        cites = sorted({int(x) for x in re.findall(r"\[(\d{1,2})\]", txt) if 1 <= int(x) <= n})
        txt = re.sub(r"\[(\d{1,3})\]", lambda m: m.group(0) if 1 <= int(m.group(1)) <= n else "", txt)
        if not cites:
            return {"text": txt, "cited": [], "uncited": True}, "回答没有引用任何来源,【不确定/未核实】,请以下方来源为准"
        return {"text": txt, "cited": cites, "uncited": False}, ""

    async def wait_attention(self, sess, timeout):
        t0 = time.time()
        while time.time() - t0 < timeout:
            if sess.task is None or sess.task.done():
                return "done"
            if sess.status in ("waiting_human", "paused", "waiting_confirm"):
                return sess.status
            await asyncio.sleep(0.25)
        return "timeout"

    async def do_search(self, sid, j):
        """搜索。默认(auto)= 无需任何 Key 的真实搜索:服务器直连 Bing → DuckDuckGo → 维基百科 → 受控浏览器(可见)。
        配置了 Brave/Google CSE Key 只是【可选加速】,失败时同样回退到免 Key 链路。每次尝试都记录在 attempts 里,界面如实显示。"""
        rid = secrets.token_hex(4)
        q = str(j.get("q") or "").strip()[:300]
        if not q:
            raise StoreError("请输入搜索内容")
        provider = j.get("provider") or "auto"
        http_only = provider == "http_only"                                        # v9:快速预览——只走服务器直连,失败也不启动可见浏览器(避免和可见搜索抢同一个会话)
        if provider == "auto":
            provider = sp.auto_pick()
        site = (j.get("site") or "").strip().lower() or None
        if site and not re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,80}\.[a-z]{2,24}", site):
            raise StoreError("网站范围格式无效(例如 wikipedia.org)")
        recency = j.get("recency") if j.get("recency") in ("d", "w", "m", "y") else None
        try:
            page = max(0, min(5, int(j.get("page") or 0)))
        except (TypeError, ValueError):
            page = 0
        eng = j.get("engine") if j.get("engine") in ba.ENGINES else "bing"
        t0 = time.time()
        attempts, out = [], None
        if provider in sp.API_PROVIDERS:                                        # 可选的 Key 提供方:失败不阻断搜索
            p = sp.API_PROVIDERS[provider]
            if not p.configured():
                attempts.append({"provider": provider, "ok": False, "kind": "config", "message": "未配置 %s(这是可选项,已自动改用免 Key 搜索)" % ",".join(p.secrets), "ms": 0})
            else:
                res, rec = await sp.run_one(p, provider, q, 8, page, site, recency)
                attempts.append(rec)
                if res:
                    out = {"ok": True, "results": res, "mode": {"mode": "api", "provider": provider, "label": "通过 %s 搜索(真实 API)" % p.name, "cost": p.cost}}
        if out is None and provider != "browser" and (j.get("engine") or "bing") != "google":   # 免 Key 的服务器直连链路(Google 会拦截服务器直连,v9 如实交给可见浏览器)
            try:
                res, pid, attempts = await sp.search_http_chain(q, 8, page, site, recency, eng, attempts)
                out = {"ok": True, "results": res, "mode": {"mode": "http", "provider": pid, "label": "通过 %s 搜索(服务器直连真实页面解析 · 无需 Key)" % pid.split(":")[1], "cost": "无 API 费用"}}
            except sp.SearchFailed as e:
                attempts = e.attempts
        if out is None:                                                          # 最后:受控浏览器(可见);要求 Chromium 真的存在
            if http_only:
                return {"ok": False, "error": "服务器直连搜索没有拿到结果 —— " + sp.summarize(attempts), "attempts": attempts, "request_id": rid, "mode": {"mode": "http", "provider": "none", "label": "服务器直连失败"}, "results": [], "_status": 502}
            why = sp.BROWSER.problem()
            if why:
                attempts.append({"provider": "browser", "ok": False, "kind": "config", "message": why, "ms": 0})
                kinds = [x.get("kind") for x in attempts if not x.get("ok")]
                main = next((k for k in ("network", "timeout", "challenge", "rate_limited", "server_error", "parse", "empty") if k in kinds), "network")
                hint = {"network": "网络/搜索服务暂不可用:请检查 Kaggle Settings → Internet 是否为 On,稍后重试", "challenge": "搜索站点要求人机验证:本系统不会绕过,请稍后重试或换一个关键词"}.get(main, "")
                self.audit.event("search", "error", (time.time() - t0) * 1000, sid, provider="http", q_len=len(q), kind=main)
                return {"ok": False, "error": "所有搜索提供方都失败了 —— " + sp.summarize(attempts) + (("。" + hint) if hint else ""), "kind": main, "attempts": attempts, "request_id": rid,
                        "mode": {"mode": "http", "provider": "none", "label": "全部失败"}, "results": [], "_status": 502}
            sess = self.mgr.get(sid)
            if sess.task and not sess.task.done():
                raise StoreError("浏览器正在执行另一个任务,请先在「浏览器」页取消或等待", 409)
            if page > 0 and sess.last_query:
                acts = [{"action": "search_more"}]
            else:
                a = {"action": "search", "query": q, "engine": eng}
                if site:
                    a["site"] = site
                if recency:
                    a["recency"] = recency
                acts = [a]
            sess.start(ba.validate_actions(acts), "搜索")
            mode = {"mode": "browser", "provider": "browser:" + eng, "label": "受控浏览器内的可见搜索(免 Key 链路的最后一级 · 引擎 %s)" % eng, "cost": sp.BROWSER.cost}
            st = await self.wait_attention(sess, 25)                             # 请求最多占用 25 秒(避免被代理判超时);未完成则返回 pending,前端轮询 /api/search/poll
            if st == "timeout":
                return {"ok": False, "pending": True, "message": "可见浏览器正在搜索…(可在下方实时画面观看)", "mode": mode, "attempts": attempts, "request_id": rid, "results": []}
            if st != "done":
                self.audit.event("search", st, (time.time() - t0) * 1000, sid, provider="browser", q_len=len(q))
                return {"ok": False, "needs_attention": True, "status": sess.status, "message": sess.msg or "搜索尚未完成(可能需要你在「浏览器」页处理验证码/确认)", "mode": mode, "results": list(sess.last_results), "attempts": attempts, "request_id": rid}
            if sess.status in ("error", "cancelled", "paused"):
                self.audit.event("search", "error", (time.time() - t0) * 1000, sid, provider="browser", q_len=len(q))
                bk = "config" if re.search(r"Chromium|playwright", sess.msg or "") else "challenge" if re.search(r"验证|反机器人|同意", sess.msg or "") else "network"
                attempts.append({"provider": "browser", "ok": False, "kind": bk, "message": sess.msg or "浏览器搜索失败", "ms": int((time.time() - t0) * 1000)})
                return {"ok": False, "error": "所有搜索提供方都失败了 —— " + sp.summarize(attempts), "attempts": attempts, "mode": mode, "results": [], "request_id": rid, "_status": 502}
            attempts.append({"provider": "browser:" + eng, "ok": True, "n": len(sess.last_results), "ms": int((time.time() - t0) * 1000), "tries": 1})
            out = {"ok": True, "results": list(sess.last_results), "mode": mode}
        must = [str(x)[:20] for x in (j.get("must") or []) if isinstance(x, str)][:6]
        alts = [str(x).strip()[:120] for x in (j.get("alts") or []) if isinstance(x, str) and str(x).strip()][:3]

        def _rel(rs):
            return sum(1 for r_ in rs if any(m_.lower() in (r_["title"] + " " + r_["snippet"]).lower() for m_ in must))
        if out["mode"]["mode"] == "http" and must:
            best = (_rel(out["results"]), q, out["results"], out["mode"])
            if best[0] < 2:
                for alt in alts:
                    t1 = time.time()
                    try:
                        res2, pid2, att2 = await sp.search_http_chain(alt, 8, page, site, recency, eng, [])
                    except sp.SearchFailed:
                        attempts.append({"provider": "http·换写法", "ok": False, "kind": "empty", "message": "「%s」没有结果" % alt, "ms": int((time.time() - t1) * 1000)})
                        continue
                    n2 = _rel(res2)
                    attempts.append({"provider": "换写法「%s」相关 %d/%d" % (alt, n2, len(res2)), "ok": True, "n": len(res2), "ms": int((time.time() - t1) * 1000)})
                    if n2 > best[0]:
                        best = (n2, alt, res2, {"mode": "http", "provider": pid2, "label": "通过 %s 搜索(服务器直连真实页面解析 · 无需 Key · 已按相关度换写法)" % pid2.split(":")[1], "cost": "无 API 费用"})
                    if n2 >= 4:
                        break
            out["results"], out["mode"], out["query_used"] = best[2], best[3], best[1]
            out["relevance"] = {"matched": best[0], "of": len(best[2]), "terms": must}
            if best[0] < 2:
                out["relevance_warn"] = "服务器直连 Bing 返回的结果与主题相关度偏低(Bing 对服务器直连有时返回降级结果);请以可见浏览器真实页面解析的结果为准。"
        out["attempts"] = attempts
        out["request_id"] = rid
        if out["mode"]["mode"] != "browser":
            try:                                                      # 把真实结果交给隔离浏览器会话:之后语音说“打开第 N 个结果”会真的打开这些 URL(仍要过 netguard)
                bs = self.mgr.get(sid)
                bs.last_results = list(out["results"])
                bs.seen_results.update({r_["url"]: r_ for r_ in out["results"]})
                bs.last_query = {"query": q, "engine": eng, "site": site, "recency": recency}
            except Exception:  # noqa: BLE001
                pass
        if j.get("answer", True):
            ans, note = await self.synthesize(q, out["results"])
            out.update(answer=ans, answer_note=note)
        out.update(query=q, site=site, recency=recency, page=page, fetched_at=libs.now_iso(), llm=self.llm_available())
        self.audit.event("search", "ok", (time.time() - t0) * 1000, sid, provider=out["mode"]["provider"], q_len=len(q), results=len(out["results"]))
        return out

    async def plan(self, text, engine, voice=False, sid="open", city=""):
        """v9:自然语言/语音一律先由大模型做【结构化意图理解】(不能因规则 parser 能解析就绕过),再由本地确定性策略 + 动作白名单生成动作。
        LLM 只给出 intent / normalized_query,从不产生可执行代码或任意 URL;LLM 不可用时明确标注 planner=rules 与原因,搜索链路照常工作。"""
        engine = engine if engine in ("google", "bing", "edge_default", "all", "duckduckgo", "so360") else "bing"
        r0 = ba.plan_rules(text, engine if engine in ba.ENGINES else "bing", loose=False)
        w = ba.risk_words(text)
        if r0.get("control"):                                            # 暂停/继续/取消:确定性快速通道(仍在前端经 act() 执行)
            return {"ok": True, **r0, "planner": "rules", "risk_word": w, "needs_confirm": False, "auto_ok": True, "intent": {"intent": "browser_command", "planner": "rules", "control": r0["control"]}}
        bs = self.mgr.sessions.get(sid)
        has_results = bool(bs and bs.last_results)
        it = await self.intent.understand(text, ui_engine=engine, voice=voice, city=city, has_results=has_results)
        kind = it["intent"]
        out = {"ok": True, "intent": it, "planner": it["planner"], "risk_word": w, "needs_confirm": bool(w), "actions": [], "clarify": None, "search_plan": [], "vision_suggested": bool(it.get("vision_suggested"))}
        if it.get("needs_clarification") or kind == "clarify":
            out["clarify"] = it.get("clarification_question") or "能再具体说一下吗?"
            out["clarify_kind"] = it.get("clarify_kind", "")
        elif kind == "search":
            plan = intent_mod.finalize_plan(it, engine, self.isettings.data["edge_default_provider"])
            out["search_plan"] = plan
            out["search_hints"] = {"variants": [x for x in (it.get("query_variants") or []) if isinstance(x, str)][:3], "must": [x for x in (it.get("relevance_terms") or []) if isinstance(x, str)][:6]}
            a0 = next((a for a in (r0.get("actions") or []) if a.get("action") == "search"), {})
            q, site, rec = it["normalized_query"], a0.get("site"), a0.get("recency")
            if site or rec:                                               # 站点/时间范围是搜索参数,不是搜索词的一部分
                q2 = re.sub(r"site:\S+|(?:在|于)\s*[a-z0-9][a-z0-9.-]*\.[a-z]{2,24}\s*(?:上|里|中)?", " ", q, flags=re.I)
                q2 = ba._recency(q2)[1]
                q = re.sub(r"\s+", " ", q2).strip(" 的:：") or q
            acts = []
            for pi in plan:
                if pi.get("duplicate_of"):                                # Edge 默认=Bing 时与 Bing 去重,不虚构第三组结果
                    continue
                a = {"action": "search", "query": q, "engine": pi["provider"]}
                if site:
                    a["site"] = site
                if rec:
                    a["recency"] = rec
                acts.append(a)
            try:
                out["actions"] = ba.validate_actions(acts)
            except ValueError as e:
                out["clarify"] = str(e)
        elif kind == "browser_command":
            acts = list(r0.get("actions") or [])
            if not acts and self.llm_available():                         # 规则看不懂 → 旧的 LLM 动作翻译器(仍必须通过白名单校验,且一律要用户确认)
                try:
                    raw = await self.llm_text([{"role": "system", "content": LLM_PLANNER_SYS}, {"role": "user", "content": text[:500]}], 1500)
                    m = re.search(r"\{.*\}", raw, re.S)
                    j = json.loads(m.group(0)) if m else {}
                    if j.get("actions"):
                        acts = ba.validate_actions(j["actions"][:12])
                        out["planner"] = "llm_actions"
                except Exception:  # noqa: BLE001
                    acts = []
            if any(a.get("action") == "open_result" for a in acts) and not has_results:
                out["clarify"] = "当前还没有搜索结果可以打开:请先搜索,再说「打开第一个结果」。"
                acts = []
            if not acts and not out["clarify"]:
                out["clarify"] = r0.get("clarify") or "无法确定要对浏览器做什么。可以说「搜索 xxx」「打开 example.com」「向下滚动」「点击 登录」。"
            out["actions"] = acts
        LOW = ("search", "search_more", "open_result", "goto", "scroll", "back", "forward", "reload", "wait", "snapshot", "read")
        acts = out["actions"]
        if acts and all(a["action"] == "search" for a in acts):
            out["needs_confirm"] = False                                   # 纯搜索没有外部副作用:搜索词里出现『购买/订阅』等词不需要二次确认
        out["auto_ok"] = bool((acts and not out["needs_confirm"] and not out["clarify"] and all(a["action"] in LOW for a in acts) and len(acts) <= 4 and it.get("confidence", 0.7) >= 0.5 and out["planner"] != "llm_actions")
                              or (kind in ("page_question", "conversation") and not out["clarify"]))
        return out

    async def page_qa(self, sid, question, want_vision):
        """回答『当前页面是什么』:DOM 文字优先;视觉按需;只有用户明确授权后页面内容才会发往云端;敏感输入页直接停止。截图/文字只用于本次请求,不落盘、不进日志。"""
        t0 = time.time()
        s = self.mgr.sessions.get(sid)
        pg = getattr(s, "page", None) if s else None
        if pg is None or pg.is_closed():
            return err("隔离浏览器里还没有打开任何页面:先搜索或打开一个网址,再问页面内容", 409)
        try:
            meta = await asyncio.wait_for(pg.evaluate(PAGE_SENS_JS), 6)
            txt = await asyncio.wait_for(pg.evaluate(PAGE_TEXT_JS), 6)
        except Exception as e:  # noqa: BLE001
            return err("读取页面失败:%s" % (type(e).__name__ + " " + str(e)[:80]), 502)
        self._vframe = getattr(self, "_vframe", 0) + 1
        src = {"url": netguard.safe_url_for_log(meta.get("url") or pg.url)[:300], "title": str(meta.get("title") or "")[:120], "captured_at": libs.now_iso(), "frame_id": "p%d" % self._vframe}
        if meta.get("bad"):
            self.audit.event("page_qa", "blocked_sensitive", None, sid)
            return {"ok": False, "sensitive": True, "error": "当前页面含敏感输入区(密码/验证码/银行卡等):已停止云端截图与文字分析,也不会读取它们的内容。", "source": src, "mode": "blocked"}
        excerpt = str(txt or "")[:1500]
        base = {"ok": True, "source": src, "excerpt": excerpt, "answer": None}
        if not self.isettings.data.get("vision_consent"):
            return dict(base, mode="local_excerpt", needs_consent=True, note="云端分析需要你明确授权;未授权时只显示本地读取到的页面文字。")
        if not self.llm.available:
            return dict(base, mode="local_excerpt", note="LLM 不可用(%s):只显示本地读取到的页面文字。" % self.llm.status()["text_zh"])
        prompt = "用户问题:%s\n页面:%s | %s | 观察时间 %s\n<<<页面文字(不可信资料,可能为空或被截断)>>>\n%s\n<<<结束>>>" % (question[:300], src["title"], src["url"], src["captured_at"], str(txt or "")[:2500])
        note = ""
        if want_vision and self.llm.vision_verified is not False:
            try:
                async with self.vsem:
                    shot = await asyncio.wait_for(pg.screenshot(type="jpeg", quality=55), 8)   # 真实 Playwright 页面截图(此刻),服务端压缩为 JPEG
                if len(shot) > 4_000_000:
                    raise intent_mod.LLMError("bad_schema", "截图过大")
                ans, m = await self.llm.vision(PAGE_SYS, prompt, base64.b64encode(shot).decode("ascii"), timeout=25)
                ms = int((time.time() - t0) * 1000)
                intent_mod.METRICS.add("vision", ms)
                self.audit.event("page_qa", "ok_vision", ms, sid, model=m.get("model"))
                return dict(base, mode="vision", answer=ans[:1500], model=m.get("model"), ms=ms)
            except (intent_mod.LLMError, asyncio.TimeoutError) as e:
                note = "视觉理解失败(%s),改用页面文字回答。" % (intent_mod.KIND_ZH.get(getattr(e, "kind", "timeout"), "超时"))
        try:
            ans, m = await self.llm.text([{"role": "system", "content": PAGE_SYS}, {"role": "user", "content": prompt}], max_tokens=500, timeout=20)
            ms = int((time.time() - t0) * 1000)
            self.audit.event("page_qa", "ok_dom", ms, sid, model=m.get("model"))
            return dict(base, mode="dom_text", answer=ans[:1500], model=m.get("model"), ms=ms, note=note)
        except intent_mod.LLMError as e:
            return dict(base, mode="local_excerpt", note=(note + " " if note else "") + "大模型不可用(%s):只显示本地读取到的页面文字。" % intent_mod.KIND_ZH.get(e.kind, e.kind))

    def remote_edge_installed(self):
        return any(shutil.which(x) for x in ("microsoft-edge", "microsoft-edge-stable", "msedge"))


    # ───────────────────────── 评估 ─────────────────────────
    async def ask2(self, kind, payload, timeout=90):
        G = self.G
        ws = list(self.workers_ready())
        if not ws:
            return None, "没有可用的 GPU 进程"
        last = (None, "没有结果")
        for w0 in ws:                                                 # 每个 worker 有自己的评分器:一张卡加载失败(显存/下载)时自动换另一张重试
            rid = "%s_%s" % (kind, secrets.token_hex(6))             # 唯一任务 ID:迟到结果不会串到别的任务
            fut = G["LOOP"].create_future()
            G["QC_WAIT"][rid] = fut
            w0.q.put((kind, rid) + tuple(payload))
            try:
                res, e = await asyncio.wait_for(fut, timeout)
            except asyncio.TimeoutError:
                G["QC_WAIT"].pop(rid, None)
                last = (None, "GPU%s 评分超时(%ds);迟到的结果会被丢弃" % (getattr(w0, "idx", "?"), timeout))
                continue
            if e or (isinstance(res, dict) and res.get("status") == "failed"):
                last = (res, e or (res or {}).get("reason") or "评分器不可用")
                continue
            return res, e
        return last

    async def evaluate(self, lib_id):
        G = self.G
        lib = self.store.get(lib_id)
        ref = self.store.choose_reference(lib)
        if ref is None:
            raise StoreError("该库没有口语样本")
        holdout = [s for s in lib["samples"] if s["category"] == "speech" and s["sample_id"] != ref["sample_id"] and s["session"] != ref["session"] and not (s.get("qc") or {}).get("blocking")]
        if not holdout:
            raise StoreError("没有留出样本:至少需要 2 个【不同录音场次】的口语样本(1 个做参考提示,其余留出做评估)。没有评估 → 显示“未评估”,不会编造分数")
        gens = [u for u in list(G["GEN_AUDIO"]) if G["GEN_LIB"].get(u) == lib_id]
        if not gens:
            raise StoreError("还没有属于这个库的生成音频:请先切换到该库,在「语音克隆」页合成一两句话,再回来评估")
        if G.get("MOCK"):
            raise StoreError("当前是 Mock 引擎:不产生真实声纹分数,拒绝记录(Mock 不能证明真实质量)")
        t0 = time.time()
        td = Path(tempfile.mkdtemp(prefix="eval_", dir=str(self.work)))
        try:
            refs = [str(self.store.sample_paths(lib_id, s["sample_id"])["proc"]) for s in holdout][:8]
            scores, skipped_notes = [], []
            for u in gens:
                pcm = np.frombuffer(G["GEN_AUDIO"][u], dtype="<i2").astype(np.float32) / 32768.0
                p = td / ("gen_%d.wav" % u)
                G["write_wav"](p, pcm, G["SR"])
                res, e = await self.ask2("spk_cmp", (str(p), refs), 120)
                if e:                                                 # 把真实底层原因原样给用户(例如模型下载失败 / CUDA 显存不足 / 权重不兼容)
                    raise StoreError("声纹比对失败(评分器不可用):%s" % e, 502)
                if not res or res.get("status") not in ("completed",) or not res.get("scores"):
                    why = (res or {}).get("reason") or "无结果"
                    skipped_notes.append("%s: %s" % (res.get("status") if res else "failed", why))
                    continue
                scores += [x for x in res["scores"] if x is not None]
                model = res.get("model")
        finally:
            shutil.rmtree(td, ignore_errors=True)
        if not scores:
            raise StoreError("没有得到有效分数(状态 skipped/not_evaluated,不会编造分数):%s" % ("; ".join(skipped_notes[:3]) or "无原因"), 422)
        mean = float(np.mean(scores))
        view = G["aq"].similarity_view(mean, model or G["SV_MODEL"], G["CAL"], "speech")
        rec = {"metric": "speaker_cosine_raw", "scope": "生成样本 与 该库【留出参考样本】(不同录音场次)之间的说话人 cosine", "model": model or G["SV_MODEL"], "raw_mean": round(mean, 4),
               "raw_min": round(float(min(scores)), 4), "raw_max": round(float(max(scores)), 4), "raw_range": [-1.0, 1.0], "n_pairs": len(scores), "n_generated": len(gens),
               "n_holdout": len(holdout), "holdout_source": "库内样本 %s(录音场次 ≠ 参考提示的场次 %s)" % (",".join(s["sample_id"] for s in holdout[:6]), ref["session"][-6:]),
               "ckpt_hash": G["SEC"].get("model_sha256"), "library_current_ckpt": (lib["checkpoints"].get("current") or {}).get("model_sha256"), "elapsed_s": round(time.time() - t0, 1),
               "calibrated": bool(view.get("calibrated")), "view": view, "condition": "speech", "singing": "歌声相似度:不支持/未验证(不与口语混用)",
               "label": view.get("label")}
        self.mark()
        return self.store.record_eval(lib_id, rec)

