class Drv:
    """v12 直连管线的手势驱动(模拟前端发出的消息)"""

    def __init__(self, s):
        self.s = s
        self.v = s.v12

    def m(self, k, x, y, **kw):
        d = {"t": "m", "k": k, "nx": x / self.s.view[0], "ny": y / self.s.view[1], "b": 0, "bs": 0, "mod": 0, "ep": self.s.view_epoch}
        d.update(kw)
        self.v.handle(d)

    async def drain(self, t=0.25):
        for _ in range(100):
            if not self.v.pump.q:
                break
            await asyncio.sleep(0.02)
        await asyncio.sleep(t)

    async def click(self, x, y, n=1, b=0):
        bs = {0: 1, 1: 4, 2: 2}[b]
        for _ in range(n):
            self.m("down", x, y, b=b, bs=bs)
            self.m("up", x, y, b=b)
        await self.drain()

    async def drag(self, x1, y1, x2, y2, steps=8):
        self.m("down", x1, y1, bs=1)
        for i in range(1, steps + 1):
            self.m("move", x1 + (x2 - x1) * i / steps, y1 + (y2 - y1) * i / steps, bs=1)
            await asyncio.sleep(0.02)
        self.m("up", x2, y2)
        await self.drain()

    async def key(self, key, code, kc, mod=0, up_mod=None):
        self.v.handle({"t": "k", "k": "down", "key": key, "code": code, "kc": kc, "mod": mod})
        self.v.handle({"t": "k", "k": "up", "key": key, "code": code, "kc": kc, "mod": mod if up_mod is None else up_mod})
        await self.drain(0.1)


def test_chromium_event_sequence_matches_native_playwright_input():
    """同一页面、同一手势:v12 直连管线 vs Playwright 原生输入,事件(类型/button/buttons/detail/key/修饰键/坐标/deltaY)逐条一致率"""
    async def sc(s):
        from playwright.async_api import async_playwright
        # 对照组:另开一个普通 Chromium 页面,用 Playwright 自己的输入
        ref_ctx = await (await s.mgr.browser()).new_context(viewport={"width": s.view[0], "height": s.view[1]})
        ref = await ref_ctx.new_page()
        await ref.goto(DATA(REC))
        await _load(s, REC)
        d = Drv(s)
        results = {}

        async def both(name, mine, theirs):
            await asyncio.sleep(0.65)                                              # 超过 500ms:不与上一个手势连成多击
            await s.page.evaluate("window.ev.length=0")
            await ref.evaluate("window.ev.length=0")
            await mine()
            await theirs()
            await asyncio.sleep(0.2)
            a, b = await s.page.evaluate("window.ev"), await ref.evaluate("window.ev")
            results[name] = (a == b, a, b)

        async def pw_click(x, y, n=1, button="left"):
            await ref.mouse.move(x, y)
            await ref.mouse.click(x, y, button=button, click_count=n)
        await both("单击", lambda: d.click(150, 150), lambda: pw_click(150, 150))
        await both("双击", lambda: d.click(150, 150, 2), lambda: pw_click(150, 150, 2))
        await both("三击", lambda: d.click(150, 150, 3), lambda: pw_click(150, 150, 3))
        await both("右键", lambda: d.click(150, 150, 1, 2), lambda: pw_click(150, 150, 1, "right"))
        await both("中键", lambda: d.click(150, 150, 1, 1), lambda: pw_click(150, 150, 1, "middle"))

        async def pw_drag():
            await ref.mouse.move(110, 130)
            await ref.mouse.down()
            await ref.mouse.move(350, 130, steps=8)
            await ref.mouse.up()
        await both("拖拽选字", lambda: d.drag(110, 130, 350, 130), pw_drag)

        async def mine_wheel():
            d.m("wheel", 600, 150, dy=120)
            await d.drain()

        async def pw_wheel():
            await ref.mouse.move(600, 150)
            await ref.mouse.wheel(0, 120)
        await both("滚轮", mine_wheel, pw_wheel)

        async def mine_type():
            await d.click(200, 330)
            for ch, code in (("A", "KeyA"), ("b", "KeyB"), ("1", "Digit1"), (" ", "Space")):
                await d.key(ch, code, ord(ch.upper()), 8 if ch == "A" else 0)
            await d.key("Enter", "Enter", 13)
            await d.key("Backspace", "Backspace", 8)

        async def pw_type():
            await pw_click(200, 330)
            await ref.keyboard.press("Shift+KeyA")
            await ref.keyboard.press("KeyB")
            await ref.keyboard.press("Digit1")
            await ref.keyboard.press("Space")
            await ref.keyboard.press("Enter")
            await ref.keyboard.press("Backspace")
        await both("键盘输入", mine_type, pw_type)
        # 对照组差异里只允许「Shift+A」里多出的 Shift 键本身事件(Playwright press 会发 Shift keydown/up,我们这里没发)—— 先看看结果,再判定
        ok_n = sum(1 for v in results.values() if v[0])
        bad = {k: (v[1][:12], v[2][:12]) for k, v in results.items() if not v[0]}
        for k in list(bad):
            if k == "键盘输入":
                strip = lambda ev: [e for e in ev if e[4] != "Shift"]                                        # noqa: E731
                if strip(results[k][1]) == strip(results[k][2]) or [e[:5] for e in strip(results[k][1])] == [e[:5] for e in strip(results[k][2])]:
                    bad.pop(k)
                    ok_n += 1
        rate = ok_n / float(len(results))
        print("   事件序列一致率 %.0f%%(%d/%d)%s" % (rate * 100, ok_n, len(results), (" 差异:" + str(bad)[:500]) if bad else ""))
        assert rate >= 0.98, bad
        await ref_ctx.close()
    _run(sc)


