def run_eval(args, epoch, adapter, local_rank):
    cmd = [sys.executable, str(HERE / "evaluate.py"), "--adapter", str(adapter), "--epoch", str(epoch), "--data_dir", args.data_dir,
           "--base", args.base, "--device", "cuda:%d" % local_rank, "--eval_log", args.eval_log, "--n", str(args.eval_n)]
    env = {k: v for k, v in os.environ.items() if k not in ("RANK", "WORLD_SIZE", "LOCAL_RANK", "MASTER_ADDR", "MASTER_PORT")}
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=args.eval_timeout)
    except Exception as e:  # noqa: BLE001
        print("⚠ 评估启动失败: %s" % e, flush=True)
        return None
    sim = None
    for ln in (r.stdout or "").splitlines():
        if ln.startswith("EVAL_RESULT "):
            try:
                sim = json.loads(ln[len("EVAL_RESULT "):]).get("similarity")
            except ValueError:
                pass
    if sim is None:
        print("⚠ 评估没有产出结果(训练继续)。stderr 尾部:\n%s" % "\n".join((r.stderr or r.stdout or "").splitlines()[-15:]), flush=True)
    return sim


def train(args):
    from accelerate import Accelerator
