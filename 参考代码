#theater:fullscreen{background:var(--bg)}
@media (max-width:900px){#theater.full{grid-template-columns:minmax(0,1fr);grid-template-areas:"bar" "prog" "stage" "foot"}#theater.full #tLog{display:none}#theater.full #tStage{width:100%}#theater.full #tTitle{display:none}#stage{width:100%}}
@media (max-width:640px){.hero{padding-top:56px}.hero h1{font-size:40px}header{padding:10px 12px}nav a{padding:5px 10px;font-size:13px}.brand small{display:none}#voice.show{grid-template-columns:1fr}}
