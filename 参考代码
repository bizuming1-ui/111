def test_integration_mock():
    srv = Server()
    try:
        # 1) 克隆 + 质检 + 原件保留 + 缺少 consent 被拒绝
        try:
            srv.post("/api/voice?text=x", b"123")
            raise AssertionError("没有 consent 必须被拒绝")
        except urllib.error.HTTPError as e:
            assert e.code == 400
        r = srv.clone()
        assert r["qc"]["kind"] == "clean_speech"
        vd = Path(srv.tmp) / "voice"
        assert list(vd.glob("orig_*")) and list(vd.glob("ref_*.wav")), "原件与处理版都要保存"
        v = srv.state()["voice"]
        assert v["text_trusted"] is True and v["ref_summary"] and v["ref_summary"].get("chars_per_s")
        # 歌声:需要用户确认,且被明确标记
        sg = srv.post("/api/voice?consent=1&ext=wav", wav_bytes(singing(10.0)))
        assert sg.get("needs_ack") and sg["qc"]["kind"] == "singing"

        # 2) 正常一轮:序号连续、END、背压窗口、plan 信息
        res = asyncio.run(run_turn(srv.port, LONG))
        c, d = res["chk"], res["done"]
        assert d and c.verify_done(d["frames"], d["samples"]), (c.stat, d)
        assert not d["errors"] and c.stat == {"dup": 0, "gap": 0, "foreign": 0, "sr": 0, "bad": 0, "missing": 0}
        plan = [m for m in res["msgs"] if m["type"] == "plan"]
        assert plan and "reason" in plan[-1] and plan[-1]["mode"] in ("continuous", "low_latency")
        win = plan[-1]["window_ms"]
        assert res["max_ahead_ms"] <= win + 3000, ("背压失效", res["max_ahead_ms"], win)
        assert d["gpu_segs"], "要有 GPU 分配记录"

        # 3) 不回 ack:网关必须停止发送(有界队列),而不是无限积压
        r2 = asyncio.run(run_turn(srv.port, LONG * 4, sid="noack", ack=False, window_probe=6))
        w2 = [m for m in r2["msgs"] if m["type"] == "plan"][-1]["window_ms"]
        assert r2["recv_ms"] < w2 + 4000, "没有 ack 时发送了 %.0f ms,超过窗口 %d ms + 一句的余量" % (r2["recv_ms"], w2)
        assert r2["chk"] is not None and not r2["chk"].ended

        # 4) 断线重连续传:不重复、不跳过
        r3 = asyncio.run(run_turn(srv.port, LONG * 2, sid="resume1", drop_after=4))
        c3, d3 = r3["chk"], r3["done"]
        assert r3["reconnects"] == 1 and d3 and c3.verify_done(d3["frames"], d3["samples"]), (c3.stat, d3)
        assert any(m["type"] == "resume_ok" for m in r3["msgs"])

        # 5) 音频损坏(NaN)必须报错并保存诊断,不得标记成功
        r4 = asyncio.run(run_turn(srv.port, "这一句会触发 NANTRIGGER 损坏。", sid="nan1"))
        warns = [m for m in r4["msgs"] if m["type"] == "warn" and m.get("integrity")]
        assert warns and r4["done"]["errors"], r4["msgs"]
        assert list((Path(srv.tmp) / "diag").glob("*.json")), "必须保存诊断快照"

        # 6) 报告:真实状态,Mock 不能算通过
        rep = json.load(urllib.request.urlopen(srv.url("/api/report"), timeout=5))
        by = {i["id"]: i for i in rep["items"]}
        assert by[1]["status"] == "未验证" and by[6]["status"] == "未验证" and by[5]["status"] == "失败"
        st = srv.state()
        assert st["backend"]["mock"] is True and "MOCK" in st["backend"]["mode_label"]
    finally:
        srv.stop()


