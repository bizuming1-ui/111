def wav_bytes_mono16(x, sr):
    bio = io.BytesIO()
    with wave.open(bio, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(sr)
        w.writeframes((np.clip(x, -1, 1) * 32767).astype("<i2").tobytes())
    return bio.getvalue()


def G_loop(G):
    return G["LOOP"]


def err(msg, code=400, **kw):
    return JSONResponse({"ok": False, "error": msg, **kw}, status_code=code)


