    r = re.sub(r"[\s,，。.!！?？、]+", "", r)
    if re.fullmatch(r"[\u4e00-\u9fa5]{2,8}(?:市|县|区|省|州|镇|岛|盟|旗)?", r) and r not in _STOP_LOC:
        return r
