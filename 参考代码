app = FastAPI(title="Voice Clone Studio")
LOOP = None
POOL = None
SESSIONS = set()
ACTIVE = {}          # turn uid -> Turn
VOICE = {"vid": 0, "state": "none", "mode": "", "text": "", "path": None, "pending": set(), "info": {}, "err": "", "msg": ""}
ASR_WAIT = {}
_uid = [0]


class Worker:
    def __init__(self, idx, gpu, proc, q):
        self.idx, self.gpu, self.proc, self.q = idx, gpu, proc, q
        self.status, self.msg = "loading", "启动中…"
        self.voice_vid = None
        self.voice_info = {}
        self.pending = 0
        self.mem = (0.0, 0.0, 0)

    def ready(self):
        return self.status in ("ready", "voice") and self.proc.is_alive()


class Pool:
    def __init__(self, ctx, gpus, cfg):
        self.ctx = ctx
        self.epoch = ctx.Value("i", 0)
        self.res_q = ctx.Queue()
        self.workers = []
        for i, g in enumerate(gpus):
            q = ctx.Queue()
            p = ctx.Process(target=worker_main, args=(i, g, q, self.res_q, self.epoch, cfg), daemon=True, name="tts-gpu%s" % g)
            p.start()
            self.workers.append(Worker(i, g, p, q))

    def pick(self):
        cand = [w for w in self.workers if w.ready() and w.voice_vid == VOICE["vid"] and VOICE["vid"] > 0]
        if not cand:
            return None
        return min(cand, key=lambda w: (w.pending, w.idx))

    def bump(self):
        with self.epoch.get_lock():
            self.epoch.value += 1

    def stop(self):
        for w in self.workers:
            try:
                w.q.put(("quit",))
            except Exception:  # noqa: BLE001
                pass


class Session:
    def __init__(self, ws):
        self.ws = ws
        self.q = asyncio.Queue()
        self.history = []
        self.task = None
        self.turn = None

    def send(self, obj):
        self.q.put_nowait(json.dumps(obj, ensure_ascii=False))

    def send_bin(self, b):
        self.q.put_nowait(b)


def broadcast(obj):
    for s in list(SESSIONS):
        s.send(obj)


class Seg:
    def __init__(self, idx, text, end_char):
        self.idx, self.text, self.end = idx, text, end_char
        self.out = []
        self.done = False
        self.err = ""
        self.trim = Trimmer()
        self.worker = -1
        self.had_audio = False
        self.stats = {}


class Turn:
    def __init__(self, sess, ref, breath):
        _uid[0] += 1
        self.uid = _uid[0]
        self.sess, self.ref, self.breath = sess, ref, breath
        self.segs = []
        self.cur = 0
        self.text_done = False
        self.closed = False
        self.pending_pause = 0
        self.t0 = time.time()
        self.first_audio = None
        self.samples = 0
        self.full_text = ""
        self.gpu_segs = {}
        self.tts = True
        self.warned = False


def voice_public():
    return {"state": VOICE["state"], "mode": VOICE["mode"], "text": VOICE["text"], "vid": VOICE["vid"],
            "info": VOICE["info"], "err": VOICE["err"], "msg": VOICE["msg"]}


def state_public():
    ws = []
    for w in POOL.workers if POOL else []:
        ws.append({"idx": w.idx, "gpu": w.gpu, "status": w.status, "msg": w.msg, "voice": (w.voice_vid == VOICE["vid"] and VOICE["vid"] > 0),
                   "mem": [round(w.mem[0], 1), round(w.mem[1], 1)], "util": w.mem[2], "info": w.voice_info, "alive": w.proc.is_alive()})
    return {"type": "state", "workers": ws, "voice": voice_public(), "deepseek": bool(DS_KEY or MOCK_LLM), "mock": MOCK, "model": MODEL}


def pump(turn):
    """按句子顺序把已就绪的音频推给浏览器。第 k 句的音频只有在前 k-1 句全部发完之后才会发出。"""
    if turn.closed:
        return
    sess = turn.sess
    head = struct.pack("<I", turn.uid)
    while turn.cur < len(turn.segs):
        seg = turn.segs[turn.cur]
        if seg.out:
            parts = [head]
            if turn.pending_pause > 0:
                parts.append(np.zeros(int(SR * turn.pending_pause / 1000), "<i2").tobytes())
                turn.pending_pause = 0
            for a in seg.out:
                parts.append(a.astype("<i2").tobytes())
                turn.samples += len(a)
            seg.out = []
            if turn.first_audio is None:
                turn.first_audio = time.time() - turn.t0
            seg.had_audio = True
            sess.send_bin(b"".join(parts))
        if seg.done:
            if seg.had_audio:
                turn.pending_pause = pause_ms(seg.end, turn.breath)
            turn.cur += 1
            continue
        break
    if turn.text_done and turn.cur >= len(turn.segs):
        turn.closed = True
        ACTIVE.pop(turn.uid, None)
        sess.send({"type": "turn_done", "turn": turn.uid, "audio_s": round(turn.samples / SR, 2),
                   "first_ms": int(turn.first_audio * 1000) if turn.first_audio is not None else None,
                   "gpu_segs": turn.gpu_segs, "segs": len(turn.segs),
                   "chars": len(turn.full_text)})


def dispatch(turn, text):
    clean = tts_clean(text)
    if not turn.tts or not has_speech(clean):
        return
    seg = Seg(len(turn.segs), clean, text.strip()[-1:])
    turn.segs.append(seg)
    w = POOL.pick() if POOL else None
    if w is None:
        seg.done = True
        seg.err = "没有可用的 GPU 进程或声音还没克隆好"
        if not turn.warned:
            turn.warned = True
            turn.sess.send({"type": "warn", "msg": "无法朗读: " + seg.err})
        return
    seg.worker = w.idx
    w.pending += len(clean)
    turn.gpu_segs[str(w.idx)] = turn.gpu_segs.get(str(w.idx), 0) + 1
    w.q.put(("tts", turn.uid, POOL.epoch.value, seg.idx, clean, CHUNK_FIRST if seg.idx == 0 else CHUNK_REST))


def on_worker_msg(msg):
    k = msg[0]
    if k == "status":
        _, idx, stage, text = msg
        w = POOL.workers[idx]
        w.status, w.msg = stage, text
        broadcast(state_public())
    elif k == "voice_ok":
        _, idx, vid, info = msg
        w = POOL.workers[idx]
        if vid == VOICE["vid"]:
            w.voice_vid, w.voice_info = vid, info
            VOICE["pending"].discard(idx)
            VOICE["info"][str(idx)] = info
            log.info("[GPU%d] 声音就绪: %s", idx, info)
            _voice_progress()
    elif k == "voice_err":
        _, idx, vid, err = msg
        if vid == VOICE["vid"]:
            VOICE["pending"].discard(idx)
            VOICE["err"] = err
            log.error("[GPU%d] 声音设置失败: %s", idx, err)
            _voice_progress()
    elif k == "asr":
        _, rid, text, err = msg
        fut = ASR_WAIT.pop(rid, None)
        if fut and not fut.done():
            fut.set_result((text, err))
    elif k == "chunk":
        _, tuid, seg_i, data = msg
        t = ACTIVE.get(tuid)
        if t is None or t.closed or seg_i >= len(t.segs):
            return
        seg = t.segs[seg_i]
        a = seg.trim.feed(np.frombuffer(data, dtype="<i2"))
        if a.size:
            seg.out.append(a)
            pump(t)
    elif k in ("seg_done", "seg_err"):
        if k == "seg_done":
            _, tuid, seg_i, idx, stats = msg
            err = ""
        else:
            _, tuid, seg_i, idx, err = msg
            stats = {}
        w = POOL.workers[idx]
        t = ACTIVE.get(tuid)
        if t is None or t.closed or seg_i >= len(t.segs):
            return
        seg = t.segs[seg_i]
        w.pending = max(0, w.pending - len(seg.text))
        a = seg.trim.flush()
        if a.size:
            seg.out.append(a)
        seg.done, seg.err, seg.stats = True, err, stats
        if err:
            t.sess.send({"type": "warn", "msg": "第 %d 句合成失败: %s" % (seg_i + 1, err)})
        elif stats.get("audio"):
            log.info("[#%d] 第%d句 GPU%d: %d字 → 音频 %.1fs, 首包 %.2fs, 耗时 %.1fs (RTF %.2f)", t.uid, seg_i, idx, len(seg.text),
                     stats["audio"], stats.get("first") or 0, stats.get("wall") or 0, (stats.get("wall") or 0) / max(stats["audio"], 1e-3))
        pump(t)


def _voice_progress():
    if not VOICE["pending"]:
        ok = [w for w in POOL.workers if w.voice_vid == VOICE["vid"]]
        VOICE["state"] = "ready" if ok else "error"
        if ok:
            VOICE["err"] = ""
        else:
            VOICE["err"] = VOICE["err"] or "所有 GPU 都没能完成声音设置"
    broadcast(state_public())


def reader_thread(loop):
    while True:
        try:
            msg = POOL.res_q.get()
        except Exception:  # noqa: BLE001
            return
        try:
            loop.call_soon_threadsafe(on_worker_msg, msg)
        except RuntimeError:
            return


# ───────── 声音克隆 ─────────
def read_wav(data):
    import io
    with wave.open(io.BytesIO(data), "rb") as w:
        ch, sw, sr, n = w.getnchannels(), w.getsampwidth(), w.getframerate(), w.getnframes()
        raw = w.readframes(n)
    if sw != 2:
        raise ValueError("需要 16-bit WAV")
    a = np.frombuffer(raw, dtype="<i2").astype(np.float32) / 32768.0
    if ch > 1:
        a = a.reshape(-1, ch).mean(axis=1)
    return a, sr


def prepare_reference(a, sr):
    """清理参考音频: 去直流、去首尾静音、归一化到 -3dBFS。"""
    a = a - float(a.mean())
    fr = max(1, sr // 100)
    n = len(a) // fr
    if n > 10:
        e = np.sqrt((a[: n * fr].reshape(n, fr) ** 2).mean(axis=1))
        thr = max(0.004, float(np.percentile(e, 95)) * 0.06)
        idx = np.where(e > thr)[0]
        if idx.size:
            s = max(0, idx[0] - 15) * fr
            t = min(n, idx[-1] + 20) * fr
            a = a[s:t]
    pk = float(np.abs(a).max()) if a.size else 0
    if pk > 1e-4:
        a = a * (0.7 / pk)
    return a.astype(np.float32), sr


async def clone_job(vid, path, text, xvec):
    try:
        if not xvec and not text:
            w0 = next((w for w in POOL.workers if w.ready()), None)
            VOICE["msg"] = "正在自动识别参考音频里说了什么…"
            broadcast(state_public())
            if w0 is not None:
                rid = "asr%d" % vid
                fut = LOOP.create_future()
                ASR_WAIT[rid] = fut
                w0.q.put(("asr", rid, path))
                try:
                    text, err = await asyncio.wait_for(fut, 240)
                except asyncio.TimeoutError:
                    text, err = "", "识别超时"
                if err:
                    log.warning("自动识别失败: %s", err)
            if not text:
                xvec = True
        if vid != VOICE["vid"]:
            return
        VOICE.update(text=text, mode=("xvec" if xvec else "icl"), msg="", info={}, err="")
        (VOICE_DIR / "current.json").write_text(json.dumps({"path": path, "text": text, "xvec": xvec}, ensure_ascii=False), encoding="utf-8")
        alive = [w for w in POOL.workers if w.proc.is_alive() and w.status != "error"]
        VOICE["pending"] = set(w.idx for w in alive)
        for w in POOL.workers:
            w.voice_vid = None
        if not alive:
            VOICE.update(state="error", err="没有可用的 GPU 进程")
            broadcast(state_public())
            return
        for w in alive:
            w.q.put(("voice", vid, path, text, xvec))
        broadcast(state_public())
    except Exception as e:  # noqa: BLE001
        log.exception("clone_job")
        VOICE.update(state="error", err="%s: %s" % (type(e).__name__, e))
        broadcast(state_public())


def start_clone(path, text, xvec):
    VOICE["vid"] += 1
    VOICE.update(state="cloning", path=path, text=text, mode="", pending=set(), info={}, err="", msg="准备中…")
    asyncio.get_running_loop().create_task(clone_job(VOICE["vid"], path, text, xvec))


@app.post("/api/voice")
async def api_voice(request: Request):
    data = await request.body()
    text = (request.query_params.get("text") or "").strip()
    try:
        a, sr = read_wav(data)
    except Exception as e:  # noqa: BLE001
        return JSONResponse({"ok": False, "error": "音频无法解析: %s" % e}, status_code=400)
    if len(a) / sr < 2.0:
        return JSONResponse({"ok": False, "error": "参考音频太短(<2 秒)"}, status_code=400)
    if len(a) / sr > 40:
        return JSONResponse({"ok": False, "error": "参考音频太长(>40 秒)"}, status_code=400)
    a, sr = prepare_reference(a, sr)
    import soundfile as sf
    VOICE_DIR.mkdir(parents=True, exist_ok=True)
    path = str(VOICE_DIR / ("ref_%d.wav" % int(time.time() * 1000)))      # 每次用新文件名: 引擎按路径缓存声音特征
    sf.write(path, a, sr, subtype="PCM_16")
    for old in VOICE_DIR.glob("ref_*.wav"):
        if str(old) != path and time.time() - old.stat().st_mtime > 600:
            try:
                old.unlink()
            except OSError:
                pass
    start_clone(path, text, False)
    return {"ok": True, "vid": VOICE["vid"], "seconds": round(len(a) / sr, 1)}


@app.delete("/api/voice")
async def api_voice_clear():
    VOICE["vid"] += 1
    VOICE.update(state="none", mode="", text="", path=None, pending=set(), info={}, err="", msg="")
    for w in POOL.workers:
        w.voice_vid = None
    try:
        (VOICE_DIR / "current.json").unlink()
    except OSError:
        pass
    broadcast(state_public())
    return {"ok": True}


