                for nx, ny in pts:
                    await sess.human({"kind": "click", "nx": nx, "ny": ny, "epoch": sess.view_epoch})
                raw = await sess.page.evaluate("window.__raw")
                assert len(raw) == len(pts), raw
                for (nx, ny), (cx, cy) in zip(pts, raw):
                    ex, ey = min(p["w"] - 1, nx * p["w"]), min(p["h"] - 1, ny * p["h"])
                    assert abs(cx - ex) <= 1.01 and abs(cy - ey) <= 1.01, (name, nx, ny, cx, cy, ex, ey)
                    if p["dpr"] > 1 and nx > 0.05:
