    best_e, best_v = hist[0][0], hist[0][1]
    for e, v, _ in hist[1:]:
        if v < best_v * 0.995:
            best_e, best_v = e, v
    last = hist[-1]
    since = last[0] - best_e
    overfit = len(hist) >= 3 and last[1] > best_v * 1.02 and last[2] < hist[-3][2]
    if since >= patience:
        return True, "早停:验证 loss 连续 %d 轮无提升(已收敛或开始过拟合)" % patience, best_e, best_v, True, overfit
    if last[0] >= max_epochs:
        return True, "达到最大轮数(未必收敛)", best_e, best_v, False, overfit
    return False, "", best_e, best_v, False, overfit


