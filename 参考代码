FILES['protocol.py'] = r'''# -*- coding: utf-8 -*-
"""
protocol.py —— 音频帧协议 v2(网关 ↔ 浏览器共用,带单元测试)

每个 WebSocket 二进制帧 = 20 字节小端头 + int16 PCM:
    turn  u32   轮次 ID(防止不同轮次串音)
    seq   u32   轮内序号,从 0 连续递增(检测漏块 / 重复块 / 乱序)
    sr    u32   本帧真实采样率
    n     u32   本帧样本数(必须等于 payload 字节数 / 2)
    flags u16   bit0 END  = 本轮最后一帧(可以 n=0,仅作结束标记)
                bit1 SEG  = 本帧是某个句子的第一帧
                bit2 PAUSE= 本帧开头包含按标点插入的自然停顿(静音)
    seg   u16   句子序号(取模 65536,仅用于诊断)
头长 20 字节 → PCM 起点 4 字节对齐,浏览器可直接建立 Int16Array 视图,无需拷贝。
"""
import struct

HEADER = struct.Struct("<IIIIHH")
HEADER_SIZE = HEADER.size           # 20
F_END, F_SEG, F_PAUSE = 1, 2, 4


class FrameError(ValueError):
    pass


def pack_frame(turn, seq, sr, pcm_bytes, flags=0, seg=0):
    if len(pcm_bytes) % 2:
        raise FrameError("PCM 字节数必须是偶数")
    return HEADER.pack(turn & 0xFFFFFFFF, seq & 0xFFFFFFFF, sr, len(pcm_bytes) // 2, flags & 0xFFFF, seg & 0xFFFF) + bytes(pcm_bytes)


def unpack_frame(buf):
    if len(buf) < HEADER_SIZE:
        raise FrameError("帧太短: %d 字节" % len(buf))
    turn, seq, sr, n, flags, seg = HEADER.unpack_from(buf, 0)
    if len(buf) - HEADER_SIZE != n * 2:
        raise FrameError("样本数与负载长度不符: 头部 n=%d, 实际 %d 字节" % (n, len(buf) - HEADER_SIZE))
    return {"turn": turn, "seq": seq, "sr": sr, "n": n, "flags": flags, "seg": seg, "pcm": bytes(buf[HEADER_SIZE:])}


class FrameChecker:
    """接收端校验器(与浏览器里的 JS 实现逻辑一致)。accept() 返回 (动作, 说明): 'ok' | 'dup' | 'gap' | 'foreign' | 'sr' | 'bad'"""

    def __init__(self, turn, sr=24000):
        self.turn, self.sr = turn, sr
        self.expected = 0
        self.samples = 0
        self.count = 0
        self.ended = False
        self.stat = {"dup": 0, "gap": 0, "foreign": 0, "sr": 0, "bad": 0, "missing": 0}

    def accept(self, buf):
        try:
            f = unpack_frame(buf)
        except FrameError as e:
            self.stat["bad"] += 1
            return "bad", str(e)
        if f["turn"] != self.turn:
            self.stat["foreign"] += 1
            return "foreign", "turn %d != %d" % (f["turn"], self.turn)
        if f["sr"] != self.sr:
            self.stat["sr"] += 1
            return "sr", "sr %d != %d" % (f["sr"], self.sr)
        if f["seq"] < self.expected:
            self.stat["dup"] += 1
            return "dup", "seq %d < expected %d" % (f["seq"], self.expected)
        if f["seq"] > self.expected:
            self.stat["gap"] += 1
            self.stat["missing"] += f["seq"] - self.expected
            return "gap", "seq %d > expected %d" % (f["seq"], self.expected)
        self.expected += 1
        self.count += 1
        self.samples += f["n"]
        if f["flags"] & F_END:
            self.ended = True
        return "ok", f

    def verify_done(self, chunks, samples):
        """与服务端 turn_done 里的总块数 / 总样本数对账"""
        return self.ended and self.count == chunks and self.samples == samples and not self.stat["gap"] and not self.stat["dup"]
'''

