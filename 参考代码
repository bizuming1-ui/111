class MockEngine:
    """无 GPU 的自检引擎(VC_MOCK=1):合成正弦"语音",用来验证整条链路。"""
    name = "mock"

    def __init__(self, idx, send):
        self.idx, self.send = idx, send
        self.dtype = "mock"

    def load(self):
        time.sleep(0.5)

    def backend_info(self):
        return {"mock": True, "backend": "mock (正弦波合成, 非真实模型)", "device": "none", "model": "mock"}

    def spk_qc(self, path):
        return {"status": "not_evaluated", "reason": "Mock 引擎不产生真实声纹结论(仅用于测试)", "kind": "reference_qc", "mock": True, "suspect": False, "p10": None, "mean": None, "n_windows": 0}

    def spk_cmp(self, gen_path, ref_paths):
        return {"status": "not_evaluated", "reason": "Mock 引擎不产生真实声纹分数(仅用于测试)", "kind": "generated_vs_holdout", "mock": True, "scores": [None for _ in ref_paths], "model": "mock"}

    def set_voice(self, path, text, xvec):
        time.sleep(0.4)
        t0, first, n, ch, tp = time.time(), None, 0, [], time.time()
        for a, sr in self.stream("今天天气真好，我们一起出去走走吧。", "calib"):
            now = time.time()
            first = first or (now - t0)
            ch.append((round(now - tp, 4), len(a)))
            tp, n = now, n + len(a)
        wall = time.time() - t0
        return {"rtf": round(wall / (n / SR), 2), "ttfa": round(first, 2), "dtype": "mock", "sr": SR, "mode": "mock", "sim": 0.96, "rms": 3000.0, "ch": ch, "prompt_cached": True}

    def stream(self, text, profile, seed=None):
        """成本模型≈T4 + 1.7B(faster-qwen3-tts 官方数据 RTF≈0.93~1.07, TTFA≈1s):
        预填充 PRE;每帧生成 F;每次解码一个固定开销 D。可用环境变量调参来压测调度/播放器。"""
        _seed_all(seed)
        F = float(os.environ.get("VC_MOCK_FRAME_MS", "82")) / 1000
        D = float(os.environ.get("VC_MOCK_DEC_MS", "30")) / 1000
        PRE = float(os.environ.get("VC_MOCK_PREFILL_MS", "450")) / 1000
        sched = SCHED.get(profile, SCHED["rest"])
        dur = max(0.6, len(text) * 0.2)
        f0 = 140 + (sum(map(ord, text)) % 5) * 25
        lead, tail = 0.18, 0.22
        total = lead + dur + tail
        nfr = int(total * 12.5)
        time.sleep(PRE)
        done, i, t0 = 0, 0, 0.0
        while done < nfr:
            n = min(sched[min(i, len(sched) - 1)], nfr - done)
            time.sleep(n * F + D)
            d = n / 12.5
            t = np.arange(int(SR * d)) / SR + t0
            sig = sum(np.sin(2 * np.pi * f0 * h * t) / h for h in range(1, 6))
            env = ((t > lead) & (t < lead + dur)) * (0.6 + 0.4 * np.sin(2 * np.pi * 3 * t))
            if os.environ.get("VC_MOCK_FAIL") == "nan" and "NANTRIGGER" in text:
                yield np.full(int(SR * d), np.nan, np.float32), SR
                return
            out_ = (0.25 * sig * env).astype(np.float32)
            if os.environ.get("VC_MOCK_ZERORUN") == "1" and i == 3 and len(out_) > 3000:      # Mock(v15):句内注入 1920 样本(80ms=一个码帧)数字零段,复现参考克隆里的零段簇
                out_[600:600 + 1920] = 0.0
            yield out_, SR
            done += n
            i += 1
            t0 += d
            self.last_frames = done
            if getattr(self, "capture_codes", False) and "RUNAWAYLOOP" in text and ((seed or 0) % 2 == 0 or "RUNAWAYALWAYS" in text):
                self.code_log.extend([7, 19, 233, 41, 5, 88] * max(1, n // 2))      # Mock:重复循环码(v13 检测用)
            _lg = os.environ.get("VC_MOCK_LATE_GPU", "")
            late_on = ("RUNAWAYLATE" in text and ((seed or 0) % 2 == 0 or os.environ.get("VC_MOCK_LATE_ALWAYS") == "1") and (_lg == "" or int(_lg) == self.idx))
            if getattr(self, "capture_codes", False) and "RUNAWAYLATE" in text:
                self.code_log.extend(range(1000 + done, 1000 + done + n))           # Mock(v14):内容期每帧码都不同
        if getattr(self, "capture_codes", False) and "RUNAWAYLATE" in text and late_on:        # Mock(v14):内容播完后不出 EOS,同一个码连续输出,电平 -34dB(不是低电平,TailHold 抓不到)
            for _ in range(60):
                time.sleep(12 * F + D)
                nz = np.random.default_rng(3).standard_normal(int(SR * 12 / 12.5))
                nz = np.convolve(nz, np.ones(8) / 8, mode="same")
                nz = nz / (np.sqrt(np.mean(nz ** 2)) + 1e-9) * 10 ** (-34 / 20)
                done += 12
                self.last_frames = done
                self.code_log.extend([5] * 12)
                yield nz.astype(np.float32), SR
        if os.environ.get("VC_MOCK_RUNAWAY") == "1" and "RUNAWAYTAIL" in text:      # 复刻线上故障:正常内容之后继续吐 -48dB 低电平噪声(未出 EOS)
            rng = np.random.default_rng(int(seed or 0) % 1000)
            for _ in range(6):
                nz = np.convolve(rng.standard_normal(int(SR * 12 / 12.5)), np.ones(40) / 40, mode="same")
                nz = nz / (np.sqrt(np.mean(nz ** 2)) + 1e-9) * 10 ** (-48 / 20)
                time.sleep(12 * F + D)
                done += 12
                self.last_frames = done
                yield nz.astype(np.float32), SR

    last_score = {"status": "completed", "reason": "Mock 假分数,仅用于测试链路,不代表真实质量"}

    def score(self, pcm):
        return 0.95 + (len(pcm) % 7) / 200.0

    def asr(self, path):
