            w.append("参考文字与音频时长不匹配(%.1f 字/秒),请核对文字是否与录音严格对应" % cps)
    q["blocking"] = kind in ("singing", "bg_music", "noisy", "unknown") or q["clip_ratio"] > 0.02 or dur < 3
    return q


