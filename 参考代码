                        raise AudioCorrupt("chunk 边界波形断裂(跳变 %.0f)" % qc.joins[-1][0])
                    now = time.time()
                    if first is None:
                        first = now - t0
                    nsamp += len(pcm)
                    acc.append(pcm)
                    ch.append((round(now - t_prev, 4), len(pcm)))
                    t_prev = now
                    send("chunk", tuid, seg, pcm.tobytes(), round(now - t0, 4))
                    sent_any = True
            except AudioCorrupt as e:
                err = e
            finally:
                try:
                    gen.close()
                except Exception:  # noqa: BLE001
                    pass
            wall = time.time() - t0
            if cancelled:
                send("seg_done", tuid, seg, idx, {"skipped": True, "cancelled": True})
                return
            if err is None:
                fr = int(getattr(eng, "last_frames", 0) or 0)
                rep_ = qc.finish(frames=fr or None, hit_max=bool(fr and fr >= max_new - 1))
                if rep_["errors"]:
                    err = AudioCorrupt("; ".join(rep_["errors"]))
            else:
                rep_ = qc.finish()
                rep_["errors"] = [str(err)]
            if err is not None:
                wav = save_diag(DIAG_DIR, "gpu%s_t%s_s%s_a%d" % (idx, tuid, seg, attempt), qc.audio(), dict(rep_, text=text, seed=cur, gpu=idx))
