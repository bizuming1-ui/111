class Metrics:
    def __init__(self, n=200):
        self.d = {}
        self.n = n

    def add(self, name, ms):
        self.d.setdefault(name, deque(maxlen=self.n)).append(float(ms))

    def pct(self, name, q):
        xs = sorted(self.d.get(name) or [])
        if not xs:
            return None
        i = min(len(xs) - 1, max(0, int(round(q * (len(xs) - 1)))))
        return round(xs[i], 1)

    def summary(self):
        return {k: {"n": len(v), "p50_ms": self.pct(k, 0.5), "p95_ms": self.pct(k, 0.95)} for k, v in self.d.items()}


