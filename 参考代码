        out["f0_median_hz"] = round(float(np.median(v)), 1)
        out["f0_p10_hz"], out["f0_p90_hz"] = round(float(np.percentile(v, 10)), 1), round(float(np.percentile(v, 90)), 1)
        out["f0_range_st"] = round(float(np.percentile(st, 90) - np.percentile(st, 10)), 2)
        out["f0_std_st"] = round(float(st.std()), 2)
    ed = edb[act]
    out["loud_p10_db"], out["loud_p90_db"] = round(float(np.percentile(ed, 10)), 1), round(float(np.percentile(ed, 90)), 1)
    out["loud_range_db"] = round(out["loud_p90_db"] - out["loud_p10_db"], 1)
    out["peak_dbfs"] = round(db(float(np.abs(x).max())), 2)
    seg = x[int(a0 * hop * sr): int(a1 * hop * sr)]
