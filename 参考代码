# ───────────────────────── 7. 保活 / 看门狗 ─────────────────────────
# 每个节拍的所有检查都在 try/except 里:任何一项异常(nvidia-smi 卡住、网络抖动…)只记一行,绝不会让看门狗本身退出。
n, last_beat, last_restart, bad_ticks = 0, 0, 0.0, 0


def tick():
    global n, last_beat, last_restart, bad_ticks, public_url
    if TEST and os.environ.get("VC_TEST_EXIT") == "1":
        return True
    if _VC_SRV["proc"].poll() is not None:
        print("[%s] ⚠ 服务进程退出,正在自动拉起…" % time.strftime("%H:%M:%S"), flush=True)
        print("\n".join("   " + l for l in list(_VC_SRV["tail"])[-8:]))
        subprocess.run(["bash", "-lc", "pkill -f %s || true" % (APP / "app.py")])
        time.sleep(3)
        start_server()
        last_restart = time.time()
        return False
    h = health()
    ws_ = (h or {}).get("workers", [])
    dead = [w for w in ws_ if (not w.get("alive", True)) or w["status"] == "error"]
    bad_ticks = bad_ticks + 1 if (h is None or (dead and len(dead) < len(ws_))) else 0
    if bad_ticks >= 4 and time.time() - last_restart > 300:      # 连续 ~1 分钟不健康(网关无响应 / 有一张卡的进程挂了) → 重启服务,声音会自动恢复
        print("[%s] ⚠ 服务不健康(无响应或 GPU 进程已挂),重启服务…" % time.strftime("%H:%M:%S"), flush=True)
        try:
            os.killpg(os.getpgid(_VC_SRV["proc"].pid), 15)
        except Exception:
            pass
        time.sleep(4)
        start_server()
        last_restart, bad_ticks = time.time(), 0
        return False
    if time.time() - last_beat >= 300:                           # 每 5 分钟打印一次,避免 Kaggle 因长时间无输出回收会话
        last_beat = time.time()
        n += 1
        free = disk_free_gb()
        print("[%s] 💓 心跳 #%d · 服务 %s · GPU进程 %s · 声音 %s · %s · 磁盘剩余 %.1fGB" % (time.strftime("%H:%M:%S"), n, "正常" if h else "❌无响应",
              "/".join(w["status"] for w in ws_), (h or {}).get("voice", "?"), gpu_report(), free), flush=True)
        if free < 1.5:                                           # 磁盘保护: 清理旧的参考录音与缓存,免得写满导致服务崩溃
            for f in sorted((WORK / "voice").glob("ref_*.wav"), key=lambda x: x.stat().st_mtime)[:-1]:
                try:
                    f.unlink()
                except OSError:
                    pass
            shutil.rmtree(Path.home() / ".cache" / "pip", ignore_errors=True)
            print("   ⚠ 磁盘不足 1.5GB,已清理旧参考录音与 pip 缓存(剩余 %.1fGB)" % disk_free_gb(), flush=True)
        if not TEST:
            try:
                from pyngrok import ngrok
                if not ngrok.get_tunnels():
                    raise RuntimeError("隧道消失")
            except Exception as e:
                print("   ⚠ ngrok 隧道异常(%s),正在重建…" % e, flush=True)
                try:
                    public_url = open_ngrok(token)
                    print("   ✅ 新地址: " + public_url, flush=True)
                except Exception as e2:
                    print("   ❌ 重建失败: %s" % e2, flush=True)
    return False


try:
    while True:
        time.sleep(15)
        try:
            if tick():
                break
        except Exception as e:
            print("[%s] 看门狗节拍异常(已隔离,继续运行): %s: %s" % (time.strftime("%H:%M:%S"), type(e).__name__, e), flush=True)
except KeyboardInterrupt:
