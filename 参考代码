def v13_job_extra(t, seg_i, clean, w):
    """给 GPU 进程的附加参数:每声音实测的 spc(帧预算用)+ 是否整句保持(hold_for_qc)。
    hold 条件:播放已经开始,且 播放头之后还剩的音频 ≥ 预计本句生成耗时 + 500ms —— 否则流式放行(首块 ≥160ms 才放行)。"""
    if not v13_on("GUARD"):
        return None
    st = W(w.idx)
    nfr = _v13.expected_frames(clean, TEXT_STATS["spc"])
    est_ms = (st["PRE"] + st["F"] * nfr + st["D"] * max(1.0, nfr / 12.0)) * 1000.0
    slack = t.sent_ahead_ms() + t.unsent_ms()
    hold = bool(seg_i >= 1 and not t.sess.legacy and t.first_audio is not None and slack >= est_ms + 500.0)
    return {"hold": hold, "spc": float(TEXT_STATS["spc"]), "est_ms": int(est_ms), "slack_ms": int(slack)}


def v13_plan(turn, need, need_ms):
    """M5 滚动视界起播(取代 v12 最长 60 秒的一次性水位):见 v13.rolling_plan。"""
    llm_slow, extra = False, ""
    if not turn.say_only and not turn.text_done:
        cps = turn.llm_cps()
        if cps is not None and cps < 1.5 / max(TEXT_STATS["spc"], 0.05):
            llm_slow = True
            need_ms = max(need_ms, 1500.0)
            extra = ";LLM 文字到达速度(%.1f 字/秒)偏慢,多预留 1.5 秒" % cps
    br_n, br_ms = 0, 0.0
    if v13_on("OPENER") and OPENERS is not None and OPENERS.vid == VOICE["vid"] and OPENERS.count() > 0 and not turn.sess.legacy:
        br_n = min(_v13.MAX_BRIDGES, OPENERS.count())
        br_ms = OPENERS.avg_ms(("ack", "think")) * br_n
    pl = _v13.rolling_plan(need_ms, PLAN_K, PLAN_FLOOR_MS, br_ms, br_n)
    v13_ts(turn).mode = pl["mode"]
    return {"ms": pl["ms"], "need_ms": int(need_ms), "reason": pl["reason"] + extra, "extra_wait_ms": int(max(0, pl["ms"] - PLAN_FLOOR_MS)), "llm_slow": llm_slow,
            "capped": pl["mode"] == "fallback", "mode": pl["mode"], "bridge": bool(pl["bridge"]), "bridge_ms": int(br_ms)}


def v13_emit_bridge(turn, cats, lead=False):
    """放一段【真实的克隆声音】桥接语音(嗯/让我想想/然后呢…)。不是静音、不是变速;每轮最多 MAX_BRIDGES 段。"""
    if not v13_on("OPENER") or OPENERS is None or turn.closed or turn.sess.legacy or OPENERS.vid != VOICE["vid"]:
        return False
    ts = v13_ts(turn)
    if ts.bridges >= _v13.MAX_BRIDGES:
        return False
    pick = OPENERS.pick(cats)
    if pick is None:
        return False
    key, text, pcm = pick
    b = np.asarray(pcm, dtype="<i2").tobytes()
    seg_i = max(0, min(turn.cur, len(turn.segs) - 1))
    turn.samples += len(b) // 2
    art_record(turn, seg_i, b, b"")                                   # 归档 = 实际播放序列(桥接记在停顿槽位,保持逐样本一致)
    if turn.first_audio is None:
        turn.first_audio = time.time() - turn.t0
        WARM["n"] += 1
    emit(turn, b, 0, seg_i)
    ms = len(pcm) * 1000 // SR
    ts.bridges += 1
    ts.bridge_ms += ms
    ts.bridge_log.append({"key": key, "text": text, "at_ms": int((time.time() - turn.t0) * 1000), "lead": bool(lead)})
    V13M["bridges"] += 1
    V13M["lead_bridges"] += 1 if lead else 0
    turn.sess.send({"type": "bridge", "turn": turn.uid, "key": key, "text": text, "ms": ms, "lead": bool(lead)})
    log.info("[#%d] 桥接语音「%s」%d ms(%s)", turn.uid, text, ms, "开场" if lead else "补缺口")
    return True


def _v13_recheck(turn):
    ts = getattr(turn, "v13", None)
    if ts is not None:
        ts.timer = None
    if not turn.closed:
        pump(turn)


def v13_watch(turn):
    """滚动视界:下一句还没到、播放头快追上已发出的音频(余量 <300ms)→ 放桥接语音,而不是让浏览器欠载。"""
    if not (v13_on("PLAN") and v13_on("OPENER")) or turn.closed or turn.first_audio is None or turn.sess.legacy or LOOP is None:
        return
    ts = v13_ts(turn)
    if ts.bridges >= _v13.MAX_BRIDGES or turn.cur >= len(turn.segs):
        return
    seg = turn.segs[turn.cur]
    if seg.out or seg.done or seg.worker < 0 or seg.had_audio:         # 只在【句子边界】补桥接:本句还没出过声;句中卡顿不插话(那会把一句话拦腰截断)
        return
    ahead = turn.sent_ahead_ms()
    if ahead > 300:
        if ts.timer is None:
            ts.timer = LOOP.call_later(max(0.05, (ahead - 250) / 1000.0), _v13_recheck, turn)
        return
    if v13_emit_bridge(turn, ("think", "ack") if turn.cur == 0 else ("bridge", "think")) and ts.timer is None:
        ts.timer = LOOP.call_later(max(0.05, (turn.sent_ahead_ms() - 250) / 1000.0), _v13_recheck, turn)


def v13_opener_kick(pool):
    """声音就绪后,在【没有任何轮次在合成、没有排队任务】的空闲卡上,逐条后台合成桥接音库(一次一条,真实任务永远优先)。"""
    if not (v13_on("OPENER") and v13_on("PLAN")) or OPENERS is None:
        return
    vid = VOICE["vid"]
    if vid <= 0:
        return
    if OP_STATE["vid"] != vid:
        OP_STATE.update(vid=vid, queue=list(_v13.opener_jobs()), busy=None, done=0, t0=time.time())
        OPENERS.reset(vid)
    if OP_STATE["busy"] is not None and time.time() - OP_STATE["t_busy"] > 90:
        OP_STATE["busy"] = None                                         # 超时保护:worker 异常时不会永远卡住
    if OP_STATE["busy"] is not None or not OP_STATE["queue"] or pool.backlog or ACTIVE:
        return
    for w in sorted(pool.usable(), key=lambda x: x.idx):
        if w.inflight > 0:
            continue
        key, cat, text = OP_STATE["queue"].pop(0)
        OP_STATE["busy"], OP_STATE["t_busy"] = key, time.time()
        w.inflight += 1
        w.cur = None
        w.q.put(("opener", vid, key, cat, text, seg_seed(vid, 9000 + len(OP_STATE["queue"]), text)))
        return


def v13_on_opener(msg):
    _, idx, vid, key, data, info = msg
    OP_STATE["busy"] = None
    w = POOL.workers[idx]
    w.inflight = max(0, w.inflight - 1)
    w.cur = None
    try:
        if vid != VOICE["vid"] or OPENERS is None:
            return
        OP_STATE["done"] += 1
        if not data:
            OPENERS.failed[key] = (info or {}).get("why") or "合成失败"
            log.warning("桥接音库 %s 失败: %s", key, OPENERS.failed[key])
            return
        tr = Trimmer()
        a = np.concatenate([tr.feed(np.frombuffer(data, dtype="<i2")), tr.flush()])
        lev = _v13.Leveler()
        lev.preset(v13_voice_rms(idx))
        a = np.concatenate([lev.process(a), lev.flush()])
        ok, why = _v13.opener_ok(a)
        if ok:
            OPENERS.add(key, (info or {}).get("cat"), (info or {}).get("text"), a)
            log.info("桥接音库 +1:%s「%s」%.2fs(已有 %d 条)", key, (info or {}).get("text"), len(a) / SR, OPENERS.count())
        else:
            OPENERS.failed[key] = why
        broadcast(state_public())
    finally:
        POOL.schedule()


def v13_on_metrics(msg):
    _, idx, d = msg
    V13M["segs"] += 1
    for k_ in ("runaway", "early_stopped", "retries", "released_corrupt"):
        V13M[k_] += int(d.get(k_, 0) or 0)
    V13M["failed_segs"] += int(d.get("failed", 0) or 0)
    V13M["wasted_s"] = round(V13M["wasted_s"] + float(d.get("wasted_s", 0) or 0), 2)
    V13M["hold_segs" if d.get("hold") else "stream_segs"] += 1


