const HEARTBEAT_INTERVAL = 18000;                   // 每 18 秒发一次心跳
const RECONNECT_DELAY = 2000;                       // 断线 2 秒后自动重连
const CHUNK_DECODE_SIZE = 24000 * 2 * 0.1;          // 每 100ms 音频量排一次队
const WS_URL = "{{WS_URL}}";                        // 服务端在返回网页时自动替换成真实地址
/* ═════════ 工具 ═════════ */
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
const ls = { get(k, d) { try { const v = localStorage.getItem("vc_" + k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } }, set(k, v) { try { localStorage.setItem("vc_" + k, JSON.stringify(v)); } catch (e) {} } };
const logs = [];
function log(msg, kind) {
  const t = new Date().toLocaleTimeString("zh-CN", { hour12: false });
  logs.push({ t, msg, kind }); if (logs.length > 400) logs.shift();
  const el = $("logs"); const d = document.createElement("div"); d.className = kind || ""; d.textContent = t + "  " + msg; el.appendChild(d);
  if (el.children.length > 400) el.removeChild(el.firstChild);
  if ($("logd").classList.contains("open")) el.scrollTop = el.scrollHeight;
}
$("btnLog").onclick = () => { $("logd").classList.add("open"); $("logs").scrollTop = 1e9; };
$("logClose").onclick = () => $("logd").classList.remove("open");

/* ═════════ 全局状态 ═════════ */
const S = {
  ws: null, wsOk: false, state: null, uid: null, turnDone: true, t0: 0, firstMs: null, underruns: 0, minRho: 1, llmMs: null,
  startMs: ls.get("startMs", Math.round(START_THRESHOLD_BYTES / 48)), opts: { auto: ls.get("auto", true), smooth: ls.get("smooth", true), filler: ls.get("filler", false), long: ls.get("long", false), breath: ls.get("breath", 1) },
  bubble: null, metaEl: null, ref: null, retry: 0, pingT: null, lastLat: null, phase: "idle",
};

/* ═════════ 播放器 ═════════
 * 引擎 A(默认): AudioWorklet 无缝播放 —— 一条连续的采样时间线,缓冲吃紧时"保音高弹性放慢"而不是停住。
 * 引擎 B(兜底): AudioContext 时间线排队 —— 每块音频精确 start(nextPlayTime),nextPlayTime += duration,绝不 start(0)。
 *               浏览器没有 AudioWorklet(旧版 Safari 等)时自动启用。
 */
const PW = {
  ctx: null, node: null, p: null,
  init() {
    if (this.p) { if (this.ctx.state === "suspended") this.ctx.resume(); return this.p; }
    this.p = (async () => {
      const AC = window.AudioContext || window.webkitAudioContext;
      let ctx; try { ctx = new AC({ sampleRate: SAMPLE_RATE, latencyHint: "interactive" }); } catch (e) { ctx = new AC(); }
      try {
        ctx.resume();
        await ctx.audioWorklet.addModule("/worklet.js?v=" + Date.now());
        const node = new AudioWorkletNode(ctx, "vc-player", { numberOfInputs: 0, numberOfOutputs: 1, outputChannelCount: [1] });
        node.connect(ctx.destination);
        node.port.onmessage = (e) => onPlayerMsg(e.data);
        this.ctx = ctx; this.node = node;
      } catch (e) { try { ctx.close(); } catch (_) {} this.p = null; throw e; }
      log("音频引擎就绪 · 采样率 " + ctx.sampleRate + "Hz" + (ctx.sampleRate !== SAMPLE_RATE ? "(与 TTS 不同,已启用重采样)" : ""), "o");
    })();
    return this.p;
  },
  get rate() { return this.ctx.sampleRate; },
  open() { this.node.port.postMessage({ t: "open", cfg: { startMs: S.startMs, hiMs: Math.max(300, S.startMs), loMs: 110, rebufMs: Math.max(700, S.startMs * 2), rhoMin: 0.62, stretch: S.opts.smooth } }); },
  end() { this.node.port.postMessage({ t: "end" }); },
  flush() { this.node.port.postMessage({ t: "flush" }); },
  push(buf) {                                    // buf: ArrayBuffer(含 4 字节 turn 头)
    const i16 = new Int16Array(buf, 4, (buf.byteLength - 4) >> 1);
    let f = new Float32Array(i16.length);
    for (let i = 0; i < i16.length; i++) f[i] = i16[i] / 32768;
    if (this.rate !== SAMPLE_RATE) f = resample(f, SAMPLE_RATE, this.rate);
    this.node.port.postMessage({ t: "pcm", d: f }, [f.buffer]);
  },
};

const PT = {
  ctx: null, p: null, next: 0, acc: [], accBytes: 0, srcs: new Set(), started: false, ended: false, rebuf: false, startBytes: START_THRESHOLD_BYTES, tm: null,
  init() {
    if (this.p) { if (this.ctx.state === "suspended") this.ctx.resume(); return this.p; }
    this.p = (async () => {
      const AC = window.AudioContext || window.webkitAudioContext;
      let ctx; try { ctx = new AC({ sampleRate: SAMPLE_RATE, latencyHint: "interactive" }); } catch (e) { ctx = new AC(); }   // 必须指定 24000
      await ctx.resume(); this.ctx = ctx;
      this.tm = setInterval(() => this.tick(), 100);
    })();
    return this.p;
  },
  open() {
    this.flush(); this.ended = false; this.started = false; this.rebuf = false; this.next = 0;
    this.startBytes = Math.max(START_THRESHOLD_BYTES, S.startMs * 48);
  },
  push(buf) {
    const i16 = new Int16Array(buf, 4, (buf.byteLength - 4) >> 1);
    this.acc.push(new Int16Array(i16)); this.accBytes += i16.length * 2;
    this.drain(false);
  },
  drain(force) {
    if (!this.accBytes) return;
    const need = this.rebuf ? this.startBytes * 2 : this.started ? CHUNK_DECODE_SIZE : this.startBytes;
    if (!force && this.accBytes < need) return;
    const n = this.accBytes / 2, f = new Float32Array(n); let o = 0;
    for (const a of this.acc) { for (let i = 0; i < a.length; i++) f[o + i] = a[i] / 32768; o += a.length; }
    this.acc = []; this.accBytes = 0;
    try {                                         // 解码/排队失败: 跳过这一块,继续处理后面的
      const ctx = this.ctx, ab = ctx.createBuffer(1, n, SAMPLE_RATE); ab.copyToChannel(f, 0);
      const now = ctx.currentTime;
      if (this.next <= now + 0.005) this.next = now + 0.01;   // 低水位保护: 时间线落后于现在(已断档) -> 拉回,留 10ms 防撕裂
      const src = ctx.createBufferSource(); src.buffer = ab; src.connect(ctx.destination);
      src.onended = () => this.srcs.delete(src); this.srcs.add(src);
      src.start(this.next);                       // 精确排队,绝不 start(0)
      this.next += ab.duration;                   // 时间线向前推进
      this.rebuf = false;
      if (!this.started) { this.started = true; onPlayerMsg({ t: "started" }); }
    } catch (e) { log("排队失败(已跳过): " + e.message, "w"); }
  },
  tick() {
    if (!this.ctx) return;
    const ms = Math.max(0, (this.next - this.ctx.currentTime) * 1000);
    if (this.started && !this.ended && !this.rebuf && ms <= 0 && !this.accBytes) { this.rebuf = true; onPlayerMsg({ t: "underrun" }); }
    if (this.started && this.ended && ms <= 0 && !this.accBytes) { this.started = false; this.ended = false; onPlayerMsg({ t: "drained" }); return; }
    if (this.ended && this.accBytes) this.drain(true);
    onPlayerMsg({ t: "stat", ms, rho: 1, mode: this.rebuf ? "rebuffer" : this.started ? "playing" : "buffering", low: ms < LOW_WATER_MS });
  },
  end() { this.ended = true; this.drain(true); if (!this.started) { this.ended = false; onPlayerMsg({ t: "drained" }); } },
  flush() {
    for (const s of this.srcs) { try { s.onended = null; s.stop(); } catch (e) {} }
    this.srcs.clear(); this.acc = []; this.accBytes = 0; this.next = 0; this.started = false; this.ended = false; this.rebuf = false;
  },
};

const P = {
  impl: null, p: null,
  get ctx() { return this.impl ? this.impl.ctx : null; },
  get node() { return this.impl ? (this.impl.node || this.impl.ctx) : null; },
  init() {
    if (this.p) { const c = this.ctx; if (c && c.state === "suspended") c.resume(); return this.p; }
    this.p = (async () => {
      let impl = null;
      if (window.AudioWorkletNode) { try { await PW.init(); impl = PW; } catch (e) { log("AudioWorklet 不可用(" + e.message + "),改用时间线排队播放", "w"); } }
      if (!impl) { await PT.init(); impl = PT; }
      this.impl = impl;
      log("播放引擎: " + (impl === PW ? "AudioWorklet 无缝播放" : "AudioContext 时间线排队(nextPlayTime)"), "o");
    })().catch((e) => { this.p = null; throw e; });
    return this.p;
  },
  open() { this.impl.open(); },
  end() { if (this.impl) this.impl.end(); },
  flush() { if (this.impl) this.impl.flush(); },
  push(b) { this.impl.push(b); },
};

function onPlayerMsg(m) {
  if (m.t === "started") {
    S.firstMs = Math.round(performance.now() - S.t0);
    $("tFirst").textContent = (S.firstMs / 1000).toFixed(2) + "s";
    setPhase("play"); log("首声 " + S.firstMs + "ms", "o");
  } else if (m.t === "stat") {
    const ms = m.ms, pct = Math.min(100, ms / TARGET_BUFFER_MS * 100);        // 绿 >50% · 黄 20~50% · 红 <20%
    const cls = pct < 20 ? " danger" : pct < 50 ? " low" : "";
    $("pbarI").style.width = pct + "%"; $("pbar").className = "pbar" + cls;
    $("meterI").style.width = pct + "%"; $("meter").className = "meter" + cls;
    $("sBuf").textContent = "缓冲: " + Math.round(ms) + "ms";
    if (m.rho < 0.995) { S.minRho = Math.min(S.minRho, m.rho); $("rateTx").textContent = "弹性放慢 ×" + m.rho.toFixed(2); } else $("rateTx").textContent = "";
    if (m.mode === "rebuffer") setPhase("buf"); else if (m.mode === "playing" && S.phase === "buf") setPhase("play");
  } else if (m.t === "underrun") {
    S.underruns++; S.startMs = Math.min(1500, Math.round(S.startMs * 1.4)); ls.set("startMs", S.startMs);
    setPhase("buf"); log("缓冲耗尽(第 " + S.underruns + " 次),已自动加大起播缓冲到 " + S.startMs + "ms", "w");
  } else if (m.t === "drained") {
    $("meterI").style.width = "0%"; $("pbarI").style.width = "0%"; $("sBuf").textContent = "缓冲: 0ms"; $("rateTx").textContent = "";
    if (S.turnDone) { setPhase("idle"); finishMeta(); if (S.underruns === 0 && S.startMs > 150) { S.startMs = Math.max(150, Math.round(S.startMs * 0.9)); ls.set("startMs", S.startMs); } }
  }
}
function resample(f, a, b) {
  const n = Math.round(f.length * b / a), o = new Float32Array(n), r = a / b;
  for (let i = 0; i < n; i++) { const x = i * r, k = Math.floor(x), t = x - k; o[i] = (f[k] || 0) * (1 - t) + (f[k + 1] || f[k] || 0) * t; }
  return o;
}
function setPhase(p) {
  S.phase = p;
  const m = { idle: ["就绪", "idle", "ok"], conn: ["连接中…", "think", "wait"], think: ["合成中…", "think", "wait"], buf: ["缓冲中…", "buf", "wait"], play: ["播放中", "play", "ok"], bad: ["连接断开,重连中…", "buf", "bad"] }[p];
  $("tag").textContent = m[0]; $("tag").className = "tag " + m[1];
  $("sTxt").textContent = m[0]; $("sDot").className = "dot " + m[2];
}

/* ═════════ WebSocket ═════════ */
function wsUrl() { return WS_URL.indexOf("{{") < 0 && WS_URL ? WS_URL : (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws"; }
function connect() {
  clearTimeout(S.rcT); setPhase(S.phase === "idle" || S.phase === "bad" ? "conn" : S.phase);
  let ws; try { ws = new WebSocket(wsUrl()); } catch (e) { return retry(); }
  ws.binaryType = "arraybuffer"; S.ws = ws;
  ws.onopen = () => { S.wsOk = true; S.retry = 0; $("dConn").className = "dot ok"; $("tConn").textContent = "已连接"; log("WebSocket 已连接", "o"); setPhase("idle"); ping(); clearInterval(S.pingT); S.pingT = setInterval(ping, HEARTBEAT_INTERVAL); };
  ws.onmessage = (e) => { if (typeof e.data === "string") onJson(JSON.parse(e.data)); else onBin(e.data); };
  ws.onclose = () => { S.wsOk = false; clearInterval(S.pingT); $("dConn").className = "dot bad"; $("tConn").textContent = "已断开,重连中…"; if (S.phase === "idle" || S.phase === "conn") setPhase("bad"); retry(); };
  ws.onerror = () => { $("dConn").className = "dot bad"; $("tConn").textContent = "连接出错"; log("WebSocket 出错," + RECONNECT_DELAY / 1000 + " 秒后重连", "w"); };
}
function retry() { clearTimeout(S.rcT); S.rcT = setTimeout(connect, RECONNECT_DELAY); }
function ping() { if (S.wsOk) S.ws.send(JSON.stringify({ type: "ping", t: performance.now() })); }
function send(o) { if (S.wsOk) { S.ws.send(JSON.stringify(o)); return true; } return false; }
document.addEventListener("visibilitychange", () => { if (document.visibilityState === "visible") { if (P.ctx && P.ctx.state === "suspended") P.ctx.resume(); if (!S.wsOk && (!S.ws || S.ws.readyState > 1)) connect(); } });

function onBin(buf) {
  const uid = new DataView(buf).getUint32(0, true);
  if (uid !== S.uid || !P.node) return;
  P.push(buf);
}

function onJson(m) {
  switch (m.type) {
    case "pong": S.lastLat = Math.round(performance.now() - m.t); $("tConn").textContent = "已连接 · " + S.lastLat + "ms"; break;
    case "state": S.state = m; renderState(); break;
    case "turn_start":
      S.uid = m.turn; S.turnDone = false; S.llmMs = null;
      if (m.tts && P.node) P.open();
      break;
    case "llm_first": S.llmMs = m.ms; break;
    case "sim": if (m.turn === S.uid || m.final) setSim(m.value, m.final); break;
    case "delta": if (S.bubble) { S.bubble.textContent += m.t; scrollChat(); } break;
    case "turn_done": onTurnDone(m); break;
    case "warn": log("⚠ " + m.msg, "w"); addSys("⚠ " + m.msg); break;
    case "error": log("❌ " + m.msg, "e"); addErr(m.msg); break;
    case "stopped": break;
    case "reset_ok": break;
  }
}
function setSim(v, final) {
  const el = $("simVal"); if (v == null) { if (final && el.textContent === "…") el.textContent = "—"; return; }
  el.textContent = v.toFixed(2); el.style.color = v >= 0.9 ? "var(--ok)" : v >= 0.8 ? "var(--warn)" : "var(--bad)";
  $("simNote").textContent = final ? "(本轮加权平均)" : "(实时)"; S.lastSim = v;
}
function onTurnDone(m) {
  S.turnDone = true;
  if (S.bubble) S.bubble.classList.remove("typing");
  S.turnInfo = m;
  if (m.audio_s > 0) P.end(); else { setPhase("idle"); finishMeta(); }
  log("本轮完成: " + m.chars + " 字 · " + m.segs + " 句 · 音频 " + m.audio_s + "s", "o");
}
function finishMeta() {
  const m = S.turnInfo; if (!m || !S.metaEl || S.metaEl.dataset.done) return;
  S.metaEl.dataset.done = 1;
  const g = Object.keys(m.gpu_segs || {}).map((k) => "GPU" + k + "×" + m.gpu_segs[k]).join(" ");
  const parts = [];
  if (m.audio_s) parts.push("音频 " + m.audio_s.toFixed(2) + "s");
  if (S.firstMs != null) parts.push("首声 " + (S.firstMs / 1000).toFixed(2) + "s");
  if (S.llmMs != null) parts.push("DeepSeek 首字 " + (S.llmMs / 1000).toFixed(2) + "s");
  if (m.first_ms != null) parts.push("服务端首包 " + (m.first_ms / 1000).toFixed(2) + "s");
  if (g) parts.push(g);
  if (S.lastSim != null) parts.push("声纹 " + S.lastSim.toFixed(2));
  if (m.audio_s) parts.push(S.underruns ? "断流 " + S.underruns + " 次(已自适应加大缓冲)" : "零断流");
  if (S.minRho < 0.995) parts.push("弹性放慢最低 ×" + S.minRho.toFixed(2));
  S.metaEl.textContent = parts.join(" · ");
}

/* ═════════ 状态渲染 ═════════ */
function renderState() {
  const st = S.state; if (!st) return;
  $("dLlm").className = "dot " + (st.deepseek ? "ok" : "bad"); $("tLlm").textContent = st.deepseek ? "DeepSeek 就绪" : "未配置 Key";
  const ws = st.workers || [], total = ws.length, ready = ws.filter((w) => w.status === "ready" || w.status === "voice").length;
  const err = ws.filter((w) => w.status === "error").length;
  $("dTts").className = "dot " + (ready === total && total ? "ok" : err === total && total ? "bad" : "wait");
  $("tTts").textContent = total ? ready + "/" + total + " 卡" : "无 GPU";
  [0, 1].forEach((i) => {
    const w = ws[i], pill = $("pg" + i);
    if (!w) { pill.style.display = "none"; return; }
    pill.style.display = ""; $("g" + i + "b").style.width = (w.mem[1] ? w.mem[0] / w.mem[1] * 100 : 0) + "%";
    $("g" + i + "t").textContent = w.mem[0].toFixed(1) + "G " + w.util + "%";
  });
  const v = st.voice, ok = v.state === "ready";
  $("tVoice").textContent = ok ? (st.trained ? "已克隆·微调" : "已克隆") : v.state === "cloning" ? "克隆中…" : v.state === "error" ? "失败" : "未克隆";
  $("tVoice").style.color = ok ? "var(--ok)" : v.state === "error" ? "var(--bad)" : "";
  /* 每卡进度 */
  const box = $("gpus"); box.innerHTML = "";
  ws.forEach((w) => {
    let pct = 8, cls = "run", txt = w.msg;
    if (w.status === "error") { pct = 100; cls = "err"; }
    else if (w.status === "loading") { pct = 35; }
    else if (w.status === "voice") { pct = 75; }
    else if (w.status === "loaded") { pct = 60; }
    else if (w.status === "ready") { if (w.voice) { pct = 100; cls = "done"; const i = w.info || {}; txt = "声音就绪" + (i.rtf != null ? " · 试合成 RTF " + i.rtf + " · 首包 " + i.ttfa + "s · " + i.dtype : ""); } else { pct = v.state === "cloning" ? 85 : 100; cls = v.state === "cloning" ? "run" : "done"; txt = v.state === "cloning" ? "等待声音设置…" : "模型就绪,等待参考语音"; } }
    const d = document.createElement("div"); d.className = "gpu";
    d.innerHTML = "<b>GPU" + w.gpu + "</b><div class='bar " + cls + "'><i style='width:" + pct + "%'></i></div><div class='st'>" + esc(txt) + "</div>";
    box.appendChild(d);
  });
  /* 结果卡 */
  const c = $("vcard"), h = $("vh"), b = $("vb"), ring = c.querySelector(".ring span");
  if (v.state === "ready") {
    c.className = "card"; ring.textContent = "✓"; h.textContent = "克隆完成 · 模式 " + (v.mode === "icl" ? "ICL 上下文克隆" : "x-vector 声纹");
    const infos = Object.values(v.info || {}); const slow = infos.some((i) => i.rtf >= 1);
    let t = "参考文字: " + (v.text ? "「" + esc(v.text.slice(0, 60)) + (v.text.length > 60 ? "…" : "") + "」" : "无(仅声纹,相似度会低一些,建议补上文字重新克隆)");
    const sims = infos.map((i) => i.sim).filter((x) => x != null);
    if (sims.length) t += "<br>试合成声纹相似度 " + sims.map((x) => x.toFixed(3)).join(" / ") + "(WavLM-SV,与参考音频对比)";
    if (st.trained) t += "<br>✅ 正在使用你微调训练后的模型";
    if (infos.length) t += "<br>每卡试合成速度 RTF " + infos.map((i) => i.rtf).join(" / ") + "(<1 即快于实时)";
    if (slow) t += "<br>⚠ 有显卡慢于实时,已用「弹性放慢」保证不停顿;双卡并行可进一步提速。";
    b.innerHTML = t;
  } else if (v.state === "cloning") {
    c.className = "card wait"; ring.textContent = "⏳"; h.textContent = "正在克隆…"; b.textContent = v.msg || "两张显卡同时提取声音特征并试合成,请稍候。";
  } else if (v.state === "error") {
    c.className = "card bad"; ring.textContent = "!"; h.textContent = "克隆失败"; b.textContent = v.err || "未知错误";
  } else {
    c.className = "card none"; ring.textContent = "🎙️"; h.textContent = "还没有克隆声音"; b.textContent = "录制或上传 5~20 秒清晰的人声,点击「开始克隆」。Qwen3-TTS 是零样本克隆,不需要训练,通常几十秒内完成。";
  }
  $("btnTry").disabled = !ok;
  $("btnClone").disabled = !S.ref || v.state === "cloning";
  if (v.state === "ready" && !renderState.vdone) { renderState.vdone = v.vid; log("声音克隆完成 · " + (v.mode === "icl" ? "ICL" : "x-vector"), "o"); }
  if (v.state !== "ready") renderState.vdone = 0;
}

/* ═════════ 聊天 ═════════ */
function scrollChat() { const c = $("chat"); c.scrollTop = c.scrollHeight; }
function addMsg(cls, text) { const e = $("empty"); if (e) e.remove(); const d = document.createElement("div"); d.className = "msg " + cls; d.textContent = text; $("chat").appendChild(d); scrollChat(); return d; }
function addSys(t) { addMsg("sys", t); }
function addErr(t) { addMsg("err", t); }
async function sendChat(text, say) {
