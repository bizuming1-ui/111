            msgs.append(j)
            if j["type"] == "turn_start":
                uid = j["turn"]
            if j["type"] == "turn_done":
                done = j
        if uid is not None and time.time() - last_ack > 0.25:
            n = sum(len(x) for x in got) // 2
            await ws.send(json.dumps({"type": "ack", "turn": uid, "next_seq": len(got), "played": min(n, int((time.time() - (t0 or time.time())) * SR)), "level_ms": 0}))
            last_ack = time.time()
        if done is not None and any(len(x) == 0 for x in got[-1:]):
            break
    await ws.close()
    return {"uid": uid, "pcm": b"".join(got), "done": done, "msgs": msgs}


