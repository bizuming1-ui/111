def chromium_installed():
    """Playwright 的 Chromium 可执行文件是否真的存在(不能只因为 import playwright 成功就说“可搜索”)。"""
    env = os.environ.get("PLAYWRIGHT_BROWSERS_PATH") or ""
    roots = [env] if env and env != "0" else [os.path.expanduser("~/.cache/ms-playwright"), "/root/.cache/ms-playwright", "/ms-playwright"]      # 与 Playwright 语义一致:设置了环境变量就只认它
    for root in roots:
        if root and os.path.isdir(root):
            for d in os.listdir(root):
                if d.startswith(("chromium-", "chromium_headless_shell-", "chromium")) and os.path.isdir(os.path.join(root, d)):
                    return True
    return False


