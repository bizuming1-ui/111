@app.websocket("/ws")
async def ws_endpoint(ws: WebSocket):
    await ws.accept()
    sess = Session(ws)
    SESSIONS.add(sess)

    async def sender():
        try:
            while True:
                m = await sess.q.get()
                if isinstance(m, (bytes, bytearray)):
                    await ws.send_bytes(m)
                else:
                    await ws.send_text(m)
        except Exception:  # noqa: BLE001
            pass

    st = asyncio.get_running_loop().create_task(sender())
    sess.send(state_public())
    try:
        while True:
            raw = await ws.receive_text()
            try:
                m = json.loads(raw)
            except ValueError:
                continue
            k = m.get("type")
            if k == "ping":
                sess.send({"type": "pong", "t": m.get("t")})
            elif k == "chat":
                txt = str(m.get("text") or "").strip()
                if txt:
                    start_turn(sess, txt[:4000], m.get("opts") or {}, m.get("ref"))
            elif k == "say":
                txt = str(m.get("text") or "").strip()
                if txt:
                    o = dict(m.get("opts") or {})
                    o["tts"] = True
                    start_turn(sess, txt[:3000], o, m.get("ref"), say_only=True)
            elif k == "stop":
                cancel_turn(sess)
                sess.send({"type": "stopped"})
            elif k == "reset":
                cancel_turn(sess)
                sess.history = []
                sess.send({"type": "reset_ok"})
    except WebSocketDisconnect:
        pass
    except Exception as e:  # noqa: BLE001
        log.info("ws 结束: %s", e)
    finally:
        cancel_turn(sess)
        SESSIONS.discard(sess)
        st.cancel()


def read_train_progress():
    """读取 auto_train_loop / train.py 写出的训练状态,供 /monitor 推送"""
    out = {"event": "train_progress", "status": "idle", "epoch": None, "similarity": None}
    try:
        if TRAIN_STATE.exists():
            out.update(json.loads(TRAIN_STATE.read_text(encoding="utf-8")))
        if EVAL_LOG.exists():
            lines = [ln for ln in EVAL_LOG.read_text(encoding="utf-8").splitlines() if ln.strip()]
            if lines:
                j = json.loads(lines[-1])
                out["epoch"], out["similarity"] = j.get("epoch"), j.get("similarity")
                out["best"] = max(json.loads(ln).get("similarity", 0) for ln in lines)
    except Exception:  # noqa: BLE001
        pass
    out["event"] = "train_progress"
    return out


