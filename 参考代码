def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def unwrap_result_url(u):
    """搜索引擎的跳转链接 → 真实目标(只用于展示/打开;打开前仍要过 netguard)"""
    try:
        sp = urlsplit(u)
        q = parse_qs(sp.query)
        if sp.netloc.endswith("duckduckgo.com") and "uddg" in q:
            return unquote(q["uddg"][0])
        if sp.netloc.endswith("google.com") and sp.path == "/url" and ("q" in q or "url" in q):
            return (q.get("q") or q.get("url"))[0]
        if sp.netloc.endswith("bing.com") and sp.path.startswith("/ck/") and "u" in q and q["u"][0].startswith("a1"):
            b = q["u"][0][2:]
            return base64.urlsafe_b64decode(b + "=" * (-len(b) % 4)).decode("utf-8", "ignore")
    except Exception:  # noqa: BLE001
        pass
    return u


def risk_words(text):
    m = RISK_RE.search(text or "")
    return m.group(0) if m else None


# ════════════════════════════════════════════════════════════════
#  网络层护栏:本机过滤代理(Chromium 的所有流量都经过它)
#  Playwright 的 route 钩子【看不到】浏览器内部跟随的 302 重定向(实测:重定向目标请求会直接发出),所以只靠 route 不够。
#  这个代理在网络层强制:目标主机由代理自己解析 → 所有地址必须是公网 → 只连接已校验的 IP(同时杜绝 DNS rebinding),重定向/子资源/WebSocket 一视同仁。
# ════════════════════════════════════════════════════════════════
class GuardProxy:
    def __init__(self):
        self.port = None
        self.server = None
        self.blocked = 0
        self.events = deque(maxlen=50)
        self.conns = 0
        self.max_conns = 96

    async def start(self):
        self.server = await asyncio.start_server(self._handle, "127.0.0.1", 0, limit=1 << 16)
        self.port = self.server.sockets[0].getsockname()[1]

    async def stop(self):
        if self.server:
            self.server.close()

    async def resolve_checked(self, host, port):
        host = host.strip("[]").lower().rstrip(".")
        allow = netguard._test_allow()
        if allow and ("%s:%s" % (host, port) in allow or host in allow):
            return host
        netguard.check_static("http://%s:%s/" % (("[%s]" % host) if ":" in host else host, port))
        ip = netguard._classify_host(host)
        if ip:
            return ip
        if netguard._name_blocked(host):
            raise netguard.Blocked("拒绝访问内部主机名(%s)" % host)
        infos = await asyncio.get_running_loop().getaddrinfo(host, port, type=socket.SOCK_STREAM)
        addrs = []
        for i in infos:
            if i[4][0] not in addrs:
                addrs.append(i[4][0])
        if not addrs:
            raise netguard.Blocked("域名无法解析(%s)" % host)
        for a in addrs:
            if not netguard.ip_is_public(a):
                raise netguard.Blocked("域名 %s 解析到了内网/保留地址 %s(防 SSRF)" % (host, a))
        return addrs[0]

    async def _copy(self, r, w):
        try:
            while True:
                b = await asyncio.wait_for(r.read(65536), 180)
                if not b:
                    break
                w.write(b)
                await w.drain()
        except Exception:  # noqa: BLE001
            pass
        finally:
            try:
                w.close()
            except Exception:  # noqa: BLE001
                pass

    async def _pipe(self, r, w, ur, uw):
        t1, t2 = asyncio.ensure_future(self._copy(r, uw)), asyncio.ensure_future(self._copy(ur, w))
        await asyncio.wait({t1, t2}, return_when=asyncio.FIRST_COMPLETED)
        for t in (t1, t2):
            t.cancel()

    async def _handle(self, r, w):
        if self.conns >= self.max_conns:
            w.close()
            return
        self.conns += 1
        uw = None
        try:
            head = await asyncio.wait_for(r.readuntil(b"\r\n\r\n"), 20)
            lines = head.decode("latin1").split("\r\n")
            method, target, _ = lines[0].split(" ", 2)
            if method.upper() == "CONNECT":
                host, _, port = target.rpartition(":")
                ip = await self.resolve_checked(host, int(port))
                ur, uw = await asyncio.wait_for(asyncio.open_connection(ip, int(port)), 15)
                w.write(b"HTTP/1.1 200 Connection Established\r\n\r\n")
                await w.drain()
                await self._pipe(r, w, ur, uw)
            else:
                sp = urlsplit(target)
                if sp.scheme != "http" or not sp.hostname:
                    raise netguard.Blocked("代理只接受 http/https 目标")
                port = sp.port or 80
                ip = await self.resolve_checked(sp.hostname, port)
                ur, uw = await asyncio.wait_for(asyncio.open_connection(ip, port), 15)
                path = (sp.path or "/") + (("?" + sp.query) if sp.query else "")
                hdrs = [ln for ln in lines[1:] if ln and not ln.lower().startswith(("proxy-connection", "connection", "proxy-authorization"))]
                uw.write(("%s %s HTTP/1.1\r\n%s\r\nConnection: close\r\n\r\n" % (method, path, "\r\n".join(hdrs))).encode("latin1"))
                await uw.drain()
                await self._pipe(r, w, ur, uw)
        except netguard.Blocked as e:
            self.blocked += 1
            self.events.append({"t": now_iso(), "reason": str(e)[:120]})
            body = ("BLOCKED_BY_SECURITY_POLICY: %s" % e).encode("utf-8")
            try:
                w.write(b"HTTP/1.1 403 Forbidden\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\nContent-Length: %d\r\n\r\n" % len(body) + body)
                await w.drain()
            except Exception:  # noqa: BLE001
                pass
        except Exception:  # noqa: BLE001
            pass
        finally:
            self.conns -= 1
            for x in (w, uw):
                try:
                    if x:
                        x.close()
                except Exception:  # noqa: BLE001
                    pass


