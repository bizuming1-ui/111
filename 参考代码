async def run_turn(port, text, sid="s1", ack_every=0.25, ack=True, drop_after=None, window_probe=None, kind="say"):
    t_begin = time.time()
    import websockets
    url = "ws://127.0.0.1:%d/ws" % port
    ws = await websockets.connect(url, max_size=None)
    await ws.send(json.dumps({"type": "hello", "sid": sid}))
    chk, msgs, played, recv_samples, t_start = None, [], 0, 0, None
    uid, done, reconnects = None, None, 0
    max_ahead = 0.0
    await ws.send(json.dumps({"type": kind, "text": text, "opts": {"tts": True}}))
    t_last_ack, ended_at = time.time(), None
    while True:
        try:
            m = await asyncio.wait_for(ws.recv(), 20 if ack else window_probe or 20)
        except asyncio.TimeoutError:
            break
        now = time.time()
        if window_probe and now - t_begin > window_probe:
            break
        if isinstance(m, (bytes, bytearray)):
            if chk is None:
                continue
            act, f = chk.accept(bytes(m))
            assert act == "ok", (act, f)
            recv_samples += f["n"]
            if t_start is None and recv_samples > 0:
                t_start = now
            if t_start is not None and ack:
                played = min(recv_samples, int((now - t_start) * SR))
            max_ahead = max(max_ahead, (recv_samples - played) / SR * 1000)
            if drop_after is not None and chk.count >= drop_after and reconnects == 0:
                await ws.close()
                ws = await websockets.connect(url, max_size=None)
                await ws.send(json.dumps({"type": "hello", "sid": sid, "resume": {"turn": uid, "next_seq": chk.expected}}))
                reconnects += 1
        else:
            j = json.loads(m)
            msgs.append(j)
            if j["type"] == "turn_start":
                uid = j["turn"]; chk = pr.FrameChecker(uid, SR)
            if j["type"] == "turn_done":
                done = j
        if ack and uid is not None and now - t_last_ack >= ack_every:
            if t_start is not None:
                played = min(recv_samples, int((now - t_start) * SR))
            await ws.send(json.dumps({"type": "ack", "turn": uid, "next_seq": chk.expected if chk else 0, "played": played, "level_ms": 0}))
            t_last_ack = now
        if done is not None and chk and chk.ended:
            break
    await ws.close()
    return {"chk": chk, "msgs": msgs, "done": done, "uid": uid, "recv_ms": recv_samples / SR * 1000, "max_ahead_ms": max_ahead, "reconnects": reconnects}


