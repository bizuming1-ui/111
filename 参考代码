def unwrap_result_url(u):
    """搜索引擎的跳转链接 → 真实目标(只用于展示/打开;打开前仍要过 netguard)"""
    try:
        u = _html.unescape(u)
        if u.startswith("//"):
            u = "https:" + u
        sp = urlsplit(u)
        q = parse_qs(sp.query)
        if sp.netloc.endswith("duckduckgo.com") and "uddg" in q:
            return unquote(q["uddg"][0])
        if sp.netloc.endswith("bing.com") and sp.path.startswith("/ck/") and "u" in q and q["u"][0].startswith("a1"):
            b = q["u"][0][2:]
            return base64.urlsafe_b64decode(b + "=" * (-len(b) % 4)).decode("utf-8", "ignore")
        if sp.netloc.endswith("google.com") and sp.path == "/url" and ("q" in q or "url" in q):
            return (q.get("q") or q.get("url"))[0]
    except Exception:  # noqa: BLE001
        pass
    return u


def parse_bing(page):
    out = []
    for blk in re.findall(r'<li[^>]+class="[^"]*\bb_algo\b[^"]*"[^>]*>(.*?)</li>', page, re.S):
        m = re.search(r'<h2[^>]*>.*?<a[^>]+href="([^"]+)"[^>]*>(.*?)</a>', blk, re.S)
        if not m:
            continue
        sn = re.search(r'<p[^>]*class="[^"]*b_lineclamp[^"]*"[^>]*>(.*?)</p>', blk, re.S) or re.search(r'<div[^>]+class="[^"]*b_caption[^"]*"[^>]*>.*?<p[^>]*>(.*?)</p>', blk, re.S) \
            or re.search(r'<div[^>]+class="[^"]*b_algoSlug[^"]*"[^>]*>(.*?)</div>', blk, re.S)
        out.append({"title": _text(m.group(2)), "url": unwrap_result_url(m.group(1)), "snippet": _text(sn.group(1)) if sn else ""})
    return out


def parse_ddg(page):
    out = []
    for blk in re.findall(r'<div[^>]+class="[^"]*\bresult\b[^"]*"[^>]*>(.*?)(?=<div[^>]+class="[^"]*\bresult\b[^"]*"|</body>)', page, re.S):
        m = re.search(r'<a[^>]+class="[^"]*result__a[^"]*"[^>]+href="([^"]+)"[^>]*>(.*?)</a>', blk, re.S) or re.search(r'<a[^>]+href="([^"]+)"[^>]+class="[^"]*result__a[^"]*"[^>]*>(.*?)</a>', blk, re.S)
        if not m:
            continue
        sn = re.search(r'class="[^"]*result__snippet[^"]*"[^>]*>(.*?)</(?:a|div|td)>', blk, re.S)
        out.append({"title": _text(m.group(2)), "url": unwrap_result_url(m.group(1)), "snippet": _text(sn.group(1)) if sn else ""})
    return out


