            except Exception as e:  # noqa: BLE001
                log.warning("[GPU%d] warmup 失败(首次合成时会自动捕获): %s", self.idx, e)
            self.sr = int(getattr(self.fast, "sample_rate", SR) or SR)
            self.slow = None
            mode = "CUDA Graph 流式"
        except Exception as e:  # noqa: BLE001
            log.warning("[GPU%d] faster-qwen3-tts 不可用,回退官方 qwen-tts 整句模式: %s", self.idx, e)
            log.warning(traceback.format_exc())
            self.fast = None
            from qwen_tts import Qwen3TTSModel
            try:
                self.slow = Qwen3TTSModel.from_pretrained(MODEL, device_map="cuda:0", dtype=dt, attn_implementation="sdpa")
            except TypeError:
                self.slow = Qwen3TTSModel.from_pretrained(MODEL, device_map="cuda:0", torch_dtype=dt, attn_implementation="sdpa")
            mode = "官方整句模式(较慢)"
        self.mode = mode
        if self.sr != SR:
            raise RuntimeError("模型输出采样率是 %d,系统固定使用 %d,拒绝启动(防止两卡音频不一致)" % (self.sr, SR))
        if self.fast is not None:
            import torch
            self._gen_custom = torch.inference_mode()(self._gen_custom_impl)
        self.say("loaded", "模型就绪 · %s · %.0fs" % (mode, time.time() - t0))

    def backend_info(self):
        import importlib.metadata as md
        import torch
        info = {"mock": False, "device": torch.cuda.get_device_name(0), "dtype": self.dtype, "mode": self.mode, "model": MODEL,
                "backend": ("faster-qwen3-tts(CUDA Graph 流式)" if self.fast is not None else "qwen-tts 官方整句(非流式!)"),
                "streaming": self.fast is not None, "custom_two_phase": bool(self.custom_ok and self.fast is not None)}
        for pk in ("torch", "transformers", "faster-qwen3-tts", "qwen-tts", "accelerate"):
            try:
                info["v_" + pk] = md.version(pk)
            except Exception:  # noqa: BLE001
                pass
        try:
            m = (self.fast.model if self.fast is not None else self.slow).model
            tot = 0.0
            n = 0
            for p_ in m.parameters():
                tot += float(torch.sum(torch.abs(p_.detach()), dtype=torch.float32))
                n += p_.numel()
            info["weights_params"], info["weights_abs_sum"] = n, round(tot, 2)       # 权重指纹:两张卡必须一致
        except Exception as e:  # noqa: BLE001
            info["weights_fp_error"] = str(e)[:100]
        try:
            info["prompt_cached"] = bool(self.fast is not None and len(self.fast._voice_prompt_cache) > 0)
        except Exception:  # noqa: BLE001
            info["prompt_cached"] = None
        return info

    def _holder(self):
        from speaker_sim import ScorerHolder, SpkScorer
        if self.scorer_holder is None:
            self.scorer_holder = ScorerHolder(lambda: SpkScorer("cuda"), label="声纹评分模型(WavLM-SV)")
        return self.scorer_holder

    def scorer_info(self):
        return self._holder().info()

    def spk_qc(self, path):
        """【参考音频质检】疑似多人检测:2 秒窗口、1 秒步长的说话人嵌入,看各窗口与整体质心的相似度分布(启发式,阈值未校准)。
        与 spk_cmp(生成音频 vs 同库留出样本)是两件事,返回里用 kind 区分,不混用同一个\"声纹分数\"。"""
        from speaker_sim import AudioSkip, ScorerUnavailable, load_wav16k, result_status
        try:
            sc = self._holder().get()
        except ScorerUnavailable as e:
            return result_status("failed", e.reason, kind="reference_qc", scorer=e.info, suspect=False, n_windows=0, p10=None, mean=None)
        try:
            w = load_wav16k(path)
            win, hop = 32000, 16000
            if len(w) < win:
                return result_status("skipped", "音频太短(<2 秒),无法检测多人", kind="reference_qc", suspect=False, n_windows=0, p10=None, mean=None, note="音频太短,无法检测多人")
            embs = []
            for i in range(0, max(1, len(w) - win + 1), hop):
                try:
                    embs.append(sc.embed(w[i:i + win]))
                except AudioSkip:
                    continue                                              # 静音窗口不计入,也不补零
            if len(embs) < 3:
                return result_status("skipped", "有效语音窗口不足 3 个(共 %d 个),无法检测多人" % len(embs), kind="reference_qc", suspect=False, n_windows=len(embs), p10=None, mean=None,
                                     note="有效语音窗口不足,无法检测多人")
            import torch
            E = torch.stack(embs)
            c = torch.nn.functional.normalize(E.mean(0), dim=-1)
            sims = (E * c).sum(-1).cpu().numpy()
            p10 = float(np.percentile(sims, 10))
            return result_status("completed", "", kind="reference_qc", suspect=bool(p10 < 0.55), n_windows=len(embs), p10=round(p10, 3), mean=round(float(sims.mean()), 3),
                                 note="启发式阈值 0.55,未经标注数据校准", model=SV_MODEL_NAME())
        except AudioSkip as e:
            return result_status("skipped", e.reason, kind="reference_qc", suspect=False, n_windows=0, p10=None, mean=None, note=e.reason)

    def spk_cmp(self, gen_path, ref_paths):
        """【生成音频 vs 同一语音库留出样本】的说话人 cosine(原始分数,未校准)。
        返回 status: completed(至少 1 对有效)/ skipped(输入音频不合格,带原因)/ failed(评分器不可用,带最初异常)。分数永远不会被伪造。"""
        from speaker_sim import AudioSkip, ScorerUnavailable, load_wav16k, result_status
        try:
            sc = self._holder().get()
        except ScorerUnavailable as e:
            return result_status("failed", e.reason, kind="generated_vs_holdout", scorer=e.info, scores=[None for _ in ref_paths], model=SV_MODEL_NAME())
        try:
            g = sc.embed(load_wav16k(gen_path))
        except AudioSkip as e:
            return result_status("skipped", "生成音频不合格:" + e.reason, kind="generated_vs_holdout", scores=[None for _ in ref_paths], model=SV_MODEL_NAME(), scorer=self._holder().info())
        import torch
        out, skipped = [], []
        for p in ref_paths:
            try:
                r = sc.embed(load_wav16k(p))
                if r.shape != g.shape:
                    raise RuntimeError("嵌入维度不一致")
                out.append(round(float(torch.nn.functional.cosine_similarity(g, r, dim=-1)), 4))
            except AudioSkip as e:
                out.append(None)
                skipped.append({"ref": os.path.basename(str(p)), "reason": e.reason})
        done = [x for x in out if x is not None]
        st = result_status("completed" if done else "skipped", "" if done else "所有留出样本都不合格:" + "; ".join(x["reason"] for x in skipped[:2]),
                           kind="generated_vs_holdout", scores=out, skipped=skipped, model=SV_MODEL_NAME(), scorer=self._holder().info())
        return st

    def _free(self):
        import gc
        import torch
        self.fast = None
        self.slow = None
        self.prompt = None
        gc.collect()
        torch.cuda.empty_cache()

    def _make_prompt(self, path, text, xvec):
        self.ref = (path, text, bool(xvec))
        self.prompt = None
        if self.fast is None and self.slow is not None:
            self.prompt = self.slow.create_voice_clone_prompt(ref_audio=path, ref_text=("" if xvec else text), x_vector_only_mode=bool(xvec))

    # ───── 声纹打分器(WavLM-SV;失败不影响合成,但失败原因必须可见,且有界重试) ─────
    def _prep_scorer(self, path):
        """为本次声音设置参考声纹。模型加载 与 参考音频读取 分开处理:参考文件有问题【不会】丢掉已加载好的模型。"""
        from speaker_sim import AudioSkip, ScorerUnavailable, load_wav16k
        try:
            if self._holder().state != "ready":
                self.say("voice", "加载声纹评分模型…")
            sc = self._holder().get()
        except ScorerUnavailable as e:
            self.last_score = {"status": "failed", "reason": e.reason}
            log.warning("[GPU%d] 声纹评分不可用(不影响合成): %s", self.idx, e.reason)
            return False
        try:
            wav = load_wav16k(path)                                  # 先读文件:缺失/损坏 → AudioSkip(skipped + 原因),不影响已加载的模型
            st = os.stat(path)
            sc.ref = None
            sc.set_ref([wav])
            self.scorer_ref_id = (str(path), int(st.st_mtime), int(st.st_size))
            self.last_score = {"status": "not_evaluated", "reason": "参考声纹已就绪,等待生成音频"}
            return True
        except AudioSkip as e:
            sc.ref, self.scorer_ref_id = None, None
            self.last_score = {"status": "skipped", "reason": "参考音频不能用于打分:" + e.reason}
        except Exception as e:  # noqa: BLE001
            sc.ref, self.scorer_ref_id = None, None
            self.last_score = {"status": "failed", "reason": "设置参考声纹失败:%s: %s" % (type(e).__name__, str(e)[:200])}
            log.warning("[GPU%d] 设置参考声纹失败(评分模型仍保留): %s", self.idx, e)
        return False

    def score(self, pcm):
        """返回 float 或 None;None 时 self.last_score 里有明确状态与原因(skipped / failed / not_evaluated),绝不伪造分数。"""
        from speaker_sim import AudioSkip, ScorerUnavailable, finite_or_none, pcm16_to_16k
        h = self.scorer_holder
        if h is None or h.state != "ready" or getattr(h.scorer, "ref", None) is None:
            if not self.last_score.get("reason"):
                self.last_score = {"status": "not_evaluated", "reason": "评分器未就绪"}
            if h is not None and h.state == "failed":
                self.last_score = {"status": "failed", "reason": h.last_error or "评分器加载失败"}
            return None
        try:
            v = finite_or_none(h.scorer.score(pcm16_to_16k(pcm, SR)))
        except AudioSkip as e:
            self.last_score = {"status": "skipped", "reason": e.reason}
            return None
        except ScorerUnavailable as e:
            self.last_score = {"status": "failed", "reason": e.reason}
            return None
        except Exception as e:  # noqa: BLE001
            self.last_score = {"status": "failed", "reason": "打分异常:%s: %s" % (type(e).__name__, str(e)[:200])}
            return None
        if v is None:
            self.last_score = {"status": "failed", "reason": "模型返回了非有限分数"}
            return None
        self.last_score = {"status": "completed", "reason": ""}
        return v

    def set_voice(self, path, text, xvec):
        self._make_prompt(path, text, xvec)
        bad = None
        for attempt in range(3):
            t0 = time.time()
            first, parts = None, []
            self.last_frames = 0
            for a, sr in self.stream("你好，我已经准备好了，今天天气真不错，我们可以开始聊天了。", "first"):
                if first is None:
                    first = time.time() - t0
                parts.append(_f2pcm(a))
            wall = time.time() - t0
            pcm = np.concatenate(parts) if parts else np.zeros(0, np.int16)
            dur = len(pcm) / SR
            ok = len(pcm) > SR * 0.3 and float(np.sqrt((pcm.astype(np.float32) ** 2).mean())) > 90
            if ok and self.last_frames and self.custom_ok and self.fast is not None:      # 自研路径自检: 样本数必须 = 帧数 × 1920
                err = abs(len(pcm) - self.last_frames * (SR / 12.5)) / max(len(pcm), 1)
                if err > 0.03:
                    ok = False
                    log.warning("[GPU%d] 自研流式自检未通过(样本数与帧数不符 %.1f%%),改用官方分块流式", self.idx, err * 100)
            if ok:
                info = {"rtf": round(wall / max(dur, 1e-3), 2), "ttfa": round(first or wall, 2), "dtype": self.dtype, "mode": self.mode + (" · 两相流式" if (self.custom_ok and self.fast is not None) else ""),
                        "sr": self.sr, "rms": round(speech_rms(pcm), 1), "sim": None,
                        "prompt_cached": bool(self.fast is not None and len(getattr(self.fast, "_voice_prompt_cache", {})) > 0)}
                self._prep_scorer(path)
                try:
                    s = self.score(pcm)
                    info["sim"] = None if s is None else round(s, 4)
                except Exception as e:  # noqa: BLE001
                    log.warning("[GPU%d] 试合成打分失败: %s", self.idx, e)
                # 第二次试合成(图/缓存已热)才是真实速度,网关据此预测需要多少预缓冲
                try:
                    t1, f1, n1, ch, tp = time.time(), None, 0, [], time.time()
                    for a, sr in self.stream("今天天气真好，我们一起出去走走吧。", "calib"):
                        now = time.time()
                        if f1 is None:
                            f1 = now - t1
                        ch.append((round(now - tp, 4), len(a)))
                        tp, n1 = now, n1 + len(a)
                    w1 = time.time() - t1
                    if n1 > SR:
                        info["rtf"], info["ttfa"], info["ch"] = round(w1 / (n1 / SR), 2), round(f1 or w1, 2), ch
                except Exception as e:  # noqa: BLE001
                    log.warning("[GPU%d] 第二次试合成失败(忽略): %s", self.idx, e)
                return info
            bad = "试合成的声音是空的/无声/长度异常(精度 %s)" % self.dtype
            if self.custom_ok and self.fast is not None:                   # 先怀疑自研路径,同精度下退回官方流式重试
                self.custom_ok = False
                log.warning("[GPU%d] %s → 自研两相流式关闭,改用官方分块流式重试", self.idx, bad)
                continue
            alt = [d for d in self.order if d != self.dtype]
            if attempt < 2 and alt:
                self.say("loading", "%s 精度输出异常,改用 %s 重新加载…" % (self.dtype, alt[0]))
                self._free()
                self.load(force_dtype=alt[0])
                self._make_prompt(path, text, xvec)
        raise RuntimeError(bad or "试合成失败")

    @staticmethod
    def _to_np(a):
        if hasattr(a, "cpu"):
            return a.flatten().float().cpu().numpy()
        return np.asarray(a).reshape(-1)

    def _gen_custom_impl(self, text, lang, max_new, sched):
        """两相流式: 逐帧生成(CUDA Graph) → 按 sched 重新分块 → 每块带滑动上下文解码。"""
        import torch
        from faster_qwen3_tts.streaming import fast_generate_streaming
        f = self.fast
        path, ref_text, xvec = self.ref
        m, talker, config, tie, tam, tth, tpe, ref_codes = f._prepare_generation(
            text=text, language=lang, ref_audio=path, ref_text=ref_text, xvec_only=xvec, non_streaming_mode=False,
            append_silence=True, voice_clone_prompt=None, instruct=None)
        tok = m.speech_tokenizer
        dev = tie.device
        groups = int(getattr(config, "num_code_groups", 16))
        hist = ref_codes[-CTX_FRAMES:].to(dev) if ref_codes is not None else torch.zeros((0, groups), dtype=torch.long, device=dev)
        pend, npend, si, total = [], 0, 0, 0
        gen = fast_generate_streaming(
            talker=talker, talker_input_embeds=tie, attention_mask=tam, trailing_text_hiddens=tth, tts_pad_embed=tpe, config=config,
            max_new_tokens=max_new, min_new_tokens=2, temperature=TEMPERATURE, top_k=TOP_K, top_p=TOP_P, do_sample=True,
            repetition_penalty=REP_PENALTY, chunk_size=1, predictor_graph=f.predictor_graph, talker_graph=f.talker_graph)

        def decode(new):
            nonlocal hist
            window = torch.cat([hist, new.to(dev)], dim=0)
            n_ctx = hist.shape[0]
            al, sr = tok.decode({"audio_codes": window.unsqueeze(0)})
            a = self._to_np(al[0])
            spf = len(a) / max(window.shape[0], 1)
            hist = window[-CTX_FRAMES:]
            return a[int(round(n_ctx * spf)):], sr

        try:
            for item in gen:
                codes = item[0] if isinstance(item, (tuple, list)) else item
                pend.append(codes)
                npend += codes.shape[0]
                if npend >= sched[min(si, len(sched) - 1)]:
                    new = torch.cat(pend, dim=0)
                    pend, npend, si = [], 0, si + 1
                    total += new.shape[0]
                    self.last_frames = total
                    yield decode(new)
            if npend:
                new = torch.cat(pend, dim=0)
                total += new.shape[0]
                self.last_frames = total
                yield decode(new)
        finally:
            try:
                gen.close()
            except Exception:  # noqa: BLE001
                pass

    def stream(self, text, profile, seed=None):
        path, ref_text, xvec = self.ref
        lang = detect_lang(text)
        max_new = min(MAX_NEW_TOKENS, max(120, int(len(text) * 7)))
        sched = SCHED.get(profile, SCHED["rest"])
        _seed_all(seed)
        if self.fast is not None:
            if self.custom_ok and self._gen_custom is not None:
                started = False
                try:
                    for a, sr in self._gen_custom(text, lang, max_new, sched):
                        started = True
                        yield a, sr
                    return
                except Exception as e:  # noqa: BLE001
                    if started:
                        raise
                    self.custom_ok = False
                    log.warning("[GPU%d] 自研两相流式不可用,退回官方分块流式: %s", self.idx, e)
                    log.warning(traceback.format_exc())
                    _seed_all(seed)
            chunk = {"first": 4, "second": 6}.get(profile, 8)
            for a, sr, _timing in self.fast.generate_voice_clone_streaming(
                    text=text, language=lang, ref_audio=path, ref_text=ref_text, chunk_size=chunk,
                    xvec_only=xvec, temperature=TEMPERATURE, top_k=TOP_K, top_p=TOP_P,
                    repetition_penalty=REP_PENALTY, max_new_tokens=max_new):
                yield a, sr
        else:
            wavs, sr = self.slow.generate_voice_clone(text=text, language=lang, voice_clone_prompt=self.prompt, max_new_tokens=max_new,
                                                      temperature=TEMPERATURE, top_k=TOP_K, top_p=TOP_P, repetition_penalty=REP_PENALTY)
            yield wavs[0], sr

    def asr(self, path):
        import soundfile as sf
        import torch
        if self._asr is None:
            from transformers import pipeline
            last = None
            for name in (ASR_MODEL, "openai/whisper-small"):
                try:
                    self.say("loading", "加载语音识别模型 %s…" % name.split("/")[-1])
                    self._asr = pipeline("automatic-speech-recognition", model=name, device=0, torch_dtype=torch.float16, chunk_length_s=30)
                    break
                except Exception as e:  # noqa: BLE001
                    last = e
                    log.warning("[GPU%d] ASR 模型 %s 加载失败: %s", self.idx, name, e)
            if self._asr is None:
                raise RuntimeError("语音识别模型加载失败: %s" % last)
        a, sr = sf.read(path, dtype="float32", always_2d=False)
        if a.ndim > 1:
            a = a.mean(axis=1)
        if sr != 16000:
            n = int(len(a) * 16000 / sr)
            a = np.interp(np.linspace(0, len(a) - 1, n), np.arange(len(a)), a).astype(np.float32)
        out = self._asr({"raw": a, "sampling_rate": 16000})
        return (out.get("text") or "").strip()


def worker_main(idx, gpu, job_q, res_q, epoch, cfg):
    """每张 GPU 一个进程。必须在 import torch 之前设置 CUDA_VISIBLE_DEVICES。"""
    if not cfg.get("mock"):
        os.environ["CUDA_VISIBLE_DEVICES"] = str(gpu)
        os.environ.setdefault("TOKENIZERS_PARALLELISM", "false")
        os.environ.setdefault("OMP_NUM_THREADS", "2")        # Kaggle 只有 4 个 CPU 核:两个 GPU 进程 + 网关,别让 CPU 线程互相抢占造成抖动
        os.environ.setdefault("MKL_NUM_THREADS", "2")

    def send(*m):
        res_q.put(m)

    try:
        eng = MockEngine(idx, send) if cfg.get("mock") else RealEngine(idx, send)
        send("status", idx, "loading", "启动中…")
        eng.load()
        send("status", idx, "ready", "就绪")
    except Exception as e:  # noqa: BLE001
        log.error("[GPU%d] 引擎加载失败:\n%s", idx, traceback.format_exc())
        send("status", idx, "error", "%s: %s" % (type(e).__name__, e))
        return
    parent = mp.parent_process()
    deferred = []            # 待打分的句子:声纹打分很吃 GPU,只在本卡空闲(队列里没有新活)时才做,绝不插在两句合成之间拖慢播放
    try:
        send("backend", idx, eng.backend_info())
    except Exception as e:  # noqa: BLE001
        log.warning("[GPU%d] 读取后端信息失败: %s", idx, e)

    def settle(item, do_score, why=""):
        """一定会回报一条 sim 消息(带 status/reason):completed / failed / skipped / not_evaluated。不再静默丢弃后只发 None。"""
        tuid, seg_i, pcm_all, ep0 = item
        sim, info = None, {"status": "not_evaluated", "reason": why or "未评分"}
        if epoch.value != ep0:
            info = {"status": "skipped", "reason": "该句所属的任务已被取消或已开始新一轮,旧结果不会串到新任务"}
        elif do_score:
            try:
                sim = eng.score(pcm_all)
                info = dict(getattr(eng, "last_score", None) or {"status": "completed" if sim is not None else "not_evaluated", "reason": ""})
                if sim is None and info.get("status") == "completed":
                    info = {"status": "not_evaluated", "reason": "评分器没有返回分数"}
            except Exception as e:  # noqa: BLE001
                info = {"status": "failed", "reason": "打分异常:%s: %s" % (type(e).__name__, str(e)[:160])}
                log.warning("[GPU%d] 打分失败: %s", idx, e)
        elif not why:
            info = {"status": "skipped", "reason": "评分队列已满(本卡持续忙碌),为不拖慢合成已跳过本句评分"}
        try:
            h = getattr(eng, "scorer_holder", None)
            if h is not None:
                info["scorer_state"] = h.state
            info["ref_id"] = (getattr(eng, "scorer_ref_id", None) or [None, None, None])[1:]
        except Exception:  # noqa: BLE001
            pass
        send("sim", tuid, seg_i, sim, len(pcm_all) / SR, info)

    def run_tts(job):
        _, tuid, ep, seg, text, prof, seed = job
        if epoch.value != ep:
            send("seg_done", tuid, seg, idx, {"skipped": True})
            return
        max_new = min(MAX_NEW_TOKENS, max(120, int(len(text) * 7)))
        for attempt in range(2):                                    # 只有「还没送出任何音频」的失败才会用新种子重试一次(可复现:seed+attempt)
            cur = int(seed) + attempt
            t0, first, nsamp, sent_any, cancelled = time.time(), None, 0, False, False
            acc, ch, t_prev = [], [], t0                            # ch: 每块 (耗时, 样本数) —— 网关据此拟合「每帧生成时间 / 每块解码开销 / 预填充」
            qc = SegmentQC()
            err = None
            eng.last_frames = 0
            gen = eng.stream(text, prof, cur)
            try:
                for a, sr in gen:
                    if epoch.value != ep:                           # 用户已取消/重连:立刻停止生成,把 GPU 让给下一个任务
                        cancelled = True
                        break
                    if int(sr) != SR:
                        raise AudioCorrupt("块采样率 %s != %d" % (sr, SR))
                    pcm = _f2pcm(a)
                    if pcm.size == 0:
                        continue
                    qc.feed(pcm)
                    if qc.joins and qc.joins[-1][1] > 25 and qc.joins[-1][0] > 6000:
                        raise AudioCorrupt("chunk 边界波形断裂(跳变 %.0f)" % qc.joins[-1][0])
                    now = time.time()
                    if first is None:
                        first = now - t0
                    nsamp += len(pcm)
                    acc.append(pcm)
                    ch.append((round(now - t_prev, 4), len(pcm)))
                    t_prev = now
                    send("chunk", tuid, seg, pcm.tobytes(), round(now - t0, 4))
                    sent_any = True
            except AudioCorrupt as e:
                err = e
            finally:
                try:
                    gen.close()
                except Exception:  # noqa: BLE001
                    pass
            wall = time.time() - t0
            if cancelled:
                send("seg_done", tuid, seg, idx, {"skipped": True, "cancelled": True})
                return
            if err is None:
                fr = int(getattr(eng, "last_frames", 0) or 0)
                rep_ = qc.finish(frames=fr or None, hit_max=bool(fr and fr >= max_new - 1))
                if rep_["errors"]:
                    err = AudioCorrupt("; ".join(rep_["errors"]))
            else:
                rep_ = qc.finish()
                rep_["errors"] = [str(err)]
            if err is not None:
                wav = save_diag(DIAG_DIR, "gpu%s_t%s_s%s_a%d" % (idx, tuid, seg, attempt), qc.audio(), dict(rep_, text=text, seed=cur, gpu=idx))
                log.error("[GPU%d] 音频完整性检查失败(句 %d, 尝试 %d): %s → 诊断 %s", idx, seg, attempt, err, wav)
                if not sent_any and attempt == 0:
                    log.warning("[GPU%d] 尚未送出音频,用新种子重试一次", idx)
                    continue
                send("seg_err", tuid, seg, idx, "AudioCorrupt: %s%s" % (err, ("(诊断已保存 %s)" % wav) if wav else ""))
                return
            send("seg_done", tuid, seg, idx, {"first": first, "wall": wall, "audio": nsamp / SR, "ch": ch[:40], "seed": cur, "attempt": attempt, "qc": rep_})
            if epoch.value == ep and nsamp > SR * 1.2:
                deferred.append((tuid, seg, np.concatenate(acc), ep))     # 音频已全部发出;打分推迟到空闲时
            else:
                send("sim", tuid, seg, None, nsamp / SR, {"status": "skipped", "reason": ("句子太短(<1.2 秒),不评分" if epoch.value == ep else "任务已取消")})
            return

    while True:
        try:
            job = job_q.get(timeout=0.25 if deferred else 2)
        except _queue.Empty:
            if parent is not None and not parent.is_alive():
                return
            if deferred:
                settle(deferred.pop(0), True)
            continue
        while len(deferred) > 4:                                    # 有界队列:积压太多(一直在忙)→ 最旧的一条标记 skipped 并写明原因(不静默丢弃)
            settle(deferred.pop(0), False)
        kind = job[0]
        if kind == "quit":
            return
        try:
            if kind == "voice":
                _, vid, path, text, xvec = job
                send("status", idx, "voice", "提取声音特征并试合成…")
                info = eng.set_voice(path, text, xvec)
                send("voice_ok", idx, vid, info)
                send("status", idx, "ready", "就绪")
            elif kind == "asr":
                _, rid, path = job
                send("status", idx, "voice", "识别参考音频文字…")
                try:
                    txt = eng.asr(path)
                    send("asr", rid, txt, "")
                except Exception as e:  # noqa: BLE001
                    log.error("[GPU%d] 识别失败: %s", idx, e)
                    send("asr", rid, "", "%s: %s" % (type(e).__name__, e))
                send("status", idx, "ready", "就绪")
            elif kind == "spk_qc":
                _, rid, path = job
                try:
                    send("spk_qc", rid, eng.spk_qc(path), "")                 # 状态(completed/failed/skipped)在结果里,质检不因评分器故障而中断上传
                except Exception as e:  # noqa: BLE001
                    log.warning("[GPU%d] 多人检测失败(忽略): %s", idx, e)
                    send("spk_qc", rid, {}, "%s: %s" % (type(e).__name__, e))
            elif kind == "spk_cmp":
                _, rid, gen_path, refs = job
                try:
                    r_ = eng.spk_cmp(gen_path, refs)
                    send("spk_cmp", rid, r_, "" if r_.get("status") != "failed" else r_.get("reason", "评分器不可用"))
                except Exception as e:  # noqa: BLE001
                    log.warning("[GPU%d] 声纹比对失败: %s", idx, e)
                    send("spk_cmp", rid, {}, "%s: %s" % (type(e).__name__, e))
            elif kind == "tts":
