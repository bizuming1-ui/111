<body>
<a class="skip" href="#main">跳到主要内容</a>
<header>
  <a class="brand" href="#/search" aria-label="星河搜索助手首页"><svg class="mark" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="5.2" fill="currentColor"/><ellipse cx="32" cy="32" rx="26" ry="10" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(-28 32 32)" opacity=".9"/><ellipse cx="32" cy="32" rx="26" ry="10" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(32 32 32)" opacity=".45"/><circle cx="52" cy="22" r="2.6" fill="currentColor"/><circle cx="14" cy="43" r="2" fill="currentColor" opacity=".7"/></svg><i>星河</i><small>搜索助手</small></a>
  <nav aria-label="主导航">
    <a class="primary" id="navVoice" href="/voice">语音克隆</a>
    <a id="navBrowser" href="#/browser">浏览器</a>
    <a id="navLibs" href="#/libs">语音库</a>
    <a id="navStatus" href="#/status">状态与设置</a>
  </nav>
</header>
<main id="main" tabindex="-1">

<!-- ═════════ 搜索 ═════════ -->
<section class="view" id="v-search" aria-labelledby="h-search">
  <div class="hero"><svg class="logo" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="5.2" fill="currentColor"/><ellipse cx="32" cy="32" rx="26" ry="10" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(-28 32 32)" opacity=".9"/><ellipse cx="32" cy="32" rx="26" ry="10" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(32 32 32)" opacity=".45"/><circle cx="52" cy="22" r="2.6" fill="currentColor"/><circle cx="14" cy="43" r="2" fill="currentColor" opacity=".7"/></svg><h1 id="h-search"><span>星河</span><em>搜索</em></h1>
    <p>直接搜索,无需任何 Key。点麦克风说出想查的内容,浏览器会在你眼前真实完成。</p></div>
  <form class="sbox" id="sform" role="search" aria-label="搜索或下达指令">
    <svg class="si" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    <input id="q" type="search" autocomplete="off" aria-label="搜索关键词或自然语言指令" placeholder="搜索,或点麦克风直接说出指令">
    <button class="ib" type="button" id="mic" aria-label="语音输入(再点一次结束)" title="语音:搜索 / 浏览器操作"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
    <button class="btn pri" type="submit" id="go">搜索</button>
  </form>
  <div class="center row" style="margin-top:8px"><span class="badge" id="modeBadge">当前模式:读取中…</span></div>
  <div id="voice" aria-live="polite">
    <button type="button" id="orbBtn" aria-label="开始 / 停止语音控制浏览器"><i></i><span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span></button>
    <div>
      <div id="vState"><span id="vStateTxt">语音控制浏览器 · 点圆球开始说话</span><span class="badge" id="vEngine"></span></div>
      <div id="vHeard"></div>
      <div class="chipline" id="vChips" aria-label="示例指令">
        <button type="button" class="chip" data-say="帮我搜索一下今天的天气">帮我搜索一下今天的天气</button><button type="button" class="chip" data-say="打开第一个结果">打开第一个结果</button><button type="button" class="chip" data-say="往下滚动">往下滚动</button><button type="button" class="chip" data-say="返回">返回</button><button type="button" class="chip" data-say="刷新">刷新</button><button type="button" class="chip" data-say="暂停">暂停</button>
      </div>
    </div>
  </div>
  <details class="optwrap"><summary>搜索选项</summary><div class="opts" role="group" aria-label="搜索选项">
    <label><input type="checkbox" id="visSearch"> 👁 文字搜索也用可见浏览器执行</label>
    <label>引擎 <select id="eng" aria-label="搜索引擎"><option value="bing">Bing</option><option value="google">Google(可见浏览器真实搜索)</option><option value="edge_default">Edge 默认搜索(实际来源见设置,默认 Bing)</option><option value="all">多来源:Google + Bing + Edge 默认(去重)</option><option value="duckduckgo">DuckDuckGo</option><option value="so360">360 搜索</option></select></label>
    <label>网站 <input type="text" id="site" size="14" placeholder="wikipedia.org" aria-label="限定网站"></label>
    <label>时间 <select id="rec" aria-label="时间范围"><option value="">不限</option><option value="d">一天内</option><option value="w">一周内</option><option value="m">一个月内</option><option value="y">一年内</option></select></label>
    <label>提供方 <select id="prov" aria-label="搜索提供方"><option value="auto">自动(免 Key)</option><option value="browser">仅可见浏览器</option><option value="brave">Brave API(可选)</option><option value="google_cse">Google CSE(遗留)</option></select></label>
    <label><input type="checkbox" id="wantAns" checked> 生成带来源的回答(需 DeepSeek,可选)</label>
    <label><input type="checkbox" id="wantSpeak"> 用当前语音库朗读 <span class="badge" id="spkLib">—</span></label>
    <label hidden><input type="radio" name="mode" value="search" checked></label>
  </div>
        <div class="opts" role="group" aria-label="理解与隐私设置" style="margin-top:6px">
      <label>默认城市 <input type="text" id="setCity" size="10" placeholder="例如 西雅图" aria-label="默认城市(天气类)" maxlength="40"></label>
      <label>时区 <input type="text" id="setTz" size="16" placeholder="Asia/Shanghai" aria-label="时区(IANA)" list="tzlist"></label>
      <datalist id="tzlist"><option value="Asia/Shanghai"><option value="Asia/Hong_Kong"><option value="Asia/Tokyo"><option value="America/Los_Angeles"><option value="America/New_York"><option value="Europe/London"><option value="UTC"></datalist>
      <label>Edge 默认搜索实际来源 <select id="setEdge" aria-label="Edge 默认搜索引擎"><option value="bing">Bing</option><option value="google">Google</option><option value="duckduckgo">DuckDuckGo</option></select></label>
      <label><input type="checkbox" id="useVision"> ☁ 允许把当前页面截图/文字发送到云端 DeepSeek(默认关闭)</label>
      <label><input type="checkbox" id="rawSearch"> 关键词直搜(不经大模型理解)</label>
      <span class="mut" id="setMsg">城市只用于天气类搜索;没有设置时会先问你,不会用服务器位置猜。</span>
    </div>
  </details>
  <div id="intentBox" class="card" hidden aria-live="polite" aria-label="大模型意图理解结果"></div>
  <div id="live" role="status" aria-live="polite"></div>
  <div id="diag" class="diag" hidden></div>
  <div id="asrBox" class="card" hidden aria-label="语音识别结果">
    <b>🎙 识别到的指令</b> <span class="badge" id="asrConf"></span>
    <textarea class="in" id="asrText" rows="2" aria-label="识别文字,可编辑"></textarea>
    <div class="row" style="margin-top:6px"><button class="btn pri" id="asrOk">确认并执行</button><button class="btn" id="asrNo">取消</button></div>
  </div>
  <div id="planBox" class="card" hidden aria-label="浏览器操作计划"></div>

  <div id="theater" hidden aria-label="浏览器实时画面(真实截图)">
    <div id="tBar"><div class="dots" aria-hidden="true"><b></b><b></b><b></b></div><div id="tUrl" title="当前真实 URL">about:blank</div><div id="tTitle"></div><span class="st" id="tSt">空闲</span></div>
    <div id="tProg"><i></i></div>
    <div id="tStage"><canvas id="tCanvas" width="1280" height="800"></canvas><canvas id="tTrail" width="1280" height="800"></canvas><div id="tCaption">等待任务…</div><div id="tCur"><svg viewBox="0 0 24 24"><path d="M3 2l7.6 19 2.6-7.8L21 10.6z" fill="#fff" stroke="#111" stroke-width="1.6" stroke-linejoin="round"/></svg></div><div id="tRip"></div><div id="tKeys"></div></div>
    <div id="tSteps"></div>
    <div id="tFoot">
      <button class="btn" id="tPause">⏸ 暂停</button><button class="btn" id="tResume">▶ 继续</button><button class="btn danger" id="tCancel">⏹ 取消</button><button class="btn" id="tTake" aria-pressed="false">✋ 人工接管</button><button class="btn" id="tRetry">↻ 重试</button><button class="btn" id="tHide">收起</button>
      <button class="btn" id="tFull" aria-pressed="false" title="切换原生全屏(Esc 退出)">全屏</button><span class="mut" id="tStat"></span>
    </div>
    <div class="log" id="tLog" aria-live="polite"></div>
  </div>

  <div id="answer"></div>
  <div id="results" aria-label="搜索结果"></div>
  <div class="center row" id="moreRow" hidden><button class="btn" id="more">再搜索几个来源</button></div>
</section>

<!-- ═════════ 浏览器 ═════════ -->
<section class="view" id="v-browser" aria-labelledby="h-browser">
  <h2 id="h-browser">隔离浏览器 <span class="sub">真实 Chromium 实时画面</span></h2>
  <p class="mut">这是服务器上的隔离 Chromium(CPU,独立 Cookie,关闭即清除登录状态)。画面是真实截图;红圈 = 真正执行的鼠标位置;输入的字会真的出现在网页里。验证码/登录/发送/提交/购买/删除等会暂停等你处理。</p>
  <div class="row" style="margin-bottom:8px">
    <input class="in" id="goUrl" style="flex:1;min-width:200px" placeholder="https://example.com" aria-label="网址">
    <button class="btn" id="goBtn">打开</button>
    <button class="btn" id="bPause">⏸ 暂停</button><button class="btn" id="bResume">▶ 继续</button><button class="btn danger" id="bCancel">⏹ 取消</button>
    <button class="btn" id="bTake" aria-pressed="false">✋ 人工接管</button><button class="btn" id="bRead">📖 读取并总结</button><button class="btn" id="bFull" title="原生全屏">全屏</button><button class="btn danger" id="bClose">关闭会话</button>
  </div>
  <div class="row" style="margin-bottom:8px"><input class="in" id="cmd" style="flex:1;min-width:200px" placeholder="自然语言:例如 向下滚动,然后点击 登录" aria-label="给浏览器的指令"><button class="btn pri" id="cmdGo">规划并执行</button></div>
  <div id="stageWrap"><div id="stage"><img id="shot" alt="远程浏览器实时画面" draggable="false"><div id="cur"></div><div id="typing"></div></div><div id="banner">未连接</div></div>
  <textarea id="kbd" aria-label="人工接管键盘输入" style="position:absolute;left:-999px;top:0;width:1px;height:1px"></textarea>
  <div class="grid2" style="margin-top:10px"><div><h3>动作日志</h3><div class="log" id="blog" aria-live="polite"></div></div>
    <div><h3>状态</h3><div class="card mono" id="bstat">—</div><div id="bsum"></div></div></div>
</section>

<!-- ═════════ 语音库 ═════════ -->
<section class="view" id="v-libs" aria-labelledby="h-libs">
  <h2 id="h-libs">语音库</h2>
  <div class="card"><div class="row"><input class="in" id="newName" style="flex:1;min-width:160px" placeholder="新语音库名称" aria-label="新语音库名称"><button class="btn pri" id="newLib">创建</button></div>
    <label class="mut"><input type="checkbox" id="newConsent"> 我确认这些声音属于本人,或已获得所有者的明确授权;输出为 AI 合成语音</label></div>
  <div id="usage" class="mut"></div>
  <div id="liblist"></div>
</section>

<!-- ═════════ 状态 ═════════ -->
<section class="view" id="v-status" aria-labelledby="h-status">
  <h2 id="h-status">运行状态与设置</h2>
  <div id="stbody" class="grid2"></div>
</section>
</main>

<dialog id="dlg" aria-labelledby="dlgT"><form method="dialog"><h3 id="dlgT"></h3><div id="dlgB"></div><div class="row" style="margin-top:12px;justify-content:flex-end"><button class="btn" value="no" id="dlgNo">取消</button><button class="btn pri" value="yes" id="dlgYes">确认</button></div></form></dialog>
<iframe id="spk" title="语音朗读(使用已有 TTS 管线)" hidden allow="autoplay"></iframe>

<script>
"use strict";
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const J = async (url, opt) => {
  let r; try { r = await fetch(url, opt); } catch (e) { return { ok: false, _status: 0, error: "网络错误:浏览器连不上服务器(" + e.message + ")。请检查网络或隧道是否仍在运行", _net: true }; }
  const ct = r.headers.get("content-type") || "", rid = r.headers.get("x-request-id") || "", raw = await r.text().catch(() => ""); let j = {};
  try { j = JSON.parse(raw); if (!j || typeof j !== "object" || Array.isArray(j)) j = { value: j }; } catch (e) { j = {}; }
  if (r.status === 401) { location.href = "/login?next=" + encodeURIComponent(location.pathname + location.hash); }
  j._status = r.status; j._rid = j.request_id || rid;
  if (!r.ok && !j.error) {                                   // 非 JSON / 无 error 字段的失败:说明它来自哪个边界,并保留响应片段
    const ng = r.headers.get("ngrok-error-code"), srv = r.headers.get("server") || "", via = r.headers.get("via") || "";
    const where = ng ? "ngrok 隧道层(ngrok-error-code=" + ng + "):请求没有到达应用,或应用没有响应" : !ct.includes("json") ? "代理/网关或服务端框架返回了非 JSON 页面" + (srv ? "(server=" + srv + ")" : "") : "应用返回了没有 error 字段的 JSON";
    j.ok = false; j.error = "HTTP " + r.status + " " + (r.statusText || "") + " —— " + where; j._diag = "响应类型:" + (ct || "无") + (via ? " · via=" + via : "") + "\n响应片段:" + raw.replace(/\s+/g, " ").slice(0, 240);
  }
  return j;
};
const post = (url, body) => J(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) });
const live = (m, bad) => { $("live").textContent = m || ""; $("live").className = bad ? "err" : ""; };
const short = (h) => (h ? String(h).slice(0, 10) + "…" : "—");
function ask(title, html, yes) { return new Promise((res) => { $("dlgT").textContent = title; $("dlgB").innerHTML = html; $("dlgYes").textContent = yes || "确认"; const d = $("dlg"); d.onclose = () => res(d.returnValue === "yes"); d.showModal(); }); }

/* ───── 路由 ───── */
const VIEWS = ["search", "browser", "libs", "status"];
function route() {
  let v = (location.hash.replace(/^#\/?/, "") || "search").split("?")[0]; if (!VIEWS.includes(v)) v = "search";
  VIEWS.forEach((x) => { $("v-" + x).classList.toggle("on", x === v); const n = $("nav" + x[0].toUpperCase() + x.slice(1)); if (n) { if (x === v) n.setAttribute("aria-current", "page"); else n.removeAttribute("aria-current"); } });
  document.body.classList.toggle("vb", v === "browser"); document.body.classList.toggle("vs", v === "search");
  if (v === "browser" || v === "search") connectBrowser(); if (v === "libs") loadLibs(); if (v === "status") loadStatus();
  document.title = { search: "星河搜索助手", browser: "浏览器 · 星河搜索助手", libs: "语音库 · 星河搜索助手", status: "运行状态 · 星河搜索助手" }[v];
}
addEventListener("hashchange", route);

/* ───── 状态条 ───── */
let ST = null;
async function refreshStatus() {
  ST = await J("/api/portal/status"); if (!ST.ok) return;
  const lib = ST.voice && ST.voice.library; $("spkLib").textContent = lib ? lib.name : "未选择语音库";
  const p = ST.search.providers.find((x) => x.id === ST.search.auto);
  const keyless = ST.search.providers.filter((x) => x.keyless && x.available).map((x) => x.id), br = ST.search.providers.find((x) => x.id === "browser");
  $("modeBadge").className = "badge " + (ST.search.auto === "http" ? "ok" : "ok");
  $("modeBadge").textContent = "当前模式:" + (ST.search.auto === "http" ? "免 Key 直搜(" + keyless.filter((x) => x !== "wikipedia").join(" → ") + (keyless.includes("wikipedia") ? " → wikipedia" : "") + ")" : (p ? p.name + "(真实 API,失败自动回退免 Key)" : ST.search.auto)) + " · 可见浏览器" + (br && br.available ? "可用" : "不可用(" + ((br && br.missing && br.missing[0]) || "?").slice(0, 40) + ")") + (ST.search.llm ? " · LLM 回答可用" : " · 未配置 LLM:只展示来源");
}

/* ───── 搜索(v7.1:免 Key 直搜 · 可见浏览器 · 失败可诊断) ───── */
let LAST = { q: "", page: 0 };
const ENGNAME = () => ($("eng").value === "edge_default" || $("eng").value === "all" ? "bing" : $("eng").value);   // v9:不再把 Google 悄悄映射成 Bing
function attemptsHtml(a) {
  if (!a || !a.length) return "";
  return '<div class="attempts">尝试过程:' + a.map((x) => (x.ok ? '<b class="ok">✓ ' + esc(x.provider) + " " + (x.n || 0) + " 条 " + (x.ms || 0) + "ms</b>" : '<b class="no">✗ ' + esc(x.provider) + "(" + esc((x.kind || "失败") + (x.message ? ":" + String(x.message).slice(0, 70) : "")) + ")</b>")).join(" → ") + "</div>";
}
function showDiag(r) {
  const d = $("diag"); if (!r || r.ok) { d.hidden = true; return; }
  const lines = ["HTTP 状态:" + (r._status != null ? r._status : "?") + (r._rid ? " · 请求 ID:" + r._rid : ""), "错误:" + (r.error || "未知")];
  (r.attempts || []).forEach((x) => lines.push(" · " + x.provider + " → " + (x.ok ? "成功" : (x.kind || "失败") + (x.message ? ":" + x.message : ""))));
  if (r._diag) lines.push(r._diag);
  d.hidden = false; d.textContent = lines.join("\n");
}
function renderResults(r) {
  const box = $("results"); box.innerHTML = "";
  if (r.attempts && r.attempts.length) box.insertAdjacentHTML("beforeend", attemptsHtml(r.attempts));
