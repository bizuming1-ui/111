"""
audio_qc.py —— 音频完整性检测 / 参考音频质检 / 声学摘要 / 相似度校准(只依赖 numpy)

  · 合成音频:NaN/Inf、无声、削波、样本数、截断、chunk 边界不连续、响度突变 —— 发现损坏必须报错并保存诊断,不得标记为成功
  · 参考音频:口语 / 歌声 / 背景音乐 / 噪声 / 疑似多人 的【启发式】判定(未经标注数据校准,只用于提示,不是权威结论)
  · 声学摘要:语速、停顿、音高范围、响度范围、音色指标;参考与生成分别计算并给出差异
  · 相似度:原始 cosine 与"校准后的估计"严格区分;没有校准文件就显示"未校准,不可给出百分比"
"""
import json
import math
import os
import time
import wave
from pathlib import Path

import numpy as np

SR = 24000


class AudioCorrupt(Exception):
    """合成音频被判定为损坏(NaN/Inf、无声、严重削波、样本数错误、边界断裂…)"""


def to_np(a):
    if hasattr(a, "detach"):
        a = a.detach().float().cpu().numpy()
    return np.asarray(a, dtype=np.float32).reshape(-1)


def float_to_pcm(a, strict=True):
    """float → int16。strict=True 时遇到 NaN/Inf 直接抛 AudioCorrupt(不再用 nan_to_num 悄悄掩盖)。"""
    a = to_np(a)
    if not np.isfinite(a).all():
        bad = int((~np.isfinite(a)).sum())
        if strict:
            raise AudioCorrupt("音频含 %d 个 NaN/Inf 样本(共 %d)" % (bad, a.size))
        a = np.nan_to_num(a)
    return (np.clip(a, -1.0, 1.0) * 32767.0).round().astype("<i2")


def db(x, floor=-120.0):
    return float(20 * math.log10(max(float(x), 1e-9))) if x > 0 else floor


def frame_rms(x, frame):
    n = len(x) // frame
    if n == 0:
        return np.zeros(0, np.float32)
    f = x[: n * frame].astype(np.float32).reshape(n, frame)
    return np.sqrt((f ** 2).mean(axis=1))


# ════════════════════════════════════════════════════════════════
#  合成音频完整性
# ════════════════════════════════════════════════════════════════
class SegmentQC:
    """逐块喂入(原始 int16,未做去静音),结束时给出报告。errors 非空 = 损坏。"""
    FR = SR // 100

    def __init__(self, sr=SR, keep_audio=True):
        self.sr = sr
        self.chunks = []
        self.keep = keep_audio
        self.n = 0
        self.joins = []          # (跳变幅度, 比值)
        self.chunk_db = []
        self.prev_tail = None

    def feed(self, pcm):
        pcm = np.asarray(pcm)
        if pcm.size == 0:
            return
        x = pcm.astype(np.float32)
        if self.prev_tail is not None:
            jump = abs(float(x[0]) - float(self.prev_tail[-1]))
            ctx = np.concatenate([self.prev_tail[-32:], x[:32]])
            local = float(np.abs(np.diff(ctx)).mean()) if ctx.size > 2 else 1.0
            self.joins.append((jump, jump / max(local, 1.0)))
        self.prev_tail = x[-64:].copy()
        r = frame_rms(x, self.FR)
        voiced = r[r >= 110.0]
        if voiced.size >= 3:                                      # 只统计有声块的响度,避免静音块拉出假"突变"
            self.chunk_db.append(db(float(np.sqrt((voiced ** 2).mean())) / 32768.0))
        self.n += pcm.size
        if self.keep:
            self.chunks.append(pcm.astype("<i2", copy=False))

    def audio(self):
        return np.concatenate(self.chunks) if self.chunks else np.zeros(0, "<i2")

    def finish(self, frames=None, spf=1920, hit_max=False):
