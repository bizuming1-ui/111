    w = np.asarray(w, dtype=np.float32).reshape(-1)
    if w.size == 0:
        raise AudioSkip("音频为空", "empty")
    if not np.isfinite(w).all():
        raise AudioSkip("音频含 NaN/Inf(损坏或合成异常)", "non_finite")
    if w.size < (min_samples or MIN_SAMPLES):
        raise AudioSkip("音频太短(%.2fs < %.2fs),说话人嵌入不可靠,已跳过(不补零)" % (w.size / 16000, (min_samples or MIN_SAMPLES) / 16000), "too_short")
    if float(np.sqrt(np.mean(w.astype(np.float64) ** 2))) < SILENCE_RMS:
        raise AudioSkip("音频近乎静音,无法提取说话人特征", "silent")
