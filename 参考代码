            _VC_SRV["tail"].append(line)
            if re.search(r"Traceback|Error|error|ERROR|⚠|声音|首包|RTF|就绪|加载|捕获|检测到|模型|对话出错|合成失败|Warning|WARNING", line) and "DeprecationWarning" not in line:
                print("  [server] " + line[:200], flush=True)
    threading.Thread(target=pump, daemon=True).start()
    return p


def health():
    try:
        return json.load(urllib.request.urlopen("http://127.0.0.1:%d/health" % PORT, timeout=4))
    except Exception:
        return None


