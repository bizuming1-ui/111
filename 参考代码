def clean_query(q, limit=120):
    q = re.sub(r"[\x00-\x1f\x7f]", " ", str(q or ""))
    q = re.sub(r"\s+", " ", q).strip(" \t\"“”'‘’「」")
    return q[:limit]


def strip_shell(text):
    """去掉“帮我搜索一下/你能不能查一查”这类指令外壳;保留人名/地点/品牌/型号/数字/否定词/引号内容。"""
    t = (text or "").strip()
    for _ in range(5):
        before = t
        t = _LEAD_SHELL.sub("", t, count=1)
        t = _VERB_LONG.sub("", t, count=1)
        t = _VERB_SHORT.sub("", t, count=1)
        if t == before:
            break
    t = _TRAIL_SHELL.sub("", t)
    return clean_query(t)


def detect_engines(text):
    """用户明确说出的引擎(确定性,权威):返回 (engines 有序去重, 去掉引擎短语后的文字)"""
    t = text or ""
    found = []
    for m in re.finditer(_ENG_PHRASE, t):
        for name in re.findall(_ENG_ALT, m.group(0), re.I):
            e = _ENG_NAMES.get(name.lower())
            if e and e not in found:
                found.append(e)
    rest = _ENG_PHRASE.sub(" ", t) if found else t
    if _ENG_MULTI.search(t):
        found = ["google", "bing", "edge_default"]
        rest = _ENG_MULTI.sub(" ", rest)
    return found, re.sub(r"\s+", " ", rest).strip()


def resolve_engines(chosen, edge_default="bing"):
    """把用户选择变成真实执行计划。edge_default → 实际 provider(Edge 不是独立索引);多引擎时去重并如实标注重合。"""
    if isinstance(chosen, str):
        chosen = ["google", "bing", "edge_default"] if chosen == "all" else [chosen]
    out, seen = [], {}
    for e in chosen or ["bing"]:
        if e == "edge_default":
            prov = edge_default if edge_default in ("bing", "google", "duckduckgo") else "bing"
            label = "Edge 默认搜索(实际来源:%s)" % ENGINE_LABELS.get(prov, prov)
            item = {"id": "edge_default", "provider": prov, "label": label, "browser": "edge", "remote_edge": False,
                    "note": "Edge 是浏览器不是独立搜索索引;本系统运行在 Kaggle 隔离 Chromium,不是你电脑上的 Microsoft Edge"}
        else:
            prov = e if e in ENGINE_LABELS else "bing"
            item = {"id": prov, "provider": prov, "label": ENGINE_LABELS.get(prov, prov)}
        if prov in seen:
            item["duplicate_of"] = seen[prov]
            item["note"] = (item.get("note", "") + ";" if item.get("note") else "") + "与 %s 实际来源相同(%s),结果已去重,不虚构第三组独立结果" % (seen[prov], ENGINE_LABELS.get(prov, prov))
        else:
            seen[prov] = item["id"]
        out.append(item)
    return out


