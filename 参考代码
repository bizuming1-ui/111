def secret(name):
    try:
        from kaggle_secrets import UserSecretsClient
        v = UserSecretsClient().get_secret(name)
        return (v or "").strip()
    except Exception:
        return (os.environ.get(name) or "").strip()


def run(cmd, tail=25, env=None, show=None):
    """运行命令,流式打印关键行;失败时抛出带日志尾部的错误。"""
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
    last = deque(maxlen=tail)
    n = 0
    for line in p.stdout:
        line = line.rstrip()
        last.append(line)
        n += 1
        if show and re.search(show, line):
            print("   " + line[:150], flush=True)
        elif n % 15 == 0:
            print(".", end="", flush=True)
    p.wait()
    if p.returncode != 0:
        raise RuntimeError("命令失败(%s):\n%s" % (" ".join(map(str, cmd[:6])), "\n".join(last)))
    return list(last)


_CURVE = {"shown": False}


def stream(cmd, env=None, cwd=None):
    """运行子进程并原样转发输出;识别训练曲线更新信号并在 Notebook 里刷新图表。可被 Ctrl+C / 停止按钮中断。"""
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env, cwd=cwd, start_new_session=True)
    try:
        for line in p.stdout:
            line = line.rstrip()
            if line.startswith("CURVE_UPDATED "):
                try:
                    from IPython.display import Image, display, update_display
                    img = Image(filename=line.split(" ", 1)[1])
                    if _CURVE["shown"]:
                        update_display(img, display_id="vc_curve")
                    else:
                        display(img, display_id="vc_curve")
                        _CURVE["shown"] = True
                except Exception:
                    pass
                continue
            print(line[:230], flush=True)
        p.wait()
    except KeyboardInterrupt:
        try:
            os.killpg(os.getpgid(p.pid), signal.SIGTERM)
        except Exception:
            pass
        raise
    return p.returncode


