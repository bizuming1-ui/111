def run(cmd, tail=25, env=None, show=None, timeout=None):
    """运行命令,流式打印关键行;失败时抛出带日志尾部的错误。timeout(秒)= 子进程看门狗:超时直接终止并按失败处理(交给 retry 重试)。"""
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
    timer, timed_out = None, []
    if timeout:
        def _kill():
            if p.poll() is None:
                timed_out.append(1)
                try:
                    p.kill()
                except Exception:
                    pass
        timer = threading.Timer(timeout, _kill)
        timer.daemon = True
        timer.start()
    last = deque(maxlen=tail)
    n = 0
    for line in p.stdout:
        line = line.rstrip()
        last.append(line)
        n += 1
        if show and re.search(show, line):
            print("   " + line[:150], flush=True)
        elif n % 15 == 0:
            print(".", end="", flush=True)
    p.wait()
    if timer:
        timer.cancel()
    if p.returncode != 0:
        raise RuntimeError("命令失败%s(%s):\n%s" % ("(超时 %ds 被终止)" % timeout if timed_out else "", " ".join(map(str, cmd[:6])), "\n".join(last)))
    return list(last)


def retry(fn, tries=3, wait=6, what="操作"):
    """网络类操作(pip / 下载模型 / ngrok)的统一重试:指数退避,最后一次失败才抛出。"""
    for i in range(1, tries + 1):
        try:
            return fn()
        except Exception as e:
            if i >= tries:
                raise
            print("  ⚠ %s 失败(第 %d/%d 次): %s → %ds 后重试" % (what, i, tries, str(e).splitlines()[0][:120], wait * i), flush=True)
            time.sleep(wait * i)


