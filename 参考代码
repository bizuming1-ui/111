    if (c) { c.drained = true; if (m.stats) { c.underruns = m.stats.underruns; c.rebuffers = m.stats.underruns; c.max_underrun_ms = m.stats.max_underrun_ms; c.silent_ms = m.stats.silent_ms; c.min_level_ms = m.stats.min_level_ms; c.overflow = m.stats.overflow; } }
    if (S.turnDone || (c && c.done)) { setPhase("idle"); finalizeTurn("drained"); }
