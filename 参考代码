                                                                              "voice_confirmed": bool(voice.get("vid", 0) > 0 and w.voice_vid == voice.get("vid"))} for w in (pool.workers if pool else [])],
                "real_gpu_count": len(gpus), "tts_ready": not why and voice.get("state") == "ready", "tts_unavailable_reason": why, "mock": bool(G.get("MOCK")),
                "voice": {"state": voice.get("state"), "vid": voice.get("vid"), "library": lib, "err": voice.get("err"), "pending": sorted(voice.get("pending") or [])},
                "models": [{"role": "语音合成 TTS", "name": os.path.basename(G["MODEL"]) if os.path.isdir(G["MODEL"]) else G["MODEL"], "where": "每张 T4 一个进程(各加载一份,权重相同)", "gpu": True},
                           {"role": "语音识别 ASR", "name": "whisper-large-v3-turbo(回退 small)", "where": "复用 GPU worker 按需加载,不另起进程", "gpu": True},
                           {"role": "声纹评估", "name": G["SV_MODEL"], "where": "复用 GPU worker 按需加载", "gpu": True},
                           {"role": "对话/回答 LLM", "name": ("DeepSeek API(远程)" if G.get("DS_KEY") else ("Mock LLM(测试)" if G.get("MOCK_LLM") else "未配置")), "where": "远程 API,不占显存", "gpu": False},
                           {"role": "浏览器自动化", "name": "Chromium(Playwright)", "where": "CPU,不加载任何视觉/Agent 模型", "gpu": False}],
                "tasks": {"tts_active": len(G["ACTIVE"]), "train": G["read_train_progress"](), "browser_active": len([1 for s in self.mgr.sessions.values() if s.status in ("running", "waiting_confirm", "paused", "waiting_human")])},
                "queues": {"tts_active_turns": len(G["ACTIVE"]), "browser_queued": self.mgr.queued, "train_jobs_queued": sum(1 for i in self.store.idx["order"] for j in self.store.get(i)["jobs"] if j["state"] == "queued")},
                "browser": self.mgr.status(), "cpu": {"load": list(os.getloadavg()) if hasattr(os, "getloadavg") else None, "cpus": os.cpu_count(), "mem_mb": mem},
