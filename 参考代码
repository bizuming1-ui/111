def bootstrap_diff_ci(a, b, n=2000, alpha=0.05, seed=0):
    """配对 bootstrap:返回 mean(b−a) 及 (1−alpha) 置信区间。a/b 为同一批样本上的基线/候选指标。"""
    a, b = np.asarray(a, float), np.asarray(b, float)
    assert a.shape == b.shape and a.size >= 5
    d = b - a
    rng = np.random.default_rng(seed)
    ms = np.array([d[rng.integers(0, d.size, d.size)].mean() for _ in range(n)])
    return float(d.mean()), (float(np.quantile(ms, alpha / 2)), float(np.quantile(ms, 1 - alpha / 2)))


class Registry:
    """版本注册表 registry.json:每个学习资产的版本、时间、样本量、指标、置信区间、回滚点。
    promote():非劣效门(护栏指标 CI 下界 ≥ −margin)+ 目标指标显著提升(CI 下界 > 0)才晋升;否则拒绝并保持当前版本;
    canary_violation() 违反护栏 → rollback() 回到上一个版本。没有证据就不晋升。"""

    def __init__(self, path=None):
        self.path = path or os.path.join(STATE_DIR, "registry.json")
        self.d = {"assets": {}}
        self._lk = threading.Lock()
        try:
            with open(self.path) as f:
                self.d = json.load(f)
        except (OSError, ValueError):
            pass

    def _save(self):
        try:
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            tmp = self.path + ".tmp"
            with open(tmp, "w") as f:
                json.dump(self.d, f, ensure_ascii=False, indent=1)
            os.replace(tmp, self.path)
        except OSError:
            pass

    def current(self, asset):
        a = self.d["assets"].get(asset)
        return a["versions"][a["cur"]] if a and a["versions"] else None

    def register(self, asset, params, note="initial"):
        with self._lk:
            a = self.d["assets"].setdefault(asset, {"cur": -1, "versions": []})
            a["versions"].append({"v": len(a["versions"]) + 1, "t": time.time(), "params": params, "note": note, "evidence": None})
            a["cur"] = len(a["versions"]) - 1
            self._save()
            return a["versions"][-1]

    def promote(self, asset, cand_params, target, guards, margin=0.0, min_n=20):
        """target = (基线样本, 候选样本, higher_is_better);guards = {name: (基线, 候选, higher_is_better, margin)}。返回 dict(promoted, reason, evidence)。"""
        ev = {"n": 0, "target": None, "guards": {}}
        tb, tc, hib = target
        if len(tb) < min_n or len(tb) != len(tc):
            return {"promoted": False, "reason": "样本不足(n=%d < %d):数据不足,不晋升" % (len(tb), min_n), "evidence": ev}
        ev["n"] = len(tb)
        sgn = 1.0 if hib else -1.0
        m, (lo, hi) = bootstrap_diff_ci(np.asarray(tb) * sgn, np.asarray(tc) * sgn)
        ev["target"] = {"mean_gain": round(m, 4), "ci": [round(lo, 4), round(hi, 4)]}
        for name, (gb, gc, ghib, gm) in guards.items():
            s2 = 1.0 if ghib else -1.0
            gmn, (glo, ghi) = bootstrap_diff_ci(np.asarray(gb) * s2, np.asarray(gc) * s2)
            ev["guards"][name] = {"mean_change": round(gmn, 4), "ci": [round(glo, 4), round(ghi, 4)], "margin": gm}
            if glo < -abs(gm):
                return {"promoted": False, "reason": "护栏「%s」非劣效不成立(置信区间下界 %.4f < −%.4f)" % (name, glo, abs(gm)), "evidence": ev}
        if lo <= margin:
            return {"promoted": False, "reason": "目标指标提升不显著(置信区间下界 %.4f ≤ %.4f)" % (lo, margin), "evidence": ev}
        v = self.register(asset, cand_params, note="promoted")
        with self._lk:
            v["evidence"] = ev
            self._save()
        return {"promoted": True, "reason": "非劣效且显著提升", "evidence": ev, "version": v["v"]}

    def canary_violation(self, asset, guard_value, limit, higher_is_better=True):
        bad = (guard_value < limit) if higher_is_better else (guard_value > limit)
        if bad:
            return self.rollback(asset, "金丝雀违反护栏:%.4f 越过 %.4f" % (guard_value, limit))
        return False

    def rollback(self, asset, why=""):
        with self._lk:
            a = self.d["assets"].get(asset)
            if not a or a["cur"] <= 0:
                return False
            a["versions"][a["cur"]]["rolled_back"] = why or True
            a["cur"] -= 1
            self._save()
            return True

    def summary(self):
        return {k: {"current": v["versions"][v["cur"]]["v"] if v["versions"] else None, "versions": len(v["versions"]),
                    "rolled_back": sum(1 for x in v["versions"] if x.get("rolled_back"))} for k, v in self.d["assets"].items()}


def sha256_file(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()
