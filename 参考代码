    """清理文本。final=True/False 时补句末标点:模型看到明确的句末标点才会收好语调(降调/上扬),不会半截吞音。"""
    t = _URL.sub("", t or "")
    t = _EMOJI.sub("", t)
    t = _MD.sub("", t)
    t = re.sub(r"\s*\n+\s*", "，", t)
    t = re.sub(r"[ \t\u3000]+", " ", t)
    t = _LEAD.sub("", t).strip()
    t = re.sub(r"\.{3,}|。{2,}", "…", t)
    if final is not None and t and has_speech(t) and t[-1] not in _ENDP and t[-1] not in "”’\"'」』)）]】":
        cjk = bool(re.search(r"[\u3040-\u30ff\u4e00-\u9fff\uac00-\ud7af]", t))
        t += ("。" if cjk else ".") if final else ("，" if cjk else ",")
    return t


def has_speech(t):
    return bool(_SPEECH.search(t or ""))


def detect_lang(t):
    cjk = len(re.findall(r"[\u4e00-\u9fff]", t))
    if re.search(r"[\u3040-\u30ff]", t):
        return "Japanese"
    if re.search(r"[\uac00-\ud7af]", t):
        return "Korean"
    if cjk >= 1:
        return "Chinese"
    return "English"


STRONG = set("。！？!?；;\n…")
WEAK = set("，,、：:")
# (最短长度, 逗号处可切的长度, 强制切断长度)
# 离线模拟扫描结果: 第 1 句 5~7 个字(≈1.1~1.5 秒音频)时「首声 + 所需预缓冲」最小(太短→句间接不上,太长→首句自身的生成缺口变大);
# 第 2 句要足够长(≥ ~1.5 秒音频),这样第 3 句的「预填充 ≈ 0.5~1 秒」能被第 1+2 句的播放时间完全盖住 → 句间零空隙。
LIMITS = [(4, 5, 12), (8, 12, 30), (10, 16, 40), (12, 24, 52)]


class Segmenter:
    """把 DeepSeek 流式吐出的文字按标点切成适合 TTS 的片段。"""

    def __init__(self):
        self.buf = ""
        self.n = 0

    def push(self, t):
        self.buf += t
        return self._drain()

    def finish(self):
        out = self._drain()
        rest = self.buf.strip()
        self.buf = ""
        if rest:
            out.append(rest)
            self.n += 1
        return out

    def _drain(self):
        out = []
        while True:
            mn, soft, hard = LIMITS[min(self.n, len(LIMITS) - 1)]
            cut = self._find(mn, soft, hard)
            if cut is None:
                break
            seg, self.buf = self.buf[:cut], self.buf[cut:]
            if seg.strip():
                out.append(seg.strip())
                self.n += 1
        return out

    def _find(self, mn, soft, hard):
        b = self.buf
        L = len(b)
        for i, ch in enumerate(b):
            ln = i + 1
            if ch in STRONG and ln >= mn:
                return ln
            if ch == "." and ln >= mn and i + 1 < L and b[i + 1] in " \n":
                return ln
            if ch in WEAK and ln >= soft:
                return ln
            if ln >= hard:
                j = max(b.rfind(c, hard // 2, ln) for c in "，,、 ")
                return (j + 1) if j > 0 else ln
        return None


_PAUSE_MS = [("。！？!?…\n", 260), ("；;：:", 190), ("，,、", 110)]


def pause_ms(end_char, scale):
    base = 60
    for chars, ms in _PAUSE_MS:
        if end_char and end_char in chars:
            base = ms
            break
    return int(base * max(0.0, min(2.5, scale)))


# ════════════════════════════════════════════════════════════════
#  去静音器: 每段 TTS 开头/结尾的静音都会变成"停顿感",在这里统一去掉,再由网关按标点插入自然停顿
# ════════════════════════════════════════════════════════════════
class Trimmer:
    F = SR // 100            # 10ms 一帧
    THR = 110.0              # RMS 低于它视为静音
    MAX_INNER = 40           # 句中静音最长保留 400ms

    def __init__(self):
        self.carry = np.zeros(0, np.int16)
        self.started = False
        self.pending = []    # 暂存的静音帧(等到后面有声音才决定要不要放出)
        self.held = None     # 最后一个有声帧(留着,结束时做淡出)
        self.total = 0

    def _emit(self, out, fr):
        if self.held is not None:
            out.append(self.held)
        self.held = fr

    def feed(self, x):
        buf = np.concatenate([self.carry, x]) if self.carry.size else x
        n = len(buf) // self.F
        self.carry = buf[n * self.F:].copy()
        out = []
        if n:
            fr = buf[:n * self.F].reshape(n, self.F)
            rms = np.sqrt((fr.astype(np.float32) ** 2).mean(axis=1))
            for k in range(n):
                f = fr[k]
                if rms[k] >= self.THR:
                    if not self.started:
                        self.started = True
                        f = f.copy()
                        m = min(len(f), SR // 200)                      # 开头 5ms 淡入
                        f[:m] = (f[:m] * np.linspace(0, 1, m, dtype=np.float32)).astype(np.int16)
                    else:
                        for p in self.pending[: self.MAX_INNER]:
                            self._emit(out, p)
                    self.pending = []
                    self._emit(out, f)
                elif self.started:
                    self.pending.append(f)
        return self._join(out)

    def flush(self):
        out = []
        if self.carry.size and self.started and np.sqrt((self.carry.astype(np.float32) ** 2).mean()) >= self.THR:
            for p in self.pending[: self.MAX_INNER]:
                self._emit(out, p)
            self.pending = []
            self._emit(out, self.carry)
        self.carry = np.zeros(0, np.int16)
        self.pending = []                                              # 结尾静音直接丢弃
        if self.held is not None:
            h = self.held.copy()
            m = min(len(h), SR // 125)                                 # 结尾 8ms 淡出
            h[-m:] = (h[-m:] * np.linspace(1, 0, m, dtype=np.float32)).astype(np.int16)
            out.append(h)
            self.held = None
        return self._join(out)

    def _join(self, out):
        if not out:
            return np.zeros(0, np.int16)
        a = np.concatenate(out)
        self.total += len(a)
        return a


