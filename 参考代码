def test_unit_search_chain_fallback_errors_and_no_retry_policy():
    import search_providers as sp
    srv, base = _fake_site()
    old = dict(sp.BASES)
    sp.BASES.update(bing=base, duckduckgo=base, wikipedia=base)
    try:
        FakeSite.modes.update(bing="ok", ddg="ok", wiki="ok")
        res, pid, att = asyncio.run(sp.search_http_chain("测试", 8))
        assert pid == "http:bing+duckduckgo" and len(res) == 3 and att[0]["ok"] and att[1]["ok"]      # v8:Bing 只有 2 条(<8)→ 合并 DDG 的 1 条
        # Bing 持续 5xx:可重试 → 重试 1 次后失败 → 自动切到 DuckDuckGo;失败原因与实际 provider 都可见
        FakeSite.modes.update(bing="503")
        FakeSite.hits.update(bing=0, ddg=0, wiki=0)
        res, pid, att = asyncio.run(sp.search_http_chain("测试", 8))
        assert pid == "http:duckduckgo" and FakeSite.hits["bing"] == 2, FakeSite.hits
        assert att[0]["provider"] == "bing" and att[0]["kind"] == "server_error" and att[0]["tries"] == 2 and att[-1]["ok"]
        # 429 / 验证码页:不可重试(只请求 1 次),且不绕过
        for mode, kind in (("429", "rate_limited"), ("challenge", "challenge"), ("empty", "empty"), ("changed", "parse")):
            FakeSite.modes.update(bing=mode, ddg="ok")
            FakeSite.hits.update(bing=0)
            res, pid, att = asyncio.run(sp.search_http_chain("测试", 8))
            assert att[0]["kind"] == kind and FakeSite.hits["bing"] == 1 and pid == "http:duckduckgo", (mode, att[0], FakeSite.hits)
        # 全部失败 → SearchFailed,携带每次尝试;维基百科最后兜底
        FakeSite.modes.update(bing="503", ddg="challenge", wiki="ok")
        res, pid, att = asyncio.run(sp.search_http_chain("日期", 8))
        assert pid == "http:wikipedia" and res[0]["url"].endswith("/wiki/%E6%B5%8B%E8%AF%95%E6%9D%A1%E7%9B%AE") and res[0]["snippet"] == "片段 高亮"
        FakeSite.modes.update(wiki="503")
        try:
            asyncio.run(sp.search_http_chain("日期", 8))
            raise AssertionError("应当失败")
        except sp.SearchFailed as e:
            kinds = [a["kind"] for a in e.attempts]
            assert kinds[:2] == ["server_error", "challenge"] and "wikipedia" in e.attempts[-1]["provider"] and "遇到验证码" in str(e)
    finally:
        sp.BASES.update(old)
        srv.shutdown()


