<script>
/* ═════════ v11 浏览器工作台:布局 / 缩放 / 全屏 / 分辨率档位 / 帧元数据 / 重连 / 语音+文字 / 视觉定位 ═════════
   四种尺寸不混用:①容器大小(这里的 stageWrap) ②Chromium CSS 视口(VIEWSZ,来自每帧元数据) ③截图实际像素(帧元数据 pw×ph) ④界面缩放(WB.cur,只影响显示)。
   鼠标坐标 = 点击位置相对画面矩形的归一化比例,服务端用「当前 CSS 视口」换算,所以界面缩放/侧栏开关/全屏都不会让远端点击偏移。 */
(function () {
  "use strict";
  const WB = { mode: "fit", scale: 1, cur: 1, side: true, conn: "idle", retry: 0, frame: null, lastId: 0, lastEpoch: -1, pending: null, arrivals: [], lastRender: 0, lastArrival: 0, profile: null, profiles: null, status: null, pseudoFull: false, timer: 0, sugg: "" };
  const PK = "wb_prefs";                                   // 只保存界面偏好:缩放模式/比例/侧栏/档位。绝不保存截图、Cookie、页面正文或浏览记录。
  let prefs = {}; try { prefs = JSON.parse(localStorage.getItem(PK) || "{}") || {}; } catch (e) {}
  if (["fit", "actual", "zoom"].includes(prefs.mode)) WB.mode = prefs.mode;
  if (typeof prefs.scale === "number" && prefs.scale >= 0.25 && prefs.scale <= 4) WB.scale = prefs.scale;
  WB.side = prefs.side !== false; WB.prefProfile = ["compat", "hd", "uhd"].includes(prefs.profile) ? prefs.profile : null;
  const savePrefs = () => { try { localStorage.setItem(PK, JSON.stringify({ mode: WB.mode, scale: WB.scale, side: WB.side, profile: WB.profile })); } catch (e) {} };
  const hint = (m, bad) => { const h = $("wbHint"); h.textContent = m || ""; h.hidden = !m; };
  const inBrowserView = () => document.body.classList.contains("vb");
  window.WBSTATE = WB;

  /* ── 布局 ── */
  function layout() {
    const wrap = $("stageWrap"), st = $("stage"); if (!wrap || !st) return;
    wrap.style.overflow = WB.mode === "fit" ? "hidden" : "auto";
    const cw = wrap.clientWidth, ch = wrap.clientHeight; if (!cw || !ch) return;
    const vw = VIEWSZ.w || 1280, vh = VIEWSZ.h || 800, fit = Math.max(0.05, Math.min(cw / vw, ch / vh));
    const sc = WB.mode === "fit" ? fit : WB.mode === "actual" ? 1 : WB.scale; WB.cur = sc; WB.fit = fit;
    st.style.width = Math.floor(vw * sc) + "px"; st.style.height = Math.floor(vh * sc) + "px";
    $("vZoom").textContent = (WB.mode === "fit" ? "适应 " : WB.mode === "actual" ? "1:1 " : "") + Math.round(sc * 100) + "%";
    $("vFit").setAttribute("aria-pressed", String(WB.mode === "fit")); $("vActual").setAttribute("aria-pressed", String(WB.mode === "actual"));
    document.documentElement.style.setProperty("--ar", (vw / vh).toFixed(4)); $("tStage").style.aspectRatio = vw + " / " + vh;
  }
  function setHH() { const h = document.querySelector("header"); document.documentElement.style.setProperty("--hh", (h && getComputedStyle(h).display !== "none" ? h.offsetHeight : 0) + "px"); layout(); }
  function applyView(v) { if (v && v.w && v.h && (v.w !== VIEWSZ.w || v.h !== VIEWSZ.h)) { VIEWSZ = { w: v.w, h: v.h }; layout(); } }
  $("vFit").onclick = () => { WB.mode = "fit"; savePrefs(); layout(); };
  $("vActual").onclick = () => { WB.mode = "actual"; savePrefs(); layout(); };
  const zoomBy = (f) => { const base = WB.cur || 1; WB.mode = "zoom"; WB.scale = Math.max(0.25, Math.min(4, +(base * f).toFixed(3))); savePrefs(); layout(); };
  $("vIn").onclick = () => zoomBy(1.25); $("vOut").onclick = () => zoomBy(0.8);
  $("vSide").onclick = () => { WB.side = !WB.side; $("wb").classList.toggle("noside", !WB.side); $("vSide").setAttribute("aria-pressed", String(WB.side)); savePrefs(); layout(); };
  $("wb").classList.toggle("noside", !WB.side); $("vSide").setAttribute("aria-pressed", String(WB.side));
  if (window.ResizeObserver) { new ResizeObserver(layout).observe($("stageWrap")); new ResizeObserver(setHH).observe(document.querySelector("header")); }
  addEventListener("resize", setHH);

  /* ── 全屏:必须由点击触发;被拒绝时显示可见提示并保留全视口布局;提供退出按钮与 Esc ── */
  const fsActive = () => document.fullscreenElement === $("wb") || WB.pseudoFull;
  function syncFs() { const on = fsActive(); document.body.classList.toggle("wbfull", on); $("bFull").textContent = on ? "退出全屏" : "全屏"; $("bFull").setAttribute("aria-pressed", String(on)); setHH(); }
  $("bFull").onclick = async () => {
    if (fsActive()) { WB.pseudoFull = false; if (document.fullscreenElement) { try { await document.exitFullscreen(); } catch (e) {} } syncFs(); hint(""); return; }
    const w = $("wb");
    if (w.requestFullscreen) { try { await w.requestFullscreen(); hint(""); return; } catch (e) { hint("浏览器拒绝了原生全屏(" + ((e && e.message) || e) + "):已切换为全视口布局;按 Esc 或再点一次「退出全屏」返回。", true); } }
    else hint("此浏览器不支持原生全屏:已切换为全视口布局;按 Esc 或再点一次「退出全屏」返回。", true);
    WB.pseudoFull = true; syncFs();
  };
  document.addEventListener("fullscreenchange", syncFs);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && WB.pseudoFull && !document.fullscreenElement) { WB.pseudoFull = false; syncFs(); hint(""); } });

  /* ── 分辨率档位(CSS 视口 / DPR):DPR 变化要重建 BrowserContext → 先提示,确认后才执行 ── */
  async function loadProfiles() {
    const r = await J("/api/agent/profiles"); if (!r.ok) return; WB.profiles = r.profiles; WB.profile = r.current;
    $("vProf").innerHTML = Object.keys(r.profiles).map((k) => { const p = r.profiles[k]; return '<option value="' + k + '">' + esc(p.label) + " " + p.w + "×" + p.h + (p.dpr > 1 ? " · DPR " + p.dpr : "") + "</option>"; }).join("");
    $("vProf").value = r.current;
    if (WB.prefProfile && WB.prefProfile !== r.current && !WB.prefTried) {              // 恢复上次选择的档位;需要重建上下文时不打扰用户(保持当前,等用户手动切换)
      WB.prefTried = true; const x = await post("/api/agent/profile", { profile: WB.prefProfile });
      if (x.ok) { WB.profile = x.profile; $("vProf").value = x.profile; applyView(x.view); }
    }
  }
  $("vProf").onchange = async () => {
    const want = $("vProf").value, label = (WB.profiles && WB.profiles[want] && WB.profiles[want].label) || want; let r = await post("/api/agent/profile", { profile: want });
    if (!r.ok && r.needs_rebuild) {
      const yes = await ask("切换到「" + label + "」需要重建浏览器上下文", "<p>" + esc(r.error) + "</p><p class='mut'>不想丢失登录状态就点取消,保持当前档位。</p>", "确认重建并切换");
      if (!yes) { $("vProf").value = WB.profile; return; }
      r = await post("/api/agent/profile", { profile: want, confirm_rebuild: true });
    }
    if (!r.ok) { hint("切换分辨率失败:" + (r.error || ("HTTP " + r._status)), true); $("vProf").value = WB.profile; return; }
    WB.profile = r.profile; WB.lastId = 0; WB.lastEpoch = -1; applyView(r.view); savePrefs(); hint("已切换到「" + label + "」:CSS 视口 " + r.view.w + "×" + r.view.h + " · DPR " + r.dpr + "(以下方「状态」里实测的截图像素为准)"); setTimeout(() => hint(""), 6000);
  };

  /* ── 画面帧:元数据与二进制配对;旧帧/乱序帧丢弃 ── */
  window.paintFrame = function (blob) {                           // 剧场画布:按真实截图像素绘制(不再固定缩成 1280×800)
    if (typeof createImageBitmap !== "function") return;
    createImageBitmap(blob).then((b) => {
      if (!TH.ctx || $("theater").hidden) { b.close && b.close(); return; }
      const cv = $("tCanvas"), w = Math.min(b.width, 1920), h = Math.round(w * b.height / b.width);
      if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }
      TH.ctx.drawImage(b, 0, 0, w, h); b.close && b.close();
    }).catch(() => {});
  };
  function onFrame(blob) {
    const m = WB.pending; WB.pending = null;
    if (m) {
      if (m.epoch === WB.lastEpoch && m.id <= WB.lastId) return;                 // 旧帧 / 乱序帧:丢弃,绝不当作当前画面
      WB.lastEpoch = m.epoch; WB.lastId = m.id; WB.frame = m; applyView({ w: m.vw, h: m.vh });
      const t = performance.now(); WB.lastArrival = t; WB.arrivals.push(t); while (WB.arrivals.length && t - WB.arrivals[0] > 3000) WB.arrivals.shift();
      $("stage").classList.remove("stale");
    }
    window.paintFrame(blob);
    const u = URL.createObjectURL(blob), img = $("shot"), old = img.src; img.onload = () => { if (old && old.startsWith("blob:")) URL.revokeObjectURL(old); }; img.src = u;
    render(false);
  }
  const origMsg = window.onBrowserMsg;
  window.onBrowserMsg = function (ev) {
    if (typeof ev.data !== "string") return onFrame(ev.data);
    let m; try { m = JSON.parse(ev.data); } catch (e) { return; }
    if (m.type === "frame") { WB.pending = m; return; }
    if (m.type === "hello") { WB.pending = null; WB.lastId = 0; WB.lastEpoch = -1; WB.status = m; if (m.view) applyView(m.view); if (m.profile) { WB.profile = m.profile; if ($("vProf").options.length > 1) $("vProf").value = m.profile; } }
    if (m.type === "status") WB.status = m;
    if (m.type === "error" && /画面已过期/.test(m.message || "")) hint(m.message, true);
    return origMsg(ev);
  };
  const STM = { idle: "空闲", running: "执行中", paused: "已暂停", waiting_confirm: "等待你确认", waiting_human: "需要你人工处理", done: "完成", error: "出错", cancelled: "已取消", queued: "排队中" };
  const connText = () => ({ open: "已连接", connecting: "连接中…", closed: "连接已断开,正在重连(第 " + WB.retry + " 次)", failed: "连接失败,已停止自动重连(刷新页面或重新登录后重试)", idle: "未连接" })[WB.conn] || WB.conn;
  window.bStatus = function (s) {
    WB.status = s; if (s.view) applyView(s.view);
    const bn = $("banner"); bn.textContent = (STM[s.status] || s.status) + (s.msg ? " · " + s.msg : "") + (s.url ? " · " + s.url.slice(0, 90) : "") + (WB.conn !== "open" ? " · " + connText() : "");
    bn.className = s.status === "error" ? "bad" : ["waiting_human", "paused", "waiting_confirm"].includes(s.status) ? "warn" : "";
    if (s.status === "paused" && /找不到|不唯一|不可见|没有明显变化/.test(s.msg || "") && (CUR_SETTINGS || {}).vision_consent) suggest(s.msg);
    render(true);
    if (s.pending) askConfirm(s.pending);
  };
  function render(force) {
    const now = performance.now(); if (!force && now - WB.lastRender < 250) return; WB.lastRender = now;
    const s = WB.status || {}, f = WB.frame, pf = s.perf || {}, a = WB.arrivals;
    const fps = a.length >= 2 ? (a.length - 1) / ((a[a.length - 1] - a[0]) / 1000) : 0;
    const prof = WB.profiles && WB.profiles[s.profile || WB.profile];
    const rows = ["状态 " + (s.status || "—") + " · 档位 " + ((prof && prof.label) || s.profile || "—") + " · 连接 " + connText(),
      "CSS 视口 " + VIEWSZ.w + "×" + VIEWSZ.h + " · 设备像素比 DPR " + (s.dpr != null ? s.dpr : "—"),
      f ? "截图像素 " + f.pw + "×" + f.ph + "(有效 DPR " + f.eff_dpr + (f.scale === "css" ? " · CSS 像素截图" : "") + ") · 帧 #" + f.id : "截图像素 —(还没有收到画面)",
      "帧率 " + fps.toFixed(1) + " fps(浏览器实测) · 截图耗时 " + (f ? f.cap_ms : "—") + " ms · 约 " + (pf.kb != null ? pf.kb : "—") + " KB/帧 · 丢帧 " + (pf.dropped || 0),
      "显示缩放 " + Math.round(WB.cur * 100) + "%(只影响显示,不影响点击坐标) · 页面数 " + (s.pages || 0) + " · 步骤 " + (s.steps || 0),
      "已发送 " + ((s.bytes_sent || 0) / 1024).toFixed(0) + " KB · 被阻止的请求 " + (s.blocked_requests || 0)];
    if (pf.degraded) rows.push("⚠ 性能降级:" + pf.degraded);
    else if (WB.conn === "open" && s.status && s.status !== "idle" && WB.lastArrival && now - WB.lastArrival > 6000) rows.push("ℹ 超过 6 秒没有新画面(页面没有变化,或服务端暂停截图)");
    $("bstat").textContent = rows.join("\n");
  }
  setInterval(() => { if (inBrowserView()) render(true); }, 1000);

  /* ── 连接:断线显示状态并自动重连;重连后服务端先发新截图,旧画面标记为过期 ── */
  window.connectBrowser = function () {
    if (BW && BW.readyState <= 1) return;
    clearTimeout(WB.timer); WB.conn = "connecting";
    let ws; try { ws = new WebSocket((location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws/browser"); } catch (e) { WB.conn = "failed"; return; }
    ws.binaryType = "blob"; BW = ws;
    ws.onopen = () => { WB.conn = "open"; WB.retry = 0; ws.send(JSON.stringify({ type: "open" })); render(true); };
    ws.onmessage = (e) => window.onBrowserMsg(e);
    ws.onerror = () => {};
    ws.onclose = () => {
      if (BW === ws) BW = null; WB.pending = null; $("stage").classList.add("stale");
      if (WB.conn === "open" || WB.conn === "connecting") WB.conn = "closed";
      WB.retry += 1; if (WB.retry > 8) { WB.conn = "failed"; render(true); return; }
      render(true); WB.timer = setTimeout(window.connectBrowser, Math.min(10000, 1000 * Math.pow(2, WB.retry - 1)));
    };
  };
  if (!TH.ctx) { TH.ctx = $("tCanvas").getContext("2d"); TH.trail = $("tTrail").getContext("2d"); TH.ctx.fillStyle = "#0d0f14"; TH.ctx.fillRect(0, 0, 1280, 800); }     // 工作台里也会收到光标事件:画布上下文必须先就绪
  const origShow = window.showTheater;
  window.showTheater = function (c) { if (inBrowserView()) return; return origShow(c); };   // 在浏览器工作台里,工作台自己就是实时画面,不再弹出剧场层

  /* ── 人工接管点击:归一化坐标 + 画面代数(服务端用当前 CSS 视口换算) ── */
  $("stage").addEventListener("click", (e) => {
    if (window.__v12 && window.__v12.active()) return; 
    if (!TAKE || !BW || BW.readyState !== 1) return; const r = $("shot").getBoundingClientRect(); if (!r.width || !r.height) return;
    const nx = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)), ny = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
    BW.send(JSON.stringify({ type: "human", kind: "click", nx, ny, epoch: WB.frame ? WB.frame.epoch : undefined, frame_id: WB.frame ? WB.frame.id : undefined })); $("kbd").focus();
  });

  /* ── 语音 / 文字:与搜索页同一条管线(handleVoiceText → /api/agent/plan → 白名单 → 安全校验 → 真实浏览器) ── */
  const DOCK = ["asrBox", "planBox", "intentBox", "live", "diag"], PH = {};
  DOCK.forEach((id) => { const el = $(id); if (el && el.parentNode) { PH[id] = document.createComment("ph-" + id); el.parentNode.insertBefore(PH[id], el); } });
  function dock(on) { DOCK.forEach((id) => { const el = $(id); if (!el || !PH[id]) return; if (on) $("wbDock").appendChild(el); else if (PH[id].parentNode) PH[id].parentNode.insertBefore(el, PH[id].nextSibling); }); }
  const origVSet = window.vSet;
  window.vSet = function (state, txt, heard, interim) {
    origVSet(state, txt, heard, interim);
    $("wbState").textContent = txt + (heard ? " · " + heard : ""); $("wbMic").classList.toggle("rec", state === "listen"); $("wbMic").setAttribute("aria-pressed", String(state === "listen"));
    $("wbMic").textContent = state === "listen" ? "⏹ 结束" : "🎙 说话"; const eng = $("vEngine").textContent; if (eng) $("wbEngine").textContent = eng;
  };
  async function wbSend(text, src) {
    text = (text || "").trim(); if (!text) return;
    const ctl = /^[\s"“]*(暂停|继续|取消|停止|算了|pause|resume|cancel|stop)(任务|执行|操作|一下)?[\s。.!！]*$/i.exec(text);
    if (ctl) { const k = /暂停|pause/i.test(ctl[1]) ? "pause" : /继续|resume/i.test(ctl[1]) ? "resume" : "cancel"; vSet("idle", "已执行控制指令:" + { pause: "暂停", resume: "继续", cancel: "取消" }[k], "「" + text + "」"); $("cmd").value = ""; await act(k); return; }   // 暂停/继续/取消:不经过模型,立即生效
    CUR_SRC_VOICE = true; $("cmd").value = ""; WB.lastCmd = text;
    await handleVoiceText(text, null, src || "文字指令(浏览器工作台)");
  }
  $("cmdGo").onclick = () => wbSend($("cmd").value);
  $("cmd").addEventListener("keydown", (e) => { if (e.key === "Enter" && !e.isComposing) { e.preventDefault(); wbSend($("cmd").value); } });
  $("wbMic").onclick = () => { CUR_SRC_VOICE = true; toggleVoice(); };
  $("goBtn").onclick = async () => { const r = await post("/api/agent/run", { actions: [{ action: "goto", url: $("goUrl").value }], title: "打开网址" }); if (!r.ok) hint("无法打开:" + (r.error || r._status), true); else hint(""); };
  $("goUrl").addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); $("goBtn").click(); } });
  $("bTake").onclick = async () => { TAKE = !TAKE; $("bTake").setAttribute("aria-pressed", String(TAKE)); $("stage").classList.toggle("take", TAKE); if (TAKE) { await act("pause"); $("kbd").focus(); hint("人工接管:点击画面操作,直接打字(你输入的内容不会被记录,也不会发给 AI)。完成后再点一次「人工接管」,然后点「继续」。"); } else hint(""); };

  /* ── 视觉定位:模型只提议(归一化坐标 + 置信度 + frame ID),你确认后服务端再校验才点击 ── */
  function suggest(msg) { WB.sugg = WB.lastCmd || ""; $("vlOut").innerHTML = '<div class="warnbox">语义定位没成功(' + esc(String(msg).slice(0, 60)) + ')。可以点「👁 视觉定位」让视觉模型看一眼截图(需要云端授权);也可以「人工接管」。</div>'; if (WB.sugg && !$("vlGoal").value) $("vlGoal").value = WB.sugg; }
  async function vlocate() {
    const goal = ($("vlGoal").value || $("cmd").value || "").trim(); if (!goal) { hint("请先描述要点击的目标", true); return; }
    $("vmark").hidden = true;
    $("vlOut").innerHTML = '<div class="mut">👁 正在请求视觉定位…(只发送此刻的一张页面截图)</div><button class="btn" id="vlCancel">取消请求</button>'; $("vlCancel").onclick = () => post("/api/agent/vision_cancel");
    const r = await post("/api/agent/vision_locate", { goal });
    const box = $("vlOut");
    if (r.needs_consent) { box.innerHTML = '<div class="warnbox">' + esc(r.error) + '</div><button class="btn pri" id="vlConsent">授权云端视觉分析并重试</button>'; $("vlConsent").onclick = () => { $("useVision").checked = true; $("useVision").dispatchEvent(new Event("change")); setTimeout(() => { if ($("useVision").checked) vlocate(); }, 1200); }; return; }
    if (!r.ok) { box.innerHTML = '<div class="warnbox">' + esc(r.error || ("HTTP " + r._status)) + "</div>"; return; }
    const p = r.proposal || {}, fr = r.frame || {};
    const meta = "<div class='mut mono'>模型 " + esc(r.model || "?") + " · " + r.ms + "ms · 观察帧 #" + fr.frame_id + " · 截图 " + fr.pw + "×" + fr.ph + " · CSS 视口 " + fr.vw + "×" + fr.vh + " · DPR " + fr.dpr + "</div>";
    if (!r.executable) { box.innerHTML = '<div class="warnbox">' + esc(r.note || "视觉模型不确定,已停止") + "</div>" + (p.found ? "<div class='mut'>候选:" + esc(p.target) + "(置信度 " + (p.confidence != null ? p.confidence.toFixed(2) : "—") + (p.ambiguous ? ",有多个候选" : "") + ")</div>" : "<div class='mut'>" + esc(p.reason || "没有找到目标") + "</div>") + meta; return; }
    const mk = $("vmark"); mk.style.left = (p.nx * 100) + "%"; mk.style.top = (p.ny * 100) + "%"; mk.hidden = false;
    box.innerHTML = "<div class='card'><b>将点击:</b>" + esc(p.target) + "<div class='mut'>置信度 " + p.confidence.toFixed(2) + " · 黄圈就是将要点击的位置(CSS 坐标 " + Math.round(p.nx * fr.vw) + "," + Math.round(p.ny * fr.vh) + ") · 页面变化或超过 20 秒后坐标自动作废</div>" + meta +
      "<div class='row' style='margin-top:6px'><button class='btn pri' id='vlOk'>确认点击</button><button class='btn' id='vlNo'>取消</button></div></div>";
    $("vlNo").onclick = () => { mk.hidden = true; box.innerHTML = ""; };
    $("vlOk").onclick = async () => { mk.hidden = true; const x = await post("/api/agent/run", { actions: [{ action: "click_at", frame_id: fr.frame_id, nx: p.nx, ny: p.ny, confidence: p.confidence, target: p.target }], title: "视觉点击" }); box.innerHTML = x.ok ? '<div class="mut">已提交视觉点击;执行后会核对页面是否真的变化,没变化会暂停。</div>' : '<div class="warnbox">' + esc(x.error || x._status) + "</div>"; };
  }
  $("vlBtn").onclick = vlocate;
