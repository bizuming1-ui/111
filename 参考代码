    need = max(1, int(pause_ms / 10))
    cuts, i, nf = [], 0, len(e)
    while i < nf:                                                   # 找 ≥ pause_ms 的静音段,取段中点
        if silent[i]:
            j = i
            while j < nf and silent[j]:
                j += 1
            if j - i >= need:
                cuts.append(((i + j) // 2) * hop)
            i = j
        else:
            i += 1
    segs, start = [], 0
    lo_len, hi_len, tg = int(min_s * sr), int(max_s * sr), int(target_s * sr)
    while n - start > hi_len:
        cands = [c for c in cuts if start + lo_len <= c <= start + hi_len]
        if cands:
            c = min(cands, key=lambda c: abs(c - (start + tg)))
        else:
            a, b = (start + tg) // hop, (start + hi_len) // hop
            b = min(b, nf)
            c = (a + int(np.argmin(e[a:b]))) * hop if b > a else start + hi_len
        c = max(c, start + lo_len)
        segs.append((start, c))
        start = c
    if n - start < lo_len and segs:                                 # 太短的尾巴并入上一段(≤ max_s + min_s,仍远小于 30 秒)
        segs[-1] = (segs[-1][0], n)
    else:
        segs.append((start, n))
    return segs


def voiced_fraction(x, sr):
    r = _frames_rms(np.asarray(x, np.float32), max(1, int(sr * 0.02)))
    if r.size == 0:
        return 0.0
    thr = max(10 ** (-48 / 20), float(np.percentile(r, 95)) * 0.05)
    return float((r > thr).mean())


def hf_noise_metrics(x, sr):
    """沙沙声(hiss)的客观痕迹:在【安静帧】里统计 6 kHz 以上的功率。启发式、未校准,只做相对比较与告警。
    返回 hf_floor_dbfs(安静帧 6k~Nyquist 的平均每 bin 功率,dBFS)与 hf_ratio(该频段占安静帧总功率的比例)。"""
    x = np.asarray(x, np.float32)
    fr = 1024
    nf = len(x) // fr
    if nf < 4 or sr < 16000:
        return {"hf_floor_dbfs": None, "hf_ratio": None, "quiet_frames": 0}
    f = x[: nf * fr].reshape(nf, fr)
    r = np.sqrt((f ** 2).mean(axis=1))
    top = float(np.percentile(r, 95))
    cand = (r <= np.percentile(r, 30)) & (r <= top * 0.15)                # 比峰值低 ≥16.5dB 的候选帧
    if cand.sum() < 3:
        return {"hf_floor_dbfs": None, "hf_ratio": None, "quiet_frames": int(cand.sum())}
    rdb = 20 * np.log10(np.maximum(r[cand], 1e-7))
    stat = np.abs(rdb - np.median(rdb)) <= 6.0                           # 平稳性:噪声底电平稳定;变化的弱语音/停顿边缘帧被剔除
    if stat.sum() < 3 or stat.mean() < 0.5:                              # 大部分候选帧不平稳 = 没有真停顿(连续语音)→ 不测量,绝不误报
        return {"hf_floor_dbfs": None, "hf_ratio": None, "quiet_frames": int(stat.sum())}
    q = f[cand][stat]
    w = np.hanning(fr)
    sp = np.abs(np.fft.rfft(q * w, axis=1)) ** 2 / (w ** 2).sum()
    k0 = int(6000 / (sr / 2.0) * (sp.shape[1] - 1))
    hf_f = sp[:, k0:].mean(axis=1)                                      # 每个安静帧的 6k+ 平均每 bin 功率
    tot_f = sp.sum(axis=1)
    hf = float(np.median(hf_f))                                         # 中位数:对个别含阶跃/点击的帧稳健
    ratio = float(np.median(sp[:, k0:].sum(axis=1) / np.maximum(tot_f, 1e-14)))
    return {"hf_floor_dbfs": round(10 * math.log10(max(hf, 1e-14)), 1), "hf_ratio": round(ratio, 3), "quiet_frames": int(len(q))}


def segment_quality(x, sr=SR):
    """逐片质量评分(0~100)与「是否可用」。复用 v15.ref_quality,再加:HF 底噪 / 直流 / 有声占比。"""
    x = np.asarray(x, np.float32)
    n = len(x)
    if _v15 is not None and n >= sr:
        q = dict(_v15.ref_quality(x, sr))
    else:
        q = {"score": 0 if n < sr else 60, "reasons": ["短于 1 秒"] if n < sr else [], "seconds": round(n / sr, 2)}
    why = list(q.get("reasons") or [])
    score = float(q.get("score", 0))
    vf = voiced_fraction(x, sr)
    hf = hf_noise_metrics(x, sr)
    dc = float(x.mean()) if n else 0.0
    if vf < 0.25:
        score -= 30
        why.append("有声部分仅 %.0f%%(多为静音/噪声)" % (vf * 100))
    if hf.get("hf_floor_dbfs") is not None and hf["hf_floor_dbfs"] > HF_REF_WARN_DB:
        score -= 10
        why.append("安静处高频底噪偏高(%.0f dBFS/bin,启发式)" % hf["hf_floor_dbfs"])
    if abs(dc) > 0.01:
        score -= 5
        why.append("直流偏移 %.3f" % dc)
    score = max(0.0, min(100.0, score))
    q.update(score=int(round(score)), reasons=why, voiced_frac=round(vf, 3), dc=round(dc, 5), **{k: v for k, v in hf.items() if k != "quiet_frames"})
    q["usable"] = bool(score >= 50 and vf >= 0.25 and q.get("clip_pct", 0) < 0.5 and n >= int(2.0 * sr))
    q["redo"] = score < 60
    return q


# ───────────────────────── M2 多参考:稳健质心 / 复合参考 / 锦标赛晋升 ─────────────────────────
def _l2(v):
    v = np.asarray(v, np.float64)
    return v / max(float(np.linalg.norm(v)), 1e-12)


def robust_centroid(embs, weights=None, mad_k=3.5):
    """说话人向量的稳健质心:L2 归一 → 与中位方向的余弦 → 中位数 + MAD 去离群 → 加权平均 → 再 L2 归一。
    返回 (centroid, keep_mask)。1~2 条时不做去离群。"""
    E = np.stack([_l2(e) for e in embs])
    n = len(E)
    w = np.ones(n) if weights is None else np.asarray(weights, np.float64).clip(1e-6, None)
    keep = np.ones(n, bool)
    if n >= 3:
        med = _l2(np.median(E, axis=0))
        cos = E @ med
        m = float(np.median(cos))
        mad = float(np.median(np.abs(cos - m))) * 1.4826
        mad = max(mad, 0.01)
        keep = cos >= m - mad_k * mad
        if keep.sum() < 2:
            keep = np.ones(n, bool)
    c = _l2((E[keep] * w[keep][:, None]).sum(axis=0))
    return c, keep


def cosine(a, b):
    return float(np.dot(_l2(a), _l2(b)))


def sample_rank_score(s):
    """库里一条样本的排序分:v16 质检分(若有) > v15 质检 > 默认。"""
    v = (s.get("v16") or {})
    if "score" in v:
        return float(v["score"])
    qc = s.get("qc") or {}
    rq = qc.get("ref_quality") or qc.get("quality") or {}
    if isinstance(rq, dict) and "score" in rq:
        return float(rq["score"])
    return 70.0 if not qc.get("blocking") else 0.0


def select_composite_members(samples, max_total_s=20.0, max_k=6, min_score=50.0, prefer_id=None):
    """从语音库样本里挑「复合参考」成员:口语 + 已启用 + 文字已核对 + 质检未阻断 + 分数 ≥ min_score;按分数降序贪心装入 ≤ max_total_s 秒。
    返回 [(sample, weight)]。不足 2 条时返回空(调用方退回 v15 的单条参考,行为不变)。"""
    pool = []
    for s in samples:
        if s.get("category") != "speech" or s.get("enabled") is False:
            continue
        if not s.get("text_trusted") or (s.get("qc") or {}).get("blocking"):
            continue
        sc = sample_rank_score(s)
        if sc < min_score:
            continue
        pool.append((sc, s))
    pool.sort(key=lambda t: (0 if (prefer_id and t[1].get("sample_id") == prefer_id) else 1, -t[0], t[1].get("sample_id", "")))      # 用户指定的主参考排第一(仍须通过筛选)
    out, tot = [], 0.0
    for sc, s in pool:
        d = float(s.get("duration_s") or 0.0)
        if d <= 0 or d > max_total_s:
            continue
        if tot + d > max_total_s or len(out) >= max_k:
            continue
        out.append((s, float(s.get("weight") or 1.0) * sc / 100.0))
        tot += d
    return out if len(out) >= 2 else []


def _voiced_rms(a):
    r = _frames_rms(a, 480)
    if r.size == 0:
        return 1e-4
    v = r[r > max(1e-4, float(np.percentile(r, 90)) * 0.1)]
    return float(np.sqrt((v ** 2).mean())) if v.size else 1e-4


def _floor_rms(a):
    r = _frames_rms(a, 480)
    return float(np.percentile(r, 10)) if r.size else 1e-4


def _punct(t):
    t = (t or "").strip()
    if not t:
        return ""
    if t[-1] in "。！？.!?…;；,，":
        return t
    cjk = any("\u4e00" <= ch <= "\u9fff" for ch in t[-4:])
    return t + ("。" if cjk else ".")


def build_composite(items, sr=SR, gap_ms=150, max_total_s=20.0, peak=0.7, seed=0):
    """items = [{"audio": float32 单声道(已是 sr), "text": str, "sample_id": str}](已按优先级排好)。
    电平对齐到中位有声 RMS(增益限制在 0.5~2 倍)→ 用与两侧底噪匹配的舒适噪声连接(首尾淡化,绝不插数字零)→ 整体峰值归一到 peak(参考电平约定 0.7)。
    确定性(同输入同种子 = 同输出)。返回 (audio, text, members, seconds)。"""
    rng = np.random.default_rng(seed)
    items = [it for it in items if it.get("audio") is not None and len(it["audio"]) > 0]
    if not items:
        return np.zeros(0, np.float32), "", [], 0.0
    rmss = [_voiced_rms(it["audio"]) for it in items]
    tgt = float(np.median(rmss))
    parts, texts, members, tot = [], [], [], 0
    for i, it in enumerate(items):
        a = np.asarray(it["audio"], np.float32)
        a = a - float(a.mean())
        g = min(2.0, max(0.5, tgt / max(rmss[i], 1e-6)))
        a = a * g
        if parts and tot + len(a) + int(gap_ms * sr / 1000) > int(max_total_s * sr):
            continue
        if parts:
            ng = int(gap_ms * sr / 1000)
            lvl = min(_floor_rms(parts[-1]), _floor_rms(a))
            noise = rng.standard_normal(ng + 2).astype(np.float32)
            noise = (noise[:-2] + noise[1:-1] + noise[2:]) / 3.0                       # 三点低通:舒适噪声偏低频,不是白噪声
            noise *= lvl / max(float(np.sqrt((noise ** 2).mean())), 1e-9)
            f = max(1, int(0.01 * sr))
            noise[:f] *= np.linspace(0, 1, f, dtype=np.float32)
            noise[-f:] *= np.linspace(1, 0, f, dtype=np.float32)
            parts.append(noise)
            tot += ng
        e = max(1, int(0.005 * sr))                                                     # 片段两端 5ms 淡入淡出,避免拼接点跳变
        a = a.copy()
        a[:e] *= np.linspace(0, 1, e, dtype=np.float32)
        a[-e:] *= np.linspace(1, 0, e, dtype=np.float32)
        parts.append(a)
        tot += len(a)
        texts.append(_punct(it.get("text", "")))
        members.append(it.get("sample_id", str(i)))
    y = np.concatenate(parts)
    pk = float(np.abs(y).max())
    if pk > 1e-4:
        y = y * (peak / pk)
    sep = "" if any("\u4e00" <= ch <= "\u9fff" for ch in "".join(texts)) else " "
    return y.astype(np.float32), sep.join(t for t in texts if t), members, round(len(y) / sr, 2)


def composite_key(members, texts_sha=""):
    """复合参考的缓存键:成员 id + 各自处理版 sha256(成员变化 → 键变化 → 重建)。"""
    return hashlib.sha256(("|".join(members) + "#" + texts_sha).encode()).hexdigest()[:16]


def tournament_promote(base, chal, margin=0.01, n_boot=2000, seed=0):
    """配对 bootstrap 晋升规则:同一批探针句上,挑战者相对基线的平均提升 ≥ margin,且 bootstrap 5% 分位 > 0,才晋升。
    base / chal 为等长分数序列(越大越好)。数据太少(<5 对)一律拒绝并说明原因(宁可不换)。"""
    b, c = np.asarray(base, np.float64), np.asarray(chal, np.float64)
    if len(b) != len(c) or len(b) < 5:
        return {"promote": False, "reason": "探针对数不足(<5)或长度不一致,拒绝晋升", "n": int(min(len(b), len(c)))}
    d = c - b
    rng = np.random.default_rng(seed)
    idx = rng.integers(0, len(d), size=(n_boot, len(d)))
    means = d[idx].mean(axis=1)
    lo = float(np.percentile(means, 5))
    ok = bool(d.mean() >= margin and lo > 0)
    return {"promote": ok, "mean_gain": round(float(d.mean()), 4), "ci5": round(lo, 4), "n": int(len(d)),
            "reason": "挑战者显著更好" if ok else "提升未达 margin 或置信下界 ≤ 0,保持基线"}


# ───────────────────────── M3 增量再优化计划 ─────────────────────────
def plan_incremental(old_ids, new_ids, replay_ratio=1.0, base_lr=1e-4, lr_scale=0.4, parent=None, seed=0, max_total=None):
    """新样本 + 旧样本回放(防灾难性遗忘):回放数 = min(len(old), round(replay_ratio × len(new)))(确定性抽样)。
    学习率 = base_lr × lr_scale(夹到 0.3~0.5);没有新样本 → noop;没有旧样本/父检查点 → 退化为全量训练。"""
    old = list(dict.fromkeys(old_ids))
    oldset = set(old)
    new = [i for i in dict.fromkeys(new_ids) if i not in oldset]
    if not new:
        return {"mode": "noop", "reason": "没有新增样本", "train_ids": list(old), "replay_ids": [], "new_ids": [], "lr": base_lr, "parent": parent}
    if not old or not parent:
        ids = old + new
        return {"mode": "full", "reason": "没有已晋升的父检查点或旧样本:全量训练", "train_ids": ids, "replay_ids": old, "new_ids": new, "lr": base_lr, "parent": None}
    k = min(len(old), int(round(float(replay_ratio) * len(new))))
    rng = np.random.default_rng(seed)
    pick = sorted(rng.choice(len(old), size=k, replace=False).tolist()) if k else []
    replay = [old[i] for i in pick]
    ids = new + replay
    if max_total and len(ids) > max_total:
        ids = new[:max_total] + replay[: max(0, max_total - len(new))]
    return {"mode": "incremental", "reason": "新 %d + 回放 %d" % (len(new), len(replay)), "train_ids": ids, "replay_ids": replay, "new_ids": new,
            "lr": float(base_lr) * float(min(0.5, max(0.3, lr_scale))), "parent": parent}


# ───────────────────────── M4 校准相似度(诚实) ─────────────────────────
def same_speaker_calibration(sims):
    """sims = 该说话人【不同真实片段对】的相似度。≥ 8 对才算校准;否则 not_calibrated(界面不显示百分比)。"""
    s = np.asarray([float(v) for v in sims if v is not None and np.isfinite(v)], np.float64)
    if len(s) < 8:
        return {"status": "not_calibrated", "n": int(len(s)), "reason": "同说话人真实片段对不足 8 对"}
    return {"status": "calibrated", "n": int(len(s)), "p05": round(float(np.percentile(s, 5)), 4), "p25": round(float(np.percentile(s, 25)), 4),
            "p50": round(float(np.percentile(s, 50)), 4), "min": round(float(s.min()), 4)}


def judge_similarity(score, cal):
    if not cal or cal.get("status") != "calibrated" or score is None:
        return {"verdict": "not_calibrated", "note": "没有校准:不显示相似度百分比;请用 /abx 盲测裁决"}
    if score >= cal["p50"]:
        v = "within_same_speaker_median"
    elif score >= cal["p05"]:
        v = "within_same_speaker_range"
    else:
        v = "below_same_speaker_range"
    return {"verdict": v, "score": round(float(score), 4), "p05": cal["p05"], "p50": cal["p50"]}


# ───────────────────────── M5 音质守护(条件式,干净语音 = 原对象) ─────────────────────────
DC_FIX_THRESHOLD = 0.003
HF_REF_WARN_DB = -62.0      # 参考语音安静处 6kHz 以上每 bin 底噪 > 此值才扣分(启发式,未校准;正常麦克风底噪 ≈ -70 以下不扣)
HF_OUT_WARN_DB = -58.0      # 输出音频同指标 > 此值才报「疑似沙沙声」(启发式,未校准)


def dc_fix_if_needed(x, thr=None):
    """仅当整段直流偏移 |mean| > thr(默认 0.003 ≈ -50dBFS)才扣除;否则原样返回同一个对象(逐样本一致)。返回 (x, fixed)。"""
    thr = DC_FIX_THRESHOLD if thr is None else thr
    if len(x) == 0:
        return x, False
    m = float(np.mean(x))
    if abs(m) <= thr:
        return x, False
    return (np.asarray(x, np.float32) - np.float32(m)), True


def audio_guard_report(pcm, sr=SR):
    """对一段【实际发给浏览器的 PCM】做 v16 取证:v15.analyze(零段/click/削波/真峰值) + HF 底噪 + 直流。"""
    x = np.asarray(pcm)
    xf = x.astype(np.float32) / 32768.0 if x.dtype.kind in "iu" else x.astype(np.float32)
    rep = dict(_v15.analyze(pcm, sr)) if _v15 is not None else {"problems": []}
    hf = hf_noise_metrics(xf, sr)
    rep.update(hf_floor_dbfs=hf["hf_floor_dbfs"], hf_ratio=hf["hf_ratio"], dc16=round(float(xf.mean()), 5) if len(xf) else 0.0)
    probs = list(rep.get("problems") or [])
    if abs(rep["dc16"]) > 0.01:
        probs.append("直流偏移 %.3f" % rep["dc16"])
    if hf["hf_floor_dbfs"] is not None and hf["hf_floor_dbfs"] > HF_OUT_WARN_DB:
        probs.append("疑似沙沙声:安静处 6kHz 以上底噪 %.0f dBFS/bin(启发式,未校准)" % hf["hf_floor_dbfs"])
    rep["problems"], rep["ok"] = probs, not probs
    return rep


