WORKLET_JS = r'''/* Voice Clone Studio - AudioWorklet
 *  - vc-player : 无缝流式播放器(抖动缓冲 + 保音高弹性放慢 WSOLA)。缓冲吃紧时"放慢"而不是"停住"。
 *  - vc-rec    : 麦克风录音(把 Float32 帧发回主线程)
 * PlayerCore 不依赖 Web Audio, 可以在 Node 里单元测试。
 */
"use strict";

class PlayerCore {
  constructor(sr, post) {
    this.sr = sr;
    this.post = post || function () {};
    this.N = 2 * Math.round(sr * 0.020);        // WSOLA 窗口 40ms
    this.Hs = this.N >> 1;                      // 合成步长 20ms
    this.D = Math.round(sr * 0.012);            // 相似度搜索半径 ±12ms
    this.win = new Float32Array(this.N);
    for (let i = 0; i < this.N; i++) this.win[i] = 0.5 - 0.5 * Math.cos(2 * Math.PI * i / this.N);  // 周期 Hann: 50% 重叠和恒为 1
    this.data = new Float32Array(sr * 20);
    this.ola = new Float32Array(this.Hs);
    this.outBuf = new Float32Array(this.Hs);
    this.cfg = { startMs: 300, hiMs: 300, loMs: 110, rebufMs: 700, rhoMin: 0.62, stretch: true };
    this.reset();
  }

  reset() {
    this.data.fill(0);
    this.wr = 0; this.prevS = 0; this.a = 0; this.resumePos = 0; this.primed = false;
    this.outPos = 0; this.outLen = 0; this.finishing = false;
    this.mode = "idle"; this.ended = false; this.rho = 1;
    this.rebufNow = this.cfg.rebufMs;
    this.fadeIn = 0; this.flushing = false; this.fadeLeft = 0; this.statCnt = 0; this.started = false;
  }

  open(cfg) { if (cfg) Object.assign(this.cfg, cfg); this.reset(); this.mode = "buffering"; }
  end() { this.ended = true; }

  push(f32) {
    if (this.mode === "idle" || this.flushing) return;
    const n = f32.length;
    if (!n) return;
    if (this.wr + n + 4 * this.N > this.data.length) {
      const nd = new Float32Array(Math.max(this.data.length * 2, this.wr + n + 4 * this.N + this.sr));
      nd.set(this.data.subarray(0, this.wr));
      this.data = nd;
    }
    this.data.set(f32, this.wr);
    this.wr += n;
  }

  flush() {
    if (this.mode === "idle") return;
    if (this.mode !== "playing" || this.outPos >= this.outLen) { this.reset(); this.post({ t: "flushed" }); return; }
    this.flushing = true; this.fadeLeft = 480;     // 10ms 淡出再清空,避免"啪"声
  }

  level() {                                          // 尚未消耗的输入量(ms)
    const p = this.primed ? this.prevS + this.Hs : this.resumePos;
    return Math.max(0, this.wr - p) * 1000 / this.sr;
  }

  updateRate() {
    const c = this.cfg;
    let t = 1;
    if (c.stretch && !this.ended) {
      const lv = this.level();
      if (lv >= c.hiMs) t = 1;
      else if (lv <= c.loMs) t = c.rhoMin;
      else t = c.rhoMin + (1 - c.rhoMin) * (lv - c.loMs) / (c.hiMs - c.loMs);
    }
    const step = 0.03;
    if (this.rho < t) this.rho = Math.min(t, this.rho + step);
    else if (this.rho > t) this.rho = Math.max(t, this.rho - step);
  }

  // 产出下一个 20ms 的输出块。返回 0=成功 1=数据不足 2=已全部播完
  hop() {
    const N = this.N, Hs = this.Hs, D = this.D, w = this.win, d = this.data;
    if (!this.primed) {
      const p = this.resumePos;
      if (this.ended && p >= this.wr) return 2;
      if (!this.ended && this.wr - p < N) return 1;
      this.prevS = p - Hs; this.a = p;
      for (let i = 0; i < Hs; i++) this.ola[i] = w[Hs + i] * d[p + i];
      this.primed = true;
      this.fadeIn = Math.round(0.004 * this.sr);
    }
    this.updateRate();
    const sNat = this.prevS + Hs;                    // 上一帧的"自然延续"位置
    let s;
    if (this.rho >= 0.999) {
      s = sNat; this.a = s;
      if (!this.ended && s + N > this.wr) return 1;
    } else {
      const a2 = this.a + Hs * this.rho;
      const c = Math.round(a2);
      const lo = Math.max(c - D, 0);
      let hi = c + D;
      if (!this.ended) hi = Math.min(hi, this.wr - N);
      if (hi < lo) return 1;
      this.a = a2;
      let best = Infinity; s = lo;
      for (let c2 = lo; c2 <= hi; c2++) {            // 在 ±D 内找与"自然延续"最像的起点(绝对差之和最小)
        let sad = 0;
        for (let k = 0; k < Hs; k += 2) { const df = d[c2 + k] - d[sNat + k]; sad += df < 0 ? -df : df; }
        if (sad < best) { best = sad; s = c2; }
      }
    }
    const ob = this.outBuf;
    if (this.ended && s >= this.wr) {                // 输入耗尽: 把残留的淡出尾巴送出去
      ob.set(this.ola); this.outPos = 0; this.outLen = Hs;
      this.finishing = true; this.primed = false; this.resumePos = this.wr;
      return 0;
    }
    for (let i = 0; i < Hs; i++) {
      ob[i] = this.ola[i] + w[i] * d[s + i];
      this.ola[i] = w[Hs + i] * d[s + Hs + i];
    }
    this.prevS = s; this.outPos = 0; this.outLen = Hs;
    if (this.prevS > 8 * this.sr) {                  // 回收已播放部分的内存
      const sh = this.prevS - this.sr;
      d.copyWithin(0, sh, this.wr);
      d.fill(0, this.wr - sh, this.wr);
      this.wr -= sh; this.prevS -= sh; this.a -= sh; this.resumePos -= sh;
    }
    return 0;
  }

  starve() {                                         // 数据真的不够了: 淡出 -> 重新缓冲(绝不在半途硬切)
    if (this.primed) {
      this.outBuf.set(this.ola); this.outPos = 0; this.outLen = this.Hs;
      this.primed = false; this.resumePos = this.prevS + this.Hs;
    }
    this.mode = "rebuffer";
    this.rho = 1;
    this.rebufNow = Math.min(8000, this.rebufNow * 1.6);     // 每断一次就把重新起播的缓冲加大,断流会越来越少
    if (this.started) this.post({ t: "underrun" });
  }

  finishNow() {
    this.reset();
    this.post({ t: "drained" });
  }

  render(out) {
    const n = out.length;
    let i = 0;
    if (this.mode === "buffering") {
      if (this.level() >= this.cfg.startMs || (this.ended && this.wr > 0)) this.mode = "playing";
      else if (this.ended) { this.finishNow(); }
    } else if (this.mode === "rebuffer") {
      if (this.level() >= this.rebufNow || (this.ended && this.wr > this.resumePos)) this.mode = "playing";
      else if (this.ended && this.outPos >= this.outLen) this.finishNow();
    }
    while (i < n) {
      if (this.outPos < this.outLen) {
        const m = Math.min(n - i, this.outLen - this.outPos);
        const ob = this.outBuf;
        for (let k = 0; k < m; k++) {
          let v = ob[this.outPos++];
          if (this.fadeIn > 0) { v *= 1 - this.fadeIn / (0.004 * this.sr); this.fadeIn--; }
          if (this.flushing) {
            v *= this.fadeLeft / 480;
            if (--this.fadeLeft <= 0) { out[i + k] = v; i += k + 1; this.reset(); this.post({ t: "flushed" }); out.fill(0, i); return; }
          }
          out[i + k] = v;
        }
        i += m;
      } else if (this.mode === "playing") {
        if (this.finishing) { this.finishNow(); continue; }
        const r = this.hop();
        if (r === 1) { this.starve(); if (this.outPos >= this.outLen) { out.fill(0, i); i = n; } continue; }
        if (r === 2) { this.finishNow(); continue; }
        if (!this.started) { this.started = true; this.post({ t: "started" }); }
      } else {
        out.fill(0, i); i = n;
      }
    }
    this.statCnt += n;
    if (this.statCnt >= this.sr / 10) {
      this.statCnt = 0;
      const rem = (this.outLen - this.outPos) * 1000 / this.sr;
      this.post({ t: "stat", ms: this.level() + rem, rho: this.rho, mode: this.mode });
    }
  }
}

