#  声学摘要
# ════════════════════════════════════════════════════════════════
def _f0_track(x, sr, fmin, fmax, hop=0.010, win=0.040):
    """基于归一化自相关的简易基频跟踪(向量化)。返回 f0(Hz, 无声=0), 帧能量 dB"""
    h, w = int(sr * hop), int(sr * win)
    n = 1 + max(0, (len(x) - w) // h)
    if n < 3:
        return np.zeros(0), np.zeros(0)
    idx = np.arange(w)[None, :] + h * np.arange(n)[:, None]
    fr = x[idx].astype(np.float32)
    fr -= fr.mean(axis=1, keepdims=True)
    e = np.sqrt((fr ** 2).mean(axis=1) + 1e-12)
    edb = 20 * np.log10(e + 1e-9)
    nfft = 1 << (2 * w - 1).bit_length()
    spec = np.fft.rfft(fr * np.hanning(w)[None, :], nfft, axis=1)
    ac = np.fft.irfft(np.abs(spec) ** 2, nfft, axis=1)[:, :w]
    ac = ac / (ac[:, :1] + 1e-9)
    lo, hi = int(sr / fmax), min(int(sr / fmin), w - 1)
    seg = ac[:, lo:hi]
    k = seg.argmax(axis=1)
    pk = seg[np.arange(n), k]
    f0 = sr / (k + lo)
    thr_e = np.percentile(edb, 90) - 30
    voiced = (pk > 0.40) & (edb > thr_e)
    return np.where(voiced, f0, 0.0), edb


def acoustic_summary(x, sr=SR, text=None, kind="speech"):
    """x: float32/int16 单声道。kind='singing' 时音高范围放宽,且不给出"语速"(歌唱的节奏不能当说话语速)。"""
    x = np.asarray(x)
    if x.dtype.kind == "i":
        x = x.astype(np.float32) / 32768.0
    x = x.astype(np.float32).reshape(-1)
    out = {"kind": kind, "dur_s": round(len(x) / sr, 3)}
    if len(x) < sr * 0.5:
        out["error"] = "音频太短"
        return out
    f0, edb = _f0_track(x, sr, 60.0, 900.0 if kind == "singing" else 420.0)
    if f0.size == 0:
        out["error"] = "音频太短"
        return out
    act = edb > (np.percentile(edb, 95) - 35)                     # 有效发声帧(相对能量)
    idx = np.where(act)[0]
    if idx.size == 0:
        out["error"] = "无有效语音"
        return out
    a0, a1 = idx[0], idx[-1] + 1
    hop = 0.010
    active_s = (a1 - a0) * hop
    out["active_s"] = round(active_s, 3)
    # 停顿:有效区间内连续 ≥150ms 的非发声帧
    run, pauses = 0, []
    for v in act[a0:a1]:
        if not v:
            run += 1
        else:
            if run * hop >= 0.15:
                pauses.append(run * hop)
            run = 0
    out["pause_count"] = len(pauses)
    out["pause_mean_s"] = round(float(np.mean(pauses)), 3) if pauses else 0.0
    out["pause_ratio"] = round(float(sum(pauses) / max(active_s, 1e-6)), 3)
    if text and kind != "singing":
        chars = sum(1 for c in text if c.isalnum() or "\u4e00" <= c <= "\u9fff")
        out["chars"] = chars
        out["chars_per_s"] = round(chars / max(active_s, 1e-6), 3)
        out["chars_per_s_no_pause"] = round(chars / max(active_s - sum(pauses), 1e-6), 3)
    v = f0[f0 > 0]
    out["voiced_ratio"] = round(float(v.size / max(f0.size, 1)), 3)
    if v.size >= 10:
        st = 12 * np.log2(v / 55.0)
        out["f0_median_hz"] = round(float(np.median(v)), 1)
        out["f0_p10_hz"], out["f0_p90_hz"] = round(float(np.percentile(v, 10)), 1), round(float(np.percentile(v, 90)), 1)
        out["f0_range_st"] = round(float(np.percentile(st, 90) - np.percentile(st, 10)), 2)
        out["f0_std_st"] = round(float(st.std()), 2)
    ed = edb[act]
    out["loud_p10_db"], out["loud_p90_db"] = round(float(np.percentile(ed, 10)), 1), round(float(np.percentile(ed, 90)), 1)
    out["loud_range_db"] = round(out["loud_p90_db"] - out["loud_p10_db"], 1)
    out["peak_dbfs"] = round(db(float(np.abs(x).max())), 2)
    seg = x[int(a0 * hop * sr): int(a1 * hop * sr)]
    if seg.size > 2048:
        n = len(seg) // 1024
        sp = np.abs(np.fft.rfft(seg[: n * 1024].reshape(n, 1024) * np.hanning(1024)[None, :], axis=1)) + 1e-9
        fr = np.fft.rfftfreq(1024, 1.0 / sr)
        pw = sp.mean(axis=0)
        out["centroid_hz"] = round(float((fr * pw).sum() / pw.sum()), 1)
        cs = np.cumsum(pw) / pw.sum()
        out["rolloff85_hz"] = round(float(fr[min(np.searchsorted(cs, 0.85), len(fr) - 1)]), 1)
        out["flatness"] = round(float(np.exp(np.log(sp).mean(axis=1)).mean() / sp.mean(axis=1).mean()), 4)
    return out


def compare_summaries(ref, gen):
    """参考 vs 生成的差异(只比较两侧都有的指标;歌声参考不与口语生成比较音高/语速)"""
    if not ref or not gen or ref.get("error") or gen.get("error"):
        return {"note": "缺少可比较的摘要"}
    if ref.get("kind") == "singing":
        return {"note": "参考是歌声:音高 / 语速 / 节奏不能作为口语生成的目标,不做差异比较(歌声克隆未验证)"}
    d = {}
    if ref.get("chars_per_s") and gen.get("chars_per_s"):
        d["rate_ratio"] = round(gen["chars_per_s"] / ref["chars_per_s"], 3)
    if "pause_ratio" in ref and "pause_ratio" in gen:
        d["pause_ratio_diff"] = round(gen["pause_ratio"] - ref["pause_ratio"], 3)
        d["pause_mean_diff_s"] = round(gen["pause_mean_s"] - ref["pause_mean_s"], 3)
    if ref.get("f0_median_hz") and gen.get("f0_median_hz"):
        d["f0_median_diff_st"] = round(12 * math.log2(gen["f0_median_hz"] / ref["f0_median_hz"]), 2)
    if ref.get("f0_range_st") is not None and gen.get("f0_range_st") is not None:
        d["f0_range_diff_st"] = round(gen["f0_range_st"] - ref["f0_range_st"], 2)
    if "loud_range_db" in ref and "loud_range_db" in gen:
        d["loud_range_diff_db"] = round(gen["loud_range_db"] - ref["loud_range_db"], 1)
    if ref.get("centroid_hz") and gen.get("centroid_hz"):
        d["centroid_ratio"] = round(gen["centroid_hz"] / ref["centroid_hz"], 3)
    return d


# ════════════════════════════════════════════════════════════════
#  参考音频质检(启发式)
# ════════════════════════════════════════════════════════════════
def reference_qc(x, sr, orig_sr=None, channels=1, text=None):
    x = np.asarray(x, np.float32).reshape(-1)
    dur = len(x) / sr
    q = {"duration_s": round(dur, 2), "orig_sr": int(orig_sr or sr), "channels": int(channels), "sr": int(sr),
         "heuristic": True, "warnings": [], "kind": "unknown", "kind_zh": "无法判定", "blocking": False}
    if dur < 0.5:
        q.update(blocking=True)
        q["warnings"].append("音频不足 0.5 秒")
        return q
    fr = int(sr * 0.025)
    r = frame_rms(x, fr)
    edb = 20 * np.log10(r + 1e-6)
    speech_lvl, floor_lvl = float(np.percentile(edb, 90)), float(np.percentile(edb, 10))
    snr = speech_lvl - floor_lvl
    q.update(peak_dbfs=round(db(float(np.abs(x).max())), 2), clip_ratio=round(float((np.abs(x) >= 0.99).mean()), 5),
             silence_ratio=round(float((edb < speech_lvl - 35).mean()), 3), snr_db_est=round(snr, 1), floor_dbfs=round(floor_lvl, 1))
    # 底噪帧的"调性":背景音乐 / 持续音的频谱平坦度很低,白噪声接近 1
    quiet = np.argsort(edb)[: max(4, len(edb) // 5)]
    flats = []
    for k in quiet[:40]:
        seg = x[k * fr:(k + 1) * fr]
        if seg.size < fr:
            continue
        sp = np.abs(np.fft.rfft(seg * np.hanning(fr))) + 1e-9
        flats.append(float(np.exp(np.log(sp).mean()) / sp.mean()))
    floor_flat = float(np.mean(flats)) if flats else 1.0
    q["floor_flatness"] = round(floor_flat, 3)
    f0, e2 = _f0_track(x, sr, 60.0, 900.0)
    voiced = f0 > 0
    q["voiced_s"] = round(float(voiced.sum() * 0.010), 2)
    sustain = 0.0
    if voiced.sum() >= 20:
        st = np.where(voiced, 12 * np.log2(np.maximum(f0, 1.0) / 55.0), np.nan)
        run, keep = [], 0
        for i in range(len(st)):
            if np.isnan(st[i]):
                if len(run) >= 30 and (max(run) - min(run)) < 1.0:
                    keep += len(run)
                run = []
            else:
                run.append(st[i])
                if max(run) - min(run) >= 1.0:                 # 音高漂出 1 个半音:不是持续音符
                    if len(run) - 1 >= 30:
                        keep += len(run) - 1
                    run = [st[i]]
        if len(run) >= 30 and (max(run) - min(run)) < 1.0:
            keep += len(run)
        sustain = keep / voiced.sum()
    q["note_sustain_ratio"] = round(float(sustain), 3)
    kind, zh = "clean_speech", "清晰口语"
    if q["voiced_s"] < 0.8:
        kind, zh = "unknown", "无法判定(有声部分太少)"
    elif sustain > 0.40:
        kind, zh = "singing", "疑似歌声(持续音符比例高)"
    elif snr < 20 and floor_flat < 0.18 and floor_lvl > -55:
        kind, zh = "bg_music", "疑似带背景音乐/持续音"
    elif snr < 15:
        kind, zh = "noisy", "噪声较大"
    q["kind"], q["kind_zh"] = kind, zh
    w = q["warnings"]
    if dur < 3:
        w.append("时长不足 3 秒,克隆稳定性差(建议 8~20 秒)")
    elif dur < 6:
        w.append("时长偏短(建议 8~20 秒)")
    if dur > 30:
        w.append("时长超过 30 秒,已在能量最低处截取前段")
    if q["clip_ratio"] > 0.005:
        w.append("有削波(%.2f%%),请降低录音增益" % (q["clip_ratio"] * 100))
    if q["silence_ratio"] > 0.5:
        w.append("静音占比过高(%.0f%%)" % (q["silence_ratio"] * 100))
    if snr < 20 and kind == "clean_speech":
        w.append("信噪比估计偏低(%.0f dB)" % snr)
    if kind == "singing":
        w.append("歌声:口语克隆流程对歌声【未验证/不支持】,请提供清晰口语样本;歌声需单独标记与管理")
    if kind == "bg_music":
        w.append("背景音乐会被当成声音特征。请使用无伴奏的原声;人声分离结果必须再质检,分离伪影可能被误认为说话人特征")
    if text is not None and kind == "clean_speech" and text.strip():
        cps = len([c for c in text if c.isalnum() or "\u4e00" <= c <= "\u9fff"]) / max(q["voiced_s"], 0.1)
        q["text_chars_per_voiced_s"] = round(cps, 2)
        if cps > 9 or cps < 1.2:
            w.append("参考文字与音频时长不匹配(%.1f 字/秒),请核对文字是否与录音严格对应" % cps)
    q["blocking"] = kind in ("singing", "bg_music", "noisy", "unknown") or q["clip_ratio"] > 0.02 or dur < 3
    return q


