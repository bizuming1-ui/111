                # 中心 / 四角 / 边缘:归一化坐标 → Playwright CSS 坐标(被页面真实收到的 clientX/clientY 必须一致)
                pts = [(0.5, 0.5), (0.01, 0.01), (0.99, 0.01), (0.01, 0.99), (0.99, 0.99), (0.5, 0.0), (0.0, 0.5)]
