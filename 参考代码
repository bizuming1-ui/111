@app.websocket("/ws")
async def ws_endpoint(ws: WebSocket):
    await ws.accept()
    sess = Session(ws)
    SESSIONS.add(sess)

    async def sender():
        try:
            while True:
                m = await sess.q.get()
                if isinstance(m, (bytes, bytearray)):
                    await ws.send_bytes(m)
                else:
                    await ws.send_text(m)
        except Exception:  # noqa: BLE001
            pass

    st = asyncio.get_running_loop().create_task(sender())
    sess.send(state_public())
    try:
        while True:
            raw = await ws.receive_text()
            try:
                m = json.loads(raw)
            except ValueError:
                continue
            k = m.get("type")
            if k == "ping":
                sess.send({"type": "pong", "t": m.get("t")})
            elif k == "chat":
                txt = str(m.get("text") or "").strip()
                if txt:
                    start_turn(sess, txt[:4000], m.get("opts") or {}, m.get("ref"))
            elif k == "say":
                txt = str(m.get("text") or "").strip()
                if txt:
                    o = dict(m.get("opts") or {})
                    o["tts"] = True
                    start_turn(sess, txt[:3000], o, m.get("ref"), say_only=True)
            elif k == "stop":
                cancel_turn(sess)
                sess.send({"type": "stopped"})
            elif k == "reset":
                cancel_turn(sess)
                sess.history = []
                sess.send({"type": "reset_ok"})
    except WebSocketDisconnect:
        pass
    except Exception as e:  # noqa: BLE001
        log.info("ws 结束: %s", e)
    finally:
        cancel_turn(sess)
        SESSIONS.discard(sess)
        st.cancel()


async def gpu_loop():
    while True:
        await asyncio.sleep(2.0)
        if not SESSIONS or POOL is None:
            continue
        try:
            if not MOCK:
                p = await asyncio.create_subprocess_exec("nvidia-smi", "--query-gpu=index,memory.used,memory.total,utilization.gpu",
                                                         "--format=csv,noheader,nounits", stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
                out, _ = await asyncio.wait_for(p.communicate(), 5)
                rows = {}
                for line in out.decode().strip().splitlines():
                    f = [x.strip() for x in line.split(",")]
                    if len(f) >= 4:
                        rows[int(f[0])] = (float(f[1]) / 1024, float(f[2]) / 1024, int(float(f[3])))
                for w in POOL.workers:
                    if int(w.gpu) in rows:
                        w.mem = rows[int(w.gpu)]
            else:
                for w in POOL.workers:
                    w.mem = (5.5 + w.idx, 15.0, 40 + 20 * w.idx)
        except Exception:  # noqa: BLE001
            pass
        broadcast(state_public())


def restore_voice():
    """重启后自动恢复上一次克隆的声音;或使用脚本里指定的默认参考音频。"""
    try:
        f = VOICE_DIR / "current.json"
        if f.exists():
            j = json.loads(f.read_text(encoding="utf-8"))
            if Path(j["path"]).exists():
                log.info("恢复上一次的克隆声音: %s", j["path"])
                start_clone(j["path"], j.get("text", ""), bool(j.get("xvec")))
                return
        ra = os.environ.get("VC_REF_AUDIO")
        if ra and Path(ra).exists():
            log.info("使用默认参考音频: %s", ra)
            start_clone(ra, os.environ.get("VC_REF_TEXT", "").strip(), False)
    except Exception as e:  # noqa: BLE001
        log.warning("恢复声音失败: %s", e)


@app.on_event("startup")
async def _startup():
    global LOOP
    LOOP = asyncio.get_running_loop()
    if POOL is not None:
        threading.Thread(target=reader_thread, args=(LOOP,), daemon=True).start()
        LOOP.create_task(gpu_loop())
        restore_voice()


def detect_gpus():
    env = os.environ.get("VC_GPUS")
    if env:
        return [x.strip() for x in env.split(",") if x.strip()]
    if MOCK:
        return ["0", "1"]
    try:
        out = subprocess.run(["nvidia-smi", "-L"], capture_output=True, text=True, timeout=15).stdout
        n = len([ln for ln in out.splitlines() if ln.startswith("GPU ")])
        return [str(i) for i in range(n)]
    except Exception:  # noqa: BLE001
        return []


def main():
    global POOL
    VOICE_DIR.mkdir(parents=True, exist_ok=True)
    gpus = detect_gpus()
    log.info("检测到 GPU: %s | 模型: %s | mock=%s", gpus or "无", MODEL, MOCK)
    if not gpus:
        log.error("⚠ 没有检测到 GPU,语音合成不可用(聊天文字仍可用)。请在 Kaggle 右侧 Settings → Accelerator 选择 GPU T4 x2")
    ctx = mp.get_context("spawn")
    POOL = Pool(ctx, gpus, {"mock": MOCK})
    import uvicorn
    try:
        uvicorn.run(app, host="0.0.0.0", port=PORT, log_level="warning", ws_ping_interval=20, ws_ping_timeout=60)
    finally:
        POOL.stop()


