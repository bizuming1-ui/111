def decide(eval_log, epoch, target, patience, max_epochs):
    """返回 (stop, reason, best_epoch, best_sim)。只看 epoch>=1 的评估(0 是未微调基线)"""
    rows = [r for r in eval_rows(eval_log) if r.get("epoch", 0) >= 1 and r.get("similarity") is not None]
    if not rows:
        return epoch + 1 >= max_epochs, "达到最大轮数" if epoch + 1 >= max_epochs else "", None, None
    best = max(rows, key=lambda r: r["similarity"])
    cur = [r for r in rows if r["epoch"] == epoch + 1]
    if cur and cur[-1]["similarity"] >= target and STOP_ON_TARGET[0]:
