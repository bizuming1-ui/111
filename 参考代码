    if (cfg) Object.assign(this.cfg, cfg);
    this.inSr = this.cfg.inSr;
    this.step = this.inSr / this.outSr;               // 每输出 1 个样本消耗多少个输入样本(同采样率时恰好 1)
    const cap = Math.round(this.inSr * this.maxSeconds);
    if (this.ring.length !== cap) this.ring = new Float32Array(cap);
    this.cap = cap;
    this.wr = 0;                                      // 累计写入的输入样本数(绝对计数)
    this.pos = 0;                                     // 当前读取位置(输入样本,可带小数)
    this.mode = "buffering";
    this.ended = false;
    this.started = false;
    this.fadeIn = 0;
    this.fadeInLen = Math.max(8, Math.round(this.outSr * 0.004));
    this.tail = 0;
    this.last = 0;
    this.flushing = 0;
    this.statCnt = 0;
    this.underruns = 0;
    this.curUnder = 0;                                // 本次欠载已持续的输出样本数
    this.silentOut = 0;                               // 起播之后插入的静音总输出样本数
    this.maxUnder = 0;
    this.minLevel = Infinity;
    this.overflow = 0;
    this.pushed = 0;
  }

  setCfg(c) { if (c) { Object.assign(this.cfg, c); } }
  end() { this.ended = true; }

  push(f32) {                                          // 返回 false = 环形缓冲放不下(服务端背压窗口应保证不会发生;发生就是故障,计数上报)
    if (this.mode === "idle" || this.flushing) return true;
    const n = f32.length;
    if (!n) return true;
    const used = this.wr - Math.floor(this.pos);
    if (used + n > this.cap) { this.overflow += n; this.post({ t: "overflow", n }); return false; }
    let w = this.wr % this.cap;
    const first = Math.min(n, this.cap - w);
    this.ring.set(f32.subarray(0, first), w);
    if (first < n) this.ring.set(f32.subarray(first), 0);
    this.wr += n;
    this.pushed += n;
    return true;
  }

  level() { return Math.max(0, this.wr - this.pos) * 1000 / this.inSr; }     // 尚未消耗的输入量(ms)
  playedSamples() { return Math.floor(this.pos); }

  flush() {
    if (this.mode === "idle") return;
    if (this.mode !== "playing") { this._reset(); this.post({ t: "flushed" }); return; }
    this.flushing = Math.round(this.outSr * 0.01);   // 10ms 淡出,避免"啪"声
    this.flushTotal = this.flushing;
  }

  _reset() { this.mode = "idle"; this.wr = 0; this.pos = 0; this.ended = false; this.started = false; this.flushing = 0; this.tail = 0; }

  stats() {
    return { underruns: this.underruns, silent_ms: Math.round(this.silentOut * 1000 / this.outSr), max_underrun_ms: Math.round(this.maxUnder * 1000 / this.outSr),
             min_level_ms: this.minLevel === Infinity ? null : Math.round(this.minLevel), played: this.playedSamples(), pushed: this.pushed, overflow: this.overflow };
  }

  _sample() {                                          // 取下一个输出样本;返回 NaN 表示数据不足
    const p = this.pos, i0 = Math.floor(p);
    const ring = this.ring, cap = this.cap;
    if (this.step === 1) {
      if (i0 >= this.wr) return NaN;
      this.pos = p + 1;
