def _run(coro_fn, **kw):
    """启动真实 BrowserManager(Chromium);不可用 → 记为未验证"""
    import browser_agent as ba
    ok, why = ba.BrowserManager.available()
    if not ok:
        SKIPPED.append("%s:未验证(%s)" % (coro_fn.__name__, why[:60]))
        return

    async def main():
        mgr = ba.BrowserManager()
        s = mgr.get("t-" + coro_fn.__name__[:20])
