def weather_variants(city, off=0):
    """搜索词变体。实测(2026-11,真实 Bing)把 ISO 日期写进搜索词(『2026-11-10 北京天气预报』)会让 Bing 返回百科/无关页,所以绝对日期放在意图的 absolute_date 字段里
    (界面显示、总结核对),搜索框里用相对日期词。Bing 对同一城市不同写法的相关度并不稳定,所以给出有序变体,由服务端『相关度检查』择优。"""
    d = _DAYW.get(off, "今天")
    if re.search(r"[A-Za-z]", city) and not re.search(r"[\u4e00-\u9fa5]", city):
        w = {0: "today", 1: "tomorrow", 2: "in 2 days"}.get(off, "today")
        return ["%s weather forecast" % city, "%s weather %s" % (city, w), "%s weather" % city]
    v = ["%s%s天气预报" % (city, "" if off == 0 else d), "%s%s天气" % (city, d), "%s天气" % city, "%s天气预报" % city]
    if city in _EN:                                                    # 国外城市:中文写法 Bing 常返回百科页,英文写法相关度高(实测),排在第二位
        v.insert(1, "%s weather %s" % (_EN[city], {0: "today", 1: "tomorrow", 2: "forecast"}.get(off, "today")))
    out = []
    for x in v:
        if x not in out:
            out.append(x)
    return out


def weather_query(city, off=0):
    return weather_variants(city, off)[0]


def rule_intent(text, settings, now_fn=None, ui_engines=None, city_override=""):
    """规则回退:同样输出结构化意图。只做字符串解析;不猜城市、不猜引擎。"""
    raw = (text or "").strip()
    d = settings.public() if hasattr(settings, "public") else dict(settings or {})
    tz = d.get("timezone") or "Asia/Shanghai"
    now = now_in(tz, now_fn)
    base = {"intent": "clarify", "normalized_query": "", "engines": [], "location": "", "location_source": "", "timezone": tz, "absolute_date": "",
            "needs_clarification": False, "clarification_question": "", "confidence": 0.7, "short_user_facing_interpretation": "", "original_text": raw}
    if not raw:
        return dict(base, needs_clarification=True, clarification_question="没有收到内容,请再说一次或直接输入。", short_user_facing_interpretation="没有收到内容")
    if _GREET_RE.match(raw):
        return dict(base, intent="conversation", short_user_facing_interpretation="这是日常对话,不会去搜索", confidence=0.8)
    eng, t2 = detect_engines(raw)
    core = strip_shell(t2)
    if _PAGE_RE.search(raw) and not re.match(r"^(?:打开|访问|前往)", core):
        return dict(base, intent="page_question", engines=[], short_user_facing_interpretation="你想了解当前浏览器页面的内容", vision_suggested=bool(_VISUAL_HINT.search(raw)))
    if is_browser_command(core) or is_browser_command(strip_shell(raw)):
        return dict(base, intent="browser_command", short_user_facing_interpretation="你想操作当前浏览器:" + core[:30], engines=eng)
    if is_weather(raw):
        loc, src = "", ""
        if city_override:
            loc, src = clean_query(city_override, 40), "this_turn"
        else:
            loc = extract_location(core)
            src = "user_said" if loc else ""
            if not loc and d.get("city"):
                loc, src = d["city"], "saved_default"
        off = day_offset(raw)
        date_iso = (now + timedelta(days=off)).strftime("%Y-%m-%d")
        if not loc:
            return dict(base, intent="clarify", engines=eng, timezone=tz, absolute_date=date_iso, needs_clarification=True, clarification_question="要查询哪个城市的天气?",
                        short_user_facing_interpretation="你想查天气,但还没说城市(我不会用服务器位置去猜)", clarify_kind="weather_city")
        vs = weather_variants(loc, off)
        q = vs[0]
        return dict(base, intent="search", normalized_query=q, query_variants=vs[1:4], relevance_terms=["天气", "weather", "forecast", "预报"], engines=eng, location=loc, location_source=src, absolute_date=date_iso,
                    short_user_facing_interpretation="查询 %s %s 的天气(来源:%s)" % (date_iso, loc, {"user_said": "你说的城市", "saved_default": "你保存的默认城市", "this_turn": "本轮你提供的城市"}.get(src, src)))
    if not core or len(core) < 1:
        return dict(base, intent="clarify", engines=eng, needs_clarification=True, clarification_question="要搜索什么内容?", short_user_facing_interpretation="没有听清要搜索的内容")
    date_iso = now.strftime("%Y-%m-%d") if re.search(_TIME_WORDS, raw) else ""
    return dict(base, intent="search", normalized_query=core, engines=eng, absolute_date=date_iso, short_user_facing_interpretation="搜索「%s」" % core[:50])


LLM_SYS = ("你是语音搜索助手的『意图理解器』。只输出一个 JSON 对象,不要任何解释。\n"
