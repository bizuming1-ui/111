  render(out) {
    const n = out.length, sr = this.outSr;
    if (this.mode === "buffering") {
      if (this.level() >= this.cfg.startMs || (this.ended && this.wr > 0)) this.mode = "playing";
      else if (this.ended) { this.mode = "idle"; this.post({ t: "drained", stats: this.stats() }); }
    } else if (this.mode === "rebuffering") {
      if (this.level() >= this.cfg.rebufMs || (this.ended && this.wr > this.pos)) {
        this.mode = "playing";
        this.fadeIn = this.fadeInLen;
        this.post({ t: "resumed", gap_ms: Math.round(this.curUnder * 1000 / sr), n: this.underruns });
        this.curUnder = 0;
      }
    }
    for (let i = 0; i < n; i++) {
      if (this.mode === "playing") {
        let v = this._sample();
        if (v !== v) {                                  // 数据不足
          if (this.ended) { this.mode = "idle"; this.post({ t: "drained", stats: this.stats() }); out[i] = 0; continue; }
          this.mode = "rebuffering";                    // 欠载:不改变速度、不重复、不造假音 —— 淡出、静音、重新缓冲,并如实计数
          this.underruns++;
          this.curUnder = 0;
          this.tail = 64;
          this.post({ t: "underrun", n: this.underruns, level_ms: this.level(), played: this.playedSamples() });
          i--;                                          // 这个输出样本改走"非播放"分支:从最后一个样本平滑衰减到 0,避免硬切
          continue;
        }
        if (!this.started) { this.started = true; this.fadeIn = this.fadeInLen; this.post({ t: "started" }); }
        if (this.fadeIn > 0) { v *= 1 - this.fadeIn / this.fadeInLen; this.fadeIn--; }
        if (this.flushing > 0) {
          v *= this.flushing / this.flushTotal;
          if (--this.flushing === 0) { out[i] = v; out.fill(0, i + 1); this._reset(); this.post({ t: "flushed" }); return; }
        }
        this.last = v;
        out[i] = v;
        if (!this.ended) { const lv = this.level(); if (lv < this.minLevel) this.minLevel = lv; }
      } else {
        if (this.tail > 0) { out[i] = this.last * (this.tail / 64); this.tail--; } else out[i] = 0;
        if (this.mode === "rebuffering") {
          this.curUnder++; this.silentOut++;
          if (this.curUnder > this.maxUnder) this.maxUnder = this.curUnder;
        }
      }
    }
    this.statCnt += n;
    if (this.statCnt >= sr / 10) {
      this.statCnt = 0;
      const s = this.stats();
      s.t = "stat"; s.ms = this.level(); s.mode = this.mode;
      this.post(s);
    }
  }
}

if (typeof AudioWorkletProcessor !== "undefined") {
  class PlayerProcessor extends AudioWorkletProcessor {
    constructor() {
      super();
      this.core = new RingPlayer(sampleRate, (m) => this.port.postMessage(m));
