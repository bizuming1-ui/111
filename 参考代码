def speech_rms(pcm):
    """只统计"有声帧"(10ms RMS > 阈值)的整体 RMS(int16 量纲)。用于两张卡的音量对齐。"""
    pcm = np.asarray(pcm)
    fr = SR // 100
    n = len(pcm) // fr
    if n < 5:
        return 0.0
    f = pcm[: n * fr].astype(np.float32).reshape(n, fr)
    r = np.sqrt((f ** 2).mean(axis=1))
    thr = max(110.0, float(np.percentile(r, 90)) * 0.12)
    v = f[r >= thr]
    return float(np.sqrt((v ** 2).mean())) if v.size else 0.0


def _f2pcm(a):
    """严格转换:NaN/Inf 直接抛 AudioCorrupt,不再悄悄 nan_to_num。"""
    return float_to_pcm(a, strict=True)


def seg_seed(vid, seg_idx, text):
    """每片段随机种子:同一(声音版本, 句序, 文本)重试得到同一个种子 → 可复现;不同片段种子不同 → 不会机械重复同一随机序列。"""
    import zlib
    return (SEED * 1000003 + zlib.crc32(("%s|%s|%s" % (vid, seg_idx, text)).encode("utf-8"))) & 0x7FFFFFFF


def _seed_all(seed=None):
    import random
    sd = SEED if seed is None else int(seed)
    random.seed(sd)
    np.random.seed(sd % (2 ** 32))
    try:
        import torch
        torch.manual_seed(sd)
        torch.cuda.manual_seed_all(sd)
    except Exception:  # noqa: BLE001
        pass


