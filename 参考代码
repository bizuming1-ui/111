def _is_pause(b):
    """停顿 = 数字零(v14 / V15 关闭)或 v15 舒适噪声(峰值 ≤ 300、RMS ≤ 60,约 -57dBFS 以下)。"""
    if not any(b):
        return True
    import numpy as _np
    x = _np.frombuffer(b[: len(b) // 2 * 2], dtype="<i2").astype(_np.float64)
    return bool(len(x)) and float(_np.abs(x).max()) <= 300 and float(_np.sqrt((x ** 2).mean())) <= 60


