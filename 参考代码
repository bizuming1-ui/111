def v16_turn_timing(turn, first_ms, model_first_ms, queue_ms):
    """M7:把已有的三个测量值记成分段:gateway=队列(轮开始→首段派发) · first_frames=模型首块(prefill+前N帧+首块解码,GPU 进程内未再细分) · ws_play=其余(规划保持/桥接/后处理/WebSocket)。"""
    if _v16 is None or V16T is None or not _v16.on("TTFA") or first_ms is None:
        return
    try:
        V16T.add("gateway", queue_ms)
        V16T.add("first_frames", model_first_ms)
        V16T.add("ws_play", max(0.0, float(first_ms) - float(queue_ms or 0) - float(model_first_ms or 0)))
    except Exception:  # noqa: BLE001
        pass


