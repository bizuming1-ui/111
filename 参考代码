def find_reference():
    """reference.wav 的查找顺序: 配置路径 -> /kaggle/input 下任意位置的 reference.wav -> None"""
    if REFERENCE_WAV.exists():
        return REFERENCE_WAV
    inp = Path("/kaggle/input")
    if inp.exists():
        for p in inp.rglob("reference.wav"):
            return p
    return None


def _patch_load_audio():
    """XTTS 用 torchaudio.load 读参考音频。torchaudio >= 2.9 起它依赖 torchcodec + 系统 FFmpeg,
    Kaggle 上常常装不上/加载失败。这里换成 soundfile 读取(不依赖 torchcodec),失败时才回退原函数。"""
    import soundfile as sf
    import torch
    import torchaudio
    import TTS.tts.models.xtts as xtts_mod

    original = xtts_mod.load_audio

    def safe_load_audio(path, sampling_rate):
        try:
            data, sr = sf.read(str(path), dtype="float32", always_2d=True)   # (n, ch)
            audio = torch.from_numpy(np.ascontiguousarray(data.T))             # (ch, n)
            if audio.size(0) != 1:
                audio = audio.mean(dim=0, keepdim=True)
            if sr != sampling_rate:
                audio = torchaudio.functional.resample(audio, sr, sampling_rate)
            return audio.clamp_(-1, 1)
        except Exception as e:  # noqa: BLE001
            log.warning("soundfile 读取参考音频失败(%s),回退 torchaudio", e)
            return original(path, sampling_rate)

    xtts_mod.load_audio = safe_load_audio


class XttsEngine:
    name = "xtts_v2"

    def __init__(self):
        import torch

        os.environ.setdefault("COQUI_TOS_AGREED", "1")     # 免交互同意 CPML 许可,否则首次下载会卡在 input()
        _patch_load_audio()
        from TTS.api import TTS

        self.torch = torch
        self.device = "cuda" if torch.cuda.is_available() else "cpu"
        if self.device == "cpu":
            log.warning("⚠ 没有检测到 GPU!XTTS 在 CPU 上远慢于实时,会严重卡顿。请在 Kaggle 右侧 Settings -> Accelerator 选 GPU T4。")
        log.info("正在加载 XTTS v2 模型(首次需下载约 1.8GB,请耐心等待)... device=%s", self.device)
        t0 = time.time()
        tts = TTS(MODEL_NAME, progress_bar=False)
        tts.to(self.device)
        self.model = tts.synthesizer.tts_model
        log.info("模型加载完成,用时 %.1fs", time.time() - t0)
        self._voice = None          # (key, gpt_cond_latent, speaker_embedding, source)
        self._voice_lock = threading.Lock()

    def voice(self):
        """返回当前克隆音色(参考音频被替换后自动重新计算;缺失则使用内置音色)"""
        with self._voice_lock:
            ref = find_reference()
            key = (str(ref), ref.stat().st_mtime if ref else None)
            if self._voice and self._voice[0] == key:
                return self._voice
            with self.torch.inference_mode():
                if ref is not None:
                    t0 = time.time()
                    gpt, spk = self.model.get_conditioning_latents(audio_path=[str(ref)])
                    log.info("已从参考音频提取声音特征: %s (%.1fs)", ref, time.time() - t0)
                    self._voice = (key, gpt, spk, "clone")
                else:
                    sm = self.model.speaker_manager
                    names = list(sm.speakers.keys())
                    name = FALLBACK_SPEAKER if FALLBACK_SPEAKER in sm.speakers else names[0]
                    log.warning("⚠ 未找到 %s,临时使用内置音色「%s」(把 reference.wav 放好后无需重启,下次请求自动切换为克隆音色)", REFERENCE_WAV, name)
                    gpt, spk = list(sm.speakers[name].values())[:2]       # 与 XTTS 官方 synthesize() 的取法一致
                    self._voice = (key, gpt, spk, "builtin")
            return self._voice

    def stream(self, text):
        """同步生成器:逐块产出 float 音频(24kHz)。必须在线程里调用。"""
        _, gpt, spk, _ = self.voice()
        with self.torch.inference_mode():
            for chunk in self.model.inference_stream(
                text, LANGUAGE, gpt, spk,
                stream_chunk_size=STREAM_CHUNK_TOKENS,
                temperature=0.75, enable_text_splitting=False,
            ):
                yield chunk

class MockEngine:
    """本地自检引擎:不需要 GPU/模型,按"约 0.4 倍实时"的速度吐出正弦波。"""
    name = "mock"
    device = "cpu"

    def __init__(self):
        log.info("使用 MockEngine(CLONE_MOCK=1),不加载真实模型")

    def stream(self, text):
        n = max(1, len(text)) * 0.18                       # 每个字约 0.18s
        t_total, freq = 0.0, 220.0 + (sum(map(ord, text)) % 5) * 60
        while t_total < n:
            time.sleep(0.12)
            dur = min(0.4, n - t_total)
            t = np.arange(int(SAMPLE_RATE * dur)) / SAMPLE_RATE + t_total
            yield (0.3 * np.sin(2 * np.pi * freq * t)).astype(np.float32)
            t_total += dur


def voice_label():
    """当前会使用的音色类型(只看文件是否存在,不触发 GPU 计算,可在事件循环里安全调用)"""
    if USE_MOCK:
        return "mock"
    return "clone" if find_reference() else "builtin"


STATS = {"rtf": None, "first_chunk_ms": None, "requests": 0, "last_error": None}
GPU_LOCK = threading.Lock()   # 一张卡同一时刻只跑一个合成


def warmup(engine):
    """预热两次:第一次触发 CUDA kernel 编译,第二次测量真实的首包延迟与实时率(RTF = 合成耗时 / 音频时长)"""
    try:
        for i in range(2):
            t0, first, samples = time.time(), None, 0
            for ch in engine.stream("你好，语音系统已经准备就绪。"):
                if first is None:
                    first = time.time() - t0
                samples += len(to_pcm16(ch)) // 2
            total = time.time() - t0
            dur = samples / SAMPLE_RATE
            if i == 1 and dur > 0:
                STATS["rtf"] = round(total / dur, 3)
                STATS["first_chunk_ms"] = round(first * 1000)
                log.info("预热完成: 首包 %d ms, 实时率 RTF=%.2f (%s)", STATS["first_chunk_ms"], STATS["rtf"],
                         "快于实时 ✓" if STATS["rtf"] < 1 else "⚠ 慢于实时,会卡顿,请确认已开启 GPU")
    except Exception as e:  # noqa: BLE001
        log.exception("预热失败(不影响启动): %s", e)


# ★ 程序启动(import/exec 本文件)时就加载模型,不等第一次请求
ENGINE = MockEngine() if USE_MOCK else XttsEngine()
warmup(ENGINE)

