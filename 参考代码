}
function curOk() { return CUR && CUR.uid != null && !CUR.final; }
function applyStartPlan(serverMs, floorMs) {
  const r = VC.computeStartMs({ serverMs, floorMs, rtts: M.rtts, minLevels: M.minLevels, mode: (S.state && S.state.perf && S.state.perf.mode) || "continuous" });
  S.startMs = r.ms;
