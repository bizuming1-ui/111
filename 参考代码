_CN = {"一": 1, "二": 2, "两": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9, "十": 10}


def _num(s):
    s = s.strip()
    return int(s) if s.isdigit() else _CN.get(s)


def _recency(t):
    for pat, v in ((r"最近一天|今天|24\s*小时|过去一天|past day|today|last 24", "d"), (r"最近一周|本周|过去一周|这周|past week|this week|last week", "w"),
                   (r"最近一个月|本月|过去一个月|past month|this month|last month", "m"), (r"今年|最近一年|过去一年|past year|this year|last year", "y")):
        if re.search(pat, t, re.I):
            return v, re.sub(pat, " ", t, flags=re.I)
    return None, t


def plan_rules(text, engine="google"):
    """返回 {"actions": [...], "clarify": str|None}。只做字符串解析。"""
    t = (text or "").strip()
    if not t:
        return {"actions": [], "clarify": "没有收到指令"}
    clauses = [c.strip() for c in re.split(r"[，,;；]\s*|\s+then\s+|\s+and then\s+|然后|接着|之后|并且", t) if c and c.strip()]
    acts, unclear = [], []
    for c in clauses:
        c0 = re.sub(r"^(请你?|帮我|麻烦你?|请帮我|please|pls|再)\s*", "", c.strip(), flags=re.I).strip()
        m = None
        if re.fullmatch(r"(返回|后退|回退|go back|back)", c0, re.I):
            acts.append({"action": "back"})
        elif re.fullmatch(r"(前进|go forward|forward)", c0, re.I):
            acts.append({"action": "forward"})
        elif re.fullmatch(r"(刷新|重新加载|reload|refresh)(页面|网页)?", c0, re.I):
            acts.append({"action": "reload"})
        elif re.search(r"(几个|更多|多些|其他|另外)\s*的?\s*(来源|结果|网站)|more (sources|results)|next page|下一页", c0, re.I):
            acts.append({"action": "search_more"})
        elif (m := re.search(r"滚(?:动)?到(顶部|底部|最上面|最下面)|scroll to (top|bottom)", c0, re.I)):
            acts.append({"action": "scroll", "direction": "top" if re.search("顶部|最上|top", m.group(0), re.I) else "bottom"})
        elif (m := re.search(r"(?:向|往)?(下|上)(?:滚动|翻|滑|拉)|scroll (down|up)|翻页", c0, re.I)):
            d = "up" if re.search("上|up", m.group(0), re.I) else "down"
            n = re.search(r"(\d{2,4})\s*(?:像素|px)", c0)
            acts.append({"action": "scroll", "direction": d, "amount": int(n.group(1)) if n else 600})
        elif (m := re.match(r"(?:打开|访问|前往|进入|去|open|go to|visit|navigate to)\s*(.+)$", c0, re.I)):
            tgt = m.group(1).strip()
            r = re.search(r"第\s*(\d+|[一二两三四五六七八九十])\s*个?\s*(?:搜索)?(?:结果|链接|网站|页面)|(?:result|link)\s*#?(\d+)|(?:the )?(first|second|third)\s*(?:result|link)", tgt, re.I)
            if r:
                v = r.group(1) or r.group(2) or {"first": 1, "second": 2, "third": 3}.get((r.group(3) or "").lower())
                n = _num(str(v)) if v is not None else None
                acts.append({"action": "open_result", "n": n or 1})
            elif re.match(r"^(https?://)?[\w-]+(\.[\w-]+)+(:\d+)?(/\S*)?$", tgt, re.I):
                acts.append({"action": "goto", "url": netguard.normalize_user_target(tgt)})
            else:
                unclear.append(c)
        elif (m := re.match(r"(?:搜索|搜一下|搜|查一下|查找|查询|查|search for|search|google|look up|find)\s*(.+)$", c0, re.I)) or (m := re.match(r"(?:在|于)\s*([\w.-]+\.[a-z]{2,})\s*(?:上|里|中)?\s*(?:搜索|搜|查)\s*(.+)$", c0, re.I)):
            site = None
            q = m.group(m.lastindex)
            if m.lastindex == 2:
                site = m.group(1).lower()
            sm = re.search(r"(?:site:|在|于)\s*([a-z0-9][a-z0-9.-]*\.[a-z]{2,24})\s*(?:上|里|中)?", q + " " + c0, re.I)
            if sm and not site:
                site = sm.group(1).lower()
            q = re.sub(r"site:\S+|(?:在|于)\s*[a-z0-9][a-z0-9.-]*\.[a-z]{2,24}\s*(?:上|里|中)?", " ", q, flags=re.I)
            rec, q = _recency(q if not _recency(c0)[0] else q + " " + c0)
            if rec is None:
                rec, _ = _recency(c0)
            q = re.sub(r"\s+", " ", q).strip(" 的:：")
            if q:
                a = {"action": "search", "query": q, "engine": engine}
                if site:
                    a["site"] = site
                if rec:
                    a["recency"] = rec
                acts.append(a)
            else:
                unclear.append(c)
        elif (m := re.match(r"(?:在\s*[「\"“']?(.+?)[」\"”']?\s*(?:里|中|框里|框中|栏里)?\s*)?(?:输入|键入|填写|type|enter|input)\s*[「\"“']?(.+?)[」\"”']?$", c0, re.I)):
            a = {"action": "type", "text": m.group(2)}
            if m.group(1):
                a["into"] = {"by": "label", "value": m.group(1)}
            acts.append(a)
        elif (m := re.match(r"(?:按|按下|press)\s*(回车|enter|esc|escape|tab|向下|向上)\s*键?$", c0, re.I)):
            k = {"回车": "Enter", "enter": "Enter", "esc": "Escape", "escape": "Escape", "tab": "Tab", "向下": "ArrowDown", "向上": "ArrowUp"}[m.group(1).lower()]
            acts.append({"action": "key", "key": k})
        elif (m := re.match(r"(?:点击|点一下|单击|点|click|tap)\s*(?:按钮|链接)?\s*[「\"“']?(.+?)[」\"”']?$", c0, re.I)):
            acts.append({"action": "click", "by": "text", "value": m.group(1)})
        elif re.search(r"阅读|读一下|读取|总结|摘要|看看|看一下|summari[sz]e|\bread\b", c0, re.I):
            acts.append({"action": "read"})
        elif re.search(r"截图|screenshot|屏幕", c0, re.I):
            acts.append({"action": "snapshot"})
        else:
            unclear.append(c)
    if unclear and not acts:
        return {"actions": [], "clarify": "无法确定要执行的操作:「%s」。请用类似“搜索 xxx”“打开 example.com”“点击 登录”的说法,或换一种表达。" % "; ".join(unclear)[:120]}
    try:
        acts = validate_actions(acts) if acts else []
    except ValueError as e:
        return {"actions": [], "clarify": str(e)}
    return {"actions": acts, "clarify": ("部分内容未能理解,已忽略:" + "; ".join(unclear)[:100]) if unclear else None}


