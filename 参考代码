class Worker:
    def __init__(self, idx, gpu, proc, q):
        self.idx, self.gpu, self.proc, self.q = idx, gpu, proc, q
        self.status, self.msg = "loading", "启动中…"
        self.voice_vid = None
        self.voice_info = {}
        self.pending = 0
        self.inflight = 0
        self.cur = None          # (turn uid, seg idx)
        self.mem = (0.0, 0.0, 0)
        self.synth_segs = 0

    def ready(self):
        return self.status in ("ready", "voice") and self.proc.is_alive()


class Pool:
    def __init__(self, ctx, gpus, cfg):
        self.ctx = ctx
        self.epoch = ctx.Value("i", 0)
        self.backlog = []          # [(turn uid, seg idx, text, profile)]
        self.res_q = ctx.Queue()
        self.workers = []
        for i, g in enumerate(gpus):
            q = ctx.Queue()
            p = ctx.Process(target=worker_main, args=(i, g, q, self.res_q, self.epoch, cfg), daemon=True, name="tts-gpu%s" % g)
            p.start()
            self.workers.append(Worker(i, g, p, q))

    def usable(self):
        return [w for w in self.workers if w.ready() and w.voice_vid == VOICE["vid"] and VOICE["vid"] > 0]

    def _next_job(self, w):
        self.backlog.sort(key=lambda j: (j[0], j[1]))
        for j in list(self.backlog):
            t = ACTIVE.get(j[0])
            if t is None or t.closed or j[1] >= len(t.segs):
                self.backlog.remove(j)
                continue
            if t.pinned is not None and t.pinned != w.idx:
                continue
            if t.blocked():                      # 背压:浏览器已经领先足够多,先不要继续烧 GPU
                continue
            self.backlog.remove(j)
            return t, j
        return None

    def schedule(self):
        """拉取式调度(work-stealing) + 背压:哪张卡空了就领队首的句子;但某一轮"已发出但尚未播放 + 已就绪未发送"的音频超过窗口时,这一轮暂停派活。"""
        for w in sorted(self.usable(), key=lambda x: x.idx):
            if w.inflight > 0:
                continue
            job = self._next_job(w)
            if job is None:
                continue
            t, (uid, seg_i, clean, prof) = job
            seg = t.segs[seg_i]
            seg.worker, seg.sent_at = w.idx, time.time()
            w.inflight += 1
            w.cur = (uid, seg_i)
            w.pending += len(clean)
            w.synth_segs += 1
            t.gpu_segs[str(w.idx)] = t.gpu_segs.get(str(w.idx), 0) + 1
            seed = seg_seed(VOICE["vid"], seg_i, clean)
            w.q.put(("tts", uid, self.epoch.value, seg_i, clean, prof, seed))

    def bump(self):
        with self.epoch.get_lock():
            self.epoch.value += 1

    def stop(self):
        for w in self.workers:
            try:
                w.q.put(("quit",))
            except Exception:  # noqa: BLE001
                pass


class Session:
    def __init__(self, sid):
        self.sid = sid
        self.ws = None
        self.q = None
        self.attached = False
        self.sender = None
        self.q_bytes = 0
        self.legacy = False
        self.history = []
        self.task = None
        self.turn = None
        self.turns = OrderedDict()
        self.detached_at = None

    def attach(self, ws):
        self.ws, self.q, self.q_bytes, self.attached, self.detached_at = ws, asyncio.Queue(), 0, True, None
        self.sender = asyncio.get_running_loop().create_task(self._sender(ws, self.q))

    def detach(self):
        self.attached = False
        self.detached_at = time.time()
        if self.sender:
            self.sender.cancel()
        self.sender = None

    async def _sender(self, ws, q):
        try:
            while True:
                m = await q.get()
                if isinstance(m, (bytes, bytearray)):
                    await ws.send_bytes(bytes(m))
                    self.q_bytes -= len(m)
                else:
                    await ws.send_text(m)
        except Exception:  # noqa: BLE001
            pass

    def send(self, obj):
        if self.attached:
            self.q.put_nowait(json.dumps(obj, ensure_ascii=False))

    def send_bin(self, b):
        if self.attached:
            self.q_bytes += len(b)
            self.q.put_nowait(b)


def broadcast(obj):
