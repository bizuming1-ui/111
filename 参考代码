/* ═════════ 播放器回调 ═════════ */
function onPlayerMsg(m) {
  const c = CUR;
  if (m.t === "started") {
    if (c && c.t_audible == null) {
      const lat = PE.ctx ? ((PE.ctx.outputLatency || 0) + (PE.ctx.baseLatency || 0)) * 1000 : 0;
      c.t_audible = performance.now() + lat;
      S.firstMs = Math.round(c.t_audible - c.t_click);
      $("tFirst").textContent = (S.firstMs / 1000).toFixed(2) + "s" + (c.cold ? "·冷" : "·热");
      log("首声 " + S.firstMs + "ms(" + (c.cold ? "冷" : "热") + "启动;含输出延迟估计 " + Math.round(lat) + "ms)", "o");
    }
    setPhase("play");
  } else if (m.t === "stat") {
    const ms = m.ms, ref = Math.max(600, S.startMs), pct = Math.min(100, ms / ref * 100), cls = pct < 15 ? " danger" : pct < 35 ? " low" : "";
    $("pbarI").style.width = pct + "%"; $("pbar").className = "pbar" + cls; $("meterI").style.width = pct + "%"; $("meter").className = "meter" + cls;
    $("sBuf").textContent = "缓冲: " + Math.round(ms) + "ms";
