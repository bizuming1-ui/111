def order_for(engine=None, page=0):
    """免 Key 链路顺序。google 无法被服务器直连(会被拦截),选 google 时仍从 Bing 开始并在界面里说明。"""
    first = ["duckduckgo", "bing"] if engine == "duckduckgo" and page == 0 else ["bing", "duckduckgo"]
    return first + ["wikipedia"]


async def run_one(prov, pid, q, count, page, site, recency, sleep=asyncio.sleep):
    """调用单个提供方,最多对【可重试】错误重试 MAX_ATTEMPT_RETRIES 次;返回 (results, attempt_record)。"""
    t0 = time.time()
    tries = 0
    while True:
        tries += 1
        try:
            res = await prov.search(q, count, page, site, recency)
            return res, {"provider": pid, "ok": True, "n": len(res), "ms": int((time.time() - t0) * 1000), "tries": tries}
        except SearchError as e:
            if e.retryable and tries <= MAX_ATTEMPT_RETRIES:
                await sleep(0.6 * tries)
                continue
            return None, {"provider": pid, "ok": False, "kind": e.kind, "message": str(e), "status": e.status, "ms": int((time.time() - t0) * 1000), "tries": tries}
        except Exception as e:  # noqa: BLE001
            return None, {"provider": pid, "ok": False, "kind": "network", "message": "%s: %s" % (type(e).__name__, str(e)[:80]), "ms": int((time.time() - t0) * 1000), "tries": tries}


async def search_http_chain(q, count=8, page=0, site=None, recency=None, engine=None, attempts=None):
    """依次尝试免 Key 的 HTTP 提供方。成功返回 (results, provider_id, attempts);全部失败抛 SearchFailed(attempts)。"""
