            self.stats["blocked"] += 1
            return {"ok": False, "engine": eng, "items": [], "error": "%s 返回 HTTP %d:已停止请求该接口 %d 秒(不重试、不绕过)" % (eng, r.status_code, COOLDOWN_S)}
