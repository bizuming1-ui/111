def open_ngrok(token):
    from pyngrok import conf, ngrok
    cfg = conf.get_default()
    cfg.auth_token = token
    try:                                                    # 二进制校验: 不存在/损坏就重新下载(网络抖动时 pyngrok 可能留下半个文件)
        if not os.path.exists(cfg.ngrok_path) or os.path.getsize(cfg.ngrok_path) < 5_000_000:
            try:
                os.remove(cfg.ngrok_path)
            except OSError:
                pass
            retry(lambda: ngrok.install_ngrok(cfg.ngrok_path), what="下载 ngrok 程序")
    except Exception as e:
        print("  ⚠ ngrok 程序校验跳过: %s" % e)

    def _open():
        for t in ngrok.get_tunnels():
            try:
                ngrok.disconnect(t.public_url)
            except Exception:
                pass
        return ngrok.connect(PORT, "http").public_url.replace("http://", "https://")
    return retry(_open, tries=3, wait=5, what="建立 ngrok 隧道")



