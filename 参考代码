  私有数据仓库(GITHUB_PRIVATE_REPO,可选):必须先通过 API 核实 private=true;只接受【加密包】(VCENC1 头);≤ 40MB;不会更改仓库可见性。
  原子:Git Data API(blob → tree → commit → update ref),一次同步一个 commit;幂等:内容与远端相同则不提交;冲突(422/409)自动重试 3 次;
  预览:/api/sync/preview 返回目标仓库、可见性、文件清单(大小/哈希/内容摘要)与拒绝原因,并给出 preview_id;同步必须带 preview_id,内容变了就要重新预览。
"""
import base64
import hashlib
import json
import os
import re
import time
from pathlib import Path

from audit import FORBIDDEN_EXT, find_secrets
from libraries import StoreError, atomic_write_json, now_iso, read_json

API = "https://api.github.com"
PUBLIC_PREFIXES = ("telemetry/",)
MAX_FILE = 256 * 1024
MAX_TOTAL = 1024 * 1024
MAX_PRIVATE = 40 * 1024 * 1024


def vet_public_files(files):
    """files: {path: str content} → (ok, problems[])"""
    probs, total = [], 0
    for path, content in files.items():
        if ".." in Path(path).parts or path.startswith("/"):
            probs.append("路径不安全: " + path)
        if not path.startswith(PUBLIC_PREFIXES):
            probs.append("不在允许的前缀内(只允许 %s): %s" % (",".join(PUBLIC_PREFIXES), path))
        if Path(path).suffix.lower() in FORBIDDEN_EXT:
            probs.append("扩展名被禁止: " + path)
        b = content.encode("utf-8") if isinstance(content, str) else content
        total += len(b)
        if len(b) > MAX_FILE:
            probs.append("文件过大(>%dKB): %s" % (MAX_FILE // 1024, path))
        if isinstance(content, str) and find_secrets(content):
            probs.append("检测到疑似密钥/令牌: " + path)
    if total > MAX_TOTAL:
        probs.append("总量超过 %dKB" % (MAX_TOTAL // 1024))
    return not probs, probs


class GitHubSync:
    def __init__(self, state_dir, audit, token=None, repo=None, branch=None, private_repo=None):
        self.state_dir = Path(state_dir)
        self.state_dir.mkdir(parents=True, exist_ok=True)
        self.audit = audit
        self._token = (token if token is not None else os.environ.get("GITHUB_TOKEN", "")).strip()
        self.repo = (repo or os.environ.get("GITHUB_REPO") or "bizuming1-ui/111").strip()
        self.branch = (branch or os.environ.get("GITHUB_BRANCH") or "").strip()
        self.private_repo = (private_repo if private_repo is not None else os.environ.get("GITHUB_PRIVATE_REPO", "")).strip()
        self.api = os.environ.get("VC_GITHUB_API", API).rstrip("/")
        self.f = self.state_dir / "sync_state.json"
        self.state = read_json(self.f, {}) or {}
        self.settings = self.state.setdefault("settings", {"auto": False, "interval_min": 30})
        self._previews = {}

    # —— 安全的 HTTP:Token 只放在请求头里 ——
    def _req(self, method, path, body=None, timeout=30):
        import httpx
        if not self._token:
            raise StoreError("没有配置 GITHUB_TOKEN(在 Kaggle Secrets 里添加;建议 fine-grained token,只授予目标仓库的 Contents: Read and write)", 400)
        h = {"Authorization": "Bearer " + self._token, "Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "vc-portal"}
        r = httpx.request(method, self.api + path, headers=h, json=body, timeout=timeout)
        return r

    def configured(self):
        return bool(self._token)

    def repo_info(self, repo=None):
        r = self._req("GET", "/repos/" + (repo or self.repo))
        if r.status_code == 404:
            raise StoreError("仓库不存在或 Token 无权访问", 404)
        if r.status_code >= 400:
            raise StoreError("GitHub 返回 %d" % r.status_code, 502)
        j = r.json()
        return {"full_name": j["full_name"], "private": bool(j["private"]), "default_branch": j.get("default_branch", "main"), "permissions": j.get("permissions", {})}

    # —— 预览 ——
    def preview(self, target="public"):
        files, upto = self.audit.public_files()
        ok, probs = vet_public_files(files)
        info, err = None, None
        if self._token:
            try:
                info = self.repo_info()
            except StoreError as e:
                err = str(e)
        else:
            err = "未配置 GITHUB_TOKEN:只能预览,不能同步"
        if info and info["private"] is False:
            vis = "公开仓库:只会上传下列脱敏文件"
        elif info:
            vis = "私有仓库"
        else:
            vis = "未知(无法核实可见性)"
        digest = hashlib.sha256(json.dumps(files, sort_keys=True).encode()).hexdigest()[:16]
        pid = "pv_" + digest
        self._previews[pid] = {"files": files, "upto": upto, "t": time.time()}
        for k in list(self._previews):
            if time.time() - self._previews[k]["t"] > 900:
                self._previews.pop(k, None)
        return {"preview_id": pid, "repo": self.repo, "branch": self.branch or (info or {}).get("default_branch") or "(默认分支)", "visibility": vis, "repo_info_error": err,
                "files": [{"path": p, "bytes": len(c.encode("utf-8")), "sha256": hashlib.sha256(c.encode("utf-8")).hexdigest()[:16], "head": c[:400]} for p, c in files.items()],
                "vetted": ok, "problems": probs, "configured": bool(self._token), "never_uploaded": "音频 / 转写 / 声纹 / 模型 / Cookie / 截图 / 完整搜索词 / Token"}

    # —— 同步:Git Data API,一次 commit ——
    def sync(self, preview_id):
        pv = self._previews.get(preview_id)
        if not pv:
            raise StoreError("预览已过期,请重新预览后再同步", 409)
        files = pv["files"]
        ok, probs = vet_public_files(files)
        if not ok:
            raise StoreError("同步被拒绝:" + "; ".join(probs[:4]), 422)
        info = self.repo_info()
        t0 = time.time()
        res = self._commit(self.repo, info, files, "chore(telemetry): sanitized audit sync %s" % now_iso())
        if res.get("committed"):
            self.audit.mark_synced(pv["upto"])
        self.state.update(last_sync=now_iso(), last_result=res, last_error=None)
        atomic_write_json(self.f, self.state)
        self.audit.event("github_sync", "ok", (time.time() - t0) * 1000, count=len(files))
        return res

    def _commit(self, repo, info, files, message, tries=3):
        branch = self.branch or info["default_branch"]
        last = None
        for attempt in range(tries):
            r = self._req("GET", "/repos/%s/git/ref/heads/%s" % (repo, branch))
            if r.status_code == 404:
                raise StoreError("分支 %s 不存在" % branch, 404)
            head = r.json()["object"]["sha"]
            base_tree = self._req("GET", "/repos/%s/git/commits/%s" % (repo, head)).json()["tree"]["sha"]
            entries = []
            for path, content in files.items():
                bl = self._req("POST", "/repos/%s/git/blobs" % repo, {"content": base64.b64encode(content if isinstance(content, bytes) else content.encode("utf-8")).decode(), "encoding": "base64"}, 120)
                if bl.status_code >= 300:
                    raise StoreError("创建 blob 失败(%d)" % bl.status_code, 502)
                entries.append({"path": path, "mode": "100644", "type": "blob", "sha": bl.json()["sha"]})
            tr = self._req("POST", "/repos/%s/git/trees" % repo, {"base_tree": base_tree, "tree": entries})
            if tr.status_code >= 300:
                raise StoreError("创建 tree 失败(%d)" % tr.status_code, 502)
            if tr.json()["sha"] == base_tree:
                return {"committed": False, "idempotent": True, "message": "远端内容已是最新,没有提交"}
            cm = self._req("POST", "/repos/%s/git/commits" % repo, {"message": message, "tree": tr.json()["sha"], "parents": [head]})
            if cm.status_code >= 300:
                raise StoreError("创建 commit 失败(%d)" % cm.status_code, 502)
            up = self._req("PATCH", "/repos/%s/git/refs/heads/%s" % (repo, branch), {"sha": cm.json()["sha"], "force": False})
            if up.status_code < 300:
                return {"committed": True, "commit": cm.json()["sha"][:10], "files": list(files), "branch": branch, "repo": repo}
            last = up.status_code
            time.sleep(1.5 * (attempt + 1))                                   # 非快进(远端有新提交) → 重新取 head 再来
        raise StoreError("同步冲突,重试 %d 次仍失败(HTTP %s)" % (tries, last), 409)

    # —— 私有数据仓库:加密包 ——
    def push_private_bundle(self, blob, name):
        if not self.private_repo:
            raise StoreError("没有配置 GITHUB_PRIVATE_REPO:声音素材不能同步到公开仓库,请改用 Kaggle 输出保存或下载加密包自行保管", 400)
        if not blob.startswith(b"VCENC1"):
            raise StoreError("只接受加密包(请在导出时设置口令):不加密的声音数据不会上传到任何 GitHub 仓库", 400)
        if len(blob) > MAX_PRIVATE:
            raise StoreError("加密包 %.1fMB 超过 %dMB 上限(GitHub API 限制与仓库体积考虑);请使用 Kaggle 输出保存" % (len(blob) / 1048576, MAX_PRIVATE >> 20), 413)
        info = self.repo_info(self.private_repo)
        if not info["private"]:
            raise StoreError("目标仓库 %s 是【公开】的:拒绝上传声音数据(本系统不会更改仓库可见性)" % self.private_repo, 403)
        safe = re.sub(r"[^A-Za-z0-9._-]", "_", name)[:80]
        res = self._commit(self.private_repo, info, {"vc-data/" + safe: blob}, "backup: encrypted voice libraries")
        self.state.update(last_private_push=now_iso())
        atomic_write_json(self.f, self.state)
        return res

    # —— 设置 / 状态 ——
    def set_auto(self, enabled, interval_min=30):
        self.settings.update(auto=bool(enabled), interval_min=max(10, min(1440, int(interval_min))))
        atomic_write_json(self.f, self.state)
        return self.settings

    def status(self):
        return {"configured": bool(self._token), "repo": self.repo, "private_repo_configured": bool(self.private_repo), "settings": self.settings, "last_sync": self.state.get("last_sync"),
                "last_result": self.state.get("last_result"), "last_error": self.state.get("last_error"), "pending_events": len(self.audit.pending()),
                "policy": "公开仓库只接收脱敏审计/汇总;声音数据只能是加密包并且只进已核实为私有的仓库。Token 仅在服务端使用。"}

    def auto_due(self):
        if not (self.settings.get("auto") and self._token):
            return False
        last = self.state.get("last_auto_ts", 0)
        return time.time() - last >= self.settings["interval_min"] * 60 and bool(self.audit.pending())

    def auto_run(self):
        self.state["last_auto_ts"] = time.time()
        try:
            pv = self.preview()
            if not pv["vetted"]:
                raise StoreError("预检未通过: " + "; ".join(pv["problems"][:2]))
            return self.sync(pv["preview_id"])
        except Exception as e:  # noqa: BLE001
            self.state["last_error"] = {"t": now_iso(), "error": type(e).__name__ + ": " + str(e)[:200]}
            atomic_write_json(self.f, self.state)
            raise
'''

