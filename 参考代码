FILES['libctl.py'] = r'''# -*- coding: utf-8 -*-
"""
libctl.py —— 启动脚本与语音库之间的训练桥(命令行)

  python libctl.py prepare --lib-dir D            取出下一个排队的训练任务(并标记 running),打印 JSON:{job_id, library_id, data_dir, val_n} 或 {"none": true}
  python libctl.py finish  --lib-dir D --job J --lib L --model-dir M --train-state F    登记候选模型(算 sha256);留出验证证据来自 train_state.json;状态变为 candidate_ready(尚未升级!)
  python libctl.py fail    --lib-dir D --job J --lib L --note "原因"
  训练期间新增的样本不会改变本次任务的冻结数据集;候选模型要经 验证 + 加载 + 试合成 三项证据才能升级(见网页「语音库」)。
"""
import argparse
import json
import math
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import libraries as libs  # noqa: E402


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["prepare", "finish", "fail"])
    ap.add_argument("--lib-dir", required=True)
    ap.add_argument("--job")
    ap.add_argument("--lib")
    ap.add_argument("--model-dir")
    ap.add_argument("--train-state")
    ap.add_argument("--note", default="")
    a = ap.parse_args()
    st = libs.LibraryStore(a.lib_dir, min_free_mb=1)
    if a.cmd == "prepare":
        lid, job = st.next_queued_job()
        if not job:
            print(json.dumps({"none": True}))
            return 0
        lib = st.get(lid)
        ds = next(d for d in lib["datasets"] if d["version"] == job["dataset_version"])
        st.job_set(lid, job["job_id"], "running", "训练开始(冻结数据集 v%d)" % ds["version"])
        print(json.dumps({"job_id": job["job_id"], "library_id": lid, "data_dir": ds["dir"], "val_n": sum(1 for i in ds["samples"] if i["split"] == "val"), "version": ds["version"]}))
        return 0
    if a.cmd == "finish":
        ts = {}
        try:
            ts = json.loads(Path(a.train_state).read_text(encoding="utf-8"))
        except Exception:  # noqa: BLE001
            pass
        lib = st.get(a.lib)
        job = next(j for j in lib["jobs"] if j["job_id"] == a.job)
        ds = next(d for d in lib["datasets"] if d["version"] == job["dataset_version"])
        bv = ts.get("best_val_loss")
        summary = {"val_loss_finite": isinstance(bv, (int, float)) and math.isfinite(bv), "best_val_loss": bv, "holdout_n": sum(1 for i in ds["samples"] if i["split"] == "val"),
                   "ddp_check": ts.get("ddp_check"), "gpus": ts.get("gpus"), "note": "证据来自 train_state.json;DDP 是否真为 2 卡同步训练见 ddp_check.world_size(未在这里声称)"}
        c = st.register_candidate(a.lib, a.job, a.model_dir, summary)
        print(json.dumps({"candidate_id": c["candidate_id"], "model_sha256": c["model_sha256"], "validated": c["validated"]}))
        return 0
    st.job_set(a.lib, a.job, "failed", a.note or "训练失败")
    print(json.dumps({"ok": True}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
'''

