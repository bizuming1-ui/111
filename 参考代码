def net_preflight():
    """对每个通道发 1 次真实 GET:区分「可用 / 被站点限制(401/403/429/验证页)/ 网络不可达」。结果写入 vc_net_preflight.json。
    这是体检,不是加速器:被限制就如实告诉你,运行期该站点会进入冷却而不是被反复请求或绕过。"""
    import urllib.error
    targets = [("Bing 网页搜索", "https://www.bing.com/search?q=test&setlang=en"), ("DuckDuckGo HTML", "https://html.duckduckgo.com/html/?q=test"),
               ("维基百科 API", "https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=test&format=json"), ("HuggingFace(模型下载)", "https://huggingface.co")]
    rows = []
    for name, url in targets:
        t0 = time.time()
        row = {"name": name, "url": url.split("?")[0]}
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"})
            with urllib.request.urlopen(req, timeout=12) as resp:
                body = resp.read(4000).decode("utf-8", "ignore").lower()
                row["status"] = resp.status
                row["verdict"] = "restricted" if (resp.status == 202 or "captcha" in body or "unusual traffic" in body) else "ok"
        except urllib.error.HTTPError as e:
            row["status"], row["verdict"] = e.code, ("restricted" if e.code in (401, 403, 429) else "error")
            row["retry_after"] = e.headers.get("Retry-After")
        except Exception as e:
            row["status"], row["verdict"], row["error"] = None, "unreachable", (str(getattr(e, "reason", e)) or type(e).__name__)[:80]
        row["ms"] = int((time.time() - t0) * 1000)
        rows.append(row)
    label = {"ok": "✅ 可用", "restricted": "⛔ 被站点限制(不绕过;运行时该站点会冷却并如实提示)", "unreachable": "❌ 网络不可达(检查 Settings → Internet 是否为 On)", "error": "⚠ 异常响应"}
    for r_ in rows:
        print("  %-22s %-34s HTTP %-5s %5d ms  %s" % (r_["name"], r_["url"][:34], r_["status"], r_["ms"], label.get(r_["verdict"], r_["verdict"])))
    try:
        (OUT / "vc_net_preflight.json").write_text(json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "rows": rows}, ensure_ascii=False, indent=1), encoding="utf-8")
    except Exception:
        pass
    return rows


