        @app.post("/api/libs/{lid}/samples")
        @guard
        async def api_sample_add(lid: str, request: Request):
            """上传/录制新样本(追加,不覆盖)。先质检;有阻断项且 ack=0 时只返回质检结果,不保存。"""
            q = request.query_params
            lib = P.store.get(lid)
            if q.get("consent") == "1":
                P.store.set_consent(lid, True)
            elif not lib["consent"]["confirmed"]:
                return err("请先确认:这是你本人的声音,或已获得声音所有者的明确授权", 400)
            data = await request.body()
            P.store.check_capacity(len(data))
            text, ack = (q.get("text") or "").strip(), q.get("ack") == "1"
            ext = re.sub(r"[^a-z0-9]", "", (q.get("ext") or "bin").lower())[:5] or "bin"
            try:
                a, sr, ch = await G["LOOP"].run_in_executor(None, G["decode_audio"], data)
            except Exception as e:  # noqa: BLE001
                return err("无法解码音频(文件损坏或格式不支持):%s" % str(e)[:100], 415)
            if len(a) / sr > P.store.max_seconds:
                return err("音频 %.0f 秒超过单条上限 %d 秒" % (len(a) / sr, P.store.max_seconds), 413)
            proc, cropped = await G["LOOP"].run_in_executor(None, G["prepare_reference"], a, sr)
            qc = await G["LOOP"].run_in_executor(None, lambda: G["aq"].reference_qc(proc, G["SR"], orig_sr=sr, channels=ch, text=text or None))
            notes = []
            if cropped:
                notes.append("超过 30 秒:处理版在安静处截断(原件完整保留)")
                text = ""
                qc["warnings"].append("音频超过 30 秒,处理版已截断,原件完整保留;文字不再严格对应,请重新转写核对")
            if qc["kind"] == "clean_speech" and P.workers_ready() and not G.get("MOCK"):
                tmp = P.work / ("lib_qc_%s.wav" % secrets.token_hex(3))
                G["write_wav"](tmp, proc, G["SR"])
                res, e = await G["ask_worker"]("spk_qc", str(tmp), 60)
                tmp.unlink(missing_ok=True)
                if res and not e:
                    qc["speaker_check"] = res
                    if res.get("suspect"):
                        qc.update(kind="multi_speaker", kind_zh="疑似多人说话", blocking=True)
                        qc["warnings"].append("疑似多人说话(启发式,阈值未校准)")
                    elif res.get("status") in ("failed", "skipped"):
                        qc["warnings"].append("多人检测未运行(%s):%s" % (res["status"], res.get("reason", "")[:160]))
                elif e:
                    qc["warnings"].append("多人检测未运行:%s" % str(e)[:160])
            if qc["blocking"] and not ack:
                return {"ok": False, "needs_ack": True, "qc": qc, "message": "质检发现问题,未保存。确认仍要保存(会标记为不参与口语训练)请带 ack=1。"}
            s = await G["LOOP"].run_in_executor(None, lambda: P.store.add_sample(lid, data, ext, wav_bytes_mono16(proc, G["SR"]), len(proc) / G["SR"], sr, ch, qc, text,
                                                                             "user" if text else "", bool(text), session=q.get("session") or None, notes=notes))
            P.mark()
            P.audit.event("sample_add", "ok", None, sid_of(request), seconds=round(len(proc) / G["SR"], 1), kind=qc["kind"])
            out = {"ok": True, "sample": P.store.public_sample(s), "qc": qc}
            if q.get("activate") == "1":
                P.store.set_active(lid)
                if s["category"] == "speech":
                    P.store.set_ref(lid, s["sample_id"])
                out["activation"] = await P.activate(lid)
            if q.get("train") == "1":
                try:
                    out["job"] = P.store.create_job(lid, {})
                except StoreError as e:
                    out["job_error"] = str(e)
            return out

