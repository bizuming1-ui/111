def _f2pcm(a):
    if hasattr(a, "detach"):
        a = a.detach().float().cpu().numpy()
    a = np.nan_to_num(np.asarray(a, dtype=np.float32).reshape(-1))
    return (np.clip(a, -1, 1) * 32767.0).round().astype("<i2")


class MockEngine:
    name = "mock"

    def __init__(self, idx, send):
        self.idx, self.send = idx, send
        self.dtype = "mock"

    def load(self):
        time.sleep(0.5)

    def set_voice(self, path, text, xvec):
        time.sleep(0.4)
        return {"rtf": 0.4, "ttfa": 0.2, "dtype": "mock", "sr": SR, "mode": "mock"}

    def stream(self, text, chunk_size):
        speed = float(os.environ.get("VC_MOCK_SPEED", "0.45"))      # 合成耗时 / 音频时长
        dur = max(0.6, len(text) * 0.2)
        f0 = 140 + (sum(map(ord, text)) % 5) * 25
        lead, tail = 0.18, 0.22
        total = lead + dur + tail
        step = chunk_size / 12.0
        t0 = 0.0
        time.sleep(0.25)
        while t0 < total:
            d = min(step, total - t0)
            time.sleep(d * speed)
            t = np.arange(int(SR * d)) / SR + t0
            sig = sum(np.sin(2 * np.pi * f0 * h * t) / h for h in range(1, 6))
            env = ((t > lead) & (t < lead + dur)) * (0.6 + 0.4 * np.sin(2 * np.pi * 3 * t))
            yield (0.25 * sig * env).astype(np.float32), SR
            t0 += d

    def asr(self, path):
        return "这是一段模拟识别的参考文本"


class RealEngine:
    """Qwen3-TTS-12Hz-1.7B-Base。优先用 faster-qwen3-tts(CUDA Graph + 流式);失败则回退到官方 qwen-tts(整句合成)。"""
    name = "qwen3-tts"

    def __init__(self, idx, send):
        self.idx, self.send = idx, send
        self.fast = None
        self.slow = None
        self.dtype = None
        self.ref = None
        self.prompt = None
        self._asr = None
        self.sr = SR
        self.mode = ""
        self.order = []

    def say(self, stage, msg):
        self.send("status", self.idx, stage, msg)
        log.info("[GPU%d] %s", self.idx, msg)

    def load(self, force_dtype=None):
        import torch
        if not torch.cuda.is_available():
            raise RuntimeError("PyTorch 看不到 GPU(请在 Kaggle 右侧 Settings 里把 Accelerator 选成 GPU T4 x2)")
        major = torch.cuda.get_device_capability(0)[0]
        order = ["bfloat16", "float16"] if major >= 8 else ["float16", "bfloat16"]     # T4(sm75) 没有 bf16 张量核,优先 fp16
        self.order = order
        self.dtype = force_dtype or order[0]
        dt = getattr(torch, self.dtype)
        self.say("loading", "加载 %s (%s)…" % (MODEL.split("/")[-1], self.dtype))
        t0 = time.time()
        try:
            from faster_qwen3_tts import FasterQwen3TTS
            self.fast = FasterQwen3TTS.from_pretrained(MODEL, device="cuda", dtype=dt, attn_implementation="sdpa", max_seq_len=2048)
            self.say("loading", "捕获 CUDA Graph…")
            try:
                self.fast.warmup()
            except Exception as e:  # noqa: BLE001
                log.warning("[GPU%d] warmup 失败(首次合成时会自动捕获): %s", self.idx, e)
            self.sr = int(getattr(self.fast, "sample_rate", SR) or SR)
            self.slow = None
            mode = "CUDA Graph 流式"
        except Exception as e:  # noqa: BLE001
            log.warning("[GPU%d] faster-qwen3-tts 不可用,回退官方 qwen-tts 整句模式: %s", self.idx, e)
            log.warning(traceback.format_exc())
            self.fast = None
            from qwen_tts import Qwen3TTSModel
            try:
                self.slow = Qwen3TTSModel.from_pretrained(MODEL, device_map="cuda:0", dtype=dt, attn_implementation="sdpa")
            except TypeError:
                self.slow = Qwen3TTSModel.from_pretrained(MODEL, device_map="cuda:0", torch_dtype=dt, attn_implementation="sdpa")
            mode = "官方整句模式(较慢)"
        self.mode = mode
        self.say("loaded", "模型就绪 · %s · %.0fs" % (mode, time.time() - t0))

    def _free(self):
        import gc
        import torch
        self.fast = None
        self.slow = None
        self.prompt = None
        gc.collect()
        torch.cuda.empty_cache()

    def _make_prompt(self, path, text, xvec):
        self.ref = (path, text, bool(xvec))
        self.prompt = None
        if self.fast is None and self.slow is not None:
            self.prompt = self.slow.create_voice_clone_prompt(ref_audio=path, ref_text=("" if xvec else text), x_vector_only_mode=bool(xvec))

    def set_voice(self, path, text, xvec):
        self._make_prompt(path, text, xvec)
        bad = None
        for attempt in range(2):
            t0 = time.time()
            first, parts = None, []
            for a, sr in self.stream("你好，我已经准备好了。", 8):
                if first is None:
                    first = time.time() - t0
                parts.append(_f2pcm(a))
            wall = time.time() - t0
            pcm = np.concatenate(parts) if parts else np.zeros(0, np.int16)
            dur = len(pcm) / SR
            ok = len(pcm) > SR * 0.3 and float(np.sqrt((pcm.astype(np.float32) ** 2).mean())) > 90
            if ok:
                return {"rtf": round(wall / max(dur, 1e-3), 2), "ttfa": round(first or wall, 2), "dtype": self.dtype, "mode": self.mode, "sr": self.sr}
            bad = "试合成的声音是空的/无声(精度 %s)" % self.dtype
            alt = [d for d in self.order if d != self.dtype]
            if attempt == 0 and alt:
                self.say("loading", "%s 精度输出异常,改用 %s 重新加载…" % (self.dtype, alt[0]))
                self._free()
                self.load(force_dtype=alt[0])
                self._make_prompt(path, text, xvec)
        raise RuntimeError(bad or "试合成失败")

    def stream(self, text, chunk_size):
        path, ref_text, xvec = self.ref
        lang = detect_lang(text)
        max_new = max(120, int(len(text) * 7))
        if self.fast is not None:
            for a, sr, _timing in self.fast.generate_voice_clone_streaming(
                    text=text, language=lang, ref_audio=path, ref_text=ref_text, chunk_size=chunk_size,
                    xvec_only=xvec, temperature=0.8, top_k=50, repetition_penalty=1.05, max_new_tokens=max_new):
                yield a, sr
        else:
            wavs, sr = self.slow.generate_voice_clone(text=text, language=lang, voice_clone_prompt=self.prompt, max_new_tokens=max_new)
            yield wavs[0], sr

    def asr(self, path):
        import soundfile as sf
        import torch
        if self._asr is None:
            from transformers import pipeline
            self.say("loading", "加载语音识别模型 whisper-small…")
            try:
                self._asr = pipeline("automatic-speech-recognition", model="openai/whisper-small", device=0, dtype=torch.float16)
            except TypeError:
                self._asr = pipeline("automatic-speech-recognition", model="openai/whisper-small", device=0, torch_dtype=torch.float16)
        a, sr = sf.read(path, dtype="float32", always_2d=False)
        if a.ndim > 1:
            a = a.mean(axis=1)
        if sr != 16000:
            n = int(len(a) * 16000 / sr)
            a = np.interp(np.linspace(0, len(a) - 1, n), np.arange(len(a)), a).astype(np.float32)
        out = self._asr({"raw": a, "sampling_rate": 16000})
        return (out.get("text") or "").strip()


def worker_main(idx, gpu, job_q, res_q, epoch, cfg):
    """每张 GPU 一个进程。必须在 import torch 之前设置 CUDA_VISIBLE_DEVICES。"""
    if not cfg.get("mock"):
        os.environ["CUDA_VISIBLE_DEVICES"] = str(gpu)
        os.environ.setdefault("TOKENIZERS_PARALLELISM", "false")

    def send(*m):
        res_q.put(m)

    try:
        eng = MockEngine(idx, send) if cfg.get("mock") else RealEngine(idx, send)
        send("status", idx, "loading", "启动中…")
        eng.load()
        send("status", idx, "ready", "就绪")
    except Exception as e:  # noqa: BLE001
        log.error("[GPU%d] 引擎加载失败:\n%s", idx, traceback.format_exc())
        send("status", idx, "error", "%s: %s" % (type(e).__name__, e))
        return
    parent = mp.parent_process()
    while True:
        try:
            job = job_q.get(timeout=2)
        except _queue.Empty:
            if parent is not None and not parent.is_alive():
                return
            continue
        kind = job[0]
        if kind == "quit":
            return
        try:
            if kind == "voice":
                _, vid, path, text, xvec = job
                send("status", idx, "voice", "提取声音特征并试合成…")
                info = eng.set_voice(path, text, xvec)
                send("voice_ok", idx, vid, info)
                send("status", idx, "ready", "就绪")
            elif kind == "asr":
                _, rid, path = job
                send("status", idx, "voice", "识别参考音频文字…")
                try:
                    txt = eng.asr(path)
                    send("asr", rid, txt, "")
                except Exception as e:  # noqa: BLE001
                    log.error("[GPU%d] 识别失败: %s", idx, e)
                    send("asr", rid, "", "%s: %s" % (type(e).__name__, e))
                send("status", idx, "ready", "就绪")
            elif kind == "tts":
                _, tuid, ep, seg, text, cs = job
                if epoch.value != ep:
                    send("seg_done", tuid, seg, idx, {"skipped": True})
                    continue
                t0, first, nsamp = time.time(), None, 0
                gen = eng.stream(text, cs)
                try:
                    for a, sr in gen:
                        if epoch.value != ep:
                            break
                        pcm = _f2pcm(a)
                        if first is None:
                            first = time.time() - t0
                        nsamp += len(pcm)
                        send("chunk", tuid, seg, pcm.tobytes())
                finally:
                    try:
                        gen.close()
                    except Exception:  # noqa: BLE001
                        pass
                wall = time.time() - t0
                send("seg_done", tuid, seg, idx, {"first": first, "wall": wall, "audio": nsamp / SR})
        except Exception as e:  # noqa: BLE001
            log.error("[GPU%d] 任务出错:\n%s", idx, traceback.format_exc())
            if kind == "voice":
                send("voice_err", idx, job[1], "%s: %s" % (type(e).__name__, e))
                send("status", idx, "ready", "就绪(声音设置失败)")
            elif kind == "tts":
                send("seg_err", job[1], job[3], idx, "%s: %s" % (type(e).__name__, e))
            elif kind == "asr":
                send("asr", job[1], "", str(e))


