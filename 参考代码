async def send_event(ws, **payload):
    await ws.send_text(json.dumps(payload, ensure_ascii=False))


def synth_blocking(segments, first_index, loop, queue, cancel):
    """【在线程池里运行】逐句调用 XTTS 流式合成,把结果经 queue 交还给事件循环。"""
    def put(item):
        try:
            loop.call_soon_threadsafe(queue.put_nowait, item)
        except RuntimeError:        # 事件循环已关闭
            cancel.set()

    try:
        while not GPU_LOCK.acquire(timeout=0.2):      # 等待上一个任务释放 GPU,同时响应取消
            if cancel.is_set():
                return
        try:
            for idx in range(first_index, len(segments)):
                if cancel.is_set():
                    break
                t0, first = time.time(), None
                for chunk in ENGINE.stream(segments[idx]):
                    if cancel.is_set():
                        break
                    if first is None:
                        first = time.time() - t0
                        if idx == first_index:
                            STATS["first_chunk_ms"] = round(first * 1000)
                    pcm = to_pcm16(chunk)
                    if pcm:
                        put(("pcm", pcm))
                else:
                    put(("sentence_done", idx))
        finally:
            GPU_LOCK.release()
    except Exception as e:  # noqa: BLE001
        log.exception("合成出错")
        STATS["last_error"] = str(e)
        put(("error", "%s: %s" % (type(e).__name__, e)))
    finally:
        put(("end", None))


async def run_request(ws, req_id, text, start_sentence, cancel):
    """处理一次合成请求:线程池合成 -> 4096 字节分块发送 -> 发送结束标记"""
    loop = asyncio.get_running_loop()
    queue = asyncio.Queue()
    future = None
    try:
        segments = split_text(text)
        if not segments:
            await send_event(ws, event="error", id=req_id, message="文本里没有可朗读的内容")
            return
        start_sentence = max(0, min(int(start_sentence or 0), len(segments)))
        await send_event(ws, event="start", id=req_id, sentences=len(segments),
                         sample_rate=SAMPLE_RATE, voice=voice_label())
        STATS["requests"] += 1
        log.info("[#%s] 开始合成: %d 字 / %d 句 (从第 %d 句)", req_id, len(text), len(segments), start_sentence)
        # ★ 同步 TTS 放进线程池,不阻塞事件循环
        future = loop.run_in_executor(None, synth_blocking, segments, start_sentence, loop, queue, cancel)
        failed, sent_bytes = False, 0
        while True:
            kind, payload = await queue.get()
            if kind == "pcm":
                for off in range(0, len(payload), CHUNK_SIZE):           # ★ 4096 字节分块
                    await ws.send_bytes(payload[off:off + CHUNK_SIZE])
                    await asyncio.sleep(0)                               # ★ 让出事件循环(心跳/取消消息才能被处理)
                sent_bytes += len(payload)
            elif kind == "sentence_done":
                await send_event(ws, event="sentence_done", id=req_id, index=payload)
            elif kind == "error":
                failed = True
                await send_event(ws, event="error", id=req_id, message=payload)
            elif kind == "end":
                break
        if not failed and not cancel.is_set():
            await send_event(ws, event="done", id=req_id)                # ★ 结束标记
            log.info("[#%s] 完成: 音频 %.1fs", req_id, sent_bytes / 2 / SAMPLE_RATE)
        elif cancel.is_set():
            log.info("[#%s] 已取消", req_id)
    except (WebSocketDisconnect, RuntimeError):
        cancel.set()
        log.info("[#%s] 客户端已断开,合成中止", req_id)
    except asyncio.CancelledError:
        cancel.set()
        raise
    except Exception as e:  # noqa: BLE001
        cancel.set()
        log.exception("请求处理异常")
        try:
            await send_event(ws, event="error", id=req_id, message="%s: %s" % (type(e).__name__, e))
        except Exception:  # noqa: BLE001
            pass
    finally:
        cancel.set()            # 保证线程里的生成循环会退出
        if future is not None:
            try:
                await future
            except Exception:  # noqa: BLE001
                pass


@app.websocket("/stream")
async def stream(ws: WebSocket):
    await ws.accept()
    peer = "%s:%s" % (ws.client.host, ws.client.port) if ws.client else "?"
    log.info("WebSocket 已连接: %s", peer)
    task, cancel = None, None

    async def abort_current():
        nonlocal task, cancel
        if task is not None:
            cancel.set()
            try:
                await task
            except Exception:  # noqa: BLE001
                pass
            task = None

    try:
        while True:
            message = await ws.receive()
            if message["type"] == "websocket.disconnect":
                raise WebSocketDisconnect(message.get("code", 1000))
            raw = message.get("text")
            if raw is None:
                continue                                    # 忽略客户端发来的二进制
            try:
                msg = json.loads(raw)
            except ValueError:
                await send_event(ws, event="error", message="请求不是合法的 JSON")
                continue
            if not isinstance(msg, dict) or "ping" in msg:  # ★ 心跳包:直接忽略
                continue
            if msg.get("stop"):
                await abort_current()
                continue
            text = str(msg.get("text") or "").strip()
            req_id = msg.get("id")
            if not text:
                await send_event(ws, event="error", id=req_id, message="文本为空")
                continue
            if len(text) > MAX_TEXT_CHARS:
                await send_event(ws, event="error", id=req_id, message="文本太长(最多 %d 字)" % MAX_TEXT_CHARS)
                continue
            await abort_current()                           # 新请求打断旧请求;旧帧一定先于新的 start 事件发完
            cancel = threading.Event()
            task = asyncio.create_task(run_request(ws, req_id, text, msg.get("start_sentence", 0), cancel))
    except WebSocketDisconnect:
        log.info("WebSocket 已断开: %s", peer)               # ★ 断开时打印日志
    except Exception as e:  # noqa: BLE001
        log.warning("WebSocket 异常: %s: %s", type(e).__name__, e)
    finally:
        await abort_current()


