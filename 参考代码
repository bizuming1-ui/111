});
if (navigator.mediaDevices && navigator.mediaDevices.addEventListener) navigator.mediaDevices.addEventListener("devicechange", () => { S.devChanges++; log("音频设备列表变化(插拔/蓝牙切换),尝试恢复 AudioContext;设备采样率变化后的行为:未验证", "w"); if (PE.ctx && PE.ctx.state !== "running") PE.ctx.resume().catch(() => {}); renderDiag(); });

function onBin(buf) {
