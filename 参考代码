        err, warn = [], []
        rep = {"samples": self.n, "sr": self.sr, "chunks": len(self.joins) + (1 if self.n else 0)}
        if self.n == 0:
            err.append("没有产生任何音频")
        if pcm is not None and pcm.size:
            x = pcm.astype(np.float32)
            r = frame_rms(x, self.FR)
            peak = float(np.abs(x).max())
            voiced_frac = float((r >= 110.0).mean()) if r.size else 0.0
            sp = r[r >= max(110.0, float(np.percentile(r, 90)) * 0.12)] if r.size else r
            speech_rms = float(np.sqrt((sp ** 2).mean())) if sp.size else 0.0
            clip = float((np.abs(x) >= 32000).mean())
            rep.update(peak_dbfs=round(db(peak / 32768.0), 2), speech_rms_dbfs=round(db(speech_rms / 32768.0), 2),
                       voiced_frac=round(voiced_frac, 3), clip_ratio=round(clip, 5), dur_s=round(self.n / self.sr, 3))
            if speech_rms < 60 or voiced_frac < 0.04:
                err.append("音频近似无声(有声帧 %.1f%%)" % (voiced_frac * 100))
            if clip > 0.01:
                err.append("严重削波(%.2f%% 样本贴近满幅)" % (clip * 100))
            elif clip > 0.002:
                warn.append("轻微削波(%.2f%%)" % (clip * 100))
            tail = r[-2:].mean() if r.size >= 2 else 0.0
            if hit_max or (frames is not None and frames <= 0):
                err.append("疑似被 max_new_tokens 截断(生成未自然结束)")
            elif speech_rms > 0 and tail > 0.6 * speech_rms and self.n / self.sr > 1.0:
                warn.append("结尾仍有较大能量,可能被截断")
        if frames:
            exp = frames * spf
            if self.n and abs(self.n - exp) / max(self.n, 1) > 0.03:
                err.append("样本数 %d 与 %d 帧×%d=%d 不符(%.1f%%)" % (self.n, frames, spf, exp, abs(self.n - exp) / max(self.n, 1) * 100))
        bad_join = [j for j in self.joins if j[1] > 25 and j[0] > 6000]
        mild = [j for j in self.joins if j[1] > 10 and j[0] > 1500]
        rep["max_join_jump"] = round(max([j[0] for j in self.joins] or [0.0]), 1)
        rep["max_join_ratio"] = round(max([j[1] for j in self.joins] or [0.0]), 2)
        if bad_join:
            err.append("%d 个 chunk 边界波形断裂(最大跳变 %.0f)" % (len(bad_join), max(j[0] for j in bad_join)))
        elif mild:
            warn.append("%d 个 chunk 边界有轻微跳变" % len(mild))
        if len(self.chunk_db) >= 3:
            d = np.abs(np.diff(self.chunk_db))
            rep["max_chunk_loudness_step_db"] = round(float(d.max()), 2)
            if d.max() > 12:
                warn.append("相邻块响度突变 %.1f dB" % d.max())
        rep["errors"], rep["warnings"] = err, warn
        return rep


def save_diag(dirpath, tag, pcm, report, sr=SR):
    """损坏音频的诊断快照:WAV + JSON。返回 WAV 路径(失败返回 '')"""
    try:
        d = Path(dirpath)
        d.mkdir(parents=True, exist_ok=True)
        base = d / ("%s_%s" % (time.strftime("%H%M%S"), "".join(c if c.isalnum() else "_" for c in tag)[:40]))
        if pcm is not None and len(pcm):
            with wave.open(str(base) + ".wav", "wb") as w:
