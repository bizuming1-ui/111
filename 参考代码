  }
  thr() { return { hi: Math.max(0.018, this.floor * 4), lo: Math.max(0.009, this.floor * 2) }; }
  start(now) { this.t0 = now; }
  feed(rms, now) {
    if (this.t0 === null) this.t0 = now;
    if (this.done) return { action: "none", state: this.state };
    const th = this.thr();
    if (!this.voiced) {
      if (rms < th.hi) { this.nCal++; this.floor = this.nCal <= 5 ? (this.floor * (this.nCal - 1) + rms) / this.nCal : this.floor * 0.95 + rms * 0.05; if (this.nCal === 1) this.floor = Math.max(0.0005, rms); }
