<script>
"use strict";
/* ======================= 配置参数(方便调整) ======================= */
const WS_URL = "{{WS_URL}}";                          // 由 Notebook Cell 4 自动替换成 wss://xxx.ngrok-free.app/stream
const SAMPLE_RATE = 24000;                            // 与 XTTS 输出一致,AudioContext 不再重采样
const START_THRESHOLD_BYTES = SAMPLE_RATE * 2 * 0.2;  // 收到 200ms 音频(16bit 单声道)后开始播放;调小=更快出声,调大=更不易断
const TARGET_BUFFER_MS = 500;                         // 目标缓冲区大小(进度条 100% = 500ms)
const LOW_WATER_MS = 50;                              // 低水位阈值:低于它视为"缓冲偏低",立刻不攒批地逐帧送入
const HEARTBEAT_INTERVAL = 20000;                     // 心跳间隔(ms),防止 ngrok 空闲断开
const RECONNECT_DELAY = 3000;                         // 断线后等待多久自动重连(ms)
/* —— 下面是稳定性增强参数(一般不用动) —— */
const MAX_RETRIES = 10;                               // 一次合成中最多自动重连次数
const MAX_PREBUFFER_MS = 1500;                        // 自适应起播缓冲的上限
const REBUFFER_TIMEOUT_MS = 2000;                     // 断流后重新攒缓冲最多等多久,超时就先播
const CONNECT_TIMEOUT_MS = 15000;                     // WebSocket 握手超时

/* ======================= DOM ======================= */
const $ = (id) => document.getElementById(id);
const el = { text: $("text"), speak: $("speak"), stop: $("stop"), dot: $("dot"), status: $("status"),
  fill: $("fill"), bufText: $("bufText"), conn: $("conn"), first: $("first"), pre: $("pre"),
  under: $("under"), count: $("count") };

/* ======================= 状态 ======================= */
let audioCtx = null;
let nextPlayTime = 0;                 // ★ 下一块音频应该开始播放的时刻(AudioContext 时间轴),保持连续
const sources = new Set();            // 已排队/正在播放的 BufferSource
let accChunks = [], accBytes = 0;     // ★ accBuffer:累积区
let ws = null, hbTimer = null, reconnectTimer = null, connectTimer = null;
let session = null, seq = 0;
let prebufferMs = loadPrebuffer();    // 自适应起播缓冲(起播时需要攒够的毫秒数)

function loadPrebuffer() {
  try { const v = +localStorage.getItem("vc_prebuffer"); if (v >= 200 && v <= MAX_PREBUFFER_MS) return v; } catch (e) {}
  return START_THRESHOLD_BYTES / (SAMPLE_RATE * 2) * 1000;
}
function savePrebuffer() { try { localStorage.setItem("vc_prebuffer", String(Math.round(prebufferMs))); } catch (e) {} }
const baseMs = START_THRESHOLD_BYTES / (SAMPLE_RATE * 2) * 1000;

/* ======================= UI ======================= */
function setStatus(kind, text) { el.dot.className = "dot " + kind; el.status.textContent = text; }
function setConn(kind, text) { el.conn.className = kind; el.conn.textContent = text; }
function busy() { return !!(session && !session.finished); }
function refreshButtons() { el.speak.disabled = busy(); el.stop.disabled = !busy(); }
el.text.addEventListener("input", () => { el.count.textContent = el.text.value.length + " / 2000"; });
el.count.textContent = el.text.value.length + " / 2000";
el.text.addEventListener("keydown", (e) => { if ((e.ctrlKey || e.metaKey) && e.key === "Enter") speak(); });

/* ======================= AudioContext 管理 ======================= */
function ensureCtx() {                // 每次操作前调用:closed 就重建,suspended 就 resume
  if (!audioCtx || audioCtx.state === "closed") {
    const AC = window.AudioContext || window.webkitAudioContext;
    try { audioCtx = new AC({ sampleRate: SAMPLE_RATE }); } catch (e) { audioCtx = new AC(); }
    nextPlayTime = 0; sources.clear();
  }
  if (audioCtx.state === "suspended") { audioCtx.resume().catch(() => {}); }
  return audioCtx;
}
document.addEventListener("visibilitychange", () => {
  if (document.visibilityState === "visible") {
    if (audioCtx) ensureCtx();
    if (!ws && !reconnectTimer) connect();
  }
});

/* ======================= 音频排队播放(零停顿核心) ======================= */
function takeAcc() {                  // 取出累积区(偶数字节),奇数多出的 1 字节留到下次
  const merged = new Uint8Array(accBytes);
  let o = 0;
  for (const c of accChunks) { merged.set(c, o); o += c.length; }
  accChunks = []; accBytes = 0;
  const even = merged.length & ~1;
  if (even !== merged.length) { accChunks = [merged.slice(even)]; accBytes = 1; }
  return new Int16Array(merged.buffer.slice(0, even));
}
function dropAcc() { accChunks = []; accBytes = 0; }
function leadMs() { return audioCtx ? Math.max(0, (nextPlayTime - audioCtx.currentTime) * 1000) : 0; }

/* 把一段 16bit PCM 精确排到时间轴上。
   注: 服务端发的是裸 PCM(没有文件头),decodeAudioData 无法解码裸 PCM,所以这里直接把 Int16 转成 Float32 AudioBuffer。 */
function schedule(int16) {
  const n = int16.length;
  if (!n) return;
  const ctx = ensureCtx();
  const buf = ctx.createBuffer(1, n, SAMPLE_RATE);
  const ch = buf.getChannelData(0);
  for (let i = 0; i < n; i++) ch[i] = int16[i] / 32768;

  const now = ctx.currentTime;
  const remaining = nextPlayTime - now;           // 当前缓冲区剩余量(秒)
  let restart = false;
  if (remaining <= 0) {                           // 缓冲已经耗尽(或首次播放):把时间线拉回当前,防止在过去的时刻排队造成抢播/撕裂
    nextPlayTime = now + 0.01; restart = true;
  } else if (remaining < LOW_WATER_MS / 1000) {   // 低水位:缓冲偏低但时间线仍连续 → 保持连续,绝不重叠/跳音
    if (session) session.lowWater++;
  }
  if (restart) {                                  // 重新起播的第一块做 4ms 淡入,消除"咔"声
    const f = Math.min(n, Math.round(SAMPLE_RATE * 0.004));
    for (let i = 0; i < f; i++) ch[i] *= i / f;
  }
  const src = ctx.createBufferSource();
  src.buffer = buf;
  src.connect(ctx.destination);
  src.start(nextPlayTime);                        // ★ 精确排队,不是 start(0)
  nextPlayTime += buf.duration;                   // ★ 时间线连续推进
  sources.add(src);
  src.onended = () => sources.delete(src);

  if (session) {
    const wasDry = session.dry;
    session.dry = false;
    if (!session.played) {
      session.played = true;
      session.firstMs = Math.round(performance.now() - session.t0);
      el.first.textContent = session.firstMs + " ms";
      setStatus("play", "播放中…");
    } else if (wasDry) {
      setStatus("play", "播放中…");
    }
  }
}

/* 是否把累积区送去播放。force=true 用于句末/结束时清空尾巴 */
function tryFlush(force) {
  if (!session || !session.armed || accBytes < 2) return;
  const ctx = ensureCtx();
  const remaining = (nextPlayTime - ctx.currentTime) * 1000;
  if (!force) {
    if (remaining <= 0) {                         // 还没开播,或刚断流:攒够起播量再开(断流后用更大的缓冲重新起播,避免"播-停-播")
      if (accBytes < SAMPLE_RATE * 2 * prebufferMs / 1000) {
        if (!session.waitSince) session.waitSince = performance.now();
        return;
      }
    } else if (accBytes < START_THRESHOLD_BYTES && remaining >= TARGET_BUFFER_MS) {
      return;                                     // 缓冲充足:继续攒到阈值再一起排队
    }                                             // 缓冲不足目标值:逐帧立刻送入
  }
  session.waitSince = 0;
  schedule(takeAcc());
}

function stopPlayback() {
  for (const s of sources) { try { s.stop(); } catch (e) {} }
  sources.clear();
  nextPlayTime = 0;
  dropAcc();
}

/* ======================= WebSocket ======================= */
function resolveWsUrl() {
  // 页面由同一个 ngrok 隧道提供时,直接用当前地址推导,不会因为隧道换地址而失效;
  // 只有用 file:// 等方式本地打开时,才使用 Notebook 替换进来的 WS_URL。
  if (/^https?:$/.test(location.protocol) && location.host) {
    return (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/stream";
  }
  return WS_URL;
}
function clearHeartbeat() { if (hbTimer) { clearInterval(hbTimer); hbTimer = null; } }
function startHeartbeat() {
  clearHeartbeat();
  hbTimer = setInterval(() => {
    if (ws && ws.readyState === WebSocket.OPEN) { try { ws.send(JSON.stringify({ ping: Date.now() })); } catch (e) {} }
  }, HEARTBEAT_INTERVAL);
}

function connect() {
  if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) return;
  const url = resolveWsUrl();
  if (!url || url.indexOf("{{") !== -1) { setConn("bad", "地址无效"); setStatus("err", "WebSocket 地址无效,请重新运行 Notebook 的 Cell 4"); return; }
  setConn("wait", "连接中");
  let sock;
  try { sock = new WebSocket(url); } catch (e) { setConn("bad", "失败"); scheduleReconnect(); return; }
  ws = sock;
  sock.binaryType = "arraybuffer";
  clearTimeout(connectTimer);
  connectTimer = setTimeout(() => { if (ws === sock && sock.readyState === WebSocket.CONNECTING) { try { sock.close(); } catch (e) {} } }, CONNECT_TIMEOUT_MS);

  sock.onopen = () => {
    if (ws !== sock) return;
    clearTimeout(connectTimer);
    setConn("ok", "已连接");
    startHeartbeat();
    if (session && !session.finished && !session.sent) sendRequest();          // ★ 连接成功后立即发送合成请求
    else if (!busy()) setStatus("idle", "就绪,输入文字后点击「合成并播放」");
  };
  sock.onmessage = (ev) => {
    if (ws !== sock) return;
    if (typeof ev.data === "string") { let m; try { m = JSON.parse(ev.data); } catch (e) { return; } onJson(m); }
    else onBinary(ev.data);
  };
  sock.onerror = () => { /* 浏览器随后一定会触发 onclose,在那里统一处理重连 */ };
  sock.onclose = () => {
    clearTimeout(connectTimer);
    clearHeartbeat();                                                           // ★ 关闭前先清心跳
    if (ws !== sock) return;
    ws = null;
    setConn("bad", "已断开");
    if (session && !session.finished) scheduleResume(); else scheduleReconnect();
  };
}

function scheduleReconnect() {          // 空闲时的静默重连,保证随时可用
  if (reconnectTimer) return;
  reconnectTimer = setTimeout(() => { reconnectTimer = null; connect(); }, RECONNECT_DELAY);
}
function scheduleResume() {             // 合成过程中断线:等 RECONNECT_DELAY 后自动重新 speak(从未播完的那一句续传)
  if (reconnectTimer) return;
  if (session.retries >= MAX_RETRIES) { failSession("多次重连失败,请检查网络或 Notebook 是否仍在运行"); scheduleReconnect(); return; }
  session.retries++; session.armed = false; session.sent = false; dropAcc();
  setStatus("proc", "连接中断," + (RECONNECT_DELAY / 1000) + " 秒后自动重连(第 " + session.retries + "/" + MAX_RETRIES + " 次)…");
  reconnectTimer = setTimeout(() => { reconnectTimer = null; speak({ resume: true }); }, RECONNECT_DELAY);
}

function sendRequest() {
  session.id = ++seq; session.sent = true; session.armed = false;
  ws.send(JSON.stringify({ id: session.id, text: session.text, start_sentence: session.resumeFrom }));
}

function onBinary(data) {
  if (!session || !session.armed || session.streamDone || session.finished) return;   // 过期/无主的帧直接丢弃
  const u8 = new Uint8Array(data);
  accChunks.push(u8); accBytes += u8.length;
  tryFlush(false);
}

function onJson(m) {
  if (m.event === "start") {
    if (session && !session.finished && m.id === session.id) {
      session.armed = true; session.retries = 0;
      if (!session.played) setStatus("proc", "合成中…");
    }
    return;
  }
  if (!session || session.finished) return;
  if (m.event === "error") {
    if (m.id === undefined || m.id === null || m.id === session.id) { tryFlush(true); failSession(m.message || "服务端合成出错"); }
    return;
  }
  if (!session.armed || (m.id !== undefined && m.id !== session.id)) return;
  if (m.event === "sentence_done") { tryFlush(true); session.resumeFrom = m.index + 1; }   // 句末把尾巴也送出去,避免句间空隙
  else if (m.event === "done") { tryFlush(true); session.streamDone = true; }
}

/* ======================= 合成入口 ======================= */
function speak(opts) {
  opts = opts || {};
  ensureCtx();                                                                  // 必须在用户点击的同一调用栈里创建/恢复 AudioContext
  if (!opts.resume) {
    const text = el.text.value.trim();
    if (!text) { setStatus("err", "请先输入要朗读的文字"); return; }
    if (busy()) return;
    stopPlayback();
    session = { text, resumeFrom: 0, retries: 0, id: 0, armed: false, sent: false, played: false, streamDone: false,
      finished: false, underruns: 0, lowWater: 0, dry: false, waitSince: 0, firstMs: null, t0: performance.now() };
    el.first.textContent = "—"; el.under.textContent = "0";
    setStatus("proc", "正在合成…");
  } else {
    if (!session || session.finished) return;
    setStatus("proc", "正在重新连接并续传…");
  }
  refreshButtons();
  if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }
  if (ws && ws.readyState === WebSocket.OPEN) sendRequest();
  else if (!ws) connect();                                                       // 连上后由 onopen 发送请求
}

function failSession(msg) {
  if (!session) return;
  session.finished = true;
  setStatus("err", "出错:" + msg);
  refreshButtons();
}
function finishSession() {
  session.finished = true;
  if (session.underruns === 0) { prebufferMs = Math.max(baseMs, prebufferMs * 0.9); savePrebuffer(); }   // 顺畅就慢慢回落
  el.pre.textContent = Math.round(prebufferMs) + " ms";
  setStatus("idle", "播放完成" + (session.underruns ? "(中途断流 " + session.underruns + " 次,已自动加大缓冲)" : "") + ",可以再次合成");
  refreshButtons();
}

el.speak.addEventListener("click", () => speak());
el.stop.addEventListener("click", () => {
  if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }
  if (ws && ws.readyState === WebSocket.OPEN) { try { ws.send(JSON.stringify({ stop: true })); } catch (e) {} }
  stopPlayback();
  if (session) session.finished = true;
  session = null;
  setStatus("idle", "已停止");
  refreshButtons();
  if (!ws) scheduleReconnect();
});

/* ======================= 100ms 巡检:进度条 / 断流检测 / 结束判定 ======================= */
setInterval(() => {
  const lead = leadMs();
  const pct = Math.min(100, lead / TARGET_BUFFER_MS * 100);
  el.fill.style.width = pct + "%";
  el.bufText.textContent = Math.round(lead) + " ms";
  let cls = "fill";
  if (!busy() || !session.played) cls += " idle";
  else if (session.streamDone) cls += (pct < 20 ? " idle" : "");
  else if (pct < 20) cls += " danger";
  else if (pct < 50) cls += " low";
  el.fill.className = cls;

  if (!session || session.finished) return;
  const now = audioCtx ? audioCtx.currentTime : 0;
  const dry = session.played && nextPlayTime <= now;
  if (session.streamDone) {                       // 数据全部到齐:等排队的音频播完就算结束
    if (!session.played) { if (accBytes >= 2) tryFlush(true); else finishSession(); }   // 全程没有任何音频
    else if (dry && accBytes < 2) finishSession();
    return;
  }
