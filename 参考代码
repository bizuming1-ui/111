def v13_post(turn, seg, a, final=False):
    """M6:开启时用流式响度控制器取代 v12 的整卡常数增益;关闭时就是 v12 的 _apply_gain(逐字节一致)。"""
    if not v13_on("LEVEL"):
        return _apply_gain(a, GAIN.get(seg.worker, 1.0))
    lev = v13_ts(turn).level(v13_voice_rms(seg.worker))
    y = lev.process(a)
    if final and lev.carry.size:
        y = np.concatenate([y, lev.flush()])
    return y


def v15_post(turn, seg, a, final=False):
    """v15 样本连续流拼接:零段填充/跳变平滑/点击修复/扩展器/软限幅/TPDF。开关全关或模块缺失 → 原样返回(与 v14 逐字节一致)。
    任何异常只记日志并返回原音频:后处理永远不能让播放中断。"""
    if _v15 is None or not _v15.any_audio_on():
        return a
    try:
        st = getattr(seg, "v15", None)
        if st is None:
            fl = getattr(turn, "v15_floor", None)
            if fl is None:
                fl = turn.v15_floor = _v15.FloorEst()
            st = seg.v15 = _v15.SegStitch(floor=fl, seed=(int(turn.uid) * 7919 + int(seg.idx) * 104729 + 17) & 0x7FFFFFFF)
        y = st.process(a) if a.size else a
        if final:
            if y.size:
                y = st.flush(y)
            if not getattr(seg, "v15_counted", False):
                seg.v15_counted = True
                V15C.add_seg(st.st)
        return y
    except Exception as e:  # noqa: BLE001
        log.warning("v15 拼接后处理异常(已跳过,播放不受影响): %s", e)
        return a


def v15_pause_bytes(turn, seg, n):
    """句间停顿:v15 舒适噪声(与说话人静音电平匹配,首尾淡化)。关闭时输出数字零(= v14)。"""
    if _v15 is not None and _v15.on("COMFORT") and n > 0:
        try:
            fl = getattr(turn, "v15_floor", None)
            b = _v15.pause_fill(n, _v15.comfort_rms(fl.rms() if fl else None), seed=(int(turn.uid) * 31 + int(seg.idx)) & 0x7FFFFFFF)
            V15C.add_pause(n)
            return b
        except Exception as e:  # noqa: BLE001
            log.warning("v15 舒适噪声异常(回退数字零): %s", e)
    return np.zeros(n, "<i2").tobytes()


