@app.websocket("/stream")
async def stream_ws(ws: WebSocket):
    """兼容简化协议: 发 {"text": "..."} -> 收原始 PCM(int16, 24kHz, 无头) -> 收 {"event":"done","similarity":0.97}"""
    await ws.accept()
    sess = Session("legacy-%s" % uuid.uuid4().hex[:8])
    sess.legacy = True
    sess.attach(ws)
    SESSIONS.add(sess)
    st = {"deadline": None, "done": True, "sim": None}
    out_q = sess.q

    async def finish():
        st["done"] = True
        st["deadline"] = None
        await ws.send_text(json.dumps({"event": "done", "similarity": st["sim"]}))

    async def sender():
        try:
            while True:
                try:
                    m = await asyncio.wait_for(out_q.get(), 0.5)
                except asyncio.TimeoutError:
                    if st["deadline"] and not st["done"] and time.time() > st["deadline"]:
                        await finish()
                    continue
                if isinstance(m, (bytes, bytearray)):
                    sess.q_bytes -= len(m)
                    if len(m) > HEADER_SIZE:
                        await ws.send_bytes(bytes(m[HEADER_SIZE:]))
                    continue
                o = json.loads(m)
                t = o.get("type")
                if t == "sim":
                    st["sim"] = o.get("value") if o.get("value") is not None else st["sim"]
                    if o.get("final") and not st["done"]:
                        await finish()
                elif t == "turn_done":
                    st["deadline"] = time.time() + 3.0
                elif t == "error":
                    st["done"] = True
                    await ws.send_text(json.dumps({"event": "error", "message": o.get("msg", "")}, ensure_ascii=False))
                elif t == "warn":
                    await ws.send_text(json.dumps({"event": "warn", "message": o.get("msg", "")}, ensure_ascii=False))
        except Exception:  # noqa: BLE001
            pass

    # legacy 通道自己消费队列(不走 Session._sender),所以取消默认 sender
    if sess.sender:
        sess.sender.cancel()
    stt = asyncio.get_running_loop().create_task(sender())
    try:
        while True:
            raw = await ws.receive_text()
            try:
                m = json.loads(raw)
            except ValueError:
                m = {"text": raw}
            if m.get("type") == "ping" or m.get("event") == "ping":
                await ws.send_text(json.dumps({"event": "pong"}))
                continue
            if m.get("type") == "stop":
                cancel_turn(sess)
                continue
            txt = str(m.get("text") or "").strip()
            if not txt:
                continue
            if VOICE["state"] != "ready":
                await ws.send_text(json.dumps({"event": "error", "message": "声音还没有克隆好,请先在网页里录入参考语音"}, ensure_ascii=False))
                continue
            st.update(done=False, sim=None, deadline=None)
            start_turn(sess, txt[:3000], {"tts": True}, None, say_only=True)
    except WebSocketDisconnect:
        pass
    except Exception as e:  # noqa: BLE001
        log.info("stream 结束: %s", e)
    finally:
        cancel_turn(sess)
        SESSIONS.discard(sess)
        stt.cancel()


def _hash_model():
    try:
        p = Path(MODEL)
        if not p.is_dir():
            from huggingface_hub import snapshot_download
            p = Path(snapshot_download(MODEL, local_files_only=True))
        f = p / "model.safetensors"
        if not f.exists():
            return
        h = hashlib.sha256()
        with open(f, "rb") as fh:
            for blk in iter(lambda: fh.read(1 << 23), b""):
                h.update(blk)
        SEC["model_sha256"], SEC["model_file"] = h.hexdigest(), str(f)
        log.info("模型文件 sha256 %s (%s)", SEC["model_sha256"][:16], f)
    except Exception as e:  # noqa: BLE001
        log.warning("模型哈希失败: %s", e)


async def gpu_loop():
    while True:
        await asyncio.sleep(2.0)
        for k in [k for k, t in RECENT.items() if time.time() - t.t0 > 120]:
            RECENT.pop(k, None)
        for sid, s in list(SESS_BY_SID.items()):                # 回收超过续传宽限期仍未回来的会话
            if not s.attached and s.detached_at and time.time() - s.detached_at > RESUME_GRACE_S:
                cancel_turn(s)
                SESSIONS.discard(s)
                SESS_BY_SID.pop(sid, None)
        try:
            if not MOCK:
                p = await asyncio.create_subprocess_exec("nvidia-smi", "--query-gpu=index,name,memory.used,memory.total,utilization.gpu", "--format=csv,noheader,nounits",
                                                         stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
                out, _ = await asyncio.wait_for(p.communicate(), 5)
                for line in out.decode().strip().splitlines():
                    f = [x.strip() for x in line.split(",")]
                    if len(f) >= 5:
                        GPU_ROWS[int(f[0])] = {"name": f[1], "mem_used": float(f[2]) / 1024, "mem_total": float(f[3]) / 1024, "util": int(float(f[4]))}
            else:
