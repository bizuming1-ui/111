#  动作校验(白名单)
# ════════════════════════════════════════════════════════════════
def _s(v, n):
    if not isinstance(v, str):
        raise ValueError("参数必须是字符串")
    v = v.strip()
    if not v or len(v) > n:
        raise ValueError("参数为空或过长")
    return v


def validate_actions(actions):
    if not isinstance(actions, list) or not actions:
        raise ValueError("没有可执行的动作")
    if len(actions) > MAX_STEPS:
        raise ValueError("动作数 %d 超过单任务上限 %d" % (len(actions), MAX_STEPS))
    out = []
    for a in actions:
        if not isinstance(a, dict) or a.get("action") not in ("goto", "search", "search_more", "open_result", "back", "forward", "reload", "scroll", "click", "type", "key", "read", "snapshot", "wait"):
            raise ValueError("不允许的动作: %r" % (a.get("action") if isinstance(a, dict) else a))
        k = a["action"]
        n = {"action": k}
        if k == "goto":
            n["url"] = _s(a.get("url"), 2048)
        elif k == "search":
            n["query"] = _s(a.get("query"), 300)
            n["engine"] = a.get("engine") if a.get("engine") in ENGINES else "google"
            if a.get("site"):
                if not re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,80}\.[a-z]{2,24}", str(a["site"]).lower()):
                    raise ValueError("网站范围格式无效")
                n["site"] = str(a["site"]).lower()
            if a.get("recency") in ("d", "w", "m", "y"):
                n["recency"] = a["recency"]
        elif k == "search_more":
            pass
        elif k == "open_result":
            i = int(a.get("n", 1))
            if not 1 <= i <= 30:
                raise ValueError("结果序号超出范围")
            n["n"] = i
        elif k == "scroll":
            n["direction"] = a.get("direction") if a.get("direction") in ("up", "down", "top", "bottom") else "down"
            n["amount"] = max(100, min(3000, int(a.get("amount", 600))))
        elif k == "click":
            n["by"] = a.get("by") if a.get("by") in ("text", "role", "label", "placeholder") else "text"
            n["value"] = _s(a.get("value"), 120)
            if a.get("role"):
                n["role"] = a["role"] if a["role"] in ("button", "link", "textbox", "checkbox", "tab", "menuitem", "combobox", "searchbox") else "button"
            if a.get("nth") is not None:
                n["nth"] = max(0, min(50, int(a["nth"])))
        elif k == "type":
            n["text"] = _s(a.get("text"), MAX_TEXT)
            if a.get("into"):
                n["into"] = {"by": a["into"].get("by") if a["into"].get("by") in ("label", "placeholder", "role", "text") else "label", "value": _s(a["into"].get("value"), 120)}
            n["submit"] = bool(a.get("submit"))
        elif k == "key":
            if a.get("key") not in KEYS:
                raise ValueError("按键不在白名单内")
            n["key"] = a["key"]
        elif k == "wait":
            n["seconds"] = max(0.2, min(5.0, float(a.get("seconds", 1))))
        out.append(n)
    return out


