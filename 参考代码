    sd = {k: v.detach().to("cpu", torch.float16).contiguous() for k, v in merged.state_dict().items()}
    save_file(sd, str(out / "model.safetensors"), metadata={"format": "pt"})
    meta = dict(ck.get("meta", {}))
    meta.update(merged_from=str(args.adapter), lora_modules=n, time=time.strftime("%Y-%m-%d %H:%M:%S"), base=args.base)
    if args.ref_wav and Path(args.ref_wav).exists():
