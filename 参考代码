async def run_one(prov, pid, q, count, page, site, recency, sleep=asyncio.sleep):
    """调用单个提供方;返回 (results, attempt_record)。
    · 熔断/冷却中:一次请求都不发,直接返回 kind=cooldown(访问限制类 401/403/429/验证码 → 停止该站点请求,不绕过)。
    · 只对【可重试】的瞬时错误(超时/网络/5xx)重试 MAX_ATTEMPT_RETRIES 次:指数退避 + 随机抖动,遵守 Retry-After(过长则不重试)。"""
    t0 = time.time()
    okay, rem, why = POLICY.allow(pid)
    if not okay:
        return None, {"provider": pid, "ok": False, "kind": "cooldown", "message": why, "status": None, "ms": 0, "tries": 0, "cooldown_s": int(rem) + 1}
    tries = 0
    while True:
        tries += 1
        try:
            res = await prov.search(q, count, page, site, recency)
            POLICY.ok(pid)
            return res, {"provider": pid, "ok": True, "n": len(res), "ms": int((time.time() - t0) * 1000), "tries": tries}
        except SearchError as e:
            POLICY.fail(pid, e.kind, str(e), e.retry_after, e.status)
            if e.retryable and tries <= MAX_ATTEMPT_RETRIES:
                d = POLICY.backoff_delay(tries, e.retry_after)
                if d is not None and POLICY.allow(pid)[0]:
                    await sleep(d)
                    continue
            rec = {"provider": pid, "ok": False, "kind": e.kind, "message": str(e), "status": e.status, "ms": int((time.time() - t0) * 1000), "tries": tries}
            st = POLICY.state(pid)
            if st["cooldown_s"]:
                rec["cooldown_s"] = st["cooldown_s"]
                if e.kind in ("rate_limited", "challenge", "access_denied", "blocked"):
                    rec["message"] += ";已停止对该站点的请求 %d 秒(不绕过)" % st["cooldown_s"]
            return None, rec
        except Exception as e:  # noqa: BLE001
            POLICY.fail(pid, "network", str(e))
            return None, {"provider": pid, "ok": False, "kind": "network", "message": "%s: %s" % (type(e).__name__, str(e)[:80]), "ms": int((time.time() - t0) * 1000), "tries": tries}


async def search_http_chain(q, count=8, page=0, site=None, recency=None, engine=None, attempts=None):
    """带缓存 + single-flight 的入口:命中缓存时 attempts 里会有 provider=cache 的记录(含年龄),结果不冒充新鲜;失败不缓存。"""
    attempts = attempts if attempts is not None else []
    key = (q.strip().lower(), count, page, site or "", recency or "", engine or "", tuple(sorted(HTTP_PROVIDERS)))
    hit = POLICY.cache_get(key)
    if hit:
        res, pid, age = hit
        attempts.append({"provider": "cache", "ok": True, "cached": True, "n": len(res), "age_s": int(age), "ms": 0, "tries": 0, "message": "命中 %d 秒前的真实结果缓存(来源 %s)" % (int(age), pid)})
        return [dict(r) for r in res], pid, attempts
    sub = []
    try:
        res, pid, att = await POLICY.single_flight(key, lambda: _search_http_chain(q, count, page, site, recency, engine, sub))
    except SearchFailed as e:
        attempts.extend(e.attempts)
        raise SearchFailed(attempts)
    attempts.extend(sub if att is sub else att)
    POLICY.cache_put(key, res, pid)
    return [dict(r) for r in res], pid, attempts


