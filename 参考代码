<script>
"use strict";
/* ═════════ 播放配置参数(集中在顶部) ═════════ */
const SAMPLE_RATE = 24000;                          // 和 TTS 输出一致,禁止让 AudioContext 自动决定
const START_THRESHOLD_BYTES = 24000 * 2 * 0.15;     // 收到 150ms 音频后立即开始播放
const TARGET_BUFFER_MS = 400;                       // 目标缓冲(进度条满格)
const LOW_WATER_MS = 40;                            // 低水位:缓冲 < 40ms 视为危险,时间线必须立即接上
const HEARTBEAT_INTERVAL = 18000;                   // 每 18 秒发一次心跳
const RECONNECT_DELAY = 2000;                       // 断线 2 秒后自动重连
const CHUNK_DECODE_SIZE = 24000 * 2 * 0.1;          // 每 100ms 音频量排一次队
const WS_URL = "{{WS_URL}}";                        // 服务端在返回网页时自动替换成真实地址
/* ═════════ 工具 ═════════ */
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
const ls = { get(k, d) { try { const v = localStorage.getItem("vc_" + k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } }, set(k, v) { try { localStorage.setItem("vc_" + k, JSON.stringify(v)); } catch (e) {} } };
const logs = [];
function log(msg, kind) {
  const t = new Date().toLocaleTimeString("zh-CN", { hour12: false });
  logs.push({ t, msg, kind }); if (logs.length > 400) logs.shift();
  const el = $("logs"); const d = document.createElement("div"); d.className = kind || ""; d.textContent = t + "  " + msg; el.appendChild(d);
  if (el.children.length > 400) el.removeChild(el.firstChild);
  if ($("logd").classList.contains("open")) el.scrollTop = el.scrollHeight;
}
$("btnLog").onclick = () => { $("logd").classList.add("open"); $("logs").scrollTop = 1e9; };
$("logClose").onclick = () => $("logd").classList.remove("open");

/* ═════════ 全局状态 ═════════ */
const S = {
  ws: null, wsOk: false, state: null, uid: null, turnDone: true, t0: 0, firstMs: null, underruns: 0, minRho: 1, llmMs: null,
  startMs: ls.get("startMs", Math.round(START_THRESHOLD_BYTES / 48)), opts: { auto: ls.get("auto", true), smooth: ls.get("smooth", true), filler: ls.get("filler", false), long: ls.get("long", false), breath: ls.get("breath", 1) },
  bubble: null, metaEl: null, devChanges: 0, diagOpen: false, streaming: null, lastStat: null, ref: null, retry: 0, pingT: null, lastLat: null, phase: "idle",
};

/* ═════════ 播放引擎 · 帧校验 · 起播规划 · 实测指标 · WebSocket(v6) ═════════
 * 播放引擎(都用同一个 RingPlayer 核心,单元测试覆盖):
 *   A. AudioWorklet 环形缓冲(默认,在音频线程运行,页面后台时也不受主线程节流影响)
 *   B. ScriptProcessor(降级,主线程播放,页面休眠/卡顿时更容易欠载)—— 界面会明确标出"降级"
 * 播放器永远 1.0 倍速:没有 WSOLA / 弹性放慢。数据不够就如实计一次欠载。 */
const PE = {
  ctx: null, node: null, core: null, kind: null, p: null,
  init() {
    if (this.p) { if (this.ctx && this.ctx.state !== "running") this.ctx.resume().catch(() => {}); return this.p; }
    this.p = (async () => {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) throw new Error("浏览器不支持 Web Audio");
      let ctx; try { ctx = new AC({ sampleRate: SAMPLE_RATE, latencyHint: "interactive" }); } catch (e) { ctx = new AC(); }
      await ctx.resume().catch(() => {});
      ctx.onstatechange = () => { log("AudioContext 状态 → " + ctx.state, ctx.state === "running" ? "o" : "w"); if (ctx.state === "suspended" || ctx.state === "interrupted") ctx.resume().catch(() => {}); renderDiag(); };
      if (ctx.onsinkchange !== undefined) ctx.onsinkchange = () => { log("音频输出设备已切换(蓝牙/耳机)", "w"); S.devChanges++; renderDiag(); };
      this.ctx = ctx;
      if (ctx.audioWorklet && window.AudioWorkletNode) {
        try {
          await ctx.audioWorklet.addModule("/worklet.js?v=" + Date.now());
          const node = new AudioWorkletNode(ctx, "vc-player", { numberOfInputs: 0, numberOfOutputs: 1, outputChannelCount: [1] });
          node.connect(ctx.destination); node.port.onmessage = (e) => onPlayerMsg(e.data);
          this.node = node; this.kind = "worklet";
        } catch (e) { log("AudioWorklet 加载失败(" + e.message + "),降级为 ScriptProcessor", "w"); }
      }
      if (!this.kind) {
        this.core = new RingPlayer(ctx.sampleRate, (m) => onPlayerMsg(m));
        const sp = ctx.createScriptProcessor(2048, 0, 1);
        sp.onaudioprocess = (ev) => this.core.render(ev.outputBuffer.getChannelData(0));
        sp.connect(ctx.destination); this.node = sp; this.kind = "scriptprocessor";
      }
      log("音频引擎: " + (this.kind === "worklet" ? "AudioWorklet 环形缓冲" : "⚠ 降级 · ScriptProcessor(主线程)") + " · 设备采样率 " + ctx.sampleRate + "Hz" + (ctx.sampleRate !== SAMPLE_RATE ? "(与 TTS 24000Hz 不同,在播放器内连续重采样)" : ""), this.kind === "worklet" ? "o" : "w");
      renderDiag();
    })().catch((e) => { this.p = null; throw e; });
    return this.p;
  },
  _msg(m, tr) { if (this.kind === "worklet") this.node.port.postMessage(m, tr || []); },
  open(cfg) { cfg.inSr = SAMPLE_RATE; if (this.kind === "worklet") this._msg({ t: "open", cfg }); else this.core.open(cfg); },
  cfg(c) { if (this.kind === "worklet") this._msg({ t: "cfg", cfg: c }); else this.core.setCfg(c); },
  push(f32) { if (this.kind === "worklet") this._msg({ t: "pcm", d: f32 }, [f32.buffer]); else if (!this.core.push(f32)) onPlayerMsg({ t: "overflow" }); },
  end() { if (this.kind === "worklet") this._msg({ t: "end" }); else this.core.end(); },
  flush() { if (!this.kind) return; if (this.kind === "worklet") this._msg({ t: "flush" }); else this.core.flush(); },
};
const P = { get ready() { return !!PE.kind; }, init() { return PE.init(); }, open: (c) => PE.open(c), cfg: (c) => PE.cfg(c), push: (f) => PE.push(f), end: () => PE.end(), flush: () => PE.flush() };

/* ═════════ 实测指标 ═════════ */
const M = { rtts: [], minLevels: ls.get("minLevels", []), turns: ls.get("turns_v6", []).slice(-40), arr: [], pageTurns: 0 };
let CUR = null;                                   // 当前轮的实测记录
function newCur(chars) {
  return { uid: null, chars, t_click: performance.now(), t_sent: null, t_turn_start: null, t_first_frame: null, t_audible: null, chk: null, arr: [], lastArr: 0, ended: false,
           underruns: 0, rebuffers: 0, max_underrun_ms: 0, silent_ms: 0, min_level_ms: null, plan: null, start: null, cold: false, done: null, final: false, reconnects: 0,
           resumed: 0, integrity_fail: false, notes: [], stopped: false, overflow: 0, drained: false, tab_hidden: 0, rho: 1 };
}
function curOk() { return CUR && CUR.uid != null && !CUR.final; }
function applyStartPlan(serverMs, floorMs) {
  const r = VC.computeStartMs({ serverMs, floorMs, rtts: M.rtts, minLevels: M.minLevels, mode: (S.state && S.state.perf && S.state.perf.mode) || "continuous" });
  S.startMs = r.ms;
  if (CUR) CUR.start = r;
  P.cfg({ startMs: r.ms, rebufMs: Math.max(800, Math.round(r.ms * 1.5)) });
  return r;
}
function finalizeTurn(reason) {
  if (!CUR || CUR.final || CUR.uid == null) return;
  const c = CUR;
  if (!c.drained && !c.stopped && reason !== "drained") return;
  if (c.done && c.chk && !c.stopped && !c.chk.verifyDone(c.done.frames, c.done.samples)) { c.integrity_fail = true; c.notes.push("帧数/样本数与服务端 turn_done 对账失败"); }
  c.final = true;
  const g = VC.summarize(c.arr);
  const rec = { turn: c.uid, chars: c.chars, cold: !!c.cold, ttfa_ms: c.t_audible != null ? Math.round(c.t_audible - c.t_click) : null, net_first_ms: c.t_first_frame != null ? Math.round(c.t_first_frame - c.t_click) : null,
                ws_send_ms: c.t_sent != null ? Math.round(c.t_sent - c.t_click) : null, start_ms: c.start ? c.start.ms : null, start_parts: c.start ? c.start.parts : null,
                underruns: c.underruns, rebuffers: c.rebuffers, max_underrun_ms: c.max_underrun_ms, silent_ms: c.silent_ms, min_level_ms: c.min_level_ms, arrival_ms: g,
                gaps: c.chk ? c.chk.stat.gap : 0, dups: c.chk ? c.chk.stat.dup : 0, foreign: c.chk ? c.chk.stat.foreign : 0, bad: c.chk ? c.chk.stat.bad : 0, integrity_fail: c.integrity_fail,
                reconnects: c.reconnects, stopped: c.stopped, engine: PE.kind, ctx_sr: PE.ctx ? PE.ctx.sampleRate : null, overflow: c.overflow, notes: c.notes, t: Date.now() };
  if (!c.stopped) {
    M.turns.push(rec); M.turns = M.turns.slice(-40); ls.set("turns_v6", M.turns);
    if (c.min_level_ms != null) { M.minLevels.push(Math.round(c.min_level_ms)); M.minLevels = M.minLevels.slice(-10); ls.set("minLevels", M.minLevels); }
    if (c.arr.length) M.arr = M.arr.concat(c.arr).slice(-3000);
    M.pageTurns++;
  }
  send({ type: "metrics", ...rec });
  finishMeta(rec); renderDiag();
}

/* ═════════ 播放器回调 ═════════ */
function onPlayerMsg(m) {
  const c = CUR;
  if (m.t === "started") {
    if (c && c.t_audible == null) {
