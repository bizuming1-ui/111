LORA_TARGET_REGEX = (r"talker\.(model|code_predictor\.model)\.layers\.\d+\."
                     r"(self_attn\.(q_proj|k_proj|v_proj|o_proj)|mlp\.(gate_proj|up_proj|down_proj))")


def build_lora(inner, r, alpha, dropout):
    """直接把 LoRA 注入原模型(不套 PeftModel 外壳,这样 model.talker / model.speaker_encoder 仍可直接调用)"""
    from peft import LoraConfig
    from peft.tuners.lora import LoraModel
    cfg = LoraConfig(r=r, lora_alpha=alpha, lora_dropout=dropout, target_modules=LORA_TARGET_REGEX, bias="none")
    lm = LoraModel(inner, cfg, "default")
    n = sum(1 for k, _ in inner.named_parameters() if "lora_A" in k)
    if n == 0:
        names = [k for k, _ in inner.named_modules()][:40]
        raise RuntimeError("没有匹配到任何 LoRA 目标层,请检查模块名。前 40 个模块: %s" % names)
    return lm, n


def lora_state(inner):
