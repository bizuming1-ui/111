def v14_record_seg(idx, stats):
    """每个完成的句子:把「实测整句耗时(含放行前重试浪费)/ 均值模型预测」记进该卡的分位数窗口;并写一行脱敏时间线。"""
    if _v14 is None:
        return
    V14M["segs"] += 1
    fr, wall = int(stats.get("frames") or 0), float(stats.get("wall") or 0)
    ratio = None
    if v14_on("TAIL") and fr >= 8 and wall > 0 and not stats.get("salvaged"):
        st = W(idx)
        wasted = float((stats.get("v13") or {}).get("wasted_s") or 0)
        ratio = (wall + wasted) / max(_v14.predicted_wall(fr, st["F"], st["D"], st["PRE"]), 0.05)
        V14_TAIL.record(idx, ratio)
        if V14M["segs"] % 10 == 0 and v14_on("LEARN"):
            v14_tail_save()
    V14_TL.log(ev="seg", gpu=idx, frames=fr, exp=stats.get("exp_frames"), wall=round(wall, 3), first=round(float(stats.get("first") or 0), 3), audio=round(float(stats.get("audio") or 0), 2),
               attempt=stats.get("attempt"), salvaged=bool(stats.get("salvaged")), ratio=None if ratio is None else round(ratio, 3))


def v14_try_xretry(t, seg, idx, err):
    """M2 跨卡重试:一张卡三次(换种子 → 降温 → 再降温)都失败且【一个音频块都没放出】→ 在另一张卡上换种子、从降温阶梯开始再试一次。
    串行兜底(不是 hedging 并行)。已经放出过音频(流式放行)就不重试,避免重复/错位。"""
    if not v14_on("XRETRY") or not POOL or t.closed or not str(err).startswith("AudioCorrupt"):
        return False
    if getattr(seg, "x_tries", 0) >= 1 or seg.had_audio or seg.out or (seg.trim.total + seg.trim.carry.size) > 0 or not POOL.usable():
        return False
    seg.x_tries = 1
    seg.avoid = idx if (len(POOL.usable()) > 1 and t.pinned is None) else None
    seg.v14_extra = {"seed_bias": 7919, "ladder_from": 1}
    seg.err, seg.done = "", False
    prof = "first" if seg.idx == 0 else ("second" if seg.idx == 1 else "rest")
    POOL.backlog.append((t.uid, seg.idx, seg.text, prof))
    V14M["xretry"] += 1
    t.integrity.append("第%d句: v14 跨卡重试(GPU%d 的重试阶梯耗尽 → %s)" % (seg.idx + 1, idx, "换到另一张卡" if seg.avoid is not None else "同卡换种子/降温"))
    log.warning("[#%d] 第%d句 GPU%d 失败 → v14 跨卡重试", t.uid, seg.idx, idx)
    V14_TL.log(ev="xretry", gpu=idx, seg=seg.idx)
    POOL.schedule()
    return True


def v14_assistant_text(turn):
    """被打断/取消的轮次:对话历史只保留「实际已播放」的文本(按已发出样本与浏览器 ack 的已播放样本映射到句子)。返回 (文本, 是否被截断)。"""
    full = turn.full_text
    if not v14_on("DIALOG") or not turn.segs or not getattr(turn, "interrupted", False):
        return full, False
    txt, cut = _v14.truncate_history_text([g.text for g in turn.segs], [int(getattr(g, "emitted", 0)) for g in turn.segs], int(turn.played_est()))
    return txt, cut


