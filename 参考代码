    # ───────────────────────── 路由 ─────────────────────────
    def mount(self):
        app, G = self.app, self.G
        P = self

        async def body(request):
            try:
                j = await request.json()
                return j if isinstance(j, dict) else {}
            except Exception:  # noqa: BLE001
                return {}

        def sid_of(request):
            return request.scope.get("vc_sid") or "open"

        def guard(fn):
            @functools.wraps(fn)
            async def inner(*a, **kw):
                try:
                    return await fn(*a, **kw)
                except StoreError as e:
                    return err(str(e), e.code)
                except ba.ActionError as e:
                    return err(str(e), 409)
            return inner

        # —— 页面与认证 ——
        @app.get("/", response_class=HTMLResponse)
        async def home():
            h = G["read_src"]("home.html")
            return HTMLResponse(h or "home.html 不存在", status_code=200 if h else 500, headers={"Cache-Control": "no-store"})

        @app.get("/login", response_class=HTMLResponse)
        async def login_page():
            return HTMLResponse(auth_mod.LOGIN_HTML, headers={"Cache-Control": "no-store"})

        @app.post("/api/login")
        async def api_login(request: Request):
            j = await body(request)
            ip = request.scope.get("vc_ip", "?")
            tok, msg = P.auth.login(str(j.get("password") or ""), ip)
            if not tok:
                P.audit.event("login", "denied")
                return err(msg, 429 if "次数" in msg else 401)
            proto = (request.headers.get("x-forwarded-proto") or request.url.scheme).split(",")[0]
            r = JSONResponse({"ok": True})
            r.set_cookie(auth_mod.COOKIE, tok, httponly=True, samesite="strict", secure=(proto == "https"), max_age=P.auth.ttl, path="/")
            P.audit.event("login", "ok")
            return r

        @app.post("/api/logout")
        async def api_logout(request: Request):
            await P.mgr.close_session(sid_of(request))
            P.auth.logout(request.scope.get("vc_token"))
            r = JSONResponse({"ok": True})
            r.delete_cookie(auth_mod.COOKIE, path="/")
            return r

        @app.get("/api/auth/info")
        async def auth_info(request: Request):
            return {"auth_enabled": P.auth.enabled, "logged_in": bool(request.scope.get("vc_sid"))}

        @app.get("/api/portal/status")
        async def api_status():
            return P.status()

        # —— 搜索 / 代理 ——
        @app.post("/api/search")
        @guard
        async def api_search(request: Request):
            j = await body(request)
            if not P.auth.lim.hit("search:" + sid_of(request), 40, 60):
                return err("搜索过于频繁,请稍后再试", 429)
            try:
                return await P.do_search(sid_of(request), j)
            except RuntimeError as e:
                return err(str(e), 502)

        @app.post("/api/agent/plan")
        @guard
        async def api_plan(request: Request):
            j = await body(request)
            return await P.plan(str(j.get("text") or "")[:500], j.get("engine") or "google")

        @app.post("/api/agent/run")
        @guard
        async def api_run(request: Request):
            j = await body(request)
            try:
                acts = ba.validate_actions(j.get("actions"))                        # 服务端再校验一遍:客户端传来的永远不可信
            except (ValueError, TypeError) as e:
                return err("动作校验失败:%s" % e, 400)
            s = P.mgr.get(sid_of(request))
            s.start(acts, str(j.get("title") or "任务")[:60])
            P.audit.event("browser_run", "started", None, sid_of(request), steps=len(acts))
            return {"ok": True, "steps": len(acts)}

        def sess_of(request):
            return P.mgr.get(sid_of(request))

        @app.post("/api/agent/pause")
        async def api_pause(request: Request):
            sess_of(request).pause()
            return {"ok": True}

        @app.post("/api/agent/resume")
        async def api_resume(request: Request):
