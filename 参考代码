        self.detached_at = None

    def attach(self, ws):
        self.ws, self.q, self.q_bytes, self.attached, self.detached_at = ws, asyncio.Queue(), 0, True, None
        self.sender = asyncio.get_running_loop().create_task(self._sender(ws, self.q))

    def detach(self):
        self.attached = False
        self.detached_at = time.time()
        if self.sender:
            self.sender.cancel()
        self.sender = None

    async def _sender(self, ws, q):
        try:
            while True:
                m = await q.get()
                if isinstance(m, (bytes, bytearray)):
                    await ws.send_bytes(bytes(m))
                    self.q_bytes -= len(m)
                else:
                    await ws.send_text(m)
        except Exception:  # noqa: BLE001
            pass

    def send(self, obj):
        if self.attached:
            self.q.put_nowait(json.dumps(obj, ensure_ascii=False))

    def send_bin(self, b):
        if self.attached:
            self.q_bytes += len(b)
            self.q.put_nowait(b)


def broadcast(obj):
    for s in list(SESSIONS):
        if not s.legacy and s.attached:
            s.send(obj)


