def parse_range(header, size):
    """单区间 Range:返回 (start, end) | None(无/忽略);不可满足抛 ArtifactError(416)。"""
    if not header:
        return None
    m = re.match(r"^bytes=(\d*)-(\d*)$", header.strip())
    if not m or (m.group(1) == "" and m.group(2) == ""):
        return None                                                   # 多区间/非法格式:按规范忽略并返回整份 200
    if m.group(1) == "":
        n = int(m.group(2))
        if n == 0:
            raise ArtifactError("range", "Range 不可满足", 416)
        return max(0, size - n), size - 1
    a = int(m.group(1))
    b = int(m.group(2)) if m.group(2) else size - 1
    if a >= size or a > b:
        raise ArtifactError("range", "Range 不可满足", 416)
    return a, min(b, size - 1)


