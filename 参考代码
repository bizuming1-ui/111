TTFA_STAGES = ("gateway", "text", "prefill", "first_frames", "decode_first", "postfx", "ws_play")


def _pct(v, q):
    if not v:
        return None
    s = sorted(v)
    return round(s[min(len(s) - 1, int(math.ceil(q / 100.0 * len(s))) - 1)], 1)


class StageTimer:
    """TTFA 拆成 7 段并全部打点(毫秒);诊断面板显示每段 P50/P95。线程安全,只测量。"""

    def __init__(self, keep=200):
        self.lock = threading.Lock()
        self.keep = keep
        self.d = {k: [] for k in TTFA_STAGES}

    def add(self, stage, ms):
        if stage not in self.d or ms is None or not np.isfinite(ms):
            return
        with self.lock:
            v = self.d[stage]
            v.append(float(ms))
            if len(v) > self.keep:
                del v[0]

    def summary(self):
        with self.lock:
            return {k: {"n": len(v), "p50": _pct(v, 50), "p95": _pct(v, 95)} for k, v in self.d.items()}

    def biggest(self):
        s = self.summary()
        c = [(v["p95"], k) for k, v in s.items() if v["p95"] is not None]
        return max(c)[1] if c else None


class Counters:
    """运行时累计计数(网关用,写入 /api/report 的 v16 段)。"""

    def __init__(self):
        self.lock = threading.Lock()
        self.d = {"long_split_files": 0, "long_split_segments": 0, "segments_rejected": 0, "composites_built": 0, "composite_fallbacks": 0,
                  "dc_fixed_turns": 0, "turns_analyzed": 0, "turns_with_problems": 0, "hiss_suspect_turns": 0, "last_turn": None, "incremental_plans": 0}

    def inc(self, k, n=1):
