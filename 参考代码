def extract_location(text):
    """只接受用户【自己说出】的地点(城市表 / 带 市区县 后缀 / 英文 in X)。找不到返回 ''。"""
    t = text or ""
    for c in sorted(_CITIES, key=len, reverse=True):
        if c in t:
            return c
    m = re.search(r"(?:weather|forecast)\s+(?:in|at|for)\s+([A-Za-z][A-Za-z .'\-]{1,29}?)(?:\s+(?:today|tomorrow|now|tonight))?\s*[?.!]*$", t, re.I) or \
        re.search(r"(?:in|at)\s+([A-Z][A-Za-z .'\-]{1,29}?)(?:\s+(?:today|tomorrow|now|tonight))?\s*[?.!]*$", t)
    if m:
        return m.group(1).strip()
    r = re.sub(_TIME_WORDS, " ", t)
