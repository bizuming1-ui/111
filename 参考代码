    f.pcm = new Int16Array(buf, HEADER, f.n);
    return f;
  }

  class FrameChecker {
    constructor(turn, sr) {
      this.turn = turn; this.sr = sr; this.expected = 0; this.count = 0; this.samples = 0; this.ended = false;
      this.stat = { dup: 0, gap: 0, foreign: 0, sr: 0, bad: 0, missing: 0 };
