    if (i0 + 1 >= this.wr && !(this.ended && i0 < this.wr)) return NaN;
    const a = ring[i0 % cap], b = (i0 + 1 < this.wr) ? ring[(i0 + 1) % cap] : a, fr = p - i0;
    this.pos = p + this.step;
