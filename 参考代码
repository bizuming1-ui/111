def window_score(a, sr):
    """候选片段「干净度 × 连续性」:SNR 越高、有声占比越高、无削波越好。"""
    a = np.asarray(a, np.float32)
    q = ref_quality(a, sr)
    fr = sr // 50
    nf = len(a) // fr
    if nf < 5:
        return 0.0
    r = np.sqrt((a[: nf * fr].reshape(nf, fr) ** 2).mean(axis=1))
    voiced = float((r > max(0.004, float(np.percentile(r, 95)) * 0.08)).mean())
    return float(q["score"]) / 100.0 * (0.5 + 0.5 * voiced)


def select_window(a, sr, target_s=20.0, step_s=2.0):
    """在 a 里找长度 ≈ target_s 的最佳连续窗口(起止对齐到 ±0.4s 内最安静的 10ms 帧)。返回 (start, end, score)。不足 target 则返回整段。"""
    a = np.asarray(a, np.float32)
    L = int(target_s * sr)
    if len(a) <= L * 1.1:
        return 0, len(a), window_score(a, sr)
    best = (0, L, -1.0)
    for s in range(0, len(a) - L + 1, int(step_s * sr)):
        sc = window_score(a[s:s + L], sr)
        if sc > best[2]:
            best = (s, s + L, sc)
    fr = sr // 100

    def low(pos, rng_):
        lo, hi = max(0, pos - rng_), min(len(a) - fr, pos + rng_)
        idx = np.arange(lo, hi, fr)
        if idx.size == 0:
            return pos
        return int(idx[int(np.argmin([float(np.abs(a[i:i + fr]).mean()) for i in idx]))])
    return low(best[0], int(0.4 * sr)), low(best[1], int(0.4 * sr)), best[2]


def prepare_reference_v15(a, sr, hp_hz=50.0):
    """在 v14 的 prepare_reference 之后调用(此时已是 24k、峰值 0.7):零相位高通 + 10ms 边缘淡化 + 质量评分。
    不改变电平策略(峰值 0.7 的约定保持不变,避免未经 GPU 验证的模型条件漂移)。"""
    y = edge_fade(highpass_zero_phase(a, sr, hp_hz), sr, 10.0)
    pk = float(np.abs(y).max())
    if pk > 1e-4:
        y = y * (0.7 / pk)
    return y.astype(np.float32), ref_quality(y, sr)


# ───────────────────────── 候选重排(挑战者必须明显优于基线才替换) ─────────────────────────
def candidate_score(pcm, sim=None, cer=None):
    """返回 (veto_reason|None, score)。veto:NaN、削波、数字零段、点击、真峰值过高 → 一票否决。
    score = 0.6×相似度(若有,否则 0.5 占位) + 0.25×洁净度 + 0.15×(1−CER)。"""
    rep = analyze(pcm)
    if rep.get("n", 0) < 480:
        return "太短", 0.0
    for key, why in (("nan_inf", "NaN/Inf"), ("clip_samples", "削波"), ("zero_runs", "数字零段"), ("click_like", "点击")):
        if rep[key]:
            return why, 0.0
    if rep["true_peak_dbfs"] > -0.5:
        return "真峰值过高", 0.0
    rel = rep["noise_rel_voiced_db"] if rep["noise_rel_voiced_db"] is not None else -30.0
    clean = 1.0 - min(1.0, max(0.0, rel + 45.0) / 30.0)
    s = 0.25 * clean + 0.15 * (1.0 - (cer if cer is not None else 0.0)) + 0.6 * (float(sim) if sim is not None else 0.5)
    return None, float(s)


def pick_best(baseline, challengers, margin=0.03):
    """baseline/challengers 为 (name, pcm, sim|None)。挑战者必须比当前最优高出 margin 且无否决才替换(抗噪规则)。返回 (name, reason)。"""
    bv, bs = candidate_score(baseline[1], baseline[2])
    best, best_s, why = baseline[0], (bs if bv is None else -1.0), ("基线保持" if bv is None else "基线被否决:" + bv)
    for name, pcm, sim in challengers:
        v, s = candidate_score(pcm, sim)
        if v is not None:
            continue
        need = best_s + (margin if best_s >= 0 else 0.0)
        if s > need:
            best, best_s, why = name, s, "挑战者 %s 明显优于当前最优(%.3f > %.3f)" % (name, s, need)
    return best, why


