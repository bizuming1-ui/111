def pump(turn):
    """按句子顺序把已就绪的音频推给浏览器。第 k 句的音频只有在前 k-1 句全部发完之后才会发出。"""
    if turn.closed:
        return
    sess = turn.sess
    head = struct.pack("<I", turn.uid)
    while turn.cur < len(turn.segs):
        seg = turn.segs[turn.cur]
        if seg.out:
            parts = [head]
            if turn.pending_pause > 0:
                parts.append(np.zeros(int(SR * turn.pending_pause / 1000), "<i2").tobytes())
                turn.pending_pause = 0
            for a in seg.out:
                parts.append(a.astype("<i2").tobytes())
                turn.samples += len(a)
            seg.out = []
            if turn.first_audio is None:
                turn.first_audio = time.time() - turn.t0
            seg.had_audio = True
            sess.send_bin(b"".join(parts))
        if seg.done:
            if seg.had_audio:
                turn.pending_pause = pause_ms(seg.end, turn.breath)
            turn.cur += 1
            continue
        break
    if turn.text_done and turn.cur >= len(turn.segs):
        turn.closed = True
        ACTIVE.pop(turn.uid, None)
        if turn.sim_wait > 0:
            RECENT[turn.uid] = turn
        sess.send({"type": "turn_done", "turn": turn.uid, "audio_s": round(turn.samples / SR, 2),
                   "first_ms": int(turn.first_audio * 1000) if turn.first_audio is not None else None,
                   "gpu_segs": turn.gpu_segs, "segs": len(turn.segs),
                   "chars": len(turn.full_text)})
        sim_check(turn)


def dispatch(turn, text):
    clean = tts_clean(text)
    if not turn.tts or not has_speech(clean):
        return
    seg = Seg(len(turn.segs), clean, text.strip()[-1:])
    turn.segs.append(seg)
    w = POOL.pick() if POOL else None
    if w is None:
        seg.done = True
        seg.err = "没有可用的 GPU 进程或声音还没克隆好"
        if not turn.warned:
            turn.warned = True
            turn.sess.send({"type": "warn", "msg": "无法朗读: " + seg.err})
        return
    seg.worker = w.idx
    turn.sim_wait += 1
    w.pending += len(clean)
    turn.gpu_segs[str(w.idx)] = turn.gpu_segs.get(str(w.idx), 0) + 1
    w.q.put(("tts", turn.uid, POOL.epoch.value, seg.idx, clean, CHUNK_FIRST if seg.idx == 0 else CHUNK_REST))


def on_worker_msg(msg):
    k = msg[0]
    if k == "status":
        _, idx, stage, text = msg
        w = POOL.workers[idx]
        w.status, w.msg = stage, text
        broadcast(state_public())
    elif k == "voice_ok":
        _, idx, vid, info = msg
        w = POOL.workers[idx]
        if vid == VOICE["vid"]:
            w.voice_vid, w.voice_info = vid, info
            VOICE["pending"].discard(idx)
            VOICE["info"][str(idx)] = info
            rs = {int(k): v.get("rms") for k, v in VOICE["info"].items() if v.get("rms")}
            if rs:                                              # 两张卡的有声 RMS 对齐到几何平均(单卡则增益=1)
                tgt = float(np.exp(np.mean(np.log(list(rs.values())))))
                TARGET_RMS[0] = round(tgt, 1)
                for i, r in rs.items():
                    GAIN[i] = float(min(1.4, max(0.7, tgt / max(r, 1.0))))
            log.info("[GPU%d] 声音就绪: %s 增益 %.2f", idx, info, GAIN.get(idx, 1.0))
            _voice_progress()
    elif k == "voice_err":
        _, idx, vid, err = msg
        if vid == VOICE["vid"]:
            VOICE["pending"].discard(idx)
            VOICE["err"] = err
            log.error("[GPU%d] 声音设置失败: %s", idx, err)
            _voice_progress()
    elif k == "asr":
        _, rid, text, err = msg
        fut = ASR_WAIT.pop(rid, None)
        if fut and not fut.done():
            fut.set_result((text, err))
    elif k == "chunk":
        _, tuid, seg_i, data = msg
        t = ACTIVE.get(tuid)
        if t is None or t.closed or seg_i >= len(t.segs):
            return
        seg = t.segs[seg_i]
        a = seg.trim.feed(np.frombuffer(data, dtype="<i2"))
        g = GAIN.get(seg.worker, 1.0)
        if a.size and abs(g - 1.0) > 0.02:                       # 两卡 RMS 电平对齐(限幅,防止削波)
            a = np.clip(a.astype(np.float32) * g, -32767, 32767).astype("<i2")
        if a.size:
            seg.out.append(a)
            pump(t)
    elif k == "sim":
        _, tuid, seg_i, sim, dur = msg
        t = ACTIVE.get(tuid) or RECENT.get(tuid)
        if t is None or seg_i >= len(t.segs):
            return
        t.segs[seg_i].sim, t.segs[seg_i].sim_dur = sim, float(dur or 0)
        _sim_slot_done(t, seg_i)
    elif k in ("seg_done", "seg_err"):
        if k == "seg_done":
            _, tuid, seg_i, idx, stats = msg
            err = ""
        else:
            _, tuid, seg_i, idx, err = msg
            stats = {}
        w = POOL.workers[idx]
        t = ACTIVE.get(tuid)
        if t is None or t.closed or seg_i >= len(t.segs):
            if k == "seg_err":
                t2 = RECENT.get(tuid)
                if t2 is not None:
                    _sim_slot_done(t2, seg_i)
            return
        seg = t.segs[seg_i]
        w.pending = max(0, w.pending - len(seg.text))
        a = seg.trim.flush()
        g = GAIN.get(seg.worker, 1.0)
        if a.size and abs(g - 1.0) > 0.02:
            a = np.clip(a.astype(np.float32) * g, -32767, 32767).astype("<i2")
        if a.size:
            seg.out.append(a)
        if err or stats.get("skipped"):
            _sim_slot_done(t, seg_i)
        seg.done, seg.err, seg.stats = True, err, stats
        if err:
            t.sess.send({"type": "warn", "msg": "第 %d 句合成失败: %s" % (seg_i + 1, err)})
        elif stats.get("audio"):
            log.info("[#%d] 第%d句 GPU%d: %d字 → 音频 %.1fs, 首包 %.2fs, 耗时 %.1fs (RTF %.2f)", t.uid, seg_i, idx, len(seg.text),
                     stats["audio"], stats.get("first") or 0, stats.get("wall") or 0, (stats.get("wall") or 0) / max(stats["audio"], 1e-3))
        pump(t)


def turn_sim(turn):
    """按音频时长加权的声纹相似度(忽略 <1.2s 的短句,嵌入不可靠)"""
    xs = [(g.sim, g.sim_dur) for g in turn.segs if g.sim is not None and g.sim_dur > 1.2]
    if not xs:
        return None
    return round(sum(a * b for a, b in xs) / sum(b for _, b in xs), 4)


def _sim_slot_done(turn, seg_i):
    g = turn.segs[seg_i]
    if g.sim_done:
        return
    g.sim_done = True
    turn.sim_wait = max(0, turn.sim_wait - 1)
    sim_check(turn)


def sim_check(turn):
    if turn.sim_sent:
        return
    v = turn_sim(turn)
    final = turn.closed and turn.sim_wait == 0
    if v is not None or final:
        turn.sess.send({"type": "sim", "turn": turn.uid, "value": v, "final": bool(final)})
    if final:
        turn.sim_sent = True
        RECENT.pop(turn.uid, None)


def _voice_progress():
    if not VOICE["pending"]:
        ok = [w for w in POOL.workers if w.voice_vid == VOICE["vid"]]
        VOICE["state"] = "ready" if ok else "error"
        if ok:
            VOICE["err"] = ""
        else:
            VOICE["err"] = VOICE["err"] or "所有 GPU 都没能完成声音设置"
    broadcast(state_public())


def reader_thread(loop):
    while True:
        try:
            msg = POOL.res_q.get()
        except Exception:  # noqa: BLE001
            return
        try:
            loop.call_soon_threadsafe(on_worker_msg, msg)
        except RuntimeError:
            return


