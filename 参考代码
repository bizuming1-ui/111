def replay(sess, uid, next_seq):
    t = sess.turns.get(uid)
    if t is None:
        EVENTS["resume_fail"] += 1
        sess.send({"type": "resume_fail", "turn": uid})
        return
    frames = t.log[next_seq:]
    sess.send({"type": "resume_ok", "turn": uid, "from": next_seq, "frames": len(frames)})
    for f in frames:
        sess.send_bin(f)
    t.replayed += len(frames)
    EVENTS["reconnect_resumed"] += 1
    if t.done_msg:
        sess.send(t.done_msg)
    pump(t)


def on_ack(sess, m):
    t = sess.turns.get(int(m.get("turn") or 0))
    if t is None:
        return
    t.has_acks = True
    t.played = max(t.played, int(m.get("played") or 0))
    t.level_ms = m.get("level_ms")
    pump(t)
    if POOL:
        POOL.schedule()


@app.websocket("/ws")
async def ws_endpoint(ws: WebSocket):
    await ws.accept()
    sess = None

    def adopt(sid):
        nonlocal sess
        sid = (sid or "")[:48] or uuid.uuid4().hex[:12]
        old = SESS_BY_SID.get(sid)
        resumed = False
        if old is not None:
            if old.attached:
                old.detach()
            sess, resumed = old, True
        else:
            sess = Session(sid)
            SESS_BY_SID[sid] = sess
        SESSIONS.add(sess)
        sess.attach(ws)
        return resumed

    try:
        while True:
            raw = await ws.receive_text()
            try:
                m = json.loads(raw)
            except ValueError:
                continue
            k = m.get("type")
            if sess is None:
                resumed = adopt(m.get("sid") if k == "hello" else None)
                sess.send({"type": "hello_ok", "sid": sess.sid, "resumed": resumed, "server_t": time.time()})
                sess.send(state_public())
                if k == "hello":
                    rs = m.get("resume")
                    if resumed and rs and sess.turns.get(int(rs.get("turn") or 0)) is not None:
                        replay(sess, int(rs["turn"]), int(rs.get("next_seq") or 0))
                    elif resumed and sess.turn is not None and not sess.turn.closed:
                        cancel_turn(sess)                  # 页面重新加载:旧轮次没人接收了
                    continue
            if k == "ping":
                sess.send({"type": "pong", "t": m.get("t")})
            elif k == "ack":
                on_ack(sess, m)
            elif k == "resume":
                replay(sess, int(m.get("turn") or 0), int(m.get("next_seq") or 0))
            elif k == "metrics":
                m.pop("type", None)
                METRICS.append(m)
            elif k == "event":
                n = m.get("name")
                if n == "visibility":
                    EVENTS["visibility"] += 1
                elif n == "ab_vote":
                    EVENTS["ab_votes"].append({"choice": m.get("choice"), "t": time.time()})
            elif k == "chat":
                txt = str(m.get("text") or "").strip()
                if txt:
                    start_turn(sess, txt[:4000], m.get("opts") or {}, m.get("ref"))
            elif k == "say":
                txt = str(m.get("text") or "").strip()
                if txt:
                    o = dict(m.get("opts") or {})
                    o["tts"] = True
                    start_turn(sess, txt[:3000], o, m.get("ref"), say_only=True)
            elif k == "stop":
                cancel_turn(sess)
                sess.send({"type": "stopped"})
            elif k == "reset":
                cancel_turn(sess)
                sess.history = []
                sess.send({"type": "reset_ok"})
    except WebSocketDisconnect:
        pass
    except Exception as e:  # noqa: BLE001
        log.info("ws 结束: %s", e)
    finally:
        if sess is not None:
            if sess.ws is ws:
                sess.detach()          # 保留会话 RESUME_GRACE_S 秒:断线重连后按 next_seq 精确续传;超时由 gpu_loop 回收并取消轮次


