    """切换到不同 DPR 的档位必须重建 BrowserContext(Cookie/登录状态会被清除):先提示用户,确认后才执行。"""


def jpeg_size(b):
    """读取 JPEG 的真实像素尺寸(SOF 段);读不出来返回 None。用来报告「截图实际像素」,不靠猜。"""
    try:
        if b[:2] != b"\xff\xd8":
            return None
        i, n = 2, len(b)
        while i + 9 < n:
            if b[i] != 0xFF:
                i += 1
                continue
            mk = b[i + 1]
            if mk in (0xD8, 0x01) or 0xD0 <= mk <= 0xD7:
                i += 2
                continue
            ln = (b[i + 2] << 8) | b[i + 3]
            if mk in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                return (b[i + 7] << 8) | b[i + 8], (b[i + 5] << 8) | b[i + 6]
            i += 2 + ln
    except Exception:  # noqa: BLE001
        pass
    return None


def norm_to_css(nx, ny, vw, vh):
    """归一化坐标(0~1,相对完整截图)→ Playwright CSS 像素。归一化坐标与 DPR 无关,所以这里【绝不】再乘/除 DPR。"""
    import math
    if not all(isinstance(v, (int, float)) and math.isfinite(v) for v in (nx, ny, vw, vh)) or vw <= 0 or vh <= 0:
        raise ActionError("坐标无效")
    if not (0.0 <= nx <= 1.0 and 0.0 <= ny <= 1.0):
        raise ActionError("坐标越界(不在 0~1 范围内)")
    return min(vw - 1, nx * vw), min(vh - 1, ny * vh)


def px_to_css(px, py, pw, ph, vw, vh):
    """截图像素坐标 → CSS 像素:按「实际截图尺寸 ↔ CSS 视口」的比例换算(高 DPR 下 pw=vw×dpr,比例里已包含 DPR,不再另乘)。"""
    if not pw or not ph or not (0 <= px <= pw and 0 <= py <= ph):
        raise ActionError("截图像素坐标越界或缺少截图尺寸")
    return min(vw - 1, px * vw / pw), min(vh - 1, py * vh / ph)


def check_visual_target(meta, cur_url, cur_view, cur_epoch, nx, ny, conf, now=None):
    """视觉坐标点击的服务端校验:帧 ID 有效 · 未过期 · 视口/URL 在观察后没变 · 置信度足够 · 坐标在视口内。任何一项不满足 → 停止并询问用户。"""
    now = time.time() if now is None else now
    if not meta:
        raise ActionError("找不到对应的视觉观察(帧 ID 无效或已过期),请重新观察后再试")
    if now - meta["ts"] > VISION_MAX_AGE_S:
        raise ActionError("视觉观察已过期(%d 秒前),页面可能已变化,请重新观察" % int(now - meta["ts"]))
    if meta["epoch"] != cur_epoch or (meta["vw"], meta["vh"]) != tuple(cur_view):
        raise ActionError("浏览器视口在观察之后发生了变化,坐标不再可信,请重新观察")
    if meta["url"] != cur_url:
        raise ActionError("页面在观察之后已切换(URL 变了),坐标不再可信,请重新观察")
    if conf < VISION_MIN_CONF:
        raise ActionError("视觉置信度过低(%.2f < %.2f),已停止,不会猜测点击。请换个说法或人工接管" % (conf, VISION_MIN_CONF))
    return norm_to_css(nx, ny, meta["vw"], meta["vh"])


class Sub:
    def __init__(self):
        self.q = deque(maxlen=400)
        self.frame = None
        self.frame_meta = None
        self.dropped = 0
        self.evt = asyncio.Event()

    def push(self, obj):
        self.q.append(obj)
        self.evt.set()

    def push_frame(self, b, meta=None):
        if self.frame is not None:
            self.dropped += 1                                    # 客户端还没取走上一帧:直接覆盖(只保留最新帧,队列有界=1)
        self.frame = b
        self.frame_meta = meta
        self.evt.set()


class BSession:
    def __init__(self, mgr, sid):
        self.mgr, self.sid = mgr, sid
        self.ctx = None
        self.pages = []
        self.page = None
        self.log = deque(maxlen=300)
        self.seq = 0
        self.status, self.msg = "idle", ""
        self.cursor = None
        self.typing = None
        self.pending = None
        self.task = None
        self.task_title = ""
        self.cancel_flag = False
        self.pause_ev = asyncio.Event()
        self.pause_ev.set()
        self.subs = set()
        self.stream_task = None
        self.last_hash = None
        self.bytes_sent = 0
        self.frames = 0
        self.last_results = []
        self.seen_results = {}                                    # v9:本会话真实解析到的结果(URL → 结果);总结接口只认这里的来源,不接受客户端伪造
        self.last_query = None
        self.search_page = 0
        self.observation = None
        self.blocked = 0
        self.last_used = time.time()
        self.last_input = 0.0
        self.steps_done = 0
        self.profile = DEFAULT_PROFILE
        self.view = (PROFILES[self.profile]["w"], PROFILES[self.profile]["h"])
        self.dpr = PROFILES[self.profile]["dpr"]
        self.view_epoch = 0
        self.frame_seq = 0
        self.vframes = {}                                         # 视觉观察帧(服务端发出的 ID → 元数据);click_at 只认这里的帧
        self.shot_scale = "device"
        self.cap_ema = None
        self.kb_ema = None
        self.dropped = 0
        self.sent_ts = deque(maxlen=24)
        self.degraded = ""
        self.last_frame_meta = None
        self.v12 = v12_mod.attach(self) if v12_mod is not None else None                  # v12:None = v11 行为

    def perf_public(self):
        ts = [t for t in self.sent_ts if time.time() - t < 10]
        fps = (len(ts) - 1) / (ts[-1] - ts[0]) if len(ts) >= 2 and ts[-1] > ts[0] else 0.0
        return {"fps": round(fps, 1), "cap_ms": round(self.cap_ema) if self.cap_ema else None, "kb": round(self.kb_ema, 1) if self.kb_ema else None, "dropped": self.dropped + sum(s.dropped for s in self.subs),
                "degraded": self.degraded, "scale": self.shot_scale}

    # —— 事件 ——
    def emit(self, obj):
        for s in list(self.subs):
            s.push(obj)

    def add_log(self, kind, msg, **kw):
        self.seq += 1
        e = {"seq": self.seq, "t": now_iso(), "kind": kind, "msg": msg[:300]}
        e.update(kw)
        self.log.append(e)
        self.emit({"type": "log", "entry": e})
        return e

    def set_status(self, st, msg=""):
        self.status, self.msg = st, msg
        self.emit({"type": "status", **self.public()})

    def public(self):
        pg = self.page
        return {"status": self.status, "msg": self.msg, "task": self.task_title, "url": (pg.url if pg and not pg.is_closed() else ""), "pages": len(self.pages), "steps": self.steps_done,
                "pending": ({k: v for k, v in self.pending.items() if k != "fut"} if self.pending else None), "cursor": self.cursor, "view": {"w": self.view[0], "h": self.view[1]},
                "profile": self.profile, "dpr": self.dpr, "epoch": self.view_epoch, "frame_id": self.frame_seq, "perf": self.perf_public(), "shot": self.last_frame_meta,
                "frames": self.frames, "bytes_sent": self.bytes_sent, "blocked_requests": self.blocked, "v12": (self.v12.public() if self.v12 is not None else None)}

    # —— 浏览器上下文 ——
    async def ensure(self):
        self.last_used = time.time()
        if self.ctx is not None and self.page is not None and not self.page.is_closed():
            return
        br = await self.mgr.browser()
        if self.ctx is None:
            self.ctx = await br.new_context(viewport={"width": self.view[0], "height": self.view[1]}, device_scale_factor=self.dpr, accept_downloads=bool(self.v12 is not None), java_script_enabled=True, permissions=[], service_workers="block",
                                            locale="zh-CN", ignore_https_errors=False)
            self.ctx.set_default_timeout(STEP_TIMEOUT_S * 1000)
            await self.ctx.route("**/*", self._guard)
            if hasattr(self.ctx, "route_web_socket"):
                try:
                    await self.ctx.route_web_socket("**/*", self._guard_ws)
                except Exception:  # noqa: BLE001
                    pass
            self.ctx.on("page", self._on_page)
        if not self.pages or self.page is None or self.page.is_closed():
            p = await self.ctx.new_page()
            self._adopt(p)
        self.add_log("system", "隔离浏览器会话已就绪(独立 Cookie/存储,关闭后清除)")

    def _adopt(self, p):
        fresh = p not in self.pages
        if fresh:
            self.pages.append(p)
        self.page = p
        if not fresh:                                             # v12:同一个页面只挂一次监听(v11 里 ensure 与 context.on("page") 会各挂一次,对话框处理器会触发两次)
            return
        p.on("dialog", lambda d: asyncio.ensure_future(self._dialog(d)))
        p.on("close", lambda *_: self._on_close(p))
        if self.v12 is not None:
            self.v12.on_adopt(p)

    async def _dialog(self, d):
        if self.v12 is not None and self.v12.on_dialog(d):                  # v12:用户亲手操作时,对话框交给前端自绘并由用户选择(AI 任务执行中仍自动关闭)
            return
        self.add_log("blocked", "已自动关闭网页弹窗(%s)" % d.type)
        try:
            await d.dismiss()
        except Exception:  # noqa: BLE001
            pass

    def _on_close(self, p):
        if p in self.pages:
            self.pages.remove(p)
        if self.page is p:
            self.page = self.pages[-1] if self.pages else None

    def _on_page(self, p):
        if len(self.pages) >= MAX_PAGES:
            self.add_log("blocked", "页面数已达上限 %d,已关闭新弹出的页面" % MAX_PAGES)
            asyncio.ensure_future(p.close())
            return
        self._adopt(p)
        if self.v12 is not None:
            self.v12.on_popup(p)
        self.add_log("system", "网页打开了新标签页,已切换到它")

    async def _guard(self, route, request):
        url = request.url
        sch = urlsplit(url).scheme
        if sch in ("data", "blob", "about"):
            return await route.continue_()
        try:
            await netguard.acheck_url(url)
        except netguard.Blocked as e:
            self.blocked += 1
            if request.is_navigation_request():
                self.add_log("blocked", "已阻止导航:%s(%s)" % (netguard.safe_url_for_log(url), e))
            try:
                await route.abort("blockedbyclient")
            except Exception:  # noqa: BLE001
                pass
            return
        try:
            rt = request.resource_type
            if accel is not None and self.v12 is not None:
                ab, _why = accel.should_abort(rt, url, BROWSER_LITE)           # v12:分级策略(默认 off 与 v11 相同;VC_MEDIA/VC_LITE 可调)
            else:
                ab = rt == "media" or (BROWSER_LITE and rt in ("image", "font"))
            if ab:
                self.lite_skipped = getattr(self, "lite_skipped", 0) + 1
                return await route.abort("aborted")
            await route.continue_()
        except Exception:  # noqa: BLE001
            pass

    async def _guard_ws(self, ws):
        try:
            await netguard.acheck_url(ws.url.replace("ws://", "http://", 1).replace("wss://", "https://", 1))
            ws.connect_to_server()
        except netguard.Blocked:
            self.blocked += 1
            await ws.close(code=1008, reason="blocked")

    async def close(self):
        self.cancel_flag = True
        if self.pending and not self.pending["fut"].done():
            self.pending["fut"].set_result(False)
        if self.task and not self.task.done():
            self.task.cancel()
        if self.stream_task:
            self.stream_task.cancel()
        if self.v12 is not None:
            try:
                await self.v12.close()
            except Exception:  # noqa: BLE001
                pass
        try:
            if self.ctx:
                await self.ctx.close()
        except Exception:  # noqa: BLE001
            pass
        self.ctx, self.pages, self.page = None, [], None
        self.add_log("system", "浏览器会话已关闭,Cookie/登录状态已清除")
        self.set_status("idle", "已关闭")

    # —— 画面流 ——
    def subscribe(self):
        s = Sub()
        self.subs.add(s)
        self.last_hash = None                                     # 强制下一次截图一定发出:重连后只恢复最新有效画面
        s.push({"type": "hello", **self.public(), "log": list(self.log)[-80:]})
        if self.stream_task is None or self.stream_task.done():
            self.stream_task = asyncio.ensure_future(self._stream())
        return s

    def unsubscribe(self, s):
        self.subs.discard(s)

    async def _stream(self):
        """截图流:最新帧优先、队列有界(每个订阅者只保留 1 帧)、客户端接收慢就跳过截图、截图过慢自动降帧/降像素,并把降级原因如实告诉前端。
        每帧先发一条 JSON 元数据({"type":"frame", id/ts/epoch/url/title/vw/vh/pw/ph/dpr/...}),紧接着发这一帧的二进制 JPEG(同一个协程里顺序发送,前端按顺序配对)。"""
        while self.subs:
            t_loop = time.time()
            if self.v12 is not None:
                await self.v12.tick()
            busy = bool(self.mgr.tts_busy())
            active = bool(self.task and not self.task.done()) or (time.time() - self.last_input < 2.0)
            fps, why = (FPS_ACTIVE if active else FPS), []
            if busy and fps > FPS_BUSY:
                fps = FPS_BUSY
                why.append("TTS 正在播放:画面降到 %.0f fps,优先保证语音连续" % FPS_BUSY)
            interval = 1.0 / max(0.2, fps)
            if self.cap_ema and self.cap_ema / 1000.0 * 1.6 > interval:
                interval = self.cap_ema / 1000.0 * 1.6
                why.append("截图耗时约 %d ms:帧率自动降到 %.1f fps" % (self.cap_ema, 1.0 / interval))
            pg = self.page
            if pg is None or pg.is_closed():
                await asyncio.sleep(0.3)
                continue
            if self.subs and all(s.frame is not None for s in self.subs):
                self.dropped += 1                                 # 客户端还没取走上一帧:不再截新图(避免积压旧帧)
                why.append("客户端接收较慢:已跳过截图,只保留最新帧")
                self.degraded = ";".join(why)
                await asyncio.sleep(interval)
                continue
            prof = PROFILES.get(self.profile, PROFILES["compat"])
            q = int(os.environ.get("VC_BROWSER_JPEG_Q") or prof["q"])
            epoch = self.view_epoch
            src, b = None, None
            if self.v12 is not None:                                  # v12:优先用 CDP Screencast 推送的帧;idle=页面静止;kf/shot=用截图补一帧;None=v11 截图
                try:
                    r12 = await self.v12.grab(interval)
                except Exception:  # noqa: BLE001
                    r12 = None
                if r12 == "idle":
                    continue
                if isinstance(r12, tuple):
                    b, src = r12[0], "cast"
                elif r12 in ("kf", "shot"):
                    src = r12
            t_cap = time.time()
            if b is None:
                try:
                    b = await pg.screenshot(type="jpeg", quality=q, timeout=4000, scale=self.shot_scale)
                except Exception:  # noqa: BLE001
                    await asyncio.sleep(min(1.0, interval))
                    continue
                if src == "shot" and not self.v12.watchdog_result(b):
                    continue
            cap_ms = (time.time() - t_cap) * 1000.0
            self.cap_ema = cap_ms if self.cap_ema is None else 0.7 * self.cap_ema + 0.3 * cap_ms
            if self.dpr > 1.0 and self.shot_scale == "device" and self.cap_ema > CAP_SLOW_MS:
                self.shot_scale = "css"                           # 高 DPR 截图太慢:改成 CSS 像素截图(不重建上下文,不丢登录状态)
                self.cap_ema = None
                self.last_hash = None
                self.add_log("system", "高 DPR 截图平均耗时超过 %d ms,已降为 CSS 像素截图(%dx%d)以保证流畅" % (CAP_SLOW_MS, self.view[0], self.view[1]))
            if self.shot_scale == "css" and self.dpr > 1.0:
                why.append("高 DPR 截图过慢:已降为 CSS 像素截图")
            self.degraded = ";".join(why)
            if epoch != self.view_epoch:
                continue                                          # 截图期间分辨率档位变了:这帧作废,不当作当前画面
            h = hashlib.md5(b).hexdigest()
            if h != self.last_hash:
                self.last_hash = h
                self.frames += 1
                self.frame_seq += 1
                self.bytes_sent += len(b) * len(self.subs)
                self.kb_ema = len(b) / 1024.0 if self.kb_ema is None else 0.8 * self.kb_ema + 0.2 * len(b) / 1024.0
                self.sent_ts.append(time.time())
                sz = jpeg_size(b) or (int(self.view[0] * (self.dpr if self.shot_scale == "device" else 1)), int(self.view[1] * (self.dpr if self.shot_scale == "device" else 1)))
                try:
                    ttl = (await pg.title())[:80]
                except Exception:  # noqa: BLE001
                    ttl = ""
                fm = {"type": "frame", "id": self.frame_seq, "ts": int(time.time() * 1000), "epoch": epoch, "url": netguard.safe_url_for_log(pg.url), "title": ttl, "vw": self.view[0], "vh": self.view[1],
                      "pw": sz[0], "ph": sz[1], "dpr": self.dpr, "eff_dpr": round(sz[0] / float(self.view[0]), 3), "bytes": len(b), "cap_ms": round(cap_ms), "status": self.status, "profile": self.profile, "scale": self.shot_scale}
                self.last_frame_meta = {k: v for k, v in fm.items() if k != "type"}
                _slow = any(s.frame is not None for s in self.subs)
                for s in list(self.subs):
                    s.push_frame(b, fm)
                if self.v12 is not None:
                    self.v12.on_emit(b, src or "shot", _slow)
                self.emit({"type": "meta", "url": pg.url, "title": ttl, "frames": self.frames, "bytes_sent": self.bytes_sent, "perf": self.perf_public()})
            await asyncio.sleep(0 if src == "cast" else max(0.02, interval - (time.time() - t_loop)))

    # —— 分辨率档位(CSS 视口 / DPR):仅视口变化 → 原地调整;DPR 变化 → 需要重建上下文,必须先让用户确认 ——
    async def set_profile(self, name, confirm_rebuild=False):
        if name not in PROFILES:
            raise ActionError("未知的分辨率档位:%s" % str(name)[:20])
        if self.task and not self.task.done():
            raise ActionError("任务正在执行:请先取消或等它完成,再切换分辨率")
        p = PROFILES[name]
        new_view, new_dpr = (p["w"], p["h"]), p["dpr"]
        live = self.ctx is not None and self.page is not None and not self.page.is_closed()
        if name == self.profile and (new_view == self.view):
            return self.public()
        rebuild = live and abs(new_dpr - self.dpr) > 1e-6
        if rebuild and not confirm_rebuild:
            raise RebuildNeeded("切换到「%s」需要重建浏览器上下文(设备像素比 %.2g → %.2g):当前页面的 Cookie / 登录状态会被清除,并重新打开当前网址。确认后才会执行。" % (p["label"], self.dpr, new_dpr))
        url = self.page.url if live else ""
        if rebuild:
            try:
                await self.ctx.close()
            except Exception:  # noqa: BLE001
                pass
            self.ctx, self.pages, self.page = None, [], None
            self.add_log("system", "已按你的确认重建浏览器上下文:Cookie/登录状态已清除")
        self.profile, self.view, self.dpr = name, new_view, new_dpr
        self.view_epoch += 1
        self.shot_scale, self.cap_ema, self.degraded, self.last_hash, self.cursor = "device", None, "", None, None
        self.vframes.clear()
        if live and not rebuild:
            for pg in list(self.pages):
                try:
                    await pg.set_viewport_size({"width": new_view[0], "height": new_view[1]})
                except Exception:  # noqa: BLE001
                    pass
        elif rebuild:
            await self.ensure()
            if re.match(r"^https?://", url or ""):
                try:
                    await self.do({"action": "goto", "url": url})
                except ActionError as e:
                    self.add_log("error", "重新打开网址失败:%s" % str(e)[:100])
        self.add_log("system", "分辨率档位:%s · CSS 视口 %dx%d · DPR %.2g" % (p["label"], new_view[0], new_view[1], new_dpr))
        if self.v12 is not None:
            await self.v12.reset_cast()                           # 视口/DPR 变了:Screencast 按新尺寸重开
        self.set_status(self.status, self.msg)
        return self.public()

    # —— 视觉观察:服务端截图并登记帧 ID(click_at 只接受这里登记过的帧) ——
    async def vision_snapshot(self, quality=70):
        pg = self.page
        if pg is None or pg.is_closed():
            raise ActionError("隔离浏览器里还没有打开任何页面")
        b = await pg.screenshot(type="jpeg", quality=quality, timeout=6000, scale="css")
        self.frame_seq += 1
        sz = jpeg_size(b) or self.view
        meta = {"id": self.frame_seq, "ts": time.time(), "epoch": self.view_epoch, "url": pg.url, "vw": self.view[0], "vh": self.view[1], "pw": sz[0], "ph": sz[1], "dpr": self.dpr}
        self.vframes[meta["id"]] = meta
        while len(self.vframes) > 6:
            self.vframes.pop(next(iter(self.vframes)))
        return b, meta

    def on_results_page(self):
        pg = self.page
        try:
            host = (urlsplit(pg.url).hostname or "").lower() if pg and not pg.is_closed() else ""
        except Exception:  # noqa: BLE001
            return False
        return bool(host) and any(host.endswith((urlsplit(e["home"]).hostname or "~").replace("www.", "")) for e in ENGINES.values()) and ("q=" in pg.url or "/search" in pg.url)

    async def _collect_page_results(self):
        """当前页本身就是搜索结果页(例如用户手动打开)时,直接解析它,让「打开第一个结果」可用。"""
        host = (urlsplit(self.page.url).hostname or "").lower()
        for ename, e in ENGINES.items():
            eh = (urlsplit(e["home"]).hostname or "~").replace("www.", "")
            if host.endswith(eh):
                try:
                    raw = await self.page.evaluate(e["js"])
                except Exception:  # noqa: BLE001
                    return
                res, seen, t = [], set(), now_iso()
                for r in raw or []:
                    u = unwrap_result_url(r["url"])
                    if not re.match(r"^https?://", u) or u in seen:
                        continue
                    try:
                        netguard.check_url(u, resolve=False)
                    except netguard.Blocked:
                        continue
                    seen.add(u)
                    res.append({"title": r["title"][:200], "url": u, "domain": (urlsplit(u).hostname or ""), "snippet": r["snippet"], "fetched_at": t, "rank": len(res) + 1, "provider": "page:" + ename})
                if res:
                    self.last_results = res
                    for r_ in res:
                        self.seen_results[r_["url"]] = r_
                    self.add_log("verify", "已从当前搜索结果页解析到 %d 条结果" % len(res), ok=True)
                return

    # —— 控制 ——
    def pause(self):
        if self.status in ("running", "waiting_confirm"):
            self.pause_ev.clear()
            self.set_status("paused", "已暂停(可点继续,或人工接管)")
            self.add_log("control", "用户暂停")

    def resume(self):
        self.pause_ev.set()
        if self.status in ("paused", "waiting_human"):
            self.set_status("running" if self.task and not self.task.done() else "idle", "")
            self.add_log("control", "用户继续")

    def cancel(self):
        self.cancel_flag = True
        self.pause_ev.set()
        if self.pending and not self.pending["fut"].done():
            self.pending["fut"].set_result(False)
        if self.task and not self.task.done():
            self.task.cancel()
        self.add_log("control", "用户取消任务")
        self.set_status("cancelled", "已取消")

    def answer_confirm(self, cid, approve):
        if not self.pending or self.pending["id"] != cid:
            raise ActionError("没有等待中的确认(可能已超时)")
        if not self.pending["fut"].done():
            self.pending["fut"].set_result(bool(approve))
        return True

    async def _gate(self):
        if self.cancel_flag:
            raise asyncio.CancelledError()
        await self.pause_ev.wait()
        if self.cancel_flag:
            raise asyncio.CancelledError()

    async def _confirm(self, action, site, summary, consequence):
        cid = "c" + hashlib.md5(("%s%s" % (time.time(), summary)).encode()).hexdigest()[:8]
        fut = asyncio.get_running_loop().create_future()
        self.pending = {"id": cid, "action": action, "site": site, "summary": summary[:300], "consequence": consequence, "fut": fut, "created": now_iso()}
        self.set_status("waiting_confirm", "等待你确认:" + summary[:80])
        self.add_log("confirm", "需要确认 → %s | 网站 %s | %s" % (action, site, summary[:120]))
        self.emit({"type": "confirm", **{k: v for k, v in self.pending.items() if k != "fut"}})
        try:
            ok = await asyncio.wait_for(fut, CONFIRM_TIMEOUT_S)
        except asyncio.TimeoutError:
            ok = False
        self.pending = None
        self.add_log("confirm", "用户%s" % ("已确认,继续执行" if ok else "拒绝/超时,未执行"))
        if ok:
            self.set_status("running", "")
        return ok

    # —— 页面辅助 ——
    async def _settle(self):
        if self.v12 is not None and self.page is not None:      # v12:事件驱动(网络空闲 + 新帧 + 去抖,最长 3 秒),取代固定 sleep 0.5
            return await self.v12.settle()
        try:
            await self.page.wait_for_load_state("domcontentloaded", timeout=6000)
        except Exception:  # noqa: BLE001
            pass
        await asyncio.sleep(0.5)

    async def _snapshot_state(self):
        pg = self.page
        try:
            h = await pg.evaluate("() => (document.body ? document.body.innerText.length : 0) + ':' + Math.round(window.scrollY)")
        except Exception:  # noqa: BLE001
            h = "?"
        return {"url": pg.url, "title": (await pg.title())[:100] if not pg.is_closed() else "", "sig": h}

    async def _check_blockers(self, soft=False):
        """验证码/反机器人/登录墙 → 暂停交给用户,绝不尝试绕过"""
        try:
            r = await self.page.evaluate(BLOCKER_JS)
        except Exception:  # noqa: BLE001
            return
        host = urlsplit(r["url"]).hostname or ""
        if r["frame"] or BLOCKER_RE.search(r["text"]) or "consent.google" in host or "/sorry/" in r["url"]:
            self.add_log("blocked", "页面需要人工处理(验证码/同意页/反机器人检测):%s。本系统不会绕过,请点「人工接管」自己完成后再继续。" % host)
            if soft:
                raise SearchBlocked("%s 出现验证/反机器人页" % host)
            raise NeedHuman("页面出现验证/同意/反机器人检测(%s),需要你亲自处理" % host)

    async def _mouse_to(self, x, y, kind="move"):
        """真实的鼠标移动:沿缓动曲线把路径拆成若干点,每个点都是一次真实的 page.mouse.move,并带着该点的真实坐标与时间戳推给前端
        (前端只在这些真实事件之间做插值,不播放预设路径)。"""
        x0, y0 = (self.cursor["x"], self.cursor["y"]) if self.cursor else (self.view[0] * 0.5, self.view[1] * 0.12)
        dist = ((x - x0) ** 2 + (y - y0) ** 2) ** 0.5
        n = max(6, min(26, int(dist / 22)))
        cx, cy = (x0 + x) / 2 + (y0 - y) * 0.08, (y0 + y) / 2 + (x - x0) * 0.08           # 轻微弧线(二次贝塞尔控制点)
        for i in range(1, n + 1):
            t = i / n
            e = t * t * (3 - 2 * t)                                                       # smoothstep 缓入缓出
            px = (1 - e) ** 2 * x0 + 2 * (1 - e) * e * cx + e * e * x
            py = (1 - e) ** 2 * y0 + 2 * (1 - e) * e * cy + e * e * y
            await self.page.mouse.move(px, py)
            self.cursor = {"x": round(px), "y": round(py), "kind": kind if i == n else "move", "t": time.time()}
            self.last_input = time.time()
            self.emit({"type": "cursor", **self.cursor, "vw": self.view[0], "vh": self.view[1], "step": i, "of": n})
            await asyncio.sleep(0.011)

    def _loc(self, spec):
        pg = self.page
        by, val = spec.get("by", "text"), spec["value"]
        if by == "role":
            return pg.get_by_role(spec.get("role") or "button", name=val)
        if by == "label":
            return pg.get_by_label(val)
        if by == "placeholder":
            return pg.get_by_placeholder(val)
        return pg.get_by_text(val, exact=False)

    async def _resolve(self, spec):
        """定位必须唯一;不唯一/找不到 → 暂停并解释(不盲点)。优先 角色/标签 语义,再退到文本。"""
        loc = self._loc(spec)
        try:
            n = await loc.count()
        except Exception as e:  # noqa: BLE001
            raise ActionError("定位失败:%s" % str(e)[:80])
        if n == 0 and spec.get("by") == "text":
            for role in ("button", "link"):
                alt = self.page.get_by_role(role, name=spec["value"])
                if await alt.count():
                    loc, n = alt, await alt.count()
                    break
        if n == 0:
            raise ActionError("页面上找不到「%s」(页面结构可能已变化)" % spec["value"][:40])
        if spec.get("nth") is not None:
            if spec["nth"] >= n:
                raise ActionError("「%s」只有 %d 个匹配,没有第 %d 个" % (spec["value"][:30], n, spec["nth"] + 1))
            return loc.nth(spec["nth"])
        vis = []
        for i in range(min(n, 8)):
            try:
                if await loc.nth(i).is_visible():
                    vis.append(i)
            except Exception:  # noqa: BLE001
                pass
        if len(vis) == 1:
            return loc.nth(vis[0])
        if len(vis) == 0:
            raise ActionError("「%s」存在但不可见" % spec["value"][:40])
        raise ActionError("「%s」匹配到 %d 个可见元素,定位不唯一,已暂停(可在指令里说“第N个”,或人工接管点击)" % (spec["value"][:30], len(vis)))

    async def _describe(self, loc):
        return await loc.evaluate("""el => { const f=el.form||el.closest('form'); const t=(el.innerText||el.value||el.getAttribute('aria-label')||el.title||'').trim().slice(0,100);
          const sr = !!(f && (f.getAttribute('role')==='search' || f.querySelector('input[type=search],input[name=q],input[name=query],input[name=wd],input[name=s]')));
          return {tag:el.tagName.toLowerCase(), type:(el.type||'').toLowerCase(), text:t, name:(el.name||'')+' '+(el.id||'')+' '+(el.autocomplete||'')+' '+(el.getAttribute('aria-label')||'')+' '+(el.placeholder||''),
                  inForm:!!f, method:f?(f.method||'get').toLowerCase():'', action:f?(f.action||''):'', searchForm:sr, download:el.hasAttribute('download'),
                  hasPw:!!(f && f.querySelector('input[type=password]')), contentEditable:!!el.isContentEditable, role:el.getAttribute('role')||''}; }""")

    def _click_risk(self, d, host):
        reasons = []
        if d["type"] == "file":
            return "block", ["文件上传需要你亲自选择文件(已禁止自动上传)"]
        if d["download"]:
            reasons.append("会下载文件(下载已被禁用)")
        sub = d["inForm"] and d["tag"] in ("button", "input") and d["type"] in ("submit", "image", "")
        if sub and not d["searchForm"]:
            reasons.append("会提交表单 → %s" % (urlsplit(d["action"]).netloc or host))
        is_field = d["tag"] in ("textarea", "select") or (d["tag"] == "input" and d["type"] not in ("submit", "image", "button", "reset"))
        if d["hasPw"] and d["inForm"] and not is_field:
            reasons.append("这是含密码输入框的登录/注册表单")
        if not is_field and RISK_RE.search(d["text"] or ""):
            reasons.append("按钮/链接文字含高影响词「%s」" % d["text"][:30])
        return ("confirm" if reasons else "ok"), reasons

    # —— 动作 ——
    async def do(self, a):
        k = a["action"]
        pg = self.page
        before = await self._snapshot_state()
        host = urlsplit(pg.url).hostname or "(空白页)"
        if k == "goto":
            try:
                url = await netguard.acheck_url(netguard.normalize_user_target(a["url"]))
            except netguard.Blocked as e:
                self.blocked += 1
                raise ActionError("安全策略拒绝访问:%s" % e, fatal=True)
            self.add_log("action", "打开 %s" % netguard.safe_url_for_log(url), action=k)
            b0, pb0 = self.blocked, self.mgr.proxy_blocked()
            try:
                await pg.goto(url, wait_until="domcontentloaded", timeout=20000)
            except Exception as e:  # noqa: BLE001
                if "blockedbyclient" in str(e) or "ERR_BLOCKED" in str(e):
                    raise ActionError("导航被安全策略阻止(重定向到了不允许的地址)", fatal=True)
                raise ActionError("打开失败:%s" % str(e).splitlines()[0][:100])
            await self._settle()
            hit = self.blocked > b0 or self.mgr.proxy_blocked() > pb0
            if hit or pg.url.startswith(("chrome-error:", "about:neterror")):
                if hit:
                    self.blocked += 1
                    self.add_log("blocked", "网络护栏拦截:%s" % (self.mgr.proxy.events[-1]["reason"] if self.mgr.proxy and self.mgr.proxy.events else "目标不被允许"))
                raise ActionError("导航被安全策略阻止(目标或重定向指向不允许的地址)" if hit else "页面加载失败(网络错误)", fatal=hit)
            await self._check_blockers()
            st = await self._snapshot_state()
            self.add_log("verify", "已到达 %s · 标题「%s」" % (netguard.safe_url_for_log(st["url"]), st["title"]), ok=True)
        elif k in ("back", "forward", "reload"):
            self.add_log("action", {"back": "返回", "forward": "前进", "reload": "刷新"}[k], action=k)
            try:
                await {"back": pg.go_back, "forward": pg.go_forward, "reload": pg.reload}[k](wait_until="domcontentloaded", timeout=15000)
            except Exception as e:  # noqa: BLE001
                raise ActionError("%s失败:%s" % (k, str(e)[:80]))
            await self._settle()
            await self._check_blockers()
            st = await self._snapshot_state()
            self.add_log("verify", "当前 %s · 「%s」" % (netguard.safe_url_for_log(st["url"]), st["title"]), ok=True)
        elif k == "search":
            await self._search(a)
        elif k == "search_more":
            if not self.last_query:
                raise ActionError("还没有进行过搜索,无法“再搜几个来源”")
            q = dict(self.last_query)
            q["page"] = self.search_page + 1
            await self._search(q, direct=True)
        elif k == "open_result":
            if not self.last_results:
                await self._collect_page_results()
            if not self.last_results:
                raise ActionError("没有搜索结果可打开(请先搜索,或先打开一个搜索结果页)")
            if a["n"] > len(self.last_results):
                raise ActionError("只有 %d 条结果,没有第 %d 条" % (len(self.last_results), a["n"]))
            r = self.last_results[a["n"] - 1]
            self.add_log("action", "打开搜索结果 #%d(来源 %s)" % (a["n"], r["domain"]), action=k)
            await self.do({"action": "goto", "url": r["url"]})
        elif k == "scroll":
            await self._mouse_to(self.view[0] / 2, self.view[1] / 2, "scroll")
            y0 = await pg.evaluate("window.scrollY")
            if a["direction"] == "top":
                await pg.evaluate("window.scrollTo(0,0)")
            elif a["direction"] == "bottom":
                await pg.evaluate("window.scrollTo(0,document.body.scrollHeight)")
            else:
                await pg.mouse.wheel(0, a["amount"] * (1 if a["direction"] == "down" else -1))
            await asyncio.sleep(0.5)
            y1 = await pg.evaluate("window.scrollY")
            self.add_log("action", "滚动 %s" % {"up": "向上", "down": "向下", "top": "到顶部", "bottom": "到底部"}[a["direction"]], action=k)
            self.add_log("verify", "滚动位置 %d → %d%s" % (y0, y1, "" if y1 != y0 else "(没有变化:已到页面边界)"), ok=True)
        elif k == "click":
            loc = await self._resolve(a)
            await self._click_loc(loc, host, "点击「%s」" % a["value"][:30])
        elif k == "click_at":
            await self._click_visual(a, host)
        elif k == "type":
            if a.get("into"):
                loc = await self._resolve(a["into"])
                await self._click_loc(loc, host, "聚焦输入框「%s」" % a["into"]["value"][:30], typing=True)
            await self._type(a["text"], host)
            if a.get("submit"):
                await self.do({"action": "key", "key": "Enter"})
        elif k == "key":
            d = await pg.evaluate("""() => { const el=document.activeElement; if(!el) return null; const f=el.closest&&el.closest('form');
              const sr=!!(f&&(f.getAttribute('role')==='search'||f.querySelector('input[type=search],input[name=q],input[name=query],input[name=wd],input[name=s]')));
              return {tag:el.tagName.toLowerCase(), type:(el.type||'').toLowerCase(), inForm:!!f, searchForm:sr, ce:!!el.isContentEditable, hasPw:!!(f&&f.querySelector('input[type=password]')), action:f?f.action:''}; }""")
            if a["key"] == "Enter" and d and ((d["inForm"] and not d["searchForm"]) or d["ce"] or d["hasPw"]):
                ok = await self._confirm("按 Enter", host, "在 %s 的%s里按 Enter,可能会提交表单/发送消息" % (host, "编辑区" if d["ce"] else "表单输入框"),
                                         "提交后内容会发送到 %s;这可能无法撤销" % (urlsplit(d["action"]).netloc or host))
                if not ok:
                    raise ActionError("你拒绝了该操作,未执行", fatal=True)
            self.add_log("action", "按键 %s" % a["key"], action=k)
            self.emit({"type": "key", "key": a["key"], "t": time.time()})
            self.last_input = time.time()
            await pg.keyboard.press(a["key"])
            await self._settle()
            await self._check_blockers()
            st = await self._snapshot_state()
            self.add_log("verify", "按键后页面:%s%s" % (netguard.safe_url_for_log(st["url"]), "(已跳转)" if st["url"] != before["url"] else ""), ok=True)
        elif k == "read":
            txt = await pg.evaluate("() => (document.body ? document.body.innerText : '').replace(/\\n{3,}/g,'\\n\\n').slice(0, 8000)")
            st = await self._snapshot_state()
            self.observation = {"url": st["url"], "title": st["title"], "text": txt, "read_at": now_iso(), "untrusted": True}
            self.add_log("action", "读取页面文字 %d 字符(作为不可信数据,不会被当作指令)" % len(txt), action=k)
            self.add_log("verify", "已读取「%s」" % st["title"], ok=bool(txt.strip()))
        elif k == "snapshot":
            st = await self._snapshot_state()
            self.add_log("action", "查看页面", action=k)
            self.add_log("verify", "当前页面 %s · 「%s」" % (netguard.safe_url_for_log(st["url"]), st["title"]), ok=True)
        elif k == "wait":
            await asyncio.sleep(a["seconds"])

    async def _describe_at(self, x, y):
        h = await self.page.evaluate_handle("([x, y]) => { const e = document.elementFromPoint(x, y); if (!e) return null; return e.closest('a,button,input,select,textarea,summary,[role=button],[role=link],[role=tab],[role=menuitem],[onclick]') || e; }", [x, y])
        el = h.as_element()
        return await self._describe(el) if el is not None else None

    async def _click_visual(self, a, host):
        """视觉坐标点击:模型只提议归一化坐标;这里负责校验(帧 ID/过期/视口/URL/置信度/越界)→ 元素风险检查 → 真实 Playwright 点击 → 核对页面变化(没变化就暂停,不连续盲点)。"""
        pg = self.page
        x, y = check_visual_target(self.vframes.get(a["frame_id"]), pg.url, self.view, self.view_epoch, a["nx"], a["ny"], a["confidence"])
        d = await self._describe_at(x, y)
        if d is None:
            raise ActionError("该坐标处没有页面元素,已停止(不会盲点)")
        if d["type"] in ("password", "file", "hidden") or SENSITIVE_RE.search(d["name"] or ""):
            raise ActionError("目标是密码/验证码/银行卡/文件字段:拒绝自动点击(请点「人工接管」亲自操作)", fatal=True)
        lvl, reasons = self._click_risk(d, host)
        label = "视觉点击「%s」" % a["target"][:30]
        if lvl == "block":
            raise ActionError("; ".join(reasons), fatal=True)
        if lvl == "confirm":
            ok = await self._confirm(label, host, "%s(元素:%s「%s」)" % (label, d["tag"], d["text"][:40]), "可能产生外部影响:" + ";".join(reasons) + "。目标网站:" + host)
            if not ok:
                raise ActionError("你拒绝了该操作,未执行", fatal=True)
            check_visual_target(self.vframes.get(a["frame_id"]), pg.url, self.view, self.view_epoch, a["nx"], a["ny"], a["confidence"])     # 等待确认期间页面可能变了:再校验一次
        await self._mouse_to(x, y, "move")
        before = await self._snapshot_state()
        self.add_log("action", "%s @(%d,%d) CSS 像素 · 置信度 %.2f" % (label, x, y, a["confidence"]), action="click_at", x=round(x), y=round(y))
        await pg.mouse.click(x, y)
        self.cursor = {"x": round(x), "y": round(y), "kind": "click", "t": time.time()}
        self.emit({"type": "cursor", **self.cursor, "vw": self.view[0], "vh": self.view[1]})
        await self._settle()
        await self._check_blockers()
        after = await self._snapshot_state()
        changed = after["url"] != before["url"] or after["sig"] != before["sig"]
        try:
            editable = await pg.evaluate("() => { const e=document.activeElement; return !!(e && (e.tagName==='INPUT'||e.tagName==='TEXTAREA'||e.isContentEditable)); }")
        except Exception:  # noqa: BLE001
            editable = False
        self.add_log("verify", "视觉点击后页面%s" % ("发生变化" if changed else ("焦点在输入框" if editable else "没有明显变化")), ok=bool(changed or editable), changed=changed)
        if not changed and not editable:
            raise ActionError("视觉点击后页面没有按预期变化,已暂停(不会连续盲点);可以重新观察、换个说法或人工接管")

    async def _click_loc(self, loc, host, label, typing=False):
        d = await self._describe(loc)
        lvl, reasons = self._click_risk(d, host)
        if lvl == "block":
            raise ActionError("; ".join(reasons), fatal=True)
        if lvl == "confirm":
            ok = await self._confirm(label, host, "%s(元素:%s「%s」)" % (label, d["tag"], d["text"][:40]), "可能产生外部影响:" + ";".join(reasons) + "。目标网站:" + host)
            if not ok:
                raise ActionError("你拒绝了该操作,未执行", fatal=True)
        await loc.scroll_into_view_if_needed(timeout=5000)
        bb = await loc.bounding_box()
        if not bb:
            raise ActionError("元素没有可点击区域")
        x, y = bb["x"] + bb["width"] / 2, bb["y"] + bb["height"] / 2
        await self._mouse_to(x, y, "move")
        vctx = (await self.v12.verifier.before(x, y)) if self.v12 is not None else None
