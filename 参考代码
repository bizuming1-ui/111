    import netguard
    res, seen, t = [], set(), now_iso()
    for r in raw:
        u = r.get("url") or ""
        if not re.match(r"^https?://", u) or u in seen:
            continue
        try:
            netguard.check_url(u, resolve=False)
        except netguard.Blocked:
            continue
        seen.add(u)
        res.append(_norm(r.get("title") or u, u, r.get("snippet"), provider, len(res) + 1 + base_rank, t))
        if len(res) >= count:
            break
    return res


