def weights_match():
    fps = [(b.get("weights_params"), b.get("weights_abs_sum")) for b in BACKEND.values() if b.get("weights_abs_sum") is not None]
    if len(fps) < 2:
        return None
    return all(f == fps[0] for f in fps)


def read_train_progress():
    out = {"event": "train_progress", "status": "idle", "epoch": None, "similarity": None}
    try:
        if TRAIN_STATE.exists():
            out.update(json.loads(TRAIN_STATE.read_text(encoding="utf-8")))
        if EVAL_LOG.exists():
            rows = []
            for ln in EVAL_LOG.read_text(encoding="utf-8").splitlines():
                try:
                    rows.append(json.loads(ln))
                except ValueError:
                    pass
            if rows:
                out["evals"] = rows[-30:]
                out["epoch_eval"], out["similarity"] = rows[-1].get("epoch"), rows[-1].get("sim_val_centroid", rows[-1].get("similarity"))
    except Exception:  # noqa: BLE001
        pass
    out["event"] = "train_progress"
    return out


def gpu_table():
    rows = []
    tr = read_train_progress()
    training = tr.get("status") in ("running", "starting")
    tg = {str(g.get("device_index")): g for g in (tr.get("gpus") or [])}
    for idx, r in sorted(GPU_ROWS.items()):
        task = "空闲"
        role = ""
        for w in (POOL.workers if POOL else []):
            if str(w.gpu) == str(idx):
                role = "推理 worker%d" % w.idx
                task = {"loading": "加载模型", "voice": "克隆/识别中", "error": "出错", "ready": "就绪"}.get(w.status, w.status)
                if w.inflight and w.cur:
                    task = "合成 轮次#%s 第%d句" % (w.cur[0], w.cur[1] + 1)
        if training:
            g = tg.get(str(idx))
            role, task = "训练", "训练中" + ((" · rank %s" % g.get("rank")) if g else "")
        rows.append({"index": idx, "name": r["name"], "util": r["util"], "mem_used": round(r["mem_used"], 2), "mem_total": round(r["mem_total"], 2), "role": role, "task": task})
    return rows


