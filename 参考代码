    return "English"


STRONG = set("。！？!?；;\n…")
WEAK = set("，,、：:")
# (最短长度, 逗号处可切的长度, 强制切断长度)  —— 第 1 句极短(抢首声),越往后越长(韵律更自然,且有前面的播放时间掩护)
LIMITS = [(3, 3, 16), (6, 10, 26), (8, 16, 36), (10, 24, 50)]


class Segmenter:
    """把 DeepSeek 流式吐出的文字按标点切成适合 TTS 的片段。"""

    def __init__(self):
        self.buf = ""
        self.n = 0

    def push(self, t):
        self.buf += t
        return self._drain()

    def finish(self):
        out = self._drain()
        rest = self.buf.strip()
        self.buf = ""
        if rest:
            out.append(rest)
            self.n += 1
        return out

    def _drain(self):
        out = []
        while True:
            mn, soft, hard = LIMITS[min(self.n, len(LIMITS) - 1)]
            cut = self._find(mn, soft, hard)
            if cut is None:
                break
            seg, self.buf = self.buf[:cut], self.buf[cut:]
            if seg.strip():
                out.append(seg.strip())
                self.n += 1
        return out

    def _find(self, mn, soft, hard):
        b = self.buf
        L = len(b)
        for i, ch in enumerate(b):
            ln = i + 1
            if ch in STRONG and ln >= mn:
                return ln
            if ch == "." and ln >= mn and i + 1 < L and b[i + 1] in " \n":
                return ln
            if ch in WEAK and ln >= soft:
                return ln
            if ln >= hard:
                j = max(b.rfind(c, hard // 2, ln) for c in "，,、 ")
                return (j + 1) if j > 0 else ln
        return None


_PAUSE_MS = [("。！？!?…\n", 260), ("；;：:", 190), ("，,、", 110)]


def pause_ms(end_char, scale):
    base = 60
    for chars, ms in _PAUSE_MS:
        if end_char and end_char in chars:
            base = ms
            break
    return int(base * max(0.0, min(2.5, scale)))


# ════════════════════════════════════════════════════════════════
#  去静音器: 每段 TTS 开头/结尾的静音都会变成"停顿感",在这里统一去掉,再由网关按标点插入自然停顿
# ════════════════════════════════════════════════════════════════
class Trimmer:
    F = SR // 100            # 10ms 一帧
    THR = 110.0              # RMS 低于它视为静音
    MAX_INNER = 40           # 句中静音最长保留 400ms

    def __init__(self):
        self.carry = np.zeros(0, np.int16)
        self.started = False
        self.pending = []    # 暂存的静音帧(等到后面有声音才决定要不要放出)
        self.held = None     # 最后一个有声帧(留着,结束时做淡出)
        self.total = 0

    def _emit(self, out, fr):
        if self.held is not None:
            out.append(self.held)
        self.held = fr

    def feed(self, x):
        buf = np.concatenate([self.carry, x]) if self.carry.size else x
        n = len(buf) // self.F
        self.carry = buf[n * self.F:].copy()
        out = []
        if n:
            fr = buf[:n * self.F].reshape(n, self.F)
            rms = np.sqrt((fr.astype(np.float32) ** 2).mean(axis=1))
            for k in range(n):
                f = fr[k]
                if rms[k] >= self.THR:
                    if not self.started:
                        self.started = True
                        f = f.copy()
                        m = min(len(f), SR // 200)                      # 开头 5ms 淡入
                        f[:m] = (f[:m] * np.linspace(0, 1, m, dtype=np.float32)).astype(np.int16)
                    else:
                        for p in self.pending[: self.MAX_INNER]:
                            self._emit(out, p)
                    self.pending = []
                    self._emit(out, f)
                elif self.started:
                    self.pending.append(f)
        return self._join(out)

    def flush(self):
        out = []
        if self.carry.size and self.started and np.sqrt((self.carry.astype(np.float32) ** 2).mean()) >= self.THR:
            for p in self.pending[: self.MAX_INNER]:
                self._emit(out, p)
            self.pending = []
            self._emit(out, self.carry)
        self.carry = np.zeros(0, np.int16)
        self.pending = []                                              # 结尾静音直接丢弃
        if self.held is not None:
            h = self.held.copy()
            m = min(len(h), SR // 125)                                 # 结尾 8ms 淡出
            h[-m:] = (h[-m:] * np.linspace(1, 0, m, dtype=np.float32)).astype(np.int16)
            out.append(h)
            self.held = None
        return self._join(out)

    def _join(self, out):
        if not out:
            return np.zeros(0, np.int16)
        a = np.concatenate(out)
        self.total += len(a)
        return a


# ════════════════════════════════════════════════════════════════
#  声音电平 / 重采样小工具
# ════════════════════════════════════════════════════════════════
def speech_rms(pcm):
    """只统计"有声帧"(10ms RMS > 阈值)的整体 RMS(int16 量纲)。用于两张卡的音量对齐。"""
    pcm = np.asarray(pcm)
    fr = SR // 100
    n = len(pcm) // fr
    if n < 5:
        return 0.0
    f = pcm[: n * fr].astype(np.float32).reshape(n, fr)
    r = np.sqrt((f ** 2).mean(axis=1))
    thr = max(110.0, float(np.percentile(r, 90)) * 0.12)
    v = f[r >= thr]
    return float(np.sqrt((v ** 2).mean())) if v.size else 0.0


def _f2pcm(a):
    if hasattr(a, "detach"):
        a = a.detach().float().cpu().numpy()
    a = np.nan_to_num(np.asarray(a, dtype=np.float32).reshape(-1))
    return (np.clip(a, -1, 1) * 32767.0).round().astype("<i2")


def _seed_all():
    """两张卡每段合成前都用同一个随机种子 -> 音色/语气走向一致"""
    import random
    random.seed(SEED)
    np.random.seed(SEED)
    try:
        import torch
        torch.manual_seed(SEED)
        torch.cuda.manual_seed_all(SEED)
    except Exception:  # noqa: BLE001
        pass


