        chain = [first] + [e for e in FALLBACK_ORDER if e != first and e in ENGINES]
        fails = []
        for i, ename in enumerate(chain):
            if i:
                self.add_log("action", "自动回退:改用 %s 搜索同一个关键词(上一个引擎:%s)" % (ENGINES[ename]["name"], fails[-1][1][:60]), action="search")
