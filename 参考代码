                assert fm["pw"] == round(p["w"] * p["dpr"]) and fm["ph"] == round(p["h"] * p["dpr"]), ("截图实际像素 = CSS 视口 × DPR", fm)
                assert sub.frame[:2] == b"\xff\xd8" and ba.jpeg_size(sub.frame) == (fm["pw"], fm["ph"])
