        return True, "达标", best["epoch"], best["similarity"]
    since = (epoch + 1) - best["epoch"]
    if since >= patience:
        return True, "收敛(连续 %d 轮无提升)" % patience, best["epoch"], best["similarity"]
    if epoch + 1 >= max_epochs:
        return True, "达到最大轮数", best["epoch"], best["similarity"]
    return False, "", best["epoch"], best["similarity"]


def write_state(path, **kw):
    try:
        old = {}
        if Path(path).exists():
            old = json.loads(Path(path).read_text(encoding="utf-8"))
        old.update(kw)
        old["updated"] = time.strftime("%Y-%m-%d %H:%M:%S")
        tmp = str(path) + ".tmp"
        Path(tmp).write_text(json.dumps(old, ensure_ascii=False), encoding="utf-8")
        os.replace(tmp, path)
    except Exception:  # noqa: BLE001
        pass


# ────────────────────────────── 合并导出 ──────────────────────────────
def merge_export(args):
    """把 LoRA 合并进基座权重,导出成一个完整的 Qwen3-TTS-Base 模型目录(faster-qwen3-tts / qwen-tts 都能直接加载)"""
    from safetensors.torch import save_file
    base = resolve_base(args.base)
    ck = torch.load(args.adapter, map_location="cpu")
    cfg = ck["lora_cfg"]
    print("加载基座(CPU, fp16)…", flush=True)
    tts = load_base(base, torch.float16)
    inner = tts.model
    lm, n = build_lora(inner, cfg["r"], cfg["alpha"], 0.0)
    missing, unexpected = inner.load_state_dict(ck["lora"], strict=False)
    bad = [k for k in missing if "lora_" in k]
    if bad or unexpected:
        raise RuntimeError("LoRA 权重与模型不匹配: missing=%s unexpected=%s" % (bad[:5], list(unexpected)[:5]))
    merged = lm.merge_and_unload()
    out = Path(args.out)
    if out.exists():
        shutil.rmtree(out)
    root = os.path.abspath(base)

    def ignore(d, names):
        if os.path.abspath(d) != root:
            return [".git"] if ".git" in names else []
        return [x for x in names if x.endswith((".safetensors", ".bin", ".msgpack", ".h5")) or x == "model.safetensors.index.json" or x.startswith(".")]

    shutil.copytree(base, out, ignore=ignore)
    sd = {k: v.detach().to("cpu", torch.float16).contiguous() for k, v in merged.state_dict().items()}
    save_file(sd, str(out / "model.safetensors"), metadata={"format": "pt"})
    meta = dict(ck.get("meta", {}))
    meta.update(merged_from=str(args.adapter), lora_modules=n, time=time.strftime("%Y-%m-%d %H:%M:%S"), base=args.base)
    if args.ref_wav and Path(args.ref_wav).exists():
        shutil.copy(args.ref_wav, out / "speaker_ref.wav")
        meta["ref_text"] = Path(args.ref_text).read_text(encoding="utf-8").strip() if args.ref_text and Path(args.ref_text).exists() else ""
    import hashlib
    h = hashlib.sha256()
    with open(out / "model.safetensors", "rb") as fh:
        for blk in iter(lambda: fh.read(1 << 23), b""):
            h.update(blk)
    meta["model_sha256"] = h.hexdigest()
    (out / "trained.json").write_text(json.dumps(meta, ensure_ascii=False, indent=2), encoding="utf-8")
    print("✅ 已导出合并后的模型 → %s  (%.2f GB)" % (out, (out / "model.safetensors").stat().st_size / 1e9), flush=True)


