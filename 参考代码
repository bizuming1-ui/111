class Turn:
    def __init__(self, sess, ref, breath, say_only, gpu_policy=None):
        _uid[0] += 1
        self.uid = _uid[0]
        self.sess, self.ref, self.breath, self.say_only = sess, ref, breath, say_only
        self.segs = []
        self.cur = 0
        self.text_done = False
        self.closed = False
        self.pending_pause = 0
        self.t0 = time.time()
        self.first_audio = None
        self.samples = 0                # 已打包进帧的样本数(含插入的停顿)
        self.full_text = ""
        self.gpu_segs = {}
        self.tts = True
        self.warned = False
        self.sim_wait = 0
        self.sim_sent = False
        self.plan = None
        self.window_ms = SEND_AHEAD_MS
        self.seq = 0
        self.log = []                   # 已发出的全部帧,index == seq,用于断线重连后精确续传
        self.played = 0                 # 浏览器回报的已消费样本数
        self.level_ms = None
        self.has_acks = False
        self.done_msg = None
        self.replayed = 0
        self.chunk_log = []             # (seg, gpu, 距轮次开始秒数)
        self.errors = []
        self.lib = dict(VOICE.get("library") or {})      # 任务开始时固定:library_id / 数据集版本 / 参考样本 / 模型哈希 / 采样参数(执行期间切库不影响本任务)
        self.integrity = []
        self.gen_pcm = []
        self.gen_samples = 0
        self.cold = WARM["n"] == 0
        self.llm_t0 = None
        self.llm_chars = 0
        self.policy = gpu_policy or GPU_POLICY
        self.pinned = None
        if self.policy == "pin_turn" and POOL and POOL.workers:
            ok = [w.idx for w in POOL.workers if w.ready()] or [w.idx for w in POOL.workers]
            self.pinned = ok[self.uid % len(ok)]

    # —— 背压 ——
    def played_est(self):
        if self.sess.legacy:                                  # 兼容通道没有 ack:用"还没写出 socket 的字节数"近似
            return max(0, self.samples - self.sess.q_bytes // 2)
        return self.played

    def sent_ahead_ms(self):
        return max(0, self.samples - self.played_est()) * 1000.0 / SR

    def unsent_ms(self):
        n = 0
        for g in self.segs[self.cur:]:
            n += sum(len(a) for a in g.out)
        return n * 1000.0 / SR

    def blocked(self):
        return (self.sent_ahead_ms() + self.unsent_ms()) > self.window_ms

    def llm_cps(self):
        if self.llm_t0 is None or self.llm_chars < 6:
            return None
        return self.llm_chars / max(time.time() - self.llm_t0, 0.2)


