        super().__init__(msg)
        self.fatal = fatal


class NeedHuman(Exception):
    pass


class SearchBlocked(ActionError):
    """搜索引擎出现验证页:不绕过,由 _search 自动换下一个引擎;全部都被拦才交给用户。"""


