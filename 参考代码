_WARM = {"t": 0.0, "cookies": None}


async def _get(url, params=None, headers=None):
    """统一的 HTTP GET:把 httpx 的各种异常归类成 SearchError(kind),不泄露内部堆栈。"""
    import httpx
    is_bing = url.startswith("https://www.bing.com")                                  # 只对真实 Bing 做 Cookie 预热;测试用的本地假站点不受影响
    try:
        async with httpx.AsyncClient(timeout=HTTP_TIMEOUT, follow_redirects=True, headers={**HEADERS, **(headers or {})}, cookies=(_WARM["cookies"] if is_bing else None)) as c:
            if is_bing and (not _WARM["cookies"] or time.time() - _WARM["t"] > 900):
                try:                                                                  # 和普通浏览器一样先访问首页拿会话 Cookie(实测能减少 Bing 对无 Cookie 请求的降级结果);不涉及任何验证绕过
                    await c.get("https://www.bing.com/", params={"setlang": "zh-Hans"}, timeout=6)
                    _WARM.update(t=time.time(), cookies={k: v for k, v in c.cookies.items()})
                except Exception:  # noqa: BLE001
                    pass
            r = await c.get(url, params=params, headers=({"Referer": "https://www.bing.com/"} if is_bing else None))
    except httpx.TimeoutException:
        raise SearchError("timeout", "请求超过 %.0f 秒没有响应" % HTTP_TIMEOUT, True)
    except (httpx.ConnectError, httpx.NetworkError, httpx.RemoteProtocolError) as e:
        raise SearchError("network", "无法连接搜索站点:%s" % (str(e) or type(e).__name__)[:80], True)
    except Exception as e:  # noqa: BLE001
        raise SearchError("network", "%s: %s" % (type(e).__name__, str(e)[:80]), True)
    if r.status_code == 429:
        raise SearchError("rate_limited", "HTTP 429", False, 429)
    if r.status_code >= 500:
        raise SearchError("server_error", "HTTP %d" % r.status_code, True, r.status_code)
    if r.status_code in (401, 403):
        raise SearchError("challenge" if "captcha" in r.text[:3000].lower() else "client_error", "HTTP %d" % r.status_code, False, r.status_code)
    if r.status_code >= 400:
        raise SearchError("client_error", "HTTP %d" % r.status_code, False, r.status_code)
    return r


