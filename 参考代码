    if language:
        kw["language"] = language
    outs = []
    for i in range(0, len(wavs16), 8):
        batch = [{"raw": w, "sampling_rate": 16000} for w in wavs16[i:i + 8]]
        res = pipe(batch, batch_size=len(batch), generate_kwargs=kw)
        outs += [(r.get("text") or "").strip() for r in res]
        print("  转录 %d/%d" % (min(i + 8, len(wavs16)), len(wavs16)), flush=True)
    return outs


def to16(y):
    from speaker_sim import to16k
    return to16k(y, SR)


def split_by_source(clips, val_ratio, seed=42):
    """按【原始录音】切分训练/验证,避免把同一录音里相邻的切片随机分到两边造成数据泄漏。
    录音数 ≥ 4: 整条录音留出;录音太少: 每条录音按时间顺序取末尾约 15% 作验证,并在边界丢弃 1 个缓冲片段。"""
    groups = {}
    for c in clips:
        groups.setdefault(c["source"], []).append(c)
    srcs = sorted(groups)
    rnd = random.Random(seed)
    if len(srcs) >= 4:
        rnd.shuffle(srcs)
        nv = max(1, int(round(len(srcs) * max(val_ratio, 0.15))))
        return [c for s_ in srcs[nv:] for c in groups[s_]], [c for s_ in srcs[:nv] for c in groups[s_]], "group_by_recording"
    train, val = [], []
    for s_ in srcs:
        g = sorted(groups[s_], key=lambda c: c["ci"])
        k = max(1, int(round(len(g) * 0.15))) if len(g) >= 8 else 0
        if k:
            val += g[-k:]
            train += g[:-k - 1]
        else:
            train += g
    return train, val, "temporal_block_per_recording"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--src", default="/kaggle/working/reference_audio")
    ap.add_argument("--out", default="/kaggle/working/data")
    ap.add_argument("--device", default="cuda:0")
    ap.add_argument("--asr_model", default=os.environ.get("VC_ASR_MODEL", "openai/whisper-large-v3-turbo"))
    ap.add_argument("--language", default="", help="转录语言提示,如 chinese / english;留空自动检测")
    ap.add_argument("--tokenizer", default="Qwen/Qwen3-TTS-Tokenizer-12Hz")
    ap.add_argument("--skip_codes", action="store_true")
    ap.add_argument("--val_ratio", type=float, default=0.15)
    ap.add_argument("--keep_suspect", action="store_true", help="保留被质检判为歌声/背景音乐的录音(默认隔离,不与口语样本混训)")
    args = ap.parse_args()

    import soundfile as sf
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import audio_qc as aq
    src, out = Path(args.src), Path(args.out)
    files = sorted(p for p in src.rglob("*") if p.suffix.lower() in EXTS) if src.exists() else []
    if not files:
        raise SystemExit("❌ 在 %s 里没找到音频文件(.wav/.mp3/.flac/.m4a …)。请把参考音频上传成 Kaggle Dataset 并设置 TRAIN_DATA_DIR。" % src)
    if out.exists():
        shutil.rmtree(out)
    (out / "wavs").mkdir(parents=True)
    print("找到 %d 个音频文件,开始切分/统一格式…" % len(files), flush=True)

    clips = []                      # dict(path, text, dur, rms, source, ci, text_source)
    quarantine, src_qc = [], {}
    dropped = {"太短": 0, "太长": 0, "太安静": 0, "读取失败": 0}
    for fi, f in enumerate(files):
        try:
            y = load_audio(f)
        except Exception as e:  # noqa: BLE001
            dropped["读取失败"] += 1
            print("  ⚠ 跳过 %s: %s" % (f.name, e))
            continue
        dur = len(y) / SR
        mid = len(y) // 2
        qc = aq.reference_qc(y[max(0, mid - 20 * SR): mid + 20 * SR], SR)             # 每个原始录音先质检(启发式,未校准)
        src_qc[str(f)] = {k: qc.get(k) for k in ("kind", "kind_zh", "snr_db_est", "note_sustain_ratio", "floor_flatness", "clip_ratio", "warnings")}
        if qc["kind"] in ("singing", "bg_music") and not args.keep_suspect:
            quarantine.append({"source": str(f), "reason": qc["kind_zh"], "warnings": qc["warnings"]})
            print("  ⚠ 隔离 %s:%s(歌声必须单独管理,不与口语样本混训;--keep_suspect 可强制保留)" % (f.name, qc["kind_zh"]))
            continue
        txt_file = f.with_suffix(".txt")
        given = txt_file.read_text(encoding="utf-8", errors="ignore").strip() if txt_file.exists() else ""
        if dur > MAX_S:
            ranges = split_long(y)
            given = ""                                # 长录音的整段文字没法对齐到片段,交给 ASR
        else:
            ranges = [(0, len(y))]
        for ci, (s, e) in enumerate(ranges):
            seg = y[s:e]
            d = len(seg) / SR
            if d < MIN_S:
                dropped["太短"] += 1
                continue
            if d > MAX_S:
                dropped["太长"] += 1
                continue
            if rms_db(seg) < -48:
                dropped["太安静"] += 1
                continue
            pk = float(np.abs(seg).max())
            if pk > 1e-4:
                seg = seg * (0.9 / pk)
            name = "%s_%03d_%02d.wav" % (f.stem[:40].replace(" ", "_"), fi, ci)
            sf.write(str(out / "wavs" / name), seg, SR, subtype="PCM_16")
            clips.append({"audio_path": str(out / "wavs" / name), "text": given, "duration": round(d, 3), "rms": rms_db(seg), "source": str(f), "ci": ci, "text_source": "given" if given else "asr"})
    if not clips:
        raise SystemExit("❌ 过滤后没有可用片段:%s" % dropped)

    need = [c for c in clips if not c["text"]]
    if need:
        print("%d 个片段没有转录文本,使用 Whisper 自动转录…" % len(need), flush=True)
        pipe = build_asr(args.asr_model, args.device)
        texts = transcribe(pipe, [to16(load_audio(c["audio_path"])) for c in need], args.language)
        for c, t in zip(need, texts):
            c["text"] = t
        del pipe
        try:
            import torch
            torch.cuda.empty_cache()
        except Exception:  # noqa: BLE001
            pass
    def cps(c):
        return len([ch for ch in c["text"] if ch.isalnum() or "\u4e00" <= ch <= "\u9fff"]) / max(c["duration"], 0.1)
    bad = [c for c in clips if len(c["text"].strip()) < 2 or len(set(c["text"])) < 3 or (c["text_source"] == "asr" and not (1.2 <= cps(c) <= 9.5))]
    clips = [c for c in clips if c not in bad]
    if bad:
        print("丢弃 %d 个转录无效/为空的片段" % len(bad))
    if len(clips) < 5:
        raise SystemExit("❌ 可用片段只有 %d 条,太少,无法训练(建议总时长 10 分钟以上)。" % len(clips))

    train, val, mode = split_by_source(clips, args.val_ratio)
    srcs_tr, srcs_va = set(c["source"] for c in train), set(c["source"] for c in val)
    if mode == "group_by_recording":
        assert not (srcs_tr & srcs_va), "数据泄漏:同一原始录音同时出现在训练集和验证集"
    n_asr = sum(1 for c in clips if c["text_source"] == "asr")
    (out / "split_report.json").write_text(json.dumps({"mode": mode, "train_clips": len(train), "val_clips": len(val), "train_sources": len(srcs_tr), "val_sources": len(srcs_va),
        "shared_sources": len(srcs_tr & srcs_va), "asr_untrusted_clips": n_asr, "quarantined": quarantine, "source_qc": src_qc}, ensure_ascii=False, indent=2), encoding="utf-8")
    with open(out / "review.tsv", "w", encoding="utf-8") as fh:                  # ASR 转写必须允许人工修正:改好 text 列后放回同名 .txt 重新运行
        fh.write("audio_path\ttext_source\ttext\n")
        for c in clips:
            if c["text_source"] == "asr":
                fh.write("%s\t%s\t%s\n" % (c["audio_path"], c["text_source"], c["text"].replace("\t", " ")))
    print("切分方式: %s · 训练 %d / 验证 %d · 训练与验证共享的原始录音数 %d" % (mode, len(train), len(val), len(srcs_tr & srcs_va)))
    if n_asr:
        print("  ⚠ %d 个片段的文字来自 Whisper 自动识别(未核对),列表见 %s —— 高质量克隆请用与音频严格对应的文字" % (n_asr, out / "review.tsv"))
    if not val:
        print("  ⚠ 数据太少,没有可留出的验证集:无法给出可信的验证 loss / 留出评估(会如实标注)")

    def dump(name, rows):
        with open(out / name, "w", encoding="utf-8") as fh:
            for r in rows:
                fh.write(json.dumps({"audio_path": r["audio_path"], "text": r["text"], "duration": r["duration"], "source": r.get("source"), "text_source": r.get("text_source")}, ensure_ascii=False) + "\n")

    dump("dataset.jsonl", clips)
    dump("train.jsonl", train)
    dump("val.jsonl", val)

    pool = [c for c in train if c["text_source"] == "given"] or train          # 参考音频只从训练集选,且优先用有人工文字的
    cand = [c for c in pool if 6.0 <= c["duration"] <= 12.0] or [c for c in pool if 4.0 <= c["duration"] <= 14.0] or pool
    ref = max(cand, key=lambda c: (c["rms"] > -35) * 2 + (-abs(c["duration"] - 9.0)) / 9.0 + c["rms"] / 100.0)
    shutil.copy(ref["audio_path"], out / "ref.wav")
    (out / "ref.txt").write_text(ref["text"], encoding="utf-8")

    tot = sum(c["duration"] for c in clips)
    print("\n" + "─" * 50 + "\n数据集统计\n" + "─" * 50)
    print("  片段数 : %d (训练 %d / 验证 %d)" % (len(clips), len(train), len(val)))
    print("  总时长 : %.1f 分钟" % (tot / 60))
    print("  平均   : %.1f 秒/条" % (tot / len(clips)))
    print("  丢弃   : %s" % dropped)
    print("  参考音频: %s (%.1fs) 「%s」" % (Path(ref["audio_path"]).name, ref["duration"], ref["text"][:40]))
    if tot < 600:
        print("  ⚠ 总时长不足 10 分钟,声纹相似度提升会受限(建议 ≥ 10 分钟、越多越好)")

    if args.skip_codes:
        return
    print("\n提取 audio_codes(%s)…" % args.tokenizer, flush=True)
    from qwen_tts import Qwen3TTSTokenizer
    tok = Qwen3TTSTokenizer.from_pretrained(args.tokenizer, device_map=args.device)
    for name, rows in (("train_codes.jsonl", train), ("val_codes.jsonl", val)):
        with open(out / name, "w", encoding="utf-8") as fh:
            for i in range(0, len(rows), 16):
                b = rows[i:i + 16]
                enc = tok.encode([r["audio_path"] for r in b])
                for r, code in zip(b, enc.audio_codes):
                    fh.write(json.dumps({"audio": r["audio_path"], "text": r["text"], "ref_audio": str(out / "ref.wav"), "language": "Auto",
                                         "audio_codes": code.cpu().tolist()}, ensure_ascii=False) + "\n")
                print("  codes %d/%d" % (min(i + 16, len(rows)), len(rows)), flush=True)
    (out / "data_ready.json").write_text(json.dumps({"clips": len(clips), "minutes": round(tot / 60, 1), "time": time.strftime("%F %T")}), encoding="utf-8")
    print("✅ 数据准备完成 → %s" % out)


if __name__ == "__main__":
    main()
'''

FILES['tts_dataset.py'] = r'''# coding=utf-8
# 取自 QwenLM/Qwen3-TTS/finetuning/dataset.py (Apache-2.0),仅增加了参考 mel 缓存。
# Copyright 2026 The Alibaba Qwen team.
