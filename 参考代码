        @app.websocket("/ws/browser")
        async def ws_browser(ws: WebSocket):
            await ws.accept()
            sid = ws.scope.get("vc_sid") or "open"
            try:
                s = P.mgr.get(sid)
            except ba.ActionError as e:
                await ws.send_text(json.dumps({"type": "error", "message": str(e)}))
                await ws.close()
                return
            sub = s.subscribe()

            async def writer():
                while True:
                    await sub.evt.wait()
                    sub.evt.clear()
                    while sub.q:
                        await ws.send_text(json.dumps(sub.q.popleft(), ensure_ascii=False))
                    if sub.frame is not None:
                        f, sub.frame = sub.frame, None
                        await ws.send_bytes(f)

            wt = asyncio.ensure_future(writer())
            try:
                if not P.mgr.status()["available"]:
                    sub.push({"type": "error", "message": "浏览器不可用:" + str(P.mgr.status()["reason"])})
                while True:
                    m = json.loads(await ws.receive_text())
                    if m.get("type") == "human":
                        try:
                            await s.human(m)
                        except ba.ActionError as e:
                            sub.push({"type": "error", "message": str(e)})
                        except Exception as e:  # noqa: BLE001
                            sub.push({"type": "error", "message": "%s: %s" % (type(e).__name__, str(e)[:100])})
                    elif m.get("type") == "open":                                 # 打开空白页以便接管/查看
                        try:
                            await s.ensure()
                        except ba.ActionError as e:
                            sub.push({"type": "error", "message": str(e)})
            except (WebSocketDisconnect, Exception):
                pass
            finally:
                wt.cancel()
                s.unsubscribe(sub)

