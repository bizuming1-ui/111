def _overlap(a, b):
    sa, sb = set(re.sub(r"\s+", "", a)), set(re.sub(r"\s+", "", b))
    if not sa or not sb:
        return 0.0
    return len(sa & sb) / float(min(len(sa), len(sb)))


class IntentService:
    def __init__(self, gateway, settings, now_fn=None):
        self.gw, self.settings, self.now_fn = gateway, settings, now_fn

    async def understand(self, text, ui_engine="bing", voice=False, city="", has_results=False):
        t0 = time.time()
        raw = str(text or "").strip()[:500]
        d = self.settings.public()
        tz = d.get("timezone") or "Asia/Shanghai"
        now = now_in(tz, self.now_fn)
        rule = rule_intent(raw, self.settings, self.now_fn, city_override=city)
        llm_meta = {"status": "skipped", "zh": ""}
        out = dict(rule, planner="rules")
        # 紧急控制词(暂停/继续/取消)由确定性代码快速处理,但仍走后续风险策略
        if self.gw is None or not self.gw.available:
            st = self.gw.status() if self.gw else {"text": "unconfigured", "text_zh": "LLM 不可用"}
            llm_meta = {"status": "unavailable", "zh": st.get("text_zh") or "LLM 不可用,当前使用规则回退", "model": getattr(self.gw, "model", None)}
        else:
            user = "今天=%s(%s) 时区=%s 已保存城市=%s 浏览器已有搜索结果=%s\n用户说:%s" % (now.strftime("%Y-%m-%d"), "一二三四五六日"[now.weekday()], tz, d.get("city") or "无" if not city else city, "是" if has_results else "否", raw)
            try:
                obj, meta = await self.gw.parse_intent(LLM_SYS, user)
                out = self._merge(rule, obj, raw, city)
                out["planner"] = "llm"
                llm_meta = {"status": "ok", "zh": "大模型已理解", "model": meta.get("model"), "ms": meta.get("ms"), "request_id": meta.get("request_id")}
            except LLMError as e:
                llm_meta = {"status": e.kind, "zh": "LLM 不可用(%s),本次使用规则回退" % KIND_ZH.get(e.kind, e.kind), "model": self.gw.model}
            except Exception as e:  # noqa: BLE001
                llm_meta = {"status": "error", "zh": "LLM 异常(%s),本次使用规则回退" % type(e).__name__}
        ms = (time.time() - t0) * 1000
        METRICS.add("intent_parse", ms)
        out["llm"] = llm_meta
        out["intent_ms"] = int(ms)
        out["engines"] = [e for e in (out.get("engines") or []) if e in ("google", "bing", "edge_default", "duckduckgo", "so360")]
        out["ui_engine"] = ui_engine
        return out

    def _merge(self, rule, obj, raw, city):
        """LLM 输出只是『建议』:经确定性策略校验后才采纳。"""
        out = dict(rule)
        it = str(obj.get("intent") or "").strip()
        if it not in INTENTS:
            raise LLMError("bad_schema", "intent=%r" % it)
        d = self.settings.public()
        out["intent"] = it
        out["confidence"] = max(0.0, min(1.0, float(obj.get("confidence") if isinstance(obj.get("confidence"), (int, float)) else 0.6)))
        interp = clean_query(obj.get("interpretation") or obj.get("short_user_facing_interpretation") or "", 100)
        if interp:
            out["short_user_facing_interpretation"] = interp
        # 引擎:只采纳用户在原话里明确说出的(确定性检测),LLM 不能替用户选引擎
        # 天气:确定性策略权威(城市来源 + 运行时日期);LLM 只负责分类
        if is_weather(raw) and it in ("search", "clarify"):
            return rule if rule["intent"] in ("search", "clarify") else out
        if it == "search":
            q = strip_shell(clean_query(obj.get("normalized_query") or ""))
            _, core_rule = detect_engines(raw)
            core_rule = strip_shell(core_rule)
            if not q:
                out.update(intent="clarify", needs_clarification=True, clarification_question=clean_query(obj.get("clarification_question") or "要搜索什么内容?", 80), normalized_query="")
            else:
                if core_rule and _overlap(q, core_rule) < 0.35:                  # 改写偏离原话:不采纳,改用规则抽取(防止模型凭空改题)
                    q = core_rule
                    out["short_user_facing_interpretation"] = "搜索「%s」" % q[:50]
                loc = clean_query(obj.get("location") or "", 40)
                if loc and loc in raw:
                    out["location"], out["location_source"] = loc, "user_said"
                out.update(normalized_query=q, needs_clarification=False, clarification_question="")
        elif it == "clarify" or obj.get("needs_clarification"):
            out.update(intent="clarify", needs_clarification=True, normalized_query="", clarification_question=clean_query(obj.get("clarification_question") or "能再具体说一下吗?", 80))
        else:
            out.update(normalized_query="", needs_clarification=False)
        # 规则看到明确的当前页面问题 / 浏览器命令时,以规则分流为准,避免被误当搜索词(如『打开第一个结果』)
        if rule["intent"] in ("page_question", "browser_command") and it in ("search", "conversation"):
            out["intent"], out["normalized_query"] = rule["intent"], ""
            out["short_user_facing_interpretation"] = rule["short_user_facing_interpretation"]
        if it == "conversation" and rule["intent"] == "search" and not _GREET_RE.match(raw) and len(strip_shell(raw)) > 1 and obj.get("confidence", 0) < 0.6:
            out["intent"] = "search"
            out["normalized_query"] = rule["normalized_query"]
        out["vision_suggested"] = bool(rule.get("vision_suggested")) or (out["intent"] == "page_question" and bool(_VISUAL_HINT.search(raw)))
        return out


