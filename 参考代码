        self.first = None
        self.last = 0
        self.win = max(1, int(sr * 0.02))
        self.carry = np.zeros(0, np.float64)
        self.win_n = self.silent_w = self.run = self.max_run = 0
        self.thr_lin = 32768.0 * (10 ** (th["silence_db"] / 20.0))

    def feed(self, pcm):
        x = np.frombuffer(pcm, dtype="<i2")
        if x.size == 0:
            return
        if self.first is None:
            self.first = int(x[0])
        self.last = int(x[-1])
        xf = x.astype(np.float64)
        self.n += x.size
        self.sum += float(xf.sum())
        self.sumsq += float(np.dot(xf, xf))
        self.peak = max(self.peak, int(np.abs(xf).max()))
        self.clip += int((np.abs(xf) >= self.th["clip_level"]).sum())
        buf = np.concatenate([self.carry, xf]) if self.carry.size else xf
        k = buf.size // self.win
        if k:
            blk = buf[:k * self.win].reshape(k, self.win)
            rms = np.sqrt((blk * blk).mean(axis=1))
            for v in rms:
                self.win_n += 1
                if v < self.thr_lin:
                    self.silent_w += 1
                    self.run += 1
                    self.max_run = max(self.max_run, self.run)
                else:
                    self.run = 0
        self.carry = buf[k * self.win:]

    def report(self, frames_expected=None):
        th, warns, errs = self.th, [], []
        dur = self.n / self.sr
        m = {"samples": self.n, "duration_s": round(dur, 3), "peak_dbfs": None, "rms_dbfs": None, "clip_frac": 0.0, "dc_offset": 0.0, "silence_frac": 0.0, "max_silence_s": 0.0}
        if self.n == 0 or dur < th["min_audio_s"]:
            errs.append("空音频或过短(%.3fs)" % dur)
        else:
            m["peak_dbfs"] = round(float(20 * np.log10(max(self.peak, 1) / 32768.0)), 2)
            m["rms_dbfs"] = round(float(20 * np.log10(max(np.sqrt(self.sumsq / self.n), 1e-9) / 32768.0)), 2)
            m["clip_frac"] = round(self.clip / self.n, 6)
            m["dc_offset"] = round(abs(self.sum / self.n) / 32768.0, 5)
            m["silence_frac"] = round(self.silent_w / max(self.win_n, 1), 3)
            m["max_silence_s"] = round(self.max_run * self.win / self.sr, 2)
            if self.peak == 0:
                errs.append("整段为数字静音")
            if m["clip_frac"] > th["clip_frac_fail"]:
                errs.append("严重削波:%.2f%% 的样本接近满幅" % (m["clip_frac"] * 100))
            elif m["clip_frac"] > th["clip_frac_warn"]:
                warns.append("削波:%.3f%% 的样本接近满幅" % (m["clip_frac"] * 100))
            if m["dc_offset"] > th["dc_warn"]:
                warns.append("DC 偏置 %.1f%% 满幅" % (m["dc_offset"] * 100))
            if m["max_silence_s"] > th["max_silence_s"] and self.peak > 0:
                warns.append("段内出现 %.1fs 连续静音" % m["max_silence_s"])
            if m["silence_frac"] > th["silence_frac_warn"] and self.peak > 0:
                warns.append("静音占比 %.0f%% 异常偏高" % (m["silence_frac"] * 100))
        if frames_expected is not None and frames_expected != self.n:
            errs.append("样本数不符:统计 %d≠期望 %d" % (self.n, frames_expected))
        return {"status": "failed" if errs else ("warning" if warns else "pass"), "warnings": warns, "errors": errs, "metrics": m, "thresholds": th}


class _Wav:
    """写入端(只在写盘线程里使用)。"""

    def __init__(self, final, sr):
        self.final, self.part, self.sr = Path(final), Path(str(final) + ".part"), sr
        self.f = open(self.part, "wb")
        self.f.write(wav_header(sr, 0))
        self.bytes = 0
        self.sha = hashlib.sha256()

    def write(self, b):
        self.f.write(b)
        self.bytes += len(b)
        self.sha.update(b)

    def close_verify(self):
        """flush → 补写头 → fsync → 独立读回校验 → 原子改名。返回 (ok, info)。"""
        if self.bytes > 0xFFFFFFFF - 36:
            self.f.close()
            return False, {"problems": ["超过 WAV 4GB 上限"]}
        self.f.flush()
        self.f.seek(0)
        self.f.write(wav_header(self.sr, self.bytes))
        self.f.flush()
        os.fsync(self.f.fileno())
        self.f.close()
        ok, info = verify_wav(self.part, self.sr, self.bytes // 2, self.sha.hexdigest())
        if ok:
            os.replace(self.part, self.final)
            info["sha256"] = sha256_file(self.final)
        return ok, info

    def abandon(self):
        try:
            self.f.close()
        except Exception:  # noqa: BLE001
            pass


class TurnRec:
    def __init__(self, store, aid, uid, lib_id, meta):
        self.store, self.aid, self.uid, self.lib_id, self.meta = store, aid, uid, lib_id, dict(meta or {})
        self.status, self.reason = "generating", ""
        self.created = now_iso()
        self.dir = store.root / safe_lib(lib_id) / aid
        self.samples_in = 0                      # 主线程累计(用于进度显示)
        self.dead = False
        self.sids = {}                           # seg idx -> sid
        # —— 以下只在写盘线程里读写 ——
        self.turn_w = None
        self.turn_qc = QCAcc(store.sr, store.th)
        self.cur_seg = None
        self.seg_w = None
        self.seg_qc = None
        self.seg_info = OrderedDict()            # idx -> dict
        self.pause_samples = 0
        self.prev_edge = None                    # 上一段末样本
        self.boundary = []
        self.manifest = None

    def sid(self, idx):
        return self.sids.setdefault(idx, "s_" + secrets.token_hex(5))

    def fail(self, reason):
        if not self.dead:
            self.dead, self.reason, self.status = True, reason, "failed"

    # —— 主线程 API(都不做磁盘 I/O) ——
    def add(self, seg_idx, pause_pcm, audio_pcm):
        if self.dead:
            return False
        self.sid(seg_idx)
        if self.store.free_low():
            self.fail("磁盘空间不足(剩余 < %d MB),已停止归档;未静默删除任何文件" % self.store.min_free_mb)
            self.store.notify(self)
            return False
        try:
            self.store.q.put_nowait(("add", self, seg_idx, pause_pcm, audio_pcm))
        except queue.Full:
            self.fail("写盘队列已满(%d 项):磁盘写入跟不上,本轮归档标记为失败,没有静默丢块" % self.store.q.maxsize)
            self.store.notify(self)
            return False
        self.samples_in += (len(pause_pcm) + len(audio_pcm)) // 2
        return True

    def seg_end(self, seg_idx, err="", text_len=0):
        if not self.dead:
            self._put(("seg_end", self, seg_idx, err, text_len))

    def finish(self, meta=None):
        self._put(("finish", self, dict(meta or {})))

    def _put(self, item):
        try:
            self.store.q.put(item, timeout=5)
        except queue.Full:
            self.fail("写盘队列已满,无法完成归档")
            self.store.notify(self)

    def summary(self):
        m = self.manifest or {}
        tf = m.get("turn_file") or {}
        segs = m.get("segments") or []
        return {"artifact_id": self.aid, "turn_uid": self.uid, "created_at": self.created, "status": self.status, "reason": self.reason, "library_id": self.lib_id,
                "duration_s": tf.get("duration_s", round(self.samples_in / self.store.sr, 2)), "bytes": tf.get("bytes"), "sha256": tf.get("sha256"),
                "quality": (tf.get("quality") or {}).get("status"), "warnings": m.get("warnings", []), "segments": [_seg_public(s) for s in segs],
                "synthetic": True, "downloadable": self.status in ("ready", "quality_warning")}


def _seg_public(s):
    return {k: s.get(k) for k in ("id", "index", "status", "duration_s", "bytes", "sha256", "frames", "quality_status", "warnings", "reason")}


class ArtifactStore:
    def __init__(self, root, sr=24000, queue_max=None, min_free_mb=None, max_total_mb=None, thresholds=None, on_event=None, store_text=None, model=None):
        self.root = Path(root)
        self.root.mkdir(parents=True, exist_ok=True)
        self.sr = int(sr)
        self.min_free_mb = int(min_free_mb if min_free_mb is not None else os.environ.get("VC_ARTIFACT_MIN_FREE_MB", "1024"))
        self.max_total_mb = int(max_total_mb if max_total_mb is not None else os.environ.get("VC_ARTIFACT_MAX_MB", "8192"))
        th = dict(DEFAULT_THRESH)
        try:
            th.update(json.loads(os.environ.get("VC_ARTIFACT_THRESH") or "{}"))
        except ValueError:
            pass
        th.update(thresholds or {})
        self.th = th
        self.q = queue.Queue(maxsize=int(queue_max or os.environ.get("VC_ARTIFACT_QUEUE", "4096")))
        self.on_event = on_event
        self.store_text = bool(int(os.environ.get("VC_ARTIFACT_STORE_TEXT", "0"))) if store_text is None else store_text
        self.model = model or {}
        self.lock = threading.RLock()
        self.turns = {}                      # aid -> TurnRec(本进程)
        self.disk_manifests = {}             # aid -> manifest(已落盘)
        self.stats = {"written_bytes": 0, "queue_high": 0, "failed": 0, "recovered_part": 0}
        self._free_cache = (0.0, False)
        self.write_delay = float(os.environ.get("VC_ARTIFACT_TEST_DELAY", "0") or 0)      # 仅测试:模拟慢盘
        try:
            (self.root / ".gitignore").write_text("# 私人合成音频与清单:永远不要提交到 Git\n*\n", encoding="utf-8")
        except OSError:
            pass
        self.scan()
        self.th_worker = threading.Thread(target=self._run, name="artifact-writer", daemon=True)
        self.th_worker.start()

    # —— 启动恢复 ——
    def scan(self):
        for mp in self.root.glob("*/t_*/manifest.json"):
            try:
                m = json.loads(mp.read_text(encoding="utf-8"))
                if not AID_RE.match(m.get("artifact_id", "")):
                    continue
                d = mp.parent
                if m.get("status") in ("ready", "quality_warning"):
                    for fe in [m["turn_file"]] + list(m.get("segments") or []):
                        if not fe.get("file"):
                            continue
                        p = d / fe["file"]
                        if fe.get("status") == "failed":
                            continue
                        if not p.is_file() or p.stat().st_size != fe["bytes"]:
                            m["status"], m["reason"] = "expired", "文件缺失或大小与清单不符:%s" % fe["file"]
                            break
                self.disk_manifests[m["artifact_id"]] = m
            except Exception:  # noqa: BLE001
                continue
        for d in self.root.glob("*/t_*"):
            if d.is_dir() and not (d / "manifest.json").exists() and AID_RE.match(d.name) and any(d.glob("*.part")):
                m = {"schema": 1, "artifact_id": d.name, "turn_uid": None, "created_at": now_iso(), "library_id": d.parent.name if d.parent.name != "_none" else None, "status": "failed",
                     "reason": "进程中断:只有 .part 临时文件,不完整,未标记为可下载", "synthetic": True, "turn_file": {"file": "turn.wav", "bytes": 0}, "segments": [], "warnings": []}
                try:
                    atomic_write_json(d / "manifest.json", m)
                except OSError:
                    pass
                self.disk_manifests[d.name] = m
                self.stats["recovered_part"] += 1

    # —— 磁盘 ——
    def total_bytes(self):
        n = 0
        for p in self.root.rglob("*"):
            try:
                if p.is_file():
                    n += p.stat().st_size
            except OSError:
                pass
        return n

    def disk(self):
        try:
            free = shutil.disk_usage(self.root).free
        except OSError:
            free = 0
        used = self.total_bytes()
        return {"free_mb": int(free / 1e6), "used_mb": round(used / 1e6, 1), "cap_mb": self.max_total_mb, "min_free_mb": self.min_free_mb,
                "queue": self.q.qsize(), "queue_max": self.q.maxsize, "recovered_part": self.stats["recovered_part"], "failed": self.stats["failed"],
                "lifecycle": "Kaggle 的 /kaggle/working 只在当前会话与保存版本内有效,不保证跨会话永久保存,请及时下载 ZIP。"}

    def free_low(self):
        t, v = self._free_cache
        if time.time() - t > 2.0:
            try:
                free_mb = shutil.disk_usage(self.root).free / 1e6
            except OSError:
                free_mb = 0
            v = free_mb < self.min_free_mb
            self._free_cache = (time.time(), v)
        return v

    def notify(self, rec):
        if self.on_event:
            try:
                self.on_event(rec)
            except Exception:  # noqa: BLE001
                pass

    # —— 入口 ——
    def begin(self, uid, lib_id, meta=None):
        aid = "t_" + secrets.token_hex(8)
        rec = TurnRec(self, aid, uid, lib_id, dict(meta or {}))
        with self.lock:
            self.turns[aid] = rec
        if self.free_low():
            rec.fail("磁盘空间不足(剩余 < %d MB),没有开始归档;请先下载并清理旧产物" % self.min_free_mb)
        elif self.total_bytes() >= self.max_total_mb * 1e6:
            rec.fail("产物总量已达上限 %d MB,没有开始归档;请先下载并清理旧产物(不会自动删除)" % self.max_total_mb)
        else:
            try:
                rec.dir.mkdir(parents=True, exist_ok=True)
            except OSError as e:
                rec.fail("无法创建产物目录: %s" % e)
        self.notify(rec)
        return rec

    def quiesce(self, timeout=30):
        t0 = time.time()
        while time.time() - t0 < timeout:
            if self.q.unfinished_tasks == 0:
                return True
            time.sleep(0.02)
        return False

    # —— 写盘线程 ——
    def _run(self):
        while True:
            item = self.q.get()
            try:
                if self.write_delay:
                    time.sleep(self.write_delay)
                self.stats["queue_high"] = max(self.stats["queue_high"], self.q.qsize())
                k = item[0]
                if k == "add":
                    self._add(*item[1:])
                elif k == "seg_end":
                    self._seg_end(*item[1:])
                elif k == "finish":
                    self._finish(*item[1:])
                elif k == "stop":
                    return
            except Exception as e:  # noqa: BLE001
                rec = item[1] if len(item) > 1 and isinstance(item[1], TurnRec) else None
                if rec is not None:
                    rec.fail("写盘异常:%s: %s" % (type(e).__name__, str(e)[:120]))
                    self._cleanup_open(rec)
                    self.notify(rec)
            finally:
                self.q.task_done()

    def _cleanup_open(self, rec):
        for w in (rec.turn_w, rec.seg_w):
            if w is not None:
                w.abandon()
        rec.turn_w = rec.seg_w = None

    def _open_seg(self, rec, idx):
        sid = rec.sid(idx)
        rec.cur_seg = idx
        rec.seg_w = _Wav(rec.dir / ("seg_%03d_%s.wav" % (idx + 1, sid)), self.sr)
        rec.seg_qc = QCAcc(self.sr, self.th)

    def _close_seg(self, rec, err="", text_len=0):
        idx = rec.cur_seg
        if idx is None:
            return
        w, qc = rec.seg_w, rec.seg_qc
        rec.cur_seg, rec.seg_w, rec.seg_qc = None, None, None
        info = {"id": rec.sid(idx), "index": idx, "file": w.final.name, "format": "WAV", "encoding": "PCM", "sample_rate": self.sr, "channels": 1, "bits_per_sample": 16, "sample_type": "int16"}
        ok, v = w.close_verify()
        q = qc.report(frames_expected=w.bytes // 2)
        status = "ready"
        reasons = list(q["errors"]) + ([] if ok else v.get("problems", []))
        if err:
            reasons.insert(0, "合成失败:" + err)
        if not ok or q["errors"] or err:
            status = "failed"
        elif q["warnings"]:
            status = "quality_warning"
        info.update(status=status, frames=w.bytes // 2, duration_s=round(w.bytes / 2 / self.sr, 3), bytes=v.get("bytes", w.bytes + 44), sha256=v.get("sha256"), pcm_sha256=v.get("pcm_sha256"),
                    quality=q, quality_status=q["status"], warnings=q["warnings"], reason="; ".join(reasons), verified=bool(ok))
        if text_len:
            info["text_chars"] = text_len
        rec.seg_info[idx] = info

    def _add(self, rec, seg_idx, pause_pcm, audio_pcm):
        if rec.dead:
            return
        if rec.turn_w is None:
            rec.turn_w = _Wav(rec.dir / "turn.wav", self.sr)
        if pause_pcm:
            rec.turn_w.write(pause_pcm)
            rec.pause_samples += len(pause_pcm) // 2
        if audio_pcm:
            if rec.cur_seg is not None and rec.cur_seg != seg_idx:
                self._close_seg(rec)
            if rec.cur_seg is None:
                self._open_seg(rec, seg_idx)
                x0 = int(np.frombuffer(audio_pcm[:2], "<i2")[0])
                if rec.prev_edge is not None:
                    step = max(abs(rec.prev_edge), abs(x0)) / 32768.0
                    if step > self.th["boundary_step_warn"]:
                        rec.boundary.append({"between": [seg_idx - 1, seg_idx], "step": round(step, 3)})
            rec.turn_w.write(audio_pcm)
            rec.seg_w.write(audio_pcm)
            rec.turn_qc.feed(audio_pcm)
            rec.seg_qc.feed(audio_pcm)
            rec.prev_edge = int(np.frombuffer(audio_pcm[-2:], "<i2")[0])
        self.stats["written_bytes"] += len(pause_pcm) + len(audio_pcm)

    def _seg_end(self, rec, seg_idx, err, text_len):
        if rec.dead:
            return
        if rec.cur_seg == seg_idx:
            self._close_seg(rec, err, text_len)
        elif seg_idx not in rec.seg_info:
            rec.seg_info[seg_idx] = {"id": rec.sid(seg_idx), "index": seg_idx, "file": None, "bytes": 0, "frames": 0, "duration_s": 0.0, "status": "failed", "quality_status": "failed",
                                     "warnings": [], "sha256": None, "reason": ("合成失败:" + err) if err else "该段没有产生音频", "verified": False}

    def _finish(self, rec, meta):
        if rec.dead:
            self._cleanup_open(rec)
            self._write_manifest(rec, meta)
            return
        rec.status = "finalizing"
        self.notify(rec)
        self._close_seg(rec)
        warnings, errors = [], []
        tw = rec.turn_w
        if tw is None:                                           # 没有任何音频
            errors.append("本轮没有产生任何音频")
            tf = {"file": "turn.wav", "frames": 0, "duration_s": 0.0, "bytes": 0, "sha256": None, "verified": False, "quality": rec.turn_qc.report(0)}
        else:
            frames = tw.bytes // 2
            ok, v = tw.close_verify()
            rec.turn_w = None
            q = rec.turn_qc.report(frames_expected=frames - rec.pause_samples)
            tf = {"file": "turn.wav", "format": "WAV", "encoding": "PCM", "sample_rate": self.sr, "channels": 1, "bits_per_sample": 16, "sample_type": "int16", "frames": frames,
                  "duration_s": round(frames / self.sr, 3), "bytes": v.get("bytes", 0), "sha256": v.get("sha256"), "pcm_sha256": v.get("pcm_sha256"), "verified": bool(ok), "quality": q,
                  "pause_samples": rec.pause_samples, "pause_s": round(rec.pause_samples / self.sr, 3)}
            if not ok:
                errors += v.get("problems", ["读回校验失败"])
            errors += q["errors"]
            warnings += q["warnings"]
            fr = meta.get("frames")                              # 与 turn.log 里【真实发出的帧】对账(独立于写盘路径)
            if fr is not None:
                try:
                    n, sha, probs = frames_digest(fr)
                    match = (n == frames and sha == v.get("pcm_sha256"))
                    tf["matches_emitted_frames"] = bool(match and not probs)
                    tf["emitted_frames"] = len(fr)
                    if not match:
                        errors.append("整轮文件与实际发出的帧不一致(样本数 %d≠%d 或 SHA 不同)" % (frames, n))
                    errors += probs
                except Exception as e:  # noqa: BLE001
                    tf["matches_emitted_frames"] = None
                    warnings.append("无法与发出的帧对账: %s" % str(e)[:80])
        segs = [rec.seg_info[i] for i in sorted(rec.seg_info)]
        seg_sum = sum(s.get("frames", 0) for s in segs)
        consistent = (tf.get("frames", 0) == seg_sum + rec.pause_samples)
        if not consistent and tf.get("frames"):
            errors.append("整轮样本数 %d ≠ 各段 %d + 停顿 %d" % (tf.get("frames", 0), seg_sum, rec.pause_samples))
        for s in segs:
            if s.get("status") == "failed":
                warnings.append("第%d段:%s" % (s["index"] + 1, s.get("reason") or "失败"))
            elif s.get("warnings"):
                warnings += ["第%d段:%s" % (s["index"] + 1, w_) for w_ in s["warnings"]]
        for b in rec.boundary:
            warnings.append("段交界 %d→%d 幅度突变 %.0f%% 满幅(可能有“咔哒”声)" % (b["between"][0] + 1, b["between"][1] + 1, b["step"] * 100))
        for w_ in meta.get("integrity") or []:
            warnings.append("生成期检测:%s" % w_)
        for e_ in meta.get("errors") or []:
            warnings.append("生成错误:%s" % e_)
        if meta.get("cancelled"):
            warnings.append("用户中途停止:文件只包含已经发出的音频(不完整的一轮)")
        if errors:
            rec.fail("; ".join(errors)[:600])
            self.stats["failed"] += 1
        else:
            rec.status = "quality_warning" if (warnings or tf.get("quality", {}).get("status") == "warning") else "ready"
        self._write_manifest(rec, meta, tf, segs, warnings)

    def _write_manifest(self, rec, meta, tf=None, segs=None, warnings=None):
        lib = meta.get("library") or {}
        m = {"schema": 1, "artifact_id": rec.aid, "turn_uid": rec.uid, "created_at": rec.created, "finished_at": now_iso(), "library_id": rec.lib_id, "dataset_version": lib.get("dataset_version"),
             "synthetic": True, "notice": NOTICE, "status": rec.status, "reason": rec.reason, "precision_note": PRECISION_NOTE,
             "model": {"id": self.model.get("id"), "sha256": meta.get("model_sha256") or self.model.get("sha256"), "trained": self.model.get("trained")},
