def truncate_history_text(seg_texts, seg_samples, played_samples):
    """打断后对话历史只保留「实际已播放」的文本:整句按已播样本数累计,半句按样本比例取字符前缀(回退到最近标点,没有标点就取比例前缀)。
    seg_texts: 每句文本;seg_samples: 每句实际发出的样本数(含句间停顿);返回 (保留文本, 是否被截断)。"""
    out, acc = [], 0
    for tx, n in zip(seg_texts, seg_samples):
        if n <= 0:
            break
        if acc + n <= played_samples:
            out.append(tx)
            acc += n
            continue
        frac = max(0.0, (played_samples - acc) / float(n))
        k = int(len(tx) * frac)
        if k >= 2:
            cut = max((tx.rfind(c, 0, k + 1) for c in "，,、；;：:。！？!?"), default=-1)
            out.append(tx[: (cut + 1) if cut >= max(1, k // 2) else k])
        return "".join(out), True
    return "".join(out), len(out) != len(seg_texts)


class TurnManager:
    """TurnManager 状态机(服务端权威;浏览器端镜像同一组状态名)。
    IDLE → LISTENING → USER_SPEAKING → ENDPOINTING → THINKING → SPEAKING;SPEAKING/THINKING 中主人开口 → BARGED_IN → USER_SPEAKING。
    文字与语音共用 submit_user_turn(source):source=text 不经声纹门(声纹锁永不拦截文字)。"""
    STATES = ("IDLE", "LISTENING", "USER_SPEAKING", "ENDPOINTING", "THINKING", "SPEAKING", "BARGED_IN")

    def __init__(self, lock=None):
        self.state = "IDLE"
        self.epoch = 0
        self.turn_id = 0
        self.lock = lock
        self.counts = {"accepted": 0, "ignored_other": 0, "ignored_echo": 0, "ignored_short": 0, "text": 0, "barge_in": 0, "barge_rejected": 0}
        self.log = deque(maxlen=200)

    def _go(self, s, why=""):
        if s != self.state:
            self.log.append((time.time(), self.state, s, why))
            self.state = s

    def start(self):
        self._go("LISTENING", "start")

    def stop(self):
        self.epoch += 1
        self._go("IDLE", "stop")

    def on_user_speech_start(self):
        if self.state in ("THINKING", "SPEAKING"):
            self._go("BARGED_IN", "owner_speech")
            self.counts["barge_in"] += 1
            self.epoch += 1
        self._go("USER_SPEAKING", "vad")

    def on_endpoint(self):
        if self.state == "USER_SPEAKING":
            self._go("ENDPOINTING", "silence")

    def on_barge_rejected(self):
        self.counts["barge_rejected"] += 1
        self._go("SPEAKING", "barge_rejected")

    def submit_user_turn(self, source, text="", verdict=None):
        """返回 (accepted, reason)。voice:必须 verdict.ok(声纹 + 非回声);text:无条件接受。"""
        if source == "text":
            self.counts["text"] += 1
            self.turn_id += 1
            self.epoch += 1
            self._go("THINKING", "text")
            return True, "text"
        v = verdict or {}
        if v.get("echo"):
            self.counts["ignored_echo"] += 1
            self._go("LISTENING", "echo")
            return False, "echo"
        if v.get("too_short"):
            self.counts["ignored_short"] += 1
            self._go("LISTENING", "short")
            return False, "too_short"
        if self.lock is not None and self.lock.active() and not v.get("ok"):
            self.counts["ignored_other"] += 1
            self._go("LISTENING", "not_owner")
            return False, "not_owner"
        self.counts["accepted"] += 1
        self.turn_id += 1
        self.epoch += 1
        self._go("THINKING", "voice")
        return True, "voice"

    def on_speaking(self):
        if self.state == "THINKING":
            self._go("SPEAKING", "first_audio")

    def on_turn_done(self):
        if self.state in ("THINKING", "SPEAKING", "BARGED_IN"):
            self._go("LISTENING", "done")


# ═══════════════════════════ 音频基础:VAD / 重采样 / 谱嵌入(回退) ═══════════════════════════
def frame_db16(x, frame=320):
    x = np.asarray(x, np.float32)
    n = len(x) // frame
    if n == 0:
        return np.zeros(0, np.float32)
    f = x[: n * frame].reshape(n, frame)
    return (20 * np.log10(np.maximum(np.sqrt((f ** 2).mean(1)), 1e-6))).astype(np.float32)


def energy_vad(x16k, min_speech_s=0.25, hang_s=0.3):
    """自适应噪声底的能量 VAD(20ms 帧)。返回语音区间 [(a_s, b_s)]。这是回退方案;浏览器端另有本地 VAD。"""
    d = frame_db16(x16k)
    if d.size == 0:
        return []
    floor = float(np.percentile(d, 15))
    thr = max(floor + 9.0, -52.0)
    sp = d > thr
    segs, i, n = [], 0, len(sp)
    hang = int(hang_s / 0.02)
    while i < n:
        if sp[i]:
            j, last = i, i
            while j < n and (sp[j] or j - last <= hang):
                if sp[j]:
                    last = j
                j += 1
            if (last - i + 1) * 0.02 >= min_speech_s:
                segs.append((i * 0.02, (last + 1) * 0.02))
            i = last + 1
        else:
            i += 1
    return segs


def to16k(x, sr):
    x = np.asarray(x, np.float32).reshape(-1)
    if int(sr) == SR16 or x.size == 0:
        return x
    try:
        from math import gcd
        from scipy.signal import resample_poly
        g = gcd(int(sr), SR16)
        return resample_poly(x, SR16 // g, int(sr) // g).astype(np.float32)
    except Exception:  # noqa: BLE001
        n = int(len(x) * SR16 / sr)
        return np.interp(np.linspace(0, len(x) - 1, n), np.arange(len(x)), x).astype(np.float32)


def _melbank(n_fft=512, n_mel=32, sr=SR16, fmin=80.0, fmax=5000.0):
    mel = lambda f: 2595 * np.log10(1 + f / 700.0)  # noqa: E731
    imel = lambda m: 700 * (10 ** (m / 2595.0) - 1)  # noqa: E731
    pts = imel(np.linspace(mel(fmin), mel(fmax), n_mel + 2))
    bins = np.floor((n_fft + 1) * pts / sr).astype(int)
    fb = np.zeros((n_mel, n_fft // 2 + 1), np.float32)
    for m in range(1, n_mel + 1):
        a, b, c = bins[m - 1], bins[m], bins[m + 1]
        for k in range(a, b):
            fb[m - 1, k] = (k - a) / max(b - a, 1)
        for k in range(b, c):
            fb[m - 1, k] = (c - k) / max(c - b, 1)
    return fb


_FB = None


def spectral_embed(x16k):
    """回退嵌入(没有声纹模型时):有声帧的平均对数梅尔谱形状 + 中位基频。【弱】:只用于沙箱测试 / 降级,界面必须标注。"""
    global _FB
    x = np.asarray(x16k, np.float32)
    if x.size < 4000:
        raise ValueError("音频太短")
    if _FB is None:
        _FB = _melbank()
    n_fft, hop = 512, 160
    win = np.hanning(n_fft).astype(np.float32)
    n = 1 + (len(x) - n_fft) // hop
    idx = np.arange(n)[:, None] * hop + np.arange(n_fft)[None, :]
    fr = x[idx] * win
    sp = np.abs(np.fft.rfft(fr, axis=1)) ** 2
    en = 10 * np.log10(np.maximum(sp.sum(1), 1e-9))
    keep = en > (np.percentile(en, 30) + 3.0)
    if keep.sum() < 8:
        keep = en >= np.median(en)
    lm = np.log(np.maximum(sp[keep] @ _FB.T, 1e-8))
    shape = lm.mean(0)
    shape = shape - shape.mean()
    f0s = []
    for f in fr[keep][:: max(1, int(keep.sum()) // 40)]:
        f = f - f.mean()
        ac = np.correlate(f, f, "full")[len(f) - 1:]
        lo, hi = int(SR16 / 400), int(SR16 / 70)
        if ac[0] > 1e-6:
            k = lo + int(np.argmax(ac[lo:hi]))
            if ac[k] / ac[0] > 0.3:
                f0s.append(SR16 / k)
    f0 = float(np.median(f0s)) if f0s else 130.0
    v = np.concatenate([shape / (np.linalg.norm(shape) + 1e-9), [1.0 * (math.log(f0) - math.log(130.0))]])
    return (v / (np.linalg.norm(v) + 1e-9)).astype(np.float32)


# ═══════════════════════════ M7 声纹锁 ═══════════════════════════
def _unit(v):
    v = np.asarray(v, np.float64)
    return v / (np.linalg.norm(v) + 1e-12)


class VoiceLock:
    """声纹锁。embed_fn(wav16k float32) → 嵌入向量。登记:VAD → 2~4s 切段 → 嵌入 → 去离群 → 质心 + K 个原型 + 留一分布。
    阈值 = max(floor, min(0.98, 登记集留一分布 μ−3σ));floor 是模型相关的工作点(WavLM-SV 官方卡片建议 0.86),【未经公开 impostor 集校准】。
    模式:strict(严格)/ off(关闭,所有声音放行)/ learn(学习:放行但打分并记录)。永远保留登记原型作锚点;自适应是有界 EMA + 可回滚。"""

    MODES = ("strict", "off", "learn")

    def __init__(self, embed_fn, backend="unknown", floor=0.86, state_dir=None):
        self.embed_fn, self.backend, self.floor = embed_fn, backend, float(floor)
        self.mode = "off"
        self.centroid = None
        self.anchor = None
        self.protos = []
        self.loo = {"mean": None, "std": None, "n": 0}
        self.thr = None
        self.enrolled_at = None
        self.history = []
        self.updates = 0
        self.state_dir = state_dir or STATE_DIR
        self._lock = threading.RLock()
        self.stats = {"scores_owner": deque(maxlen=500), "scores_other": deque(maxlen=500)}

    def active(self):
        return self.mode == "strict" and self.centroid is not None

    # —— 登记 ——
    def enroll(self, wavs16k, seg_s=3.0, min_voiced_s=6.0, k_protos=3):
        """wavs16k: 若干条 16k 单声道 float32(现场 3 段 / 上传文件)。返回 dict(ok, reason, ...)。拒绝太短 / 含多人迹象 / 噪声过大并给出具体原因。"""
        segs = []
        voiced = 0.0
        for w in wavs16k:
            w = np.asarray(w, np.float32)
            for a, b in energy_vad(w):
                voiced += b - a
                a_i, b_i = int(a * SR16), int(b * SR16)
                step = int(seg_s * SR16)
                if b_i - a_i < int(1.2 * SR16):
                    continue
                for s in range(a_i, max(a_i + 1, b_i - int(1.2 * SR16) + 1), step):
                    segs.append(w[s: min(b_i, s + step)])
        if voiced < min_voiced_s:
            return {"ok": False, "reason": "有效语音只有 %.1f 秒,至少需要 %.0f 秒(请在安静环境多说几句)" % (voiced, min_voiced_s)}
        embs = []
        for s in segs:
            try:
                embs.append(_unit(self.embed_fn(s)))
            except Exception:  # noqa: BLE001
                continue
        if len(embs) < 3:
            return {"ok": False, "reason": "可用语音片段不足 3 段(%d),无法建立声纹" % len(embs)}
        E = np.stack(embs)
        c0 = _unit(np.median(E, axis=0))
        sc = E @ c0
        med = float(np.median(sc))
        mad = 1.4826 * float(np.median(np.abs(sc - med))) + 0.01
        E2 = E[sc >= med - 3.0 * mad]
        if len(E2) < 3:
            return {"ok": False, "reason": "语音片段互相差异很大(可能含多人或噪声过大),请只留下你一个人的声音"}
        cen = _unit(E2.mean(0))
        loo = np.array([float(_unit(np.delete(E2, i, 0).mean(0)) @ E2[i]) for i in range(len(E2))])
        if float(loo.min()) < 0.5 * self.floor:
            return {"ok": False, "reason": "登记片段之间一致性过低(最低 %.2f),疑似含有多人说话" % float(loo.min())}
        protos = self._kmeans(E2, min(k_protos, max(1, len(E2) // 3)))
        mu, sd = float(loo.mean()), float(loo.std())
        with self._lock:
            self.centroid, self.anchor, self.protos = cen, cen.copy(), protos
            self.loo = {"mean": round(mu, 4), "std": round(sd, 4), "n": int(len(loo))}
            # 登记片段来自同一次录音,留一分布偏乐观:σ 取下限 0.02,并减 4σ(宁可略松一点交给全句终判与回声门,也不让主人被误拒)
            self.thr = float(max(self.floor, min(0.98, mu - 4.0 * max(sd, 0.02))))
            self.enrolled_at = time.time()
            self.history.clear()
            self.updates = 0
            if self.mode == "off":
                self.mode = "strict"
        return {"ok": True, "segments": int(len(E2)), "dropped": int(len(E) - len(E2)), "voiced_s": round(voiced, 1), "threshold": round(self.thr, 3),
                "loo_mean": self.loo["mean"], "loo_std": self.loo["std"], "protos": len(protos), "backend": self.backend,
                "note": "阈值来自登记集留一分布与模型工作点;未用公开 impostor 集校准,FAR/FRR 未知"}

    @staticmethod
    def _kmeans(E, k, iters=8):
        rng = np.random.default_rng(0)
        C = E[rng.choice(len(E), k, replace=False)].copy()
        for _ in range(iters):
            a = np.argmax(E @ C.T, axis=1)
            for j in range(k):
                if (a == j).any():
                    C[j] = _unit(E[a == j].mean(0))
        return [c.copy() for c in C]

    # —— 打分 / 判决 ——
    def score(self, wav16k):
        """原始 cosine(质心与最近原型的折中)。无登记 → None。"""
        if self.centroid is None:
            return None
        e = _unit(self.embed_fn(np.asarray(wav16k, np.float32)))
        s_c = float(e @ self.centroid)
        s_p = max(float(e @ p) for p in self.protos) if self.protos else s_c
        return max(s_c, 0.5 * (s_c + s_p))

    def verdict(self, wav16k, echo=False, adapt=True):
        """全句终判。返回 dict(ok, score, thr, mode, reason)。off → 一律放行(不计分);learn → 放行并记录分数。"""
        if self.mode == "off" or self.centroid is None:
            return {"ok": True, "score": None, "thr": self.thr, "mode": self.mode, "reason": "lock_off"}
        try:
            s = self.score(wav16k)
        except Exception as e:  # noqa: BLE001
            return {"ok": self.mode == "learn", "score": None, "thr": self.thr, "mode": self.mode, "reason": "embed_error: %s" % str(e)[:80], "too_short": "短" in str(e)}
        ok = s >= self.thr
        (self.stats["scores_owner"] if ok else self.stats["scores_other"]).append(s)
        if adapt and ok and not echo and s >= self.thr + 0.04:
            self._adapt(wav16k)
        return {"ok": bool(ok or self.mode == "learn"), "score": round(float(s), 4), "thr": round(self.thr, 4), "mode": self.mode, "reason": "owner" if ok else "not_owner"}

    def seq_decider(self, win_s=1.5, step_s=0.25, a=3.0, b=3.0):
        return SeqDecider(self, win_s, step_s, a, b)

    # —— 有界 EMA 自适应(只用高置信、非回声样本;锚点永不改;可回滚) ——
    def _adapt(self, wav16k, rate=0.02, max_drift=0.97):
        try:
            e = _unit(self.embed_fn(np.asarray(wav16k, np.float32)))
        except Exception:  # noqa: BLE001
            return False
        with self._lock:
            new = _unit((1 - rate) * self.centroid + rate * e)
            if float(new @ self.anchor) < max_drift:
                return False
            self.history.append(self.centroid.copy())
            self.history = self.history[-20:]
            self.centroid = new
            self.updates += 1
        return True

    def rollback(self):
        with self._lock:
            if self.history:
                self.centroid = self.history.pop()
                self.updates = max(0, self.updates - 1)
                return True
            if self.anchor is not None:
                self.centroid = self.anchor.copy()
                self.updates = 0
                return True
        return False

    @staticmethod
    def far_frr_curve(own_scores, other_scores, n=21):
        """用【真实采集】的主人/他人分数画 FAR/FRR 曲线;样本不足 → None(界面显示「数据不足」)。"""
        if len(own_scores) < 10 or len(other_scores) < 10:
            return None
        o, x = np.asarray(own_scores, float), np.asarray(other_scores, float)
        ts = np.linspace(min(o.min(), x.min()), max(o.max(), x.max()), n)
        return [{"thr": round(float(t), 3), "frr": round(float((o < t).mean()), 3), "far": round(float((x >= t).mean()), 3)} for t in ts]

    # —— 持久化(只写本地私有目录,0600;绝不进公开仓库;delete 真删) ——
    def to_dict(self):
        return {"backend": self.backend, "mode": self.mode, "thr": self.thr, "floor": self.floor, "loo": self.loo, "enrolled_at": self.enrolled_at,
                "centroid": None if self.centroid is None else self.centroid.tolist(), "anchor": None if self.anchor is None else self.anchor.tolist(),
                "protos": [p.tolist() for p in self.protos], "updates": self.updates}

    def save(self):
        os.makedirs(self.state_dir, exist_ok=True)
        p = os.path.join(self.state_dir, "voicelock.json")
        tmp = p + ".tmp"
        with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(self.to_dict(), f)
        os.replace(tmp, p)
        return p

    def load(self):
        p = os.path.join(self.state_dir, "voicelock.json")
        if not os.path.isfile(p):
            return False
        with open(p) as f:
            d = json.load(f)
        if d.get("backend") != self.backend:                 # 换了嵌入模型 → 旧向量不可比,必须重新登记
            return False
        with self._lock:
            self.mode, self.thr, self.loo, self.enrolled_at, self.updates = d.get("mode", "strict"), d.get("thr"), d.get("loo", {}), d.get("enrolled_at"), d.get("updates", 0)
            self.centroid = None if d.get("centroid") is None else np.asarray(d["centroid"])
            self.anchor = None if d.get("anchor") is None else np.asarray(d["anchor"])
            self.protos = [np.asarray(x) for x in d.get("protos", [])]
        return self.centroid is not None

    def delete(self):
        with self._lock:
            self.centroid = self.anchor = None
            self.protos, self.history, self.thr, self.updates, self.enrolled_at = [], [], None, 0, None
            self.mode = "off"
            self.loo = {"mean": None, "std": None, "n": 0}
        p = os.path.join(self.state_dir, "voicelock.json")
        try:
            if os.path.isfile(p):
                os.remove(p)
        except OSError:
            pass
        return not os.path.isfile(p)

    def info(self):
        return {"enrolled": self.centroid is not None, "mode": self.mode, "threshold": None if self.thr is None else round(self.thr, 3), "backend": self.backend,
                "loo": self.loo, "updates": self.updates, "enrolled_at": self.enrolled_at,
                "calibrated": False, "note": "cosine 为原始分数,未用标注数据校准;声纹验证不是安全认证,不能用于支付/解锁"}


class SeqDecider:
    """滑窗累计对数似然比(SPRT 思路)。目标分布 N(μ_t,σ_t) 取登记留一分布;非目标分布 N(thr−0.12, 0.06) 是【假设】(没有 impostor 集前无法估计),
    因此它只用于「打断时尽早放行/拒绝」,整句结束仍以全句 cosine ≥ thr 终判。"""

    def __init__(self, lock, win_s, step_s, a, b):
        self.lock, self.win, self.step, self.A, self.B = lock, int(win_s * SR16), int(step_s * SR16), a, b
        self.llr, self.pos, self.scores = 0.0, 0, []
        self.decision = None

    def feed_all(self, x16k):
        x = np.asarray(x16k, np.float32)
        lk = self.lock
        mu_t = max(lk.thr + 0.04, (lk.loo.get("mean") or (lk.thr + 0.05)) - 0.03)
        sd_t = max(lk.loo.get("std") or 0.03, 0.03)
        mu_n, sd_n = lk.thr - 0.12, 0.06
        win = min(self.win, len(x))
        while win >= int(0.6 * SR16) and self.pos + win <= len(x) and self.decision is None:
            try:
                s = lk.score(x[self.pos: self.pos + win])
            except Exception:  # noqa: BLE001
                break
            self.scores.append(s)
            l_t = -0.5 * ((s - mu_t) / sd_t) ** 2 - math.log(sd_t)
            l_n = -0.5 * ((s - mu_n) / sd_n) ** 2 - math.log(sd_n)
            self.llr += float(np.clip(l_t - l_n, -4.0, 4.0))
            if self.llr >= self.A:
                self.decision = "owner"
            elif self.llr <= -self.B:
                self.decision = "other"
            self.pos += self.step
        return self.decision or "undecided"


# ═══════════════════════════ M7.3 回声:已知参考信号的相干检测 ═══════════════════════════
def _bandpass_fft(x, lo=250.0, hi=3400.0, sr=SR16):
    X = np.fft.rfft(x)
    f = np.fft.rfftfreq(len(x), 1.0 / sr)
    X[(f < lo) | (f > hi)] = 0
    return np.fft.irfft(X, len(x)).astype(np.float32)


def echo_score(mic16k, ref16k, min_ref_rms=0.003):
    """mic 片段 vs 最近一段已知播放参考(16k):GCC-PHAT(相位变换加权互相关)峰值 + 峰旁比 PSR。
    PHAT 把幅度谱白化,只保留相位 → 「同一个声音在说不同内容」(克隆声 vs 主人声,谐波结构相近)不会因为周期性相似而假相干;
    真正的延迟副本(含房间混响、噪声)在真实延迟处出现尖锐峰。返回 dict(psr, peak, lag_s, echo)。
    echo=True ⇔ PSR ≥ 25(合成测试:同音色独立说话人 PSR ≤ 18,衰减 24dB+噪声的混响回声 PSR ≥ 34;真机必须用 RIR 混音重新校准)。
    说明:浏览器 AEC 已抑制大部分线性回声,这里是第二道、基于「精确已知参考」的闸。"""
    x = np.asarray(mic16k, np.float32)
    y = np.asarray(ref16k, np.float32)
    if x.size < 3200 or y.size < x.size or float(np.sqrt(np.mean(y ** 2))) < min_ref_rms:
        return {"peak": 0.0, "psr": 0.0, "lag_s": None, "echo": False, "reason": "no_reference"}
    x = x[: 16000 * 4]
    N, M = len(x), len(y)
    L = 1 << int(np.ceil(np.log2(M + N)))
    f = np.fft.rfftfreq(L, 1.0 / SR16)
    band = (f >= 250.0) & (f <= 3400.0)
    X = np.fft.rfft(x - x.mean(), L)
    Y = np.fft.rfft(y - y.mean(), L)
    G = Y * np.conj(X)
    G = np.where(band, G / (np.abs(G) + 1e-12), 0.0)
    c = np.fft.irfft(G, L)[: M - N + 1]
    a = np.abs(c)
    k = int(np.argmax(a))
    peak = float(a[k])
    side = np.delete(a, slice(max(0, k - 80), k + 80))
    psr = (peak - float(side.mean())) / (float(side.std()) + 1e-12) if side.size > 100 else 0.0
    coherent = bool(psr >= 25.0)
    near_frac = 0.0
    if coherent:                                     # 双讲检测:逐 32ms 帧看 mic 与「对齐后的参考」的相关;主人在说话的帧相关低 → near_end 占比高
        xb, yb = _bandpass_fft(x - x.mean()), _bandpass_fft(y - y.mean())
        st = M - N - (M - N - k)                     # = k:参考中与 mic 起点对齐的位置
        al = yb[st: st + N]
        fr = 512
        nf = min(len(xb), len(al)) // fr
        if nf >= 3:
            xs, ys = xb[: nf * fr].reshape(nf, fr), al[: nf * fr].reshape(nf, fr)
            ex_ = np.sqrt((xs ** 2).sum(1)) + 1e-9
            rho_f = np.abs((xs * ys).sum(1)) / (ex_ * (np.sqrt((ys ** 2).sum(1)) + 1e-9))
            voiced = ex_ > 0.15 * ex_.max()
            if voiced.any():
                near_frac = float((rho_f[voiced] < 0.35).mean())
    echo = bool(coherent and near_frac < 0.4)
    return {"peak": round(peak, 5), "psr": round(psr, 2), "lag_s": round((M - N - k) / SR16, 3), "echo": echo, "double_talk": bool(coherent and not echo),
            "near_end_frac": round(near_frac, 3), "reason": ("double_talk" if coherent and not echo else "coherent") if coherent else "independent"}


class RefBuffer:
    """网关侧:保存最近 N 秒【实际发给浏览器的】播放 PCM(24k int16),供回声相干检测使用。"""

    def __init__(self, seconds=45):
        self.cap = seconds * SR
        self.chunks = deque()
        self.n = 0
        self.t_last = 0.0
        self._lk = threading.Lock()

    def add(self, b):
        a = np.frombuffer(b, dtype="<i2")
        with self._lk:
            self.chunks.append(a)
            self.n += len(a)
            self.t_last = time.time()
            while self.n > self.cap and self.chunks:
                self.n -= len(self.chunks.popleft())

    def last16k(self):
        with self._lk:
            if not self.chunks:
                return np.zeros(0, np.float32)
            a = np.concatenate(list(self.chunks)).astype(np.float32) / 32768.0
        return to16k(a, SR)

    def idle_s(self):
        return time.time() - self.t_last if self.t_last else 1e9


