#tFoot{border-top:1px solid var(--line);background:var(--card);padding:10px 14px;gap:8px}
#tSteps{padding:10px 14px 0}.step{background:transparent;border-color:var(--line2)}
body.noscroll #theater.full,#theater.full{position:fixed;inset:0;z-index:90;margin:0;max-width:none;border-radius:0;border:0;display:grid;grid-template-columns:minmax(0,1fr) 320px;grid-template-rows:auto auto minmax(0,1fr) auto;grid-template-areas:"bar bar" "prog prog" "stage side" "foot foot";background:var(--bg);animation:fadeup .3s var(--ease) both}
#theater.full #tBar{grid-area:bar}#theater.full #tProg{grid-area:prog}
