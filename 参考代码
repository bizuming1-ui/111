    def add_turn(self, rep):
        self.d["turns_analyzed"] += 1
        self.d["last_turn"] = rep
        if rep.get("problems"):
            self.d["turns_with_problems"] += 1
            self.d["worst_turn"] = rep

    def snapshot(self):
        return dict(self.d)
