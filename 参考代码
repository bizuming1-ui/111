"""
data_prep.py —— 训练数据预处理(子系统 A)

  输入 : --src 目录(默认 /kaggle/working/reference_audio),里面放 .wav/.mp3/.flac/.m4a 音频,可附同名 .txt 转录
  处理 : ① 统一转成 24kHz 单声道 16-bit  ② 长录音(>20s)按静音自动切成 3~15 秒的片段(不是直接丢掉,不浪费数据)
         ③ 过滤 <2s / >20s / 几乎无声的片段  ④ 没有 .txt 的片段用 Whisper 自动转录  ⑤ 挑一条最合适的参考音频 ref.wav/ref.txt
         ⑥ 95% / 5% 划分训练集/验证集  ⑦ 用 Qwen3-TTS-Tokenizer-12Hz 提取 audio_codes(SFT 训练需要)
  输出 : data/wavs/*.wav · dataset.jsonl · train.jsonl · val.jsonl · ref.wav · ref.txt · train_codes.jsonl · val_codes.jsonl
"""
import argparse
import json
import os
import random
import shutil
import sys
import time
from pathlib import Path

import numpy as np

SR = 24000
EXTS = {".wav", ".mp3", ".flac", ".m4a", ".ogg", ".aac", ".opus", ".webm"}
MIN_S, MAX_S, CHUNK_MAX = 2.0, 20.0, 15.0


def load_audio(p):
    import librosa
    y, _ = librosa.load(str(p), sr=SR, mono=True)
    return y.astype(np.float32)


def split_long(y):
    """把长录音按静音切成 3~15 秒的片段,返回 [(start, end)] 采样点区间"""
    import librosa
    iv = librosa.effects.split(y, top_db=33, frame_length=2048, hop_length=512)
    segs, cur = [], None
    for s, e in iv:
        if e - s > CHUNK_MAX * SR:                       # 单段连续说话就超长: 在能量最低点硬切
            pieces = []
            a = s
            while e - a > CHUNK_MAX * SR:
                lo, hi = a + int(8 * SR), a + int(CHUNK_MAX * SR)
                w = np.abs(y[lo:hi])
                k = lo + int(np.argmin(np.convolve(w, np.ones(480) / 480, mode="same")))
                pieces.append((a, k))
                a = k
            pieces.append((a, e))
        else:
            pieces = [(s, e)]
        for ps, pe in pieces:
            if cur is None:
                cur = [ps, pe]
            elif pe - cur[0] <= CHUNK_MAX * SR and ps - cur[1] <= 0.8 * SR:
                cur[1] = pe
            else:
                segs.append(tuple(cur))
                cur = [ps, pe]
    if cur is not None:
        segs.append(tuple(cur))
    pad = int(0.12 * SR)
    return [(max(0, s - pad), min(len(y), e + pad)) for s, e in segs]


def rms_db(y):
    return 20 * np.log10(float(np.sqrt((y.astype(np.float64) ** 2).mean())) + 1e-9)


def build_asr(name, device):
    import torch
    from transformers import pipeline
    dev = 0 if (device.startswith("cuda") and torch.cuda.is_available()) else -1
    last = None
    for n in (name, "openai/whisper-small"):
        try:
            print("加载语音识别模型 %s …" % n, flush=True)
            return pipeline("automatic-speech-recognition", model=n, device=dev, torch_dtype=torch.float16 if dev == 0 else torch.float32, chunk_length_s=30)
        except Exception as e:  # noqa: BLE001
            last = e
            print("  加载失败: %s" % e, flush=True)
    raise RuntimeError("语音识别模型加载失败: %s" % last)


def transcribe(pipe, wavs16, language):
    kw = {"task": "transcribe"}
    if language:
        kw["language"] = language
    outs = []
    for i in range(0, len(wavs16), 8):
        batch = [{"raw": w, "sampling_rate": 16000} for w in wavs16[i:i + 8]]
        res = pipe(batch, batch_size=len(batch), generate_kwargs=kw)
        outs += [(r.get("text") or "").strip() for r in res]
        print("  转录 %d/%d" % (min(i + 8, len(wavs16)), len(wavs16)), flush=True)
    return outs


def to16(y):
    from speaker_sim import to16k
    return to16k(y, SR)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--src", default="/kaggle/working/reference_audio")
    ap.add_argument("--out", default="/kaggle/working/data")
    ap.add_argument("--device", default="cuda:0")
    ap.add_argument("--asr_model", default=os.environ.get("VC_ASR_MODEL", "openai/whisper-large-v3-turbo"))
    ap.add_argument("--language", default="", help="转录语言提示,如 chinese / english;留空自动检测")
    ap.add_argument("--tokenizer", default="Qwen/Qwen3-TTS-Tokenizer-12Hz")
    ap.add_argument("--skip_codes", action="store_true")
    ap.add_argument("--val_ratio", type=float, default=0.05)
    args = ap.parse_args()

    import soundfile as sf
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    src, out = Path(args.src), Path(args.out)
    files = sorted(p for p in src.rglob("*") if p.suffix.lower() in EXTS) if src.exists() else []
    if not files:
        raise SystemExit("❌ 在 %s 里没找到音频文件(.wav/.mp3/.flac/.m4a …)。请把参考音频上传成 Kaggle Dataset 并设置 TRAIN_DATA_DIR。" % src)
    if out.exists():
        shutil.rmtree(out)
    (out / "wavs").mkdir(parents=True)
    print("找到 %d 个音频文件,开始切分/统一格式…" % len(files), flush=True)

    clips = []                      # dict(path, text, dur, rms)
    dropped = {"太短": 0, "太长": 0, "太安静": 0, "读取失败": 0}
    for fi, f in enumerate(files):
        try:
            y = load_audio(f)
        except Exception as e:  # noqa: BLE001
            dropped["读取失败"] += 1
            print("  ⚠ 跳过 %s: %s" % (f.name, e))
            continue
        dur = len(y) / SR
        txt_file = f.with_suffix(".txt")
        given = txt_file.read_text(encoding="utf-8", errors="ignore").strip() if txt_file.exists() else ""
        if dur > MAX_S:
            ranges = split_long(y)
            given = ""                                # 长录音的整段文字没法对齐到片段,交给 ASR
        else:
            ranges = [(0, len(y))]
        for ci, (s, e) in enumerate(ranges):
            seg = y[s:e]
            d = len(seg) / SR
            if d < MIN_S:
                dropped["太短"] += 1
                continue
            if d > MAX_S:
                dropped["太长"] += 1
                continue
            if rms_db(seg) < -48:
                dropped["太安静"] += 1
                continue
            pk = float(np.abs(seg).max())
            if pk > 1e-4:
                seg = seg * (0.9 / pk)
            name = "%s_%03d_%02d.wav" % (f.stem[:40].replace(" ", "_"), fi, ci)
            sf.write(str(out / "wavs" / name), seg, SR, subtype="PCM_16")
            clips.append({"audio_path": str(out / "wavs" / name), "text": given, "duration": round(d, 3), "rms": rms_db(seg)})
    if not clips:
        raise SystemExit("❌ 过滤后没有可用片段:%s" % dropped)

    need = [c for c in clips if not c["text"]]
    if need:
        print("%d 个片段没有转录文本,使用 Whisper 自动转录…" % len(need), flush=True)
        pipe = build_asr(args.asr_model, args.device)
        texts = transcribe(pipe, [to16(load_audio(c["audio_path"])) for c in need], args.language)
        for c, t in zip(need, texts):
            c["text"] = t
        del pipe
        try:
            import torch
            torch.cuda.empty_cache()
        except Exception:  # noqa: BLE001
            pass
    bad = [c for c in clips if len(c["text"].strip()) < 2 or len(set(c["text"])) < 3]
    clips = [c for c in clips if c not in bad]
    if bad:
        print("丢弃 %d 个转录无效/为空的片段" % len(bad))
    if len(clips) < 5:
        raise SystemExit("❌ 可用片段只有 %d 条,太少,无法训练(建议总时长 10 分钟以上)。" % len(clips))

    rnd = random.Random(42)
    rnd.shuffle(clips)
    nval = max(1, int(round(len(clips) * args.val_ratio))) if len(clips) >= 20 else 0
    val, train = clips[:nval], clips[nval:]

    def dump(name, rows):
        with open(out / name, "w", encoding="utf-8") as fh:
            for r in rows:
                fh.write(json.dumps({"audio_path": r["audio_path"], "text": r["text"], "duration": r["duration"]}, ensure_ascii=False) + "\n")

    dump("dataset.jsonl", clips)
    dump("train.jsonl", train)
    dump("val.jsonl", val)

    cand = [c for c in clips if 6.0 <= c["duration"] <= 12.0] or [c for c in clips if 4.0 <= c["duration"] <= 14.0] or clips
    ref = max(cand, key=lambda c: (c["rms"] > -35) * 2 + (-abs(c["duration"] - 9.0)) / 9.0 + c["rms"] / 100.0)
    shutil.copy(ref["audio_path"], out / "ref.wav")
    (out / "ref.txt").write_text(ref["text"], encoding="utf-8")

    tot = sum(c["duration"] for c in clips)
    print("\n" + "─" * 50 + "\n数据集统计\n" + "─" * 50)
    print("  片段数 : %d (训练 %d / 验证 %d)" % (len(clips), len(train), len(val)))
    print("  总时长 : %.1f 分钟" % (tot / 60))
    print("  平均   : %.1f 秒/条" % (tot / len(clips)))
    print("  丢弃   : %s" % dropped)
    print("  参考音频: %s (%.1fs) 「%s」" % (Path(ref["audio_path"]).name, ref["duration"], ref["text"][:40]))
    if tot < 600:
        print("  ⚠ 总时长不足 10 分钟,声纹相似度提升会受限(建议 ≥ 10 分钟、越多越好)")

    if args.skip_codes:
        return
    print("\n提取 audio_codes(%s)…" % args.tokenizer, flush=True)
    from qwen_tts import Qwen3TTSTokenizer
    tok = Qwen3TTSTokenizer.from_pretrained(args.tokenizer, device_map=args.device)
    for name, rows in (("train_codes.jsonl", train), ("val_codes.jsonl", val)):
        with open(out / name, "w", encoding="utf-8") as fh:
            for i in range(0, len(rows), 16):
                b = rows[i:i + 16]
                enc = tok.encode([r["audio_path"] for r in b])
                for r, code in zip(b, enc.audio_codes):
                    fh.write(json.dumps({"audio": r["audio_path"], "text": r["text"], "ref_audio": str(out / "ref.wav"), "language": "Auto",
                                         "audio_codes": code.cpu().tolist()}, ensure_ascii=False) + "\n")
                print("  codes %d/%d" % (min(i + 16, len(rows)), len(rows)), flush=True)
    (out / "data_ready.json").write_text(json.dumps({"clips": len(clips), "minutes": round(tot / 60, 1), "time": time.strftime("%F %T")}), encoding="utf-8")
    print("✅ 数据准备完成 → %s" % out)


if __name__ == "__main__":
    main()
'''

FILES['tts_dataset.py'] = r'''# coding=utf-8
# 取自 QwenLM/Qwen3-TTS/finetuning/dataset.py (Apache-2.0),仅增加了参考 mel 缓存。
