        self.ref = None

    def embed(self, wav16k):
        torch = self.torch
        w = np.asarray(wav16k, dtype=np.float32).reshape(-1)
        if w.size < 8000:                                   # 不足 0.5 秒,嵌入不可靠
            w = np.pad(w, (0, 8000 - w.size))
        w = w[: 16000 * 30]
        inp = self.fe([w], sampling_rate=16000, return_tensors="pt", padding=True)
