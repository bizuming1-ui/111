def detect_emotion(t):
    """基于文本的规则情绪标签(neutral/happy/sad/question/comfort/angry)。
    ⚠ Qwen3-TTS-12Hz-1.7B-Base 的 generate_voice_clone 没有 instruct 参数(instruct 只存在于 CustomVoice / VoiceDesign 模型),
      所以这个标签【不会】传给模型,只用于界面标注和(可选的)句间停顿微调;模型本身的语气变化来自文本语义与参考音频,不是可控的情绪开关。"""
    for lab, rx in _EMO_RULES:
        if rx.search(t or ""):
            return lab
    return "neutral"


