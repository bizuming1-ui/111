def voice(f0, formants, dur, seed, snr_db=35.0):
    rng = np.random.default_rng(seed)
    n = int(SR16 * dur)
    t = np.arange(n) / SR16
    traj = f0 * (1 + 0.08 * np.cumsum(rng.standard_normal(n)) / np.sqrt(n) * 8)
    traj = np.clip(traj, f0 * 0.8, f0 * 1.2)
    ph = 2 * np.pi * np.cumsum(traj) / SR16
    src = sum(np.sin(h * ph) / h ** 0.8 for h in range(1, 30))
    X = np.fft.rfft(src)
    f = np.fft.rfftfreq(n, 1 / SR16)
    H = sum(np.exp(-0.5 * ((f - fm) / bw) ** 2) * g for fm, bw, g in formants) + 0.02
    sig = np.fft.irfft(X * H, n)
    env = np.clip(np.sin(2 * np.pi * (4.5 + rng.random()) * t + rng.random() * 6) + 0.25, 0, None) ** 0.7
    sig = sig * env
    sig = sig / (np.sqrt(np.mean(sig ** 2)) + 1e-9) * 0.08
    noise = rng.standard_normal(n) * 0.08 * 10 ** (-snr_db / 20)
    return (sig + noise).astype(np.float32)


