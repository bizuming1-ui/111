#  输出:按句序打包成协议 v2 帧
# ════════════════════════════════════════════════════════════════
def emit(turn, pcm_bytes, flags=0, seg=0):
    f = pack_frame(turn.uid, turn.seq, SR, pcm_bytes, flags, seg)
    turn.seq += 1
    turn.log.append(f)
    turn.sess.send_bin(f)


def pump(turn):
    """按句子顺序把已就绪的音频推给浏览器。受背压窗口限制:浏览器领先过多时,音频留在队列里不发。"""
    if turn.closed:
        return
    while turn.cur < len(turn.segs):
        seg = turn.segs[turn.cur]
        if seg.out:
            if turn.sent_ahead_ms() >= turn.window_ms:
                return
            parts, flags = [], F_SEG if not seg.had_audio else 0
            if turn.pending_pause > 0:
                parts.append(np.zeros(int(SR * turn.pending_pause / 1000), "<i2").tobytes())
                turn.pending_pause = 0
                flags |= F_PAUSE
            for a in seg.out:
                parts.append(a.astype("<i2").tobytes())
            seg.out = []
            b = b"".join(parts)
            turn.samples += len(b) // 2
            if turn.first_audio is None:
                turn.first_audio = time.time() - turn.t0
                WARM["n"] += 1
            seg.had_audio = True
            emit(turn, b, flags, seg.idx)
        if seg.done:
            if seg.had_audio:
                turn.pending_pause = int(pause_ms(seg.end, turn.breath) * (EMO_PAUSE_SCALE.get(seg.emotion, 1.0) if EMOTION_PAUSE else 1.0))
            turn.cur += 1
            continue
        return
    if turn.text_done and turn.cur >= len(turn.segs):
        finish_turn(turn)


def finish_turn(turn):
    turn.closed = True
    ACTIVE.pop(turn.uid, None)
    emit(turn, b"", F_END, len(turn.segs))
    if turn.sim_wait > 0:
        RECENT[turn.uid] = turn
    gaps = {}
    for g in sorted(set(x[1] for x in turn.chunk_log)):
        xs, last = [], None
        for sg, gg, t in turn.chunk_log:
            if gg != g:
                continue
            if last is not None and last[0] == sg:
                xs.append((t - last[1]) * 1000)
            last = (sg, t)
        gaps[str(g)] = pcts(xs)
    seg0 = turn.segs[0].stats if turn.segs else {}
    turn.done_msg = {"type": "turn_done", "turn": turn.uid, "audio_s": round(turn.samples / SR, 2), "frames": turn.seq, "samples": turn.samples,
                     "first_ms": int(turn.first_audio * 1000) if turn.first_audio is not None else None, "model_first_ms": int(seg0.get("first", 0) * 1000) if seg0.get("first") else None,
                     "queue_ms": int((turn.segs[0].sent_at - turn.t0) * 1000) if turn.segs and turn.segs[0].sent_at else None, "cold": turn.cold,
                     "gpu_segs": turn.gpu_segs, "segs": len(turn.segs), "chars": len(turn.full_text), "chunk_gap_ms_by_gpu": gaps, "errors": turn.errors, "integrity": turn.integrity,
                     "policy": turn.policy, "pinned": turn.pinned, "plan": turn.plan, "emotions": [g.emotion for g in turn.segs][:40], "replayed_frames": turn.replayed,
                     "seeds": [g.stats.get("seed") for g in turn.segs][:40], "library_id": (turn.lib or {}).get("library_id")}
    turn.sess.send(turn.done_msg)
    TURN_LOG.append(dict(turn.done_msg, chars=len(turn.full_text), t=time.time()))
    if turn.gen_pcm:
        GEN_AUDIO[turn.uid] = b"".join(turn.gen_pcm)
        GEN_LIB[turn.uid] = (turn.lib or {}).get("library_id")
        while len(GEN_AUDIO) > 3:
            GEN_AUDIO.popitem(last=False)
        if LOOP is not None and VOICE.get("ref_summary") is not None:
            LOOP.create_task(acoustic_job(turn))
    sim_check(turn)


async def acoustic_job(turn):
    try:
        pcm = np.frombuffer(GEN_AUDIO.get(turn.uid, b""), dtype="<i2")
        if pcm.size < SR:
            return
        gen = await LOOP.run_in_executor(None, lambda: aq.acoustic_summary(pcm, SR, turn.full_text, "speech"))
        ref = VOICE["ref_summary"]
        turn.sess.send({"type": "acoustic", "turn": turn.uid, "ref": ref, "gen": gen, "diff": aq.compare_summaries(ref, gen)})
    except Exception as e:  # noqa: BLE001
        log.warning("声学摘要失败: %s", e)


def dispatch(turn, text, final=False):
    clean = tts_clean(text, final=final)
    if not turn.tts or not has_speech(clean):
        return
    seg = Seg(len(turn.segs), clean, text.strip()[-1:])
    turn.segs.append(seg)
    if not POOL or not POOL.usable():
        seg.done = True
        seg.err = "没有可用的 GPU 进程或声音还没克隆好"
        if not turn.warned:
            turn.warned = True
            turn.sess.send({"type": "warn", "msg": "无法朗读: " + seg.err})
        return
    turn.sim_wait += 1
    prof = "first" if seg.idx == 0 else ("second" if seg.idx == 1 else "rest")
    POOL.backlog.append((turn.uid, seg.idx, clean, prof))
    POOL.schedule()


def _apply_gain(a, g):
    if a.size and abs(g - 1.0) > 0.02:
        a = np.clip(a.astype(np.float32) * g, -32767, 32767).astype("<i2")
    return a


def on_worker_msg(msg):
    k = msg[0]
    if k == "status":
        _, idx, stage, text = msg
        w = POOL.workers[idx]
        w.status, w.msg = stage, text
        broadcast(state_public())
    elif k == "backend":
        _, idx, info = msg
        BACKEND[idx] = info
        broadcast(state_public())
    elif k == "voice_ok":
        _, idx, vid, info = msg
        w = POOL.workers[idx]
        cal = info.pop("ch", None) if isinstance(info, dict) else None
        if vid == VOICE["vid"]:
            w.voice_vid, w.voice_info = vid, info
            VOICE["pending"].discard(idx)
            VOICE["info"][str(idx)] = info
            rs = {int(k_): v.get("rms") for k_, v in VOICE["info"].items() if v.get("rms")}
            if rs:                                              # 两卡有声 RMS 对齐(整卡常数增益,限制在 ±1.5dB 以内;不做逐 chunk 自动增益)
                tgt = float(np.exp(np.mean(np.log(list(rs.values())))))
                TARGET_RMS[0] = round(tgt, 1)
                for i, r in rs.items():
                    GAIN[i] = float(min(1.19, max(0.84, tgt / max(r, 1.0))))
            log.info("[GPU%d] 声音就绪: %s 增益 %.2f", idx, info, GAIN.get(idx, 1.0))
            st = W(idx)
            if info.get("rtf") and info.get("ttfa") and st["n"] == 0:
                st["rtf"], st["ttfa"] = float(info["rtf"]), float(info["ttfa"])
                st["F"] = min(0.2, max(0.03, float(info["rtf"]) * FRAME_S - st["D"] / 5))
                st["PRE"] = max(0.15, float(info["ttfa"]) - 2 * st["F"] - st["D"])
                if cal:
                    st["obs"].clear()
                    ingest_chunks(idx, cal)
            _voice_progress()
            POOL.schedule()
    elif k == "voice_err":
        _, idx, vid, err = msg
        if vid == VOICE["vid"]:
            VOICE["pending"].discard(idx)
            VOICE["err"] = err
            log.error("[GPU%d] 声音设置失败: %s", idx, err)
            _voice_progress()
    elif k == "asr":
        _, rid, text, err = msg
        fut = ASR_WAIT.pop(rid, None)
        if fut and not fut.done():
            fut.set_result((text, err))
    elif k in ("spk_qc", "spk_cmp"):
        _, rid, res, err = msg
        fut = QC_WAIT.pop(rid, None)
        if fut and not fut.done():
            fut.set_result((res, err))
    elif k == "chunk":
        _, tuid, seg_i, data, tsec = msg
        t = ACTIVE.get(tuid)
        if t is None or t.closed or seg_i >= len(t.segs):
            return
        seg = t.segs[seg_i]
        t.chunk_log.append((seg_i, seg.worker, time.time() - t.t0))
        a = _apply_gain(seg.trim.feed(np.frombuffer(data, dtype="<i2")), GAIN.get(seg.worker, 1.0))
        if a.size:
            seg.out.append(a)
            if t.gen_samples < SR * 120:
                t.gen_pcm.append(a.tobytes())
                t.gen_samples += a.size
            pump(t)
    elif k == "sim":
        _, tuid, seg_i, sim, dur = msg[:5]
        info = msg[5] if len(msg) > 5 and isinstance(msg[5], dict) else {"status": "completed" if sim is not None else "not_evaluated", "reason": ""}
        t = ACTIVE.get(tuid) or RECENT.get(tuid)
        if t is None or seg_i >= len(t.segs):
            return                                                    # 迟到/未知任务的结果直接丢弃,不会串到新一轮
        t.segs[seg_i].sim, t.segs[seg_i].sim_dur = sim, float(dur or 0)
        t.segs[seg_i].sim_info = info
        _sim_slot_done(t, seg_i)
    elif k in ("seg_done", "seg_err"):
        if k == "seg_done":
            _, tuid, seg_i, idx, stats = msg
            err = ""
        else:
            _, tuid, seg_i, idx, err = msg
            stats = {}
        w = POOL.workers[idx]
        w.inflight = max(0, w.inflight - 1)
        w.cur = None
        try:
            if stats.get("audio") and stats.get("wall") and not err:
                st = W(idx)
                a_s, first = float(stats["audio"]), float(stats.get("first") or 0)
                seg0 = ACTIVE.get(tuid)
                if a_s > 1.2 and stats["wall"] > first:
                    st["rtf"] = _ema(st["rtf"], (stats["wall"] - first) / max(a_s - 0.3, 0.3))
                    st["n"] += 1
                if first > 0:
                    st["ttfa"] = _ema(st["ttfa"], first)
                ingest_chunks(idx, stats.get("ch"))
                if seg0 is not None and seg_i < len(seg0.segs) and len(seg0.segs[seg_i].text) >= 6 and a_s > 1.0:
                    sg = seg0.segs[seg_i]
                    delivered = (sg.trim.total + sg.trim.carry.size) / SR
                    if delivered > 0.5:
                        TEXT_STATS["spc"] = min(0.5, max(0.08, _ema(TEXT_STATS["spc"], delivered / len(sg.text))))
                        TEXT_STATS["trim"] = min(1.0, max(0.0, _ema(TEXT_STATS["trim"], a_s - delivered)))
        finally:
            POOL.schedule()
        t = ACTIVE.get(tuid)
        if t is None or t.closed or seg_i >= len(t.segs):
            if k == "seg_err":
                t2 = RECENT.get(tuid)
                if t2 is not None:
                    _sim_slot_done(t2, seg_i)
            return
        seg = t.segs[seg_i]
        w.pending = max(0, w.pending - len(seg.text))
        a = _apply_gain(seg.trim.flush(), GAIN.get(seg.worker, 1.0))
        if a.size:
            seg.out.append(a)
            if t.gen_samples < SR * 120:
                t.gen_pcm.append(a.tobytes())
                t.gen_samples += a.size
        if err or stats.get("skipped"):
            _sim_slot_done(t, seg_i)
        seg.done, seg.err, seg.stats = True, err, stats
        if stats.get("qc"):
            for wmsg in stats["qc"].get("warnings", []):
                t.integrity.append("第%d句: %s" % (seg_i + 1, wmsg))
        if err:
            t.errors.append("第%d句: %s" % (seg_i + 1, err))
            t.sess.send({"type": "warn", "msg": "第 %d 句音频被判定为损坏/合成失败(未标记为成功): %s" % (seg_i + 1, err), "integrity": True})
        elif stats.get("audio"):
            log.info("[#%d] 第%d句 GPU%d: %d字 → 音频 %.1fs, 首包 %.2fs, 耗时 %.1fs (RTF %.2f) seed=%s", t.uid, seg_i, idx, len(seg.text),
                     stats["audio"], stats.get("first") or 0, stats.get("wall") or 0, (stats.get("wall") or 0) / max(stats["audio"], 1e-3), stats.get("seed"))
        pump(t)


def turn_sim(turn):
    xs = [(g.sim, g.sim_dur) for g in turn.segs if g.sim is not None and g.sim_dur > 1.2]
    if not xs:
        return None
    return round(sum(a * b for a, b in xs) / sum(b for _, b in xs), 4)


def _sim_slot_done(turn, seg_i):
    g = turn.segs[seg_i]
    if g.sim_done:
        return
    g.sim_done = True
    turn.sim_wait = max(0, turn.sim_wait - 1)
    sim_check(turn)


def sim_check(turn):
    if turn.sim_sent:
        return
    v = turn_sim(turn)
    final = turn.closed and turn.sim_wait == 0
    if v is not None or final:
        infos = [getattr(g, "sim_info", None) for g in turn.segs if getattr(g, "sim_info", None)]
        st = "completed" if v is not None else ("failed" if any(i.get("status") == "failed" for i in infos) else "skipped" if any(i.get("status") == "skipped" for i in infos) else "not_evaluated")
        why = "" if v is not None else (next((i.get("reason") for i in infos if i.get("status") == st and i.get("reason")), "") or "没有可评分的句子(句子太短或评分器未就绪)")
        lib_ = turn.lib or {}
        turn.sess.send({"type": "sim", "turn": turn.uid, "value": v, "final": bool(final), "view": aq.similarity_view(v, SV_MODEL, CAL, "speech"),
                        "per_gpu": _sim_by_gpu(turn), "status": st, "reason": why, "scope": "生成音频 vs 当前参考样本的原始 cosine(不是留出评估)", "model": SV_MODEL,
                        "library_id": lib_.get("library_id"), "sample_id": lib_.get("sample_id"), "dataset_version": lib_.get("dataset_version")})
    if final:
        turn.sim_sent = True
        RECENT.pop(turn.uid, None)


def _sim_by_gpu(turn):
    d = {}
    for g in turn.segs:
        if g.sim is not None and g.sim_dur > 1.2 and g.worker >= 0:
            d.setdefault(str(g.worker), []).append(g.sim)
    return {k: {"mean": round(float(np.mean(v)), 4), "n": len(v)} for k, v in d.items()}


def _voice_progress():
    if not VOICE["pending"]:
        ok = [w for w in POOL.workers if w.voice_vid == VOICE["vid"]]
        VOICE["state"] = "ready" if ok else "error"
        if ok:
            VOICE["err"] = ""
            WARM["n"] = 0
        else:
            VOICE["err"] = VOICE["err"] or "所有 GPU 都没能完成声音设置"
    broadcast(state_public())


def reader_thread(loop):
    while True:
        try:
            msg = POOL.res_q.get()
        except Exception:  # noqa: BLE001
            return
        try:
            loop.call_soon_threadsafe(on_worker_msg, msg)
        except RuntimeError:
            return


# ════════════════════════════════════════════════════════════════
#  参考音频:解码 → 原件另存 → 处理版(去直流/去首尾静音/峰值 -3dBFS/24kHz) → 质检 → 克隆
# ════════════════════════════════════════════════════════════════
def decode_audio(data):
    """尽量接受任意格式: wav(16/24/32bit/float) 用 soundfile;其余交给 soundfile/librosa(ffmpeg)。返回 (float32 mono, sr, 原声道数)"""
    import soundfile as sf
    try:
        a, sr = sf.read(io.BytesIO(data), dtype="float32", always_2d=True)
    except Exception:  # noqa: BLE001
        import tempfile
        import librosa
        with tempfile.NamedTemporaryFile(suffix=".bin", delete=False) as f:
            f.write(data)
            tmp = f.name
        try:
            y, sr = librosa.load(tmp, sr=None, mono=False)
            a = (y[:, None] if y.ndim == 1 else y.T).astype(np.float32)
        finally:
            os.unlink(tmp)
    ch = a.shape[1]
    return a.mean(axis=1).astype(np.float32), int(sr), int(ch)


def resample_to(x, sr, to=SR):
    if sr == to:
        return x
    from math import gcd
    from scipy.signal import resample_poly
    g = gcd(int(sr), int(to))
    return resample_poly(x, to // g, int(sr) // g).astype(np.float32)


def prepare_reference(a, sr):
    """处理版:去直流、去首尾静音、峰值归一到 -3dBFS、重采样到 24kHz。原件另存,绝不覆盖。超过 30 秒时在 20~30 秒内能量最低处截断。"""
    a = a - float(a.mean())
    fr = max(1, sr // 100)
    n = len(a) // fr
    if n > 10:
        e = np.sqrt((a[: n * fr].reshape(n, fr) ** 2).mean(axis=1))
        thr = max(0.004, float(np.percentile(e, 95)) * 0.06)
        idx = np.where(e > thr)[0]
        if idx.size:
            s = max(0, idx[0] - 15) * fr
            t = min(n, idx[-1] + 20) * fr
            a = a[s:t]
    cropped = False
    if len(a) > 30 * sr:
        lo, hi = 20 * sr, 30 * sr
        w = np.convolve(np.abs(a[lo:hi]), np.ones(sr // 50) / (sr // 50), mode="same")
        a = a[: lo + int(np.argmin(w))]
        cropped = True
    pk = float(np.abs(a).max()) if a.size else 0
    if pk > 1e-4:
        a = a * (0.7 / pk)
    return resample_to(a.astype(np.float32), sr), cropped


def write_wav(path, x, sr):
    with wave.open(str(path), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(sr)
        w.writeframes((np.clip(x, -1, 1) * 32767).astype("<i2").tobytes())


async def ask_worker(kind, path, timeout):
    w0 = next((w for w in POOL.workers if w.ready()), None) if POOL else None
    if w0 is None:
        return None, "没有可用的 GPU 进程"
    rid = "%s%d_%d" % (kind, VOICE["vid"], int(time.time() * 1000) % 100000)
    fut = LOOP.create_future()
    (ASR_WAIT if kind == "asr" else QC_WAIT)[rid] = fut
    w0.q.put((kind, rid, path))
    try:
        return await asyncio.wait_for(fut, timeout)
    except asyncio.TimeoutError:
        return None, "超时"


async def clone_job(vid, path, text, xvec):
    try:
        GAIN.clear()
        TARGET_RMS[0] = 0.0
        if not xvec and not text:
            VOICE["msg"] = "正在自动识别参考音频里说了什么(识别结果需要你核对)…"
            broadcast(state_public())
            text, err = await ask_worker("asr", path, 240)
            text = (text or "").strip()
            if err:
                log.warning("自动识别失败: %s", err)
            if text:
                VOICE["text_source"], VOICE["text_trusted"] = "asr", False
                qc = VOICE.get("qc") or {}
                voiced = qc.get("voiced_s") or 0
                n = len([c for c in text if c.isalnum() or "\u4e00" <= c <= "\u9fff"])
                if voiced > 1 and (n / voiced > 9 or n / voiced < 1.2):
                    qc.setdefault("warnings", []).append("ASR 文本与音频时长明显不匹配(%.1f 字/秒),很可能识别有误,请务必修正后重新克隆" % (n / voiced))
            else:
                xvec = True
                VOICE["text_source"] = "none(x-vector)"
        if vid != VOICE["vid"]:
            return
        VOICE.update(text=text, mode=("xvec" if xvec else "icl"), msg="", info={}, err="")
        (VOICE_DIR / "current.json").write_text(json.dumps({"path": path, "text": text, "xvec": xvec, "orig": VOICE.get("orig"), "text_source": VOICE["text_source"],
                                                              "text_trusted": VOICE["text_trusted"], "qc": VOICE.get("qc")}, ensure_ascii=False), encoding="utf-8")
        ref = VOICE.get("ref_summary") or {}
        if text and ref and not ref.get("error"):                     # 文字确定后再补算参考语音的语速
            try:
                y, _ = decode_audio(Path(path).read_bytes())[:2]
                VOICE["ref_summary"] = await LOOP.run_in_executor(None, lambda: aq.acoustic_summary(y, SR, text, VOICE.get("kind") if VOICE.get("kind") == "singing" else "speech"))
            except Exception as e:  # noqa: BLE001
                log.warning("参考摘要失败: %s", e)
        alive = [w for w in POOL.workers if w.proc.is_alive() and w.status != "error"]
        VOICE["pending"] = set(w.idx for w in alive)
        for w in POOL.workers:
            w.voice_vid = None
        if not alive:
            VOICE.update(state="error", err="没有可用的 GPU 进程")
            broadcast(state_public())
            return
        for w in alive:
            w.q.put(("voice", vid, path, text, xvec))
        broadcast(state_public())
    except Exception as e:  # noqa: BLE001
        log.exception("clone_job")
        VOICE.update(state="error", err="%s: %s" % (type(e).__name__, e))
        broadcast(state_public())


def start_clone(path, text, xvec):
    VOICE["vid"] += 1
    VOICE.update(state="cloning", path=path, text=text, mode="", pending=set(), info={}, err="", msg="准备中…")
    asyncio.get_running_loop().create_task(clone_job(VOICE["vid"], path, text, xvec))


@app.post("/api/voice")
async def api_voice(request: Request):
    if MONITOR_ONLY or not POOL or not POOL.workers:
        return JSONResponse({"ok": False, "error": "语音服务未启动(训练监控模式或没有 GPU)"}, status_code=503)
    q = request.query_params
    if q.get("consent") != "1":
        return JSONResponse({"ok": False, "error": "请先确认:这是你本人的声音,或已获得声音所有者的明确授权"}, status_code=400)
    data = await request.body()
    text = (q.get("text") or "").strip()
    ack = q.get("ack") == "1"
    ext = re.sub(r"[^a-z0-9]", "", (q.get("ext") or "bin").lower())[:5] or "bin"
    try:
        a, sr, ch = await LOOP.run_in_executor(None, decode_audio, data)
    except Exception as e:  # noqa: BLE001
        return JSONResponse({"ok": False, "error": "无法解码音频(%s)。请上传 wav / flac / mp3 / m4a" % str(e)[:120]}, status_code=415)
    proc, cropped = await LOOP.run_in_executor(None, prepare_reference, a, sr)
    qc = await LOOP.run_in_executor(None, lambda: aq.reference_qc(proc, SR, orig_sr=sr, channels=ch, text=text or None))
    if cropped:
        text = ""                                                # 截断后原文字不再严格对应 → 交给 ASR
        qc["warnings"].append("音频超过 30 秒已截断,提供的参考文字不再对应,将重新自动识别(请核对)")
    if qc["kind"] == "clean_speech":
        tmp = VOICE_DIR / ("tmp_qc_%d.wav" % int(time.time() * 1000))
        write_wav(tmp, proc, SR)
        res, err = await ask_worker("spk_qc", str(tmp), 60)
        tmp.unlink(missing_ok=True)
        if res and not err:
            qc["speaker_check"] = res
            if res.get("suspect"):
                qc.update(kind="multi_speaker", kind_zh="疑似多人说话", blocking=True)
                qc["warnings"].append("疑似多人说话(窗口说话人相似度 P10=%s < 0.55,启发式)。克隆需要单一说话人" % res.get("p10"))
            elif res.get("status") in ("failed", "skipped"):
                qc["warnings"].append("多人检测未运行(%s):%s" % (res["status"], str(res.get("reason", ""))[:160]))
        elif err:
            qc["warnings"].append("多人检测未运行:%s" % str(err)[:160])
    if qc["blocking"] and not ack:
        return {"ok": False, "needs_ack": True, "qc": qc}
    try:                                                          # 语音库:新样本【追加】保存到当前库(不覆盖旧样本);容量不足明确拒绝
        lib_sample = await LOOP.run_in_executor(None, lambda: PORTAL.legacy_append(data, ext, proc, sr, ch, qc, text))
    except Exception as e:  # noqa: BLE001
        return JSONResponse({"ok": False, "error": str(e)}, status_code=getattr(e, "code", 500))
    VOICE_DIR.mkdir(parents=True, exist_ok=True)
    n = int(time.time())
    orig_path = VOICE_DIR / ("orig_%d.%s" % (n, ext))
    orig_path.write_bytes(data)                                  # 原件保留
    path = VOICE_DIR / ("ref_%d.wav" % n)
    write_wav(path, proc, SR)                                    # 处理版另存
    kind = "singing" if qc["kind"] == "singing" else "speech"
    ref_summary = await LOOP.run_in_executor(None, lambda: aq.acoustic_summary(proc, SR, text or None, kind))
    VOICE.update(qc=qc, orig=str(orig_path), kind=kind, ack=ack, ref_summary=ref_summary,
                 text_source=("user" if text else ""), text_trusted=bool(text))
    PORTAL.bind_voice(lib_sample)
    start_clone(str(path), text, False)
    return {"ok": True, "vid": VOICE["vid"], "seconds": round(len(proc) / SR, 1), "qc": qc, "library": VOICE.get("library"), "sample_id": lib_sample["sample_id"]}


