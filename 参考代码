            write_state(state_file, status="running", epoch=epoch + 1, loss=round(ep_loss, 4), similarity=sim, best_epoch=be, best_similarity=bs)
            ctrl_path.write_text(json.dumps({"epoch": epoch + 1, "stop": bool(stop), "reason": reason, "best_epoch": be, "best_sim": bs, "sim": sim}), encoding="utf-8")
            keep = {be, epoch + 1, epoch}                                               # 只保留最优 + 最近两轮,省磁盘
            for old in ck_dir.glob("epoch_*"):
