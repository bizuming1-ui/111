def cur_lib():
    return (VOICE.get("library") or {}).get("library_id")


def art_err(e):
    return JSONResponse({"ok": False, "error": e.msg, "code": e.code}, status_code=e.http, headers={"Cache-Control": "no-store"})


def serve_file(request, path, sha, filename, ctype="audio/wav", etag_extra=""):
    size = path.stat().st_size
    etag = '"%s%s"' % (etag_extra, sha)
    hdr = {"ETag": etag, "Accept-Ranges": "bytes", "Cache-Control": "private, no-store", "X-Synthetic-Audio": "1", "X-Content-Type-Options": "nosniff",
           "Content-Disposition": 'attachment; filename="%s"' % art.safe_filename(filename), "X-Content-SHA256": sha}
    inm = request.headers.get("if-none-match")
    if inm and etag in [x.strip() for x in inm.split(",")]:
        return Response(status_code=304, headers={"ETag": etag, "Cache-Control": "private, no-store"})
    try:
        rng = art.parse_range(request.headers.get("range"), size)
    except art.ArtifactError:
        return Response(status_code=416, headers={"Content-Range": "bytes */%d" % size, "Cache-Control": "no-store"})
    ifr = request.headers.get("if-range")
    if rng and ifr and ifr.strip() != etag:
        rng = None                                                    # If-Range 不匹配:按规范返回完整新内容
    if rng:
        a, b = rng
        hdr.update({"Content-Range": "bytes %d-%d/%d" % (a, b, size), "Content-Length": str(b - a + 1), "Content-Type": ctype})
        if request.method == "HEAD":
            return Response(b"", status_code=206, headers=hdr)
        return StreamingResponse(art.iter_file(path, a, b), status_code=206, headers=hdr)
    hdr.update({"Content-Length": str(size), "Content-Type": ctype})
    if request.method == "HEAD":
        return Response(b"", status_code=200, headers=hdr)
    return StreamingResponse(art.iter_file(path), status_code=200, headers=hdr)


