#  动作校验(白名单)
# ════════════════════════════════════════════════════════════════
def _s(v, n):
    if not isinstance(v, str):
        raise ValueError("参数必须是字符串")
    v = v.strip()
    if not v or len(v) > n:
        raise ValueError("参数为空或过长")
    return v


def validate_actions(actions):
    if not isinstance(actions, list) or not actions:
        raise ValueError("没有可执行的动作")
    if len(actions) > MAX_STEPS:
        raise ValueError("动作数 %d 超过单任务上限 %d" % (len(actions), MAX_STEPS))
    out = []
    for a in actions:
        if not isinstance(a, dict) or a.get("action") not in ("goto", "search", "search_more", "open_result", "back", "forward", "reload", "scroll", "click", "type", "key", "read", "snapshot", "wait"):
            raise ValueError("不允许的动作: %r" % (a.get("action") if isinstance(a, dict) else a))
        k = a["action"]
        n = {"action": k}
        if k == "goto":
            n["url"] = _s(a.get("url"), 2048)
        elif k == "search":
            n["query"] = _s(a.get("query"), 300)
            n["engine"] = a.get("engine") if a.get("engine") in ENGINES else "bing"
            if a.get("site"):
                if not re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,80}\.[a-z]{2,24}", str(a["site"]).lower()):
                    raise ValueError("网站范围格式无效")
                n["site"] = str(a["site"]).lower()
            if a.get("recency") in ("d", "w", "m", "y"):
                n["recency"] = a["recency"]
        elif k == "search_more":
            pass
        elif k == "open_result":
            i = int(a.get("n", 1))
            if not 1 <= i <= 30:
                raise ValueError("结果序号超出范围")
            n["n"] = i
        elif k == "scroll":
            n["direction"] = a.get("direction") if a.get("direction") in ("up", "down", "top", "bottom") else "down"
            n["amount"] = max(100, min(3000, int(a.get("amount", 600))))
        elif k == "click":
            n["by"] = a.get("by") if a.get("by") in ("text", "role", "label", "placeholder") else "text"
            n["value"] = _s(a.get("value"), 120)
            if a.get("role"):
                n["role"] = a["role"] if a["role"] in ("button", "link", "textbox", "checkbox", "tab", "menuitem", "combobox", "searchbox") else "button"
            if a.get("nth") is not None:
                n["nth"] = max(0, min(50, int(a["nth"])))
        elif k == "type":
            n["text"] = _s(a.get("text"), MAX_TEXT)
            if a.get("into"):
                n["into"] = {"by": a["into"].get("by") if a["into"].get("by") in ("label", "placeholder", "role", "text") else "label", "value": _s(a["into"].get("value"), 120)}
            n["submit"] = bool(a.get("submit"))
        elif k == "key":
            if a.get("key") not in KEYS:
                raise ValueError("按键不在白名单内")
            n["key"] = a["key"]
        elif k == "wait":
            n["seconds"] = max(0.2, min(5.0, float(a.get("seconds", 1))))
        out.append(n)
    return out


# ════════════════════════════════════════════════════════════════
#  规则规划器(不依赖 LLM,不看网页内容)
# ════════════════════════════════════════════════════════════════
_CN = {"一": 1, "二": 2, "两": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9, "十": 10}


def _num(s):
    s = s.strip()
    return int(s) if s.isdigit() else _CN.get(s)


def _recency(t):
    """只有【明确的时间范围说法】才当作时间过滤;“今天的天气”“今年的计划”里的今天/今年是搜索主题的一部分,不能被删掉。"""
    for pat, v in ((r"最近一天|24\s*小时内?|过去一天|过去24小时|past day|last 24 ?h(?:ours)?", "d"), (r"最近一周|过去一周|最近7天|past week|last week", "w"),
                   (r"最近一个月|过去一个月|最近30天|past month|last month", "m"), (r"最近一年|过去一年|past year|last year", "y")):
        if re.search(pat, t, re.I):
            return v, re.sub(pat, " ", t, flags=re.I)
    return None, t


def plan_rules(text, engine="bing", loose=False):
    """返回 {"actions": [...], "clarify": str|None}。只做字符串解析。"""
    t = (text or "").strip()
    if not t:
        return {"actions": [], "clarify": "没有收到指令"}
    t = re.sub(r"^[\s\"“”'‘’「」]+|[\s。.!！?？,，;；\"“”'‘’「」]+$", "", t)                   # 语音识别常带句末标点
    ctl = {"pause": r"(暂停|先停一下|停一下|pause)", "resume": r"(继续|接着来|恢复|resume|continue)", "cancel": r"(取消|停止|算了|别搜了|cancel|stop)"}
    for k_, p_ in ctl.items():
        if re.fullmatch(p_ + r"(任务|执行|操作|一下)?", t, re.I):
            return {"actions": [], "clarify": None, "control": k_}
    clauses = [c.strip() for c in re.split(r"[，,;；]\s*|\s+then\s+|\s+and then\s+|然后|接着|之后|并且", t) if c and c.strip()]
    acts, unclear = [], []
    for c in clauses:
        c0 = re.sub(r"^(请你?|帮我|麻烦你?|请帮我|please|pls|再|嗯|呃|那个)\s*", "", c.strip(), flags=re.I).strip()
        c0 = re.sub(r"^(?:帮我|给我)\s*", "", c0).strip()
        m = None
        if re.fullmatch(r"(返回|后退|回退|go back|back)", c0, re.I):
            acts.append({"action": "back"})
        elif re.fullmatch(r"(前进|go forward|forward)", c0, re.I):
            acts.append({"action": "forward"})
        elif re.fullmatch(r"(刷新|重新加载|reload|refresh)(页面|网页)?", c0, re.I):
            acts.append({"action": "reload"})
        elif re.search(r"(几个|更多|多些|其他|另外)\s*的?\s*(来源|结果|网站)|more (sources|results)|next page|下一页", c0, re.I):
            acts.append({"action": "search_more"})
        elif (m := re.search(r"滚(?:动)?到(顶部|底部|最上面|最下面)|scroll to (top|bottom)", c0, re.I)):
            acts.append({"action": "scroll", "direction": "top" if re.search("顶部|最上|top", m.group(0), re.I) else "bottom"})
        elif (m := re.search(r"(?:向|往)?(下|上)(?:滚动|翻|滑|拉)|scroll (down|up)|翻页", c0, re.I)):
            d = "up" if re.search("上|up", m.group(0), re.I) else "down"
            n = re.search(r"(\d{2,4})\s*(?:像素|px)", c0)
            acts.append({"action": "scroll", "direction": d, "amount": int(n.group(1)) if n else 600})
        elif (m := re.match(r"(?:打开|访问|前往|进入|去|open|go to|visit|navigate to)\s*(.+)$", c0, re.I)):
            tgt = m.group(1).strip()
            r = re.search(r"第\s*(\d+|[一二两三四五六七八九十])\s*个?\s*(?:搜索)?(?:结果|链接|网站|页面)|(?:result|link)\s*#?(\d+)|(?:the )?(first|second|third)\s*(?:result|link)", tgt, re.I)
            if r:
                v = r.group(1) or r.group(2) or {"first": 1, "second": 2, "third": 3}.get((r.group(3) or "").lower())
                n = _num(str(v)) if v is not None else None
                acts.append({"action": "open_result", "n": n or 1})
            elif re.match(r"^(https?://)?[\w-]+(\.[\w-]+)+(:\d+)?(/\S*)?$", tgt, re.I):
                acts.append({"action": "goto", "url": netguard.normalize_user_target(tgt)})
            else:
                unclear.append(c)
        elif (m := re.match(r"(?:搜索|搜一下|搜|查一下|查找|查询|查|search for|search|google|look up|find)\s*(.+)$", c0, re.I)) or (m := re.match(r"(?:在|于)\s*([\w.-]+\.[a-z]{2,})\s*(?:上|里|中)?\s*(?:搜索|搜|查)\s*(.+)$", c0, re.I)):
            site = None
            q = m.group(m.lastindex)
            if m.lastindex == 2:
                site = m.group(1).lower()
            sm = re.search(r"(?:site:|在|于)\s*([a-z0-9][a-z0-9.-]*\.[a-z]{2,24})\s*(?:上|里|中)?", q + " " + c0, re.I)
            if sm and not site:
                site = sm.group(1).lower()
            q = re.sub(r"site:\S+|(?:在|于)\s*[a-z0-9][a-z0-9.-]*\.[a-z]{2,24}\s*(?:上|里|中)?", " ", q, flags=re.I)
            rec, q = _recency(q)
            q = re.sub(r"\s+", " ", q).strip(" 的:：")
            if q:
                a = {"action": "search", "query": q, "engine": engine}
                if site:
                    a["site"] = site
                if rec:
                    a["recency"] = rec
                acts.append(a)
            else:
                unclear.append(c)
        elif (m := re.match(r"(?:在\s*[「\"“']?(.+?)[」\"”']?\s*(?:里|中|框里|框中|栏里)?\s*)?(?:输入|键入|填写|type|enter|input)\s*[「\"“']?(.+?)[」\"”']?$", c0, re.I)):
            a = {"action": "type", "text": m.group(2)}
            if m.group(1):
                a["into"] = {"by": "label", "value": m.group(1)}
            acts.append(a)
        elif (m := re.match(r"(?:按|按下|press)\s*(回车|enter|esc|escape|tab|向下|向上)\s*键?$", c0, re.I)):
            k = {"回车": "Enter", "enter": "Enter", "esc": "Escape", "escape": "Escape", "tab": "Tab", "向下": "ArrowDown", "向上": "ArrowUp"}[m.group(1).lower()]
            acts.append({"action": "key", "key": k})
        elif (m := re.match(r"(?:点击|点一下|单击|点|click|tap)\s*(?:按钮|链接)?\s*[「\"“']?(.+?)[」\"”']?$", c0, re.I)):
            acts.append({"action": "click", "by": "text", "value": m.group(1)})
        elif re.search(r"阅读|读一下|读取|总结|摘要|看看|看一下|summari[sz]e|\bread\b", c0, re.I):
            acts.append({"action": "read"})
        elif re.search(r"截图|screenshot|屏幕", c0, re.I):
            acts.append({"action": "snapshot"})
        else:
            unclear.append(c)
    if loose and not acts and 1 <= len(t) <= 80 and not risk_words(t):
        return {"actions": validate_actions([{"action": "search", "query": t, "engine": engine}]), "clarify": None, "assumed_search": True}       # 语音里直接说出关键词 = 搜索它
    if unclear and not acts:
        return {"actions": [], "clarify": "无法确定要执行的操作:「%s」。请用类似“搜索 xxx”“打开 example.com”“点击 登录”的说法,或换一种表达。" % "; ".join(unclear)[:120]}
    try:
        acts = validate_actions(acts) if acts else []
    except ValueError as e:
        return {"actions": [], "clarify": str(e)}
    return {"actions": acts, "clarify": ("部分内容未能理解,已忽略:" + "; ".join(unclear)[:100]) if unclear else None}


