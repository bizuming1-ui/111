import hashlib
import json
import os
import re
import secrets
import shutil
import threading
import time
from pathlib import Path

SCHEMA = 1


class StoreError(Exception):
    def __init__(self, msg, code=400):
        super().__init__(msg)
        self.code = code


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def sha256_file(path, chunk=1 << 20):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            b = f.read(chunk)
            if not b:
                break
            h.update(b)
    return h.hexdigest()


def sha256_bytes(b):
    return hashlib.sha256(b).hexdigest()


def atomic_write_bytes(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp-%s" % secrets.token_hex(3))
    with open(tmp, "wb") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def atomic_write_json(path, obj, backup=True):
    path = Path(path)
    data = json.dumps(obj, ensure_ascii=False, indent=1, sort_keys=True).encode("utf-8")
    if backup and path.exists():
        try:
            shutil.copy2(path, path.with_name(path.name + ".bak"))
        except OSError:
            pass
    atomic_write_bytes(path, data)


def read_json(path, default=None):
    """主文件损坏时回退 .bak;两者都坏则抛错(调用方必须把错误告诉用户,不能当作空库)"""
    path = Path(path)
    last = None
    for p in (path, path.with_name(path.name + ".bak")):
        if p.exists():
            try:
                return json.loads(p.read_text(encoding="utf-8"))
            except Exception as e:  # noqa: BLE001
                last = e
    if last is not None:
        raise StoreError("%s 已损坏且没有可用备份: %s" % (path.name, last), 500)
    return default


def _id(prefix):
    return "%s_%s" % (prefix, secrets.token_hex(5))


