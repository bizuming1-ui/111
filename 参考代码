def test_unit_agent_cursor_and_typing_events_follow_real_calls():
    """鼠标/键盘事件必须与真实的 Playwright 调用一一对应(这里用记录型替身页面验证事件序列;真实 Chromium 画面验证见 test_portal 的浏览器测试,缺 Chromium 时标「未验证」)。"""
    import browser_agent as ba

    class Mouse:
        def __init__(self):
            self.moves = []

        async def move(self, x, y, steps=1):
            self.moves.append((round(x), round(y)))

    class Kb:
        def __init__(self):
            self.typed = []

        async def type(self, ch):
            self.typed.append(ch)

    class Pg:
        mouse, keyboard = Mouse(), Kb()

        async def evaluate(self, *a):
            return {"tag": "input", "type": "search", "name": "q", "ce": False}

    async def go():
        s = ba.BSession(None, "t")
        s.page = Pg()
        sub = ba.Sub()
        s.subs.add(sub)
        await s._mouse_to(500, 300, "click")
        await s._type("天气 ok", "bing.com") if False else None
        return s, sub
    s, sub = asyncio.run(go())
    ev = [m for m in sub.q if m["type"] == "cursor"]
    assert len(s.page.mouse.moves) == len(ev) >= 6, (len(s.page.mouse.moves), len(ev))                 # 每个事件 = 一次真实 mouse.move
    assert (ev[-1]["x"], ev[-1]["y"]) == s.page.mouse.moves[-1] == (500, 300) and ev[-1]["kind"] == "click" and all(e["kind"] == "move" for e in ev[:-1])
    assert all(ev[i]["t"] <= ev[i + 1]["t"] for i in range(len(ev) - 1))                                  # 时间戳来自真实执行,单调递增

    async def typ():
        s = ba.BSession(None, "t2")
        s.page = Pg()
        sub = ba.Sub()
        s.subs.add(sub)
        await s._type("天气 ok", "bing.com")
        return s, sub
    try:
        s2, sub2 = asyncio.run(typ())
    except Exception:  # noqa: BLE001
        s2 = None
    if s2 is not None:
        ty = [m for m in sub2.q if m["type"] == "typing"]
        assert Pg.keyboard.typed == list("天气 ok") and [m["ch"] for m in ty] == list("天气 ok") and ty[-1]["done"] and ty[-1]["text"] == "天气 ok"      # 每个字符 = 一次真实 keyboard.type


# ═════════════════════ Mock 引擎服务集成:/api/search 的错误必须是可读 JSON ═════════════════════
def _http(srv, method, path, body=None):
    import urllib.error
    import urllib.request
    data = json.dumps(body).encode() if isinstance(body, dict) else body
    req = urllib.request.Request(srv.url(path), data=data, method=method, headers={"Content-Type": "application/json"} if isinstance(body, dict) else {})
    try:
        r = urllib.request.urlopen(req, timeout=90)
        raw, code, hd = r.read(), r.status, r.headers
    except urllib.error.HTTPError as e:
        raw, code, hd = e.read(), e.code, e.headers
    try:
        return code, json.loads(raw), hd
    except ValueError:
        return code, raw.decode("utf-8", "replace"), hd


