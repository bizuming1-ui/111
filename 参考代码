FILES['vc_common.js'] = r'''/* vc_common.js —— 浏览器与 Node 单元测试共用的纯逻辑:帧协议校验 / 分位数 / 起播水位规划 */
"use strict";
(function (root) {
  const HEADER = 20, F_END = 1, F_SEG = 2, F_PAUSE = 4;

  function parseFrame(buf) {                        // buf: ArrayBuffer;PCM 视图 4 字节对齐,零拷贝
    if (buf.byteLength < HEADER) throw new Error("帧太短 " + buf.byteLength);
    const dv = new DataView(buf);
    const f = { turn: dv.getUint32(0, true), seq: dv.getUint32(4, true), sr: dv.getUint32(8, true), n: dv.getUint32(12, true), flags: dv.getUint16(16, true), seg: dv.getUint16(18, true) };
    if (buf.byteLength - HEADER !== f.n * 2) throw new Error("样本数与负载不符 n=" + f.n + " bytes=" + (buf.byteLength - HEADER));
    f.pcm = new Int16Array(buf, HEADER, f.n);
    return f;
  }

  class FrameChecker {
    constructor(turn, sr) {
      this.turn = turn; this.sr = sr; this.expected = 0; this.count = 0; this.samples = 0; this.ended = false;
      this.stat = { dup: 0, gap: 0, foreign: 0, sr: 0, bad: 0, missing: 0 };
    }
    accept(buf) {                                    // 返回 {action: ok|dup|gap|foreign|sr|bad, frame?, msg?}
      let f;
      try { f = parseFrame(buf); } catch (e) { this.stat.bad++; return { action: "bad", msg: String(e.message) }; }
      if (f.turn !== this.turn) { this.stat.foreign++; return { action: "foreign", msg: "turn " + f.turn + " != " + this.turn }; }
      if (f.sr !== this.sr) { this.stat.sr++; return { action: "sr", msg: "sr " + f.sr + " != " + this.sr }; }
      if (f.seq < this.expected) { this.stat.dup++; return { action: "dup", msg: "seq " + f.seq + " < " + this.expected }; }
      if (f.seq > this.expected) { this.stat.gap++; this.stat.missing += f.seq - this.expected; return { action: "gap", msg: "seq " + f.seq + " > " + this.expected }; }
      this.expected++; this.count++; this.samples += f.n;
      if (f.flags & F_END) this.ended = true;
      return { action: "ok", frame: f };
    }
    verifyDone(frames, samples) {                    // 与 turn_done 对账
      return this.ended && this.count === frames && this.samples === samples && !this.stat.gap && !this.stat.dup;
    }
  }

  function percentile(xs, q) {
    if (!xs || !xs.length) return null;
    const a = Array.from(xs).sort((x, y) => x - y), k = (a.length - 1) * q / 100, lo = Math.floor(k), hi = Math.ceil(k);
    return a[lo] + (a[hi] - a[lo]) * (k - lo);
  }

  function summarize(xs) {
    if (!xs || !xs.length) return null;
    return { n: xs.length, p50: percentile(xs, 50), p95: percentile(xs, 95), p99: percentile(xs, 99), max: Math.max.apply(null, xs) };
  }

  // 起播水位 = max(下限, 网关按各 GPU 实测模拟出的需求) + 网络抖动余量 + 自适应余量(最近几轮起播后的最低水位太低就加大)
  function computeStartMs(o) {
    const rtts = o.rtts || [], p50 = percentile(rtts, 50) || 0, p95 = percentile(rtts, 95) || 0;
    const jitter = Math.max(0, p95 - p50) * 2;
    const hist = (o.minLevels || []).slice(-5);
    let adapt = 0;
    if (hist.length) { const worst = Math.min.apply(null, hist); if (worst < 120) adapt = Math.min(3000, (120 - worst) * 4 + 150); }
    if (o.mode !== "continuous") adapt *= 0.5;
    const base = Math.max(o.floorMs || 0, o.serverMs || 0);
    const ms = Math.min(60000, Math.round(base + jitter + adapt));
    return { ms, parts: { server: Math.round(o.serverMs || 0), floor: Math.round(o.floorMs || 0), jitter: Math.round(jitter), adapt: Math.round(adapt) } };
  }

  const api = { HEADER, F_END, F_SEG, F_PAUSE, parseFrame, FrameChecker, percentile, summarize, computeStartMs };
  if (typeof module !== "undefined" && module.exports) module.exports = api;
  root.VC = api;
})(typeof window !== "undefined" ? window : globalThis);
