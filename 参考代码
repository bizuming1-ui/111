class ActionError(Exception):
    def __init__(self, msg, fatal=False):
        super().__init__(msg)
        self.fatal = fatal


class NeedHuman(Exception):
    pass


class Sub:
    def __init__(self):
        self.q = deque(maxlen=400)
        self.frame = None
        self.evt = asyncio.Event()

    def push(self, obj):
        self.q.append(obj)
        self.evt.set()

    def push_frame(self, b):
        self.frame = b
        self.evt.set()


class BSession:
    def __init__(self, mgr, sid):
        self.mgr, self.sid = mgr, sid
        self.ctx = None
        self.pages = []
        self.page = None
        self.log = deque(maxlen=300)
        self.seq = 0
        self.status, self.msg = "idle", ""
        self.cursor = None
        self.typing = None
        self.pending = None
        self.task = None
        self.task_title = ""
        self.cancel_flag = False
        self.pause_ev = asyncio.Event()
        self.pause_ev.set()
        self.subs = set()
        self.stream_task = None
        self.last_hash = None
        self.bytes_sent = 0
        self.frames = 0
        self.last_results = []
        self.last_query = None
        self.search_page = 0
        self.observation = None
        self.blocked = 0
        self.last_used = time.time()
        self.steps_done = 0

    # —— 事件 ——
    def emit(self, obj):
        for s in list(self.subs):
            s.push(obj)

    def add_log(self, kind, msg, **kw):
        self.seq += 1
        e = {"seq": self.seq, "t": now_iso(), "kind": kind, "msg": msg[:300]}
        e.update(kw)
        self.log.append(e)
        self.emit({"type": "log", "entry": e})
        return e

    def set_status(self, st, msg=""):
        self.status, self.msg = st, msg
        self.emit({"type": "status", **self.public()})

    def public(self):
        pg = self.page
        return {"status": self.status, "msg": self.msg, "task": self.task_title, "url": (pg.url if pg and not pg.is_closed() else ""), "pages": len(self.pages), "steps": self.steps_done,
                "pending": ({k: v for k, v in self.pending.items() if k != "fut"} if self.pending else None), "cursor": self.cursor, "view": {"w": VIEW[0], "h": VIEW[1]},
                "frames": self.frames, "bytes_sent": self.bytes_sent, "blocked_requests": self.blocked}

    # —— 浏览器上下文 ——
    async def ensure(self):
        self.last_used = time.time()
        if self.ctx is not None and self.page is not None and not self.page.is_closed():
            return
        br = await self.mgr.browser()
        if self.ctx is None:
            self.ctx = await br.new_context(viewport={"width": VIEW[0], "height": VIEW[1]}, accept_downloads=False, java_script_enabled=True, permissions=[], service_workers="block",
                                            locale="zh-CN", ignore_https_errors=False)
            self.ctx.set_default_timeout(STEP_TIMEOUT_S * 1000)
            await self.ctx.route("**/*", self._guard)
            if hasattr(self.ctx, "route_web_socket"):
                try:
                    await self.ctx.route_web_socket("**/*", self._guard_ws)
                except Exception:  # noqa: BLE001
                    pass
            self.ctx.on("page", self._on_page)
        if not self.pages or self.page is None or self.page.is_closed():
            p = await self.ctx.new_page()
            self._adopt(p)
        self.add_log("system", "隔离浏览器会话已就绪(独立 Cookie/存储,关闭后清除)")

    def _adopt(self, p):
        if p not in self.pages:
            self.pages.append(p)
        self.page = p
        p.on("dialog", lambda d: asyncio.ensure_future(self._dialog(d)))
        p.on("close", lambda *_: self._on_close(p))

    async def _dialog(self, d):
        self.add_log("blocked", "已自动关闭网页弹窗(%s)" % d.type)
        try:
            await d.dismiss()
        except Exception:  # noqa: BLE001
            pass

    def _on_close(self, p):
        if p in self.pages:
            self.pages.remove(p)
        if self.page is p:
            self.page = self.pages[-1] if self.pages else None

    def _on_page(self, p):
        if len(self.pages) >= MAX_PAGES:
            self.add_log("blocked", "页面数已达上限 %d,已关闭新弹出的页面" % MAX_PAGES)
            asyncio.ensure_future(p.close())
            return
        self._adopt(p)
        self.add_log("system", "网页打开了新标签页,已切换到它")

    async def _guard(self, route, request):
        url = request.url
        sch = urlsplit(url).scheme
        if sch in ("data", "blob", "about"):
            return await route.continue_()
        try:
            await netguard.acheck_url(url)
        except netguard.Blocked as e:
            self.blocked += 1
            if request.is_navigation_request():
                self.add_log("blocked", "已阻止导航:%s(%s)" % (netguard.safe_url_for_log(url), e))
            try:
                await route.abort("blockedbyclient")
            except Exception:  # noqa: BLE001
                pass
            return
        try:
            await route.continue_()
        except Exception:  # noqa: BLE001
            pass

    async def _guard_ws(self, ws):
        try:
            await netguard.acheck_url(ws.url.replace("ws://", "http://", 1).replace("wss://", "https://", 1))
            ws.connect_to_server()
        except netguard.Blocked:
            self.blocked += 1
            await ws.close(code=1008, reason="blocked")

    async def close(self):
        self.cancel_flag = True
        if self.pending and not self.pending["fut"].done():
            self.pending["fut"].set_result(False)
        if self.task and not self.task.done():
            self.task.cancel()
        if self.stream_task:
            self.stream_task.cancel()
        try:
            if self.ctx:
                await self.ctx.close()
        except Exception:  # noqa: BLE001
            pass
        self.ctx, self.pages, self.page = None, [], None
        self.add_log("system", "浏览器会话已关闭,Cookie/登录状态已清除")
        self.set_status("idle", "已关闭")

    # —— 画面流 ——
    def subscribe(self):
        s = Sub()
        self.subs.add(s)
        s.push({"type": "hello", **self.public(), "log": list(self.log)[-80:]})
        if self.stream_task is None or self.stream_task.done():
            self.stream_task = asyncio.ensure_future(self._stream())
        return s

    def unsubscribe(self, s):
        self.subs.discard(s)

    async def _stream(self):
        while self.subs:
            busy = bool(self.mgr.tts_busy())
            await asyncio.sleep(1.0 / (FPS_BUSY if busy else FPS))
            pg = self.page
            if pg is None or pg.is_closed():
                continue
            try:
                b = await pg.screenshot(type="jpeg", quality=JPEG_Q, timeout=4000)
            except Exception:  # noqa: BLE001
                continue
            h = hashlib.md5(b).hexdigest()
            if h == self.last_hash:
                continue
            self.last_hash = h
            self.frames += 1
            self.bytes_sent += len(b) * len(self.subs)
            for s in list(self.subs):
                s.push_frame(b)
            self.emit({"type": "meta", "url": pg.url, "frames": self.frames, "bytes_sent": self.bytes_sent})

    # —— 控制 ——
    def pause(self):
        if self.status in ("running", "waiting_confirm"):
            self.pause_ev.clear()
            self.set_status("paused", "已暂停(可点继续,或人工接管)")
            self.add_log("control", "用户暂停")

    def resume(self):
        self.pause_ev.set()
        if self.status in ("paused", "waiting_human"):
            self.set_status("running" if self.task and not self.task.done() else "idle", "")
            self.add_log("control", "用户继续")

    def cancel(self):
        self.cancel_flag = True
        self.pause_ev.set()
        if self.pending and not self.pending["fut"].done():
            self.pending["fut"].set_result(False)
        if self.task and not self.task.done():
            self.task.cancel()
        self.add_log("control", "用户取消任务")
        self.set_status("cancelled", "已取消")

    def answer_confirm(self, cid, approve):
        if not self.pending or self.pending["id"] != cid:
            raise ActionError("没有等待中的确认(可能已超时)")
        if not self.pending["fut"].done():
            self.pending["fut"].set_result(bool(approve))
        return True

    async def _gate(self):
        if self.cancel_flag:
            raise asyncio.CancelledError()
        await self.pause_ev.wait()
        if self.cancel_flag:
            raise asyncio.CancelledError()

    async def _confirm(self, action, site, summary, consequence):
        cid = "c" + hashlib.md5(("%s%s" % (time.time(), summary)).encode()).hexdigest()[:8]
        fut = asyncio.get_running_loop().create_future()
        self.pending = {"id": cid, "action": action, "site": site, "summary": summary[:300], "consequence": consequence, "fut": fut, "created": now_iso()}
        self.set_status("waiting_confirm", "等待你确认:" + summary[:80])
        self.add_log("confirm", "需要确认 → %s | 网站 %s | %s" % (action, site, summary[:120]))
        self.emit({"type": "confirm", **{k: v for k, v in self.pending.items() if k != "fut"}})
        try:
            ok = await asyncio.wait_for(fut, CONFIRM_TIMEOUT_S)
        except asyncio.TimeoutError:
            ok = False
        self.pending = None
        self.add_log("confirm", "用户%s" % ("已确认,继续执行" if ok else "拒绝/超时,未执行"))
        if ok:
            self.set_status("running", "")
        return ok

    # —— 页面辅助 ——
    async def _settle(self):
        try:
            await self.page.wait_for_load_state("domcontentloaded", timeout=6000)
        except Exception:  # noqa: BLE001
            pass
        await asyncio.sleep(0.5)

    async def _snapshot_state(self):
        pg = self.page
        try:
            h = await pg.evaluate("() => (document.body ? document.body.innerText.length : 0) + ':' + Math.round(window.scrollY)")
        except Exception:  # noqa: BLE001
            h = "?"
        return {"url": pg.url, "title": (await pg.title())[:100] if not pg.is_closed() else "", "sig": h}

    async def _check_blockers(self):
        """验证码/反机器人/登录墙 → 暂停交给用户,绝不尝试绕过"""
        try:
            r = await self.page.evaluate(BLOCKER_JS)
        except Exception:  # noqa: BLE001
            return
        host = urlsplit(r["url"]).hostname or ""
        if r["frame"] or BLOCKER_RE.search(r["text"]) or "consent.google" in host or "/sorry/" in r["url"]:
            self.add_log("blocked", "页面需要人工处理(验证码/同意页/反机器人检测):%s。本系统不会绕过,请点「人工接管」自己完成后再继续。" % host)
            raise NeedHuman("页面出现验证/同意/反机器人检测(%s),需要你亲自处理" % host)

    async def _mouse_to(self, x, y, kind="move"):
        await self.page.mouse.move(x, y, steps=14)
        self.cursor = {"x": round(x), "y": round(y), "kind": kind, "t": time.time()}
        self.emit({"type": "cursor", **self.cursor, "vw": VIEW[0], "vh": VIEW[1]})

    def _loc(self, spec):
        pg = self.page
        by, val = spec.get("by", "text"), spec["value"]
        if by == "role":
            return pg.get_by_role(spec.get("role") or "button", name=val)
        if by == "label":
            return pg.get_by_label(val)
        if by == "placeholder":
            return pg.get_by_placeholder(val)
        return pg.get_by_text(val, exact=False)

    async def _resolve(self, spec):
        """定位必须唯一;不唯一/找不到 → 暂停并解释(不盲点)。优先 角色/标签 语义,再退到文本。"""
        loc = self._loc(spec)
        try:
            n = await loc.count()
        except Exception as e:  # noqa: BLE001
            raise ActionError("定位失败:%s" % str(e)[:80])
        if n == 0 and spec.get("by") == "text":
            for role in ("button", "link"):
                alt = self.page.get_by_role(role, name=spec["value"])
                if await alt.count():
                    loc, n = alt, await alt.count()
                    break
        if n == 0:
            raise ActionError("页面上找不到「%s」(页面结构可能已变化)" % spec["value"][:40])
        if spec.get("nth") is not None:
            if spec["nth"] >= n:
                raise ActionError("「%s」只有 %d 个匹配,没有第 %d 个" % (spec["value"][:30], n, spec["nth"] + 1))
            return loc.nth(spec["nth"])
        vis = []
        for i in range(min(n, 8)):
            try:
                if await loc.nth(i).is_visible():
                    vis.append(i)
            except Exception:  # noqa: BLE001
                pass
        if len(vis) == 1:
            return loc.nth(vis[0])
        if len(vis) == 0:
            raise ActionError("「%s」存在但不可见" % spec["value"][:40])
        raise ActionError("「%s」匹配到 %d 个可见元素,定位不唯一,已暂停(可在指令里说“第N个”,或人工接管点击)" % (spec["value"][:30], len(vis)))

    async def _describe(self, loc):
        return await loc.evaluate("""el => { const f=el.form||el.closest('form'); const t=(el.innerText||el.value||el.getAttribute('aria-label')||el.title||'').trim().slice(0,100);
          const sr = !!(f && (f.getAttribute('role')==='search' || f.querySelector('input[type=search],input[name=q],input[name=query],input[name=wd],input[name=s]')));
          return {tag:el.tagName.toLowerCase(), type:(el.type||'').toLowerCase(), text:t, name:(el.name||'')+' '+(el.id||'')+' '+(el.autocomplete||'')+' '+(el.getAttribute('aria-label')||'')+' '+(el.placeholder||''),
                  inForm:!!f, method:f?(f.method||'get').toLowerCase():'', action:f?(f.action||''):'', searchForm:sr, download:el.hasAttribute('download'),
                  hasPw:!!(f && f.querySelector('input[type=password]')), contentEditable:!!el.isContentEditable, role:el.getAttribute('role')||''}; }""")

    def _click_risk(self, d, host):
        reasons = []
        if d["type"] == "file":
            return "block", ["文件上传需要你亲自选择文件(已禁止自动上传)"]
        if d["download"]:
            reasons.append("会下载文件(下载已被禁用)")
        sub = d["inForm"] and d["tag"] in ("button", "input") and d["type"] in ("submit", "image", "")
        if sub and not d["searchForm"]:
            reasons.append("会提交表单 → %s" % (urlsplit(d["action"]).netloc or host))
        is_field = d["tag"] in ("textarea", "select") or (d["tag"] == "input" and d["type"] not in ("submit", "image", "button", "reset"))
        if d["hasPw"] and d["inForm"] and not is_field:
            reasons.append("这是含密码输入框的登录/注册表单")
        if not is_field and RISK_RE.search(d["text"] or ""):
            reasons.append("按钮/链接文字含高影响词「%s」" % d["text"][:30])
        return ("confirm" if reasons else "ok"), reasons

    # —— 动作 ——
    async def do(self, a):
        k = a["action"]
        pg = self.page
        before = await self._snapshot_state()
        host = urlsplit(pg.url).hostname or "(空白页)"
        if k == "goto":
            try:
                url = await netguard.acheck_url(netguard.normalize_user_target(a["url"]))
            except netguard.Blocked as e:
                self.blocked += 1
                raise ActionError("安全策略拒绝访问:%s" % e, fatal=True)
            self.add_log("action", "打开 %s" % netguard.safe_url_for_log(url), action=k)
            b0, pb0 = self.blocked, self.mgr.proxy_blocked()
            try:
                await pg.goto(url, wait_until="domcontentloaded", timeout=20000)
            except Exception as e:  # noqa: BLE001
                if "blockedbyclient" in str(e) or "ERR_BLOCKED" in str(e):
                    raise ActionError("导航被安全策略阻止(重定向到了不允许的地址)", fatal=True)
                raise ActionError("打开失败:%s" % str(e).splitlines()[0][:100])
            await self._settle()
            hit = self.blocked > b0 or self.mgr.proxy_blocked() > pb0
            if hit or pg.url.startswith(("chrome-error:", "about:neterror")):
                if hit:
                    self.blocked += 1
                    self.add_log("blocked", "网络护栏拦截:%s" % (self.mgr.proxy.events[-1]["reason"] if self.mgr.proxy and self.mgr.proxy.events else "目标不被允许"))
                raise ActionError("导航被安全策略阻止(目标或重定向指向不允许的地址)" if hit else "页面加载失败(网络错误)", fatal=hit)
            await self._check_blockers()
            st = await self._snapshot_state()
            self.add_log("verify", "已到达 %s · 标题「%s」" % (netguard.safe_url_for_log(st["url"]), st["title"]), ok=True)
        elif k in ("back", "forward", "reload"):
            self.add_log("action", {"back": "返回", "forward": "前进", "reload": "刷新"}[k], action=k)
            try:
                await {"back": pg.go_back, "forward": pg.go_forward, "reload": pg.reload}[k](wait_until="domcontentloaded", timeout=15000)
            except Exception as e:  # noqa: BLE001
                raise ActionError("%s失败:%s" % (k, str(e)[:80]))
            await self._settle()
            await self._check_blockers()
            st = await self._snapshot_state()
            self.add_log("verify", "当前 %s · 「%s」" % (netguard.safe_url_for_log(st["url"]), st["title"]), ok=True)
        elif k == "search":
            await self._search(a)
        elif k == "search_more":
            if not self.last_query:
                raise ActionError("还没有进行过搜索,无法“再搜几个来源”")
            q = dict(self.last_query)
            q["page"] = self.search_page + 1
            await self._search(q, direct=True)
        elif k == "open_result":
            if not self.last_results:
                raise ActionError("没有搜索结果可打开(请先搜索)")
            if a["n"] > len(self.last_results):
                raise ActionError("只有 %d 条结果,没有第 %d 条" % (len(self.last_results), a["n"]))
            r = self.last_results[a["n"] - 1]
            self.add_log("action", "打开搜索结果 #%d(来源 %s)" % (a["n"], r["domain"]), action=k)
            await self.do({"action": "goto", "url": r["url"]})
        elif k == "scroll":
            await self._mouse_to(VIEW[0] / 2, VIEW[1] / 2, "scroll")
            y0 = await pg.evaluate("window.scrollY")
            if a["direction"] == "top":
                await pg.evaluate("window.scrollTo(0,0)")
            elif a["direction"] == "bottom":
                await pg.evaluate("window.scrollTo(0,document.body.scrollHeight)")
            else:
                await pg.mouse.wheel(0, a["amount"] * (1 if a["direction"] == "down" else -1))
            await asyncio.sleep(0.5)
            y1 = await pg.evaluate("window.scrollY")
            self.add_log("action", "滚动 %s" % {"up": "向上", "down": "向下", "top": "到顶部", "bottom": "到底部"}[a["direction"]], action=k)
            self.add_log("verify", "滚动位置 %d → %d%s" % (y0, y1, "" if y1 != y0 else "(没有变化:已到页面边界)"), ok=True)
        elif k == "click":
            loc = await self._resolve(a)
            await self._click_loc(loc, host, "点击「%s」" % a["value"][:30])
        elif k == "type":
            if a.get("into"):
                loc = await self._resolve(a["into"])
                await self._click_loc(loc, host, "聚焦输入框「%s」" % a["into"]["value"][:30], typing=True)
            await self._type(a["text"], host)
            if a.get("submit"):
                await self.do({"action": "key", "key": "Enter"})
        elif k == "key":
            d = await pg.evaluate("""() => { const el=document.activeElement; if(!el) return null; const f=el.closest&&el.closest('form');
              const sr=!!(f&&(f.getAttribute('role')==='search'||f.querySelector('input[type=search],input[name=q],input[name=query],input[name=wd],input[name=s]')));
              return {tag:el.tagName.toLowerCase(), type:(el.type||'').toLowerCase(), inForm:!!f, searchForm:sr, ce:!!el.isContentEditable, hasPw:!!(f&&f.querySelector('input[type=password]')), action:f?f.action:''}; }""")
            if a["key"] == "Enter" and d and ((d["inForm"] and not d["searchForm"]) or d["ce"] or d["hasPw"]):
                ok = await self._confirm("按 Enter", host, "在 %s 的%s里按 Enter,可能会提交表单/发送消息" % (host, "编辑区" if d["ce"] else "表单输入框"),
                                         "提交后内容会发送到 %s;这可能无法撤销" % (urlsplit(d["action"]).netloc or host))
                if not ok:
                    raise ActionError("你拒绝了该操作,未执行", fatal=True)
            self.add_log("action", "按键 %s" % a["key"], action=k)
            await pg.keyboard.press(a["key"])
            await self._settle()
            await self._check_blockers()
            st = await self._snapshot_state()
            self.add_log("verify", "按键后页面:%s%s" % (netguard.safe_url_for_log(st["url"]), "(已跳转)" if st["url"] != before["url"] else ""), ok=True)
        elif k == "read":
            txt = await pg.evaluate("() => (document.body ? document.body.innerText : '').replace(/\\n{3,}/g,'\\n\\n').slice(0, 8000)")
            st = await self._snapshot_state()
            self.observation = {"url": st["url"], "title": st["title"], "text": txt, "read_at": now_iso(), "untrusted": True}
            self.add_log("action", "读取页面文字 %d 字符(作为不可信数据,不会被当作指令)" % len(txt), action=k)
            self.add_log("verify", "已读取「%s」" % st["title"], ok=bool(txt.strip()))
        elif k == "snapshot":
            st = await self._snapshot_state()
            self.add_log("action", "查看页面", action=k)
            self.add_log("verify", "当前页面 %s · 「%s」" % (netguard.safe_url_for_log(st["url"]), st["title"]), ok=True)
        elif k == "wait":
            await asyncio.sleep(a["seconds"])

    async def _click_loc(self, loc, host, label, typing=False):
        d = await self._describe(loc)
        lvl, reasons = self._click_risk(d, host)
        if lvl == "block":
            raise ActionError("; ".join(reasons), fatal=True)
        if lvl == "confirm":
            ok = await self._confirm(label, host, "%s(元素:%s「%s」)" % (label, d["tag"], d["text"][:40]), "可能产生外部影响:" + ";".join(reasons) + "。目标网站:" + host)
            if not ok:
                raise ActionError("你拒绝了该操作,未执行", fatal=True)
        await loc.scroll_into_view_if_needed(timeout=5000)
        bb = await loc.bounding_box()
        if not bb:
            raise ActionError("元素没有可点击区域")
        x, y = bb["x"] + bb["width"] / 2, bb["y"] + bb["height"] / 2
        await self._mouse_to(x, y, "move")
        before = await self._snapshot_state()
        self.add_log("action", "%s @(%d,%d)" % (label, x, y), action="click", x=round(x), y=round(y))
        await self.page.mouse.click(x, y)
        self.cursor = {"x": round(x), "y": round(y), "kind": "click", "t": time.time()}
        self.emit({"type": "cursor", **self.cursor, "vw": VIEW[0], "vh": VIEW[1]})
        await self._settle()
        await self._check_blockers()
        after = await self._snapshot_state()
        changed = after["url"] != before["url"] or after["sig"] != before["sig"]
        if typing:
            focused = await self.page.evaluate("() => { const e=document.activeElement; return e ? e.tagName.toLowerCase() : '' }")
            ok = focused in ("input", "textarea") or await self.page.evaluate("() => !!(document.activeElement && document.activeElement.isContentEditable)")
            self.add_log("verify", "输入框已聚焦" if ok else "点击后焦点不在输入框上", ok=ok)
            if not ok:
                raise ActionError("点击后焦点不在输入框上,已暂停")
        else:
            self.add_log("verify", "点击后页面%s:%s" % ("发生变化" if changed else "没有明显变化", netguard.safe_url_for_log(after["url"])), ok=True, changed=changed)

    async def _type(self, text, host):
