/* ═════════ 全局状态 ═════════ */
const S = {
  ws: null, wsOk: false, state: null, uid: null, turnDone: true, t0: 0, firstMs: null, underruns: 0, minRho: 1, llmMs: null,
  startMs: ls.get("startMs", Math.round(START_THRESHOLD_BYTES / 48)), opts: { auto: ls.get("auto", true), smooth: ls.get("smooth", true), filler: ls.get("filler", false), long: ls.get("long", false), breath: ls.get("breath", 1) },
