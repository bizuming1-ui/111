  每条记录只含:UTC 时间 · 事件类型 · 任务状态 · 耗时 · 错误类别 · 匿名会话 ID · 必要的模型/GPU 指标。
  默认【不】保存:麦克风音频、网页内容、完整搜索词、URL 查询参数、密码、Cookie、转写、文件名。
  所有字段都过白名单;字符串过长/疑似密钥会被丢弃;写盘前再做一次敏感信息扫描。
"""
import json
import os
import re
import threading
import time
from collections import Counter
from pathlib import Path

ALLOWED_KEYS = {"gpu", "gpu_mem_mb", "gpu_util", "queue", "n", "bytes", "count", "provider", "mode", "action", "http", "steps", "fps", "reason_code", "workers",
                "samples", "seconds", "kind", "model", "ok", "domain", "q_len", "results", "cpu", "mem_mb", "frames"}
SECRET_PATTERNS = [
    r"ghp_[A-Za-z0-9]{20,}", r"github_pat_[A-Za-z0-9_]{20,}", r"gh[ousr]_[A-Za-z0-9]{20,}", r"hf_[A-Za-z0-9]{20,}", r"sk-[A-Za-z0-9]{16,}",
    r"AKIA[0-9A-Z]{16}", r"AIza[0-9A-Za-z_\-]{30,}", r"xox[baprs]-[A-Za-z0-9-]{10,}", r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"(authorization|bearer)\s*[:=]\s*[A-Za-z0-9._\-]{16,}", r"\b(api[_-]?key|token|secret|password|passwd|cookie)\b\s*[:=]\s*['\"]?[A-Za-z0-9._\-/+]{12,}",
    r"\b2[A-Za-z0-9]{26,}_[A-Za-z0-9]{20,}\b",                       # ngrok authtoken 形态
]
_SECRET_RE = re.compile("|".join("(?:%s)" % p for p in SECRET_PATTERNS), re.I)
FORBIDDEN_EXT = {".wav", ".mp3", ".flac", ".m4a", ".ogg", ".webm", ".aac", ".opus", ".safetensors", ".pt", ".pth", ".bin", ".ckpt", ".npy", ".npz", ".onnx",
                 ".png", ".jpg", ".jpeg", ".gif", ".zip", ".tar", ".gz", ".enc", ".sqlite", ".db", ".pem", ".key"}


def find_secrets(text):
    """返回命中的敏感片段类型(不返回内容本身)"""
    return ["secret_pattern"] if _SECRET_RE.search(text or "") else []


def clean_value(v):
    if isinstance(v, bool) or v is None:
        return v
    if isinstance(v, (int, float)):
        return round(float(v), 3) if isinstance(v, float) else v
    if isinstance(v, str):
        if len(v) > 64 or find_secrets(v) or "?" in v and "=" in v:
            return "[dropped]"
        return v
    if isinstance(v, (list, tuple)) and len(v) <= 8:
        return [clean_value(x) for x in v]
    return "[dropped]"


class Audit:
    def __init__(self, root, auth=None):
        self.root = Path(root)
        self.root.mkdir(parents=True, exist_ok=True)
        self.file = self.root / "audit.jsonl"
        self.auth = auth
        self.lock = threading.Lock()
        self.synced_upto = self._read_cursor()

    def _read_cursor(self):
        try:
            return int((self.root / "synced.cursor").read_text())
        except Exception:  # noqa: BLE001
            return 0

    def event(self, etype, status="ok", dur_ms=None, err=None, sid="", **metrics):
        rec = {"t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "type": str(etype)[:40], "status": str(status)[:20]}
        if dur_ms is not None:
            rec["dur_ms"] = int(dur_ms)
        if err:
            rec["err"] = (err if isinstance(err, str) and len(err) <= 40 and re.fullmatch(r"[A-Za-z0-9_.:-]+", err) else type(err).__name__ if not isinstance(err, str) else "error")
        if sid:
            rec["sid"] = self.auth.anon(sid) if self.auth else "anon"
        for k, v in metrics.items():
            if k in ALLOWED_KEYS:
                rec[k] = clean_value(v)
        line = json.dumps(rec, ensure_ascii=False, separators=(",", ":"))
        if find_secrets(line):
            return None
        with self.lock:
            with open(self.file, "a", encoding="utf-8") as f:
                f.write(line + "\n")
        return rec

    def lines(self):
        try:
            return self.file.read_text(encoding="utf-8").splitlines()
        except FileNotFoundError:
            return []

    def pending(self):
        return self.lines()[self.synced_upto:]

    def mark_synced(self, n_total):
        self.synced_upto = n_total
        (self.root / "synced.cursor").write_text(str(n_total))

    def summary(self):
        recs = []
        for ln in self.lines()[-5000:]:
            try:
                recs.append(json.loads(ln))
            except ValueError:
                pass
        c = Counter((r.get("type"), r.get("status")) for r in recs)
        d = {}
        for r in recs:
            if "dur_ms" in r:
                d.setdefault(r["type"], []).append(r["dur_ms"])

        def pct(xs, q):
            xs = sorted(xs)
            return xs[min(len(xs) - 1, int(q * len(xs)))] if xs else None
        return {"generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "events": len(recs),
                "by_type_status": {"%s/%s" % k: v for k, v in sorted(c.items(), key=lambda kv: str(kv[0]))},
                "duration_ms": {k: {"n": len(v), "p50": pct(v, .5), "p95": pct(v, .95)} for k, v in d.items()},
                "note": "脱敏汇总:不含搜索词、网页内容、音频、转写、Cookie 或 Token"}

    def public_files(self, max_lines=2000):
        """可同步到公开仓库的文件(路径 → 内容)。只有脱敏审计与汇总。"""
        pend = self.pending()[:max_lines]
        files = {}
        if pend:
            day = time.strftime("%Y%m%d", time.gmtime())
            files["telemetry/audit-%s-%d.jsonl" % (day, self.synced_upto + 1)] = "\n".join(pend) + "\n"
        files["telemetry/summary.json"] = json.dumps(self.summary(), ensure_ascii=False, indent=1, sort_keys=True) + "\n"
        return files, self.synced_upto + len(pend)
'''

