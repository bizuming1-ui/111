def free_port():
    s = socket.socket(); s.bind(("127.0.0.1", 0)); p = s.getsockname()[1]; s.close(); return p


def wav_bytes(x, sr=SR):
    bio = io.BytesIO()
    with wave.open(bio, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(sr); w.writeframes((x * 32767).astype("<i2").tobytes())
    return bio.getvalue()


class Server:
    def __init__(self, **env):
        self.port = free_port()
        self.tmp = tempfile.mkdtemp()
        e = dict(os.environ, VC_MOCK="1", VC_MOCK_LLM="1", VC_PORT=str(self.port), VC_WORK=self.tmp, PYTHONPATH=str(HERE), PYTHONUNBUFFERED="1", VC_SEND_AHEAD_MS="2500",
                 VC_EVAL_LOG=self.tmp + "/e.jsonl", VC_TRAIN_STATE=self.tmp + "/t.json", VC_REPORT_DIR=self.tmp + "/rep", VC_DIAG_DIR=self.tmp + "/diag",
                 VC_MOCK_FAIL="nan", VC_MOCK_FRAME_MS="20", VC_MOCK_DEC_MS="5", VC_MOCK_PREFILL_MS="100")
        e.update({k: str(v) for k, v in env.items()})
        self.p = subprocess.Popen([sys.executable, str(HERE / "app.py")], env=e, cwd=str(HERE), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        t0 = time.time()
        while time.time() - t0 < 40:
            try:
                h = json.load(urllib.request.urlopen(self.url("/health"), timeout=2))
                if h["workers"] and all(w["status"] == "ready" for w in h["workers"]):
                    return
            except Exception:
                pass
            if self.p.poll() is not None:
                raise RuntimeError("server exited:\n" + self.p.stdout.read())
            time.sleep(0.3)
        raise RuntimeError("server start timeout")

    def url(self, p):
        return "http://127.0.0.1:%d%s" % (self.port, p)

    def post(self, path, data, ctype="application/octet-stream"):
        req = urllib.request.Request(self.url(path), data=data, method="POST", headers={"Content-Type": ctype})
        return json.load(urllib.request.urlopen(req, timeout=60))

    def state(self):
        return json.load(urllib.request.urlopen(self.url("/api/state"), timeout=5))

    def clone(self):
        wavb = wav_bytes(speechlike(10.0))
        r = self.post("/api/voice?consent=1&text=" + urllib.request.quote("今天天气真好我们一起出去走走吧") + "&ext=wav", wavb)
        assert r.get("ok"), r
        for _ in range(100):
            if self.state()["voice"]["state"] == "ready":
                return r
            time.sleep(0.3)
        raise RuntimeError("clone timeout: %s" % self.state()["voice"])

    def stop(self):
        self.p.terminate()
        try:
            self.p.wait(10)
        except Exception:
            self.p.kill()


async def run_turn(port, text, sid="s1", ack_every=0.25, ack=True, drop_after=None, window_probe=None, kind="say"):
    t_begin = time.time()
    import websockets
    url = "ws://127.0.0.1:%d/ws" % port
    ws = await websockets.connect(url, max_size=None)
    await ws.send(json.dumps({"type": "hello", "sid": sid}))
    chk, msgs, played, recv_samples, t_start = None, [], 0, 0, None
    uid, done, reconnects = None, None, 0
    max_ahead = 0.0
    await ws.send(json.dumps({"type": kind, "text": text, "opts": {"tts": True}}))
    t_last_ack, ended_at = time.time(), None
    while True:
        try:
            m = await asyncio.wait_for(ws.recv(), 20 if ack else window_probe or 20)
        except asyncio.TimeoutError:
            break
        now = time.time()
        if window_probe and now - t_begin > window_probe:
            break
        if isinstance(m, (bytes, bytearray)):
            if chk is None:
                continue
            act, f = chk.accept(bytes(m))
            assert act == "ok", (act, f)
            recv_samples += f["n"]
            if t_start is None and recv_samples > 0:
                t_start = now
            if t_start is not None and ack:
                played = min(recv_samples, int((now - t_start) * SR))
            max_ahead = max(max_ahead, (recv_samples - played) / SR * 1000)
            if drop_after is not None and chk.count >= drop_after and reconnects == 0:
                await ws.close()
                ws = await websockets.connect(url, max_size=None)
                await ws.send(json.dumps({"type": "hello", "sid": sid, "resume": {"turn": uid, "next_seq": chk.expected}}))
                reconnects += 1
        else:
            j = json.loads(m)
            msgs.append(j)
            if j["type"] == "turn_start":
                uid = j["turn"]; chk = pr.FrameChecker(uid, SR)
            if j["type"] == "turn_done":
                done = j
        if ack and uid is not None and now - t_last_ack >= ack_every:
            if t_start is not None:
                played = min(recv_samples, int((now - t_start) * SR))
            await ws.send(json.dumps({"type": "ack", "turn": uid, "next_seq": chk.expected if chk else 0, "played": played, "level_ms": 0}))
            t_last_ack = now
        if done is not None and chk and chk.ended:
            break
    await ws.close()
    return {"chk": chk, "msgs": msgs, "done": done, "uid": uid, "recv_ms": recv_samples / SR * 1000, "max_ahead_ms": max_ahead, "reconnects": reconnects}


