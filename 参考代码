def _free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    p = s.getsockname()[1]
    s.close()
    return p


def _http(srv, method, path, body=None, headers=None, cookie=None, timeout=60):
    h = dict(headers or {})
    if cookie:
        h["Cookie"] = cookie
    data = body if isinstance(body, (bytes, type(None))) else json.dumps(body).encode()
    if isinstance(body, dict):
        h.setdefault("Content-Type", "application/json")

    class NoRedir(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *a, **k):
            return None
    op = urllib.request.build_opener(NoRedir)
    req = urllib.request.Request(srv.url(path), data=data, method=method, headers=h)
    try:
        r = op.open(req, timeout=timeout)
        raw, code, hd = r.read(), r.status, r.headers
    except urllib.error.HTTPError as e:
        raw, code, hd = e.read(), e.code, e.headers
    try:
        return code, json.loads(raw), hd
    except ValueError:
        return code, raw.decode("utf-8", "replace"), hd


