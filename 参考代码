                        "scaler": acc.scaler.state_dict() if acc.scaler is not None else None}, d / "state.pt")
            print("✔ 第 %d 轮完成 · 平均 loss %.4f · 用时 %.1f 分钟 → %s" % (epoch + 1, ep_loss, (time.time() - t_ep) / 60, d), flush=True)
