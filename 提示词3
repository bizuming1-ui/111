### 8.3 单测模板(示意,真实实现自己写)

```bash
python3 - <<'EOF'
import numpy as np, importlib, sys
sys.path.insert(0, '.')
import v16
# 1) 稳健质心:注入 1 个离群向量,质心不应被拉偏
rng = np.random.default_rng(0)
base = rng.normal(size=256); base /= np.linalg.norm(base)
good = [base + 0.3*rng.normal(size=256)/16 for _ in range(12)]
bad  = [rng.normal(size=256)]
c, info = v16.robust_centroid(good + bad)
cos = float(np.dot(c, base) / (np.linalg.norm(c)*np.linalg.norm(base)))
assert info['outliers'] == [12], info
assert cos > 0.98, cos
print('centroid ok', round(cos, 4))
EOF
```

