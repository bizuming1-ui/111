def _unpack():
    n = 0
    for rel, (h, data) in FILES.items():
        raw = zlib.decompress(base64.b64decode(data))
        if hashlib.sha256(raw).hexdigest()[:12] != h:
            raise SystemExit(f"✗ 粘贴内容损坏或被截断: {rel} —— 请重新完整复制整段代码")
        p = ROOT / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_bytes(raw)
        if rel.startswith("browser_portal/") and Path("/kaggle/working").exists():
            sub_rel = rel[len("browser_portal/"):]
            bp = Path("/kaggle/working") / sub_rel
            bp.parent.mkdir(parents=True, exist_ok=True)
            bp.write_bytes(raw)
        n += 1
    print(f"✓ 已写入 {n} 个文件 → {ROOT}")


