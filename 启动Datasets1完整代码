SEARCH_ROOTS = (
    "/kaggle/input/datasets1",
    "/kaggle/input/Datasets1",
    "/kaggle/input",
    "/app/kaggle_release",
    "/workspace/kaggle_release",
    str(Path.cwd() / "public" / "kaggle"),
)


def find_mounted_dataset_script() -> Path:
    custom = os.environ.get("VOXCPM_DATASET_SCRIPT", "").strip()
    if custom and Path(custom).is_file():
        return Path(custom).resolve()
    for root_str in SEARCH_ROOTS:
        root = Path(root_str)
        if not root.exists():
            continue
        for fname in CANDIDATE_FILENAMES:
            direct = root / fname
            if direct.is_file():
                return direct.resolve()
            for matched in sorted(root.rglob(fname)):
                if matched.is_file():
                    return matched.resolve()
        # Fallback: any .py > 5MB inside /kaggle/input/datasets1
        for py_file in sorted(root.rglob("*.py")):
            if py_file.is_file() and py_file.stat().st_size > 5_000_000:
                return py_file.resolve()
    raise FileNotFoundError(
        "未在 /kaggle/input/datasets1 或 /kaggle/input 中找到挂载的完整代码文件 (Datasets.py / 参考代码.py / kaggle_voxcpm2_v24_ultimate.py)。"
        "请先通过 Kaggle 右侧 Add Input -> Datasets 挂载名为 Datasets1 的数据集！"
    )


