        POINT a = new POINT(); GetCursorPos(out a);
        if (a.X != tx || a.Y != ty) {
            Fixups++; SetCursorPos(tx, ty); GetCursorPos(out a);
            if (a.X != tx || a.Y != ty) throw new InvalidOperationException("光标定位失败：目标 (" + tx + "," + ty + ")，实际 (" + a.X + "," + a.Y + ")，已取消点击。");
        }
        if (Follower != null) Follower.Follow(tx, ty);
    }
    // 真实光标沿人类轨迹移到 (tx,ty)；已在目标上则不动。用户中途动鼠标 / 急停键 → 抛异常中止（不会继续点击）
    public static void HumanMoveTo(int tx, int ty) {
        tx = ClampX(tx); ty = ClampY(ty);
        POINT cur = new POINT(); GetCursorPos(out cur);
        if (Follower != null) Follower.Follow(cur.X, cur.Y);
        double ddx = tx - cur.X, ddy = ty - cur.Y, d = Math.Sqrt(ddx * ddx + ddy * ddy);
        if (d < 1.0) { Settle(tx, ty); return; }
        if (!Humanize) { SetCursorPos(tx, ty); Settle(tx, ty); return; }
        bool tm = false; try { timeBeginPeriod(1); tm = true; } catch { }
        try {
            int dur = HumanDuration(d, TargetW);
            double[][] path = HumanPath(cur.X, cur.Y, tx, ty, dur, 8.0, Rnd(1, 2000000000), TargetW);
            Stopwatch sw = Stopwatch.StartNew();
            int lx = cur.X, ly = cur.Y, k = 0;
            foreach (double[] p in path) {
                int px = ClampX((int)Math.Round(p[1])), py = ClampY((int)Math.Round(p[2]));
                while (true) { double rem = p[0] - sw.Elapsed.TotalMilliseconds; if (rem <= 0) break; if (rem > 2.0) Thread.Sleep(1); else Thread.SpinWait(300); }
                POINT now = new POINT(); GetCursorPos(out now);
                if (Math.Abs(now.X - lx) > 6 || Math.Abs(now.Y - ly) > 6) {
                    Thread.Sleep(12); GetCursorPos(out now);
                    if (Math.Abs(now.X - lx) > 6 || Math.Abs(now.Y - ly) > 6) {
                        if (now.X <= 0 && now.Y <= 0) throw new InvalidOperationException("触发保护：鼠标位于屏幕左上角，已紧急停止当前任务。");
                        throw new InvalidOperationException("你正在使用鼠标，已让出控制权（光标移动已中止，未点击）。");
                    }
                }
                if ((++k & 3) == 0) CheckStop();
                if (px == lx && py == ly) continue;
                MoveAbs(px, py); lx = px; ly = py;
                if (Follower != null) Follower.Follow(px, py);
                if (RecordTrace) { POINT a = new POINT(); GetCursorPos(out a); trace.Add(new double[] { sw.Elapsed.TotalMilliseconds, px, py, a.X, a.Y }); }
            }
            Settle(tx, ty);
        } finally { if (tm) { try { timeEndPeriod(1); } catch { } } }
    }
    // v6.1 按下前守卫：悬停结束后、按键按下前再读回一次光标。>6px = 用户动了鼠标（让出控制权，不点击）；1~6px = 微调回目标；仍不一致 = 放弃点击
    static void PressGuard(int x, int y) {
        x = ClampX(x); y = ClampY(y);
        POINT a = new POINT(); GetCursorPos(out a);
        int dev = Math.Max(Math.Abs(a.X - x), Math.Abs(a.Y - y));
        LastPressDev = dev;
        if (dev > 6) {
            if (a.X <= 0 && a.Y <= 0) throw new InvalidOperationException("触发保护：鼠标位于屏幕左上角，已紧急停止当前任务。");
            throw new InvalidOperationException("你正在使用鼠标，已让出控制权（按下前发现光标偏离目标 " + dev + "px，未点击）。");
        }
        if (dev > 0) {
            PressGuardFixes++; Fixups++;
            MoveAbs(x, y); Thread.Sleep(2); GetCursorPos(out a);
            if (a.X != x || a.Y != y) { SetCursorPos(x, y); Thread.Sleep(1); GetCursorPos(out a); }
            if (a.X != x || a.Y != y) throw new InvalidOperationException("光标定位失败（按下前）：目标 (" + x + "," + y + ")，实际 (" + a.X + "," + a.Y + ")，已取消点击。");
        }
        if (Follower != null) Follower.Follow(x, y);
    }
    static void CheckExpect(int x, int y) {
        if (ExpectRoot == IntPtr.Zero) return;
        IntPtr r = RootAt(x, y);
        if (r != IntPtr.Zero && r != ExpectRoot && (Follower == null || r != Follower.Hwnd))
            throw new InvalidOperationException("光标到位后发现目标点被其他窗口遮挡（" + WinClass(r) + "），已取消点击（未按下鼠标）。");
    }
    static void HumanClick(int x, int y, int button, int count) {
        HumanMoveTo(x, y);
        CheckExpect(x, y);
        Thread.Sleep((int)(Rnd(90, 210) / Math.Max(0.5, HumanSpeed)));   // 到位后停一下：触发 hover 态，也是人眼确认
        CheckExpect(x, y);
        if (Follower != null) { Follower.SetPressed(true); Follower.Pulse(button == 1 ? 1 : (button == 2 ? 2 : 0)); }
        try {
            for (int i = 0; i < count; i++) {
                CheckStop(); PressGuard(x, y);
                Send1(Mouse(BtnDown(button), 0)); Thread.Sleep(Rnd(52, 104));
                Send1(Mouse(BtnUp(button), 0));
                if (i + 1 < count) Thread.Sleep(Rnd(65, 130));
            }
        } finally { if (Follower != null) Follower.SetPressed(false); }
        { POINT rl = new POINT(); GetCursorPos(out rl); LastReleaseDev = Math.Max(Math.Abs(rl.X - ClampX(x)), Math.Abs(rl.Y - ClampY(y))); }
        Thread.Sleep(Rnd(25, 60));
    }
    static void HumanHover(int x, int y, int ms) { HumanMoveTo(x, y); CheckExpect(x, y); Thread.Sleep(ms); }
    static void HumanDrag(int x1, int y1, int x2, int y2) {
        HumanMoveTo(x1, y1); CheckExpect(x1, y1); Thread.Sleep(Rnd(90, 170)); PressGuard(x1, y1);
        if (Follower != null) Follower.SetPressed(true);
        Send1(Mouse(BtnDown(0), 0));
        try { Thread.Sleep(Rnd(90, 160)); HumanMoveTo(x2, y2); Thread.Sleep(Rnd(70, 130)); PressGuard(x2, y2); }
        finally { Send1(Mouse(BtnUp(0), 0)); if (Follower != null) Follower.SetPressed(false); }
        Thread.Sleep(Rnd(25, 60));
    }
    static void HumanWheel(int x, int y, int notches) {
        HumanMoveTo(x, y); CheckExpect(x, y); Thread.Sleep(Rnd(80, 170));
        int dir = notches >= 0 ? 1 : -1, n = Math.Abs(notches);
        for (int i = 0; i < n; i++) {
            if ((i & 3) == 0) CheckStop();
            Send1(Mouse(0x0800u, 120 * dir));
            Thread.Sleep(Rnd(22, 64) + ((i % 5 == 4) ? Rnd(40, 120) : 0));
        }
        Thread.Sleep(Rnd(40, 90));
    }
    static void HumanType(string s) {
        double baseMs = 1000.0 / Math.Max(1.0, TypeCps * HumanSpeed);
        // v6.5：长文本分级提速（<=24 字保持原节奏；25~60 x0.8；61~160 x0.6；>160 x0.4），按键保持时间同步缩短；抖动 / 标点停顿 / 急停检查不变
        if (s.Length > 160) baseMs *= 0.4; else if (s.Length > 60) baseMs *= 0.6; else if (s.Length > 24) baseMs *= 0.8;
        bool fastKey = s.Length > 60;
        int k = 0;
        for (int i = 0; i < s.Length; i++) {
            char c = s[i];
            if ((++k & 7) == 0) CheckStop();
            bool nl = false;
            if (c == '\r') { if (i + 1 < s.Length && s[i + 1] == '\n') continue; nl = true; }
            else if (c == '\n') nl = true;
            if (nl || c == '\t') {
                int vk = nl ? 0x0D : 0x09;
                Send1(KeyIn(vk, false, false)); Thread.Sleep(Rnd(25, 60)); Send1(KeyIn(vk, true, false));
            } else if (char.IsHighSurrogate(c) && i + 1 < s.Length && char.IsLowSurrogate(s[i + 1])) {
                Send(new INPUT[] { UniIn(c, false), UniIn(c, true), UniIn(s[i + 1], false), UniIn(s[i + 1], true) }); i++;
            } else {
                Send1(UniIn(c, false)); Thread.Sleep(fastKey ? Rnd(9, 24) : Rnd(18, 46)); Send1(UniIn(c, true));
            }
            double gap = baseMs * Math.Exp(0.30 * Gauss()) - 30.0;
            if (c == ' ' || c == ',' || c == '，' || c == '、') gap += Rnd(20, 90);
            if (c == '.' || c == '。' || c == '!' || c == '?' || c == '！' || c == '？' || c == ';' || c == '；' || nl) gap += Rnd(60, 180);
            Thread.Sleep((int)Math.Max(8.0, Math.Min(700.0, gap)));
        }
    }
