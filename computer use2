function Get-ViewBounds {
    # 控件可见区的边界：前台窗口矩形、虚拟桌面（物理像素）。返回 @{ Win; Screen }，各为 [l,t,r,b]
    $vx = [DsNative61]::VirtX(); $vy = [DsNative61]::VirtY(); $vw = [DsNative61]::VirtW(); $vh = [DsNative61]::VirtH()
    $scr = @([double]$vx, [double]$vy, [double]($vx + $vw), [double]($vy + $vh))
    $win = $null
    try {
        if ($script:ObsHwnd -ne [IntPtr]::Zero -and [DsNative61]::IsWindow($script:ObsHwnd)) {
            $w = [DsNative61]::WinRect($script:ObsHwnd)
            $win = @([double]$w[0], [double]$w[1], [double]$w[2], [double]$w[3])
        }
    }
    catch { $win = $null }
    return @{ Win = $win; Screen = $scr }
}
function Get-ClipRect($r, $vb) {
    # 把控件矩形裁到「真正看得见」的部分（窗口 ∩ 屏幕）；与窗口无交集的（弹出层）只与屏幕求交。
    # 日志任务3的教训：被吸顶工具栏 / 窗口边缘遮住一半的控件，几何中心会落在看不见的地方。
    # 注意：PowerShell 变量不区分大小写，所以不能同时用 $L 和 $l。
    $x0 = [double]$r.Left; $y0 = [double]$r.Top; $x1 = $x0 + [double]$r.Width; $y1 = $y0 + [double]$r.Height
    $scr = $vb.Screen
    foreach ($bd in @($vb.Win, $scr)) {
        if ($null -eq $bd) { continue }
        $ax = [Math]::Max($x0, $bd[0]); $ay = [Math]::Max($y0, $bd[1]); $bx = [Math]::Min($x1, $bd[2]); $by = [Math]::Min($y1, $bd[3])
        if ($null -ne $scr) { $ax = [Math]::Max($ax, $scr[0]); $ay = [Math]::Max($ay, $scr[1]); $bx = [Math]::Min($bx, $scr[2]); $by = [Math]::Min($by, $scr[3]) }
        if ($bx -gt $ax -and $by -gt $ay) { return [pscustomobject]@{ Left = $ax; Top = $ay; Width = ($bx - $ax); Height = ($by - $ay); IsEmpty = $false } }
    }
    return [pscustomobject]@{ Left = 0.0; Top = 0.0; Width = 0.0; Height = 0.0; IsEmpty = $true }
}
function Get-CoordLine([IntPtr]$hwnd) {
    try {
        $mons = (@([System.Windows.Forms.Screen]::AllScreens | ForEach-Object { "$($_.Bounds.Width)x$($_.Bounds.Height)@($($_.Bounds.X),$($_.Bounds.Y))" + $(if ($_.Primary) { '主' } else { '' }) })) -join ' '
        $wr = [DsNative61]::WinRect($hwnd)
        return "坐标系: 物理像素（已 Per-Monitor DPI 感知，系统缩放 $(([DsNative61]::DpiScale()).ToString('0.00'))x），原点=主屏左上角，副屏可为负数；虚拟桌面 ($([DsNative61]::VirtX()),$([DsNative61]::VirtY())) $([DsNative61]::VirtW())x$([DsNative61]::VirtH())；显示器: $mons；前台窗口矩形 ($($wr[0]),$($wr[1]))-($($wr[2]),$($wr[3]))；控件 @(x,y) 是其「可见部分」的中心"
    }
    catch { return '' }
}
function Test-TargetInRow($t, $modelRows) {
    # 目标（按钮）是否真的在某个「可见」列表行里面，返回行号，0 = 不在。
    # 日志任务3根因：旧版拿「所有行（含已滚出视口的行，其未裁剪矩形会盖到吸顶工具栏的坐标上）」做几何包含，
    # 把工具栏的「刪除」误判成行内按钮，连续拒绝 58 步。现在：只看视口内的行 + UIA 祖先链核验。
    if ($null -eq $t -or [double]$t.W -le 0) { return 0 }
    $cx = [double]$t.L + [double]$t.W / 2.0; $cy = [double]$t.T + [double]$t.H / 2.0
    $hit = [System.Collections.Generic.List[object]]::new()
    foreach ($rw in $modelRows) {
        $q = $rw.Row
        if ($q.Off) { continue }
        if ($cx -ge $q.L -and $cx -le ($q.L + $q.W) -and $cy -ge $q.T -and $cy -le ($q.T + $q.H)) { $hit.Add($rw) }
    }
    if ($hit.Count -eq 0) { return 0 }
    if ($null -eq $t.El) { return [int]$hit[0].Index }
    try {
        $walker = [System.Windows.Automation.TreeWalker]::ControlViewWalker
        $cur = $t.El
        for ($i = 0; $i -lt 24 -and $null -ne $cur; $i++) {
            foreach ($h in $hit) { if ([System.Windows.Automation.Automation]::Compare($cur, $h.Row.El)) { return [int]$h.Index } }
            $cur = $walker.GetParent($cur)
        }
        return 0   # 整条祖先链都不经过任何一行 → 不是行内按钮
    }
    catch { return [int]$hit[0].Index }   # 无法核验时保守地当作行内（宁可多拦）
}
function Get-ErrorInfo([string]$msg) {
    # 借鉴 agent-desktop 的结构化错误（code + 可否重试），让模型和熔断器不再靠猜
    $m = "$msg"; $code = 'ERROR'; $retry = 'after_observe'
    if ($m -match '^\[(SECURITY_[A-Z_]+)\]') { return [pscustomobject]@{ Code = $Matches[1]; Retry = 'no' } }   # v6.4：结构化安全错误码
    if ($m -match '^\[(REPEAT_EFFECT|REPEAT_UNVERIFIED|REPEAT_NOEFFECT|UNGROUNDED)\]') {
        $c5 = $Matches[1]; $r5 = 'no'
        if ($c5 -eq 'UNGROUNDED') { $r5 = 'after_inspect' } elseif ($c5 -ne 'REPEAT_NOEFFECT') { $r5 = 'after_verify' }
        return [pscustomobject]@{ Code = $c5; Retry = $r5 }
    }
    if ($m -match '安全联锁') { $code = 'INTERLOCK'; $retry = 'no' }
    elseif ($m -match '黑名单|禁止写入|已使用 -NoShell') { $code = 'BLOCKED'; $retry = 'no' }
    elseif ($m -match '超过 \d+ 秒') { $code = 'TIMEOUT'; $retry = 'no_same_command' }
    elseif ($m -match '让出控制权|正在使用键盘|正在使用鼠标') { $code = 'USER_ACTIVE'; $retry = 'safe_after_wait' }
    elseif ($m -match '光标定位失败') { $code = 'CURSOR_FIX'; $retry = 'after_observe' }
    elseif ($m -match '网页元素.*遮挡') { $code = 'OCCLUDED'; $retry = 'after_close_overlay' }
    elseif ($m -match '遮挡|前台窗口已变化') { $code = 'OCCLUDED'; $retry = 'after_focus_window' }
    elseif ($m -match '已不存在|界面已变化|位置已偏移|名称已由|已不可见|不存在（当前|滚动后仍不可见') { $code = 'STALE_REF'; $retry = 'after_observe' }
    elseif ($m -match '被禁用') { $code = 'DISABLED'; $retry = 'no' }
    elseif ($m -match '拒绝访问|UnauthorizedAccess|Access is denied') { $code = 'PERMISSION'; $retry = 'no' }
    return [pscustomobject]@{ Code = $code; Retry = $retry }
}
function Get-PixelSig([IntPtr]$hwnd) {
    # 前台窗口可见部分缩成 48x32 灰度：独立于 UIA 的「屏幕是否真的变了」证据（虚拟鼠标窗口已排除出截图）
    $bmp = $null; $g = $null; $small = $null; $g2 = $null
    try {
        $vb = Get-ViewBounds
        $bd = if ($null -ne $vb.Win) { $vb.Win } else { $vb.Screen }
        $s = $vb.Screen
        $l = [int][Math]::Max($bd[0], $s[0]); $t = [int][Math]::Max($bd[1], $s[1]); $r = [int][Math]::Min($bd[2], $s[2]); $b = [int][Math]::Min($bd[3], $s[3])
        $w = $r - $l; $h = $b - $t
        if ($w -lt 16 -or $h -lt 16) { return $null }
        $bmp = [System.Drawing.Bitmap]::new($w, $h)
        $g = [System.Drawing.Graphics]::FromImage($bmp)
        Copy-ScreenPixels $g $l $t $w $h
        $small = [System.Drawing.Bitmap]::new(48, 32)
        $g2 = [System.Drawing.Graphics]::FromImage($small)
        $g2.InterpolationMode = [System.Drawing.Drawing2D.InterpolationMode]::HighQualityBilinear
        $g2.DrawImage($bmp, 0, 0, 48, 32)
        $sig = New-Object 'byte[]' 1536
        for ($y = 0; $y -lt 32; $y++) { for ($x = 0; $x -lt 48; $x++) { $c = $small.GetPixel($x, $y); $sig[$y * 48 + $x] = [byte][int](0.299 * $c.R + 0.587 * $c.G + 0.114 * $c.B) } }
        return , $sig
    }
    catch { return $null }
    finally { foreach ($o in @($g2, $small, $g, $bmp)) { if ($o) { $o.Dispose() } } }
}
function Get-PixelDiff($a, $b) {
    # 返回发生明显变化（亮度差 ≥10）的区块占比（%）；任一为空返回 $null
    if ($null -eq $a -or $null -eq $b -or $a.Length -ne $b.Length -or $a.Length -eq 0) { return $null }
    $n = 0
    for ($i = 0; $i -lt $a.Length; $i++) { if ([Math]::Abs([int]$a[$i] - [int]$b[$i]) -ge 10) { $n++ } }
    return [Math]::Round(100.0 * $n / $a.Length, 1)
}
function Get-ObsSig($obs) {
    # 「界面有没有变」的指纹 = 控件文本（去掉鼠标位置）+ 像素大面积变化标记（≥3% 才算，避免光标闪烁误判）
    $s = ($obs.Text -replace '真实鼠标位置: \(\d+,\d+\)', '')
    if ($null -ne $obs.PixPct -and [double]$obs.PixPct -ge 3.0) { $s += "|px$([int]$obs.PixPct)" }
    return $s
}
function Repair-JsonControlChars([string]$j) {
    # 模型常在 JSON 字符串里直接换行（多行脚本）→ 严格解析失败；把字符串内部的裸换行 / 制表符转义后重试
    $sb = [System.Text.StringBuilder]::new(); $inStr = $false; $esc = $false
    foreach ($ch in $j.ToCharArray()) {
        if ($inStr) {
            if ($esc) { [void]$sb.Append($ch); $esc = $false; continue }
            if ($ch -eq '\') { $esc = $true; [void]$sb.Append($ch); continue }
            if ($ch -eq '"') { $inStr = $false; [void]$sb.Append($ch); continue }
            if ($ch -eq "`n") { [void]$sb.Append('\n'); continue }
            if ($ch -eq "`r") { [void]$sb.Append('\r'); continue }
            if ($ch -eq "`t") { [void]$sb.Append('\t'); continue }
            [void]$sb.Append($ch)
        }
        else { if ($ch -eq '"') { $inStr = $true }; [void]$sb.Append($ch) }
    }
    return $sb.ToString()
}
function Invoke-WriteFile($a) {
    # 长脚本通道：模型不必把几十行脚本塞进一个 JSON（日志任务1：输出被截断 → 非法 JSON 连续 5 次）
    $p = [Environment]::ExpandEnvironmentVariables("$($a.path)").Trim()
    if ($script:SafeOn) { $full = Assert-SafePath $p 'write' }   # v6.4：路径牢笼（相对路径落在工作区；越权抛 SECURITY_PATH_VIOLATION）
    else {
        if (-not [System.IO.Path]::IsPathRooted($p)) { throw 'write_file 的 path 必须是绝对路径（桌面请先用 [Environment]::GetFolderPath(''Desktop'') 查询）' }
        $full = [System.IO.Path]::GetFullPath($p)
        if (-not $NoSafety -and $full -match '(?i)^[a-z]:\\(Windows|Program Files|Program Files \(x86\))(\\|$)') { throw "禁止写入系统目录: $full" }
    }
    $content = "$($a.content)"
    if ($content.Length -gt 400000) { throw 'write_file 的 content 过长（>400000），请分段（append=true）' }
    if ($script:SafeOn) { $full = Assert-SafePath $full 'write' }   # v6.4：写入前再核对一次（缩小 TOCTOU 窗口）
    $dir = [System.IO.Path]::GetDirectoryName($full)
    if ($dir -and -not (Test-Path -LiteralPath $dir)) { [void](New-Item -ItemType Directory -Force -Path $dir) }
    if ($script:SafeOn) { $full = Assert-SafePath $full 'write' }
    $append = Test-True $a.append
    $ext = [System.IO.Path]::GetExtension($full).ToLower()
    $enc = [System.Text.UTF8Encoding]::new($ext -in '.ps1', '.psm1')   # .ps1 带 BOM 兼容 Windows PowerShell 5；.bat/.py 等不带
    $before = if (Test-Path -LiteralPath $full) { ([System.IO.FileInfo]$full).Length } else { 0 }
    if ($append) { [System.IO.File]::AppendAllText($full, $content, $enc) } else { [System.IO.File]::WriteAllText($full, $content, $enc); $before = 0 }
    $len = ([System.IO.FileInfo]$full).Length
    $fresh = ((-not $append) -or $before -eq 0)
    $exp = $before + $enc.GetByteCount($content) + $(if ($fresh) { $enc.GetPreamble().Length } else { 0 })
    if ($len -ne $exp) { throw "写入后读回大小不符（期望 $exp 字节，实际 $len 字节）: $full" }
    return "已$(if ($append) { '追加' } else { '写入' }) $($content.Length) 字符到 $full；读回核验：文件共 $len 字节"
}
function Invoke-ProcessAction($a) {
    # 子进程通道：按扩展名选解释器，stdout/stderr 异步读取（不死锁），超时杀整个进程树（日志任务1：PowerPoint COM 卡死 60 秒）
    $file = [Environment]::ExpandEnvironmentVariables("$($a.file)").Trim()
    $argStr = "$($a.args)"
    if (-not $NoSafety) { $hit = Test-DangerousCommand "$file $argStr"; if ($hit) { throw "命令命中灾难性命令黑名单 ($hit)，已拒绝（如确需执行请使用 -NoSafety）" } }
    $to = 120
    if (Test-NumValue $a.timeout) { $to = [int][Math]::Min([Math]::Max([double]"$($a.timeout)", 1), 900) }
    $ext = [System.IO.Path]::GetExtension($file).ToLower()
    $exe = $file; $full = $argStr
    switch ($ext) {
        '.ps1' { $exe = (Get-Process -Id $PID).Path; $full = "-NoProfile -ExecutionPolicy Bypass -File `"$file`" $argStr" }
        '.py' { $exe = 'python'; $full = "`"$file`" $argStr" }
        { $_ -in '.js', '.mjs', '.cjs' } { $exe = 'node'; $full = "`"$file`" $argStr" }
        { $_ -in '.bat', '.cmd' } { $exe = $(if ($env:ComSpec) { $env:ComSpec } else { 'cmd.exe' }); $full = "/d /c `"`"$file`" $argStr`"" }
    }
    $psi = [System.Diagnostics.ProcessStartInfo]::new($exe, $full)
    $psi.UseShellExecute = $false; $psi.RedirectStandardOutput = $true; $psi.RedirectStandardError = $true; $psi.CreateNoWindow = $true
    $oem = ("$($a.encoding)" -match '(?i)oem|gbk')
    $encd = if ($oem) { try { [System.Text.Encoding]::GetEncoding([System.Globalization.CultureInfo]::CurrentCulture.TextInfo.OEMCodePage) } catch { [System.Text.Encoding]::UTF8 } } else { [System.Text.Encoding]::UTF8 }
    $psi.StandardOutputEncoding = $encd; $psi.StandardErrorEncoding = $encd
    $psi.Environment['PYTHONIOENCODING'] = 'utf-8'; $psi.Environment['PYTHONUTF8'] = '1'
    if ($script:SafeOn) { foreach ($ek in @($psi.Environment.Keys)) { if ($ek -match $script:EnvScrubRx) { [void]$psi.Environment.Remove($ek) } } }   # v6.4：子进程不继承 API Key / Token 等密钥
    if (-not [string]::IsNullOrWhiteSpace("$($a.cwd)")) { $psi.WorkingDirectory = $(if ($script:SafeOn) { Assert-SafePath "$($a.cwd)" 'read' } else { [Environment]::ExpandEnvironmentVariables("$($a.cwd)") }) }
    elseif ($script:SafeOn -and $script:WorkspaceRoot) { $psi.WorkingDirectory = $script:WorkspaceRoot }
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $p = [System.Diagnostics.Process]::Start($psi)
    [void](Add-ProcessToJob $p)   # v6.4：DsJob63 执行作业（进程数 / 内存 / UI 配额 + KILL_ON_JOB_CLOSE）
    $so = $p.StandardOutput.ReadToEndAsync(); $se = $p.StandardError.ReadToEndAsync()
    while (-not $p.WaitForExit(200)) {
        try { Test-Abort } catch { try { $p.Kill($true) } catch { }; Stop-TaskProcesses; throw }   # v6.4：急停时清理整棵进程树（v6.3 只在超时时才杀）
        if ($sw.Elapsed.TotalSeconds -gt $to) { try { $p.Kill($true) } catch { }; throw "进程超过 $to 秒未完成，已终止整个进程树（$exe）" }
    }
    $p.WaitForExit()
    $o = Limit-Text $so.Result 1500; $e = Limit-Text $se.Result 700
    return "退出码 $($p.ExitCode)（$([int]$sw.Elapsed.TotalSeconds) 秒）; stdout: $o$(if ($e) { "; stderr: $e" })"
}
