function ConvertFrom-ChineseNumber([string]$s) {
    if ($s -match '^\d+$') { return [int]$s }
    $d = @{ '零' = 0; '一' = 1; '二' = 2; '两' = 2; '三' = 3; '四' = 4; '五' = 5; '六' = 6; '七' = 7; '八' = 8; '九' = 9 }
    $total = 0; $cur = 0
    foreach ($ch in $s.ToCharArray()) {
        $c = [string]$ch
        if ($d.ContainsKey($c)) { $cur = $d[$c] }
        elseif ($c -eq '十') { if ($cur -eq 0) { $cur = 1 }; $total += $cur * 10; $cur = 0 }
        elseif ($c -eq '百') { if ($cur -eq 0) { $cur = 1 }; $total += $cur * 100; $cur = 0 }
        else { return 0 }
    }
    return ($total + $cur)
}
function Get-TaskQuantity([string]$t) {
    # 从任务文本里识别「要处理几个」：前10个 / 前面10个 / 前十封 / 10 封邮件 / first 10 / top 5。「第3个」不算数量。
    if ([string]::IsNullOrWhiteSpace($t)) { return 0 }
    # 只对「选择 / 删除 / 归档 / 标记 / 移动」类任务生效，避免「打开一个记事本」被当成 N=1
    if ($t -notmatch '(?i)(删|刪|delete|remove|勾|选中|選取|选择|選擇|select|archive|归档|歸檔|封存|垃圾|trash|标记|標記|mark|移动|移至|移到|move)') { return 0 }
    $num = '(\d{1,3}|[零一二两三四五六七八九十百]{1,4})'
    $pats = @(
        "(?:最?前面?|头|first|top)\s*$num",
        "(?<![第\d零一二两三四五六七八九十百])$num\s*(?:个|個|封|条|條|项|項|则|則|份|篇)",
        "(?<![第\d])$num\s+(?:emails?|mails?|messages?|items?|conversations?|rows?)"
    )
    foreach ($p in $pats) {
        if ($t -match "(?i)$p") {
            $v = ConvertFrom-ChineseNumber $Matches[1]
            if ($v -gt 0) { return [int]$v }
        }
    }
    return 0
}
function ConvertTo-RowList([string]$spec, [int]$max) {
    # "1-10" / "1,3,5-7" / "1到10" → 升序去重的行号数组；超出列表行数直接报错（不猜）
    $s = (("$spec" -replace '[，、；;]', ',') -replace '[～~—–至到]', '-') -replace '\s+', ''
    if ($s -notmatch '^\d+(-\d+)?(,\d+(-\d+)?)*$') { throw "rows 格式不对：'$spec'（示例：`"1-10`" 或 `"1,3,5-7`"）" }
    $set = [System.Collections.Generic.SortedSet[int]]::new()
    foreach ($part in $s.Split(',')) {
        if ($part -match '^(\d+)-(\d+)$') {
            $lo = [int]$Matches[1]; $hi = [int]$Matches[2]
            if ($lo -gt $hi) { throw "rows 区间写反了：'$part'" }
            for ($i = $lo; $i -le $hi; $i++) { [void]$set.Add($i) }
        }
        else { [void]$set.Add([int]$part) }
    }
    if ($set.Count -gt 200) { throw 'rows 一次最多 200 行' }
    foreach ($i in $set) {
        if ($i -lt 1) { throw 'rows 从 1 开始编号' }
        if ($max -gt 0 -and $i -gt $max) { throw "列表只识别到 $max 行（含视口外），没有第 $i 行；请先翻页/滚动后重新观察，或缩小范围" }
    }
    return , ([int[]]@($set))
}
function Format-RowRanges($idx) {
    $arr = @($idx | ForEach-Object { [int]$_ } | Sort-Object -Unique)
    if ($arr.Count -eq 0) { return '无' }
    $out = [System.Collections.Generic.List[string]]::new()
    $s0 = $arr[0]; $p0 = $arr[0]
    for ($i = 1; $i -le $arr.Count; $i++) {
        if ($i -lt $arr.Count -and $arr[$i] -eq ($p0 + 1)) { $p0 = $arr[$i]; continue }
        if ($s0 -eq $p0) { $out.Add("R$s0") } else { $out.Add("R$s0-R$p0") }
        if ($i -lt $arr.Count) { $s0 = $arr[$i]; $p0 = $arr[$i] }
    }
    return ($out -join ',')
}
function Join-RowCheckboxes($rows, $cbs) {
    # 纯几何：每个复选框归入包含其中心点的候选行（宽度至少是复选框的 3 倍）。Chrome 把表格的「行」和「单元格」都报成 DataItem，
    # 所以在「高度像一行」的候选里取最宽的（= 整行而不是单元格）；都不像一行时取面积最小的。同一行取最左边的复选框。
    # 然后做表格一致性过滤：宽度 / 左边界偏离中位数的「行」（例如工具栏里的项）剔除，其复选框归入 Master（通常是「全选」框）。
    $map = @{}
    $master = [System.Collections.Generic.List[object]]::new()
    foreach ($cb in $cbs) {
        $cx = [double]$cb.L + [double]$cb.W / 2.0; $cy = [double]$cb.T + [double]$cb.H / 2.0
        $hMax = [Math]::Max(4.0 * [double]$cb.H, 120.0)
        $best = -1; $bestW = -1.0; $alt = -1; $altA = [double]::MaxValue
        for ($i = 0; $i -lt $rows.Count; $i++) {
            $rw = $rows[$i]
            if ([double]$rw.W -lt (3.0 * [double]$cb.W)) { continue }
            if ($cx -ge $rw.L -and $cx -le ($rw.L + $rw.W) -and $cy -ge $rw.T -and $cy -le ($rw.T + $rw.H)) {
                if ([double]$rw.H -le $hMax) { if ([double]$rw.W -gt $bestW) { $bestW = [double]$rw.W; $best = $i } }
                else { $ar = [double]$rw.W * [double]$rw.H; if ($ar -lt $altA) { $altA = $ar; $alt = $i } }
            }
        }
        if ($best -lt 0) { $best = $alt }
        if ($best -lt 0) { $master.Add($cb); continue }
        if (-not $map.ContainsKey($best) -or [double]$cb.L -lt [double]$map[$best].L) {
            if ($map.ContainsKey($best)) { $master.Add($map[$best]) }
            $map[$best] = $cb
        }
        else { $master.Add($cb) }
    }
    $list = [System.Collections.Generic.List[object]]::new()
    foreach ($key in @($map.Keys)) { $list.Add([pscustomobject]@{ Row = $rows[[int]$key]; Cb = $map[$key]; Text = ''; Index = 0; Key = '' }) }
    if ($list.Count -ge 3) {
        $ws = @($list | ForEach-Object { [double]$_.Row.W } | Sort-Object); $ls = @($list | ForEach-Object { [double]$_.Row.L } | Sort-Object)
        $mw = $ws[[int][Math]::Floor($ws.Count / 2)]; $ml = $ls[[int][Math]::Floor($ls.Count / 2)]
        $keep = [System.Collections.Generic.List[object]]::new()
        foreach ($e in $list) {
            if ([Math]::Abs([double]$e.Row.W - $mw) -le (0.15 * $mw) -and [Math]::Abs([double]$e.Row.L - $ml) -le 24) { $keep.Add($e) } else { $master.Add($e.Cb) }
        }
        $list = $keep
    }
    $sorted = @($list | Sort-Object -Property @{ Expression = { [double]$_.Row.T } }, @{ Expression = { [double]$_.Row.L } })
    $n = 0
    foreach ($r in $sorted) { $n++; $r.Index = $n }
    return [pscustomobject]@{ Rows = $sorted; Master = $master.ToArray() }
}
function Set-RowKeys($rows) {
