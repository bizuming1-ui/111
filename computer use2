                if (-not (Test-IdValue $i)) { return "$k 的 ids 里有非法编号 '$i'" }
                if (-not $script:Elements.ContainsKey([int]"$i")) { return "元素编号 $i 不存在" }
                $ci = $script:Elements[[int]"$i"]
                if ($ci.Type -ne 'CheckBox' -and $ci.Pat -notcontains 'tog') { return "元素 $i 是 $($ci.Type)，不是复选框/开关，不能 $k" }
