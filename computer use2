function Get-ActionRisk($a, [string]$Kind) {
    # 返回 @{Kind; Detail} 列表：payment / login / delete / submit / nav / exec
    $risks = [System.Collections.Generic.List[object]]::new()
    $name = ''; $type = ''; $item = $null
    try { if ((Test-IdValue $a.id) -and $script:Elements -and $script:Elements.ContainsKey([int]"$($a.id)")) { $item = $script:Elements[[int]"$($a.id)"]; $name = "$($item.FullName) $($item.Name)"; $type = "$($item.Type)" } } catch { }
    if ($name -and ($Kind -in @('click', 'double_click', 'check', 'key', 'hotkey') -or ($Kind -eq 'type' -and (Test-True $a.enter)))) {
        foreach ($k in 'payment', 'login', 'delete', 'submit') {
            if ($name -match $script:RiskRx[$k]) { [void]$risks.Add([pscustomobject]@{ Kind = $k; Detail = "操作控件「$(Limit-Text $name 60)」($type)" }); break }
        }
    }
    if ($Kind -eq 'click_many') {
        foreach ($cid in @($a.ids)) {
            try { $it = $script:Elements[[int]"$cid"]; $nm = "$($it.FullName) $($it.Name)"; foreach ($k in 'payment', 'login', 'delete', 'submit') { if ($nm -match $script:RiskRx[$k]) { [void]$risks.Add([pscustomobject]@{ Kind = $k; Detail = "click_many 控件「$(Limit-Text $nm 40)」" }); break } } } catch { }
        }
    }
    if ($Kind -eq 'type') {
        if ($item -and ($name -match '(?i)(密码|口令|password|passwd|\bpwd\b|passcode|验证码|\botp\b)' -or "$($item.Value)" -match '^•+$')) { [void]$risks.Add([pscustomobject]@{ Kind = 'login'; Detail = "向凭据输入框「$(Limit-Text $name 40)」输入内容" }) }
        if ("$($a.text)" -match '^(?i)(https?://|www\.)') { $h = Get-UrlHost "$($a.text)"; if ($h -and -not (Test-DomainTrusted $h)) { [void]$risks.Add([pscustomobject]@{ Kind = 'nav'; Detail = "输入非白名单域名 $h" }) } }
    }
    if ($Kind -in 'key', 'hotkey') {
        $keys = "$($a.keys)".ToLower()
        $fgProc = "$($script:LastFgProcess)"
        if ($keys -match '(^|\s)(shift\+delete|delete|ctrl\+delete)(\s|$)' -and $fgProc -match '(?i)explorer') { [void]$risks.Add([pscustomobject]@{ Kind = 'delete'; Detail = "在资源管理器按 $keys（删除文件）" }) }
    }
    if ($Kind -eq 'launch') {
        $tgt = "$($a.target)"; $seenNav = $false
        foreach ($tok in (("$tgt $($a.args)") -split '\s+')) {
            if ($tok -match '^(?i)(https?://|www\.)') { $h = Get-UrlHost $tok; if ($h -and -not (Test-DomainTrusted $h) -and -not $seenNav) { $seenNav = $true; [void]$risks.Add([pscustomobject]@{ Kind = 'nav'; Detail = "启动并导航到非白名单域名 $h" }) } }
        }
        $lc = Get-LaunchClass $tgt
        if ($lc -eq 'other') { [void]$risks.Add([pscustomobject]@{ Kind = 'exec'; Detail = "启动未知程序 $(Limit-Text $tgt 60)" }) }
    }
    return $risks.ToArray()
}

