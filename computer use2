function Test-ApiRetryable($status, [string]$detail) {
    # v6.1：按 HTTP 状态码决定是否值得重试；无状态码 = 网络 / 超时 / 连接重置，重试
    if ($null -ne $status -and "$status" -match '^\d+$') {
        $c = [int]$status
        if ($c -in 408, 409, 425, 429) { return $true }
        return ($c -ge 500)
    }
    if ("$detail" -match '\b401\b|\b402\b|Authentication|invalid.*key|Insufficient') { return $false }
    return $true
}
function Get-RetryDelayMs([int]$attempt, [double]$retryAfterSec = 0, [int]$seed = -1) {
    # v6.1：Retry-After 优先（上限 60s）；否则 1s·2^(n-1) 指数退避（上限 30s）；叠加 0~400ms 抖动避免同时重试
    $jit = if ($seed -ge 0) { [Random]::new($seed).Next(0, 401) } else { Get-Random -Minimum 0 -Maximum 401 }
    if ($retryAfterSec -gt 0) { return [int][Math]::Min(60000.0, $retryAfterSec * 1000.0 + $jit) }
    return [int][Math]::Min(30000.0, 1000.0 * [Math]::Pow(2.0, [Math]::Max(0, $attempt - 1)) + $jit)
}
function Get-DsHttpClient {
    # v6.2：全任务复用一个 HttpClient（连接池 + keep-alive + 压缩）。Invoke-RestMethod 每次调用都新建客户端、重新 TCP+TLS 握手，
    # 一个任务 20 步就是 20 次握手（国内网络每次约 0.2~0.6 秒）。复用连接后，握手只在会话的第一次发生。
    if ($null -eq $script:Http) {
        $hd = [System.Net.Http.SocketsHttpHandler]::new()
        $hd.PooledConnectionLifetime = [TimeSpan]::FromMinutes(10)
        $hd.PooledConnectionIdleTimeout = [TimeSpan]::FromMinutes(5)
        try { $hd.EnableMultipleHttp2Connections = $true } catch { }
        $hd.ConnectTimeout = [TimeSpan]::FromSeconds(20)
        $hd.AutomaticDecompression = [System.Net.DecompressionMethods]::GZip -bor [System.Net.DecompressionMethods]::Deflate -bor [System.Net.DecompressionMethods]::Brotli
        $script:Http = [System.Net.Http.HttpClient]::new($hd, $true)
        $script:Http.Timeout = [System.Threading.Timeout]::InfiniteTimeSpan   # 超时由每次请求的 CancellationToken 控制
    }
    return $script:Http
}
function Start-ApiWarmup {
    # 提前建立到 API 的 TLS 连接（不阻塞）：第一次真正的请求直接复用池里的连接
    $cli = Get-DsHttpClient
    $rq = [System.Net.Http.HttpRequestMessage]::new([System.Net.Http.HttpMethod]::Get, "$($BaseUrl.TrimEnd('/'))/models")
    [void]$rq.Headers.TryAddWithoutValidation('Authorization', "Bearer $ApiKey")
    $script:WarmTask = $cli.SendAsync($rq)
}
function Get-InnerMessage($ex) {
    $e = $ex
    while ($null -ne $e.InnerException -and ($e -is [System.Management.Automation.MethodInvocationException] -or $e -is [System.AggregateException] -or $e -is [System.Management.Automation.RuntimeException])) { $e = $e.InnerException }
    if ($e -is [System.Threading.Tasks.TaskCanceledException]) { return '请求超时（已取消）' }
    $msg = "$($e.Message)"
    if ($null -ne $e.InnerException -and $e.InnerException.Message -and $msg -notlike "*$($e.InnerException.Message)*") { $msg += ' → ' + $e.InnerException.Message }
    return $msg
}
function Invoke-DsHttpPost([string]$uri, [byte[]]$bytes, [int]$timeoutSec = 120) {
    $cli = Get-DsHttpClient
    $req = [System.Net.Http.HttpRequestMessage]::new([System.Net.Http.HttpMethod]::Post, $uri)
    try { $req.Version = [Version]::new(2, 0); $req.VersionPolicy = [System.Net.Http.HttpVersionPolicy]::RequestVersionOrLower } catch { }   # v7.0：优先 HTTP/2，失败降级 1.1
    $cts = [System.Threading.CancellationTokenSource]::new([TimeSpan]::FromSeconds($timeoutSec))
    $resp = $null
    try {
        [void]$req.Headers.TryAddWithoutValidation('Authorization', "Bearer $ApiKey")
        $req.Content = [System.Net.Http.ByteArrayContent]::new($bytes)
        $req.Content.Headers.ContentType = [System.Net.Http.Headers.MediaTypeHeaderValue]::new('application/json')
        $req.Content.Headers.ContentType.CharSet = 'utf-8'
        $task = $cli.SendAsync($req, [System.Net.Http.HttpCompletionOption]::ResponseContentRead, $cts.Token)
        # 等待期间每 80ms 检查一次紧急停止（Ctrl+Alt+Q / 鼠标甩到左上角）：v6.1 的 Invoke-RestMethod 在等待的 1~120 秒里完全无法中断
        while ($true) {
            $done = $false
            try { $done = $task.Wait(80) } catch { $done = $true }
            if ($done) { break }
            Test-Abort
        }
        $resp = $task.GetAwaiter().GetResult()
        $body = $resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()
        $ra = 0.0
        try { $rah = $resp.Headers.RetryAfter; if ($rah -and $rah.Delta) { $ra = $rah.Delta.TotalSeconds } } catch { }
        return [pscustomobject]@{ Status = [int]$resp.StatusCode; Body = $body; RetryAfter = $ra }
    }
    finally {
        try { $cts.Cancel() } catch { }
        if ($resp) { try { $resp.Dispose() } catch { } }
        try { $req.Dispose() } catch { }
        try { $cts.Dispose() } catch { }
    }
}
function Invoke-DeepSeek([string]$userContent, [string]$systemText = '', [int]$maxTok = 0, $userParts = $null, [string]$useModel = '', [bool]$jsonMode = $true) {
    # v6.2：$userParts 非空时 user 消息改用多模态 content 数组（视觉轮次）；$useModel 默认 $Model（视觉轮次传 $VisionModel）
    if ([string]::IsNullOrEmpty($systemText)) { $systemText = $SystemPrompt }
    if ($maxTok -le 0) { $maxTok = Get-StepMaxTokens }   # v7.0：自适应输出上限
    if ([string]::IsNullOrEmpty($useModel)) { $useModel = $Model }
    $payload = New-ChatPayload $systemText $userContent $userParts $useModel $maxTok $jsonMode
    $json = $payload | ConvertTo-Json -Depth 10 -Compress
    $bytes = [System.Text.Encoding]::UTF8.GetBytes($json)
    $uri = "$($BaseUrl.TrimEnd('/'))/chat/completions"
    $lastErr = ''
    $swApi = [System.Diagnostics.Stopwatch]::StartNew()
    foreach ($attempt in 1..5) {
        $httpStatus = $null; $retryAfter = 0.0
        try {
            $r = Invoke-DsHttpPost $uri $bytes 120
            if ($r.Status -ge 200 -and $r.Status -lt 300) {
                $obj = $r.Body | ConvertFrom-Json
                $content = [string]$obj.choices[0].message.content
                $script:LastFinish = [string]$obj.choices[0].finish_reason
                if ([string]::IsNullOrWhiteSpace($content)) { throw 'API 返回了空内容' }
                $script:LastApiMs = [int]$swApi.ElapsedMilliseconds
                Set-LastUsage $obj $script:LastApiMs
                return $content
            }
            $httpStatus = $r.Status; $retryAfter = $r.RetryAfter
            throw ("HTTP $($r.Status) | " + (Limit-Text $r.Body 300))
        }
        catch {
            if ($_.Exception.Message -like '触发保护*') { throw }
            $detail = Get-InnerMessage $_.Exception
            $lastErr = $detail
            Write-Host "  API 调用失败（第 $attempt 次）: $detail" -ForegroundColor DarkYellow
            if (-not (Test-ApiRetryable $httpStatus $detail)) { Write-Host "  （状态码 $httpStatus 属于请求本身的问题，重试不会有不同结果，已停止重试）" -ForegroundColor DarkYellow; break }
            if ($attempt -ge 5) { break }
            Wait-Safe (Get-RetryDelayMs $attempt $retryAfter)
        }
    }
    throw "DeepSeek API 调用失败: $lastErr"
}
function Get-FirstJsonObject([string]$t) {
    # 字符串感知的括号配对：返回文本里「第一个完整的 JSON 对象」；括号出现在字符串里不会干扰；没有完整对象返回 $null
    $s = $t.IndexOf('{')
    if ($s -lt 0) { return $null }
    $depth = 0; $inStr = $false; $esc = $false
    for ($i = $s; $i -lt $t.Length; $i++) {
        $ch = $t[$i]
        if ($inStr) {
            if ($esc) { $esc = $false }
            elseif ($ch -eq '\') { $esc = $true }
            elseif ($ch -eq '"') { $inStr = $false }
            continue
        }
        if ($ch -eq '"') { $inStr = $true; continue }
        if ($ch -eq '{') { $depth++ }
        elseif ($ch -eq '}') {
            $depth--
            if ($depth -eq 0) { return $t.Substring($s, $i - $s + 1) }
        }
    }
    return $null
}
function ConvertFrom-ModelJson([string]$text) {
    # v4 的做法是取「第一个 { 到最后一个 }」——模型输出两个对象时整段非法（日志任务1第1、2步）。
    $first = Get-FirstJsonObject $text
    if ($null -eq $first) { throw "模型输出里没有完整的 JSON 对象: $(Limit-Text $text 200)" }
    $rest = $text.Substring($text.IndexOf($first) + $first.Length)
    if ($rest.IndexOf('{') -ge 0) { Write-Host '  （模型输出了多个 JSON 对象，只执行第一个；其余已忽略）' -ForegroundColor DarkYellow }
    try { return ($first | ConvertFrom-Json) }
    catch {
        try { return ((Repair-JsonControlChars $first) | ConvertFrom-Json) }
        catch { throw "模型输出的 JSON 无法解析: $($_.Exception.Message)" }
    }
}
