# ====================================================================================================
# L1：路径牢笼 —— 纯字符串规范化（Windows 语义，不依赖运行平台）+ 运行期 ReparsePoint / 最终路径复核
# ====================================================================================================
function ConvertTo-CanonWinPath([string]$Path, [string]$Base = '', [switch]$AllowWildcard) {
    $fail = { param($r) [pscustomobject]@{ Ok = $false; Path = ''; Reason = $r } }
    if ([string]::IsNullOrWhiteSpace($Path)) { return (& $fail 'empty_path') }
    $p = $Path.Trim()
    if ($p -match '[\x00-\x1f]') { return (& $fail 'control_char') }
    if ($p.StartsWith('~')) { return (& $fail 'tilde_home_expansion') }
    $p = $p.Replace('/', '\')
    if ($p -match '^\\\\[?.]\\') { return (& $fail 'device_namespace') }
    if ($p.StartsWith('\\')) { return (& $fail 'unc_path') }
    $drive = ''
    if ($p -match '^([A-Za-z]):(.*)$') {
        $drive = $Matches[1].ToUpper() + ':'; $rest = $Matches[2]
        if (-not $rest.StartsWith('\')) { return (& $fail 'drive_relative_path') }
        $p = $rest
    }
    elseif ($p.StartsWith('\')) { return (& $fail 'rooted_without_drive') }
    else {
        if ([string]::IsNullOrWhiteSpace($Base)) { return (& $fail 'relative_without_base') }
        $b = ConvertTo-CanonWinPath $Base ''
        if (-not $b.Ok) { return $b }
        $drive = $b.Path.Substring(0, 2); $p = $b.Path.Substring(2) + '\' + $p
    }
    $segs = [System.Collections.Generic.List[string]]::new()
    foreach ($s in $p.Split('\')) {
        if ($s -eq '' -or $s -eq '.') { continue }
        if ($s -eq '..') { return (& $fail 'path_traversal') }
        if ($s -match '[ .]$') { return (& $fail 'trailing_dot_or_space') }
        if ($s.Contains(':')) { return (& $fail 'alternate_data_stream_or_provider') }
        if ($s -match '[<>"|]') { return (& $fail 'illegal_char') }
        if (-not $AllowWildcard -and $s -match '[*?]') { return (& $fail 'wildcard_not_allowed') }
        if ($s -match '^(?i:CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9]|CONIN\$|CONOUT\$)(\..*)?$') { return (& $fail 'reserved_device_name') }
        if ($s -match '~\d') { return (& $fail 'short_name_8dot3') }
        $segs.Add($s)
    }
    if ($segs.Count -eq 0) { return [pscustomobject]@{ Ok = $true; Path = ($drive + '\'); Reason = '' } }
    return [pscustomobject]@{ Ok = $true; Path = ($drive + '\' + ($segs -join '\')); Reason = '' }
}
function Test-SecPathInside([string]$Full, [string]$Root) {
    $r = $Root.TrimEnd('\')
    return ($Full.Equals($r, [System.StringComparison]::OrdinalIgnoreCase) -or $Full.StartsWith($r + '\', [System.StringComparison]::OrdinalIgnoreCase))
}
function Get-SecSensitiveDirs {
    if ($script:SensDirs) { return $script:SensDirs }
    $l = [System.Collections.Generic.List[string]]::new()
    foreach ($e in 'SystemRoot', 'windir', 'ProgramFiles', 'ProgramFiles(x86)', 'ProgramW6432', 'ProgramData', 'APPDATA', 'LOCALAPPDATA', 'PUBLIC', 'ALLUSERSPROFILE') {
        $v = [Environment]::GetEnvironmentVariable($e)
        if ($v) { $c = ConvertTo-CanonWinPath $v ''; if ($c.Ok) { [void]$l.Add($c.Path) } }
    }
    $up = [Environment]::GetEnvironmentVariable('USERPROFILE')
    if ($up) {
        foreach ($sub in '.ssh', '.aws', '.azure', '.kube', '.gnupg', '.docker', '.config', '.gradle', '.m2', '.nuget', '.vscode', '.git-credentials', '.netrc', '.npmrc', '.pypirc', 'NTUSER.DAT') {
            $c = ConvertTo-CanonWinPath ($up.TrimEnd('\', '/') + '\' + $sub) ''; if ($c.Ok) { [void]$l.Add($c.Path) }
        }
    }
    foreach ($d in 'C:\Windows', 'C:\Program Files', 'C:\Program Files (x86)', 'C:\ProgramData', 'C:\System Volume Information', 'C:\$Recycle.Bin', 'C:\Recovery', 'C:\Boot') { [void]$l.Add($d) }
    $script:SensDirs = @($l | Select-Object -Unique)
    return $script:SensDirs
}
$script:SensRegex = @(
    @{ N = 'windows_dir'; R = '(?i)^[a-z]:\\Windows(\\|$)' },
    @{ N = 'program_files'; R = '(?i)^[a-z]:\\Program Files( \(x86\))?(\\|$)' },
    @{ N = 'program_data'; R = '(?i)^[a-z]:\\ProgramData(\\|$)' },
    @{ N = 'system32'; R = '(?i)\\System32(\\|$)' },
    @{ N = 'sam_hive'; R = '(?i)\\config\\(SAM|SYSTEM|SECURITY|SOFTWARE|DEFAULT)$' },
    @{ N = 'user_appdata'; R = '(?i)^[a-z]:\\Users\\[^\\]+\\AppData(\\|$)' },
    @{ N = 'user_secret_dir'; R = '(?i)^[a-z]:\\Users\\[^\\]+\\(\.ssh|\.aws|\.azure|\.kube|\.gnupg|\.docker|\.config)(\\|$)' },
    @{ N = 'user_hive'; R = '(?i)\\NTUSER\.DAT' },
    @{ N = 'credential_file'; R = '(?i)(^|\\)(id_rsa|id_ed25519|id_ecdsa|id_dsa|\.git-credentials|\.netrc|\.npmrc|\.pypirc|ntds\.dit|Login Data|Cookies|Web Data|Local State|credentials\.json|secrets\.json)(\.pub)?$' },
    @{ N = 'key_material'; R = '(?i)\.(pfx|p12|ppk|kdbx|keystore|jks)$' }
)
function Get-SecSensitiveReason([string]$Full) {
    if ([string]::IsNullOrWhiteSpace($Full)) { return $null }
    $tmp = $null
    try { $t = [System.IO.Path]::GetTempPath(); if ($t) { $tc = ConvertTo-CanonWinPath $t ''; if ($tc.Ok) { $tmp = $tc.Path } } } catch { }
    if ($tmp -and (Test-SecPathInside $Full $tmp)) { return $null }   # 用户 Temp 目录是唯一放行的 AppData 子目录
    foreach ($d in (Get-SecSensitiveDirs)) { if (Test-SecPathInside $Full $d) { return "sensitive_dir:$d" } }
    foreach ($r in $script:SensRegex) { if ($Full -match $r.R) { return "sensitive:$($r.N)" } }
    return $null
}
function Test-SafePath {
    # 返回 [pscustomobject]@{ Ok; Path; Reason }，不抛异常（Assert-SafePath 是抛异常版本）
    param([string]$Path, [ValidateSet('read', 'write', 'delete', 'exec')][string]$Operation = 'write', [string]$Root = '', [switch]$AllowWildcard)
    $bad = { param($r) [pscustomobject]@{ Ok = $false; Path = ''; Reason = $r } }
    $root = if ($Root) { $Root } else { $script:WorkspaceRoot }
    if ([string]::IsNullOrWhiteSpace($root)) { return (& $bad 'workspace_not_initialized') }
    $expanded = [Environment]::ExpandEnvironmentVariables($Path)
    $c = ConvertTo-CanonWinPath $expanded $root -AllowWildcard:$AllowWildcard
    if (-not $c.Ok) { return (& $bad $c.Reason) }
    $rc = ConvertTo-CanonWinPath $root ''
    if (-not $rc.Ok) { return (& $bad "workspace_root_invalid:$($rc.Reason)") }
    if (-not (Test-SecPathInside $c.Path $rc.Path)) {
        $sr = Get-SecSensitiveReason $c.Path
        return (& $bad $(if ($sr) { "outside_workspace;$sr" } else { 'outside_workspace' }))
    }
    if ($IsWindows) {
        # 运行期复核（仅 Windows）：规范化一致性 + 沿途 ReparsePoint（符号链接 / 目录联接）+ 最终路径（GetFinalPathNameByHandle）仍在牢笼内
        try {
            if (-not $AllowWildcard) {
                $gf = [System.IO.Path]::GetFullPath($c.Path)
                if (-not $gf.TrimEnd('\').Equals($c.Path.TrimEnd('\'), [System.StringComparison]::OrdinalIgnoreCase)) { return (& $bad 'canonicalization_mismatch') }
            }
            $cur = $rc.Path
            $rel = $c.Path.Substring($rc.Path.Length).Trim('\')
            $chain = [System.Collections.Generic.List[string]]::new(); [void]$chain.Add($cur)
            if ($rel) { foreach ($seg in $rel.Split('\')) { $cur = $cur + '\' + $seg; [void]$chain.Add($cur) } }
            foreach ($node in $chain) {
                if ($node -match '[*?]') { break }
                $attr = $null
                try { $attr = [System.IO.File]::GetAttributes($node) } catch { $attr = $null }
                if ($null -ne $attr -and ($attr -band [System.IO.FileAttributes]::ReparsePoint)) { return (& $bad 'reparse_point_or_symlink') }
            }
            if ((-not $AllowWildcard) -and ('DsJob63' -as [type])) {
                $probe = $c.Path
                while ($probe -and -not [System.IO.File]::Exists($probe) -and -not [System.IO.Directory]::Exists($probe)) { $probe = [System.IO.Path]::GetDirectoryName($probe) }
                if ($probe) {
                    $fin = [DsJob63]::FinalPath($probe); $rootFin = [DsJob63]::FinalPath($rc.Path)
                    if ($fin -and $rootFin -and -not (Test-SecPathInside $fin $rootFin)) { return (& $bad 'final_path_escapes_workspace') }
                    if (($Operation -eq 'write' -or $Operation -eq 'delete') -and [System.IO.File]::Exists($c.Path)) { $lk = [DsJob63]::LinkCount($c.Path); if ($lk -gt 1) { return (& $bad 'hardlink_count_gt_1') } }
                }
            }
        }
        catch { return (& $bad "runtime_check_failed:$($_.Exception.Message)") }
    }
    return [pscustomobject]@{ Ok = $true; Path = $c.Path; Reason = '' }
}
function Assert-SafePath {
    param([string]$Path, [ValidateSet('read', 'write', 'delete', 'exec')][string]$Operation = 'write', [string]$Root = '', [switch]$AllowWildcard)
    if (-not $script:SafeOn) { return [System.IO.Path]::GetFullPath([Environment]::ExpandEnvironmentVariables($Path)) }
    $r = Test-SafePath -Path $Path -Operation $Operation -Root $Root -AllowWildcard:$AllowWildcard
    if (-not $r.Ok) {
        $script:SecStats.PathDenied++
        Write-SecEvent 'SECURITY_PATH_VIOLATION' "op=$Operation path=$Path reason=$($r.Reason)"
        throw (New-SecError 'SECURITY_PATH_VIOLATION' "操作=$Operation 路径=「$Path」被路径牢笼拒绝（原因: $($r.Reason)；工作区: $($script:WorkspaceRoot)）。请只在工作区内读写（相对路径会自动落在工作区）。")
    }
    return $r.Path
}
function Test-WorkspaceRootSane([string]$Root) {
    $c = ConvertTo-CanonWinPath $Root ''
    if (-not $c.Ok) { return "路径无效($($c.Reason))" }
    if ($c.Path.Length -le 3) { return '不能是磁盘根目录' }
    $sr = Get-SecSensitiveReason $c.Path
    if ($sr) { return "位于敏感位置($sr)" }
    foreach ($d in (Get-SecSensitiveDirs)) { if ($d.StartsWith($c.Path.TrimEnd('\') + '\', [System.StringComparison]::OrdinalIgnoreCase)) { return "包含敏感目录 $d（工作区不能是它的上级）" } }
    return $null
}
function Initialize-TaskWorkspace([int]$TaskNo = 1) {
    # 每个任务一个专属隔离目录（-WorkspaceRoot 显式指定时直接使用该目录）
    if (-not $script:SafeOn) { return $null }
    if (-not $script:WorkspaceBase) {
        if (-not [string]::IsNullOrWhiteSpace($WorkspaceRoot)) { $script:WorkspaceBase = [Environment]::ExpandEnvironmentVariables($WorkspaceRoot); $script:WorkspaceFixed = $true }
        else {
            $home0 = [Environment]::GetEnvironmentVariable('USERPROFILE'); if (-not $home0) { $home0 = [System.IO.Path]::GetTempPath() }
            $script:WorkspaceBase = $home0.TrimEnd('\', '/') + '\DeepSeekComputerUse\workspace'
        }
    }
    $target = if ($script:WorkspaceFixed) { $script:WorkspaceBase } else { $script:WorkspaceBase + '\' + $script:WsStamp + '\' + ('task{0:D2}' -f $TaskNo) }
    $why = Test-WorkspaceRootSane $target
    if ($why) { throw (New-SecError 'SECURITY_PATH_VIOLATION' "工作区 $target 不安全: $why") }
    $canon = (ConvertTo-CanonWinPath $target '').Path
    if ($IsWindows) { [void][System.IO.Directory]::CreateDirectory($canon) }
    $script:WorkspaceRoot = $canon
    return $canon
}

