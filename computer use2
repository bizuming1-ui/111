    public long DocEpoch { get { return Interlocked.Read(ref docEpoch); } }
    public long LastEventTick { get { return Interlocked.Read(ref lastEvt); } }

    // ===== JSON-RPC 编解码（静态，可离线自检）=====
    public static string BuildRequest(int id, string method, string paramsJson) {
        return "{\"id\":" + id + ",\"method\":\"" + method + "\",\"params\":" + (string.IsNullOrEmpty(paramsJson) ? "{}" : paramsJson) + "}";
    }
    public static int IdOf(string msg) {
        if (msg == null || !msg.StartsWith("{\"id\":", StringComparison.Ordinal)) return -1;
        int j = 6, v = 0, n = 0;
        while (j < msg.Length && msg[j] >= '0' && msg[j] <= '9') { v = v * 10 + (msg[j] - '0'); j++; n++; }
        return n > 0 ? v : -1;
    }
    public static string ErrorOf(string msg) {
        if (string.IsNullOrEmpty(msg)) return "空响应";
        int k = msg.IndexOf("\"error\":", 0, Math.Min(msg.Length, 48), StringComparison.Ordinal);
        if (k < 0) return null;
        try { using (var d = JsonDocument.Parse(msg, Jo)) { JsonElement e; if (d.RootElement.TryGetProperty("error", out e)) { JsonElement m; return e.TryGetProperty("message", out m) ? m.GetString() : e.GetRawText(); } } } catch { }
