    $script:LastAstCmd = $null; $script:LastAstRes = $null
    if (-not $script:SafeOn) { Write-Host '  ⚠ 安全模式已关闭（-SafeMode:$false）：路径牢笼 / AST 审计 / 污点隔离 / HITL 全部不生效。' -ForegroundColor Red; return }
    $ws = Initialize-TaskWorkspace $script:TaskNo
