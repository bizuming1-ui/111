    }
    public static string ResultOf(string msg) {
        try { using (var d = JsonDocument.Parse(msg, Jo)) { JsonElement r; return d.RootElement.TryGetProperty("result", out r) ? r.GetRawText() : "{}"; } } catch { return "{}"; }
