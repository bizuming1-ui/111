    $err = ''
    foreach ($rawLine in ($outText -split "`r?`n")) {
        $ln = $rawLine.Trim().TrimStart([char]0xFEFF)
        if (-not $ln.StartsWith('{')) { continue }
        $o = $null
        try { $o = $ln | ConvertFrom-Json } catch { continue }
        if ($o.err) { $err = "$($o.err)"; continue }
        $txt = Optimize-OcrText "$($o.t)"
        if ($txt -eq '') { continue }
        $lx = $x0 + [int]([double]$o.x / $scale); $ly = $y0 + [int]([double]$o.y / $scale)
        $lw = [int]([double]$o.w / $scale); $lh = [int]([double]$o.h / $scale)
        $item = [pscustomobject]@{ Text = $txt; L = $lx; T = $ly; W = $lw; H = $lh; cx = [int]($lx + $lw / 2); cy = [int]($ly + $lh / 2) }
