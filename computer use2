# ---------- 确定性等待引擎 ----------
function Set-CdpActionEpoch {
    # 动作开始前记下事件序号：动作期间发生的任何网络 / 导航事件都算「有活动」
    if (Test-CdpForeground) { $script:CdpActEp = @{ Epoch = [long]$script:Cdp.Epoch; Doc = [long]$script:Cdp.DocEpoch } } else { $script:CdpActEp = $null }
