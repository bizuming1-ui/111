        try {
            $c = $el.Cached
            $rc = $c.BoundingRectangle
            if ($rc.IsEmpty -or $rc.Width -lt 4 -or $rc.Height -lt 4) { continue }
            if (($rc.Left + $rc.Width) -lt $wr[0] -or $rc.Left -gt $wr[2]) { continue }   # 与前台窗口水平方向不相交（隐藏面板等）
            $type = ($c.ControlType.ProgrammaticName -replace '^ControlType\.', '')
            $o = [pscustomobject]@{
                El = $el; Type = $type; Name = "$($c.Name)"; AutoId = "$($c.AutomationId)"
                L = [double]$rc.Left; T = [double]$rc.Top; W = [double]$rc.Width; H = [double]$rc.Height
                Off = [bool]$c.IsOffscreen; Enabled = [bool]$c.IsEnabled; State = ''; Tog = $false; Pats = @()
            }
            if ($type -eq 'CheckBox') {
                try {
                    if ($el.GetCachedPropertyValue($AE::IsTogglePatternAvailableProperty) -eq $true) {
                        $o.Tog = $true
                        $tv = $el.GetCachedPropertyValue($TogP)
                        if ($tv -is [System.Windows.Automation.ToggleState]) { $o.State = "$tv".ToLower() }
                    }
                }
                catch { }
                $cbs.Add($o)
            }
            else {
                $pp = @()
                try { if ($el.GetCachedPropertyValue($AE::IsSelectionItemPatternAvailableProperty) -eq $true) { $pp += 'sel' } } catch { }
                try { if ($el.GetCachedPropertyValue($AE::IsInvokePatternAvailableProperty) -eq $true) { $pp += 'inv' } } catch { }
                $o.Pats = $pp
                $rows.Add($o)
            }
        }
        catch { continue }
    }
    if ($cbs.Count -eq 0) { return $empty }
    if ($rows.Count -eq 0) { return [pscustomobject]@{ Rows = @(); Master = $cbs.ToArray() } }
    $j = Join-RowCheckboxes $rows $cbs
    if (@($j.Rows).Count -gt 0) {
        $need = @($j.Rows | Where-Object { [string]::IsNullOrWhiteSpace($_.Row.Name) }).Count
        $texts = @()
        if ($need -gt 0) { $texts = @(Get-RowTexts $j.Rows) }
        $buckets = @{}
        foreach ($tx in $texts) {
            foreach ($rw in $j.Rows) {
                $rr = $rw.Row
                if ($tx.cx -ge $rr.L -and $tx.cx -le ($rr.L + $rr.W) -and $tx.cy -ge $rr.T -and $tx.cy -le ($rr.T + $rr.H)) {
                    if (-not $buckets.ContainsKey($rw.Index)) { $buckets[$rw.Index] = [System.Collections.Generic.List[object]]::new() }
                    $buckets[$rw.Index].Add($tx)
                    break
                }
            }
        }
        foreach ($rw in $j.Rows) {
            if (-not [string]::IsNullOrWhiteSpace($rw.Row.Name)) { $rw.Text = Limit-Text $rw.Row.Name 120; continue }
            $names = [System.Collections.Generic.List[string]]::new()
            if ($buckets.ContainsKey($rw.Index)) {
                foreach ($tx in @($buckets[$rw.Index] | Sort-Object -Property L)) { if (-not $names.Contains($tx.Name)) { $names.Add($tx.Name) } }
            }
            $rw.Text = Limit-Text ($names -join ' · ') 120
        }
        Set-RowKeys $j.Rows
    }
    return $j
}
function ConvertTo-RowCbItem($row) {
    $cb = $row.Cb
    $nm = "$($cb.Name)"; if ([string]::IsNullOrWhiteSpace($nm)) { $nm = "$($cb.AutoId)" }
    $pats = @(); if ($cb.Tog) { $pats += 'tog' }
    return [pscustomobject]@{
        Type = 'CheckBox'; Name = (Limit-Text $nm 80); FullName = "$($cb.Name)"; Value = ''; State = $cb.State
        Enabled = [bool]$cb.Enabled; Focus = $false; Hwnd = 0; Pat = $pats; El = $cb.El
        cx = [int]($cb.L + $cb.W / 2); cy = [int]($cb.T + $cb.H / 2); L = [int]$cb.L; T = [int]$cb.T; W = [int]$cb.W; H = [int]$cb.H
        IsMaster = $false; RowIdx = [int]$row.Index; RowText = "$($row.Text)"; Off = [bool]$row.Row.Off
    }
}
function ConvertTo-RowItem($row) {
    $rw = $row.Row
    $nm = "$($rw.Name)"; if ([string]::IsNullOrWhiteSpace($nm)) { $nm = "$($rw.AutoId)" }
    return [pscustomobject]@{
        Type = $rw.Type; Name = (Limit-Text $nm 80); FullName = "$($rw.Name)"; Value = ''; State = ''
        Enabled = [bool]$rw.Enabled; Focus = $false; Hwnd = 0; Pat = @($rw.Pats); El = $rw.El
        cx = [int]($rw.L + $rw.W / 2); cy = [int]($rw.T + $rw.H / 2); L = [int]$rw.L; T = [int]$rw.T; W = [int]$rw.W; H = [int]$rw.H
        IsMaster = $false; RowIdx = [int]$row.Index; RowText = "$($row.Text)"; Off = [bool]$rw.Off
    }
}
function Get-PrecisePoint($item, $r) {
    # 物理点击的落点：TryGetClickablePoint + 矩形内若干候选点，逐个做「严格命中测试」（实时命中的必须是目标本身或其后代）
    $cands = [System.Collections.Generic.List[object]]::new()
    try {
        $pt = [System.Windows.Point]::new(0, 0)
        if ($item.El.TryGetClickablePoint([ref]$pt)) { $cands.Add(@([int][Math]::Round($pt.X), [int][Math]::Round($pt.Y))) }
    }
    catch { }
    foreach ($f in @(@(0.5, 0.5), @(0.35, 0.5), @(0.65, 0.5), @(0.5, 0.3), @(0.5, 0.7))) {
        $cands.Add(@([int][Math]::Round($r.Left + $r.Width * $f[0]), [int][Math]::Round($r.Top + $r.Height * $f[1])))
    }
    $tried = 0
    foreach ($c in $cands) {
        if ($c[0] -lt $r.Left -or $c[0] -gt ($r.Left + $r.Width) -or $c[1] -lt $r.Top -or $c[1] -gt ($r.Top + $r.Height)) { continue }
        $tried++
        if (Test-HitTarget $item $c[0] $c[1] -Strict) { return @{ x = $c[0]; y = $c[1]; verified = $true } }
        if ($tried -ge 4) { break }
    }
    return @{ x = [int]($r.Left + $r.Width / 2); y = [int]($r.Top + $r.Height / 2); verified = $false }
}
function Invoke-ScrollIntoView($el) {
    try {
        $sp = $el.GetCurrentPattern([System.Windows.Automation.ScrollItemPattern]::Pattern)
        $sp.ScrollIntoView()
        Start-Sleep -Milliseconds 250
        return $true
    }
    catch { return $false }
}
function Get-LiveToggle($item) {
    try { return "$($item.El.GetCurrentPattern([System.Windows.Automation.TogglePattern]::Pattern).Current.ToggleState)".ToLower() }
    catch { return '' }
}
function Wait-ToggleState($item, [string]$want, [int]$timeoutMs) {
    # 网页复选框是异步更新的（Gmail 常见 100~500 ms）：轮询到目标状态或超时，返回最后读到的状态
    $end = (Get-Date).AddMilliseconds($timeoutMs)
    $st = Get-LiveToggle $item
    while ($st -ne $want -and (Get-Date) -lt $end) {
        Start-Sleep -Milliseconds 60
        $st = Get-LiveToggle $item
    }
    return $st
}
function Assert-ItemFresh($item, [int]$n) {
    # 和 Resolve-Target 相同的身份核对（名称 + 收紧后的漂移容差），但允许控件在视口外（UIA 不需要可见）
    $cur = $null
    try { $cur = $item.El.Current; $rc = $cur.BoundingRectangle }
    catch {
        if (-not (Update-ItemElement $item)) { throw "控件 [$n] 已不存在（界面已变化），请重新观察后再操作" }
        try { $cur = $item.El.Current; $rc = $cur.BoundingRectangle } catch { throw "控件 [$n] 已不存在（界面已变化），请重新观察后再操作" }
    }
    if ($rc.IsEmpty) { throw "控件 [$n] 已不可用（无位置信息），请重新观察" }
    $live = $cur.Name
    if ([string]::IsNullOrWhiteSpace($live) -and $item.Type -ne 'Text') { $live = $cur.AutomationId }
    if ($item.Name -and (Limit-Text $live 80) -ne $item.Name) { throw "控件 [$n] 的名称已变化，界面已变化，请重新观察" }
    $drift = [Math]::Sqrt([Math]::Pow(($rc.Left + $rc.Width / 2) - $item.cx, 2) + [Math]::Pow(($rc.Top + $rc.Height / 2) - $item.cy, 2))
    $tol = Get-DriftTolerance $item
    if ($drift -gt $tol) { throw "控件 [$n] 位置已偏移 $([int]$drift) 像素（容差 $tol），界面已变化，请重新观察" }
}
function Invoke-PhysicalOnItem($item, [string]$label) {
    $cur = $item.El.Current
    $rc = $cur.BoundingRectangle
    if ($rc.IsEmpty -or [bool]$cur.IsOffscreen) {
        if (-not (Invoke-ScrollIntoView $item.El)) { throw "$label 在视口外，且无法自动滚动到可见区域" }
        $cur = $item.El.Current; $rc = $cur.BoundingRectangle
        if ($rc.IsEmpty -or [bool]$cur.IsOffscreen) { throw "$label 滚动后仍不可见" }
    }
    $pp = Get-PrecisePoint $item $rc
    $t = @{ x = $pp.x; y = $pp.y; label = $label; item = $item; byId = $true }
    if (-not [DsNative61]::Humanize) { Move-VirtualCursor $t.x $t.y }
    Assert-PhysicalReady $t
    Set-ExpectRoot $t
    if ([DsNative61]::Humanize) { Invoke-HumanApproach $t $item } else { Set-CursorPulse 0 }
    try { [DsNative61]::PhysicalClick($t.x, $t.y, 0, 1, $true) } catch { throw (Get-NativeError $_) }
    return [bool]$pp.verified
}
function Set-CheckState($item, [bool]$on, [string]$label) {
    # 幂等设定复选框状态（不是切换）：已是目标状态就不动；UIA Toggle → 轮询读回 → 仍不对再用命中核验过的物理点击 → 再读回。
    $want = if ($on) { 'on' } else { 'off' }
    $s0 = Get-LiveToggle $item
    if ($s0 -eq $want) {
        return [pscustomobject]@{ Ok = $true; Changed = $false; State = $s0; Via = '已是目标状态，未操作' }
    }
    $via = [System.Collections.Generic.List[string]]::new()
    try {
        $lc = $item.El.Current
        if (-not [bool]$lc.IsOffscreen) { $lr = $lc.BoundingRectangle; if (-not $lr.IsEmpty) { Move-VirtualCursor ([int]($lr.Left + $lr.Width / 2)) ([int]($lr.Top + $lr.Height / 2)) } }
    }
    catch { }
    $st = $s0
    if ($script:Mode -in 'Auto', 'Uia' -and ($item.Pat -contains 'tog' -or $item.Type -eq 'CheckBox')) {
        for ($k = 0; $k -lt 2 -and $st -ne $want; $k++) {
            $before = $st
            try { $item.El.GetCurrentPattern([System.Windows.Automation.TogglePattern]::Pattern).Toggle(); $via.Add('UIA Toggle') } catch { break }
            Set-CursorPulse 0
            $st = Wait-ToggleState $item $want 1500
            if ($st -eq $before) { break }   # 没有任何变化：不再盲目切换，交给下一层
        }
    }
    if ($st -ne $want -and $script:Mode -ne 'Uia') {
        Start-Sleep -Milliseconds 400
        $st = Get-LiveToggle $item   # 再读一次：防止迟到的异步生效被下一层「再切一次」抵消
        if ($st -ne $want) {
            if ($script:Mode -eq 'Message') {
                if ($item.Hwnd -eq 0 -or -not (Test-MessageFriendly $item.Hwnd)) { throw "$label 无法用窗口消息操作（请改用 mode auto）" }
                $mr = $item.El.Current.BoundingRectangle
                [void][DsNative61]::PostClick([IntPtr]$item.Hwnd, [int]($mr.Left + $mr.Width / 2), [int]($mr.Top + $mr.Height / 2), 0, 1)
                $via.Add('窗口消息')
            }
            else {
                $ver = Invoke-PhysicalOnItem $item $label
                $via.Add($(if ($ver) { '物理点击(落点已核验)' } else { '物理点击(落点未核验)' }))
            }
            $st = Wait-ToggleState $item $want 1500
        }
    }
    return [pscustomobject]@{ Ok = ($st -eq $want); Changed = $true; State = $st; Via = ($via -join '→') }
}
function Invoke-CheckAction($a, [bool]$on) {
    $ids = @()
    if ($null -ne $a.ids) { $ids = @($a.ids) } elseif (Test-IdValue $a.id) { $ids = @($a.id) }
    $want = if ($on) { 'on' } else { 'off' }
    $parts = [System.Collections.Generic.List[string]]::new()
    $bad = 0
    foreach ($i in $ids) {
        Test-Abort
        $n = [int]"$i"
        $item = $script:Elements[$n]
        if ($item.Cdp) { $res = Set-CdpCheckState $item $on "[$n]" $n }   # v6.3：CDP 读回 checked / aria-checked，幂等设定
        else {
            Assert-ItemFresh $item $n
            $res = Set-CheckState $item $on "[$n]"
        }
        if (-not $res.Ok) { $bad++ }
        $tag = if (-not $res.Changed) { "已是$want" } elseif ($res.Ok) { "→$($res.State)✓" } else { "→$($res.State)✗($($res.Via))" }
        $parts.Add("[$n]$tag")
        Start-Sleep -Milliseconds 40
    }
    $verb = if ($on) { 'check' } else { 'uncheck' }
    $verdict = if ($bad -eq 0) { "全部读回为 $want ✓" } else { "$bad 个未达成 ✗，请重新观察后处理" }
    return "$verb $($ids.Count) 个：$($parts -join ' ')；$verdict"
}
function Invoke-SelectRows($a) {
    # 按「列表行」R 编号精确勾选：幂等设定、默认独占（其他行取消）、闭环核验（重新扫描，按冻结的行身份核对，不符纠正），
    # 通过后再隔 0.8 秒复扫一次确认稳定（防止迟到的异步切换在「✓」之后又把状态改掉）。
    $spec = "$($a.rows)"
    $exclusive = $true
    if ($null -ne $a.exclusive -and "$($a.exclusive)" -ne '') { $exclusive = Test-True $a.exclusive }
    $m = Get-RowModel $script:ObsHwnd
    $total = @($m.Rows).Count
    if ($total -eq 0) { throw '当前前台窗口没有识别到「带复选框的列表行」，无法 select_rows（请重新观察，或改用 check）' }
    $want = ConvertTo-RowList $spec $total
    $useKeys = (@($m.Rows | Where-Object { $_.Text }).Count -eq $total)
    # 任务内指代一致性：同一任务里再次 select_rows 同一范围时，沿用首次冻结的行身份（中途到达的新邮件不会被算进「前 N 个」）
    $memoNote = ''
    if ($useKeys -and $script:SelectMemo -and $script:SelectMemo.Spec -eq $spec) {
        $idxByKey = @{}
        foreach ($row in $m.Rows) { $idxByKey[$row.Key] = [int]$row.Index }
        $mapped = @($script:SelectMemo.Keys | Where-Object { $idxByKey.ContainsKey($_) } | ForEach-Object { [int]$idxByKey[$_] } | Sort-Object)
        if ($mapped.Count -eq @($script:SelectMemo.Keys).Count -and ($mapped -join ',') -ne ($want -join ',')) {
            $want = [int[]]$mapped
            $memoNote = "（列表在本任务中途有变化：沿用首次选择时冻结的行身份，现在是 $(Format-RowRanges $want)）"
        }
    }
    if ($useKeys -and -not ($script:SelectMemo -and $script:SelectMemo.Spec -eq $spec)) {
        $script:SelectMemo = [pscustomobject]@{ Spec = $spec; Keys = @($want | ForEach-Object { $m.Rows[$_ - 1].Key }) }
    }
    $wantSet = [System.Collections.Generic.HashSet[int]]::new()
    foreach ($i in $want) { [void]$wantSet.Add([int]$i) }
    $frozen = @{}
    foreach ($i in $want) { $frozen[$m.Rows[$i - 1].Key] = $i }
    $changed = 0
    foreach ($row in $m.Rows) {
        Test-Abort
        $isT = $wantSet.Contains([int]$row.Index)
        $isOn = ($row.Cb.State -eq 'on')
        if ($isT -eq $isOn) { continue }
        if (-not $isT -and -not $exclusive) { continue }
        # 网页重绘会让元素引用失效：单行出错不中止，交给下面的「重新扫描 + 核验 + 纠正」处理
        try { [void](Set-CheckState (ConvertTo-RowCbItem $row) $isT "R$($row.Index)") } catch { if ($_.Exception.Message -like '触发保护*') { throw } }
        $changed++
    }
    $note = ''
    $missing = @(); $extra = @(); $onNow = @(); $stable = $false
    for ($pass = 1; $pass -le 3; $pass++) {
        Wait-Safe 350
        $v = Get-RowModel $script:ObsHwnd
        $byKey = $useKeys
        if ($byKey) {
            $found = @($v.Rows | Where-Object { $frozen.ContainsKey($_.Key) }).Count
            if ($found -lt [Math]::Ceiling($want.Count / 2.0)) { $byKey = $false; $note = '（行文字在操作后有变化，已改按行号核验）' }
            elseif ($found -lt $want.Count) { $note = "（有 $($want.Count - $found) 个目标行已不在列表中）" }
        }
        $missing = @(); $extra = @(); $onNow = @()
        foreach ($row in $v.Rows) {
            $isT = if ($byKey) { $frozen.ContainsKey($row.Key) } else { $wantSet.Contains([int]$row.Index) }
            $isOn = ($row.Cb.State -eq 'on')
            if ($isOn) { $onNow += [int]$row.Index }
            if ($isT -and -not $isOn) { $missing += $row }
            elseif ((-not $isT) -and $isOn -and $exclusive) { $extra += $row }
        }
        if (($missing.Count + $extra.Count) -eq 0) {
            Wait-Safe 800
            $v2 = Get-RowModel $script:ObsHwnd
            $on2 = @($v2.Rows | Where-Object { $_.Cb.State -eq 'on' } | ForEach-Object { [int]$_.Index })
            if (($on2 -join ',') -eq ($onNow -join ',')) { $stable = $true; break }
            continue   # 0.8 秒内又有变化（迟到的异步切换）：下一轮重新核对并纠正
        }
        if ($pass -eq 3) { break }
        foreach ($row in @($missing) + @($extra)) {
            $wantOn = $missing -contains $row
            try { [void](Set-CheckState (ConvertTo-RowCbItem $row) $wantOn "R$($row.Index)") } catch { if ($_.Exception.Message -like '触发保护*') { throw } }
            $changed++
        }
    }
    $tgt = Format-RowRanges $want
    if ($stable -and ($missing.Count + $extra.Count) -eq 0) {
        $tail = if ($exclusive) { '，其他行均未勾选' } else { '' }
        return "select_rows $spec：目标 $($want.Count) 行（$tgt），本次改动 $changed 个复选框；✓ 闭环验证通过（0.8 秒后复扫一致）：当前共勾选 $($onNow.Count) 行（$(Format-RowRanges $onNow)）$tail$note$memoNote"
    }
    $mi = Format-RowRanges @($missing | ForEach-Object { [int]$_.Index })
    $ex = Format-RowRanges @($extra | ForEach-Object { [int]$_.Index })
    $why = if (($missing.Count + $extra.Count) -eq 0) { '勾选状态在复扫时仍在变化（页面迟到的异步更新）' } else { "未勾上 $mi；多勾了 $ex" }
    return "select_rows $spec：✗ 未完全达成（已自动纠正）：$why；当前勾选 $($onNow.Count) 行（$(Format-RowRanges $onNow)）$note$memoNote。请 wait 1 秒后再 select_rows 一次，此时不要点删除"
}
function Test-InterlockDecision([int]$qty, [string]$name, [string]$type, [bool]$isMaster, [int]$rowCount, [int]$onCount, [bool]$inRow) {
    # 纯判定函数（自检可直接测）：返回 $null 表示放行，否则返回拒绝原因
    if ($qty -le 0 -or $rowCount -le 0) { return $null }
    $nm = "$name".Trim()
    if ($isMaster -and $rowCount -gt $qty) { return "安全联锁：任务只要求 $qty 个，禁止点击「全选」复选框（列表共 $rowCount 行）；请用 select_rows 精确勾选第 1-$qty 行" }
    if ($nm -match $script:SelectAllPattern -and $rowCount -gt $qty) { return "安全联锁：任务只要求 $qty 个，禁止使用「$nm」（会选中全部 $rowCount 行）；请用 select_rows 精确勾选第 1-$qty 行" }
    if ($nm -match $script:DestructivePattern) {
        if ($inRow -and $qty -ne 1) { return "安全联锁：「$(Limit-Text $nm 16)」位于某一行内，只会处理那一行，而任务要求 $qty 个；请先 select_rows 勾选，再点工具栏上的按钮" }
        if (-not $inRow -and $onCount -ne $qty) { return "安全联锁：任务要求处理 $qty 个，但列表当前实际勾选 $onCount 个，已拒绝「$(Limit-Text $nm 16)」（未发送任何输入）；请先用 select_rows 精确勾选第 1-$qty 行，看到 ✓ 闭环验证通过后再删除" }
    }
    return $null
}
function Find-ItemAt([int]$x, [int]$y) {
    $best = $null; $bestA = [double]::MaxValue
    foreach ($kv in $script:Elements.GetEnumerator()) {
        $it = $kv.Value
        if ($it.Off) { continue }   # 视口外的行：未裁剪的矩形可能与屏幕上别的控件重叠
        if ($x -ge $it.L -and $x -le ($it.L + $it.W) -and $y -ge $it.T -and $y -le ($it.T + $it.H)) {
            $ar = [double]$it.W * [double]$it.H
            if ($ar -lt $bestA) { $bestA = $ar; $best = $it }
        }
    }
    return $best
}
function Assert-BulkInterlock($a, [string]$kind) {
    # 只在「任务有明确数量」且目标看起来是 删除/归档/全选 时才额外扫描一次列表；-NoSafety 可关闭
    if ($NoSafety -or $script:TaskQty -le 0) { return }
    $targets = [System.Collections.Generic.List[object]]::new()
    if ($kind -in 'click', 'double_click', 'check', 'click_many') {
        $idList = @()
        if ($null -ne $a.ids) { $idList = @($a.ids) } elseif (Test-IdValue $a.id) { $idList = @($a.id) }
        foreach ($i in $idList) { if ((Test-IdValue $i) -and $script:Elements.ContainsKey([int]"$i")) { $targets.Add($script:Elements[[int]"$i"]) } }
        if ($idList.Count -eq 0 -and (Test-NumValue $a.x) -and (Test-NumValue $a.y)) { $hitItem = Find-ItemAt ([int]$a.x) ([int]$a.y); if ($hitItem) { $targets.Add($hitItem) } }
    }
    elseif ($kind -in 'key', 'hotkey') {
        if ("$($a.keys)" -match '(?i)(^|[\s+])(delete|del)(\s|$)|shift\+3') {
            $targets.Add([pscustomobject]@{ Type = 'Key'; FullName = 'delete'; Name = 'delete'; IsMaster = $false; L = 0; T = 0; W = 0; H = 0 })
        }
    }
    if ($targets.Count -eq 0) { return }
    $need = $false
    foreach ($t in $targets) { $nm = "$($t.FullName)"; if (-not $nm) { $nm = "$($t.Name)" }; if ($nm -match $script:DestructivePattern -or $nm -match $script:SelectAllPattern -or [bool]$t.IsMaster) { $need = $true } }
    if (-not $need) { return }
    $m = Get-RowModel $script:ObsHwnd
    $rowCount = @($m.Rows).Count
    if ($rowCount -eq 0) { return }
    $onCount = @($m.Rows | Where-Object { $_.Cb.State -eq 'on' }).Count
    foreach ($t in $targets) {
        $nm = "$($t.FullName)"; if (-not $nm) { $nm = "$($t.Name)" }
        $rowNo = Test-TargetInRow $t @($m.Rows)   # v4.3：只看视口内的行 + UIA 祖先链核验
        $inRow = ($rowNo -gt 0)
        $why = Test-InterlockDecision $script:TaskQty $nm "$($t.Type)" ([bool]$t.IsMaster) $rowCount $onCount $inRow
