    Task<string> Post(string method, string paramsJson) {
        if (!Connected || ws == null) throw new InvalidOperationException("CDP 未连接");
        int id = Interlocked.Increment(ref nextId);
        var tcs = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
        pending[id] = tcs;
        tcs.Task.ContinueWith(t => { var x = t.Exception; }, TaskContinuationOptions.OnlyOnFaulted);
