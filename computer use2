function Get-RuntimeKey($el) { try { return ((@($el.GetRuntimeId())) -join '.') } catch { return '' } }
function Get-RowTexts($rows) {
    # 行本身没有名称时（Gmail 的行就是这样），取「首行与末行的最近公共祖先」下的全部 Text，按几何归入各行
    $AE = [System.Windows.Automation.AutomationElement]
    $w = [System.Windows.Automation.TreeWalker]::ControlViewWalker
    $cnt = @($rows).Count
    if ($cnt -eq 0) { return @() }
    $firstEl = $rows[0].Row.El; $lastEl = $rows[$cnt - 1].Row.El
    $anc = @{}; $cont = $null
    try {
        $cur = $w.GetParent($firstEl)
        for ($i = 0; $i -lt 8 -and $null -ne $cur; $i++) { $rk = Get-RuntimeKey $cur; if ($rk) { $anc[$rk] = $true }; $cur = $w.GetParent($cur) }
        $cur = $w.GetParent($lastEl)
        for ($i = 0; $i -lt 8 -and $null -ne $cur; $i++) { $rk = Get-RuntimeKey $cur; if ($rk -and $anc.ContainsKey($rk)) { $cont = $cur; break }; $cur = $w.GetParent($cur) }
    }
    catch { $cont = $null }
    if ($null -eq $cont) { return @() }
    $col = $null; $act = $null
    try {
        $cr = [System.Windows.Automation.CacheRequest]::new()
        $cr.Add($AE::NameProperty); $cr.Add($AE::BoundingRectangleProperty)
        $act = $cr.Activate()
        $tc = [System.Windows.Automation.PropertyCondition]::new($AE::ControlTypeProperty, [System.Windows.Automation.ControlType]::Text)
        $col = $cont.FindAll([System.Windows.Automation.TreeScope]::Descendants, $tc)
    }
    catch { $col = $null }
    finally { if ($act) { $act.Dispose() } }
    if ($null -eq $col) { return @() }
    $out = [System.Collections.Generic.List[object]]::new()
    $k = 0
    foreach ($el in $col) {
        $k++; if ($k -gt 4000) { break }
        try {
            $c = $el.Cached
            $nm = "$($c.Name)".Trim()
            if ($nm -eq '') { continue }
            $rc = $c.BoundingRectangle
            if ($rc.IsEmpty) { continue }
            $out.Add([pscustomobject]@{ Name = (Limit-Text $nm 40); cx = $rc.Left + $rc.Width / 2.0; cy = $rc.Top + $rc.Height / 2.0; L = $rc.Left })
        }
        catch { continue }
    }
    return $out.ToArray()
}
function Get-RowModel([IntPtr]$hwnd) {
    # 列表行模型：CheckBox + DataItem/ListItem/TreeItem 一次缓存取回（不加 IsOffscreen 过滤，所以视口外的行也在），
    # 复选框按几何归行；行摘要来自行名称或行内文字。返回 Rows（R1..Rn）与 Master（不属于任何行的复选框）。
    $empty = [pscustomobject]@{ Rows = @(); Master = @() }
