function Wait-CdpSettled {
    # 等待 document.readyState==='complete' 且 InFlightRequests==0 并持续「安静窗口」（有网络 / 导航活动 -QuietMs=250ms；纯界面操作缩短到 120ms；总超时 -CdpTimeoutMs=5000ms；
    # 没有导航时最多等 2s，避免被统计 / 心跳类请求拖到 5s）。80ms 轮询，每圈检查急停（Ctrl+Alt+Q）。返回 $false = CDP 不可用（调用方回退 UIA 等待）。
    [CmdletBinding()]
    param([int]$QuietMs = 0, [int]$TimeoutMs = 0)
    $c = $script:Cdp
    if ($null -eq $c -or -not $c.Connected) { return $false }
    if ($QuietMs -le 0) { $QuietMs = [int]$script:CdpQuietMs }
    if ($TimeoutMs -le 0) { $TimeoutMs = [int]$script:CdpSettleTimeoutMs }
    $ap = $script:CdpActEp; $script:CdpActEp = $null
    $ep0 = if ($ap) { [long]$ap.Epoch } else { [long]$c.Epoch }
    $doc0 = if ($ap) { [long]$ap.Doc } else { [long]$c.DocEpoch }
    $t0 = [Environment]::TickCount64
    $quietSince = 0L; $rs = ''; $first = $true; $infl = 0; $nav = $false; $note = ''
    while ($true) {
        Test-Abort
        $now = [Environment]::TickCount64
        if (-not $c.Connected) { return $false }
        if ($c.DialogOpen) { $note = "JS 对话框未处理($($c.DialogInfo))"; break }
        $nav = ([long]$c.DocEpoch -ne $doc0); $act = ([long]$c.Epoch -ne $ep0)
        $need = if ($act) { $QuietMs } else { [Math]::Min($QuietMs, 120) }
        $cap = if ($nav) { $TimeoutMs } else { [Math]::Min($TimeoutMs, 2000) }
        $infl = [int]$c.InFlight(4000)
        if (($now - $t0) -ge $cap) { $note = "超时 ${cap}ms（在途=$infl rs=$rs）"; break }
        try {
            $expr = if ($first) { 'new Promise(r=>{let d=0;const f=()=>{if(!d){d=1;r(document.readyState)}};requestAnimationFrame(()=>requestAnimationFrame(f));setTimeout(f,100)})' } else { 'document.readyState' }
            $first = $false
            $rs = ("$($c.Eval($expr, 1500))").Trim('"')
        }
        catch { $rs = 'busy' }   # 导航中 / 执行上下文已销毁
        $infl = [int]$c.InFlight(4000)
        if ($rs -eq 'complete' -and $infl -eq 0) {
            if ($quietSince -eq 0) { $quietSince = $now }
            $ref = [Math]::Max($quietSince, [Math]::Max([long]$c.LastEventTick, $t0))
            if (([Environment]::TickCount64 - $ref) -ge $need) { break }
        }
        else { $quietSince = 0 }
        Start-Sleep -Milliseconds ([Math]::Min(80, [Math]::Max(10, $need / 2)))
    }
    $ms = [int]([Environment]::TickCount64 - $t0)
    $script:CdpSettleNote = if ($note) { "CDP 等待: $note，共 ${ms}ms" } else { "CDP 已稳定 ${ms}ms（readyState=$rs，在途=$infl$(if ($nav) { '，含导航' })）" }
    return $true
}
function Wait-CdpScrollIdle([int]$MaxMs = 700) {
    # 滚动落定：scrollX/Y 连续两次读数不变即返回（替代固定 260ms 睡眠）
    try {
