function Confirm-CdpAim($t, $item) {
    # 光标到位后的闭环：页面真实收到的 mousemove(clientX/Y) 与我们换算的视口坐标比对；偏差 > 2.5 CSS px 就校准原点并重新瞄准（同一几何只验证一次，之后零开销）
    try {
        if ("$($item.Frame)" -ne '') { return }
        $o = $script:CdpState.Origin
        if ($null -eq $o) { return }
        $key = '{0}|{1:N1}|{2:N1}|{3:N3}' -f $script:CdpState.Root, $o.OX, $o.OY, $o.Scale
        if ($script:CdpState.Verified -eq $key) { return }
        Start-Sleep -Milliseconds 30
        $cur = [DsNative61]::CursorPos()
        $mm = ($script:Cdp.Eval('(()=>{const m=window.__dsM;return m?{x:m.x,y:m.y,age:performance.now()-m.t}:null})()', 1500) | ConvertFrom-Json)
        if ($null -eq $mm -or [double]$mm.x -lt 0 -or [double]$mm.age -gt 1500) { return }
        $exp = ConvertFrom-CdpScreenPoint $cur[0] $cur[1] $o
        $dx = [double]$mm.x - $exp[0]; $dy = [double]$mm.y - $exp[1]
        if ([Math]::Abs($dx) -le 2.5 -and [Math]::Abs($dy) -le 2.5) { $script:CdpState.Verified = $key; return }
        if ([Math]::Abs($dx) -gt 600 -or [Math]::Abs($dy) -gt 600) { return }
        $script:CdpState.CalX += ($cur[0] - [double]$mm.x * $o.Scale) - $o.OX
        $script:CdpState.CalY += ($cur[1] - [double]$mm.y * $o.Scale) - $o.OY
        $t2 = Resolve-CdpItemTarget $item $t.n
        $script:CdpAimNote = "；CDP 光标闭环：页面实测偏差 ($([Math]::Round($dx, 1)),$([Math]::Round($dy, 1))) CSS px → 已校准原点并重新瞄准"
        $t.x = $t2.x; $t.y = $t2.y
        [DsNative61]::HumanMoveTo([int]$t.x, [int]$t.y)
        $o2 = $script:CdpState.Origin
        $script:CdpState.Verified = '{0}|{1:N1}|{2:N1}|{3:N3}' -f $script:CdpState.Root, $o2.OX, $o2.OY, $o2.Scale
    }
