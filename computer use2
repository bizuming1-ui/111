    $stagedScript = Join-Path $codeDir 'DeepSeekComputerUse.ps1'
    if ($SourceScript -and (Test-Path -LiteralPath $SourceScript)) { Copy-Item -LiteralPath $SourceScript -Destination $stagedScript -Force; [void]$note.Add("已复制脚本 → $stagedScript") }
    else {
        $hist = $null
        try { $hist = (Get-History -Count 1 -ErrorAction Stop).CommandLine } catch { }
        if ($hist -and $hist.Length -gt 50000 -and $hist -match 'DeepSeek Computer Use v6\.4') { [System.IO.File]::WriteAllText($stagedScript, $hist, [System.Text.UTF8Encoding]::new($true)); [void]$note.Add("已从当前会话历史还原脚本 → $stagedScript") }
