function Save-Skill([string]$Task, $Trail, [int]$Steps, [int]$Secs) {
    if (-not $script:SkillsOn) { return $false }
    if ($null -eq $Trail -or $Trail.Count -eq 0) { return $false }
    if ($script:Taint.TaskInjection -or [int]$script:Taint.InjectionHits -gt 0) { return $false }   # 被注入污染过的轨迹绝不入库
    $task = Limit-Text (Protect-SkillText $Task) 90
    $trailArr = [string[]]@($Trail | ForEach-Object { Protect-SkillText "$_" })
    if (@(Find-InjectionPhrases ($task + ' ' + ($trailArr -join ' '))).Count -gt 0) { return $false }
    $p = Get-SkillsPath
    if (-not $p) { return $false }
    $store = Get-SkillStore
    $q = Get-SkillGrams $task
    $dup = $null
    foreach ($s in $store) { if ((Get-SkillScore $q (Get-SkillGrams "$($s.task)")) -ge 0.85) { $dup = $s; break } }
    if ($dup) {
        $dup.uses = [int]$dup.uses + 1
        if ($Steps -le [int]$dup.steps) { $dup.trail = $trailArr; $dup.steps = $Steps; $dup.secs = $Secs }
    }
    else {
        $store.Add([pscustomobject]@{ task = $task; trail = $trailArr; steps = $Steps; secs = $Secs; uses = 1; ts = (Get-Date).ToString('o') })
        while ($store.Count -gt 200) { $store.RemoveAt(0) }
    }
    try {
        $lines = [string[]]@(foreach ($s in $store) { $s | ConvertTo-Json -Compress -Depth 4 })
        $tmp = "$p.tmp"
        [System.IO.File]::WriteAllLines($tmp, $lines, [System.Text.UTF8Encoding]::new($false))
        Move-Item -LiteralPath $tmp -Destination $p -Force
        return $true
    }
    catch { return $false }
}
