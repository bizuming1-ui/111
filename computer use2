                if ([double]"$($vrg.w)" -lt 16 -or [double]"$($vrg.h)" -lt 16) { return 'region 的 w,h 至少 16' }
            }
        }
        'inspect' {
            if ("$($a.mode)".ToLower() -eq 'vision') {
                if ($NoVision) { return '已使用 -NoVision，禁止 inspect mode=vision（改用普通 inspect / ocr）' }
                if ($index -gt 1) { return 'inspect mode=vision 必须单独输出' }
                break
            }
            if (Test-IdValue $a.id) { if (-not $script:Elements.ContainsKey([int]"$($a.id)")) { return "元素编号 $($a.id) 不存在" } }
            elseif ($null -ne $a.x -and -not ((Test-NumValue $a.x) -and (Test-NumValue $a.y))) { return 'inspect 需要 id，或同时提供 x 和 y（都不给则检查键盘焦点）' }
        }
        'ocr' {
            if ($null -ne $a.x -and -not ((Test-NumValue $a.x) -and (Test-NumValue $a.y) -and (Test-NumValue $a.w) -and (Test-NumValue $a.h))) { return 'ocr 的区域需要同时给 x,y,w,h（都不给则识别整个前台窗口）' }
        }
    }
    return $null
}
#endregion
#region ---------- 动作执行（分层精确） ----------
function Test-HitTarget($item, [int]$x, [int]$y, [switch]$Strict) {
    if ($item.Cdp) { return (Test-CdpHit $item $x $y) }   # v6.3
    # 目标点处「实际」的 UIA 元素必须是目标本身、其后代，或其近亲祖先。
    # -Strict（坐标吸附用）：只接受「命中元素本身或其后代」。
    # 非 Strict（物理点击前核对）：跨窗口遮挡已由 RootAt 严格拦截；同窗口内只拦截菜单 / 弹出窗口类遮挡，避免 Chrome 页面里的误判。
    try {
        $AE = [System.Windows.Automation.AutomationElement]
        $hit = $AE::FromPoint([System.Windows.Point]::new([double]$x, [double]$y))
        if ($null -eq $hit) { return (-not $Strict) }
        $w = [System.Windows.Automation.TreeWalker]::ControlViewWalker
        $cur = $hit
        for ($i = 0; $i -lt 10 -and $null -ne $cur; $i++) {
            if ([System.Windows.Automation.Automation]::Compare($cur, $item.El)) { return $true }
            $cur = $w.GetParent($cur)
        }
        if ($Strict) { return $false }
        $cur = $item.El
        for ($i = 0; $i -lt 3 -and $null -ne $cur; $i++) {
            $cur = $w.GetParent($cur)
            if ($null -ne $cur -and [System.Windows.Automation.Automation]::Compare($cur, $hit)) { return $true }
        }
        $ht = ($hit.Current.ControlType.ProgrammaticName -replace '^ControlType\.', '')
        if ($ht -in @('Menu', 'MenuItem', 'Window')) { return $false }
        return $true
    }
    catch { return $true }   # 无法核验时不误杀
}
function Find-ElementAtPoint([int]$x, [int]$y) {
    # 坐标 → 已观察控件：点必须落在某个带 UIA 模式的控件矩形内，且「实时」命中的确实是它（Strict），取面积最小者
    if ($script:Mode -notin 'Auto', 'Uia') { return $null }
    try {
        $best = $null; $bestId = 0; $bestArea = [double]::MaxValue
        $snapMax = [Math]::Pow(320.0 * [DsNative61]::DpiScale(), 2)   # v5：日志任务6第2步坐标被吸附到整页大小的 Hyperlink 并 Invoke 了它
        foreach ($kv in $script:Elements.GetEnumerator()) {
            $it = $kv.Value
            if ($it.Type -eq 'Text' -or $it.Pat.Count -eq 0 -or $it.Off) { continue }
            if (([double]$it.W * [double]$it.H) -gt $snapMax) { continue }
            if ($x -ge $it.L -and $x -le ($it.L + $it.W) -and $y -ge $it.T -and $y -le ($it.T + $it.H)) {
                $area = [double]$it.W * [double]$it.H
                if ($area -lt $bestArea) { $best = $it; $bestId = [int]$kv.Key; $bestArea = $area }
            }
        }
        if ($null -ne $best -and (Test-HitTarget $best $x $y -Strict)) { return @{ Id = $bestId; Item = $best } }
    }
    catch { }
    return $null
}
function Resolve-Target($a) {
    $vx = [DsNative61]::VirtX(); $vy = [DsNative61]::VirtY(); $vw = [DsNative61]::VirtW(); $vh = [DsNative61]::VirtH()
    if (Test-IdValue $a.id) {
        $n = [int]"$($a.id)"
        if (-not $script:Elements.ContainsKey($n)) { throw "元素编号 $n 不存在（当前只有 $($script:Elements.Count) 个元素）" }
        $item = $script:Elements[$n]
        if ($item.Cdp) { return (Resolve-CdpItemTarget $item $n) }   # v6.3：CDP 条目用 backendNodeId 实时重算几何 + 命中检查
        # 发送前重新核对：控件还在、没被隐藏、没被禁用、名称没变、位置没有大幅漂移 —— 并使用「此刻」的精确坐标
        $liveName = ''; $r = $null; $enabled = $true; $offscreen = $false
        try {
            $cur = $item.El.Current
            $r = $cur.BoundingRectangle
            $enabled = [bool]$cur.IsEnabled
            $offscreen = [bool]$cur.IsOffscreen
            $liveName = $cur.Name
            if ([string]::IsNullOrWhiteSpace($liveName) -and $item.Type -ne 'Text') { $liveName = $cur.AutomationId }
        }
        catch {
            # v4.1：元素引用失效（网页重绘常见）时，先按名称+类型+就近位置重新找回，再核对
            if (Update-ItemElement $item) {
                try {
                    $cur = $item.El.Current
                    $r = $cur.BoundingRectangle
                    $enabled = [bool]$cur.IsEnabled
                    $offscreen = [bool]$cur.IsOffscreen
                    $liveName = $cur.Name
                    if ([string]::IsNullOrWhiteSpace($liveName) -and $item.Type -ne 'Text') { $liveName = $cur.AutomationId }
                }
                catch { throw "控件 [$n] $($item.Type) `"$($item.Name)`" 已不存在（界面已变化），请重新观察后再操作" }
            }
            else { throw "控件 [$n] $($item.Type) `"$($item.Name)`" 已不存在（界面已变化），请重新观察后再操作" }
        }
        if ($r.IsEmpty -or $offscreen) { throw "控件 [$n] `"$($item.Name)`" 已不可见（视口外的列表行请用 select_rows / check，无需先滚动），请重新观察" }
        if (-not $enabled) { throw "控件 [$n] `"$($item.Name)`" 当前被禁用，点击不会有效果" }
        if ($item.Name -and (Limit-Text $liveName 80) -ne $item.Name) { throw "控件 [$n] 的名称已由 `"$($item.Name)`" 变为 `"$(Limit-Text $liveName 40)`"，界面已变化，请重新观察" }
        $lx0 = [int]($r.Left + $r.Width / 2); $ly0 = [int]($r.Top + $r.Height / 2)
        $vr = Get-ClipRect $r (Get-ViewBounds)
        if ($vr.IsEmpty) { throw "控件 [$n] `"$($item.Name)`" 已不可见（在窗口/屏幕之外），请重新观察" }
        $lx = [int]($vr.Left + $vr.Width / 2); $ly = [int]($vr.Top + $vr.Height / 2)
        $dA = [Math]::Sqrt([Math]::Pow($lx - $item.cx, 2) + [Math]::Pow($ly - $item.cy, 2)); $dB = [Math]::Sqrt([Math]::Pow($lx0 - $item.cx, 2) + [Math]::Pow($ly0 - $item.cy, 2))
        $drift = [Math]::Min($dA, $dB)
        $tol = Get-DriftTolerance $item
        if ($drift -gt $tol) { throw "控件 [$n] 位置已偏移 $([int]$drift) 像素（容差 $tol），界面已变化，请重新观察" }
        if ($lx -le 1 -and $ly -le 1) { throw '目标坐标位于屏幕左上角保护区，拒绝操作。' }
        return @{ x = $lx; y = $ly; label = "[$n] $($item.Type) $($item.Name)"; item = $item; byId = $true }
    }
    if ((Test-NumValue $a.x) -and (Test-NumValue $a.y)) {
        $px = [Math]::Min([Math]::Max([int]$a.x, $vx + 2), $vx + $vw - 3)
        $py = [Math]::Min([Math]::Max([int]$a.y, $vy + 2), $vy + $vh - 3)
        if ($px -le 1 -and $py -le 1) { throw '目标坐标位于屏幕左上角保护区，拒绝操作。' }
        $snap = Find-ElementAtPoint $px $py
        if ($snap) {
            return @{ x = $px; y = $py; label = "($px,$py) ≈ [$($snap.Id)] $($snap.Item.Type) $($snap.Item.Name)"; item = $snap.Item }
        }
        return @{ x = $px; y = $py; label = "($px,$py)"; item = $null }
    }
    throw '需要提供 id，或者 x 和 y 坐标'
}
function Update-ItemElement($item) {
    # 重新定位控件：同名同类型的候选里取离原位置最近的，且必须在 80 像素以内
    if ([string]::IsNullOrWhiteSpace($item.FullName)) { return $false }
    try {
        $AE = [System.Windows.Automation.AutomationElement]
        $root = $AE::FromHandle($script:ObsHwnd)
        $c1 = [System.Windows.Automation.PropertyCondition]::new($AE::NameProperty, [string]$item.FullName)
        $ctName = [string]$item.Type
        $c2 = [System.Windows.Automation.PropertyCondition]::new($AE::ControlTypeProperty, [System.Windows.Automation.ControlType]::$ctName)
        $cond = [System.Windows.Automation.AndCondition]::new($c1, $c2)
        $col = $root.FindAll([System.Windows.Automation.TreeScope]::Descendants, $cond)
        $best = $null; $bestD = [double]::MaxValue
        foreach ($el in $col) {
            try {
                $r = $el.Current.BoundingRectangle
                if ($r.IsEmpty) { continue }
                $d = [Math]::Sqrt([Math]::Pow(($r.Left + $r.Width / 2) - $item.cx, 2) + [Math]::Pow(($r.Top + $r.Height / 2) - $item.cy, 2))
                if ($d -lt $bestD) { $bestD = $d; $best = $el }
            }
            catch { continue }
        }
        if ($null -ne $best -and $bestD -le (Get-DriftTolerance $item)) { $item.El = $best; return $true }
    }
    catch { }
    return $false
}
function Test-HasTarget($a) { return ((Test-IdValue $a.id) -or ((Test-NumValue $a.x) -and (Test-NumValue $a.y))) }
function Assert-PhysicalReady($t) {
    Wait-UserIdle
    $hit = [DsNative61]::RootAt($t.x, $t.y)
    if ($script:Cur -and $hit -eq $script:Cur.Hwnd) { return }
    if ($hit -ne [IntPtr]::Zero -and (Test-IsConsoleWindow $hit)) {
        # v5：日志任务6里 8 次因此失败。先把控制台最小化让位、切回目标窗口，再核对一次
        if (Invoke-ConsoleYield) { $hit = [DsNative61]::RootAt($t.x, $t.y) }
        if ($hit -ne [IntPtr]::Zero -and (Test-IsConsoleWindow $hit)) { throw '目标点位于运行本脚本的控制台窗口上，已取消（避免误点自己）。' }
    }
    if ($t.item) {
        $expect = [DsNative61]::Root($script:ObsHwnd)
        if ($hit -ne $expect) {
            throw "目标点 ($($t.x),$($t.y)) 当前被其他窗口遮挡 [$([DsNative61]::WinClass($hit)) / $(Limit-Text ([DsNative61]::WinText($hit)) 30)]，已取消点击（未发送任何输入）。"
        }
        if (-not (Test-HitTarget $t.item $t.x $t.y)) { throw "目标点 ($($t.x),$($t.y)) 处被菜单 / 弹出层遮挡，实际不是 $($t.label)，已取消点击。" }
    }
}
function Test-MessageFriendly([int]$hwnd) {
    # 排除已知会忽略 PostMessage 鼠标消息的框架
    if ($hwnd -eq 0) { return $false }
    $root = [DsNative61]::Root([IntPtr]$hwnd)
    $cls = [DsNative61]::WinClass($root)
    return ($cls -notmatch '^(Chrome_|MozillaWindowClass|ApplicationFrameWindow|Windows\.UI\.|WinUIDesktop|Qt\d*QWindow|SunAwt|ConsoleWindowClass|CASCADIA|Shell_TrayWnd|XamlExplorerHostIslandWindow)')
}
function Invoke-UiaClickOnce($item) {
    $el = $item.El
    $order = @(switch ($item.Type) {
            'CheckBox' { 'tog', 'sel', 'inv' }
            'RadioButton' { 'sel', 'inv', 'tog' }
            { $_ -in 'ListItem', 'TabItem', 'DataItem', 'TreeItem' } { 'sel', 'inv', 'exp' }
            'ComboBox' { 'exp', 'inv' }
            'Edit' { 'focus' }
            default { 'inv', 'tog', 'sel', 'exp' }
        })
    foreach ($o in $order) {
        if ($o -eq 'focus') {
            try { $el.SetFocus(); return 'UIA 聚焦' } catch { continue }
        }
        if ($item.Pat -notcontains $o) { continue }
        try {
            switch ($o) {
                'inv' {
                    $p = $el.GetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern)
                    if (Invoke-Worker { param($p) $p.Invoke() } $p 1500) { return 'UIA Invoke' }
                    return 'UIA Invoke（1.5 秒内未返回，可能弹出了对话框）'
                }
                'tog' {
                    $p = $el.GetCurrentPattern([System.Windows.Automation.TogglePattern]::Pattern)
                    $was = "$($p.Current.ToggleState)".ToLower()
                    $p.Toggle()
                    $now = $was
                    $tEnd = (Get-Date).AddMilliseconds(1200)
                    do {
                        Start-Sleep -Milliseconds 60
                        try { $now = "$($p.Current.ToggleState)".ToLower() } catch { break }
                    } while ($now -eq $was -and (Get-Date) -lt $tEnd)
                    $script:LastClickState = $now
                    $conf = if ($now -eq $was) { '（1.2 秒内读回未变化，可能未生效）' } else { '' }
                    return "UIA Toggle：$was → 读回 $now$conf"
                }
                'sel' {
                    $p = $el.GetCurrentPattern([System.Windows.Automation.SelectionItemPattern]::Pattern)
                    $p.Select()
                    $script:LastClickState = 'selected'
                    return 'UIA Select'
                }
                'exp' {
                    $p = $el.GetCurrentPattern([System.Windows.Automation.ExpandCollapsePattern]::Pattern)
                    if ("$($p.Current.ExpandCollapseState)" -eq 'Expanded') { $p.Collapse() } else { $p.Expand() }
                    return 'UIA ExpandCollapse'
                }
            }
        }
        catch { continue }
    }
    return $null
}
function Invoke-UiaClick($item) {
    # v4.1：失败后先重新定位控件再试一次（网页重绘会让旧的元素引用失效），两次都失败才交给下一层
    $script:LastClickState = ''
    for ($attempt = 1; $attempt -le 2; $attempt++) {
        $m = Invoke-UiaClickOnce $item
        if ($m) { return $m }
        if ($attempt -eq 1) { Start-Sleep -Milliseconds 120; [void](Update-ItemElement $item) }
    }
    return $null
}
function Invoke-PointerAction([string]$kind, $a) {
    $t = Resolve-Target $a
    # v5：坐标点击必须有依据（日志任务6：模型按「图标大概在数字上方 40px」猜了 20 多次）
    if (-not $t.byId -and $null -eq $t.item -and $kind -ne 'hover' -and -not (Test-True $a.force) -and -not $NoRepeatGuard -and -not (Test-Grounded $t.x $t.y)) {
        throw "[UNGROUNDED] 坐标 ($($t.x),$($t.y)) 不在当前观察的任何控件内，也不在 inspect / ocr 给出的区域内——这是猜出来的位置。请先 inspect 该点（或 ocr 该区域）拿到真实元素和坐标；确实要点空白处时加 `"force`":true"
    }
    $human = Test-HumanTarget
    if (-not $human) { Move-VirtualCursor $t.x $t.y }   # 人类化时由真实光标的移动带动覆盖层，不再各走各的
    $item = $t.item
    if ($kind -ne 'hover') { Start-EffectProbe $t.x $t.y }   # v5：动作前采样落点周围，动作后由 Invoke-Action 对比
    if ($kind -eq 'hover') {
        Assert-PhysicalReady $t
        Set-ExpectRoot $t
        if ([DsNative61]::Humanize) { Invoke-HumanApproach $t $item } else { Set-CursorPulse 2 }
        try { [DsNative61]::PhysicalHover($t.x, $t.y, 450) } catch { throw (Get-NativeError $_) }
        return "已悬停 $($t.label)（$(if ([DsNative61]::Humanize) { '人类化物理输入：光标沿曲线移到目标并停留在那里，悬停菜单保持展开' } else { '真实鼠标仅借用 0.45 秒后已归位' })）"
    }
    $btn = switch ($kind) { 'right_click' { 1 } 'middle_click' { 2 } default { 0 } }
    $n = if ($kind -eq 'double_click') { 2 } else { 1 }
    $fallback = ''
    # ---- 第 1 层：UIA 模式（不动鼠标、不用键盘）----
    $script:LastClickState = ''
    if (($script:Mode -in 'Auto', 'Uia') -and -not $human) {
        if ($item -and $kind -eq 'click' -and (Test-UiaActionable $item)) {
            $m = Invoke-UiaClick $item
            if ($m) {
                Set-CursorPulse 0
                Start-Sleep -Milliseconds 80
                return "已点击 $($t.label)（$m；真实鼠标未被占用）"
            }
            $fallback = '（UIA 两次尝试均失败，已降级）'
        }
        if ($script:Mode -eq 'Uia') { throw "-InputMode Uia：$kind $($t.label) 无法通过无障碍接口完成" }
    }
    # ---- 第 2 层：窗口消息（仅限有独立 HWND 的经典控件）----
    $msgHwnd = [IntPtr]::Zero
    if ($script:Mode -eq 'Message') {
        if ($item -and $item.Hwnd -ne 0) { $msgHwnd = [IntPtr]$item.Hwnd }
        else { $msgHwnd = [DsNative61]::DeepChildAt([DsNative61]::RootAt($t.x, $t.y), $t.x, $t.y) }
        if ($msgHwnd -eq [IntPtr]::Zero) { throw "找不到 ($($t.x),$($t.y)) 处的窗口句柄，无法发送窗口消息" }
    }
    elseif ($script:Mode -eq 'Auto' -and -not $human -and $item -and $item.Hwnd -ne 0 -and (Test-MessageFriendly $item.Hwnd)) {
        $msgHwnd = [IntPtr]$item.Hwnd
    }
    if ($msgHwnd -ne [IntPtr]::Zero) {
        if (Test-IsConsoleWindow $msgHwnd) { throw '目标是运行本脚本的控制台，已取消。' }
        if ([DsNative61]::PostClick($msgHwnd, $t.x, $t.y, $btn, $n)) {
            Set-CursorPulse $(if ($btn -eq 1) { 1 } else { 0 })
            Start-Sleep -Milliseconds 80
            return "已发送窗口消息 $kind $($t.label)（真实鼠标未被占用；消息方式无法确认生效，请以下一步观察为准）$fallback"
        }
        if ($script:Mode -eq 'Message') { throw '窗口消息发送失败' }
    }
    # ---- 第 3 层：物理输入（先让位、再校验、借用后归位）----
    $hitNote = ''
    if ($item -and $t.byId -and -not $item.Cdp) {
        # v4.2：不盲点矩形中心，挑一个「严格命中测试」通过的落点
        try {
            $lr = Get-ClipRect $item.El.Current.BoundingRectangle (Get-ViewBounds)   # v4.3：只在可见部分内选落点
            if (-not $lr.IsEmpty) {
                $pp = Get-PrecisePoint $item $lr
                $t.x = $pp.x; $t.y = $pp.y
                $hitNote = if ($pp.verified) { '；落点已核验命中目标' } else { '；落点未能核验' }
                if (-not [DsNative61]::Humanize) { Move-VirtualCursor $t.x $t.y }
            }
        }
        catch { }
    }
    Assert-PhysicalReady $t
    Set-ExpectRoot $t
    [DsNative61]::Fixups = 0; [DsNative61]::PressGuardFixes = 0; [DsNative61]::LastPressDev = 0; [DsNative61]::LastReleaseDev = 0
    if ([DsNative61]::Humanize) { Invoke-HumanApproach $t $item }
    else {
        Set-CursorPulse $(if ($btn -eq 1) { 1 } else { 0 })
        if ($n -eq 2) { Start-Sleep -Milliseconds 90; Set-CursorPulse 0 }
    }
    try { [DsNative61]::PhysicalClick($t.x, $t.y, $btn, $n, $true) } catch { throw (Get-NativeError $_) }
    $rcpt = ''
    if ([DsNative61]::Humanize) { $rcpt = "；回执：按下前光标偏差 $([DsNative61]::LastPressDev)px、释放后偏差 $([DsNative61]::LastReleaseDev)px、落点修正 $([DsNative61]::Fixups) 次" }
    $how = if ([DsNative61]::Humanize) { "人类化物理输入：光标沿曲线移到目标→核对位置与遮挡→悬停→按下抬起，光标停在目标上$hitNote" } else { "物理输入$hitNote；真实鼠标瞬时借用并已归位" }
    $aim = "$($script:CdpAimNote)"; $script:CdpAimNote = ''
    return "已执行 $kind $($t.label)（$how；页面弹窗可能稍后才出现，以下一轮的『界面变化』为准）$fallback$rcpt$aim"
}
function Invoke-ClickMany($a) {
    # 一次点击/勾选多个控件。每个控件执行前都会实时核对（名称/位置/可见/可用）；任一失败即中止，并报告已完成的部分（不会回滚）。
    $ids = @($a.ids)
    $done = [System.Collections.Generic.List[string]]::new()
    foreach ($i in $ids) {
        Test-Abort
        try {
            $r = Invoke-PointerAction 'click' ([pscustomobject]@{ id = $i })
            $st = if ($script:LastClickState) { "→$($script:LastClickState)" } else { '' }
            $done.Add("[$i]$st")
        }
        catch {
            if ($_.Exception.Message -like '触发保护*') { throw }
            $prog = if ($done.Count -gt 0) { "已完成 $($done.Count)/$($ids.Count) 个（$($done -join ' ')）；" } else { '' }
            throw "${prog}第 [$i] 个失败并中止其余: $($_.Exception.Message)"
        }
        Start-Sleep -Milliseconds 60
    }
    return "已依次点击 $($ids.Count) 个控件: $($done -join ' ')（状态为 UIA 读回值；请以下一轮观察的『复选框汇总』核对）"
}
function Invoke-DragAction($a) {
    $s = Resolve-Target ([pscustomobject]@{ id = $a.from_id; x = $a.from_x; y = $a.from_y })
    $d = Resolve-Target ([pscustomobject]@{ id = $a.to_id; x = $a.to_x; y = $a.to_y })
    if ([DsNative61]::Humanize) {
        Assert-PhysicalReady $s
        Set-ExpectRoot $s
        try { [DsNative61]::PhysicalDrag($s.x, $s.y, $d.x, $d.y, 28) } catch { throw (Get-NativeError $_) }
        return "已拖拽 $($s.label) → $($d.label)（人类化物理输入：移到起点→按住→沿曲线拖到终点→停顿→松开；光标停在终点）"
    }
    Move-VirtualCursor $s.x $s.y
    Assert-PhysicalReady $s
    if ($script:Cur) { $script:Cur.SetPressed($true); $script:Cur.MoveTo([double]$d.x, [double]$d.y, 320) }
    try { [DsNative61]::PhysicalDrag($s.x, $s.y, $d.x, $d.y, 28) }
    finally {
        if ($script:Cur) { [void]$script:Cur.WaitIdle(1500); $script:Cur.SetPressed($false) }
    }
    return "已拖拽 $($s.label) → $($d.label)（物理输入；真实鼠标已归位）"
}
function Invoke-TypeAction($a) {
    $text = "$($a.text)"
    $clear = Test-True $a.clear
    $enter = Test-True $a.enter
    $item = $null
    $label = ''
    if (Test-HasTarget $a) {
        $t = Resolve-Target $a
        $item = $t.item
        $label = " 到 $($t.label)"
        if (-not (Test-HumanTarget)) { Move-VirtualCursor $t.x $t.y }
        Set-CursorPulse 2
    }
    $hType = Test-HumanTarget   # 浏览器里不直接 SetValue：真人是点进去再敲字，页面的 focus / input / key 事件才完整
    $done = $false
    $note = ''
    # ---- 第 1 层：ValuePattern 直接写值（不用键盘、不动鼠标）----
    if ($item -and -not $hType -and $script:Mode -ne 'Physical' -and $script:Mode -ne 'Message') {
        try { $item.El.SetFocus() } catch { }
        if ($item.Pat -contains 'val') {
            try {
                $vp = $item.El.GetCurrentPattern([System.Windows.Automation.ValuePattern]::Pattern)
                if (-not $vp.Current.IsReadOnly) {
                    $old = "$($vp.Current.Value)"
                    $new = if ($clear) { $text } else { $old + $text }
                    $vp.SetValue($new)
                    Start-Sleep -Milliseconds 80
                    $back = "$($vp.Current.Value)"
                    if ($back -eq $new) { $done = $true; $note = "（UIA 直接写入；读回值=$(Limit-Text $back 60)）" }
                    else { try { $vp.SetValue($old) } catch { } }   # 控件改写了内容：还原，改走键盘
                }
            }
            catch { }
        }
        if ($script:Mode -eq 'Uia' -and -not $done) { throw "-InputMode Uia：控件 $($item.Name) 不支持 ValuePattern 写值" }
    }
    # ---- 第 3 层：键盘（SendInput）----
    if (-not $done) {
        if ($item) {
            $focused = $false
            try { $focused = [bool]$item.El.Current.HasKeyboardFocus } catch { }
            if ($item.Cdp) { $focused = Test-CdpFocused $item }   # v6.3：已聚焦就不再多点一次
            if (-not $focused) {
                $t2 = Resolve-Target $a
                Assert-PhysicalReady $t2
                Set-ExpectRoot $t2
                if ([DsNative61]::Humanize) { Invoke-HumanApproach $t2 $item }
                try { [DsNative61]::PhysicalClick($t2.x, $t2.y, 0, 1, $true) } catch { throw (Get-NativeError $_) }
                Start-Sleep -Milliseconds 120
            }
        }
        Assert-KeyboardReady
        if ($clear) { Send-KeyCombo 'ctrl+a'; Start-Sleep -Milliseconds 40; Send-KeyCombo 'backspace'; Start-Sleep -Milliseconds 40 }
        Send-Text $text
        $note = '（键盘输入）'
        if ($item -and $item.Cdp) {
            $back = Get-CdpValue $item   # v6.3：用 CDP 读回输入框的真实值
            if ($null -ne $back) {
                $tail = if ($text.Length -gt 20) { $text.Substring($text.Length - 20) } else { $text }
                $note = if ($back.Contains($tail)) { "（键盘输入；CDP 读回值包含所输入文本 ✓）" } else { "（键盘输入；CDP 读回值=$(Limit-Text $back 60)，与预期不符，请核对）" }
            }
        }
        if ($item -and $item.Pat -contains 'val') {
            try {
                $back = "$($item.El.GetCurrentPattern([System.Windows.Automation.ValuePattern]::Pattern).Current.Value)"
                $tail = if ($text.Length -gt 20) { $text.Substring($text.Length - 20) } else { $text }
                $note = if ($back.Contains($tail)) { "（键盘输入；读回值包含所输入文本 ✓）" } else { "（键盘输入；读回值=$(Limit-Text $back 60)，与预期不符，请核对）" }
            }
            catch { }
        }
    }
    if ($enter) { Assert-KeyboardReady; Start-Sleep -Milliseconds 100; Send-KeyCombo 'enter' }
    return "已输入文本$label$note"
}
function Find-ScrollPattern($el) {
    $AE = [System.Windows.Automation.AutomationElement]
    $w = [System.Windows.Automation.TreeWalker]::ControlViewWalker
    $cur = $el
    for ($i = 0; $i -lt 8 -and $null -ne $cur; $i++) {
        try {
            if ($cur.GetCurrentPropertyValue($AE::IsScrollPatternAvailableProperty) -eq $true) {
                $sp = $cur.GetCurrentPattern([System.Windows.Automation.ScrollPattern]::Pattern)
                if ($sp.Current.VerticallyScrollable) { return $sp }
            }
        }
        catch { }
        try { $cur = $w.GetParent($cur) } catch { $cur = $null }
    }
    return $null
}
function Invoke-ScrollAction($a) {
    $dir = if ("$($a.direction)".ToLower() -eq 'up') { 1 } else { -1 }
    $amount = if ($a.amount) { [int]$a.amount } else { 3 }
    $amount = [Math]::Min([Math]::Max($amount, 1), 30)
    if (Test-HasTarget $a) { $t = Resolve-Target $a }
    else {
        $r = [DsNative61]::WinRect($script:ObsHwnd)
        $t = @{ x = [int](($r[0] + $r[2]) / 2); y = [int](($r[1] + $r[3]) / 2); label = '窗口中心'; item = $null }
    }
    $hs = Test-HumanTarget
    if (-not $hs) { Move-VirtualCursor $t.x $t.y }
    if ($t.item -and ($script:Mode -in 'Auto', 'Uia') -and -not $hs) {
        $sp = Find-ScrollPattern $t.item.El
        if ($sp) {
            $amt = if ($dir -lt 0) { [System.Windows.Automation.ScrollAmount]::SmallIncrement } else { [System.Windows.Automation.ScrollAmount]::SmallDecrement }
            for ($i = 0; $i -lt ($amount * 3); $i++) { $sp.Scroll([System.Windows.Automation.ScrollAmount]::NoAmount, $amt) }
            return "已滚动 $($a.direction) x$amount（UIA ScrollPattern；真实鼠标未被占用）"
        }
        if ($script:Mode -eq 'Uia') { throw '-InputMode Uia：该区域没有可用的 ScrollPattern' }
    }
    Assert-PhysicalReady $t
    Set-ExpectRoot $t
    try { [DsNative61]::PhysicalWheel($t.x, $t.y, $dir * $amount, $true) } catch { throw (Get-NativeError $_) }
    if (Test-CdpForeground) { Wait-CdpScrollIdle } elseif ([DsNative61]::Humanize) { Start-Sleep -Milliseconds 260 }   # v6.3：CDP 读 scrollY 落定即返回   # 网页的平滑滚动需要时间落定，之后的观察才是稳定画面
    return "已滚动 $($a.direction) x$amount（$(if ([DsNative61]::Humanize) { '人类化物理滚轮：光标移到滚动区域→停顿→逐格滚动，光标停在原处' } else { '物理滚轮；真实鼠标已归位' })）"
}
function Focus-WindowByTitle([string]$keyword) {
    if ([string]::IsNullOrWhiteSpace($keyword)) { throw 'focus_window 需要 title（窗口标题或进程名关键字）' }
    $all = @(Get-TopWindowList 80)
    $p = $all | Where-Object { $_.Title -like "*$keyword*" } | Select-Object -First 1
    if (-not $p) { $p = $all | Where-Object { $_.Process -like "*$keyword*" } | Select-Object -First 1 }
    if (-not $p) { throw "找不到标题或进程名包含 '$keyword' 的窗口" }
    if (-not [DsNative61]::Activate($p.Handle)) { throw "无法把窗口 [$($p.Title)] 切到前台（可能被系统前台锁阻止，或目标权限更高：请用 -RunAsAdmin）" }
    $script:ObsHwnd = [DsNative61]::GetForegroundWindow()
    return "已切换到窗口: $($p.Title)"
}
function Describe-Action($a) {
    $parts = @("action=$($a.action)")
    foreach ($k in 'id', 'ids', 'rows', 'exclusive', 'x', 'y', 'w', 'h', 'r', 'repeat', 'force', 'text', 'keys', 'direction', 'amount', 'target', 'args', 'title', 'seconds', 'command', 'from_id', 'to_id', 'path', 'file', 'cwd', 'timeout', 'append', 'mode', 'detail', 'vision_grounded') {
        $v = "$($a.$k)"
        if ($null -ne $a.$k -and $v -ne '') { $parts += ("{0}={1}" -f $k, (Limit-Text $v 80)) }
    }
    return ($parts -join ' ')
}
function Invoke-ShellCommand([string]$cmd, [int]$timeoutSec = 0) {
    $to = if ($timeoutSec -gt 0) { [Math]::Min($timeoutSec, 900) } else { $ShellTimeoutSec }
    if (-not $NoSafety) {
        $hit = Test-DangerousCommand $cmd
        if ($hit) { throw "命令命中灾难性命令黑名单 ($hit)，已拒绝（如确需执行请使用 -NoSafety）" }
    }
    $sb = New-SafeScriptBlock $cmd   # v6.4：AST 审计通过后才创建；运行时 CLM + 固定工作目录
    $job = $null
    if (Get-Command Start-ThreadJob -ErrorAction SilentlyContinue) { $job = Start-ThreadJob -ScriptBlock $sb }
    else { $job = Start-Job -ScriptBlock $sb }
    try {
        if (-not (Wait-Job $job -Timeout $to)) {
            Stop-Job $job -ErrorAction SilentlyContinue
            throw "命令超过 $to 秒未完成，已终止"
        }
        $out = & { $ErrorActionPreference = 'Continue'; Receive-Job $job 2>&1 | Out-String }
        return "命令输出: $(Limit-Text $out 1800)"
    }
    finally { Remove-Job $job -Force -ErrorAction SilentlyContinue }
}
function Invoke-Launch($a) {
    $target = "$($a.target)"
    $before = [DsNative61]::GetForegroundWindow()
    $known = Get-TopHandles
    $script:LaunchStamp = Get-Date
    $argStr = "$($a.args)"
    # v6.3：Chrome / Edge / Brave 默认以「隔离 Profile + 远程调试端口」启动，由 CDP 负责感知与等待；-NoCdp 或失败时回到 v6.2 的 --force-renderer-accessibility
    $cdpLa = $null
    if ((Test-CdpEnabled) -and ($target -match '(?i)(^|[\\/])(chrome|msedge|brave)(\.exe)?$')) {
        try { $cdpLa = Start-CdpBrowser $target $argStr }
        catch { $cdpLa = $null; Write-Host "  CDP 隔离启动失败，改用普通启动: $(Limit-Text $_.Exception.Message 120)" -ForegroundColor DarkYellow }
    }
    if ($null -eq $cdpLa) {
        # Chrome / Edge：自动打开渲染器无障碍，网页内容才会出现在控件列表里
        if ($target -match '(?i)(^|[\\/])(chrome|msedge)(\.exe)?$' -and $argStr -notmatch 'force-renderer-accessibility') {
            $argStr = ('--force-renderer-accessibility ' + $argStr).Trim()
        }
        if ($argStr) { Start-Process -FilePath $target -ArgumentList $argStr }
        else { Start-Process -FilePath $target }
    }
    # 等待：前台窗口变化，或出现新的顶层窗口（最多 5 秒）
    $end = (Get-Date).AddSeconds(5)
    $newHandle = [IntPtr]::Zero
    while ((Get-Date) -lt $end) {
        Test-Abort
        Start-Sleep -Milliseconds 120
        if ([DsNative61]::GetForegroundWindow() -ne $before) { break }
        foreach ($line in [DsNative61]::TopWindows([uint32]$PID, 100)) {
            $hs = $line.Split('|', 3)[0]
            if (-not $known.Contains($hs)) { $newHandle = [IntPtr][int64]$hs; break }
        }
        if ($newHandle -ne [IntPtr]::Zero) { break }
    }
    if ($newHandle -ne [IntPtr]::Zero -and [DsNative61]::GetForegroundWindow() -ne $newHandle) { [void][DsNative61]::Activate($newHandle) }
    $cdpNote = ''
    if ($cdpLa) {
        $cdpUp = Wait-CdpEndpoint ([int]$cdpLa.Port) 3000
        $cdpNote = if ($cdpUp) { "；CDP 隔离实例已就绪（端口 $($cdpLa.Port)，Profile $($cdpLa.Profile)）" } else { '；CDP 端点未就绪（本轮回退 UIA 感知）' }
        if ($cdpLa.Warn) { $cdpNote += "；$($cdpLa.Warn)" }
        Start-Sleep -Milliseconds $(if ($cdpUp) { 120 } else { 450 })
    }
    else { Start-Sleep -Milliseconds 450 }
    $now = [DsNative61]::GetForegroundWindow()
    $script:ObsHwnd = $now
    Add-LaunchedToJob $now $newHandle   # v6.4：新启动的应用进入应用作业（退出代理即清理）
    $tail = if ($now -eq $before) { '；前台窗口未变化（程序可能已在运行或在后台打开，必要时用 focus_window）' } else { "；前台窗口: [$(Limit-Text ([DsNative61]::WinText($now)) 50)]" }
    return "已启动 $target$tail$cdpNote"
}
function Invoke-ActionCore($a, [string]$kind) {
    switch ($kind) {
        { $_ -in 'click', 'double_click', 'right_click', 'middle_click', 'hover' } { return (Invoke-PointerAction $kind $a) }
        'click_many' { return (Invoke-ClickMany $a) }
        'check' { return (Invoke-CheckAction $a $true) }
        'uncheck' { return (Invoke-CheckAction $a $false) }
        'select_rows' { return (Invoke-SelectRows $a) }
        'drag' { return (Invoke-DragAction $a) }
        'type' { return (Invoke-TypeAction $a) }
        { $_ -in 'key', 'hotkey' } {
            Assert-KeyboardReady
            Send-KeySequence "$($a.keys)"
            return "已按键 $($a.keys)"
        }
        'scroll' { return (Invoke-ScrollAction $a) }
        'launch' { return (Invoke-Launch $a) }
        'focus_window' { return (Focus-WindowByTitle "$($a.title)") }
        'wait' {
            $s = if ($a.seconds) { [double]$a.seconds } else { 1 }
            $s = [Math]::Min([Math]::Max($s, 0.2), 30)
            Wait-Safe ([int]($s * 1000))
            return "已等待 $s 秒"
        }
        'run_powershell' { return (Invoke-ShellCommand "$($a.command)" $(if (Test-NumValue $a.timeout) { [int][double]"$($a.timeout)" } else { 0 })) }
        'write_file' { return (Invoke-WriteFile $a) }
        'run_process' { return (Invoke-ProcessAction $a) }
        'inspect' {
            if ("$($a.mode)".ToLower() -eq 'vision') { return (Request-VisionInspect $a) }
            return (Invoke-InspectAction $a)
        }
        'vision_inspect' { return (Request-VisionInspect $a) }
        'ocr' { return (Invoke-OcrAction $a) }
        default { throw "未知动作: '$($a.action)'" }
    }
}
function Invoke-Action($a) {
    $kind = "$($a.action)".ToLower().Trim()
    Assert-ActionPolicy $a $kind   # v6.4：所有动作在此强制经过策略门（路径牢笼 / AST / 污点 / HITL），不依赖模型自觉
    $script:EffectProbe = $null; $script:LastEffect = $null
    [DsNative61]::ExpectRoot = [IntPtr]::Zero
    Assert-BulkInterlock $a $kind   # v4.2：数量联锁（删除/归档/全选前核对已勾选行数）
    $before = [DsNative61]::GetForegroundWindow()
    if ($kind -notin 'launch', 'focus_window', 'wait', 'run_powershell', 'write_file', 'run_process', 'inspect', 'ocr', 'vision_inspect') { Set-CdpActionEpoch }   # v6.3
    $r = Invoke-ActionCore $a $kind
    if ($kind -notin 'launch', 'focus_window', 'wait', 'run_powershell', 'write_file', 'run_process', 'inspect', 'ocr', 'vision_inspect') {
        if (-not (Test-CdpForeground)) { Start-Sleep -Milliseconds 60 }   # v6.4：CDP 前台由 Wait-CdpSettled 确定性等待，不再固定多睡 60ms
        $script:CdpSettleNote = ''
        Wait-UiSettled
        if ($script:CdpSettleNote) { $r += "；$($script:CdpSettleNote)" }
        $after = [DsNative61]::GetForegroundWindow()
        if ($after -ne $before) { $r += "；前台窗口已变为 [$(Limit-Text ([DsNative61]::WinText($after)) 50)]" }
        $fx = Complete-EffectProbe   # v5：局部视觉证据
        if ($fx) { $script:LastEffect = $fx; $r += "；$($fx.Text)" }
    }
    return $r
}
