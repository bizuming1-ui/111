#region ---------- v6.2 第一阶段：UIA 主通道 + Set-of-Mark 标注截图 + DeepSeek 视觉兜底（按需触发） ----------
# 设计要点（只加深、不加大；C# 原生层 DsNative61 / DsOverlay61 / DsTestTarget61 逐字未改）：
#  1) 视觉通道只在「UIA 盲区 / 执行受阻 / 模型显式 vision_inspect」时触发；常规步骤与规划继续走 $Model。UIA 永远是主通道。
#  2) 每次请求只带「当前这一帧」图片，图片只放在 user 消息里（assistant 消息带图会 400）；历史里只留文本摘要，旧截图不会进入下一轮。
#  3) 系统提示词与文本轮次逐字相同（DeepSeek 上下文缓存按前缀命中，不因视觉轮次而失效）；视觉说明放在 user 文本末尾。
#  4) 坐标闭环：图像坐标 → 物理屏幕坐标 = (offset + x / scale)；落在截图窗口内的坐标自动记为 vision_grounded，通过 UNGROUNDED 校验。
$script:VisionTurns = 0
$script:VisionFails = 0
$script:VisionMaxTurns = 12        # 单任务最多视觉轮数（成本 / 延迟上限）
$script:VisionRequest = $null      # vision_inspect 写入，下一轮观察时消费
$script:BlockErrStreak = 0         # 连续 REPEAT_NOEFFECT / UNGROUNDED 次数
$script:LastVision = $null
$script:Http = $null
$script:LastApiMs = 0
# 8 种高对比、白字可读的 SoM 颜色（按编号循环）
$script:SomPalette = @(@(220, 20, 60), @(0, 102, 230), @(200, 0, 170), @(235, 110, 0), @(0, 150, 70), @(120, 50, 210), @(0, 140, 150), @(180, 40, 40))
function Reset-VisionTaskState {
    $script:VisionTurns = 0; $script:VisionFails = 0
    $script:VisionRequest = $null; $script:BlockErrStreak = 0; $script:LastVision = $null
}
function Test-VisionReady {
    # 视觉通道当前是否可用：未关闭、未熔断（连续 3 次失败）、本任务未超过轮数上限
    if ($NoVision -or [string]::IsNullOrWhiteSpace($VisionModel)) { return $false }
    if ([int]$script:VisionFails -ge 3) { return $false }
    if ([int]$script:VisionTurns -ge [int]$script:VisionMaxTurns) { return $false }
    return $true
}
function ConvertTo-VisionDetail($d) {
    $s = "$d".ToLower().Trim()
    if ($s -eq 'low') { return 'low' }
    return 'original'   # original / high / auto / 空 → original（官方：high 与 original 等价）
}
function Get-LedgerBlockStreak($ledger) {
    # 动作账本末尾连续「无效果（ineffective）」的条数
    $n = 0
    $arr = @($ledger)
    for ($i = $arr.Count - 1; $i -ge 0; $i--) {
        if ($null -ne $arr[$i] -and $arr[$i].Outcome -eq 'nochange') { $n++ } else { break }
    }
    return $n
}
function Test-ShouldEscalateToVision($obs, $ledger = $script:Ledger) {
    # 自适应路由状态机（感知阶段调用一次）：UIA 永远先行，满足下列任一条件才升级到视觉兜底
    #   EXPLICIT  : 模型输出 vision_inspect（或 inspect + mode=vision）
    #   UIA_BLIND : 前台非控制台窗口的可交互 UIA 控件数 < 6（画布 / 游戏 / 远程桌面 / 自绘界面）
    #   BLOCKED   : 连续 >= 2 次 ineffective（账本无效果）/ REPEAT_NOEFFECT / UNGROUNDED
    $no = [pscustomobject]@{ Use = $false; Reason = ''; Why = ''; Detail = 'original'; Region = $null }
    if (-not (Test-VisionReady)) { return $no }
    if ($null -eq $obs -or $null -eq $obs.Foreground -or $obs.Foreground.Handle -eq [IntPtr]::Zero) { return $no }
    $req = $script:VisionRequest
    if ($null -ne $req) {
        $script:VisionRequest = $null
        return [pscustomobject]@{ Use = $true; Reason = 'EXPLICIT'; Why = '模型显式请求 vision_inspect'; Detail = (ConvertTo-VisionDetail $req.Detail); Region = $req.Region }
    }
    if ($obs.IsConsole) { return $no }
    if ($obs.CdpHint) { return [pscustomobject]@{ Use = $true; Reason = 'CDP_CANVAS'; Why = "CDP 盲区：$($obs.CdpHint)"; Detail = 'original'; Region = $null } }   # v6.3：canvas / WebGL / 验证码 / 跨进程 iframe
    $ic = if ($null -ne $obs.Inter) { [int]$obs.Inter } else { 99 }
    if ($ic -lt 6) {
        return [pscustomobject]@{ Use = $true; Reason = 'UIA_BLIND'; Why = "UIA 盲区：可交互控件 $ic 个 < 6"; Detail = 'original'; Region = $null }
    }
    $streak = (Get-LedgerBlockStreak $ledger) + [int]$script:BlockErrStreak
    if ($streak -ge 2) {
        return [pscustomobject]@{ Use = $true; Reason = 'BLOCKED'; Why = "执行受阻：连续 $streak 次无效果 / REPEAT_NOEFFECT / UNGROUNDED"; Detail = 'original'; Region = $null }
    }
    return $no
}
function Request-VisionInspect($a) {
    # vision_inspect / inspect(mode=vision) 的执行体：只登记请求，不改变界面；下一轮观察时附带标注截图
    if ($NoVision) { throw '已使用 -NoVision，视觉通道关闭，不能 vision_inspect；请改用 inspect / ocr。' }
    if (-not (Test-VisionReady)) { throw "视觉通道当前不可用（连续失败 3 次，或本任务已用满 $($script:VisionMaxTurns) 轮视觉）；请改用 inspect / ocr / 控件编号。" }
    $detail = ConvertTo-VisionDetail $a.detail
    $reg = $null
    $rg = $a.region
    if ($null -ne $rg -and (Test-NumValue $rg.x) -and (Test-NumValue $rg.y) -and (Test-NumValue $rg.w) -and (Test-NumValue $rg.h)) {
        $reg = [pscustomobject]@{ x = [int][double]"$($rg.x)"; y = [int][double]"$($rg.y)"; w = [int][double]"$($rg.w)"; h = [int][double]"$($rg.h)" }
    }
    $script:VisionRequest = [pscustomobject]@{ Detail = $detail; Region = $reg }
    $rt = if ($reg) { " region=($($reg.x),$($reg.y) $($reg.w)x$($reg.h))" } else { '' }
    return "已请求视觉观察（detail=$detail$rt）：下一轮观察会附带 SoM 标注截图，由 $VisionModel 看图后决策（本动作没有改变界面）"
}
function ConvertTo-VisionPhysical($ctx, [double]$ix, [double]$iy) {
    # 图像坐标 → 物理屏幕坐标： offset + x / scale
    return @([int][Math]::Round([double]$ctx.OffsetX + $ix / [double]$ctx.ScaleX), [int][Math]::Round([double]$ctx.OffsetY + $iy / [double]$ctx.ScaleY))
}
function ConvertTo-VisionImage($ctx, [double]$px, [double]$py) {
    # 物理屏幕坐标 → 图像坐标： (p - offset) * scale
    return @([int][Math]::Round(($px - [double]$ctx.OffsetX) * [double]$ctx.ScaleX), [int][Math]::Round(($py - [double]$ctx.OffsetY) * [double]$ctx.ScaleY))
}
function ConvertTo-VisionText([string]$text, $ctx) {
    # 视觉轮次里，文本观察中所有 @(x,y)（物理像素）改写为「当前图像坐标」，保证模型看到和输出的坐标在同一坐标系
    if ([string]::IsNullOrEmpty($text)) { return '' }
    $sb = [System.Text.StringBuilder]::new()
    $last = 0
    foreach ($m in [regex]::Matches($text, '@\((-?\d+),(-?\d+)\)')) {
        [void]$sb.Append($text, $last, $m.Index - $last)
        $p = ConvertTo-VisionImage $ctx ([double]$m.Groups[1].Value) ([double]$m.Groups[2].Value)
        [void]$sb.Append("@($($p[0]),$($p[1]))")
        $last = $m.Index + $m.Length
    }
    [void]$sb.Append($text, $last, $text.Length - $last)
    return $sb.ToString()
}
function Test-PointInVisionRect($ctx, [int]$x, [int]$y) {
    $r = $ctx.Rect
    return ($x -ge $r[0] -and $x -le $r[2] -and $y -ge $r[1] -and $y -le $r[3])
}
function Convert-VisionActionCoords($a, $ctx) {
    # 把模型在视觉轮次里给出的图像坐标就地还原为物理屏幕坐标；落在截图窗口内的点登记为 vision_grounded
    # 返回：@{ Converted = 是否含坐标；Grounded = 全部点都在窗口内 }
    $kind = "$($a.action)".ToLower().Trim()
    $converted = $false; $allIn = $true
    foreach ($pair in @(@('x', 'y'), @('from_x', 'from_y'), @('to_x', 'to_y'))) {
        $kx = $pair[0]; $ky = $pair[1]
        if (-not ((Test-NumValue $a.$kx) -and (Test-NumValue $a.$ky))) { continue }
        $pp = ConvertTo-VisionPhysical $ctx ([double]"$($a.$kx)") ([double]"$($a.$ky)")
        $a.$kx = $pp[0]; $a.$ky = $pp[1]
        $converted = $true
        if (Test-PointInVisionRect $ctx $pp[0] $pp[1]) {
            if ($null -eq $script:Grounded) { $script:Grounded = [System.Collections.Generic.List[object]]::new() }
            $script:Grounded.Add([pscustomobject]@{ L = ($pp[0] - 10); T = ($pp[1] - 10); W = 20; H = 20 })
        }
        else { $allIn = $false }
    }
    if ($kind -eq 'ocr' -and (Test-NumValue $a.w) -and (Test-NumValue $a.h)) {
        $a.w = [int][Math]::Round([double]"$($a.w)" / [double]$ctx.ScaleX); $a.h = [int][Math]::Round([double]"$($a.h)" / [double]$ctx.ScaleY)
    }
    if ($kind -eq 'inspect' -and (Test-NumValue $a.r)) { $a.r = [int][Math]::Round([double]"$($a.r)" / [double]$ctx.ScaleX) }
    $rg = $a.region
    if ($null -ne $rg -and (Test-NumValue $rg.x) -and (Test-NumValue $rg.y) -and (Test-NumValue $rg.w) -and (Test-NumValue $rg.h)) {
        $p0 = ConvertTo-VisionPhysical $ctx ([double]"$($rg.x)") ([double]"$($rg.y)")
        $a.region = [pscustomobject]@{ x = $p0[0]; y = $p0[1]; w = [int][Math]::Round([double]"$($rg.w)" / [double]$ctx.ScaleX); h = [int][Math]::Round([double]"$($rg.h)" / [double]$ctx.ScaleY) }
        $converted = $true
    }
    if ($converted -and $allIn) { $a | Add-Member -NotePropertyName vision_grounded -NotePropertyValue $true -Force }
    return [pscustomobject]@{ Converted = $converted; Grounded = ($converted -and $allIn) }
}
function New-SomAnnotatedScreenshot {
    # 采集前台窗口（或指定区域 / 虚拟桌面）→ 等比缩放 → 叠加 SoM 编号框 + 坐标标尺网格 → JPEG Base64
    # 返回的 OffsetX/OffsetY（窗口左上角物理坐标）与 ScaleX/ScaleY（图像像素 / 物理像素）用于把图像坐标还原为物理坐标
    param(
        [IntPtr]$Hwnd = [IntPtr]::Zero,
        [string]$Detail = 'original',
        $Region = $null,
        $Items = $null,
        [int]$MaxEdge = 0,
        [int]$Quality = 0,
        [int[]]$Rect = $null,
        [switch]$NoMarks
    )
    $swSom = [System.Diagnostics.Stopwatch]::StartNew()
    $Detail = ConvertTo-VisionDetail $Detail
    if ($MaxEdge -le 0) { $MaxEdge = $VisionMaxEdge }
    if ($Quality -le 0) { $Quality = $VisionJpegQuality }
    $MaxEdge = [Math]::Max(200, $MaxEdge)
    $Quality = [Math]::Min(100, [Math]::Max(30, $Quality))
    if ($null -eq $Items) { $Items = $script:Elements }
    # ---- 1. 采集矩形（物理像素，已 Per-Monitor DPI 感知）----
    $sl = [int][DsNative61]::VirtX(); $st = [int][DsNative61]::VirtY()
    $sr = $sl + [int][DsNative61]::VirtW(); $sb = $st + [int][DsNative61]::VirtH()
    $cap = $null
    if ($null -ne $Rect -and $Rect.Count -ge 4) { $cap = @([int]$Rect[0], [int]$Rect[1], [int]$Rect[2], [int]$Rect[3]) }
    elseif ($null -ne $Region) {
        $rx0 = [int]$Region.x; $ry0 = [int]$Region.y; $rw0 = [Math]::Max(192, [int]$Region.w); $rh0 = [Math]::Max(192, [int]$Region.h)
        if ([int]$Region.w -lt 192) { $rx0 = [int]($Region.x + $Region.w / 2 - $rw0 / 2) }
        if ([int]$Region.h -lt 192) { $ry0 = [int]($Region.y + $Region.h / 2 - $rh0 / 2) }
        $cap = @($rx0, $ry0, ($rx0 + $rw0), ($ry0 + $rh0))
    }
    elseif ($Hwnd -ne [IntPtr]::Zero -and [DsNative61]::IsWindow($Hwnd)) {
        $wr = [DsNative61]::WinRect($Hwnd)
        $cap = @([int]$wr[0], [int]$wr[1], [int]$wr[2], [int]$wr[3])
    }
    if ($null -eq $cap) { $cap = @($sl, $st, $sr, $sb) }
    $capL = [Math]::Max($cap[0], $sl); $capT = [Math]::Max($cap[1], $st)
    $capR = [Math]::Min($cap[2], $sr); $capB = [Math]::Min($cap[3], $sb)
    if (($capR - $capL) -lt 48 -or ($capB - $capT) -lt 48) { $capL = $sl; $capT = $st; $capR = $sr; $capB = $sb }   # 窗口最小化 / 在屏幕外 → 退回整个虚拟桌面
    $capW = $capR - $capL; $capH = $capB - $capT
    # ---- 2. 自适应分辨率：长边 <= MaxEdge；总像素 <= ~1.7MP（服务端会把图缩到约 1300x1300 量级，多传的像素白白浪费上传时间）----
    $long = [double][Math]::Max($capW, $capH)
    $sc = 1.0
    $edgeCap = [double]$MaxEdge
    if ($Detail -eq 'low') { $edgeCap = [Math]::Min($edgeCap, 512.0) }   # low：服务端本来就会缩到 512x512，预先缩好既省上传又保证模型看到的坐标系就是我们标注的坐标系
    if ($long -gt $edgeCap) { $sc = $edgeCap / $long }
    if (([double]$capW * $capH * $sc * $sc) -gt 1700000.0) { $sc = [Math]::Sqrt(1700000.0 / ([double]$capW * $capH)) }
    if ($null -ne $Region -and $long -lt 512.0) { $sc = [Math]::Min(4.0, 512.0 / $long) }   # 小区域放大看
    $outW = [int][Math]::Max(1, [Math]::Round($capW * $sc)); $outH = [int][Math]::Max(1, [Math]::Round($capH * $sc))
    $scX = $outW / [double]$capW; $scY = $outH / [double]$capH
    $bmpSrc = $null; $bmpOut = $null; $g = $null; $ms = $null
    $fonts = [System.Collections.Generic.List[object]]::new()
    $pens = [System.Collections.Generic.List[object]]::new()
    $brushes = [System.Collections.Generic.List[object]]::new()
    $marked = 0
    try {
        $fmt = [System.Drawing.Imaging.PixelFormat]::Format24bppRgb
        $bmpSrc = [System.Drawing.Bitmap]::new($capW, $capH, $fmt)
        $g0 = [System.Drawing.Graphics]::FromImage($bmpSrc)
        try { Copy-ScreenPixels $g0 $capL $capT $capW $capH } finally { $g0.Dispose() }
        $bmpOut = [System.Drawing.Bitmap]::new($outW, $outH, $fmt)
        $g = [System.Drawing.Graphics]::FromImage($bmpOut)
        $g.InterpolationMode = [System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
        $g.PixelOffsetMode = [System.Drawing.Drawing2D.PixelOffsetMode]::HighQuality
        $g.CompositingQuality = [System.Drawing.Drawing2D.CompositingQuality]::HighQuality
        if ($outW -eq $capW -and $outH -eq $capH) { $g.DrawImageUnscaled($bmpSrc, 0, 0) }
        else { $g.DrawImage($bmpSrc, [System.Drawing.Rectangle]::new(0, 0, $outW, $outH), 0, 0, $capW, $capH, [System.Drawing.GraphicsUnit]::Pixel) }
        if (-not $NoMarks) {
            $g.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
            $g.TextRenderingHint = [System.Drawing.Text.TextRenderingHint]::AntiAliasGridFit
            $fBold = [System.Drawing.Font]::new('Segoe UI', 11.0, [System.Drawing.FontStyle]::Bold, [System.Drawing.GraphicsUnit]::Pixel); $fonts.Add($fBold)
            $fRule = [System.Drawing.Font]::new('Segoe UI', 10.0, [System.Drawing.FontStyle]::Regular, [System.Drawing.GraphicsUnit]::Pixel); $fonts.Add($fRule)
            # ---- 3a. 坐标网格（图像坐标系，淡色虚线：深浅各画一条，在白底 / 黑底上都看得见）----
            $step = if ([Math]::Max($outW, $outH) -le 700) { 100 } else { 200 }
            $penDark = [System.Drawing.Pen]::new([System.Drawing.Color]::FromArgb(60, 0, 0, 0), 1.0); $penDark.DashStyle = [System.Drawing.Drawing2D.DashStyle]::Dash; $pens.Add($penDark)
            $penLite = [System.Drawing.Pen]::new([System.Drawing.Color]::FromArgb(70, 255, 255, 255), 1.0); $penLite.DashStyle = [System.Drawing.Drawing2D.DashStyle]::Dash; $pens.Add($penLite)
            for ($gx = $step; $gx -lt $outW; $gx += $step) { $g.DrawLine($penDark, $gx, 0, $gx, $outH); $g.DrawLine($penLite, ($gx + 1), 0, ($gx + 1), $outH) }
            for ($gy = $step; $gy -lt $outH; $gy += $step) { $g.DrawLine($penDark, 0, $gy, $outW, $gy); $g.DrawLine($penLite, 0, ($gy + 1), $outW, ($gy + 1)) }
            # ---- 3b. 边缘标尺（顶部 / 左侧，数字 = 图像像素坐标；刻度每 step/5）----
            $bgRule = [System.Drawing.SolidBrush]::new([System.Drawing.Color]::FromArgb(150, 0, 0, 0)); $brushes.Add($bgRule)
            $fgRule = [System.Drawing.SolidBrush]::new([System.Drawing.Color]::FromArgb(255, 255, 255, 255)); $brushes.Add($fgRule)
            $penTick = [System.Drawing.Pen]::new([System.Drawing.Color]::FromArgb(220, 255, 255, 255), 1.0); $pens.Add($penTick)
            $g.FillRectangle($bgRule, 0, 0, $outW, 13)
            $g.FillRectangle($bgRule, 0, 0, 30, $outH)
            $minor = [Math]::Max(10, [int]($step / 5))
            for ($tx = 0; $tx -lt $outW; $tx += $minor) { $th = if (($tx % $step) -eq 0) { 13 } else { 5 }; $g.DrawLine($penTick, $tx, 0, $tx, $th) }
            for ($ty = 0; $ty -lt $outH; $ty += $minor) { $tw = if (($ty % $step) -eq 0) { 30 } else { 8 }; $g.DrawLine($penTick, 0, $ty, $tw, $ty) }
            for ($tx = $step; $tx -lt $outW; $tx += $step) { $g.DrawString("$tx", $fRule, $fgRule, [single]($tx + 2), [single]0) }
            for ($ty = $step; $ty -lt $outH; $ty += $step) { $g.DrawString("$ty", $fRule, $fgRule, [single]1, [single]($ty + 1)) }
            # ---- 3c. SoM：与观察列表同编号的可交互控件框 + [id] 角标 ----
            $palPen = @(); $palFill = @()
            foreach ($pc in $script:SomPalette) {
                $pp1 = [System.Drawing.Pen]::new([System.Drawing.Color]::FromArgb(235, $pc[0], $pc[1], $pc[2]), 2.0); $pens.Add($pp1); $palPen += $pp1
                $pb1 = [System.Drawing.SolidBrush]::new([System.Drawing.Color]::FromArgb(30, $pc[0], $pc[1], $pc[2])); $brushes.Add($pb1); $palFill += $pb1
            }
            $palBadge = @()
            foreach ($pc in $script:SomPalette) { $pb2 = [System.Drawing.SolidBrush]::new([System.Drawing.Color]::FromArgb(240, $pc[0], $pc[1], $pc[2])); $brushes.Add($pb2); $palBadge += $pb2 }
            $capArea = [double]$capW * $capH
            if ($null -ne $Items) {
                foreach ($kv in @($Items.GetEnumerator() | Sort-Object { [int]$_.Key })) {
                    if ($marked -ge 120) { break }
                    $it = $kv.Value
                    if ($null -eq $it -or $it.Off -or $it.Type -eq 'Text') { continue }
                    $x0 = [Math]::Max([double]$it.L, [double]$capL); $y0 = [Math]::Max([double]$it.T, [double]$capT)
                    $x1 = [Math]::Min([double]$it.L + [double]$it.W, [double]$capR); $y1 = [Math]::Min([double]$it.T + [double]$it.H, [double]$capB)
                    if (($x1 - $x0) -lt 2 -or ($y1 - $y0) -lt 2) { continue }
                    if ((($x1 - $x0) * ($y1 - $y0)) -gt (0.5 * $capArea)) { continue }   # 整块容器不画
                    $bx = [single](($x0 - $capL) * $scX); $by = [single](($y0 - $capT) * $scY)
                    $bw = [single](($x1 - $x0) * $scX); $bh = [single](($y1 - $y0) * $scY)
                    $ci = ([int]$kv.Key) % $script:SomPalette.Count
                    $g.FillRectangle($palFill[$ci], $bx, $by, $bw, $bh)
                    $g.DrawRectangle($palPen[$ci], $bx, $by, $bw, $bh)
                    $lab = "[$([int]$kv.Key)]"
                    $lsz = $g.MeasureString($lab, $fBold)
                    $lw = [single]($lsz.Width * 0.9 + 3); $lh = [single]14
                    $lx = $bx; if (($lx + $lw) -gt $outW) { $lx = [single]($outW - $lw) }
                    $ly = [single]($by - $lh); if ($ly -lt 13) { $ly = $by }
                    $g.FillRectangle($palBadge[$ci], $lx, $ly, $lw, $lh)
                    $g.DrawString($lab, $fBold, $fgRule, [single]($lx + 1), [single]($ly - 1))
                    $marked++
                }
            }
        }
        # ---- 4. JPEG 编码 ----
        $codec = $null
        foreach ($cd in [System.Drawing.Imaging.ImageCodecInfo]::GetImageEncoders()) { if ($cd.MimeType -eq 'image/jpeg') { $codec = $cd; break } }
        $ep = [System.Drawing.Imaging.EncoderParameters]::new(1)
        try {
            $ep.Param[0] = [System.Drawing.Imaging.EncoderParameter]::new([System.Drawing.Imaging.Encoder]::Quality, [long]$Quality)
            $ms = [System.IO.MemoryStream]::new()
            $bmpOut.Save($ms, $codec, $ep)
        }
        finally { $ep.Dispose() }
        $data = $ms.ToArray()
        return [pscustomobject]@{
            Base64 = [Convert]::ToBase64String($data); Data = $data; Bytes = $data.Length; KB = [Math]::Round($data.Length / 1024.0, 1)
            Width = $outW; Height = $outH; CapW = $capW; CapH = $capH
            OffsetX = $capL; OffsetY = $capT; ScaleX = $scX; ScaleY = $scY; ScaleFactor = $scX
            Rect = @($capL, $capT, $capR, $capB); Detail = $Detail; Marked = $marked; Ms = [int]$swSom.ElapsedMilliseconds
        }
    }
    finally {
        foreach ($o in @($ms, $g, $bmpOut, $bmpSrc)) { if ($o) { try { $o.Dispose() } catch { } } }
        foreach ($o in $fonts) { try { $o.Dispose() } catch { } }
        foreach ($o in $pens) { try { $o.Dispose() } catch { } }
        foreach ($o in $brushes) { try { $o.Dispose() } catch { } }
    }
}
function Assert-ChatPayloadSafe($payload) {
    # DeepSeek 官方限制：图片只能出现在 user / system / tool 消息；assistant 消息带图会 400。本脚本更严格：图片只允许出现在 user。
    foreach ($m in @($payload.messages)) {
        if ($m.role -notin 'system', 'user') { throw "消息角色 '$($m.role)' 不允许出现（本脚本每轮只发 system + user，历史以文本摘要放进 user）" }
        if ($m.content -isnot [string] -and $m.role -ne 'user') { throw "图片只允许出现在 user 消息里（当前: $($m.role)）" }
    }
}
function New-ChatPayload([string]$systemText, [string]$userContent, $userParts, [string]$modelName, [int]$maxTok, [bool]$jsonMode = $true) {
    $uc = $userContent
    if ($null -ne $userParts) { $uc = @($userParts) }   # OpenAI 兼容多模态：content 为 [{type:text},{type:image_url}] 数组
    $messages = @(
        [ordered]@{ role = 'system'; content = $systemText }
        [ordered]@{ role = 'user'; content = $uc }
    )
    $payload = [ordered]@{ model = $modelName; messages = $messages; temperature = 0; max_tokens = $maxTok }
    if ($jsonMode -and $modelName -notlike '*reasoner*') { $payload['response_format'] = @{ type = 'json_object' } }
    Assert-ChatPayloadSafe $payload
    return $payload
}
function Invoke-DeepSeekVisionStep([string]$userContent, $obs, $esc, [int]$step = 0) {
    # 视觉决策：截图 + SoM 标注 → deepseek-flash（OpenAI 兼容 content 数组）→ 返回原始 JSON 文本与坐标还原上下文
    $shot = New-SomAnnotatedScreenshot -Hwnd $obs.Foreground.Handle -Detail $esc.Detail -Region $esc.Region
    if ($SaveScreenshots -and $script:RunDir) {
        try { [System.IO.File]::WriteAllBytes((Join-Path $script:RunDir ("task{0:D2}-step{1:D2}-som.jpg" -f $script:TaskNo, $step)), $shot.Data) } catch { }
    }
    $text = ConvertTo-VisionText $userContent $shot
    $regionNote = if ($esc.Region) { "（已按你请求的 region 裁剪放大）" } else { '' }
    $head = @"


【视觉轮次 · 感知通道=Vision($VisionModel) · 触发原因=$($esc.Why) · detail=$($shot.Detail)】
附图是前台窗口的截图$regionNote：图像 $($shot.Width)x$($shot.Height) 像素，左上角为原点；已叠加两种提示：
 ① SoM 编号框：带 [n] 角标的彩色框 = 上面观察列表里的控件 [n]。能对应上的目标，优先用 {"id":n}（最稳，走 UIA）。
 ② 坐标标尺与网格：图像顶部 / 左侧的数字与虚线网格 = 图像像素坐标。
坐标规则：本轮文本里所有 @(x,y) 已改写为【图像坐标】；你输出的 x,y / from_x,from_y / to_x,to_y / region 也一律使用图像坐标，系统自动换算为物理屏幕坐标。点目标的中心，不要点边缘。
画布 / 游戏 / 自绘界面里没有 SoM 框的目标：直接输出图像坐标 (x,y)。文本里其他位置出现的坐标（inspect 矩形、历史记录）仍是物理像素，不要直接当 x,y 用。
看不清时输出 {"action":"vision_inspect","detail":"original","region":{"x":0,"y":0,"w":400,"h":300},"reason":"想放大看哪里"}（region 为图像坐标）。detail=low 仅用于确认整体状态，需要点准坐标请用 original。
仍然只输出一个 JSON 对象。
"@
    $parts = @(
        [ordered]@{ type = 'text'; text = ($text + $head) }
        [ordered]@{ type = 'image_url'; image_url = [ordered]@{ url = ('data:image/jpeg;base64,' + $shot.Base64); detail = $shot.Detail } }
    )
    $raw = $null
    try { $raw = Invoke-DeepSeek '' '' 0 $parts $VisionModel $true }
    catch {
        if ($_.Exception.Message -like '触发保护*') { throw }
        # 个别模型 / 网关不支持 response_format：只重试一次，去掉 JSON 模式（解析器本来就能从文本里抽 JSON）
        if ($_.Exception.Message -match 'response_format|json_object') { $raw = Invoke-DeepSeek '' '' 0 $parts $VisionModel $false }
        else { throw }
    }
    $script:LastVision = $shot
    return [pscustomobject]@{ Raw = $raw; Ctx = $shot }
}
