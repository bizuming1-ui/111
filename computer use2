Start-Process -FilePath $pw -ArgumentList @('-NoLogo', '-NoExit', '-ExecutionPolicy', 'Bypass', '-File', 'C:\Agent\code\DeepSeekComputerUse.ps1', '-WorkspaceRoot', 'C:\Agent\exchange\workspace', '-LogDir', 'C:\Agent\exchange\logs')
'@
    $bootFile = Join-Path $codeDir 'agent-bootstrap.ps1'
    [System.IO.File]::WriteAllText($bootFile, $boot, [System.Text.UTF8Encoding]::new($true))
    # 3) .wsb（XML；SecurityElement.Escape 防止路径特殊字符破坏结构）
    $esc = { param($s) [System.Security.SecurityElement]::Escape($s) }
    $pwshHome = if ($PSHOME) { $PSHOME } else { 'C:\Program Files\PowerShell\7' }
    $net = if ($NoNetwork) { 'Disable' } else { 'Enable' }
    $xml = @"
