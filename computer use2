function New-UiaCondition([string[]]$typeNames) {
    $AE = [System.Windows.Automation.AutomationElement]
    $conds = @(foreach ($n in $typeNames) {
            [System.Windows.Automation.PropertyCondition]::new($AE::ControlTypeProperty, [System.Windows.Automation.ControlType]::$n)
        })
    if ($conds.Count -eq 0) { throw 'New-UiaCondition 需要至少一个控件类型' }
    if ($conds.Count -eq 1) { $typeCond = $conds[0] }
    else { $typeCond = [System.Windows.Automation.OrCondition]::new([System.Windows.Automation.Condition[]]$conds) }
    $off = [System.Windows.Automation.PropertyCondition]::new($AE::IsOffscreenProperty, $false)
    return [System.Windows.Automation.AndCondition]::new($typeCond, $off)
}
function Get-UiElements([IntPtr]$hwnd) {
    $result = [System.Collections.Generic.List[object]]::new()
    if ($hwnd -eq [IntPtr]::Zero) { return @() }
    $AE = [System.Windows.Automation.AutomationElement]
    try { $root = $AE::FromHandle($hwnd) } catch { return @() }
    $interactive = @('Button', 'Edit', 'MenuItem', 'ListItem', 'TabItem', 'CheckBox', 'RadioButton',
        'ComboBox', 'Hyperlink', 'TreeItem', 'SplitButton', 'Slider', 'DataItem')
    $vb = Get-ViewBounds   # v4.3：控件坐标取「可见部分」中心
    $cond = New-UiaCondition ($interactive + @('Text'))
    # v5：网页里可点击的 div（点赞 / 收藏 / 评论图标）在 UIA 里通常是「无名 Group/Image/Custom + 可获得焦点或可调用」，v4 完全看不到
    $extraMax = 0; $winArea = 0.0
    if (-not $NoContainers) {
        try {
            $exTypes = New-UiaCondition @('Group', 'Image', 'Custom')
            $exFoc = [System.Windows.Automation.PropertyCondition]::new($AE::IsKeyboardFocusableProperty, $true)
            $exInv = [System.Windows.Automation.PropertyCondition]::new($AE::IsInvokePatternAvailableProperty, $true)
            $exAct = [System.Windows.Automation.OrCondition]::new([System.Windows.Automation.Condition[]]@($exFoc, $exInv))
            $exCond = [System.Windows.Automation.AndCondition]::new([System.Windows.Automation.Condition[]]@($exTypes, $exAct))
            $cond = [System.Windows.Automation.OrCondition]::new([System.Windows.Automation.Condition[]]@($cond, $exCond))
            $extraMax = 60
            if ($null -ne $vb.Win) { $winArea = ($vb.Win[2] - $vb.Win[0]) * ($vb.Win[3] - $vb.Win[1]) }
        }
        catch { $extraMax = 0 }
    }
    $extraCount = 0
    $patProps = [ordered]@{
        inv = $AE::IsInvokePatternAvailableProperty
        val = $AE::IsValuePatternAvailableProperty
        tog = $AE::IsTogglePatternAvailableProperty
        sel = $AE::IsSelectionItemPatternAvailableProperty
        exp = $AE::IsExpandCollapsePatternAvailableProperty
        scr = $AE::IsScrollPatternAvailableProperty
    }
    # v4.1：开关状态 / 值 / 选中状态也随 CacheRequest 一次取回（不再受「最多 45 次实时读取」限制）
    $TogP = [System.Windows.Automation.TogglePattern]::ToggleStateProperty
    $ValP = [System.Windows.Automation.ValuePattern]::ValueProperty
    $SelP = [System.Windows.Automation.SelectionItemPattern]::IsSelectedProperty
    $useCache = $true
    $act = $null
    try {
        $cr = [System.Windows.Automation.CacheRequest]::new()
        foreach ($p in @($AE::NameProperty, $AE::AutomationIdProperty, $AE::ControlTypeProperty,
                $AE::BoundingRectangleProperty, $AE::IsEnabledProperty, $AE::NativeWindowHandleProperty,
                $AE::HasKeyboardFocusProperty, $AE::IsKeyboardFocusableProperty, $TogP, $ValP, $SelP)) { $cr.Add($p) }
        foreach ($p in $patProps.Values) { $cr.Add($p) }
        $act = $cr.Activate()
    }
    catch { $useCache = $false; $act = $null }
    $col = $null
    try { $col = $root.FindAll([System.Windows.Automation.TreeScope]::Descendants, $cond) }
    catch { $col = $null }
    finally { if ($act) { $act.Dispose() } }
    if ($null -eq $col) { return @() }
    $interCount = 0
    $textCount = 0
    $liveReads = 0
    foreach ($el in $col) {
        if (($interCount + $textCount) -ge $script:ScanCap) { break }   # v4.2：只设扫描上限，预算在按位置排序之后再截断
        try {
            $c = if ($useCache) { $el.Cached } else { $el.Current }
            $r = $c.BoundingRectangle
            if ($r.IsEmpty -or $r.Width -lt 2 -or $r.Height -lt 2) { continue }
            $vr = Get-ClipRect $r $vb
            if ($vr.IsEmpty) { continue }
            $type = ($c.ControlType.ProgrammaticName -replace '^ControlType\.', '')
            $isText = ($type -eq 'Text')
            $isExtra = ($type -in @('Group', 'Image', 'Custom'))
            if ($isExtra) {
                if ($extraCount -ge $extraMax) { continue }
                if ($winArea -gt 0 -and ($vr.Width * $vr.Height) -gt (0.2 * $winArea)) { continue }   # 整块内容区不是按钮
                $extraCount++
            }
            $name = $c.Name
            if ([string]::IsNullOrWhiteSpace($name) -and -not $isText) { $name = $c.AutomationId }
            if ($isText -and [string]::IsNullOrWhiteSpace($name)) { continue }
            $pats = @()
            if (-not $isText) {
                foreach ($k in $patProps.Keys) {
                    try {
                        $pv = if ($useCache) { $el.GetCachedPropertyValue($patProps[$k]) } else { $el.GetCurrentPropertyValue($patProps[$k]) }
                        if ($pv -eq $true) { $pats += $k }
                    }
                    catch { }
                }
            }
            if ($isExtra) {
                $kf = $false
                try { $kf = [bool]$c.IsKeyboardFocusable } catch { }
                if ($kf) { $pats += 'foc' }
            }
            $value = ''
            $state = ''
            if (-not $isText) {
                if ($useCache) {
                    try {
                        if ($type -eq 'Edit' -or $type -eq 'ComboBox' -or $pats -contains 'val') {
                            $vv = $el.GetCachedPropertyValue($ValP)
                            if ($vv -is [string]) { $value = $vv }
                        }
                        if ($pats -contains 'tog') {
                            $tv = $el.GetCachedPropertyValue($TogP)
                            if ($tv -is [System.Windows.Automation.ToggleState]) { $state = "$tv".ToLower() }
                        }
                        elseif ($pats -contains 'sel') {
                            $sv = $el.GetCachedPropertyValue($SelP)
                            if ($sv -is [bool]) { $state = if ($sv) { 'selected' } else { '' } }
                        }
                    }
                    catch { }
                }
                elseif ($liveReads -lt 45) {
                    # 缓存不可用时的退路（与 v4 相同的实时读取）
                    if ($type -eq 'Edit' -or $type -eq 'ComboBox') {
                        try {
                            $pat = $null
                            if ($el.TryGetCurrentPattern([System.Windows.Automation.ValuePattern]::Pattern, [ref]$pat)) { $value = $pat.Current.Value }
                        }
                        catch { }
                        $liveReads++
                    }
                    elseif ($pats -contains 'tog') {
                        try {
                            $pat = $null
                            if ($el.TryGetCurrentPattern([System.Windows.Automation.TogglePattern]::Pattern, [ref]$pat)) { $state = "$($pat.Current.ToggleState)".ToLower() }
                        }
                        catch { }
                        $liveReads++
                    }
                    elseif ($pats -contains 'sel') {
                        try {
                            $pat = $null
                            if ($el.TryGetCurrentPattern([System.Windows.Automation.SelectionItemPattern]::Pattern, [ref]$pat)) { $state = if ($pat.Current.IsSelected) { 'selected' } else { '' } }
                        }
                        catch { }
                        $liveReads++
                    }
                }
            }
            if ($isText) { $textCount++ } else { $interCount++ }
            $full = "$name"
            if ($full.Length -gt 300) { $full = $full.Substring(0, 300) }
            $focus = $false
            try { $focus = [bool]$c.HasKeyboardFocus } catch { }
            $result.Add([pscustomobject]@{
                    Type = $type
                    Name = (Limit-Text $name 80)
                    FullName = $full
                    Value = (Limit-Text $value 80)
                    State = $state
                    Enabled = [bool]$c.IsEnabled
                    Focus = $focus
                    Hwnd = [int]$c.NativeWindowHandle
                    Pat = $pats
                    El = $el
                    IsMaster = $false
                    RowIdx = 0
                    RowText = ''
                    Extra = $isExtra
                    Near = ''
                    cx = [int]($vr.Left + $vr.Width / 2)
                    cy = [int]($vr.Top + $vr.Height / 2)
                    L = [int]$r.Left
                    T = [int]$r.Top
                    W = [int]$r.Width
                    H = [int]$r.Height
                })
        }
        catch { continue }
    }
    return $result.ToArray()
}
function Set-Elements($items) {
    $script:Elements = @{}
    $id = 0
    foreach ($it in @($items)) { $id++; $script:Elements[$id] = $it }
}
function Get-Observation {
    Test-Abort
    $fg = Get-ForegroundInfo
    $script:ObsHwnd = $fg.Handle
    $sw = [DsNative61]::PrimaryW(); $sh = [DsNative61]::PrimaryH()
    $cursor = [DsNative61]::CursorPos()
    $windows = @(Get-TopWindowList 15 | ForEach-Object { "  - $($_.Process): $(Limit-Text $_.Title 60)" })
    # v6.3：感知路由器——前台是 Chromium 且 CDP 已附着时优先用 CDP（DOM + AXTree 融合）；失败 / 页面有 ≥2 个复选框（需要 UIA 行模型）时回到 UIA
    $cdpObs = $null
    try { $cdpObs = Get-CdpObservation $fg }
    catch {
        if ("$($_.Exception.Message)" -like '触发保护*') { throw }
        Write-Host "  CDP 感知异常，本步回退 UIA: $(Limit-Text $_.Exception.Message 120)" -ForegroundColor DarkYellow
        $cdpObs = $null
    }
    if ($cdpObs -and (@($cdpObs.Items | Where-Object { $_.Type -eq 'CheckBox' }).Count -ge 2)) { $cdpObs.UseItems = $false }
    $useCdp = [bool]($cdpObs -and $cdpObs.UseItems)
    if ($useCdp) { $all = @($cdpObs.Items | Sort-Object cy, cx) }
    else {
        $all = @(Get-UiElements $fg.Handle | Sort-Object cy, cx)
        try { Add-NearLabels $all } catch { }   # v5：无名可点击容器带上内部 / 紧邻文字
        # 隔离浏览器没有强制开启渲染器无障碍：UIA 回退拿到的控件明显比 CDP 少时，继续使用 CDP 条目（不让感知「失明」）
        if ($cdpObs -and (@($all | Where-Object { $_.Type -ne 'Text' }).Count -lt [Math]::Max(4, [int]($cdpObs.Nodes / 3)))) { $cdpObs.UseItems = $true; $useCdp = $true; $all = @($cdpObs.Items | Sort-Object cy, cx) }
    }
    # v4.2：屏幕上有 ≥2 个复选框时建立「列表行模型」（含视口外的行）
    $model = $null
    if (-not $useCdp -and @($all | Where-Object { $_.Type -eq 'CheckBox' }).Count -ge 2) { try { $model = Get-RowModel $fg.Handle } catch { $model = $null } }
    $rowParts = [System.Collections.Generic.HashSet[string]]::new()
    $masterKeys = [System.Collections.Generic.HashSet[string]]::new()
    $rowRects = [System.Collections.Generic.List[object]]::new()
    if ($model) {
        foreach ($row in $model.Rows) {
            [void]$rowParts.Add((Get-GeoKey $row.Cb)); [void]$rowParts.Add((Get-GeoKey $row.Row))
            if (-not $row.Row.Off) { $rowRects.Add($row.Row) }
        }
        foreach ($mc in $model.Master) { [void]$masterKeys.Add((Get-GeoKey $mc)) }
    }
    # v4.2：先按屏幕位置排序、再按预算截断（v4.1 在 UIA 文档顺序里截断：Gmail 左侧栏/工具栏占满 100 个名额，模型只看到 6 行邮件）
    $general = [System.Collections.Generic.List[object]]::new()
    $inter = 0; $txt = 0
    foreach ($it in $all) {
        $gk = Get-GeoKey $it
        if ($rowParts.Contains($gk)) { continue }                                              # 行与行复选框在「列表行」区单独列出
        if (($it.Type -eq 'Text' -or $it.Extra) -and $rowRects.Count -gt 0 -and (Test-InAnyRect $it $rowRects)) { continue }   # 行内文字已并入行摘要
        if ($masterKeys.Contains($gk)) { $it.IsMaster = $true }
        if ($it.Type -eq 'Text') { if ($txt -ge 40) { continue }; $txt++ }
        else { if ($inter -ge $MaxElements) { continue }; $inter++ }
        $general.Add($it)
    }
    $script:Elements = @{}
    $lines = [System.Collections.Generic.List[string]]::new()
    $baseKeys = [System.Collections.Generic.List[string]]::new()
    $id = 0
    $cbTotal = 0
    $cbOnIds = [System.Collections.Generic.List[int]]::new()
    foreach ($it in $general) {
        $id++
        $script:Elements[$id] = $it
        $line = "[$id] $($it.Type) `"$($it.Name)`""
        if ($it.Near) { $line += " ≈「$($it.Near)」" }
        if ($it.Value) { $line += " value=`"$($it.Value)`"" }
        if ($it.State) { $line += " state=$($it.State)" }
        if (-not $it.Enabled) { $line += ' (disabled)' }
        if ($it.Focus) { $line += ' ★焦点' }
        if ($it.IsMaster) { $line += ' ⚠全选复选框' }
        if ($it.Covered) { $line += " ⛔被「$($it.CoveredBy)」遮挡（点不到）" }
        if ($it.Pat.Count -gt 0) { $line += ' {' + ($it.Pat -join ',') + '}' }
        $line += " @($($it.cx),$($it.cy))"
        $lines.Add($line)
        $baseKeys.Add("$($it.Type)|$($it.Name)|$($it.State)")
        if ($it.Type -eq 'CheckBox') { $cbTotal++; if ($it.State -eq 'on') { $cbOnIds.Add($id) } }
    }
    $rowBlock = ''
    if ($model -and @($model.Rows).Count -gt 0) {
        $rl = [System.Collections.Generic.List[string]]::new()
        $onIdx = [System.Collections.Generic.List[int]]::new()
        $shown = 0
        foreach ($row in $model.Rows) {
            $id++; $cbId = $id; $script:Elements[$id] = (ConvertTo-RowCbItem $row)
            $id++; $rowId = $id; $script:Elements[$id] = (ConvertTo-RowItem $row)
            $isOn = ($row.Cb.State -eq 'on')
            if ($isOn) { $onIdx.Add([int]$row.Index) }
            $baseKeys.Add("Row|$($row.Text)|$($row.Cb.State)")
            if ($shown -lt 60) {
                $mark = if ($isOn) { '☑' } else { '☐' }
                $vis = if ($row.Row.Off) { ' (视口外)' } else { '' }
                $rl.Add("  R$($row.Index) $mark 复选框[$cbId] 行[$rowId] `"$(Limit-Text $row.Text 70)`"$vis")
                $shown++
            }
        }
        $cnt = @($model.Rows).Count
        if ($cnt -gt $shown) { $rl.Add("  …其余 $($cnt - $shown) 行省略（select_rows 仍可按 R 编号操作）") }
        $vis2 = @($model.Rows | Where-Object { -not $_.Row.Off })
        $vr = if ($vis2.Count -gt 0) { "R$($vis2[0].Index)-R$($vis2[$vis2.Count - 1].Index)" } else { '无' }
        $head = "列表行（带复选框；共 $cnt 行，视口内 $vr；R 编号按从上到下，包含视口外的行。勾选用 select_rows / check，打开某一行请 click 它的行编号）:"
        $sum = "行勾选汇总: 共 $cnt 行，已勾选 $($onIdx.Count) 行" + $(if ($onIdx.Count -gt 0) { "（$(Format-RowRanges $onIdx)）" } else { '' })
        if (@($model.Master).Count -gt 0) { $sum += "；另有 $(@($model.Master).Count) 个不属于任何行的复选框（通常是「全选」，已标注 ⚠）" }
        $rowBlock = (@($head) + @($rl) + @($sum)) -join "`n"
    }
    $focusLine = ''
    try {
