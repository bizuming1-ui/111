        int n = hit, k = 0, p;
        while (parent.TryGetValue(n, out p) && p >= 0 && k++ < 80) { if (p == cand) return true; n = p; }
        n = cand; k = 0;
        int label = -1;
        while (parent.TryGetValue(n, out p) && p >= 0 && k++ < 80) {
            if (p == hit) return (tag.ContainsKey(hit) && (tag[hit] == "a" || tag[hit] == "button" || tag[hit] == "label" || tag[hit] == "summary" || tag[hit] == "select")) || (wrapper != null && wrapper.Contains(hit));
