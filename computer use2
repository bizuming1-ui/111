#region ---------- v6.4：C# 程序集磁盘缓存（启动提速）+ DsJob63（Job Object 资源配额 / 最终路径解析） ----------
# 原先每次启动都要用 Roslyn 重新编译约 2500 行 C#（DsNative61 + DsCdp63 + DsWin63，冷启动通常 1.5~4 秒）。
# 现在按「源码 SHA-256 + PowerShell 版本」把编译结果缓存为 DLL，第二次起直接加载（实测约 3ms）；缓存失败 / -NoAsmCache 时自动回到原来的 Add-Type -TypeDefinition。
function Import-DsCSharp {
    param([string]$Name, [string]$Source, [string]$ProbeType)
    if ($ProbeType -as [type]) { return 'loaded' }
    $dll = $null
    if (-not $NoAsmCache) {
        try {
            $sha = [System.Security.Cryptography.SHA256]::HashData([System.Text.Encoding]::UTF8.GetBytes($Source + '|' + $PSVersionTable.PSVersion.ToString()))
            $hex = [Convert]::ToHexString($sha).Substring(0, 20)
            $base = [Environment]::GetFolderPath('LocalApplicationData')
            if ([string]::IsNullOrWhiteSpace($base)) { $base = [System.IO.Path]::GetTempPath() }
            $base = Join-Path $base 'DeepSeekComputerUse\asmcache'
            if (-not [System.IO.Directory]::Exists($base)) { [void][System.IO.Directory]::CreateDirectory($base) }
            if (([System.IO.File]::GetAttributes($base) -band [System.IO.FileAttributes]::ReparsePoint)) { throw '缓存目录是重解析点，拒绝使用' }
            $dll = Join-Path $base "$Name-$hex.dll"
        }
        catch { $dll = $null }
    }
    if ($dll -and [System.IO.File]::Exists($dll)) {
        try { Add-Type -Path $dll -ErrorAction Stop; if ($ProbeType -as [type]) { return 'cache-hit' } }
        catch { try { [System.IO.File]::Delete($dll) } catch { } }
    }
    if ($dll) {
        $tmp = $dll.Substring(0, $dll.Length - 4) + ".$PID.build.dll"
        try {
            Add-Type -TypeDefinition $Source -Language CSharp -IgnoreWarnings -OutputAssembly $tmp -ErrorAction Stop
            [System.IO.File]::Move($tmp, $dll, $true)
            Add-Type -Path $dll -ErrorAction Stop
            if ($ProbeType -as [type]) { return 'compiled+cached' }
        }
        catch { try { if ([System.IO.File]::Exists($tmp)) { [System.IO.File]::Delete($tmp) } } catch { } }
    }
    Add-Type -TypeDefinition $Source -Language CSharp -IgnoreWarnings
    return 'compiled'
}
