            $ids = @($a.ids)
            if ($ids.Count -lt 1 -or $ids.Count -gt 20) { return 'click_many 需要 1~20 个 ids' }
            foreach ($i in $ids) {
                if (-not (Test-IdValue $i)) { return "click_many 的 ids 里有非法编号 '$i'" }
                if (-not $script:Elements.ContainsKey([int]"$i")) { return "元素编号 $i 不存在" }
            }
        }
        { $_ -in 'check', 'uncheck' } {
            $cids = @()
