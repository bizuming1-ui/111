    }
    // 视口裁剪：返回可见部分 [l,t,r,b]，没有可见部分返回 null
    public static double[] ClipRect(double l, double t, double r, double b, double vw, double vh) {
        double a = Math.Max(l, 0), c = Math.Max(t, 0), d = Math.Min(r, vw), e = Math.Min(b, vh);
        if (d - a < 1 || e - c < 1) return null;
        return new double[] { a, c, d, e };
    }
    public static bool IsGhost(double opacity, double visibility) { return opacity < 0.05 || visibility < 0.5; }

    static double[] Box(string resp) {
        if (resp == null) return null;
        try {
            using (var d = JsonDocument.Parse(resp, Jo)) {
                JsonElement r, m, q;
                if (!d.RootElement.TryGetProperty("result", out r) || !r.TryGetProperty("model", out m)) return null;
                if (!m.TryGetProperty("border", out q) && !m.TryGetProperty("content", out q)) return null;
                double x0 = double.MaxValue, y0 = double.MaxValue, x1 = double.MinValue, y1 = double.MinValue;
                for (int i = 0; i + 1 < q.GetArrayLength(); i += 2) { double x = q[i].GetDouble(), y = q[i + 1].GetDouble(); x0 = Math.Min(x0, x); x1 = Math.Max(x1, x); y0 = Math.Min(y0, y); y1 = Math.Max(y1, y); }
                return new double[] { x0, y0, x1, y1 };
            }
        } catch { return null; }
    }
    static int HitOf(string resp) {
        if (resp == null) return -1;
        try { using (var d = JsonDocument.Parse(resp, Jo)) { JsonElement r, b; if (d.RootElement.TryGetProperty("result", out r) && r.TryGetProperty("backendNodeId", out b)) return b.GetInt32(); } } catch { }
        return -1;
    }
    static string Describe(Dictionary<int, Dn> dom, int bid) {
        Dn n; if (bid < 0 || !dom.TryGetValue(bid, out n)) return "未知元素";
        string s = string.IsNullOrEmpty(n.Tag) ? "node" : n.Tag;
        string id = Attr(n, "id"), cl = Attr(n, "class");
        if (!string.IsNullOrEmpty(id)) s += "#" + id;
        else if (!string.IsNullOrEmpty(cl)) s += "." + cl.Trim().Split(' ')[0];
        return s.Length > 40 ? s.Substring(0, 40) : s;
    }
    static string Js(string s) { return JsonSerializer.Serialize(s); }
    static string Num(double d) { return Math.Round(d, 2).ToString(System.Globalization.CultureInfo.InvariantCulture); }

    // 缓存最近一次观察的 DOM 关系（Related 用）
    Dictionary<int, int> lastParent = new Dictionary<int, int>(); Dictionary<int, string> lastTag = new Dictionary<int, string>();

    public string Observe(int maxCand, int timeoutMs) {
        var sw = Stopwatch.StartNew(); long tA, tB, tC;
        // ---- 阶段 A：四路并发（页面度量 / AXTree / DOM 树 pierce / Frame 树）----
        var ra = Batch(new[] { "Runtime.evaluate", "Accessibility.getFullAXTree", "DOM.getDocument", "Page.getFrameTree" },
            new[] { "{\"expression\":" + Js(MetricsJs) + ",\"returnByValue\":true}", "{}", "{\"depth\":-1,\"pierce\":true}", "{}" }, timeoutMs);
        if (ra[0] == null || ra[1] == null || ra[2] == null) throw new InvalidOperationException("CDP 感知失败：" + (ra[0] == null ? "Runtime.evaluate " : "") + (ra[1] == null ? "AXTree " : "") + (ra[2] == null ? "DOM " : "") + "无响应");
        tA = sw.ElapsedMilliseconds;
        var docs = new List<JsonDocument>();
        try {
            var dMetrics = JsonDocument.Parse(ra[0], Jo); docs.Add(dMetrics);
            var mEl = dMetrics.RootElement.GetProperty("result").GetProperty("result").GetProperty("value");
            JsonElement tmp;
            if (mEl.TryGetProperty("err", out tmp)) throw new InvalidOperationException("页面度量失败: " + tmp.GetString());
            double vw = mEl.GetProperty("iw").GetDouble(), vh = mEl.GetProperty("ih").GetDouble();
            var dDom = JsonDocument.Parse(ra[2], Jo); docs.Add(dDom);
            var dom = ParseDom(dDom.RootElement.GetProperty("result").GetProperty("root"));
            var dAx = JsonDocument.Parse(ra[1], Jo); docs.Add(dAx);
            var axRoots = new List<KeyValuePair<JsonElement, string>>();
            axRoots.Add(new KeyValuePair<JsonElement, string>(dAx.RootElement.GetProperty("result").GetProperty("nodes"), ""));
            // 同进程子 frame 的 AXTree（跨进程 OOPIF 取不到，计数后交给视觉兜底）
            int oopif = 0;
            try {
                var dFt = JsonDocument.Parse(ra[3] ?? "{\"result\":{\"frameTree\":{}}}", Jo); docs.Add(dFt);
                var fids = new List<string>(); var stack = new Stack<JsonElement>(); stack.Push(dFt.RootElement.GetProperty("result").GetProperty("frameTree"));
                bool first = true;
                while (stack.Count > 0) { var ft = stack.Pop(); JsonElement e;
                    if (!first && ft.TryGetProperty("frame", out e) && e.TryGetProperty("id", out e)) fids.Add(e.GetString());
                    first = false;
                    if (ft.TryGetProperty("childFrames", out e)) foreach (var c in e.EnumerateArray()) stack.Push(c); }
                if (fids.Count > 0) {
                    if (fids.Count > 8) fids = fids.GetRange(0, 8);
                    var ms = new string[fids.Count]; var ps = new string[fids.Count];
                    for (int i = 0; i < ms.Length; i++) { ms[i] = "Accessibility.getFullAXTree"; ps[i] = "{\"frameId\":" + Js(fids[i]) + "}"; }
                    var rf = Batch(ms, ps, Math.Min(timeoutMs, 2500));
                    for (int i = 0; i < rf.Length; i++) {
                        if (rf[i] == null) { oopif++; continue; }
                        var df = JsonDocument.Parse(rf[i], Jo); docs.Add(df);
                        axRoots.Add(new KeyValuePair<JsonElement, string>(df.RootElement.GetProperty("result").GetProperty("nodes"), fids[i]));
                    }
                }
            } catch { }
            // ---- 候选：AX 非 ignored 的可交互角色 / 可聚焦的泛型节点 ----
            var cands = new List<Cand>(); var seen = new HashSet<int>(); var texts = new List<Cand>(); int axTotal = 0;
            foreach (var ar in axRoots) {
                foreach (var node in ar.Key.EnumerateArray()) {
                    axTotal++;
                    JsonElement e;
                    if (node.TryGetProperty("ignored", out e) && e.ValueKind == JsonValueKind.True) continue;
                    string role = node.TryGetProperty("role", out e) && e.TryGetProperty("value", out e) ? S(e) : "";
                    if (!node.TryGetProperty("backendDOMNodeId", out e)) continue;
                    int bid = e.GetInt32();
                    string type; bool extra = false;
                    bool focusable = false; string url = "";
                    var c = new Cand { Bid = bid, Role = role, Frame = ar.Value, Order = cands.Count };
                    c.Name = node.TryGetProperty("name", out e) && e.TryGetProperty("value", out e) ? S(e) : "";
                    c.Value = node.TryGetProperty("value", out e) && e.TryGetProperty("value", out e) ? S(e) : "";
                    if (node.TryGetProperty("properties", out e) && e.ValueKind == JsonValueKind.Array) {
                        foreach (var p in e.EnumerateArray()) {
                            string pn = p.TryGetProperty("name", out var pe) ? pe.GetString() : ""; string pv = p.TryGetProperty("value", out pe) && pe.TryGetProperty("value", out pe) ? S(pe) : "";
                            switch (pn) {
                                case "disabled": if (pv == "true") c.Enabled = false; break;
                                case "focused": if (pv == "true") c.Focus = true; break;
                                case "focusable": focusable = (pv == "true"); break;
                                case "url": url = pv; break;
                                case "checked": case "pressed": c.State = pv == "true" ? "on" : (pv == "mixed" ? "mixed" : "off"); break;
                                case "expanded": if (c.State == "") c.State = pv == "true" ? "expanded" : "collapsed"; break;
                                case "selected": if (pv == "true" && c.State == "") c.State = "selected"; break;
                            }
                        }
                    }
                    if (!RoleType.TryGetValue(role, out type)) {
                        if (role == "StaticText" || !GenericRoles.Contains(role) || !focusable) continue;
                        if (role == "heading" || role == "cell" || role == "gridcell" || role == "listitem") { if (string.IsNullOrWhiteSpace(c.Name)) continue; }
                        type = "Group"; extra = true;
                    }
                    if (!seen.Add(bid)) continue;
                    c.Type = type; c.Extra = extra; c.Href = url;
                    Dn dn; if (dom.TryGetValue(bid, out dn)) {
                        c.Tag = dn.Tag;
                        if (type == "Edit" && string.Equals(Attr(dn, "type"), "password", StringComparison.OrdinalIgnoreCase)) c.Value = string.IsNullOrEmpty(c.Value) ? "" : "••••";
                        if (string.IsNullOrWhiteSpace(c.Name)) {
                            c.Name = Attr(dn, "title") ?? Attr(dn, "aria-label") ?? Attr(dn, "placeholder") ?? Attr(dn, "alt") ?? Attr(dn, "name") ?? Attr(dn, "id") ?? "";
                            if (c.Name == "" && url != "") c.Name = "→ " + (url.Length > 50 ? url.Substring(url.Length - 50) : url);
                        }
                    }
                    cands.Add(c);
                    if (cands.Count >= maxCand * 3) break;
                }
            }
            // 父子关系表（Related 用）
            var parent = new Dictionary<int, int>(dom.Count); var tags = new Dictionary<int, string>(dom.Count);
            foreach (var kv in dom) { parent[kv.Key] = kv.Value.Parent; tags[kv.Key] = kv.Value.Tag; }
            lastParent = parent; lastTag = tags;
            // ---- 阶段 B：DOM.getBoxModel 管线化 ----
            int n0 = cands.Count; var bm = new string[n0]; var bp = new string[n0];
            for (int i = 0; i < n0; i++) { bm[i] = "DOM.getBoxModel"; bp[i] = "{\"backendNodeId\":" + cands[i].Bid + "}"; }
            var rb = n0 > 0 ? Batch(bm, bp, timeoutMs) : new string[0];
            tB = sw.ElapsedMilliseconds;
            var vis = new List<Cand>(); int above = 0, below = 0;
            var belowNames = new List<string>(); var aboveNames = new List<string>();
            for (int i = 0; i < n0; i++) {
                var bx = Box(rb[i]); var c = cands[i];
                if (bx == null || bx[2] - bx[0] < 1 || bx[3] - bx[1] < 1) continue;   // display:none / 无布局 / 零尺寸
                var cl = ClipRect(bx[0], bx[1], bx[2], bx[3], vw, vh);
                if (cl == null) {
                    if (c.Type == "Group") continue;
                    if (bx[3] <= 0) { above++; if (aboveNames.Count < 6 && c.Name != "") aboveNames.Add(c.Name); }
                    else if (bx[1] >= vh) { below++; if (belowNames.Count < 10 && c.Name != "") belowNames.Add(c.Name); }
                    continue;
                }
                c.L = cl[0]; c.T = cl[1]; c.R = cl[2]; c.B = cl[3]; c.X = (cl[0] + cl[2]) / 2; c.Y = (cl[1] + cl[3]) / 2;
                if ((cl[2] - cl[0]) * (cl[3] - cl[1]) > 0.6 * vw * vh && c.Type == "Group") continue;   // 整页容器不是按钮
                vis.Add(c);
                if (vis.Count >= maxCand * 2) break;
            }
            // ---- 阶段 C：中心点命中测试（DOM.getNodeForLocation = 浏览器真实 elementFromPoint 语义）∥ 页面内透明度 / visibility 链 ----
            int nv = vis.Count; var cm = new string[nv + 1]; var cp = new string[nv + 1];
            var ptsJson = new StringBuilder("[");
            for (int i = 0; i < nv; i++) {
                cm[i] = "DOM.getNodeForLocation"; cp[i] = "{\"x\":" + (int)Math.Round(vis[i].X) + ",\"y\":" + (int)Math.Round(vis[i].Y) + ",\"includeUserAgentShadowDOM\":false}";
                if (i > 0) ptsJson.Append(','); ptsJson.Append('[').Append(Num(vis[i].X)).Append(',').Append(Num(vis[i].Y)).Append(']');
            }
            ptsJson.Append(']');
            cm[nv] = "Runtime.evaluate"; cp[nv] = "{\"expression\":" + Js(StyleJs + "(" + ptsJson + ")") + ",\"returnByValue\":true}";
            var rc = Batch(cm, cp, timeoutMs);
            double[][] sty = null;
            if (rc[nv] != null) { try { using (var ds = JsonDocument.Parse(rc[nv], Jo)) { var arr = ds.RootElement.GetProperty("result").GetProperty("result").GetProperty("value"); sty = new double[arr.GetArrayLength()][]; int k = 0; foreach (var it in arr.EnumerateArray()) sty[k++] = new[] { it[0].GetDouble(), it[1].GetDouble() }; } } catch { sty = null; } }
            var blocked = new List<int>(); var hits = new int[nv];
            for (int i = 0; i < nv; i++) {
                hits[i] = HitOf(rc[i]);
                if (hits[i] < 0) continue;   // 命中测试失败：不误杀
                if (Related(vis[i].Bid, hits[i], parent, tags, null)) { if (sty != null && i < sty.Length && IsGhost(sty[i][0], sty[i][1])) vis[i].Ghost = true; }
                else blocked.Add(i);
            }
            // 被挡住的候选：在可见矩形内再试 4 个内部点，找到「点得到」的位置就改用它；全部被挡才标记 Covered
            if (blocked.Count > 0) {
                var m2 = new List<string>(); var p2 = new List<string>();
                foreach (int i in blocked) {
                    var c = vis[i]; double w = c.R - c.L, h = c.B - c.T;
                    double[][] alt = { new[] { c.L + w * 0.25, c.Y }, new[] { c.L + w * 0.75, c.Y }, new[] { c.X, c.T + h * 0.25 }, new[] { c.X, c.T + h * 0.75 } };
                    foreach (var a in alt) { m2.Add("DOM.getNodeForLocation"); p2.Add("{\"x\":" + (int)Math.Round(a[0]) + ",\"y\":" + (int)Math.Round(a[1]) + ",\"includeUserAgentShadowDOM\":false}"); }
                }
                var r2 = Batch(m2.ToArray(), p2.ToArray(), Math.Min(timeoutMs, 3000));
                int q = 0;
                foreach (int i in blocked) {
                    var c = vis[i]; double w = c.R - c.L, h = c.B - c.T; bool ok = false;
                    double[][] alt = { new[] { c.L + w * 0.25, c.Y }, new[] { c.L + w * 0.75, c.Y }, new[] { c.X, c.T + h * 0.25 }, new[] { c.X, c.T + h * 0.75 } };
                    for (int k = 0; k < 4; k++) { int hb = HitOf(r2[q + k]); if (hb >= 0 && Related(c.Bid, hb, parent, tags, null)) { c.X = Math.Round(alt[k][0]); c.Y = Math.Round(alt[k][1]); ok = true; break; } }
                    q += 4;
                    if (!ok) { c.Covered = true; c.By = Describe(dom, hits[i]); }
                }
            }
            tC = sw.ElapsedMilliseconds;
            // ---- 输出 ----
            int covered = 0, ghost = 0;
            var ms2 = new MemoryStream();
            using (var w = new Utf8JsonWriter(ms2)) {
                w.WriteStartObject();
                w.WritePropertyName("m"); mEl.WriteTo(w);
                w.WriteStartArray("items");
                foreach (var c in vis) {
                    if (c.Ghost) { ghost++; continue; }
                    if (c.Covered) covered++;
                    w.WriteStartObject();
                    w.WriteNumber("bid", c.Bid); w.WriteString("ty", c.Type); w.WriteString("role", c.Role); w.WriteString("nm", c.Name); w.WriteString("val", c.Value); w.WriteString("st", c.State);
                    w.WriteBoolean("en", c.Enabled); w.WriteBoolean("fo", c.Focus); w.WriteBoolean("ex", c.Extra); w.WriteString("tag", c.Tag); w.WriteString("fr", c.Frame);
                    w.WriteNumber("x", c.X); w.WriteNumber("y", c.Y); w.WriteNumber("l", c.L); w.WriteNumber("t", c.T); w.WriteNumber("w", c.R - c.L); w.WriteNumber("h", c.B - c.T);
                    w.WriteBoolean("cv", c.Covered); w.WriteString("by", c.By);
                    w.WriteEndObject();
                }
                w.WriteEndArray();
                w.WriteStartObject("s");
                w.WriteNumber("ax", axTotal); w.WriteNumber("dom", dom.Count); w.WriteNumber("cand", n0); w.WriteNumber("vis", nv - ghost); w.WriteNumber("covered", covered); w.WriteNumber("ghost", ghost);
                w.WriteNumber("above", above); w.WriteNumber("below", below); w.WriteNumber("oopif", oopif);
                w.WriteNumber("tA", tA); w.WriteNumber("tB", tB - tA); w.WriteNumber("tC", tC - tB); w.WriteNumber("tD", sw.ElapsedMilliseconds - tC);
                w.WriteEndObject();
                w.WriteStartArray("belowNames"); foreach (var s in belowNames) w.WriteStringValue(s); w.WriteEndArray();
                w.WriteStartArray("aboveNames"); foreach (var s in aboveNames) w.WriteStringValue(s); w.WriteEndArray();
                w.WriteEndObject();
            }
            return Encoding.UTF8.GetString(ms2.ToArray());
        }
        finally { foreach (var d in docs) { try { d.Dispose(); } catch { } } }
    }

    // ===== 单目标实时核对：几何 + 名称 + 命中（页面内 elementFromPoint）=====
    // 返回 JSON：{ok, err, m:{...}, name, x, y, l,t,w,h, by}（坐标 = 视口 CSS 像素）
    public string LiveTarget(int bid, int timeoutMs) {
        var r1 = Batch(new[] { "DOM.resolveNode", "Runtime.evaluate", "DOM.getBoxModel", "Accessibility.getPartialAXTree" },
            new[] { "{\"backendNodeId\":" + bid + ",\"objectGroup\":\"dscu\"}", "{\"expression\":" + Js(MetricsLiteJs) + ",\"returnByValue\":true}", "{\"backendNodeId\":" + bid + "}", "{\"backendNodeId\":" + bid + ",\"fetchRelatives\":false}" }, timeoutMs);
        string mj = "null", name = "";
        if (r1[1] != null) { try { using (var d = JsonDocument.Parse(r1[1], Jo)) mj = d.RootElement.GetProperty("result").GetProperty("result").GetProperty("value").GetRawText(); } catch { } }
        if (r1[0] == null || r1[2] == null) return "{\"ok\":false,\"err\":\"gone\",\"m\":" + mj + "}";
        if (r1[3] != null) { try { using (var d = JsonDocument.Parse(r1[3], Jo)) { foreach (var nd in d.RootElement.GetProperty("result").GetProperty("nodes").EnumerateArray()) { JsonElement e; if (nd.TryGetProperty("ignored", out e) && e.ValueKind == JsonValueKind.True) continue; if (nd.TryGetProperty("name", out e) && e.TryGetProperty("value", out e)) { name = S(e); break; } } } } catch { } }
        var bx = Box(r1[2]); double vw = 0, vh = 0;
        try { using (var d = JsonDocument.Parse(mj, Jo)) { vw = d.RootElement.GetProperty("iw").GetDouble(); vh = d.RootElement.GetProperty("ih").GetDouble(); } } catch { }
        if (bx == null) return "{\"ok\":false,\"err\":\"nobox\",\"m\":" + mj + ",\"name\":" + Js(name) + "}";
        var cl = ClipRect(bx[0], bx[1], bx[2], bx[3], vw, vh);
        if (cl == null) return "{\"ok\":false,\"err\":\"offscreen\",\"m\":" + mj + ",\"name\":" + Js(name) + ",\"t\":" + Num(bx[1]) + ",\"b\":" + Num(bx[3]) + ",\"vh\":" + Num(vh) + "}";
        double w0 = cl[2] - cl[0], h0 = cl[3] - cl[1];
        double[][] pts = { new[] { (cl[0] + cl[2]) / 2, (cl[1] + cl[3]) / 2 }, new[] { cl[0] + w0 * 0.25, cl[1] + h0 * 0.5 }, new[] { cl[0] + w0 * 0.75, cl[1] + h0 * 0.5 }, new[] { cl[0] + w0 * 0.5, cl[1] + h0 * 0.25 }, new[] { cl[0] + w0 * 0.5, cl[1] + h0 * 0.75 } };
        string oid; using (var d = JsonDocument.Parse(r1[0], Jo)) oid = d.RootElement.GetProperty("result").GetProperty("object").GetProperty("objectId").GetString();
        var sb = new StringBuilder("["); for (int i = 0; i < pts.Length; i++) { if (i > 0) sb.Append(','); sb.Append('[').Append(Num(pts[i][0])).Append(',').Append(Num(pts[i][1])).Append(']'); }
        sb.Append(']');
        string rr = Call("Runtime.callFunctionOn", "{\"objectId\":" + Js(oid) + ",\"functionDeclaration\":" + Js(RelFn) + ",\"arguments\":[{\"value\":" + sb + "}],\"returnByValue\":true}", timeoutMs);
        try { Post("Runtime.releaseObjectGroup", "{\"objectGroup\":\"dscu\"}"); } catch { }
        int pick = -1; string by = "";
        using (var d = JsonDocument.Parse(rr, Jo)) {
            var v = d.RootElement.GetProperty("result").GetProperty("result").GetProperty("value");
            by = v.GetProperty("d").GetString(); int k = 0;
            foreach (var it in v.GetProperty("r").EnumerateArray()) { if (it.GetInt32() == 1 && pick < 0) pick = k; k++; }
        }
        if (pick < 0) return "{\"ok\":false,\"err\":\"covered\",\"by\":" + Js(by) + ",\"m\":" + mj + ",\"name\":" + Js(name) + "}";
        return "{\"ok\":true,\"m\":" + mj + ",\"name\":" + Js(name) + ",\"x\":" + Num(pts[pick][0]) + ",\"y\":" + Num(pts[pick][1]) + ",\"l\":" + Num(cl[0]) + ",\"t\":" + Num(cl[1]) + ",\"w\":" + Num(w0) + ",\"h\":" + Num(h0) + ",\"pick\":" + pick + "}";
    }
    // 页面内函数调用（取状态 / 值 / 焦点 / 命中）
    public string CallOn(int bid, string fn, int timeoutMs) {
        string r = Call("DOM.resolveNode", "{\"backendNodeId\":" + bid + ",\"objectGroup\":\"dscu\"}", timeoutMs);
        string oid; using (var d = JsonDocument.Parse(r, Jo)) oid = d.RootElement.GetProperty("result").GetProperty("object").GetProperty("objectId").GetString();
        string rr = Call("Runtime.callFunctionOn", "{\"objectId\":" + Js(oid) + ",\"functionDeclaration\":" + Js(fn) + ",\"returnByValue\":true}", timeoutMs);
        try { Post("Runtime.releaseObjectGroup", "{\"objectGroup\":\"dscu\"}"); } catch { }
        using (var d = JsonDocument.Parse(rr, Jo)) { JsonElement v = d.RootElement.GetProperty("result").GetProperty("result"); JsonElement val; return v.TryGetProperty("value", out val) ? val.GetRawText() : "null"; }
    }
    // 物理点位 → 命中检查（页面内）：该点处「真正会收到点击」的元素是否就是 bid（或其后代 / 可点击包装）
    public string HitAt(int bid, double vx, double vy, int timeoutMs) {
        string fn = RelFn.Replace("function(pts)", "function()").Replace("let ox=0,oy=0;", "const pts=[[" + Num(vx) + "," + Num(vy) + "]];let ox=0,oy=0;");
        return CallOn(bid, fn, timeoutMs);
    }
