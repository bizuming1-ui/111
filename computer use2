        $changes = "$changes`n $pl".Trim()
    }
    return [pscustomobject]@{ Text = $text; Foreground = $fg; Keys = $curSet; Changes = $changes; Rows = $model; PixPct = $pixPct; Inter = $interAll; IsConsole = [bool]$isConsole; Pix = $pix; Cdp = $(if ($useCdp) { $cdpObs } else { $null }); CdpHint = $(if ($useCdp) { $cdpObs.Hint } else { '' }) }
