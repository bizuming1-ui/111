    catch {
        $script:CdpDisabled = $true
        Write-Host "  CDP 引擎编译 / 初始化失败，本次会话自动关闭 CDP（回退 UIA）: $(Limit-Text $_.Exception.Message 160)" -ForegroundColor DarkYellow
        return $false
    }
}
function Test-CdpEnabled { return ((-not $NoCdp) -and (-not $script:CdpDisabled) -and ($script:Mode -in 'Auto', 'Physical')) }
function Test-CdpForeground {
    # 当前前台窗口就是已附着 CDP 的那个浏览器窗口（切到别的程序 / 别的浏览器实例时为 $false）
    $c = $script:Cdp
    if ($null -eq $c -or -not $c.Connected) { return $false }
    $h = [DsNative61]::GetForegroundWindow()
    if ($h -eq [IntPtr]::Zero) { return $false }
    return ([DsNative61]::Root($h) -eq $script:CdpState.Root)
}
function Get-CdpHttp {
    if ($null -eq $script:CdpHttp) { $script:CdpHttp = [System.Net.Http.HttpClient]::new(); $script:CdpHttp.Timeout = [TimeSpan]::FromMilliseconds(2500) }
    return $script:CdpHttp
}
function Invoke-CdpHttp([int]$Port, [string]$Path, [string]$Verb = 'GET', [int]$TimeoutMs = 1500) {
    $cts = $null
    try {
        $req = [System.Net.Http.HttpRequestMessage]::new([System.Net.Http.HttpMethod]::new($Verb), "http://127.0.0.1:$Port$Path")
        $cts = [System.Threading.CancellationTokenSource]::new($TimeoutMs)
        $resp = (Get-CdpHttp).SendAsync($req, $cts.Token).GetAwaiter().GetResult()
        $txt = $resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()
        if (-not $resp.IsSuccessStatusCode) { return $null }
        return $txt
    }
    catch { return $null }
    finally { if ($cts) { $cts.Dispose() } }
}
function Test-CdpEndpoint([int]$Port, [int]$TimeoutMs = 700) {
    if ($Port -le 0) { return $null }
    $t = Invoke-CdpHttp $Port '/json/version' 'GET' $TimeoutMs
    if ($null -eq $t) { return $null }
    try { return ($t | ConvertFrom-Json) } catch { return $null }
}
function Get-CdpTargets([int]$Port) {
    $t = Invoke-CdpHttp $Port '/json/list' 'GET' 1500
    if ($null -eq $t) { return @() }
    try { return @(($t | ConvertFrom-Json) | Where-Object { $_.type -eq 'page' -and $_.webSocketDebuggerUrl -and "$($_.url)" -notmatch '^(devtools|chrome-extension|chrome-untrusted)://' }) } catch { return @() }
}
function Test-CdpPortFree([int]$Port) {
    try { $l = [System.Net.Sockets.TcpListener]::new([System.Net.IPAddress]::Loopback, $Port); $l.Start(); $l.Stop(); return $true } catch { return $false }
}
function Find-CdpFreePort([int]$Preferred) {
    if ($Preferred -gt 0 -and (Test-CdpPortFree $Preferred)) { return $Preferred }
    $l = [System.Net.Sockets.TcpListener]::new([System.Net.IPAddress]::Loopback, 0)
    $l.Start(); $p = [int]$l.LocalEndpoint.Port; $l.Stop()
    return $p
}
function Select-CdpTarget($Targets, [string]$FgTitle, [string]$CurrentId = '') {
    # 把前台浏览器窗口匹配到 /json/list 里的某个 Page Target。窗口标题 =「页面标题 - Google Chrome / Microsoft​ Edge …」，所以用 StartsWith 并取最长标题。
    $pages = @($Targets | Where-Object { $_ -and $_.webSocketDebuggerUrl })
    if ($pages.Count -eq 0) { return $null }
    $ft = ("$FgTitle" -replace '[\u200B-\u200D\uFEFF]', '').Trim()
    $hits = @($pages | Where-Object { $t = ("$($_.title)" -replace '[\u200B-\u200D\uFEFF]', '').Trim(); $t.Length -gt 0 -and $ft.StartsWith($t, [System.StringComparison]::OrdinalIgnoreCase) })
    if ($hits.Count -gt 0) {
        $cur = $hits | Where-Object { $_.id -eq $CurrentId } | Select-Object -First 1
        if ($cur) { return $cur }
        return ($hits | Sort-Object { ("$($_.title)").Length } -Descending | Select-Object -First 1)
    }
    $byUrl = @($pages | Where-Object { $u = ("$($_.url)" -replace '^[a-z]+://', '').TrimEnd('/'); $u.Length -ge 4 -and $ft.Contains($u) })
    if ($byUrl.Count -ge 1) { return ($byUrl | Sort-Object { ("$($_.url)").Length } -Descending | Select-Object -First 1) }
    $blank = @($pages | Where-Object { "$($_.url)" -in 'about:blank', 'chrome://newtab/', 'edge://newtab/' -and [string]::IsNullOrWhiteSpace("$($_.title)") })
    if ($blank.Count -eq 1 -and $ft -match '(?i)(新标签页|new tab|about:blank|untitled|无标题)') { return $blank[0] }
    if ($pages.Count -eq 1) { return $pages[0] }
    $keep = $pages | Where-Object { $_.id -eq $CurrentId } | Select-Object -First 1
    if ($keep) { return $keep }
    return $null
}
function Test-CdpDefaultProfile([string]$Path) {
    # Chrome 136+ 起：使用「默认」user-data-dir 时 --remote-debugging-port 会被忽略（安全策略）；所以必须是独立目录
    if ([string]::IsNullOrWhiteSpace($Path)) { return $false }
    try {
        $p = [System.IO.Path]::GetFullPath($Path).TrimEnd('\').ToLowerInvariant()
        foreach ($d in @("$env:LOCALAPPDATA\Google\Chrome\User Data", "$env:LOCALAPPDATA\Microsoft\Edge\User Data", "$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\User Data")) {
            if ($d -and $p -eq $d.TrimEnd('\').ToLowerInvariant()) { return $true }
        }
    }
    catch { }
    return $false
}
function Get-CdpLaunchArgs([string]$Target, [string]$ArgStr) {
    $key = if ($Target -match '(?i)msedge') { 'edge' } elseif ($Target -match '(?i)brave') { 'brave' } else { 'chrome' }
    $port = 0
    if ($ArgStr -match '--remote-debugging-port=(\d+)') { $port = [int]$Matches[1] }
    elseif ($script:CdpState.Port -gt 0 -and (Test-CdpEndpoint $script:CdpState.Port)) { $port = [int]$script:CdpState.Port }
    else { $port = Find-CdpFreePort ([int]$script:CdpPortCfg) }
    $profile = ''
    if ($ArgStr -match '--user-data-dir=(?:"([^"]+)"|(\S+))') { $profile = if ($Matches[1]) { $Matches[1] } else { $Matches[2] } }
    elseif (-not [string]::IsNullOrWhiteSpace($CdpProfile)) { $profile = $CdpProfile }
    else { $profile = Join-Path ([System.IO.Path]::GetTempPath()) "DeepSeekComputerUse-cdp-$key" }
    $warn = ''
    if (Test-CdpDefaultProfile $profile) {
        $warn = "指定的 Profile 是浏览器默认目录，Chrome 136+ 会忽略远程调试端口；已改用隔离目录"
        $profile = Join-Path ([System.IO.Path]::GetTempPath()) "DeepSeekComputerUse-cdp-$key"
    }
    $flags = [System.Collections.Generic.List[string]]::new()
    if ($ArgStr -notmatch '--remote-debugging-port') { $flags.Add("--remote-debugging-port=$port") }
    if ($ArgStr -notmatch '--user-data-dir') { $flags.Add("--user-data-dir=`"$profile`"") }
    foreach ($f in @('--no-first-run', '--no-default-browser-check', '--disable-background-timer-throttling', '--disable-renderer-backgrounding', '--disable-backgrounding-occluded-windows')) {
        if ($ArgStr -notmatch [regex]::Escape($f)) { $flags.Add($f) }   # 后三项：窗口被遮挡 / 失焦时不降频，rAF / 定时器照常，等待才是确定性的
    }
    $full = (($flags -join ' ') + ' ' + $ArgStr).Trim()
    return @{ Args = $full; Port = $port; Profile = $profile; Key = $key; Warn = $warn }
}
function Start-CdpBrowser([string]$Target, [string]$ArgStr = '') {
    # 隔离式启动：独立 --user-data-dir（不污染 / 不冲突你日常浏览器的登录态）+ --remote-debugging-port；显式 -CdpProfile 才复用指定目录
    $la = Get-CdpLaunchArgs $Target $ArgStr
    New-Item -ItemType Directory -Force -Path $la.Profile | Out-Null
    Start-Process -FilePath $Target -ArgumentList $la.Args
    $script:CdpState.Port = [int]$la.Port; $script:CdpState.Profile = $la.Profile; $script:CdpState.Launched = $true
    $script:CdpPidPort = @{}
    return $la
}
function Wait-CdpEndpoint([int]$Port, [int]$TimeoutMs = 3000) {
    $end = [Environment]::TickCount64 + $TimeoutMs
    while ([Environment]::TickCount64 -lt $end) {
        Test-Abort
        $v = Test-CdpEndpoint $Port 400
        if ($v) { if (@(Get-CdpTargets $Port).Count -gt 0) { return $true } }
        Start-Sleep -Milliseconds 50
    }
    return $false
}
function Resolve-CdpPort($Fg) {
    $procId = [int][DsNative61]::WinPid($Fg.Handle)
    $now = [Environment]::TickCount64
    $e = $script:CdpPidPort[$procId]
    if ($e -and ($e.Port -gt 0 -or ($now - $e.At) -lt 15000)) { return [int]$e.Port }
    $port = 0; $cimOk = $false
    try {
        $ci = Get-CimInstance -ClassName Win32_Process -Filter "ProcessId=$procId" -ErrorAction Stop
        $cimOk = $true
        if ("$($ci.CommandLine)" -match '--remote-debugging-port=(\d+)') { $port = [int]$Matches[1] }
    }
    catch { }
    if ($port -le 0 -and -not $cimOk -and $script:CdpState.Port -gt 0) { $port = [int]$script:CdpState.Port }   # 读不到命令行时才退回本会话启动的端口
    if ($port -gt 0 -and -not (Test-CdpEndpoint $port)) { $port = 0 }
    $script:CdpPidPort[$procId] = @{ Port = $port; At = $now }
    return $port
}
function Connect-CdpTarget($Fg, [switch]$Force) {
    if (-not (Initialize-CdpEngine)) { return $false }
    $c = $script:Cdp
    $fgTitle = "$($Fg.Title)"
    $root = [DsNative61]::Root($Fg.Handle)
    if (-not $Force -and $c.Connected -and $script:CdpState.Root -eq $root -and $script:CdpState.FgTitle -eq $fgTitle) { return $true }
    $port = Resolve-CdpPort $Fg
    if ($port -le 0) { return $false }
    $targets = @(Get-CdpTargets $port)
    if ($targets.Count -eq 0) { return $false }
    $t = Select-CdpTarget $targets $fgTitle $script:CdpState.TargetId
    if ($null -eq $t) { return $false }
    if ($Force -or -not ($c.Connected -and $c.WsUrl -eq $t.webSocketDebuggerUrl)) {
        try { $c.Connect([string]$t.webSocketDebuggerUrl, 3000) }
        catch { Write-Host "  CDP 附着失败: $(Limit-Text (Get-NativeError $_) 120)" -ForegroundColor DarkYellow; return $false }
    }
    $script:CdpState.Port = $port; $script:CdpState.Root = $root; $script:CdpState.TargetId = [string]$t.id; $script:CdpState.FgTitle = $fgTitle
    return $true
}
function Restore-CdpConnection {
    try {
        $h = [DsNative61]::GetForegroundWindow()
        if ([DsNative61]::Root($h) -ne $script:CdpState.Root) { return $false }
        $fg = Get-ForegroundInfo
        return (Connect-CdpTarget $fg -Force)
    }
    catch { return $false }
}
function Invoke-CdpMethod([string]$Method, $Params = $null, [int]$TimeoutMs = 5000, [switch]$NoReconnect) {
    # JSON-RPC 请求 → 响应（C# 分发器按 id 匹配，线程安全）；带超时；连接断开时自动重连一次再重试
    $c = $script:Cdp
    if ($null -eq $c) { throw 'CDP 未初始化' }
    $pj = if ($null -eq $Params) { '{}' } elseif ($Params -is [string]) { $Params } else { ($Params | ConvertTo-Json -Compress -Depth 8) }
    for ($try = 0; $try -lt 2; $try++) {
        try {
            if (-not $c.Connected) { throw [System.InvalidOperationException]::new('CDP 未连接') }
            $msg = $c.Call($Method, $pj, $TimeoutMs)
            return ($msg | ConvertFrom-Json).result
        }
        catch {
            $em = Get-NativeError $_
            $dead = (-not $c.Connected) -or ($em -match '未连接|已断开|已关闭')
            if ($try -eq 0 -and $dead -and -not $NoReconnect -and (Restore-CdpConnection)) { continue }
            throw $em
        }
    }
}
function Close-CdpClient {
    try { if ($script:Cdp) { $script:Cdp.Close() } } catch { }
    try { if ($script:CdpHttp) { $script:CdpHttp.Dispose(); $script:CdpHttp = $null } } catch { }
    $script:Cdp = $null
}
# ---------- 视口（CSS 像素）→ Windows 物理屏幕坐标 ----------
function Get-CdpOrigin($m, $Client, $Render) {
    # 三级降级：① Chrome_RenderWidgetHostHWND 的真实物理矩形（与 innerWidth*dpr 吻合时）② 窗口客户区（左 / 下贴边，上方多出的是标签栏 + 地址栏）③ screenX/Y + 边框 + 工具栏高度 经典公式
    $dpr = [double]$m.dpr; if ($dpr -le 0.1) { $dpr = 1.0 }
    $vpW = [double]$m.iw * $dpr; $vpH = [double]$m.ih * $dpr
    if ($Render -and @($Render).Count -ge 4) {
        if ([Math]::Abs($Render[2] - $vpW) -le [Math]::Max(6.0, 0.03 * $vpW) -and [Math]::Abs($Render[3] - $vpH) -le [Math]::Max(6.0, 0.03 * $vpH)) {
            return @{ OX = [double]$Render[0]; OY = [double]$Render[1]; Scale = $dpr; Src = 'render-hwnd' }
        }
    }
    if ($Client -and @($Client).Count -ge 4 -and $Client[2] -ge ($vpW - 6) -and $Client[3] -ge ($vpH - 6)) {
        return @{ OX = [double]$Client[0]; OY = [double]($Client[1] + [Math]::Max(0.0, $Client[3] - $vpH)); Scale = $dpr; Src = 'client-rect' }
    }
    $border = [Math]::Max(0.0, ([double]$m.ow - [double]$m.iw) / 2.0)
    $top = [Math]::Max(0.0, [double]$m.oh - [double]$m.ih - $border)
    return @{ OX = (([double]$m.sx + $border) * $dpr); OY = (([double]$m.sy + $top) * $dpr); Scale = $dpr; Src = 'screenXY' }
}
function ConvertTo-CdpScreenPoint([double]$Vx, [double]$Vy, $o) {
    return @([int][Math]::Round($o.OX + $Vx * $o.Scale), [int][Math]::Round($o.OY + $Vy * $o.Scale))
}
function ConvertFrom-CdpScreenPoint([double]$Px, [double]$Py, $o) {
    return @((($Px - $o.OX) / $o.Scale), (($Py - $o.OY) / $o.Scale))
}
function Get-CdpViewportOrigin([IntPtr]$Hwnd, $m) {
    $root = [DsNative61]::Root($Hwnd)
    $client = $null; $render = $null
    try { $client = [DsWin63]::ClientRect($root) } catch { }
    try { $render = [DsWin63]::RenderRect($root) } catch { }
    $o = Get-CdpOrigin $m $client $render
    $key = "$root|$($o.Src)"
    if ($script:CdpState.CalKey -ne $key) { $script:CdpState.CalKey = $key; $script:CdpState.CalX = 0.0; $script:CdpState.CalY = 0.0 }
    $o.OX += [double]$script:CdpState.CalX; $o.OY += [double]$script:CdpState.CalY   # 由页面 mousemove 回读学到的校准量
    $script:CdpState.Origin = $o
    return $o
}
# ---------- DOM + AXTree 融合观测 ----------
function Get-CdpObservation($Fg) {
    if (-not (Test-CdpEnabled)) { return $null }
    if ($script:ChromiumNames -notcontains "$($Fg.Process)".ToLower()) { return $null }
    if ([Environment]::TickCount64 -lt $script:CdpRetryAfter) { return $null }
    if (-not (Initialize-CdpEngine)) { return $null }
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    if (-not (Connect-CdpTarget $Fg)) { $script:CdpRetryAfter = [Environment]::TickCount64 + 1200; return $null }
    $c = $script:Cdp
    if ($c.DialogOpen) { Write-Host "  页面有未处理的 JS 对话框（$($c.DialogInfo)），CDP 暂停，本步改用 UIA" -ForegroundColor DarkYellow; return $null }
    $o = $null
    for ($try = 0; $try -lt 2 -and $null -eq $o; $try++) {
        try { $o = ($c.Observe([int]($MaxElements + 60), 6000) | ConvertFrom-Json) }
        catch {
            $em = Get-NativeError $_
            if ($try -eq 0 -and (-not $c.Connected) -and (Restore-CdpConnection)) { continue }
            $script:CdpState.Fails++
            if ($script:CdpState.Fails -ge 3) { $script:CdpRetryAfter = [Environment]::TickCount64 + 30000; $script:CdpState.Fails = 0 }
            Write-Host "  CDP 感知失败，本步回退 UIA: $(Limit-Text $em 140)" -ForegroundColor DarkYellow
            return $null
        }
    }
    if ($null -eq $o) { return $null }
    $script:CdpState.Fails = 0
    $m = $o.m
    # 刚导航 / 仍在加载：先做确定性等待再重新观察一次（只做一次）
    if ("$($m.rs)" -ne 'complete' -or $c.InFlight(3000) -gt 0) {
        try {
            if (Wait-CdpSettled -TimeoutMs 3000) { $o = ($c.Observe([int]($MaxElements + 60), 6000) | ConvertFrom-Json); $m = $o.m }
        }
        catch { if ($_.Exception.Message -like '触发保护*') { throw } }
    }
    $origin = Get-CdpViewportOrigin $Fg.Handle $m
    $sc = [double]$origin.Scale
    $items = [System.Collections.Generic.List[object]]::new()
    $inter = 0
    foreach ($it in @($o.items)) {
        $pt = ConvertTo-CdpScreenPoint ([double]$it.x) ([double]$it.y) $origin
        $L = [int][Math]::Round($origin.OX + [double]$it.l * $sc); $T = [int][Math]::Round($origin.OY + [double]$it.t * $sc)
        $W = [int][Math]::Max(2.0, [Math]::Round([double]$it.w * $sc)); $H = [int][Math]::Max(2.0, [Math]::Round([double]$it.h * $sc))
        $name = "$($it.nm)"; $full = if ($name.Length -gt 300) { $name.Substring(0, 300) } else { $name }
        $inter++
        $items.Add([pscustomobject]@{
                Type = "$($it.ty)"; Name = (Limit-Text $name 80); FullName = $full; Value = (Limit-Text "$($it.val)" 80); State = "$($it.st)"
                Enabled = [bool]$it.en; Focus = [bool]$it.fo; Hwnd = 0; Pat = @(); El = $null; IsMaster = $false; RowIdx = 0; RowText = ''
                Extra = [bool]$it.ex; Near = ''; cx = $pt[0]; cy = $pt[1]; L = $L; T = $T; W = $W; H = $H
                Cdp = $true; Bid = [int]$it.bid; Covered = [bool]$it.cv; CoveredBy = "$($it.by)"; Frame = "$($it.fr)"
            })
    }
    foreach ($tx in @($m.texts)) {
        $s = "$($tx[0])"; if ([string]::IsNullOrWhiteSpace($s)) { continue }
        $L = [int][Math]::Round($origin.OX + [double]$tx[1] * $sc); $T = [int][Math]::Round($origin.OY + [double]$tx[2] * $sc)
        $W = [int][Math]::Max(2.0, [Math]::Round([double]$tx[3] * $sc)); $H = [int][Math]::Max(2.0, [Math]::Round([double]$tx[4] * $sc))
        $items.Add([pscustomobject]@{
                Type = 'Text'; Name = (Limit-Text $s 80); FullName = $s; Value = ''; State = ''; Enabled = $true; Focus = $false; Hwnd = 0; Pat = @(); El = $null
                IsMaster = $false; RowIdx = 0; RowText = ''; Extra = $false; Near = ''; cx = [int]($L + $W / 2); cy = [int]($T + $H / 2); L = $L; T = $T; W = $W; H = $H
                Cdp = $true; Bid = -1; Covered = $false; CoveredBy = ''; Frame = ''
            })
    }
    # 视口外摘要 / 页面信息行 / 焦点行
    $pageLine = "网页(CDP): 《$(Limit-Text "$($m.title)" 60)》 $(Limit-Text "$($m.url)" 140) readyState=$($m.rs) 在途网络请求=$($c.InFlight(4000)) 滚动 $([int]$m.py)/$([int][Math]::Max(0, [double]$m.sh - [double]$m.ih))px；坐标原点来源=$($origin.Src) 缩放=$([Math]::Round($sc, 3))"
    $s = $o.s
    if ([int]$s.below -gt 0 -or [int]$s.above -gt 0) {
        $pageLine += "`n  视口外还有可交互元素：下方 $($s.below) 个$(if (@($o.belowNames).Count -gt 0) { '（如：' + ((@($o.belowNames) | Select-Object -First 6 | ForEach-Object { Limit-Text $_ 18 }) -join '、') + '）' })，上方 $($s.above) 个（需要先 scroll 再操作）"
    }
    if ([int]$s.covered -gt 0) { $pageLine += "`n  ⛔ 标记的控件被其它元素（遮罩 / 弹窗）挡住，点击会落在遮挡物上；请先关闭遮挡物（通常是弹窗的关闭 / 同意按钮）" }
    $focusLine = ''
    if ($m.act) { $focusLine = "当前键盘焦点: [网页] $($m.act.tag)$(if ($m.act.type) { '/' + $m.act.type }) `"$(Limit-Text "$($m.act.name)" 40)`"" }
    $hint = ''
    if ([double]$m.cv -ge 0.25 -and $inter -lt 25) { $hint = "画布 / WebGL 占视口 $([int]([double]$m.cv * 100))% 且可交互 DOM 节点只有 $inter 个" }
    elseif ([int]$m.cap -gt 0) { $hint = "视口内检测到验证码组件（$($m.cap) 处，可能是无语义图片）" }
    elseif ([int]$s.oopif -gt 0 -and $inter -lt 12) { $hint = "$($s.oopif) 个跨进程 iframe 无法经 CDP 读取" }
    $res = [pscustomobject]@{
        Items = $items; Nodes = $inter; Inflight = [int]$c.InFlight(4000); Ms = [int]$sw.ElapsedMilliseconds; Hint = $hint; Line = $pageLine; FocusLine = $focusLine
        Stats = $s; Origin = $origin; UseItems = $true; Url = "$($m.url)"; Title = "$($m.title)"
    }
    $script:CdpLast = $res
    return $res
}
# ---------- 单目标实时解析（身份 = backendNodeId，不靠位置猜）----------
function Resolve-CdpItemTarget($item, [int]$n) {
    if (-not (Test-CdpForeground)) { throw "控件 [$n] 所在的网页已不在前台（界面已变化），请重新观察" }
    $c = $script:Cdp
    if ($c.DialogOpen) { throw "页面正显示 JS 对话框（$($c.DialogInfo)），请先用 key enter / escape 处理，再继续" }
    $r = $null
    for ($try = 0; $try -lt 2 -and $null -eq $r; $try++) {
        try { $r = ($c.LiveTarget([int]$item.Bid, 3000) | ConvertFrom-Json) }
        catch { if ($try -eq 0 -and (-not $c.Connected) -and (Restore-CdpConnection)) { continue }; throw "控件 [$n] 无法通过 CDP 核对（$(Limit-Text (Get-NativeError $_) 100)），请重新观察" }
    }
