        try { lock (sendLock) { ws.SendAsync(new ArraySegment<byte>(bytes), WebSocketMessageType.Text, true, cts.Token).GetAwaiter().GetResult(); } Interlocked.Increment(ref Sent); }
        catch { TaskCompletionSource<string> d; pending.TryRemove(id, out d); throw; }
        return tcs.Task;
    }
    public string Call(string method, string paramsJson, int timeoutMs) {
