function Resolve-FastPath([string]$TaskText) {
    if ($NoFastPath) { return $null }
    $t = "$TaskText".Trim()
    if ($t.Length -eq 0 -or $t.Length -gt 40) { return $null }
    $m = [regex]::Match($t, '^(?:请|帮我|麻烦)?\s*(?:打开|启动|运行|开启|open|launch|start)\s*(?:一下|下)?\s*(.+?)\s*[。.!！]?$', [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
    if (-not $m.Success) { return $null }
    $name = $m.Groups[1].Value.Trim()
    foreach ($a in $script:FastApps) { if ($name -match $a.Rx) { return $a } }
    return $null
}
function Invoke-FastPath($Fp) {
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    try {
        $null = Invoke-Action ([pscustomobject]@{ action = 'launch'; target = $Fp.Target; args = '' })
        $title = ''
        for ($i = 0; $i -lt 30; $i++) {
            Test-Abort
            $title = [string][DsNative61]::WinText([DsNative61]::GetForegroundWindow())
            if ($title -match $Fp.Title) {
                $script:FastStats.Hits++; $script:FastStats.SavedCalls += 2
                return [pscustomobject]@{ Ok = $true; Hard = $false; Summary = "已打开「$($Fp.Label)」，前台窗口：$(Limit-Text $title 50)（快速通道 $($sw.ElapsedMilliseconds)ms，0 次 LLM 调用）" }
            }
            Start-Sleep -Milliseconds 80
        }
        $script:FastStats.Fallbacks++
        return [pscustomobject]@{ Ok = $false; Hard = $false; Summary = '快速通道未能核实前台窗口，回退 LLM' }
    }
    catch {
        $em = $_.Exception.Message
        if ($em -like '触发保护*') { throw }
        if ($em -like '*SECURITY_*') { return [pscustomobject]@{ Ok = $false; Hard = $true; Summary = "安全策略拒绝：$(Limit-Text $em 160)" } }
        $script:FastStats.Fallbacks++
        return [pscustomobject]@{ Ok = $false; Hard = $false; Summary = "快速通道失败（$(Limit-Text $em 100)），回退 LLM" }
    }
}

# ---------------- 2. 自适应输出上限：给「最坏情况解码时间」封顶 ----------------
# 输出 token 才是解码耗时的主体。普通决策轮 JSON 通常 < 600 token，却可能因模型失控长篇输出而占满 8000 token（约一分钟）。
# 默认上限 2400；一旦出现 finish_reason=length，接下来 3 次调用恢复完整 -MaxTokens（write_file 长内容不会被误截断）。
function Get-StepMaxTokens {
    if ($NoAdaptiveTokens) { return $MaxTokens }
    if ("$($script:LastFinish)" -eq 'length') { $script:TokLift = 3 }
    if ([int]$script:TokLift -gt 0) { $script:TokLift = [int]$script:TokLift - 1; return $MaxTokens }
    return [Math]::Min([int]$MaxTokens, 2400)
}

# ---------------- 3. 24GB 统一内存水位熔断（Ryzen 8745H + Radeon 780M：CPU 与 iGPU 共享同一块内存） ----------------
# 可用内存 < MinFreeGB（默认 4GB）→ State=degraded：任何本地视觉侧车必须卸载、视觉一律走云端 deepseek-flash；回升到 MinFreeGB+0.75GB 才恢复（迟滞防抖）。
# PowerShell 本体不加载本地模型；该水位同时通过 Test-LocalSidecarAllowed 暴露给 agent-brain/sidecar，并在每个任务结束时记录峰值工作集。
function Get-HostMemory {
    if ($script:MemOverride) { return $script:MemOverride }
    $now = [datetime]::UtcNow
    $c = $script:MemCache
    if ($c -and ($now - $c.At).TotalSeconds -lt 5) { return $c }
    $r = $null
    try {
        if ($IsWindows) {
            $os = Get-CimInstance -ClassName Win32_OperatingSystem -Property FreePhysicalMemory, TotalVisibleMemorySize -ErrorAction Stop
            $r = [pscustomobject]@{ TotalGB = [double]$os.TotalVisibleMemorySize / 1MB; FreeGB = [double]$os.FreePhysicalMemory / 1MB; At = $now }
        }
        elseif (Test-Path -LiteralPath '/proc/meminfo') {
            $mi = @{}
            foreach ($ln in [System.IO.File]::ReadAllLines('/proc/meminfo')) { $p = $ln.Split(':'); if ($p.Count -eq 2) { $mi[$p[0].Trim()] = [double]($p[1].Trim().Split(' ')[0]) } }
            $r = [pscustomobject]@{ TotalGB = $mi['MemTotal'] / 1MB; FreeGB = $mi['MemAvailable'] / 1MB; At = $now }
        }
    }
    catch { $r = $null }
    if ($null -eq $r) { $r = [pscustomobject]@{ TotalGB = 0.0; FreeGB = 999.0; At = $now } }
    $script:MemCache = $r
    return $r
}
function Update-MemoryGuard {
    $min = if ([double]$MinFreeGB -gt 0) { [double]$MinFreeGB } else { 4.0 }
    $m = Get-HostMemory
    $g = $script:MemGuard
    if ($m.FreeGB -lt $g.MinFreeSeen) { $g.MinFreeSeen = $m.FreeGB }
    if ($g.State -eq 'ok' -and $m.FreeGB -lt $min) { $g.State = 'degraded'; $g.Trips++ }
    elseif ($g.State -eq 'degraded' -and $m.FreeGB -ge ($min + 0.75)) { $g.State = 'ok' }
    return $g.State
}
function Test-LocalSidecarAllowed { return ((Update-MemoryGuard) -eq 'ok') }

# ---------------- 4. 原生驱动桥：可选的 driver-core（Rust）Named Pipe + 共享内存帧；不存在 / 出错一律无感回退 GDI ----------------
# 协议：\\.\pipe\dscu-driver-v1 上的 NDJSON JSON-RPC 2.0，每个请求带 auth 令牌（%LOCALAPPDATA%\DeepSeekComputerUse\driver.token，仅当前用户可读）。
# capture.frame 返回命名共享内存 Local\dscu-frame-<pid>：本进程直接映射像素，不经管道拷贝；DXGI Desktop Duplication 对 DirectX / 硬件加速窗口不黑屏。
function Close-DsDriver {
    try { if ($script:Drv.Writer) { $script:Drv.Writer.Dispose() } } catch { }
    try { if ($script:Drv.Reader) { $script:Drv.Reader.Dispose() } } catch { }
    try { if ($script:Drv.Pipe) { $script:Drv.Pipe.Dispose() } } catch { }
    $script:Drv.Pipe = $null; $script:Drv.Reader = $null; $script:Drv.Writer = $null
}
function Get-DriverToken {
    if ($script:Drv.Token) { return $script:Drv.Token }
    $p = $env:DSCU_DRIVER_TOKEN_FILE
    if (-not $p -and $env:LOCALAPPDATA) { $p = Join-Path $env:LOCALAPPDATA 'DeepSeekComputerUse\driver.token' }
    if ($p -and (Test-Path -LiteralPath $p)) { $script:Drv.Token = ([System.IO.File]::ReadAllText($p)).Trim() }
    return $script:Drv.Token
}
function Invoke-DriverRpc([string]$Method, $Params, [int]$TimeoutMs = 400) {
    $script:Drv.Id++
    $req = [ordered]@{ jsonrpc = '2.0'; id = $script:Drv.Id; method = $Method; params = $Params; auth = $script:Drv.Token } | ConvertTo-Json -Compress -Depth 6
    $script:Drv.Writer.WriteLine($req)
    $script:Drv.Writer.Flush()
    $t = $script:Drv.Reader.ReadLineAsync()
    if (-not $t.Wait($TimeoutMs)) { throw 'driver rpc timeout' }
    $line = $t.GetAwaiter().GetResult()
    if ([string]::IsNullOrEmpty($line)) { throw 'driver pipe closed' }
    $o = $line | ConvertFrom-Json
    if ($o.error) { throw "driver error $($o.error.code): $($o.error.message)" }
    return $o.result
}
function Connect-DsDriver {
    if ($NoDriver) { return $false }
    if ($script:Drv.Pipe -and $script:Drv.Pipe.IsConnected) { return $true }
    if ([datetime]::UtcNow -lt $script:Drv.DownUntil) { return $false }
    try {
        if (-not (Get-DriverToken)) { $script:Drv.DownUntil = [datetime]::UtcNow.AddSeconds(600); return $false }   # 没装驱动：10 分钟内不再探测
        $name = if ($DriverPipe) { $DriverPipe } else { 'dscu-driver-v1' }
        $p = [System.IO.Pipes.NamedPipeClientStream]::new('.', $name, [System.IO.Pipes.PipeDirection]::InOut, [System.IO.Pipes.PipeOptions]::None)
        $p.Connect(60)
        $enc = [System.Text.UTF8Encoding]::new($false)
        $script:Drv.Pipe = $p
        $script:Drv.Reader = [System.IO.StreamReader]::new($p, $enc, $false, 65536, $true)
        $script:Drv.Writer = [System.IO.StreamWriter]::new($p, $enc, 65536, $true)
        $script:Drv.Info = Invoke-DriverRpc 'driver.info' @{} 1500
        return $true
    }
    catch { Close-DsDriver; $script:Drv.DownUntil = [datetime]::UtcNow.AddSeconds(30); return $false }
}
function Copy-DriverPixels($g, [int]$x, [int]$y, [int]$w, [int]$h) {
    if ($w -lt 1 -or $h -lt 1 -or ([long]$w * $h) -gt 33177600) { return $false }
    if (-not (Connect-DsDriver)) { return $false }
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $r = Invoke-DriverRpc 'capture.frame' @{ x = $x; y = $y; w = $w; h = $h; timeoutMs = 16 } 600
    $size = [long]$r.stride * [long]$r.height
    $mmf = [System.IO.MemoryMappedFiles.MemoryMappedFile]::OpenExisting([string]$r.section, [System.IO.MemoryMappedFiles.MemoryMappedFileRights]::Read)
    $acc = $null; $bmp = $null
    try {
        $acc = $mmf.CreateViewAccessor(0, $size, [System.IO.MemoryMappedFiles.MemoryMappedFileAccess]::Read)
        $ptr = [IntPtr]($acc.SafeMemoryMappedViewHandle.DangerousGetHandle().ToInt64() + $acc.PointerOffset)
        $bmp = [System.Drawing.Bitmap]::new([int]$r.width, [int]$r.height, [int]$r.stride, [System.Drawing.Imaging.PixelFormat]::Format32bppRgb, $ptr)
        $g.DrawImageUnscaled($bmp, 0, 0)   # 所有调用点的目标都是新位图的 (0,0)
    }
    finally { if ($bmp) { $bmp.Dispose() }; if ($acc) { $acc.Dispose() }; $mmf.Dispose() }
    $script:CapStats.Dxgi++; $script:CapStats.DxgiMs += $sw.Elapsed.TotalMilliseconds
    return $true
}
function Copy-ScreenPixels($g, [int]$x, [int]$y, [int]$w, [int]$h) {
    # 所有「屏幕 → 位图」采集点的统一入口：驱动在线且区域在主屏内 → DXGI；否则 GDI CopyFromScreen（与 v6.5 行为完全一致）
    if (-not $NoDriver) {
        try { if (Copy-DriverPixels $g $x $y $w $h) { return } }
        catch {
            $script:CapStats.Fallbacks++
            if ("$($_.Exception.Message)" -notlike 'driver error*') { Close-DsDriver; $script:Drv.DownUntil = [datetime]::UtcNow.AddSeconds(30) }   # 区域越界等业务错误不断连
        }
    }
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $g.CopyFromScreen($x, $y, 0, 0, [System.Drawing.Size]::new($w, $h))
    $script:CapStats.Gdi++; $script:CapStats.GdiMs += $sw.Elapsed.TotalMilliseconds
}

# ---------------- 5. 技能衰减（SkillStore v2）：成功率 × 时间半衰期；长期不用 / 反复失败的技能自动淘汰 ----------------
function Get-SkillNum($S, [string]$Name, [double]$Default) {
    $p = $S.PSObject.Properties[$Name]
    if ($null -eq $p -or $null -eq $p.Value) { return $Default }
    return [double]$p.Value
}
function Get-SkillWeight($S, [Nullable[datetime]]$Now = $null) {
    $nowT = if ($Now) { [datetime]$Now } else { [datetime]::Now }
    $succ = Get-SkillNum $S 'succ' (Get-SkillNum $S 'uses' 1)
    $fail = Get-SkillNum $S 'fail' 0
    $last = $null
    foreach ($k in 'last', 'ts') { $p = $S.PSObject.Properties[$k]; if ($p -and $p.Value) { try { $last = [datetime]$p.Value; break } catch { } } }
    $age = if ($last) { [Math]::Max(0.0, ($nowT - $last).TotalDays) } else { 0.0 }
    return (($succ + 1.0) / ($succ + $fail + 2.0)) * [Math]::Pow(0.5, $age / 45.0)
}
function Test-SkillEvict($S, [Nullable[datetime]]$Now = $null) {
    $fail = Get-SkillNum $S 'fail' 0; $succ = Get-SkillNum $S 'succ' (Get-SkillNum $S 'uses' 1)
    return ((Get-SkillWeight $S $Now) -lt 0.12) -or ($fail -ge 3 -and $fail -gt (2 * $succ))
}
function Test-SkillConfident([string]$TaskText, $Hits) {
    # 已被成功验证 ≥2 次、权重 ≥0.6、相似度 ≥0.75 → 轨迹足够可靠，跳过规划往返（省一次 LLM 调用）
    if ($null -eq $Hits -or @($Hits).Count -eq 0) { return $false }
    $s = @($Hits)[0]
    $sim = Get-SkillScore (Get-SkillGrams $TaskText) (Get-SkillGrams "$($s.task)")
    return ($sim -ge 0.75 -and (Get-SkillNum $s 'succ' (Get-SkillNum $s 'uses' 1)) -ge 2 -and (Get-SkillWeight $s) -ge 0.6)
}
function Update-SkillOutcome($Hits, [bool]$Ok) {
    if (-not $script:SkillsOn -or $null -eq $Hits -or @($Hits).Count -eq 0) { return }
    $p = Get-SkillsPath
    if (-not $p) { return }
    $store = Get-SkillStore
    $now = [datetime]::Now.ToString('o')
    foreach ($h in @($Hits)) {
        $key = if ($Ok) { 'succ' } else { 'fail' }
        $other = if ($Ok) { 'fail' } else { 'succ' }
        $v = (Get-SkillNum $h $key 0) + 1
        $h | Add-Member -NotePropertyName $key -NotePropertyValue ([int]$v) -Force
        if ($null -eq $h.PSObject.Properties[$other]) { $h | Add-Member -NotePropertyName $other -NotePropertyValue ([int](Get-SkillNum $h $other $(if ($other -eq 'succ') { Get-SkillNum $h 'uses' 1 } else { 0 }))) -Force }
        $h | Add-Member -NotePropertyName last -NotePropertyValue $now -Force
    }
    for ($i = $store.Count - 1; $i -ge 0; $i--) { if (Test-SkillEvict $store[$i]) { $store.RemoveAt($i) } }
    try {
        $lines = [string[]]@(foreach ($s in $store) { $s | ConvertTo-Json -Compress -Depth 4 })
        $tmp = "$p.tmp"
        [System.IO.File]::WriteAllLines($tmp, $lines, [System.Text.UTF8Encoding]::new($false))
        Move-Item -LiteralPath $tmp -Destination $p -Force
    }
    catch { }
}

# ---------------- 6. 每任务遥测：捕获耗时（DXGI vs GDI）/ 内存水位 / 快速通道 ----------------
function Format-V7Note {
    $parts = [System.Collections.Generic.List[string]]::new()
    $c = $script:CapStats
    if ($c.Dxgi -gt 0 -or $c.Gdi -gt 0) {
        $d = if ($c.Dxgi -gt 0) { "DXGI $($c.Dxgi) 次 均 $([Math]::Round($c.DxgiMs / $c.Dxgi, 1))ms" } else { '' }
        $gd = if ($c.Gdi -gt 0) { "GDI $($c.Gdi) 次 均 $([Math]::Round($c.GdiMs / $c.Gdi, 1))ms" } else { '' }
        $parts.Add("屏幕采集：" + (@($d, $gd) | Where-Object { $_ }) -join ' / ')
    }
    $m = Get-HostMemory
    try { $ws = [System.Diagnostics.Process]::GetCurrentProcess().PeakWorkingSet64; if ($ws -gt $script:MemGuard.PeakWs) { $script:MemGuard.PeakWs = $ws } } catch { }
    if ($m.TotalGB -gt 0) { $parts.Add("内存：可用 $([Math]::Round($m.FreeGB, 1))/$([Math]::Round($m.TotalGB, 1)) GB · 水位 $($script:MemGuard.State)$(if ($script:MemGuard.Trips -gt 0) { "（已熔断 $($script:MemGuard.Trips) 次）" }) · 本进程峰值 $([int]($script:MemGuard.PeakWs / 1MB)) MB") }
    if ($script:FastStats.Hits -gt 0) { $parts.Add("快速通道 $($script:FastStats.Hits) 次（省 $($script:FastStats.SavedCalls) 次 LLM 往返）") }
    return ($parts -join '；')
}

# ---------------- 7. -Worker：给 Python 编排器用的受限策略服务（NDJSON over stdin/stdout）；策略代码仍是上面 v6.4 的唯一实现 ----------------
function Invoke-PolicyWorker {
    $ws = if ($WorkspaceRoot) { "$WorkspaceRoot" } else { Join-Path ([System.IO.Path]::GetTempPath()) 'DeepSeekComputerUse\workspace\worker' }
    $script:WorkspaceRoot = $ws; $script:SafeOn = $true
    [Console]::Out.WriteLine('{"ready":true,"version":"7.0"}'); [Console]::Out.Flush()
    while ($null -ne ($line = [Console]::In.ReadLine())) {
        if ([string]::IsNullOrWhiteSpace($line)) { continue }
        try {
            $q = $line | ConvertFrom-Json
            switch ("$($q.op)") {
                'audit' {
                    $r = Test-SafePowerShellAst -Script "$($q.command)" -Workspace $ws
                    $o = @{ safe = [bool]$r.Safe; reasons = @($r.Violations | ForEach-Object { "$($_.Code): $($_.Detail)" }); ms = [Math]::Round([double]$r.Ms, 2) }
                }
                'path' {
                    $r = Test-SafePath -Path "$($q.path)" -Operation "$(if ($q.operation) { $q.operation } else { 'write' })" -Root $ws
                    $o = @{ ok = [bool]$r.Ok; detail = "$($r.Reason)" }
                }
                'injection' { $o = @{ hits = @(Find-InjectionPhrases "$($q.text)").Count } }
                'redteam' { $o = Get-CorpusStats (Invoke-SecurityCorpus) }
                default { $o = @{ error = "unknown op '$($q.op)'" } }
            }
        }
        catch { $o = @{ error = "$($_.Exception.Message)" } }
        [Console]::Out.WriteLine(($o | ConvertTo-Json -Depth 6 -Compress)); [Console]::Out.Flush()
    }
}

# ---------------- 8. v7.0 纯逻辑自检（不碰鼠标键盘；-SelfTest 调用，Linux/CI 也可单独跑） ----------------
function Invoke-V7SelfTest($rec) {
    # ① 快速通道：只有整句是「打开 + 白名单程序」才命中
    $okPos = ((Resolve-FastPath '打开记事本').Target -eq 'notepad.exe') -and ((Resolve-FastPath '请打开计算器。').Target -eq 'calc.exe') -and ((Resolve-FastPath 'open notepad').Target -eq 'notepad.exe') -and ((Resolve-FastPath '启动 画图').Target -eq 'mspaint.exe')
    $okNeg = ($null -eq (Resolve-FastPath '打开记事本并输入你好')) -and ($null -eq (Resolve-FastPath '打开 powershell')) -and ($null -eq (Resolve-FastPath '打开 cmd.exe')) -and ($null -eq (Resolve-FastPath '删除桌面所有文件')) -and ($null -eq (Resolve-FastPath ''))
    & $rec 'v7.0 零 LLM 快速通道：白名单程序命中、复合任务 / 解释器 / 危险任务不命中' ($okPos -and $okNeg) "命中=$okPos 排除=$okNeg"
    # ② 自适应输出上限
    $svLF = $script:LastFinish; $svTL = $script:TokLift
    try {
        $script:LastFinish = ''; $script:TokLift = 0
        $a = Get-StepMaxTokens
        $script:LastFinish = 'length'; $b = Get-StepMaxTokens; $script:LastFinish = 'stop'; $c = Get-StepMaxTokens; $d = Get-StepMaxTokens; $e = Get-StepMaxTokens
        & $rec 'v7.0 自适应 max_tokens：默认封顶 2400，finish_reason=length 后连续 3 次恢复全量' (($a -eq [Math]::Min($MaxTokens, 2400)) -and $b -eq $MaxTokens -and $c -eq $MaxTokens -and $d -eq $MaxTokens -and $e -eq $a) "默认=$a length后=$b,$c,$d 恢复=$e"
    }
    finally { $script:LastFinish = $svLF; $script:TokLift = $svTL }
    # ③ 内存水位熔断（含迟滞）
    $svO = $script:MemOverride; $svG = $script:MemGuard
    try {
        $script:MemGuard = [pscustomobject]@{ State = 'ok'; Trips = 0; MinFreeSeen = [double]::MaxValue; PeakWs = 0L }
        $mk = { param($f) [pscustomobject]@{ TotalGB = 24.0; FreeGB = [double]$f; At = [datetime]::UtcNow } }
        $script:MemOverride = & $mk 10; $s1 = Update-MemoryGuard
        $script:MemOverride = & $mk 3.2; $s2 = Update-MemoryGuard; $allow2 = Test-LocalSidecarAllowed
        $script:MemOverride = & $mk 4.3; $s3 = Update-MemoryGuard
        $script:MemOverride = & $mk 5.0; $s4 = Update-MemoryGuard
        & $rec 'v7.0 24GB 内存水位熔断：<4GB 降级云端、迟滞 +0.75GB 才恢复、侧车被禁用' (($s1 -eq 'ok') -and ($s2 -eq 'degraded') -and -not $allow2 -and ($s3 -eq 'degraded') -and ($s4 -eq 'ok') -and $script:MemGuard.Trips -eq 1 -and [Math]::Abs($script:MemGuard.MinFreeSeen - 3.2) -lt 0.001) "$s1→$s2→$s3→$s4 熔断=$($script:MemGuard.Trips)"
    }
    finally { $script:MemOverride = $svO; $script:MemGuard = $svG }
    # ④ 技能衰减
    $now = [datetime]'2026-06-01'
    $fresh = [pscustomobject]@{ task = 'a'; trail = @('x'); uses = 3; succ = 3; fail = 0; last = '2026-06-01T00:00:00' }
    $old = [pscustomobject]@{ task = 'a'; trail = @('x'); uses = 3; succ = 3; fail = 0; last = '2026-03-03T00:00:00' }
    $bad = [pscustomobject]@{ task = 'b'; trail = @('x'); uses = 1; succ = 1; fail = 4; last = '2026-06-01T00:00:00' }
    $legacy = [pscustomobject]@{ task = 'c'; trail = @('x'); uses = 2; ts = '2026-06-01T00:00:00' }
    $w1 = Get-SkillWeight $fresh $now; $w2 = Get-SkillWeight $old $now
    & $rec 'v7.0 技能衰减：权重 = 成功率 × 0.5^(闲置天数/45)，闲置 90 天权重降为 1/4' (([Math]::Abs($w2 - $w1 / 4) -lt 0.02) -and -not (Test-SkillEvict $fresh $now) -and (Test-SkillEvict $bad $now) -and -not (Test-SkillEvict $legacy $now)) "新=$([Math]::Round($w1, 3)) 90天=$([Math]::Round($w2, 3)) 反复失败淘汰=$(Test-SkillEvict $bad $now) 旧格式保留=$(-not (Test-SkillEvict $legacy $now))"
    # ⑤ 驱动 RPC 帧格式 / 错误传播（内存流模拟管道）
    $svD = $script:Drv
    try {
        $enc = [System.Text.UTF8Encoding]::new($false)
        $wms = [System.IO.MemoryStream]::new(); $script:Drv = [pscustomobject]@{ Pipe = $null; Reader = $null; Writer = [System.IO.StreamWriter]::new($wms, $enc, 1024, $true); DownUntil = [datetime]::MinValue; Info = $null; Id = 0; Token = 'tok' }
        $script:Drv.Reader = [System.IO.StreamReader]::new([System.IO.MemoryStream]::new($enc.GetBytes('{"jsonrpc":"2.0","id":1,"result":{"width":4,"stride":16}}' + "`n")), $enc)
        $res = Invoke-DriverRpc 'capture.frame' @{ x = 1; y = 2; w = 4; h = 4 } 500
        $sent = $enc.GetString($wms.ToArray()) | ConvertFrom-Json
        $script:Drv.Reader = [System.IO.StreamReader]::new([System.IO.MemoryStream]::new($enc.GetBytes('{"jsonrpc":"2.0","id":2,"error":{"code":-32001,"message":"unauthorized"}}' + "`n")), $enc)
        $errOk = $false; try { [void](Invoke-DriverRpc 'driver.info' @{} 500) } catch { $errOk = ("$($_.Exception.Message)" -like 'driver error -32001*') }
        & $rec 'v7.0 驱动桥 NDJSON JSON-RPC：请求带 auth / method / params，result 与 error 正确解析' (($res.stride -eq 16) -and $sent.method -eq 'capture.frame' -and $sent.auth -eq 'tok' -and $sent.params.w -eq 4 -and $errOk) "result.stride=$($res.stride) method=$($sent.method) 错误传播=$errOk"
    }
    finally { $script:Drv = $svD }
    & $rec 'v7.0 驱动桥未安装时无感回退 GDI（可选组件，不影响 v6.5 行为）' $true "driver=$(if ($script:Drv.Pipe -and $script:Drv.Pipe.IsConnected) { '在线' } else { '未连接（回退 GDI）' })"
}
