# ---------- ① 控制台让位 ----------
function Invoke-ConsoleYield {
    # 目标点被本脚本的控制台挡住：把控制台最小化（不激活），再把观察到的目标窗口切回前台
    if ($NoConsoleYield -or $script:ConsoleHwnd -eq [IntPtr]::Zero) { return $false }
    try {
        if (-not [DsWin5.U]::IsIconic($script:ConsoleHwnd)) { [void][DsWin5.U]::ShowWindow($script:ConsoleHwnd, 7) }   # SW_SHOWMINNOACTIVE
        $script:ConsoleParked = $true
        Start-Sleep -Milliseconds 150
        $tgt = $script:LastTarget
        if ($script:ObsHwnd -ne [IntPtr]::Zero -and -not (Test-IsConsoleWindow $script:ObsHwnd)) { $tgt = $script:ObsHwnd }
        if ($tgt -ne [IntPtr]::Zero -and [DsNative61]::IsWindow($tgt)) { [void][DsNative61]::Activate($tgt) }
        Start-Sleep -Milliseconds 120
        # 让位前的像素基线里是控制台，必须重新采样，否则会把「控制台消失」误判成「点击生效」
        if ($script:EffectProbe) { $ep = $script:EffectProbe; Start-EffectProbe $ep.X $ep.Y $ep.Rad }
        return $true
    }
    catch { return $false }
}
function Resume-TargetWindow {
    # 每轮观察前：前台若是本控制台，由系统自动切回上一个目标窗口（不再让模型花一步 focus_window）
    $fg = [DsNative61]::GetForegroundWindow()
    if ($fg -ne [IntPtr]::Zero -and -not (Test-IsConsoleWindow $fg)) { $script:LastTarget = $fg; return '' }
    if ($NoConsoleYield) { return '' }
    $t = $script:LastTarget
    if ($t -eq [IntPtr]::Zero -or -not [DsNative61]::IsWindow($t) -or (Test-IsConsoleWindow $t)) { return '' }
    if ([DsNative61]::Activate($t)) {
        Start-Sleep -Milliseconds 150
        return "前台原本是运行本脚本的控制台，系统已自动切回上一个目标窗口 [$(Limit-Text ([DsNative61]::WinText($t)) 50)]，不需要再 focus_window；任务若需要别的程序请 launch / focus_window。"
    }
    return ''
}

# ---------- ② 局部视觉证据（点击点周围的小块屏幕，动作前后对比，先测静止噪声） ----------
function Get-RegionSample([int]$cx, [int]$cy, [int]$rad) {
    # 截取 (cx,cy) 周围的小块屏幕（物理像素），等距采样最多 32x32 个点；虚拟鼠标窗口已排除出截图
    $bmp = $null; $g = $null
    try {
        $vb = Get-ViewBounds; $s = $vb.Screen
        $x0 = [int][Math]::Max($cx - $rad, $s[0]); $y0 = [int][Math]::Max($cy - $rad, $s[1])
        $x1 = [int][Math]::Min($cx + $rad, $s[2]); $y1 = [int][Math]::Min($cy + $rad, $s[3])
        $w = $x1 - $x0; $h = $y1 - $y0
        if ($w -lt 6 -or $h -lt 6) { return $null }
        $fmt = [System.Drawing.Imaging.PixelFormat]::Format32bppArgb
        $bmp = [System.Drawing.Bitmap]::new($w, $h, $fmt)
        $g = [System.Drawing.Graphics]::FromImage($bmp)
        Copy-ScreenPixels $g $x0 $y0 $w $h
        $bd = $bmp.LockBits([System.Drawing.Rectangle]::new(0, 0, $w, $h), [System.Drawing.Imaging.ImageLockMode]::ReadOnly, $fmt)
        try {
            $stride = [Math]::Abs($bd.Stride)
            $buf = New-Object 'byte[]' ($stride * $h)
            [System.Runtime.InteropServices.Marshal]::Copy($bd.Scan0, $buf, 0, $buf.Length)
        }
        finally { $bmp.UnlockBits($bd) }
        $nx = [Math]::Min(32, $w); $ny = [Math]::Min(32, $h)
        $px = New-Object 'int[]' ($nx * $ny)
        $k = 0
        for ($j = 0; $j -lt $ny; $j++) {
            $yy = [int][Math]::Floor(($j + 0.5) * $h / $ny)
            for ($i = 0; $i -lt $nx; $i++) {
                $xx = [int][Math]::Floor(($i + 0.5) * $w / $nx)
                $o = $yy * $stride + $xx * 4
                $px[$k] = ([int]$buf[$o + 2] -shl 16) -bor ([int]$buf[$o + 1] -shl 8) -bor [int]$buf[$o]
                $k++
            }
        }
        return [pscustomobject]@{ L = $x0; T = $y0; W = $w; H = $h; Px = $px }
    }
    catch { return $null }
    finally { if ($g) { $g.Dispose() }; if ($bmp) { $bmp.Dispose() } }
}
function Get-SampleDiff($sa, $sb) {
    # 两次采样之间 RGB 总差 ≥60 的采样点占比（%）
    if ($null -eq $sa -or $null -eq $sb -or $sa.Px.Length -ne $sb.Px.Length -or $sa.Px.Length -eq 0) { return $null }
    $n = 0
    for ($i = 0; $i -lt $sa.Px.Length; $i++) {
        $p = $sa.Px[$i]; $q = $sb.Px[$i]
        $d = [Math]::Abs((($p -shr 16) -band 255) - (($q -shr 16) -band 255)) + [Math]::Abs((($p -shr 8) -band 255) - (($q -shr 8) -band 255)) + [Math]::Abs(($p -band 255) - ($q -band 255))
        if ($d -ge 60) { $n++ }
    }
    return [Math]::Round(100.0 * $n / $sa.Px.Length, 1)
}
function Get-ColorStats($smp) {
    # 鲜艳像素按色相分 8 桶，返回 @{ 颜色名 = 百分比 }：点亮的红心、选中的蓝色、绿色对勾都会体现在这里
    $res = @{}
    if ($null -eq $smp -or $smp.Px.Length -eq 0) { return $res }
    $cnt = New-Object 'int[]' 8
    foreach ($p in $smp.Px) {
        $r = ($p -shr 16) -band 255; $g = ($p -shr 8) -band 255; $b = $p -band 255
        $mx = [Math]::Max($r, [Math]::Max($g, $b)); $mn = [Math]::Min($r, [Math]::Min($g, $b))
        $c = $mx - $mn
        if ($mx -lt 70 -or $c -lt 70) { continue }
        if ($mx -eq $r) { $hh = 60.0 * ((($g - $b) / $c) % 6) }
        elseif ($mx -eq $g) { $hh = 60.0 * ((($b - $r) / $c) + 2) }
        else { $hh = 60.0 * ((($r - $g) / $c) + 4) }
        if ($hh -lt 0) { $hh += 360 }
        $bin = 7
        if ($hh -lt 15 -or $hh -ge 345) { $bin = 0 } elseif ($hh -lt 40) { $bin = 1 } elseif ($hh -lt 70) { $bin = 2 } elseif ($hh -lt 160) { $bin = 3 } elseif ($hh -lt 200) { $bin = 4 } elseif ($hh -lt 255) { $bin = 5 } elseif ($hh -lt 300) { $bin = 6 }
        $cnt[$bin]++
    }
    for ($i = 0; $i -lt 8; $i++) { if ($cnt[$i] -gt 0) { $res[$script:HueNames[$i]] = [Math]::Round(100.0 * $cnt[$i] / $smp.Px.Length, 1) } }
    return $res
}
function Format-ColorShift($before, $after) {
    $names = @(@($before.Keys) + @($after.Keys) | Select-Object -Unique)
    $parts = [System.Collections.Generic.List[string]]::new()
    foreach ($nm in $names) {
        $x = [double]$before[$nm]; $y = [double]$after[$nm]
        if ([Math]::Abs($y - $x) -ge 3) { $parts.Add("$nm $x%→$y%") }
    }
    return ($parts -join '，')
}
function Start-EffectProbe([int]$x, [int]$y, [int]$rad = 0) {
    # 动作前在目标点周围采样两次（间隔 110ms）：第二次作为基线，两次之差作为「静止噪声」（视频 / 动画）
    $script:EffectProbe = $null
    try {
        if ($rad -le 0) { $rad = [int][Math]::Max(40, [Math]::Min(160, 56 * [DsNative61]::DpiScale())) }
        $a1 = Get-RegionSample $x $y $rad
        Start-Sleep -Milliseconds 110
        $a2 = Get-RegionSample $x $y $rad
        if ($null -eq $a1 -or $null -eq $a2) { return }
        $script:EffectProbe = [pscustomobject]@{ X = $x; Y = $y; Rad = $rad; Before = $a2; Noise = (Get-SampleDiff $a1 $a2) }
    }
    catch { $script:EffectProbe = $null }
}
function Complete-EffectProbe {
    # 返回 @{ Verdict = changed / nochange / noisy ; Text = 证据 }；没有探针时返回 $null
    $p = $script:EffectProbe
    $script:EffectProbe = $null
    if ($null -eq $p) { return $null }
    try {
        $after = Get-RegionSample $p.X $p.Y $p.Rad
        $d = Get-SampleDiff $p.Before $after
        if ($null -eq $d) { return $null }
        $noise = [double]$p.Noise
        $shift = Format-ColorShift (Get-ColorStats $p.Before) (Get-ColorStats $after)
        $th = [Math]::Max(6.0, 2.0 * $noise + 3.0)
        $verdict = 'nochange'
        if ($d -ge $th) { $verdict = 'changed' }
        elseif ($noise -ge 25) { $verdict = 'noisy' }
        elseif ($shift) { $verdict = 'changed' }
        $txt = "局部视觉证据：点 ($($p.X),$($p.Y)) 周围 $(2 * $p.Rad)px 内 $d% 像素变化（动作前静止噪声 $noise%）"
        if ($shift) { $txt += "，鲜艳颜色占比 $shift" }
        $tail = ' → 背景在动（视频/动画），像素证据不可靠：请 inspect 该处看颜色/状态，不要直接重复'
        if ($verdict -eq 'changed') { $tail = ' → 该处确实变了' }
        elseif ($verdict -eq 'nochange') { $tail = ' → 该处没有可见变化（这次点击很可能没生效）' }
        return [pscustomobject]@{ Verdict = $verdict; Text = "$txt$tail" }
    }
    catch { return $null }
}

# ---------- ③ 坐标依据 / 不吸附大容器 ----------
function Test-UiaActionable($item) {
    if ($null -eq $item) { return $false }
    if ($item.Cdp) { return $false }   # v6.3：网页 CDP 条目没有 UIA 元素
    if ($item.Type -eq 'Edit') { return $true }
    foreach ($p in @($item.Pat)) { if ($p -in 'inv', 'tog', 'sel', 'exp') { return $true } }
    return $false
}
function Test-Grounded([int]$x, [int]$y) {
    # 坐标点击的依据：落在当前观察某个「小」控件的矩形内（大容器不算），或落在 inspect / ocr 给出的区域内
    if ($null -eq $script:Elements -or $script:Elements.Count -eq 0) { return $true }
    $maxA = [Math]::Pow(320.0 * [DsNative61]::DpiScale(), 2)
    foreach ($kv in $script:Elements.GetEnumerator()) {
        $it = $kv.Value
        if ($it.Off) { continue }
        if (([double]$it.W * [double]$it.H) -gt $maxA) { continue }
        if ($x -ge ($it.L - 6) -and $x -le ($it.L + $it.W + 6) -and $y -ge ($it.T - 6) -and $y -le ($it.T + $it.H + 6)) { return $true }
    }
    foreach ($gr in $script:Grounded) {
        if ($x -ge ($gr.L - 12) -and $x -le ($gr.L + $gr.W + 12) -and $y -ge ($gr.T - 12) -and $y -le ($gr.T + $gr.H + 12)) { return $true }
    }
    return $false
}
function Add-NearLabels($all) {
    # 无名字的可交互容器（Group/Image/Custom）用其内部或紧邻（48px 内）的文字作标签，例如 ≈"41.1万"
    $texts = @($all | Where-Object { $_.Type -eq 'Text' } | Select-Object -First 600)
    if ($texts.Count -eq 0) { return }
    foreach ($it in $all) {
        if (-not $it.Extra -or -not [string]::IsNullOrWhiteSpace($it.Name)) { continue }
        $best = ''; $bestD = [double]::MaxValue
        $ax = [double]$it.L; $ay = [double]$it.T; $bx = $ax + [double]$it.W; $by = $ay + [double]$it.H
        foreach ($tx in $texts) {
            $tcx = [double]$tx.cx; $tcy = [double]$tx.cy
            if ($tcy -lt ($ay - 48) -or $tcy -gt ($by + 48) -or $tcx -lt ($ax - 48) -or $tcx -gt ($bx + 48)) { continue }
            $dx = [Math]::Max([Math]::Max($ax - $tcx, 0.0), $tcx - $bx)
            $dy = [Math]::Max([Math]::Max($ay - $tcy, 0.0), $tcy - $by)
            $d = [Math]::Sqrt($dx * $dx + $dy * $dy)
            if ($d -lt $bestD) { $bestD = $d; $best = "$($tx.Name)"; if ($d -le 0) { break } }
        }
        if ($best) { $it.Near = (Limit-Text $best 24) }
    }
}

# ---------- ④ 动作账本：切换类动作不重复、无效动作不硬试 ----------
function Get-ActionPoint($a) {
    if (Test-IdValue $a.id) {
        $n = [int]"$($a.id)"
        if ($script:Elements.ContainsKey($n)) { $it = $script:Elements[$n]; return @([int]$it.cx, [int]$it.cy) }
        return $null
    }
    if ((Test-NumValue $a.x) -and (Test-NumValue $a.y)) { return @([int][double]"$($a.x)", [int][double]"$($a.y)") }
    return $null
}
function New-LedgerProbe($a, [string]$kind) {
    if ($kind -notin $script:GuardKinds) { return $null }
    $keys = ''
    if ($kind -in 'key', 'hotkey') {
        $keys = ("$($a.keys)" -replace '\s*\+\s*', '+').Trim().ToLower()
        if ($keys -match $script:SafeRepeatKeys) { return $null }
    }
    if ($kind -eq 'type' -and (Test-True $a.clear)) { return $null }
    $pt = Get-ActionPoint $a
    if (($kind -in @('click', 'double_click', 'right_click', 'middle_click')) -and ($null -eq $pt)) { return $null }
    $title = ''
    try { $title = [DsNative61]::WinText([DsNative61]::GetForegroundWindow()) } catch { }
    $txt = ''
    if ($kind -eq 'type') { $txt = "$($a.text)" }
    return [pscustomobject]@{ Kind = $kind; Keys = $keys; Text = $txt; Pt = $pt; Title = $title }
}
function Test-LedgerMatch($e, $p) {
    if ($e.Kind -ne $p.Kind -or $e.Title -ne $p.Title) { return $false }
    if ($p.Kind -in 'key', 'hotkey') { return ($e.Keys -eq $p.Keys) }
    if ($p.Kind -eq 'type') {
        if ($e.Text -ne $p.Text) { return $false }
        if ($null -eq $p.Pt -and $null -eq $e.Pt) { return $true }
    }
    if ($null -eq $e.Pt -or $null -eq $p.Pt) { return $false }
    $dx = $e.Pt[0] - $p.Pt[0]; $dy = $e.Pt[1] - $p.Pt[1]
    return ([Math]::Sqrt($dx * $dx + $dy * $dy) -le 36)
}
function Assert-RepeatGuard($a, [string]$kind) {
    # 返回本次动作的账本探针（$null = 不受账本约束）；需要拒绝时抛出带错误码的异常（动作不会被执行）
    if ($NoRepeatGuard) { return $null }
    $p = New-LedgerProbe $a $kind
    if ($null -eq $p) { return $null }
    $hits = @($script:Ledger | Where-Object { Test-LedgerMatch $_ $p })
    if ($hits.Count -eq 0) { return $p }
    $last = $hits[$hits.Count - 1]
    $noEff = @($hits | Where-Object { $_.Outcome -eq 'nochange' }).Count
    $what = $p.Kind
    if ($p.Kind -in 'key', 'hotkey') { $what = "按键 $($p.Keys)" }
    elseif ($null -ne $p.Pt) { $what = "$($p.Kind) ($($p.Pt[0]),$($p.Pt[1])) 附近" }
    if ($noEff -ge 2) {
        throw "[REPEAT_NOEFFECT] $what 在本任务已执行 $($hits.Count) 次，其中 $noEff 次没有任何可验证的效果；原样重试不会有不同结果。请先 inspect 该区域（无障碍祖先链 / 文字 / 颜色），或换控件编号 / 换快捷键 / replan"
    }
    if ($last.Outcome -eq 'nochange') { return $p }
    $ok = Test-True $a.repeat
    if ($last.Outcome -eq 'changed') {
        if ($ok) { return $p }
        throw "[REPEAT_EFFECT] $what 在第 $($last.Step) 步已经执行过并且产生了变化（$(Limit-Text $last.Evidence 80)）。切换类动作（点赞 / 收藏 / 勾选 / 播放暂停）再执行一次会把效果撤销。如果任务确实需要再执行（翻下一个视频、多次点下一步），请在该动作里加 `"repeat`":true 并在 thought 里写明原因"
    }
    $key = "$($p.Kind)|$($p.Keys)"
    if ($null -ne $p.Pt) { $key += "|$([int]($p.Pt[0] / 36))_$([int]($p.Pt[1] / 36))" }
    $used = [int]$script:RepeatOverride[$key]
    if ($ok -and $used -lt 1) { $script:RepeatOverride[$key] = $used + 1; return $p }
    throw "[REPEAT_UNVERIFIED] $what 在第 $($last.Step) 步已执行过，但效果无法验证（$(Limit-Text $last.Evidence 80)）。不要盲目重复切换类动作：先 inspect 该处（颜色 / 文字 / tog 状态）确认确实没生效，再加 `"repeat`":true 重试一次"
}
function Add-LedgerEntry($probe, [int]$step, [string]$desc, $effect) {
    if ($null -eq $probe) { return }
    $outcome = 'pending'; $ev = '等待下一轮观察核实'; $local = 'none'
    if ($effect) {
        $local = "$($effect.Verdict)"; $ev = "$($effect.Text)"
        if ($local -eq 'changed') { $outcome = 'changed' } elseif ($local -eq 'nochange') { $outcome = 'nochange' }
    }
    $script:Ledger.Add([pscustomobject]@{ Kind = $probe.Kind; Keys = $probe.Keys; Text = $probe.Text; Pt = $probe.Pt; Title = $probe.Title; Step = $step; Desc = $desc; Local = $local; Outcome = $outcome; Evidence = $ev; Fresh = $true })
}
function Update-LedgerFromObservation($obs) {
    # 用新一轮观察核实上一轮的动作：标题变化 > 局部视觉证据 > 控件增减；仍无法判断的记为「未验证」
    $ch = "$($obs.Changes)"
    $title = ($ch -match '前台窗口标题')
    $ui = ($ch -match '新增 \d+ 个|消失 \d+ 个')
    $same = ($ch -match '完全相同|控件列表与上一轮相同')
    $still = ($ch -match '几乎无变化')
    foreach ($e in $script:Ledger) {
        if (-not $e.Fresh) { continue }
        $e.Fresh = $false
        if ($title) { $e.Outcome = 'changed'; $e.Evidence = '下一轮前台窗口标题变化'; continue }
        if ($e.Outcome -ne 'pending') { continue }
        if ($e.Local -eq 'noisy') {
            if ($same -and $still) { $e.Outcome = 'nochange'; $e.Evidence = '控件与像素都没有变化' } else { $e.Outcome = 'unknown' }
        }
        elseif ($ui) { $e.Outcome = 'changed'; $e.Evidence = '下一轮观察出现控件新增 / 消失' }
        elseif ($same) { $e.Outcome = 'nochange'; $e.Evidence = '下一轮控件列表完全相同' }
        else { $e.Outcome = 'unknown'; $e.Evidence = '下一轮没有能归因于该动作的证据' }
    }
}
function Format-Ledger {
    if ($script:Ledger.Count -eq 0) { return '' }
    $map = @{ changed = '已生效'; nochange = '无效果'; unknown = '未验证'; pending = '待核实' }
    $lines = @($script:Ledger | Select-Object -Last 10 | ForEach-Object { "  第$($_.Step)步 $(Limit-Text $_.Desc 60) → $($map[$_.Outcome])（$(Limit-Text $_.Evidence 90)）" })
    return "【动作账本】（同一目标上「已生效 / 未验证」的切换类动作不会被重复执行；两次「无效果」的动作会被拒绝）:`n" + ($lines -join "`n")
}

# ---------- ⑤ 先规划后执行 ----------
function ConvertTo-PlanObject($pl) {
    $steps = [System.Collections.Generic.List[object]]::new()
    $i = 0
    foreach ($s in @($pl.steps)) {
        if ($null -eq $s) { continue }
        $i++
        if ($i -gt 10) { break }
        $act = ''
        foreach ($nmk in @('act', 'do', 'action', 'desc', 'step')) { if (-not $act) { try { $act = "$($s.$nmk)" } catch { } } }
        if (-not $act) { $act = "$s" }
        $steps.Add([pscustomobject]@{ N = $i; Act = (Limit-Text $act 90); How = (Limit-Text "$($s.how)" 110); Verify = (Limit-Text "$($s.verify)" 90) })
    }
    if ($steps.Count -eq 0) { throw '计划里没有可执行的 steps' }
    $dw = @(@($pl.done_when) | Where-Object { $_ } | ForEach-Object { Limit-Text "$_" 90 } | Select-Object -First 4)
    $once = @(@($pl.once) | Where-Object { $_ } | ForEach-Object { Limit-Text "$_" 40 } | Select-Object -First 6)
    $risks = @(@($pl.risks) | Where-Object { $_ } | ForEach-Object { Limit-Text "$_" 80 } | Select-Object -First 4)
    return [pscustomobject]@{ Goal = (Limit-Text "$($pl.goal)" 120); DoneWhen = $dw; Steps = $steps; Once = $once; Risks = $risks }
}
function Format-Plan([switch]$NoCursor) {
    $p = $script:Plan
    if ($null -eq $p) { return '' }
    $ls = [System.Collections.Generic.List[string]]::new()
    $ls.Add('【执行计划】（动手之前由规划器制定。每轮 JSON 用 "step":n 标明正在执行第几步，用 "expect" 写出预期变化；证据表明计划不对时单独输出 {"action":"replan",...}）')
    if ($p.Goal) { $ls.Add("  目标: $($p.Goal)") }
    if (@($p.DoneWhen).Count -gt 0) { $ls.Add("  完成证据: $(@($p.DoneWhen) -join '；')") }
    foreach ($s in $p.Steps) {
        $m = '·'
        if ($NoCursor) { } elseif ($s.N -lt $script:PlanCur) { $m = '✓' } elseif ($s.N -eq $script:PlanCur) { $m = '→' }
        $line = "  $m $($s.N). $($s.Act)"
        if ($s.How) { $line += " ｜方法: $($s.How)" }
        if ($s.Verify) { $line += " ｜核实: $($s.Verify)" }
        $ls.Add($line)
    }
    if (@($p.Once).Count -gt 0) { $ls.Add("  只能执行一次（执行后先核实，绝不连按）: $(@($p.Once) -join '、')") }
    if (@($p.Risks).Count -gt 0) { $ls.Add("  风险: $(@($p.Risks) -join '；')") }
    return ($ls -join "`n")
}
function Invoke-PlanPhase([string]$TaskText, $obs, [string]$memNote) {
    $u = "${memNote}【任务】: $TaskText`n`n当前观察:`n$($obs.Text)`n`n请输出执行计划 JSON（只输出一个 JSON 对象）。"
    $raw = Invoke-DeepSeek $u $PlannerPrompt 1500
    return (ConvertTo-PlanObject (ConvertFrom-ModelJson $raw))
}

# ---------- ⑥ 看得更准：inspect（钻取某一点）与 Windows OCR（无障碍树看不到的软件） ----------
$script:OcrScript = @'
param([string]$Path)
$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = New-Object System.Text.UTF8Encoding $false
try {
    Add-Type -AssemblyName System.Runtime.WindowsRuntime
    $null = [Windows.Storage.StorageFile, Windows.Storage, ContentType = WindowsRuntime]
    $null = [Windows.Media.Ocr.OcrEngine, Windows.Foundation, ContentType = WindowsRuntime]
    $null = [Windows.Foundation.IAsyncOperation`1, Windows.Foundation, ContentType = WindowsRuntime]
    $null = [Windows.Graphics.Imaging.SoftwareBitmap, Windows.Foundation, ContentType = WindowsRuntime]
    $null = [Windows.Storage.Streams.RandomAccessStream, Windows.Storage.Streams, ContentType = WindowsRuntime]
    $aw = [WindowsRuntimeSystemExtensions].GetMember('GetAwaiter') | Where-Object { $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1' } | Select-Object -First 1
    function Await($op, [Type]$rt) { $aw.MakeGenericMethod($rt).Invoke($null, @($op)).GetResult() }
    $file = Await ([Windows.Storage.StorageFile]::GetFileFromPathAsync($Path)) ([Windows.Storage.StorageFile])
    $stream = Await ($file.OpenAsync([Windows.Storage.FileAccessMode]::Read)) ([Windows.Storage.Streams.IRandomAccessStream])
    $dec = Await ([Windows.Graphics.Imaging.BitmapDecoder]::CreateAsync($stream)) ([Windows.Graphics.Imaging.BitmapDecoder])
    $bmp = Await ($dec.GetSoftwareBitmapAsync()) ([Windows.Graphics.Imaging.SoftwareBitmap])
    $eng = [Windows.Media.Ocr.OcrEngine]::TryCreateFromUserProfileLanguages()
    if ($null -eq $eng) {
        foreach ($lg in [Windows.Media.Ocr.OcrEngine]::AvailableRecognizerLanguages) { $eng = [Windows.Media.Ocr.OcrEngine]::TryCreateFromLanguage($lg); if ($eng) { break } }
    }
    if ($null -eq $eng) { Write-Output '{"err":"no_ocr_language"}'; $stream.Dispose(); exit 0 }
