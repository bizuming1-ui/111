    else { $outDir = [System.IO.Path]::GetFullPath($OutPath) }
    if (-not $wsbFile) { $wsbFile = Join-Path $outDir 'agent-safe.wsb' }
    $codeDir = Join-Path $outDir 'code'; $exDir = Join-Path $outDir 'exchange'
    foreach ($d in $outDir, $codeDir, $exDir, (Join-Path $exDir 'workspace'), (Join-Path $exDir 'logs')) { [void][System.IO.Directory]::CreateDirectory($d) }
    $note = [System.Collections.Generic.List[string]]::new()
