            if ("$($a.direction)".ToLower() -notin 'up', 'down') { return "scroll 的 direction 只能是 up 或 down" }
            if (Test-IdValue $a.id) {
                if (-not $script:Elements.ContainsKey([int]"$($a.id)")) { return "元素编号 $($a.id) 不存在" }
            }
        }
