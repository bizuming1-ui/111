    $boot = @'
$ErrorActionPreference = 'Continue'
$pw = 'C:\Agent\pwsh\pwsh.exe'
New-Item -ItemType Directory -Force 'C:\Agent\exchange\workspace', 'C:\Agent\exchange\logs' | Out-Null
