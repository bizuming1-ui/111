# ---------------- Job Object ----------------
function Initialize-DsJob {
    if ($script:JobReady -or -not $script:SafeOn) { return }
    $script:JobReady = $true
    try {
        if (-not ('DsJob63' -as [type])) { $script:JobInfo = 'DsJob63 不可用'; return }
        $g = if ($KeepApps) { $false } else { [DsJob63]::InitGuard() }
        $e = [DsJob63]::InitExec(32, 2147483648)
        $a = [DsJob63]::InitApps()
        $script:JobInfo = "guard=$g exec=$e apps=$a$(if ([DsJob63]::LastError) { ' (' + [DsJob63]::LastError + ')' })"
    }
    catch { $script:JobInfo = "不可用: $($_.Exception.Message)" }
}
function Add-ProcessToJob($Proc) {
    if (-not $script:SafeOn -or -not $Proc) { return $false }
    try { if ('DsJob63' -as [type]) { return [DsJob63]::AssignExec([int]$Proc.Id) } } catch { }
    return $false
}
function Add-LaunchedToJob([IntPtr]$Fg, [IntPtr]$New) {
    # 只收「本次启动之后才创建」的进程，且永不包含 explorer 等壳进程（否则退出时会连带关掉你的桌面 / 已打开的浏览器）
    if (-not $script:SafeOn -or $KeepApps -or -not ('DsJob63' -as [type])) { return }
    try {
        foreach ($h in @($New, $Fg)) {
            if ($h -eq [IntPtr]::Zero) { continue }
            $pidv = [DsJob63]::PidOfWindow($h)
            if ($pidv -le 4 -or $pidv -eq $PID) { continue }
            $p = [System.Diagnostics.Process]::GetProcessById($pidv)
            if ($p.ProcessName -match '(?i)^(explorer|dwm|sihost|csrss|winlogon|ShellExperienceHost|StartMenuExperienceHost|SearchHost|TextInputHost|ApplicationFrameHost|WindowsTerminal|conhost|pwsh|powershell)$') { continue }
            if ($p.StartTime -lt $script:LaunchStamp.AddSeconds(-1)) { continue }
            [void][DsJob63]::AssignApps($pidv)
        }
    }
    catch { }
}
function Stop-TaskProcesses { try { if ('DsJob63' -as [type]) { [void][DsJob63]::KillExec() } } catch { } }

# ---------------- HITL：置顶倒计时确认框（与 Ctrl+Alt+Q 联动；超时 = 拒绝；Enter / Esc = 拒绝） ----------------
function Show-HitlDialog([string]$Title, [string]$Body, [string]$Banner, [int]$TimeoutSec, [bool]$Danger) {
    $prevFg = [IntPtr]::Zero; try { $prevFg = [DsNative61]::GetForegroundWindow() } catch { }
    [System.Windows.Forms.Application]::EnableVisualStyles()
    $form = [System.Windows.Forms.Form]::new()
    $result = 'deny'
    try {
        $form.Text = "DeepSeek Computer Use - 高危操作确认（$TimeoutSec 秒内未确认将自动拒绝）"
        $form.TopMost = $true; $form.ShowInTaskbar = $true; $form.FormBorderStyle = 'FixedDialog'; $form.MaximizeBox = $false; $form.MinimizeBox = $false
        $form.AutoScaleDimensions = [System.Drawing.SizeF]::new(96, 96); $form.AutoScaleMode = 'Dpi'
        $form.ClientSize = [System.Drawing.Size]::new(600, 300); $form.StartPosition = 'CenterScreen'
        $form.Font = [System.Drawing.Font]::new('Microsoft YaHei UI', 9.5)
        $hd = [System.Windows.Forms.Label]::new()
        $hd.Text = $Title; $hd.Dock = 'Top'; $hd.Height = 44; $hd.TextAlign = 'MiddleLeft'; $hd.Padding = [System.Windows.Forms.Padding]::new(12, 0, 0, 0)
        $hd.BackColor = if ($Danger) { [System.Drawing.Color]::FromArgb(176, 32, 32) } else { [System.Drawing.Color]::FromArgb(180, 110, 0) }
        $hd.ForeColor = [System.Drawing.Color]::White; $hd.Font = [System.Drawing.Font]::new('Microsoft YaHei UI', 11, [System.Drawing.FontStyle]::Bold)
        $form.Controls.Add($hd)
        $tb = [System.Windows.Forms.TextBox]::new()
        $tb.Multiline = $true; $tb.ReadOnly = $true; $tb.ScrollBars = 'Vertical'; $tb.Location = [System.Drawing.Point]::new(12, 54); $tb.Size = [System.Drawing.Size]::new(576, 140)
        $tb.Text = ($(if ($Banner) { $Banner + "`r`n`r`n" } else { '' }) + $Body); $tb.BackColor = [System.Drawing.Color]::White
        $form.Controls.Add($tb)
        $cd = [System.Windows.Forms.Label]::new(); $cd.Location = [System.Drawing.Point]::new(12, 202); $cd.Size = [System.Drawing.Size]::new(576, 22); $cd.Text = ''
        $form.Controls.Add($cd)
        $bar = [System.Windows.Forms.ProgressBar]::new(); $bar.Location = [System.Drawing.Point]::new(12, 226); $bar.Size = [System.Drawing.Size]::new(576, 8); $bar.Minimum = 0; $bar.Maximum = [Math]::Max(1, $TimeoutSec * 10); $bar.Value = $bar.Maximum
        $form.Controls.Add($bar)
        $bDeny = [System.Windows.Forms.Button]::new(); $bDeny.Text = '拒绝 (Esc / Enter)'; $bDeny.DialogResult = [System.Windows.Forms.DialogResult]::No
        $bDeny.Location = [System.Drawing.Point]::new(12, 250); $bDeny.Size = [System.Drawing.Size]::new(200, 36)
        $bAllow = [System.Windows.Forms.Button]::new(); $bAllow.Text = '允许一次 (&A)'; $bAllow.DialogResult = [System.Windows.Forms.DialogResult]::Yes; $bAllow.Enabled = $false
        $bAllow.Location = [System.Drawing.Point]::new(388, 250); $bAllow.Size = [System.Drawing.Size]::new(200, 36)
        $form.Controls.Add($bDeny); $form.Controls.Add($bAllow)
        $form.AcceptButton = $bDeny; $form.CancelButton = $bDeny   # Enter / Esc 都是「拒绝」：防止误触放行
        $t0 = [System.Diagnostics.Stopwatch]::StartNew(); $flag = @{ Abort = $false }
        $timer = [System.Windows.Forms.Timer]::new(); $timer.Interval = 100
        $timer.Add_Tick({
                $ms = [int]$t0.ElapsedMilliseconds
                if ($ms -ge 700 -and -not $bAllow.Enabled) { $bAllow.Enabled = $true }   # 防「点击穿透」：前 0.7 秒不可点允许
                $remain = [Math]::Max(0, $TimeoutSec - [int][Math]::Floor($ms / 1000))
                $cd.Text = "剩余 $remain 秒（Ctrl+Alt+Q = 急停并拒绝）"
                $bar.Value = [Math]::Max(0, [Math]::Min($bar.Maximum, $bar.Maximum - [int]($ms / 100)))
                try {
                    $c = [DsNative61]::GetAsyncKeyState(0x11) -band 0x8000; $al = [DsNative61]::GetAsyncKeyState(0x12) -band 0x8000; $q = [DsNative61]::GetAsyncKeyState(0x51) -band 0x8000
                    if ($c -and $al -and $q) { $flag.Abort = $true; $form.DialogResult = [System.Windows.Forms.DialogResult]::Abort; $form.Close(); return }
                }
                catch { }
                if ($ms -ge ($TimeoutSec * 1000)) { $form.DialogResult = [System.Windows.Forms.DialogResult]::No; $form.Close() }
            }.GetNewClosure())
        $timer.Start()
        $form.Add_Shown({ try { $form.Activate(); [void][DsNative61]::Activate($form.Handle) } catch { } }.GetNewClosure())
        $dr = $form.ShowDialog()
        $timer.Stop(); $timer.Dispose()
        if ($flag.Abort) { $result = 'abort' } elseif ($dr -eq [System.Windows.Forms.DialogResult]::Yes) { $result = 'allow' } else { $result = 'deny' }
    }
    finally { $form.Dispose() }
    Start-Sleep -Milliseconds 250
    try { if ($prevFg -ne [IntPtr]::Zero) { [void][DsNative61]::Activate($prevFg) } } catch { }
    return $result
}
function Confirm-HighRiskAction {
    param([Parameter(Mandatory)][string]$Kind, [string]$Detail = '', [switch]$Tainted, [string]$Domain = '')
    $script:SecStats.HitlAsked++
    $labels = @{ payment = '💳 支付 / 转账'; login = '🔑 账号登录 / 凭据'; delete = '🗑 文件删除'; submit = '📨 表单提交'; nav = '🌐 非白名单域名导航'; exec = '⚙ 执行程序'; kill = '⛔ 结束进程'; shell = '⌨ 执行 PowerShell（污点上下文）' }
    $lab = if ($labels.ContainsKey($Kind)) { $labels[$Kind] } else { $Kind }
    $banner = ''
    if ($script:Taint.TaskInjection) { $banner = '⚠ 本任务已在页面中检测到提示词注入攻击（已从模型视野删除）。请确认这一步确实是你想做的，而不是网页诱导。' }
    elseif ($Tainted) { $banner = '⚠ 当前上下文含外部不可信内容（网页 / OCR）。这一步不会被自动放行。' }
    $ok = $false; $how = ''
    if ($script:HitlResponder) { $ok = [bool](& $script:HitlResponder $Kind $Detail $Domain); $how = 'responder' }
    elseif (-not [Environment]::UserInteractive) { $ok = $false; $how = 'non-interactive' }
    elseif ($ConsoleConfirm) {
        Write-Host "  [高危确认] $lab : $Detail" -ForegroundColor Red
        if ($banner) { Write-Host "  $banner" -ForegroundColor Yellow }
        $ans = Read-Host '  输入 yes 放行（其它任何输入 = 拒绝）'
        $ok = ("$ans".Trim().ToLower() -eq 'yes'); $how = 'console'
    }
    else {
        try {
            $r = Show-HitlDialog "$lab 需要你确认" $Detail $banner $script:HitlTimeout ($Kind -in 'payment', 'login', 'delete', 'kill', 'shell', 'exec')
            if ($r -eq 'abort') { throw '触发保护：检测到 Ctrl+Alt+Q，已紧急停止当前任务。' }
            $ok = ($r -eq 'allow'); $how = 'dialog:' + $r
        }
        catch { if ("$($_.Exception.Message)" -like '触发保护*') { throw }; $ok = $false; $how = 'dialog-error:' + $_.Exception.Message }
    }
    Write-SecEvent 'HITL' "kind=$Kind allow=$ok how=$how detail=$(Limit-Text $Detail 120)"
    if ($ok -and $Kind -eq 'nav' -and $Domain) { [void]$script:SessionApprovedDomains.Add($Domain) }
    if (-not $ok) { $script:SecStats.HitlDenied++ }
    return $ok
}
function Resolve-Risks($Risks, [string]$Context) {
    foreach ($r in @($Risks)) {
        $dom = ''; if ($r.Kind -eq 'nav' -and "$($r.Detail)" -match '(\S+)$') { $dom = $Matches[1] }
        $ok = Confirm-HighRiskAction -Kind $r.Kind -Detail "$($r.Detail)`r`n$Context" -Tainted:([bool]$script:Taint.Tainted) -Domain $dom
        if (-not $ok) { throw (New-SecError 'SECURITY_HITL_DENIED' "高危操作（$($r.Kind)：$($r.Detail)）未获人工确认（拒绝 / 超时 / 非交互），未执行。") }
    }
}

# ---------------- 动作策略：所有动作在 Invoke-Action 入口强制经过（硬拦截，不依赖模型自觉） ----------------
function Assert-ProcessPolicy($a) {
    $file = [Environment]::ExpandEnvironmentVariables("$($a.file)").Trim()
    $argStr = "$($a.args)"
    if ([string]::IsNullOrWhiteSpace($file)) { throw (New-SecError 'SECURITY_EXEC_VIOLATION' 'run_process 缺少 file') }
    $leaf = ($file -replace '/', '\').Split('\')[-1].ToLower(); if ($leaf.EndsWith('.exe')) { $leaf = $leaf.Substring(0, $leaf.Length - 4) }
    if ($script:Taint.Tainted) {
        $script:SecStats.TaintBlocked++
        Write-SecEvent 'SECURITY_TAINT_BLOCKED' "run_process $file"
        throw (New-SecError 'SECURITY_TAINT_BLOCKED' "污点上下文（含外部不可信内容）禁止自动执行 run_process（$file）。请先回到可信界面，或由用户亲自操作。")
    }
    $isScript = $file -match '(?i)\.(ps1|py|js|mjs|cjs|bat|cmd|exe)$'
    $info = "run_process: $file $argStr"
    if ($isScript -or $file -match '[\\/]') {
        $full = Assert-SafePath $file 'exec'
        if ($full -match '(?i)\.ps1$') { [void](Assert-SafePowerShellAst ([System.IO.File]::ReadAllText($full)) 'run_process(.ps1)') }
        $info = "run_process（工作区内文件）: $full $argStr"
    }
    elseif ($leaf -notin $script:DevTools) { throw (New-SecError 'SECURITY_EXEC_VIOLATION' "run_process 只允许工作区内的脚本 / 可执行文件，或开发工具（$($script:DevTools -join ', ')）；「$file」不在其中。") }
    if ((Get-LaunchClass $file) -eq 'blocked' -and $file -notmatch '(?i)\.(ps1|bat|cmd)$') { throw (New-SecError 'SECURITY_EXEC_VIOLATION' "run_process 目标「$file」是解释器 / LOLBin，被禁止。") }
    if (-not [string]::IsNullOrWhiteSpace("$($a.cwd)")) { [void](Assert-SafePath "$($a.cwd)" 'read') }
    if ($argStr -match '(?i)(\.\.[\\/]|\\\\[a-z0-9]|https?://|-enc(odedcommand)?\b|-e\s+[A-Za-z0-9+/=]{20,})') { throw (New-SecError 'SECURITY_EXEC_VIOLATION' 'run_process 参数含路径穿越 / UNC / 网址 / 编码命令，被禁止。') }
    # 解释器会执行模型自己写的代码，无法被进程内路径牢笼约束：必须由人确认（真正的隔离请用 -GenerateWsb 的 Windows Sandbox）
    $ok = Confirm-HighRiskAction -Kind 'exec' -Detail "$info`r`n（在 Job Object 配额内运行：进程数 ≤32、单进程内存 ≤2GB、禁剪贴板 / 切桌面；Agent 退出即清理）"
    if (-not $ok) { throw (New-SecError 'SECURITY_HITL_DENIED' "run_process「$file」未获人工确认，未执行。") }
}
function Get-ClickNavRisk($a, [string]$kind) {
    # 点击链接 / 提交按钮时再看一眼它真正的目标域名（CDP 实时 href / form.action）
    $extra = @()
    try {
        if ($kind -in 'click', 'double_click' -and (Test-IdValue $a.id) -and $script:Elements.ContainsKey([int]"$($a.id)")) {
            $it = $script:Elements[[int]"$($a.id)"]
            if ($it.Cdp -and $it.Bid -gt 0 -and $script:Cdp) {
                $fn = 'function(){var a=this.closest&&this.closest("a[href]");var f=this.form||(this.closest&&this.closest("form"));return JSON.stringify({h:a?a.href:"",f:f?f.action:""})}'
                $tu = "$($script:Cdp.CallOn([int]$it.Bid, $fn, 1200))" | ConvertFrom-Json | ConvertFrom-Json
                foreach ($u in @($tu.h, $tu.f)) { if ($u) { $h = Get-UrlHost $u; if ($h -and -not (Test-DomainTrusted $h)) { $extra += [pscustomobject]@{ Kind = 'nav'; Detail = "目标域名 $h" } } } }
            }
        }
    }
    catch { }
    return $extra
}
function Assert-ActionPolicy($a, [string]$kind) {
    if (-not $script:SafeOn) { return }
    $t = $script:Taint; $inj = [bool]$t.TaskInjection
    switch ($kind) {
        'run_powershell' {
            $cmd = "$($a.command)"
            $ast = Assert-SafePowerShellAst $cmd 'run_powershell'
            $script:LastAstCmd = $cmd; $script:LastAstRes = $ast
            if ($t.Tainted) {
                $script:SecStats.TaintBlocked++
                Write-SecEvent 'SECURITY_TAINT_BLOCKED' "run_powershell injection=$inj reasons=$($t.Reasons -join ',')"
                if ($inj) { throw (New-SecError 'SECURITY_TAINT_BLOCKED' '本任务已检测到间接提示词注入：污点上下文中禁止执行 run_powershell（硬拦截，不可由模型绕过）。') }
                $ok = Confirm-HighRiskAction -Kind 'shell' -Detail "污点上下文下的 run_powershell：`r`n$(Limit-Text $cmd 400)" -Tainted
                if (-not $ok) { throw (New-SecError 'SECURITY_TAINT_BLOCKED' "污点上下文（$($t.Reasons -join '、')）禁止自动执行 run_powershell；未获人工确认。") }
            }
            $rs = @($ast.Risks | Where-Object { $_.Kind -eq 'delete' -or $_.Kind -eq 'kill' -or ($_.Kind -eq 'exec' -and $_.Class -ne 'benign') })
            if ($rs.Count -gt 0) { Resolve-Risks $rs "来自 run_powershell：$(Limit-Text $cmd 200)" }
        }
        'write_file' {
            $full = Assert-SafePath "$($a.path)" 'write'
            $ext = [System.IO.Path]::GetExtension($full).ToLower()
            if ($ext -in $script:ForbiddenWriteExts) { throw (New-SecError 'SECURITY_EXEC_VIOLATION' "安全模式禁止写入可直接执行的文件类型 $ext（$full）。") }
            if ($t.Tainted) {
                $dir = [System.IO.Path]::GetDirectoryName($full)
                $crossDir = -not $dir.TrimEnd('\').Equals("$($script:WorkspaceRoot)".TrimEnd('\'), [System.StringComparison]::OrdinalIgnoreCase)
                if ($ext -in $script:ExecExts -or $crossDir) {
                    $script:SecStats.TaintBlocked++
                    Write-SecEvent 'SECURITY_TAINT_BLOCKED' "write_file $full"
                    throw (New-SecError 'SECURITY_TAINT_BLOCKED' "污点上下文禁止写入脚本 / 可执行类型（$ext）或跨目录写入（$full）。")
                }
            }
            if ($ext -in '.ps1', '.psm1', '.psd1') { [void](Assert-SafePowerShellAst "$($a.content)" 'write_file(.ps1)') }
        }
        'run_process' { Assert-ProcessPolicy $a }
        'launch' {
            $tgt = "$($a.target)"
            if ((Get-LaunchClass $tgt) -eq 'blocked' -or $tgt -match '(?i)(^|[\\/])(powershell|pwsh|cmd)(\.exe)?\b') { throw (New-SecError 'SECURITY_EXEC_VIOLATION' "launch 目标「$tgt」是解释器 / LOLBin / 脚本文件，被禁止（请使用白名单应用）。") }
            $rk = @(Get-ActionRisk $a $kind)
            if ($rk.Count -gt 0) {
                if ($t.Tainted -and ($rk | Where-Object { $_.Kind -eq 'exec' })) { $script:SecStats.TaintBlocked++; throw (New-SecError 'SECURITY_TAINT_BLOCKED' "污点上下文禁止启动未知程序（$tgt）。") }
                Resolve-Risks $rk "launch $tgt $($a.args)"
            }
        }
        { $_ -in 'wait', 'done', 'fail', 'replan', 'inspect', 'ocr', 'vision_inspect', 'focus_window', 'scroll', 'hover' } { }
        default {
            $rk = @(Get-ActionRisk $a $kind)
            $rk += @(Get-ClickNavRisk $a $kind)
            if ($rk.Count -gt 0) { Resolve-Risks $rk "动作: $(Describe-Action $a)" }
        }
    }
}
function New-SafeScriptBlock([string]$Cmd) {
    # 通过 AST 审计后才创建脚本块；运行时再叠加 CLM（ConstrainedLanguage）+ 固定工作目录：AST 被绕过时，CLM 仍然拒绝任意 .NET 调用
    if (-not $script:SafeOn) { return [scriptblock]::Create($Cmd) }
    if ($script:LastAstCmd -ne $Cmd) { [void](Assert-SafePowerShellAst $Cmd 'run_powershell') }
    $q = "$($script:WorkspaceRoot)".Replace("'", "''")
    $pre = "`$WS = '$q'; Set-Location -LiteralPath `$WS`n"
    if ($script:ClmOn) { $pre += "`$ExecutionContext.SessionState.LanguageMode = 'ConstrainedLanguage'`n" }
    return [scriptblock]::Create($pre + $Cmd)
}
function Test-SkipPlan([string]$TaskText) {
    # v6.4 提速：简单的单意图任务（如「打开记事本」）跳过规划阶段（省掉一次 2~6 秒的 LLM 往返）；多步 / 长任务仍先规划。-AlwaysPlan 强制总是规划
    if ($AlwaysPlan) { return $false }
    $t = "$TaskText".Trim()
    if ($t.Length -gt 36) { return $false }
    if ($t -match '(然后|接着|之后|再|并且|并|同时|最后|依次|and then|\bthen\b|after that|,|，|；|;|\band\b)') { return $false }
    return $true
}
