            & $rec '坐标点击自动吸附到控件并走 UIA（Uia 模式下也成功）' ($tt.GetCheck() -eq 1 -and $msg -match 'UIA') $msg
            # A4. v4.2 幂等勾选：已勾选时 check 不动作；uncheck 读回 off
            $tt.SetCheck(1); Start-Sleep -Milliseconds 120
            $ck1 = $null; $ck2 = $null; $ckErr = ''
            try { $ck1 = Set-CheckState $script:Elements[$cid] $true '[自检复选框]'; $ck2 = Set-CheckState $script:Elements[$cid] $false '[自检复选框]' } catch { $ckErr = $_.Exception.Message }
            & $rec 'v4.2 幂等勾选（已勾选时 check 不操作；uncheck 后读回 off）' ($null -ne $ck1 -and -not $ck1.Changed -and $null -ne $ck2 -and $ck2.Ok -and $tt.GetCheck() -eq 0) ("check=[$(if ($ck1) { $ck1.Via })] uncheck=[$(if ($ck2) { "$($ck2.Via)/$($ck2.State)" })] $ckErr")
            # B. 写值
            $want = '你好 DeepSeek 123'
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'type'; id = $eid; text = $want; clear = $true }) } catch { $msg = "异常: $($_.Exception.Message)" }
            & $rec '第1层 UIA 写值并读回' ($tt.GetText() -eq $want) "读回=[$($tt.GetText())]"
            # C. 消息
            $script:Mode = 'Message'
            $tt.SetCheck(0)
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click'; id = $cid }) } catch { $msg = "异常: $($_.Exception.Message)" }
            $r2 = [DsNative61]::CursorPos()
            & $rec '第2层 窗口消息点击' ($tt.GetCheck() -eq 1 -and $r0[0] -eq $r2[0] -and $r0[1] -eq $r2[1]) $msg
            # D. 物理
            $script:Mode = 'Physical'
            $tt.SetCheck(0)
            Start-Sleep -Milliseconds ($IdleMs + 100)
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click'; id = $cid }) } catch { $msg = "异常: $($_.Exception.Message)" }
            Start-Sleep -Milliseconds 100
            $r3 = [DsNative61]::CursorPos()
            & $rec '第3层 物理点击并归位真实鼠标' ($tt.GetCheck() -eq 1 -and $r0[0] -eq $r3[0] -and $r0[1] -eq $r3[1]) "$msg ；归位后 ($($r3[0]),$($r3[1]))"
            # G. v5 inspect + Windows OCR（真实屏幕；编辑框此时内容为「你好 DeepSeek 123」）
            $script:Mode = 'Auto'
            $insp = ''
            try { $insp = Invoke-InspectAction ([pscustomobject]@{ id = $cid }) } catch { $insp = "异常: $($_.Exception.Message)" }
            & $rec 'v5 inspect 钻取（返回 CheckBox 祖先链与 tog 状态）' (($insp -match 'CheckBox') -and ($insp -match 'tog=')) (Limit-Text ($insp -replace '\s+', ' ') 90)
            $twr = [DsNative61]::WinRect($tt.Parent)
            $ocrR = Invoke-Ocr $twr[0] $twr[1] ($twr[2] - $twr[0]) ($twr[3] - $twr[1])
            $ocrTxt = (@($ocrR.Lines) | ForEach-Object { $_.Text }) -join ' '
            if ((-not $ocrR.Ok) -and ($ocrR.Err -match '语言包|PowerShell 5|NoOcr')) { & $rec 'v5 Windows OCR（本机不可用，已跳过）' $true $ocrR.Err }
            else { & $rec 'v5 Windows OCR 识别自检窗口文字（DeepSeek / 123 / 自检）' ($ocrR.Ok -and ($ocrTxt -match 'DeepSeek|123|自检')) "识别=[$(Limit-Text $ocrTxt 60)] $($ocrR.Err)" }
            # H. v5 局部视觉证据（真实屏幕）：编辑框内容改变 → 该处「变了」；什么都不做 → 「无变化」
            $edIt = $script:Elements[$eid]
            $dk = [DsNative61]::DpiScale()
            $ex = [int]($edIt.L + 60 * $dk); $ey = [int]$edIt.cy; $erad = [int](40 * $dk)
            Start-EffectProbe $ex $ey $erad
            try { [void](Invoke-TypeAction ([pscustomobject]@{ action = 'type'; id = $eid; text = 'WWWWWWWWWWWWWWWW'; clear = $true })) } catch { }
            Start-Sleep -Milliseconds 250
            $fxOn = Complete-EffectProbe
            Start-EffectProbe $ex $ey $erad
            Start-Sleep -Milliseconds 250
            $fxNo = Complete-EffectProbe
            & $rec 'v5 局部视觉证据（真实屏幕：内容改变=变了；不动=无变化）' (($null -ne $fxOn) -and ($fxOn.Verdict -eq 'changed') -and ($null -ne $fxNo) -and ($fxNo.Verdict -eq 'nochange')) "改变=[$(if ($fxOn) { $fxOn.Verdict })] 不动=[$(if ($fxNo) { $fxNo.Verdict })] $(if ($fxOn) { Limit-Text $fxOn.Text 50 })"
        }
            # I. v6.2 SoM 标注截图（真实屏幕 + 自检靶窗口 DsTestTarget61）：JPEG Base64 / [id] 框 / 缩放前后坐标换算 <= 2px
            $somOk = $false; $somMsg = ''
            $dispose = [System.Collections.Generic.List[object]]::new()
            try {
                $script:ObsHwnd = $tt.Parent
                Set-Elements @(Get-UiElements $tt.Parent | Sort-Object cy, cx)
                $somCid = 0; $somEid = 0
                foreach ($kv in $script:Elements.GetEnumerator()) {
                    if ($kv.Value.Type -eq 'CheckBox') { $somCid = [int]$kv.Key }
                    if ($kv.Value.Type -eq 'Edit') { $somEid = [int]$kv.Key }
                }
                $shPlain = New-SomAnnotatedScreenshot -Hwnd $tt.Parent -Detail original -MaxEdge 1600 -NoMarks
                $shFull = New-SomAnnotatedScreenshot -Hwnd $tt.Parent -Detail original -MaxEdge 1600
                $shSmall = New-SomAnnotatedScreenshot -Hwnd $tt.Parent -Detail original -MaxEdge 200
                $jb = [Convert]::FromBase64String($shFull.Base64)
                $isJpeg = ($jb.Length -gt 300 -and $jb[0] -eq 0xFF -and $jb[1] -eq 0xD8 -and $jb[2] -eq 0xFF)
                $msF = [System.IO.MemoryStream]::new($jb); $dispose.Add($msF)
                $bmF = [System.Drawing.Bitmap]::new($msF); $dispose.Add($bmF)
                $msP = [System.IO.MemoryStream]::new([Convert]::FromBase64String($shPlain.Base64)); $dispose.Add($msP)
                $bmP = [System.Drawing.Bitmap]::new($msP); $dispose.Add($bmP)
                $decOk = ($bmF.Width -eq $shFull.Width -and $bmF.Height -eq $shFull.Height)
                $twr2 = [DsNative61]::WinRect($tt.Parent)
                $capOk = ($shFull.CapW -eq ($twr2[2] - $twr2[0]) -and $shFull.CapH -eq ($twr2[3] - $twr2[1]) -and $shFull.OffsetX -eq $twr2[0] -and $shFull.OffsetY -eq $twr2[1])
                # [id] 框确实画在了正确位置：沿复选框上边框取 3 点，标注图与未标注图的像素差必须明显
                $hit = 0
                if ($somCid -gt 0) {
                    $ci2 = $script:Elements[$somCid]
                    $iy = [int][Math]::Round(($ci2.T - $shFull.OffsetY) * $shFull.ScaleY)
                    foreach ($fr in 0.35, 0.55, 0.8) {
                        $ix = [int][Math]::Round(($ci2.L + $ci2.W * $fr - $shFull.OffsetX) * $shFull.ScaleX)
                        if ($ix -ge 0 -and $ix -lt $bmF.Width -and $iy -ge 0 -and $iy -lt $bmF.Height) {
                            $pa = $bmF.GetPixel($ix, $iy); $pb = $bmP.GetPixel($ix, $iy)
                            if (([Math]::Abs($pa.R - $pb.R) + [Math]::Abs($pa.G - $pb.G) + [Math]::Abs($pa.B - $pb.B)) -ge 60) { $hit++ }
                        }
                    }
                }
                # 缩放前后坐标换算误差：控件中心 物理 → 图像 → 物理
                $rtMax = 0.0
                foreach ($sh in @($shFull, $shSmall)) {
                    foreach ($eid2 in @($somCid, $somEid)) {
                        if ($eid2 -le 0) { continue }
                        $e2 = $script:Elements[$eid2]
                        $im2 = ConvertTo-VisionImage $sh $e2.cx $e2.cy
                        $bk2 = ConvertTo-VisionPhysical $sh $im2[0] $im2[1]
                        $rtMax = [Math]::Max($rtMax, [Math]::Max([Math]::Abs($bk2[0] - $e2.cx), [Math]::Abs($bk2[1] - $e2.cy)))
                    }
                }
                $somOk = ($isJpeg -and $decOk -and $capOk -and ($shFull.Marked -ge 2) -and ($hit -ge 2) -and ($rtMax -le 2.0) -and ($shSmall.ScaleX -lt 1.0) -and ($shSmall.Width -le 200) -and ($shFull.KB -gt 0.3))
                $somMsg = "JPEG=$isJpeg 解码尺寸一致=$decOk 采集矩形/偏移=$capOk 标注框=$($shFull.Marked)个 边框像素命中=$hit/3 往返误差=${rtMax}px 缩放=$([Math]::Round($shSmall.ScaleX, 3)) 原图 $($shFull.KB)KB→缩小 $($shSmall.KB)KB 耗时 $($shFull.Ms)ms"
            }
            catch { $somMsg = "异常: $($_.Exception.Message)" }
            finally { foreach ($o in $dispose) { try { $o.Dispose() } catch { } } }
            & $rec 'v6.2 SoM 标注截图（靶窗口：JPEG Base64 + [id] 框 + 缩放前后坐标换算 <= 2px）' $somOk $somMsg
        # E. Schema
        $okId = if ($cid -gt 0) { $cid } else { 1 }
        $okEd = if ($eid -gt 0) { $eid } else { 1 }
        $s1 = Test-ActionSchema ([pscustomobject]@{ action = 'click' }) 1
        $s2 = Test-ActionSchema ([pscustomobject]@{ action = 'key'; keys = 'ctrl+foo' }) 1
        $s3 = Test-ActionSchema ([pscustomobject]@{ action = 'wait'; seconds = 1 }) 1
        $s4 = Test-ActionSchema ([pscustomobject]@{ action = 'done'; summary = 'x' }) 2
        $s5 = Test-ActionSchema ([pscustomobject]@{ action = 'rm_rf' }) 1
        $s6 = Test-ActionSchema ([pscustomobject]@{ action = 'click_many'; ids = @() }) 1
        $s7 = Test-ActionSchema ([pscustomobject]@{ action = 'click_many'; ids = @($okId) }) 1
        $s8 = Test-ActionSchema ([pscustomobject]@{ action = 'type'; text = 'x'; id = $okEd }) 2
        & $rec 'Schema：拒绝非法动作（含 done 排在批量后面）' ($s1 -and $s2 -and $s4 -and $s5 -and $s6 -and (-not $s3)) ("缺目标=[$s1] 非法键=[$s2] 批量中done=[$s4] 未知动作=[$s5]")
        & $rec 'Schema：批量中后续动作可以使用 id（v4 会误拒）、click_many 合法' ((-not $s7) -and (-not $s8)) "click_many=[$s7] 批量type id=[$s8]"
        # F. 过期控件
        $tt.Stop()
        Start-Sleep -Milliseconds 400
        $threw = $false; $why = ''
        if ($cid -gt 0) {
            try { [void](Resolve-Target ([pscustomobject]@{ id = $cid })) } catch { $threw = $true; $why = $_.Exception.Message }
        }
        & $rec '过期控件被拒绝（不会点到错误位置）' $threw $why
    }
    finally {
        $script:Mode = $savedMode
        try { $tt.Stop() } catch { }
    }
    return $rows
}
