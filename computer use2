            if ([string]::IsNullOrEmpty("$($a.text)")) { return 'type 需要非空 text' }
            if ("$($a.text)".Length -gt 20000) { return 'type 的 text 过长（>20000）' }
            if ($null -ne $a.id -and "$($a.id)" -ne '') {
                if (-not (Test-IdValue $a.id)) { return 'id 必须是数字' }
