function Invoke-SecurityCorpus {
    $c = Get-SecurityCorpus
    $res = [System.Collections.Generic.List[object]]::new()
    $sw = [System.Diagnostics.Stopwatch]::new()
    $add = { param($cat, $id, $expect, $actual, $ms) $res.Add([pscustomobject]@{ Cat = $cat; Id = $id; Expect = $expect; Actual = $actual; Ok = ($expect -eq $actual); Ms = [Math]::Round($ms, 2) }) }
    $svSafe = $script:SafeOn; $script:SafeOn = $true
    try {
        foreach ($p in $c.PathBad) { $sw.Restart(); $r = Test-SafePath -Path $p -Operation write -Root $c.Root; $act = if ($r.Ok) { 'allow' } else { 'block' }; & $add 'path_escape' $p 'block' $act $sw.Elapsed.TotalMilliseconds }
        foreach ($p in $c.PathGood) { $sw.Restart(); $r = Test-SafePath -Path $p -Operation write -Root $c.Root; $act = if ($r.Ok) { 'allow' } else { 'block' }; & $add 'path_benign' $p 'allow' $act $sw.Elapsed.TotalMilliseconds }
        foreach ($k in $c.AstBad.Keys) { $sw.Restart(); $r = Test-SafePowerShellAst -Script $c.AstBad[$k] -Workspace $c.Root; $act = if ($r.Safe) { 'allow' } else { 'block' }; & $add 'ast_danger' $k 'block' $act $sw.Elapsed.TotalMilliseconds }
        foreach ($k in $c.AstGood.Keys) { $sw.Restart(); $r = Test-SafePowerShellAst -Script $c.AstGood[$k] -Workspace $c.Root; $act = if ($r.Safe) { 'allow' } else { 'block' }; & $add 'ast_benign' $k 'allow' $act $sw.Elapsed.TotalMilliseconds }
        foreach ($s in $c.InjBad) { $sw.Restart(); $h = @(Find-InjectionPhrases $s); $act = if ($h.Count -gt 0) { 'detect' } else { 'miss' }; & $add 'injection' (Limit-Text $s 50) 'detect' $act $sw.Elapsed.TotalMilliseconds }
        foreach ($s in $c.InjGood) { $sw.Restart(); $h = @(Find-InjectionPhrases $s); $act = if ($h.Count -eq 0) { 'clean' } else { 'false_positive' }; & $add 'injection_benign' (Limit-Text $s 50) 'clean' $act $sw.Elapsed.TotalMilliseconds }
    }
    finally { $script:SafeOn = $svSafe }
    return $res
}
function Get-CorpusStats($Res) {
    $g = { param($cat) $x = @($Res | Where-Object { $_.Cat -eq $cat }); [pscustomobject]@{ N = $x.Count; Ok = @($x | Where-Object { $_.Ok }).Count } }
    $pe = & $g 'path_escape'; $pb = & $g 'path_benign'; $ad = & $g 'ast_danger'; $ab = & $g 'ast_benign'; $ij = & $g 'injection'; $ib = & $g 'injection_benign'
