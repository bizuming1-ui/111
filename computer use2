#region ---------- 发送前校验（Schema） ----------
$script:ActionNames = @('click', 'click_many', 'check', 'uncheck', 'select_rows', 'double_click', 'right_click', 'middle_click', 'hover', 'drag', 'type', 'key', 'hotkey',
    'scroll', 'launch', 'focus_window', 'wait', 'run_powershell', 'write_file', 'run_process', 'inspect', 'ocr', 'vision_inspect', 'replan', 'done', 'fail')
function Test-IdValue($v) { return ($null -ne $v -and "$v" -match '^\d+$') }
function Test-NumValue($v) { return ($null -ne $v -and "$v" -ne '' -and $null -ne ("$v" -as [double])) }
function Test-ActionUsesId($a) {
    return [bool]((Test-IdValue $a.id) -or ($null -ne $a.ids) -or (Test-IdValue $a.from_id) -or (Test-IdValue $a.to_id))
}
function Test-ActionSchema($a, [int]$index) {
    # 返回 $null 表示合法，否则返回原因。任何一个动作不合法，整批都不执行。
    # v4.1：批量里允许使用 id（执行每个动作前都会实时重新核对控件：名称 + 位置 + 可见 + 可用，不符就中止其余动作）。
    $k = "$($a.action)".ToLower().Trim()
    if ($k -notin $script:ActionNames) { return "未知动作 '$($a.action)'" }
    if (($k -in 'done', 'fail') -and $index -gt 1) {
        return "$k 必须单独输出（放在其他动作之后等于没看到结果就宣布结束）；请先执行动作，下一轮看到结果后再 $k"
    }
    switch ($k) {
        { $_ -in 'click', 'double_click', 'right_click', 'middle_click', 'hover' } {
            if (Test-IdValue $a.id) {
                if (-not $script:Elements.ContainsKey([int]"$($a.id)")) { return "元素编号 $($a.id) 不存在" }
            }
            elseif (-not ((Test-NumValue $a.x) -and (Test-NumValue $a.y))) { return '需要 id，或同时提供 x 和 y' }
        }
