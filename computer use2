                if ($lr.IsEmpty) { break }
                $pp = Get-PrecisePoint $item $lr
                if ([Math]::Abs([int]$pp.x - [int]$t.x) -le 2 -and [Math]::Abs([int]$pp.y - [int]$t.y) -le 2) { break }
                $t.x = $pp.x; $t.y = $pp.y
                [DsNative61]::HumanMoveTo([int]$t.x, [int]$t.y)
            }
            catch { if ("$($_.Exception.Message)" -match '触发保护|让出控制权') { throw (Get-NativeError $_) }; break }
        }
    }
}
function Invoke-Worker([scriptblock]$Script, $Arg, [int]$TimeoutMs) {
    # 在预热的运行空间池里执行可能阻塞的 UIA 调用（例如会弹模态框的 Invoke）；超时返回 $false，不卡住主流程
    $ps = [powershell]::Create()
    $ps.RunspacePool = $script:Pool
    [void]$ps.AddScript('param($f, $x) $ErrorActionPreference = "Stop"; & ([scriptblock]::Create($f)) $x').AddArgument($Script.ToString()).AddArgument($Arg)
    $ar = $ps.BeginInvoke()
    if ($ar.AsyncWaitHandle.WaitOne($TimeoutMs)) {
        try { [void]$ps.EndInvoke($ar) } finally { $ps.Dispose() }
        return $true
    }
    return $false
}
