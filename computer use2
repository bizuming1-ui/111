function Get-AstCanonName([string]$Name) {
    $n = "$Name".Trim().ToLower()
    if ($n -match '^[a-z]:' -or $n.Contains('/') -or $n.Contains('\')) {
        if ($n -match '^[\w.]+\\[^\\]+$' -and $n -notmatch '^[a-z]:') { $n = ($n -split '\\', 2)[1] }   # 模块限定名 Microsoft.PowerShell.Utility\Invoke-Expression
        else { return $null }                                                                           # 路径限定的可执行文件
    }
    if ($n.EndsWith('.exe') -and $n -ne 'sc.exe' -and $n -ne 'curl.exe' -and $n -ne 'wget.exe') { $n = $n.Substring(0, $n.Length - 4) }
    if ($script:AstAlias.ContainsKey($n)) { $n = $script:AstAlias[$n] }
    return $n
}
function Get-AstConstPath($Ast, [string]$Ws) {
    # 常量路径求值：字面量、"$WS\x"、$WS、(Join-Path ...)、'a' + 'b'；其余一律返回 $null（= 动态路径，拒绝）
    if ($null -eq $Ast) { return $null }
    switch ($Ast.GetType().Name) {
        'StringConstantExpressionAst' { return $Ast.Value }
        'ConstantExpressionAst' { return "$($Ast.Value)" }
        'ExpandableStringExpressionAst' {
            foreach ($ne in $Ast.NestedExpressions) {
                if ($ne -isnot [System.Management.Automation.Language.VariableExpressionAst]) { return $null }
                if ($ne.VariablePath.UserPath -notin 'WS', 'Workspace') { return $null }
            }
            return ([regex]::Replace($Ast.Value, '\$\{?(WS|Workspace)\}?', $Ws.Replace('$', '$$'), 'IgnoreCase'))
        }
        'VariableExpressionAst' { if ($Ast.VariablePath.UserPath -in 'WS', 'Workspace') { return $Ws } else { return $null } }
        'ParenExpressionAst' {
            $pl = $Ast.Pipeline
            if ($pl -is [System.Management.Automation.Language.PipelineAst] -and $pl.PipelineElements.Count -eq 1 -and $pl.PipelineElements[0] -is [System.Management.Automation.Language.CommandAst]) {
                $c = $pl.PipelineElements[0]
                if ($c.CommandElements.Count -ge 2 -and (Get-AstCanonName "$($c.GetCommandName())") -eq 'join-path') {
                    $parts = [System.Collections.Generic.List[string]]::new()
                    for ($i = 1; $i -lt $c.CommandElements.Count; $i++) {
                        $e = $c.CommandElements[$i]
                        if ($e -is [System.Management.Automation.Language.CommandParameterAst]) { continue }
                        $v = Get-AstConstPath $e $Ws; if ($null -eq $v) { return $null }; [void]$parts.Add($v)
                    }
                    if ($parts.Count -ge 1) { return ($parts -join '\') }
                }
            }
            return $null
        }
        'BinaryExpressionAst' {
            if ($Ast.Operator -eq [System.Management.Automation.Language.TokenKind]::Plus) {
                $l = Get-AstConstPath $Ast.Left $Ws; $r = Get-AstConstPath $Ast.Right $Ws
                if ($null -ne $l -and $null -ne $r) { return ($l + $r) }
            }
            return $null
        }
    }
    return $null
}
function Test-AstPipelineItem($Ast) {
    # $_ / $PSItem 为根的表达式：仅当它位于 ForEach-Object / Where-Object 脚本块内、且该管道上游是文件枚举命令时才放行
    $root = $Ast
    while ($root -is [System.Management.Automation.Language.MemberExpressionAst]) { $root = $root.Expression }
    if ($root -isnot [System.Management.Automation.Language.VariableExpressionAst] -or $root.VariablePath.UserPath -notin '_', 'PSItem') { return $false }
    $p = $Ast.Parent
    while ($p -and $p -isnot [System.Management.Automation.Language.ScriptBlockExpressionAst]) { $p = $p.Parent }
    if (-not $p) { return $false }
    $cmd = $p.Parent
    if ($cmd -isnot [System.Management.Automation.Language.CommandAst]) { return $false }
    if ((Get-AstCanonName "$($cmd.GetCommandName())") -notin 'foreach-object', 'where-object') { return $false }
    $pl = $cmd.Parent
    if ($pl -isnot [System.Management.Automation.Language.PipelineAst]) { return $false }
    $ix = $pl.PipelineElements.IndexOf($cmd)
    if ($ix -le 0) { return $false }
    $prev = $pl.PipelineElements[$ix - 1]
    return ($prev -is [System.Management.Automation.Language.CommandAst] -and (Get-AstCanonName "$($prev.GetCommandName())") -in 'get-childitem', 'get-item')
}
function Get-LaunchClass([string]$Target) {
    # 返回 blocked / benign / other / url
    $t = "$Target".Trim().Trim('"')
    if ($t -match '^(?i:https?|ftp|file)://') { return 'url' }
    $leaf = ($t -replace '/', '\').Split('\')[-1].ToLower()
    if ($leaf.EndsWith('.exe')) { $leaf = $leaf.Substring(0, $leaf.Length - 4) }
    if ($leaf -in $script:LaunchBlocked) { return 'blocked' }
    if ($leaf -match '\.(ps1|psm1|bat|cmd|vbs|vbe|js|jse|wsf|hta|scr|pif|lnk|reg|msi|dll|jar|com)$') { return 'blocked' }
    if (($t -notmatch '[\\/]') -and $leaf -in $script:LaunchBenign) { return 'benign' }
    return 'other'
}

