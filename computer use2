    Write-Host ''
    Write-Host '=== DeepSeek Computer Use v7.0 深化版（零 LLM 快速通道 + 自适应输出上限 + 技能衰减 + 内存水位熔断 + DXGI 驱动桥；缓存友好 Prompt + Token 遥测 + 过程记忆 + 长文本提速；CDP 混合感知 + 确定性等待 + 视觉兜底 + 连接复用 + 人类化输入 + 按下前守卫 + 操作回执 + 预期核对 + 按状态码重试；保留 v5.1 / v6.0 全部能力）===' -ForegroundColor Cyan
    Write-Host "模型    : $Model    每任务最大步数: $MaxSteps    批量动作上限: $MaxBatch"
    Write-Host "模式    : $(if ($DryRun) { '仅预演(DryRun)' } elseif ($script:Auto) { '全自动（无需确认）' } else { '逐步确认' })    Shell: $(if ($NoShell) { '禁止' } else { '允许' })    管理员: $(if ($script:IsAdmin) { '是' } else { '否（加 -RunAsAdmin 可操作高权限窗口）' })    会话记忆: $(if ($MemoryLimit -gt 0) { "最近 $MemoryLimit 个任务" } else { '关闭' })"
    Write-Host "输入    : $($script:Mode)（Auto=UIA→消息→物理借用归位）    虚拟鼠标: $(if ($script:Cur) { '已启用' } else { '未启用' })    让位阈值: ${IdleMs}ms"
    Write-Host "v5      : 规划 $(if ($NoPlan) { '关' } else { '开' })    防重复 $(if ($NoRepeatGuard) { '关' } else { '开' })    OCR $(if ($NoOcr) { '关' } else { '开' })    控制台让位 $(if ($NoConsoleYield) { '关' } else { '开' })"
    Write-Host "v6.3    : CDP $(if ($NoCdp) { '关（-NoCdp）' } else { "开（Chrome / Edge / Brave 隔离 Profile + 调试端口 $script:CdpPortCfg；感知 CDP→UIA→视觉→OCR；等待=readyState+在途请求+${script:CdpQuietMs}ms 安静窗口，总超时 $($script:CdpSettleTimeoutMs)ms）" })"
    Write-Host "v6.2    : 视觉兜底 $(if ($NoVision) { '关（-NoVision）' } else { "开（$VisionModel；UIA 盲区<6 / 连续2次无效 / vision_inspect 时触发；长边≤${VisionMaxEdge}px，JPEG q${VisionJpegQuality}；单任务最多 $($script:VisionMaxTurns) 轮）" })    HTTP 连接复用：开    步间等待：自适应"
    Write-Host "v6 : 人类化输入 $(if ($NoHuman) { '关（-NoHuman）' } else { "开（浏览器内：曲线移动→悬停→按压；速度 ${HumanSpeed}x，打字 ${TypeCps} 字/秒；用户一动鼠标立即让出）" })"
    Write-Host "v6.4    : 零信任 $(if ($script:SafeOn) { "开（路径牢笼 + AST 白名单 + CLM + 污点隔离 + HITL ${script:HitlTimeout}s；工作区 $(if ($script:WorkspaceFixed) { $script:WorkspaceBase } else { 'USERPROFILE\DeepSeekComputerUse\workspace\<时间戳>\taskNN' })）" } else { '关（-SafeMode:$false）' })    C# 程序集缓存 $(if ($NoAsmCache) { '关' } else { '开' })" -ForegroundColor $(if ($script:SafeOn) { 'Green' } else { 'Red' })
    Write-Host "v6.5    : 输出精简 $(if ($NoTerse) { '关' } else { '开' })    过程记忆 $(if ($script:SkillsOn) { '开' } else { '关（-NoSkills）' })    HumanSpeed ${HumanSpeed}x    缓存友好布局 开（每步显示 Token 入/出 + 前缀缓存命中率）"
    Write-Host "v7.0    : 快速通道 $(if ($NoFastPath) { '关' } else { '开' })    自适应 token $(if ($NoAdaptiveTokens) { '关' } else { '开（决策轮封顶 2400）' })    HTTP/2 优先    内存熔断线 ${MinFreeGB}GB    原生驱动 $(if ($NoDriver) { '关（-NoDriver）' } else { '自动探测（无则 GDI）' })"
    Write-Host "日志    : $(if ($script:RunDir) { $script:RunDir } else { '（未启用）' })"
    Write-Host '紧急停止: 鼠标甩到左上角 / Ctrl+Alt+Q（终止当前任务）；Ctrl+C（退出程序）' -ForegroundColor Yellow
    Write-Host '输入 help 查看命令，输入 exit 退出；首次使用建议先运行  -SelfTest  验证本机环境。' -ForegroundColor DarkGray
}
Initialize-Runtime
Show-Banner
Write-Log @{ type = 'session_start'; model = $Model; admin = $script:IsAdmin; mode = $script:Mode; overlay = [bool]$script:Cur; version = '7.0'; safeMode = $script:SafeOn; workspace = "$($script:WorkspaceBase)"; cdp = (-not $NoCdp); vision = (-not $NoVision); visionModel = $VisionModel; human = [bool][DsNative61]::Humanize }
$pending = $Task
try {
    while ($true) {
        if (-not [string]::IsNullOrWhiteSpace($pending)) {
            $current = $pending.Trim()
            $pending = $null
            Write-Host ''
            Write-Host "任务    : $current" -ForegroundColor White
        }
        else {
            Restore-Console
            Write-Host ''
            $line = Read-Host '请输入任务（help 帮助 / exit 退出）'
            if ($null -eq $line) { break }
            $current = $line.Trim()
            if ($current -eq '') { continue }
            switch -Regex ($current.ToLower()) {
                '^(exit|quit|q|退出|结束)$' { $current = $null }
                '^(help|\?|帮助)$' { Show-Help; $current = '' }
                '^(cls|clear|清屏)$' { Clear-Host; $current = '' }
                '^log$' { Write-Host "日志目录: $(if ($script:RunDir) { $script:RunDir } else { '（未启用）' })" -ForegroundColor DarkGray; $current = '' }
                '^mode\s+(auto|uia|message|physical)$' {
                    $script:Mode = (Get-Culture).TextInfo.ToTitleCase($Matches[1])
                    Write-Host "输入模式已切换为: $($script:Mode)" -ForegroundColor DarkGray
                    $current = ''
                }
                '^(history|历史)$' {
                    if ($script:Session.Count -eq 0) { Write-Host '（本会话还没有执行过任务）' -ForegroundColor DarkGray }
                    else { $script:Session | ForEach-Object { Write-Host "  $_" -ForegroundColor DarkGray } }
                    $current = ''
                }
            }
            if ($null -eq $current) { break }
            if ($current -eq '') { continue }
        }
        $script:TaskNo++
        Write-Host ''
        Write-Host "╭─ 任务 #$($script:TaskNo) ─────────────────────────" -ForegroundColor Cyan
        Reset-AbortState
        $res = Invoke-AgentTask $current
        switch ($res.Outcome) {
            'done' { $script:Stats.done++ }
            'fail' { $script:Stats.fail++ }
            default { $script:Stats.other++ }
        }
        $script:Session.Add("任务$($script:TaskNo): $(Limit-Text $current 100) → [$($res.Outcome)] $(Limit-Text $res.Summary 160)")
        while ($script:Session.Count -gt 50) { $script:Session.RemoveAt(0) }
        Write-Host "╰─ 任务 #$($script:TaskNo) 结束（$($res.Outcome)）──────────" -ForegroundColor Cyan
        if ($Once) { break }
    }
}
finally {
    Stop-Runtime
    $elapsed = [int]((Get-Date) - $script:Started).TotalSeconds
    Write-Host ''
    Write-Host "会话结束：共 $($script:TaskNo) 个任务（完成 $($script:Stats.done) / 失败 $($script:Stats.fail) / 其他 $($script:Stats.other)），总耗时 ${elapsed} 秒" -ForegroundColor DarkGray
    if ($script:RunDir) { Write-Host "日志目录: $($script:RunDir)" -ForegroundColor DarkGray }
    Write-Log @{ type = 'session_end'; tasks = $script:TaskNo }
}
#endregion
