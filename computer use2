    $cw = $x1 - $x0; $ch = $y1 - $y0
    if ($cw -lt 8 -or $ch -lt 8) { return (New-OcrResult $false '识别区域太小或在屏幕外' $none) }
    $dir = Join-Path ([System.IO.Path]::GetTempPath()) 'DeepSeekComputerUse'
    if (-not (Test-Path -LiteralPath $dir)) { [void](New-Item -ItemType Directory -Force -Path $dir) }
    $helper = Join-Path $dir 'ocr-v5.ps1'
    if ($script:OcrHelper -ne $helper -or -not (Test-Path -LiteralPath $helper)) {
        [System.IO.File]::WriteAllText($helper, $script:OcrScript, [System.Text.UTF8Encoding]::new($true))
