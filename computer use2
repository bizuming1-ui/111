    public static bool PostClick(IntPtr h, int sx, int sy, int button, int count) {
        POINT p = new POINT(); p.X = sx; p.Y = sy;
        if (!ScreenToClient(h, ref p)) return false;
        IntPtr l = new IntPtr(((p.Y & 0xFFFF) << 16) | (p.X & 0xFFFF));
        uint down = button == 1 ? 0x0204u : (button == 2 ? 0x0207u : 0x0201u);
        uint up = button == 1 ? 0x0205u : (button == 2 ? 0x0208u : 0x0202u);
        uint dbl = button == 1 ? 0x0206u : (button == 2 ? 0x0209u : 0x0203u);
        IntPtr mk = new IntPtr(button == 1 ? 0x0002 : (button == 2 ? 0x0010 : 0x0001));
        PostMessage(h, 0x0200u, IntPtr.Zero, l);
        Thread.Sleep(15);
        for (int i = 0; i < count; i++) {
            PostMessage(h, (i == 0) ? down : dbl, mk, l); Thread.Sleep(20);
            PostMessage(h, up, IntPtr.Zero, l); Thread.Sleep(30);
        }
        return true;
    }
    // 可见的顶层窗口，Z 序从上到下；每项 "hwnd|pid|title"
    public static string[] TopWindows(uint skipPid, int max) {
        List<string> list = new List<string>();
        EnumProc cb = delegate (IntPtr h, IntPtr l) {
            if (list.Count >= max) return false;
            if (!IsWindowVisible(h)) return true;
            if (GetWindowTextLength(h) == 0) return true;
            int ex = GetWindowLong(h, -20);
            if ((ex & 0x80) != 0 && (ex & 0x40000) == 0) return true;
            int cloaked = 0;
            try { DwmGetWindowAttribute(h, 14, out cloaked, 4); } catch { }
            if (cloaked != 0) return true;
            uint pid = 0; GetWindowThreadProcessId(h, out pid);
            if (pid == skipPid) return true;
            list.Add(h.ToInt64().ToString() + "|" + pid.ToString() + "|" + WinText(h));
            return true;
        };
        EnumWindows(cb, IntPtr.Zero);
        GC.KeepAlive(cb);
        return list.ToArray();
    }
    // 把窗口切到前台：AttachThreadInput 绕过前台锁，失败再轻按 Alt 重试；返回是否真的成功
    public static bool Activate(IntPtr h) {
        if (h == IntPtr.Zero || !IsWindow(h)) return false;
        if (IsIconic(h)) ShowWindow(h, 9);
        for (int attempt = 0; attempt < 2; attempt++) {
            IntPtr fg = GetForegroundWindow();
            uint dummy = 0;
            uint fgT = GetWindowThreadProcessId(fg, out dummy);
            uint me = GetCurrentThreadId();
            bool att = (fgT != 0 && fgT != me) && AttachThreadInput(me, fgT, true);
            SetForegroundWindow(h); BringWindowToTop(h);
            if (att) AttachThreadInput(me, fgT, false);
            Thread.Sleep(80);
            if (GetForegroundWindow() == h) return true;
            Key(0x12, false, false); Key(0x12, true, false);
        }
        return GetForegroundWindow() == h;
    }
