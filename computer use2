function Optimize-OcrText([string]$s) {
    # Windows OCR 会在中文字之间插空格：「润 魂 学」→「润魂学」
    if ([string]::IsNullOrWhiteSpace($s)) { return '' }
    $s = [regex]::Replace($s, '(?<=[\u2E80-\u9FFF\uF900-\uFAFF\uFF00-\uFFEF])\s+(?=[\u2E80-\u9FFF\uF900-\uFAFF\uFF00-\uFFEF])', '')
    return $s.Trim()
}
function New-OcrResult([bool]$ok, [string]$err, $lines) { return [pscustomobject]@{ Ok = $ok; Err = $err; Lines = @($lines) } }
function Invoke-Ocr([int]$rx, [int]$ry, [int]$rw, [int]$rh) {
