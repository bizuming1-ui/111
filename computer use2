}
function Get-WindowOcrBlock([IntPtr]$hwnd, $pix) {
    # 观察时：前台窗口的无障碍控件很少（游戏 / 画布 / 远程桌面 / 自绘界面）才自动 OCR；画面没变就复用上次结果
    $c = $script:OcrCache
    if ($c -and $c.Hwnd -eq $hwnd -and $null -ne $pix) {
        $dd = Get-PixelDiff $c.Pix $pix
        if ($null -ne $dd -and $dd -lt 0.5) { foreach ($gr in @($c.Rects)) { $script:Grounded.Add($gr) }; return $c.Block }
    }
    $wr = [DsNative61]::WinRect($hwnd)
    $res = Invoke-Ocr $wr[0] $wr[1] ($wr[2] - $wr[0]) ($wr[3] - $wr[1])
    if (-not $res.Ok) {
        $fb = "OCR（该窗口无障碍控件很少，尝试读屏幕文字）: 不可用 - $($res.Err)"
        $script:OcrCache = [pscustomobject]@{ Hwnd = $hwnd; Pix = $pix; Block = $fb; Rects = @() }
        return $fb
    }
    if (@($res.Lines).Count -eq 0) { return 'OCR（该窗口无障碍控件很少）: 没有识别到文字' }
    $ls = @(@($res.Lines) | Select-Object -First 45 | ForEach-Object { "  「$(Limit-Text $_.Text 50)」@($($_.cx),$($_.cy))" })
    $block = "OCR 屏幕文字（该窗口无障碍控件很少；以下是识别出的文字及中心坐标，可作为坐标点击的依据）:`n" + ($ls -join "`n")
    $script:OcrCache = [pscustomobject]@{ Hwnd = $hwnd; Pix = $pix; Block = $block; Rects = @($res.Lines) }
    return $block
}
function Invoke-OcrAction($a) {
    if ((Test-NumValue $a.x) -and (Test-NumValue $a.y) -and (Test-NumValue $a.w) -and (Test-NumValue $a.h)) {
        $res = Invoke-Ocr ([int][double]"$($a.x)") ([int][double]"$($a.y)") ([int][double]"$($a.w)") ([int][double]"$($a.h)")
    }
    else {
        $wr = [DsNative61]::WinRect($script:ObsHwnd)
        $res = Invoke-Ocr $wr[0] $wr[1] ($wr[2] - $wr[0]) ($wr[3] - $wr[1])
    }
    if (-not $res.Ok) { throw "OCR 不可用: $($res.Err)" }
    $n = @($res.Lines).Count
    if ($n -eq 0) { return 'OCR 完成：该区域没有识别到文字' }
    $ls = @(@($res.Lines) | Select-Object -First 60 | ForEach-Object { "「$(Limit-Text $_.Text 40)」@($($_.cx),$($_.cy))" })
