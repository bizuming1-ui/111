        try { if (!t.Wait(timeoutMs)) throw new TimeoutException(method + " 超时（" + timeoutMs + "ms）"); }
        catch (AggregateException ae) { throw ae.InnerException ?? ae; }
        string err = ErrorOf(t.Result);
