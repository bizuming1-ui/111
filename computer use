def collect(rows: list[dict[str, Any]], bbon: bool) -> dict[str, Any]:
    rolls = [r for t in rows for r in t["rollouts"]]
    n_tasks = len(rows)
    if not rows:
        return {}
    sel_ok = sum(1 for t in rows if (t["selected_success"] if bbon else t["pass_at_1"]))
    elapsed = [r["elapsed_s"] for r in rolls]
    mis = sum(1 for r in rolls if r["misoperation"])
    with_rec = [r for r in rolls if r["facts"].get("recovery_events", 0) > 0]
    rec_ok = sum(1 for r in with_rec if r["success"])
    lo, hi = wilson(sel_ok, n_tasks)
    return {"tasks": n_tasks, "rollouts": len(rolls), "success_rate": round(sel_ok / n_tasks, 3), "wilson95": [lo, hi],
            "pass_at_1": round(sum(t["pass_at_1"] for t in rows) / n_tasks, 3), "bBoN": round(sum(t["selected_success"] for t in rows) / n_tasks, 3),
            "oracle_pass_at_n": round(sum(t["oracle_pass_at_n"] for t in rows) / n_tasks, 3), "judge_agreement": round(sum(t["judge_correct"] for t in rows) / n_tasks, 3),
            "misoperation_rate": round(mis / max(1, len(rolls)), 3), "recovery_rate": round(rec_ok / len(with_rec), 3) if with_rec else None, "rollouts_with_recovery": len(with_rec),
            "mean_s": round(sum(elapsed) / max(1, len(elapsed)), 2), "p50_s": round(pct(elapsed, .5), 2), "p95_s": round(pct(elapsed, .95), 2), "p99_s": round(pct(elapsed, .99), 2),
            "mean_steps": round(sum(r["steps"] for r in rolls) / max(1, len(rolls)), 2), "cdp_heals": sum(r["facts"].get("cdp_heals", 0) for r in rolls),
            "stable_object_hits": sum(sum((r["facts"].get("stable_object_hits") or {}).values()) for r in rolls)}


