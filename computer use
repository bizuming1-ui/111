from __future__ import annotations

import itertools
import os
import time
from enum import Enum
from typing import Any, Literal, Optional

from pydantic import BaseModel, ConfigDict, Field, field_validator

PROTOCOL_VERSION = "1"


class Code(str, Enum):
    OK = "OK"
    STALE_EPOCH = "STALE_EPOCH"
    AMBIGUOUS_TARGET = "AMBIGUOUS_TARGET"
    OCCLUDED = "OCCLUDED"
    UIPI_DENIED = "UIPI_DENIED"
    SECURITY_DENIED = "SECURITY_DENIED"
    NOT_FOUND = "NOT_FOUND"
    USER_ACTIVE = "USER_ACTIVE"
    FOREGROUND_FAILED = "FOREGROUND_FAILED"
    TIMEOUT = "TIMEOUT"
    UNSUPPORTED = "UNSUPPORTED"
    INTERNAL = "INTERNAL"


Channel = Literal["cdp", "uia", "jab", "dxgi_vision"]
Zone = Literal["Toolbar", "Row", "Modal", "Other"]

_seq = itertools.count(1)
_RUN = f"{os.getpid():x}{int(time.time()) & 0xFFFFFF:x}"


def new_id(prefix: str = "r") -> str:
    return f"{prefix}{_RUN}-{next(_seq)}"


def new_action_id() -> str:
    return new_id("a")


class _Model(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)


class Element(_Model):
    ref_id: str
    role: str
    name: str = ""
    value: Optional[str] = None
    rect: list[int]
    zone: Zone = "Other"
    stable_key: str
    states: list[str] = Field(default_factory=list)
    patterns: list[str] = Field(default_factory=list)
    row: Optional[int] = None
    occluded: Optional[bool] = None

    @field_validator("ref_id")
    @classmethod
    def _ref(cls, v: str) -> str:
        if not v.startswith("@") or ":" not in v:
            raise ValueError(f"bad ref_id {v!r}")
        return v

    @property
    def epoch(self) -> int:
        return int(self.ref_id[1:].split(":")[0])

    @property
    def center(self) -> tuple[int, int]:
        x, y, w, h = self.rect
        return x + w // 2, y + h // 2

    @property
    def is_cdp(self) -> bool:
        return ":c" in self.ref_id


class WindowInfo(_Model):
    hwnd: int
    title: str = ""
    process: str = ""
    pid: Optional[int] = None
    cls: Optional[str] = Field(default=None, alias="class")
    rect: list[int]
    z: int
    minimized: Optional[bool] = None
    topmost: Optional[bool] = None
    cloaked: Optional[bool] = None
    occluded_by: list[int] = Field(default_factory=list)
    own_console: Optional[bool] = None


class DxgiStats(_Model):
    capture_backend: Literal["DXGI", "GDI", "NONE"]
    dirty_rects_count: int
    frame_ms: float
    fallback_reason: Optional[str] = None
    width: Optional[int] = None
    height: Optional[int] = None
    frame_hash: Optional[str] = None
    timed_out_reused_frame: Optional[bool] = None


class Observation(_Model):
    type: Literal["observation"] = "observation"
    id: str
    ok: bool
    channel: Channel
    snapshot_epoch: int
    hwnd: int
    title: str = ""
    process: str = ""
    url: Optional[str] = None
    fg_hwnd: Optional[int] = None
    windows: list[WindowInfo] = Field(default_factory=list)
    elements: list[Element] = Field(default_factory=list)
    dxgi_stats: Optional[DxgiStats] = None
    screenshot: Optional[dict[str, Any]] = None
    screen: Optional[dict[str, Any]] = None
    user_idle_ms: Optional[int] = None
    settled: Optional[bool] = None
    inflight: Optional[int] = None
    uia_blind: Optional[bool] = None
    telemetry: dict[str, Any] = Field(default_factory=dict)
    error: Optional[dict[str, Any]] = None

    def fg_window(self) -> Optional[WindowInfo]:
        for w in self.windows:
            if w.hwnd == self.fg_hwnd:
                return w
        return self.windows[0] if self.windows else None

    def target_window(self) -> Optional[WindowInfo]:
        for w in self.windows:
            if w.hwnd == self.hwnd:
                return w
        return None


class ActionRequest(_Model):
    type: Literal["action"] = "action"
    id: str = Field(default_factory=new_id)
    action_id: str = Field(default_factory=new_action_id)
    action: str
    expect_epoch: Optional[int] = None
    expect_hwnd: Optional[int] = None


class ActionResult(_Model):
    type: Literal["action_result"] = "action_result"
    id: Optional[str] = None
    action_id: Optional[str] = None
    ok: bool
    code: Code = Code.INTERNAL
    message: str = ""
    idempotent_replay: bool = False
    latency_ms: Optional[float] = None
    effect: dict[str, Any] = Field(default_factory=dict)

    @property
    def blocking(self) -> bool:
        return self.code in (Code.OCCLUDED, Code.SECURITY_DENIED, Code.UIPI_DENIED, Code.FOREGROUND_FAILED, Code.AMBIGUOUS_TARGET)


def parse_observation(d: dict[str, Any]) -> Observation:
    if d.get("type") == "error":
        raise RuntimeError(f"peer error {d.get('code')}: {d.get('message')}")
    if "windows" in d:
        for w in d["windows"]:
            if "class" in w and "cls" not in w:
                w["cls"] = w["class"]
    return Observation.model_validate(d)


def parse_result(d: dict[str, Any]) -> ActionResult:
    if d.get("type") == "error":
        return ActionResult(ok=False, code=Code(d.get("code", "INTERNAL")) if d.get("code") in Code._value2member_map_ else Code.INTERNAL, message=str(d.get("message", "")))
    code = d.get("code", "INTERNAL")
    d = dict(d)
    d["code"] = code if code in Code._value2member_map_ else "INTERNAL"
    return ActionResult.model_validate(d)
