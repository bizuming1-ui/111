"""v15 controlled desktop-safety primitives (whitelisted, the LLM never supplies a command line):

  open_known_folder(name)     - ShellExecute of explorer.exe with ONE hard-coded argument from a closed whitelist
                                (Desktop / Documents / Downloads / RecycleBin).  Replaces the denied `explorer.exe` / `Start-Process`
                                / `shell:RecycleBinFolder typed into the address bar` attempts seen in the v14 run log (tasks #2/#3).
  recycle_bin_status()        - READ-ONLY, two independent channels that must agree:
                                  (1) shell32!SHQueryRecycleBinW  (item count + bytes)
                                  (2) COM Shell.Application.NameSpace(10).Items()  (the Recycle Bin shell folder, ssfBITBUCKET) -> count + names
                                the COM probe runs a FIXED constant script (not model-controlled) in a child PowerShell.
  recycle_file(path)          - SHFileOperationW(FO_DELETE | FOF_ALLOWUNDO): moves ONE file into the Recycle Bin (not a permanent delete);
                                path must live under a known folder (Desktop/Documents/Downloads) or the agent workspace.
  empty_recycle_bin()         - SHEmptyRecycleBinW(no confirmation / no UI).  Brain-side intent gate: only when the task text asks for it.

Everything degrades explicitly (returns ok=False with a reason) on non-Windows; nothing is simulated.
"""
from __future__ import annotations

import json
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Optional

IS_WIN = sys.platform == "win32"

# closed whitelist of views
VIEWS: dict[str, str] = {"desktop": "Desktop", "documents": "Documents", "downloads": "Downloads", "recyclebin": "RecycleBin"}
VIEW_ALIASES = {
    "桌面": "desktop", "desktop": "desktop", "文档": "documents", "documents": "documents", "我的文档": "documents",
    "下载": "downloads", "downloads": "downloads", "回收站": "recyclebin", "recyclebin": "recyclebin", "recycle bin": "recyclebin",
    "recycle": "recyclebin", "trash": "recyclebin", "shell:recyclebinfolder": "recyclebin",
}
RECYCLE_TITLES = ("回收站", "recycle bin")

# fixed COM probe (constant string; never built from model output)
_COM_PROBE = (
    "$ErrorActionPreference='Stop';"
    "$ns=(New-Object -ComObject Shell.Application).NameSpace(10);"
    "$items=@($ns.Items());"
    "$names=@($items | Select-Object -First 50 | ForEach-Object { $_.Name });"
    "[Console]::Out.WriteLine((@{count=$items.Count;names=$names} | ConvertTo-Json -Compress))"
)


def normalize_view(name: str) -> Optional[str]:
    n = str(name or "").strip()
    return VIEW_ALIASES.get(n.lower()) or VIEW_ALIASES.get(n)


def _known_folder(name: str) -> Path:
    from .layer0 import known_folder

    return known_folder(name)


def open_known_folder(name: str) -> tuple[bool, str, str]:
    """-> (ok, message, normalized_view).  ShellExecute with a whitelisted, constant argument only."""
    view = normalize_view(name)
    if view is None:
        return False, f"[SECURITY_DENIED] open_known_folder 只允许 {sorted(VIEWS.values())}，收到 {name!r}", ""
    if not IS_WIN:
        return False, "open_known_folder 仅支持 Windows", view
    import ctypes

    arg = "shell:RecycleBinFolder" if view == "recyclebin" else f'"{_known_folder(view)}"'
    rc = ctypes.windll.shell32.ShellExecuteW(None, "open", "explorer.exe", arg, None, 1)  # type: ignore[attr-defined]
    if rc <= 32:
        return False, f"ShellExecute 失败 rc={rc}", view
    return True, f"已请求资源管理器打开 {VIEWS[view]}（ShellExecute 白名单参数）", view


def _sh_query() -> Optional[dict[str, int]]:
    if not IS_WIN:
        return None
    import ctypes
    from ctypes import wintypes

    class SHQUERYRBINFO(ctypes.Structure):
        _fields_ = [("cbSize", wintypes.DWORD), ("i64Size", ctypes.c_longlong), ("i64NumItems", ctypes.c_longlong)]

    info = SHQUERYRBINFO()
    info.cbSize = ctypes.sizeof(info)
    hr = ctypes.windll.shell32.SHQueryRecycleBinW(None, ctypes.byref(info))  # type: ignore[attr-defined]
    if hr != 0:
        return None
    return {"count": int(info.i64NumItems), "bytes": int(info.i64Size)}


def _com_query(timeout: float = 20.0) -> Optional[dict[str, Any]]:
    if not IS_WIN:
        return None
    exe = shutil.which("powershell.exe") or shutil.which("pwsh") or shutil.which("pwsh.exe")
    if not exe:
        return None
    try:
        p = subprocess.run([exe, "-NoProfile", "-NonInteractive", "-Command", _COM_PROBE], capture_output=True, timeout=timeout,
                           creationflags=0x08000000)  # CREATE_NO_WINDOW
        out = p.stdout.decode("utf-8", "replace").strip().splitlines()
        j = json.loads(out[-1]) if out else None
        if not isinstance(j, dict):
            return None
        names = j.get("names") or []
        if isinstance(names, str):
            names = [names]
        return {"count": int(j.get("count", 0)), "names": [str(n) for n in names]}
    except Exception:  # noqa: BLE001
        return None


def recycle_bin_status() -> dict[str, Any]:
    """Independent read-only verification of the real Recycle Bin content."""
    t0 = time.perf_counter()
    if not IS_WIN:
        return {"ok": False, "reason": "not_windows", "count": None, "sources": {}}
    api = _sh_query()
    com = _com_query()
    sources: dict[str, Any] = {}
    if api is not None:
        sources["SHQueryRecycleBinW"] = api["count"]
    if com is not None:
        sources["COM.NameSpace(10)"] = com["count"]
    counts = list(sources.values())
    ms = round((time.perf_counter() - t0) * 1000, 1)
    if not counts:
        return {"ok": False, "reason": "no_channel_available", "count": None, "sources": sources, "ms": ms}
    return {"ok": True, "count": max(counts), "consistent": len(set(counts)) == 1, "sources": sources, "bytes": (api or {}).get("bytes"),
            "names": (com or {}).get("names", []), "ms": ms}


def wait_recycle_count(expected: int, timeout: float = 6.0) -> dict[str, Any]:
    """Poll (the shell updates asynchronously) until the independent count equals `expected` or the timeout elapses."""
    end = time.time() + timeout
    while True:
        last = recycle_bin_status()
        if last.get("ok") and last.get("count") == expected and last.get("consistent", True):
            return last
        if time.time() >= end:
            return last
        time.sleep(0.4)


def path_allowed(path: Path, extra_roots: tuple[Path, ...] = ()) -> bool:
    from .layer0 import known_folder

    roots = [known_folder(k) for k in ("desktop", "documents", "downloads")] + list(extra_roots)
    try:
        rp = path.resolve()
    except OSError:
        rp = path
    for r in roots:
        try:
            rr = r.resolve()
        except OSError:
            rr = r
        if rp == rr:
            return False  # never the folder itself
        if rr in rp.parents:
            return True
    return False


def recycle_file(path: str | Path, extra_roots: tuple[Path, ...] = ()) -> tuple[bool, str]:
    """Move ONE existing file to the Recycle Bin (undoable).  Directories / wildcards / paths outside the allowed roots are refused."""
    p = Path(str(path))
    if any(ch in str(p) for ch in "*?"):
        return False, "[SECURITY_DENIED] recycle_file 不接受通配符"
    if not p.exists():
        return False, f"文件不存在: {p}"
    if p.is_dir():
        return False, "[SECURITY_DENIED] recycle_file 只处理单个文件，不处理目录"
    if not path_allowed(p, extra_roots):
        return False, f"[SECURITY_DENIED] 路径不在授权目录（桌面/文档/下载/工作区）内: {p}"
    if not IS_WIN:
        return False, "recycle_file 仅支持 Windows（非 Windows 不会改为永久删除）"
    import ctypes
    from ctypes import wintypes

    class SHFILEOPSTRUCTW(ctypes.Structure):
        _fields_ = [("hwnd", wintypes.HWND), ("wFunc", wintypes.UINT), ("pFrom", wintypes.LPCWSTR), ("pTo", wintypes.LPCWSTR),
                    ("fFlags", wintypes.WORD), ("fAnyOperationsAborted", wintypes.BOOL), ("hNameMappings", ctypes.c_void_p),
                    ("lpszProgressTitle", wintypes.LPCWSTR)]

    fo_delete, fof_silent, fof_noconfirmation, fof_allowundo, fof_noerrorui = 3, 0x4, 0x10, 0x40, 0x400
    buf = ctypes.create_unicode_buffer(str(p.resolve()) + "\0")  # double-NUL terminated
    op = SHFILEOPSTRUCTW()
    op.wFunc = fo_delete
    op.pFrom = ctypes.cast(buf, wintypes.LPCWSTR)
    op.fFlags = fof_allowundo | fof_noconfirmation | fof_silent | fof_noerrorui
    rc = ctypes.windll.shell32.SHFileOperationW(ctypes.byref(op))  # type: ignore[attr-defined]
    if rc != 0 or op.fAnyOperationsAborted:
        return False, f"SHFileOperationW 失败 rc={rc} aborted={bool(op.fAnyOperationsAborted)}"
    if p.exists():
        return False, "SHFileOperationW 返回成功但文件仍在原位置"
    return True, f"已移入回收站（可还原）：{p}"


def empty_recycle_bin() -> tuple[bool, str]:
    if not IS_WIN:
        return False, "empty_recycle_bin 仅支持 Windows"
    import ctypes

    flags = 1 | 2 | 4  # SHERB_NOCONFIRMATION | NOPROGRESSUI | NOSOUND
    hr = ctypes.windll.shell32.SHEmptyRecycleBinW(None, None, flags)  # type: ignore[attr-defined]
    if (hr & 0xFFFFFFFF) in (0, 0x8000FFFF):  # S_OK / already-empty on some builds
        return True, "回收站已清空（SHEmptyRecycleBinW）"
    return False, f"SHEmptyRecycleBinW 失败 hr=0x{hr & 0xFFFFFFFF:08X}"


def window_is_recycle(title: str) -> bool:
    t = (title or "").lower()
    return any(k in t for k in RECYCLE_TITLES)
