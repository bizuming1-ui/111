        if destructive:
            return self._deny("ROLE_CANNOT_COMMIT", f"{o.action_role} 对象不能承载破坏性动作 {verb}")
        return GateVerdict(True, "RELEASED_NAV", "导航/容器对象的非破坏性动作")

    def check_point(self, x: float, y: float, epoch: int, verb: str = "", human_attested: bool = False) -> GateVerdict:
