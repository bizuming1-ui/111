    import argparse

    ap = argparse.ArgumentParser("agent_brain")
    ap.add_argument("task")
    ap.add_argument("--workspace", default=os.path.expanduser("~/DeepSeekComputerUse/workspace"))
    ap.add_argument("--user-home", default=None)
    ap.add_argument("--execute", action="store_true", help="Run unified state machine and output Protocol v1 trace")
