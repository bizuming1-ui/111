    $cursor = [DsNative61]::CursorPos()
    $windows = @(Get-TopWindowList 15 | ForEach-Object { "  - $($_.Process): $(Limit-Text $_.Title 60)" })
    # v6.3：感知路由器——前台是 Chromium 且 CDP 已附着时优先用 CDP（DOM + AXTree 融合）；失败 / 页面有 ≥2 个复选框（需要 UIA 行模型）时回到 UIA
    $cdpObs = $null
    try { $cdpObs = Get-CdpObservation $fg }
    catch {
        if ("$($_.Exception.Message)" -like '触发保护*') { throw }
        Write-Host "  CDP 感知异常，本步回退 UIA: $(Limit-Text $_.Exception.Message 120)" -ForegroundColor DarkYellow
        $cdpObs = $null
    }
    # v9.2：多复选框网页（Gmail / 飞书 / 后台表格）不再退回 250 控件 UIA——用 DOM 行模型（[role=row] / tr 内的 checkbox + 行摘要）留在高速 CDP 通道
    $cdpModel = $null; $script:V92.CdpRows = $false
    if ($cdpObs -and (@($cdpObs.Items | Where-Object { $_.Type -eq 'CheckBox' }).Count -ge 2)) {
        try { $cdpModel = Get-V92CdpRowModel $cdpObs }
        catch { if ("$($_.Exception.Message)" -like '触发保护*') { throw }; $cdpModel = $null }
        if ((Resolve-V92PerceptionChannel $cdpObs $cdpModel) -eq 'uia') { $cdpObs.UseItems = $false }   # 行模型建不起来才回退 UIA（兜底，等同 v9.1）
    }
    $useCdp = [bool]($cdpObs -and $cdpObs.UseItems)
    if ($useCdp) { $all = @($cdpObs.Items | Sort-Object cy, cx) }
    else {
        $all = @(Get-UiElements $fg.Handle | Sort-Object cy, cx)
        try { Add-NearLabels $all } catch { }   # v5：无名可点击容器带上内部 / 紧邻文字
        # 隔离浏览器没有强制开启渲染器无障碍：UIA 回退拿到的控件明显比 CDP 少时，继续使用 CDP 条目（不让感知「失明」）
        if ($cdpObs -and (@($all | Where-Object { $_.Type -ne 'Text' }).Count -lt [Math]::Max(4, [int]($cdpObs.Nodes / 3)))) { $cdpObs.UseItems = $true; $useCdp = $true; $all = @($cdpObs.Items | Sort-Object cy, cx) }
    }
    # v4.2：屏幕上有 ≥2 个复选框时建立「列表行模型」（含视口外的行）
    $model = $null
    if (-not $useCdp -and @($all | Where-Object { $_.Type -eq 'CheckBox' }).Count -ge 2) { try { $model = Get-RowModel $fg.Handle } catch { $model = $null } }
    elseif ($useCdp -and $cdpModel) { $model = $cdpModel; $script:V92.CdpRows = $true; $script:V92.CdpRowSteps++ }
    $rowParts = [System.Collections.Generic.HashSet[string]]::new()
    $masterKeys = [System.Collections.Generic.HashSet[string]]::new()
    $rowRects = [System.Collections.Generic.List[object]]::new()
    $rowBids = [System.Collections.Generic.HashSet[int]]::new()
    if ($model) {
        foreach ($row in $model.Rows) {
            if ($row.Cdp) { if ([int]$row.Cb.Bid -gt 0) { [void]$rowBids.Add([int]$row.Cb.Bid) }; if ($row.RowItem) { [void]$rowBids.Add([int]$row.RowItem.Bid) } }
            [void]$rowParts.Add((Get-GeoKey $row.Cb)); [void]$rowParts.Add((Get-GeoKey $row.Row))
            if (-not $row.Row.Off) { $rowRects.Add($row.Row) }
        }
        foreach ($mc in $model.Master) { [void]$masterKeys.Add((Get-GeoKey $mc)) }
    }
    # v4.2：先按屏幕位置排序、再按预算截断（v4.1 在 UIA 文档顺序里截断：Gmail 左侧栏/工具栏占满 100 个名额，模型只看到 6 行邮件）
    $general = [System.Collections.Generic.List[object]]::new()
    $inter = 0; $txt = 0
    foreach ($it in $all) {
        $gk = Get-GeoKey $it
        if ($rowParts.Contains($gk)) { continue }                                              # 行与行复选框在「列表行」区单独列出
        if ($useCdp -and $model -and $it.Cdp) {   # v9.2：CDP 行模型——行内复选框 / 行主链接在「列表行」区单独列出；行外复选框（工具栏「全选」）标为 ⚠全选
            if ([int]$it.Bid -gt 0 -and $rowBids.Contains([int]$it.Bid)) { continue }
            if ($it.Type -eq 'CheckBox' -and $rowRects.Count -gt 0 -and (Test-InAnyRect $it $rowRects)) { continue }
            if ($it.Type -eq 'CheckBox') { $it.IsMaster = $true }
        }
        if (($it.Type -eq 'Text' -or $it.Extra) -and $rowRects.Count -gt 0 -and (Test-InAnyRect $it $rowRects)) { continue }   # 行内文字已并入行摘要
        if ($masterKeys.Contains($gk)) { $it.IsMaster = $true }
        if ($it.Type -eq 'Text') { if ($txt -ge 40) { continue }; $txt++ }
        else { if ($inter -ge $MaxElements) { continue }; $inter++ }
        $general.Add($it)
    }
    try { Update-V92State $fg $all $model } catch { }   # v9.2：选择指纹 / 模态框纪元（状态条件动作账本）
    $script:Elements = @{}
    $lines = [System.Collections.Generic.List[string]]::new()
    $baseKeys = [System.Collections.Generic.List[string]]::new()
    $id = 0
    $cbTotal = 0
    $cbOnIds = [System.Collections.Generic.List[int]]::new()
    foreach ($it in $general) {
        $id++
        $script:Elements[$id] = $it
        $line = "[$id] $($it.Type) `"$($it.Name)`""
        if ($it.Near) { $line += " ≈「$($it.Near)」" }
        if ($it.Value) { $line += " value=`"$($it.Value)`"" }
        if ($it.State) { $line += " state=$($it.State)" }
        if (-not $it.Enabled) { $line += ' (disabled)' }
        if ($it.Focus) { $line += ' ★焦点' }
        if ($it.IsMaster) { $line += ' ⚠全选复选框' }
        if ($it.Covered) { $line += " ⛔被「$($it.CoveredBy)」遮挡（点不到）" }
        if ($it.Pat.Count -gt 0) { $line += ' {' + ($it.Pat -join ',') + '}' }
        $line += " @($($it.cx),$($it.cy))"
        $lines.Add($line)
        $baseKeys.Add("$($it.Type)|$($it.Name)|$($it.State)")
        if ($it.Type -eq 'CheckBox') { $cbTotal++; if ($it.State -eq 'on') { $cbOnIds.Add($id) } }
    }
    $rowBlock = ''
    if ($model -and @($model.Rows).Count -gt 0) {
        $rl = [System.Collections.Generic.List[string]]::new()
        $onIdx = [System.Collections.Generic.List[int]]::new()
        $shown = 0
        foreach ($row in $model.Rows) {
            $id++; $cbId = $id; $script:Elements[$id] = (ConvertTo-RowCbItem $row)
            $id++; $rowId = $id; $script:Elements[$id] = (ConvertTo-RowItem $row)
            $isOn = ($row.Cb.State -eq 'on')
            if ($isOn) { $onIdx.Add([int]$row.Index) }
            $baseKeys.Add("Row|$($row.Text)|$($row.Cb.State)")
            if ($shown -lt 60) {
                $mark = if ($isOn) { '☑' } else { '☐' }
                $vis = if ($row.Row.Off) { ' (视口外)' } else { '' }
                $rl.Add("  R$($row.Index) $mark 复选框[$cbId] 行[$rowId] `"$(Limit-Text $row.Text 70)`"$vis")
                $shown++
            }
        }
        $cnt = @($model.Rows).Count
        if ($cnt -gt $shown) { $rl.Add("  …其余 $($cnt - $shown) 行省略（select_rows 仍可按 R 编号操作）") }
        $vis2 = @($model.Rows | Where-Object { -not $_.Row.Off })
        $vr = if ($vis2.Count -gt 0) { "R$($vis2[0].Index)-R$($vis2[$vis2.Count - 1].Index)" } else { '无' }
        $head = "列表行（带复选框；共 $cnt 行，视口内 $vr；R 编号按从上到下，包含视口外的行。勾选用 select_rows / check，打开某一行请 click 它的行编号）:"
        $sum = "行勾选汇总: 共 $cnt 行，已勾选 $($onIdx.Count) 行" + $(if ($onIdx.Count -gt 0) { "（$(Format-RowRanges $onIdx)）" } else { '' })
        if (@($model.Master).Count -gt 0) { $sum += "；另有 $(@($model.Master).Count) 个不属于任何行的复选框（通常是「全选」，已标注 ⚠）" }
        $rowBlock = (@($head) + @($rl) + @($sum)) -join "`n"
    }
    $focusLine = ''
    try {
        $fe = if ($useCdp) { $null } else { [System.Windows.Automation.AutomationElement]::FocusedElement }
        if ($null -ne $fe) {
            $fc = $fe.Current
            $focusLine = "当前键盘焦点: $($fc.ControlType.ProgrammaticName -replace '^ControlType\.', '') `"$(Limit-Text $fc.Name 50)`""
        }
    }
    catch { }
    $cbLine = ''
    if ($cbTotal -gt 0) {
        $cbLine = "复选框汇总（不含列表行）: 可见共 $cbTotal 个，已勾选 $($cbOnIds.Count) 个" + $(if ($cbOnIds.Count -gt 0) { "（编号 $($cbOnIds -join ',')）" } else { '' })
    }
    $consoleHint = ''
    $isConsole = (Test-IsConsoleWindow $fg.Handle) -or ($fg.Process -in @('pwsh', 'powershell', 'WindowsTerminal', 'conhost', 'OpenConsole'))
    if ($isConsole) { $consoleHint = '（注意：当前前台是运行本脚本的控制台，请先 launch 或 focus_window 切换到目标程序）' }
    $coordLine = Get-CoordLine $fg.Handle
    $text = @(
        "屏幕分辨率: ${sw}x${sh}  真实鼠标位置: ($($cursor[0]),$($cursor[1]))（虚拟鼠标不会移动它）"
        $coordLine
        $(if ($useCdp) { $cdpObs.Line } else { '' })
        $(if ($useCdp) { $cdpObs.FocusLine } else { '' })
        "前台窗口: [$($fg.Process)] $(Limit-Text $fg.Title 100) $consoleHint"
        $focusLine
        '已打开的窗口:'
        ($windows -join "`n")
        "前台窗口控件（共 $($general.Count) 个，按从上到下、从左到右排序；{...} 为可用的无障碍模式 inv=可调用 val=可写值 tog=开关 sel=可选中 exp=可展开 scr=可滚动 foc=可获得键盘焦点（网页可点击元素常见）；≈「…」是无名控件内部或紧邻的文字）:"
        ($lines -join "`n")
        $cbLine
        $rowBlock
    ) | Where-Object { $_ -ne '' } | ForEach-Object { $_ }
    $text = $text -join "`n"
    $curSet = New-KeySet (Add-OrdinalKeys $baseKeys.ToArray())
    $changes = Get-ObservationDiff $script:BaseKeys $curSet $script:BaseTitle $fg.Title
    # v4.3：独立于 UIA 的像素证据（控件文本没变但屏幕变了 = 动作其实生效了；两者都没变 = 真的没生效）
    $pix = Get-PixelSig $fg.Handle
    $pixPct = Get-PixelDiff $script:PixPrev $pix
    $script:PixPrev = $pix
    # v5：无障碍控件很少（游戏 / 画布 / 远程桌面 / 自绘界面）时自动 OCR，补上「看得见的文字 + 坐标」；画面不变则复用
    $interAll = $inter + $(if ($model) { 2 * @($model.Rows).Count } else { 0 })
    # v6.2：视觉通道可用时，盲区窗口不再先跑 OCR 子进程（约 1~3 秒），截图直接交给视觉模型；视觉失败才由调用方回退 OCR
    $skipOcr = ((Test-VisionReady) -and $interAll -lt 6)
    if (-not $NoOcr -and -not $isConsole -and $inter -lt 6 -and $fg.Handle -ne [IntPtr]::Zero -and -not $skipOcr) {
        try { $ob = Get-WindowOcrBlock $fg.Handle $pix; if ($ob) { $text = "$text`n$ob" } } catch { }
    }
    if ($null -ne $pixPct) {
        $pl = if ($pixPct -lt 0.2) { '屏幕像素: 前台窗口几乎无变化' } else { "屏幕像素: 前台窗口约 $pixPct% 的区块发生了变化" }
        $changes = "$changes`n $pl".Trim()
    }
    return [pscustomobject]@{ Text = $text; Foreground = $fg; Keys = $curSet; Changes = $changes; Rows = $model; PixPct = $pixPct; Inter = $interAll; IsConsole = [bool]$isConsole; Pix = $pix; Cdp = $(if ($useCdp) { $cdpObs } else { $null }); CdpHint = $(if ($useCdp) { $cdpObs.Hint } else { '' }) }
}
