//! Span recorder: capture / uia / jab / input / ipc / vision planes -> P50/P99 and OTLP/JSON
//! (same document shape as `ConvertTo-OtlpDocument` of the client, so one collector ingests both).
//! Attributes are limited to plane / name / action_id: request params can never leak into traces.
use serde_json::{json, Value};
use std::collections::VecDeque;

#[derive(Clone, Debug)]
pub struct Span {
    pub plane: String,
    pub name: String,
    pub ms: f64,
    pub end_ns: u64,
    pub action_id: u64,
}

pub struct Recorder {
    spans: VecDeque<Span>,
    pub trace_id: String,
}

/// Nearest-rank percentile, identical to `Get-Percentile`.
pub fn percentile(values: &[f64], p: f64) -> f64 {
    if values.is_empty() {
        return 0.0;
    }
    let mut s = values.to_vec();
    s.sort_by(|a, b| a.partial_cmp(b).unwrap());
    let n = s.len();
    let mut idx = ((p / 100.0 * n as f64).ceil() as i64) - 1;
    idx = idx.clamp(0, n as i64 - 1);
    (s[idx as usize] * 100.0).round() / 100.0
}

impl Recorder {
    pub fn new(trace_id: String) -> Self {
        Recorder { spans: VecDeque::new(), trace_id }
    }
    pub fn add(&mut self, plane: &str, name: &str, ms: f64, now_ns: u64, action_id: u64) {
        self.spans.push_back(Span { plane: plane.into(), name: name.into(), ms: (ms * 1000.0).round() / 1000.0, end_ns: now_ns, action_id });
        while self.spans.len() > 20_000 {
            self.spans.pop_front();
        }
    }
    pub fn stats(&self) -> Value {
        let mut planes: Vec<String> = self.spans.iter().map(|s| s.plane.clone()).collect();
        planes.sort();
        planes.dedup();
        Value::Array(
            planes
                .iter()
                .map(|p| {
                    let v: Vec<f64> = self.spans.iter().filter(|s| &s.plane == p).map(|s| s.ms).collect();
                    json!({ "plane": p, "n": v.len(), "p50": percentile(&v, 50.0), "p99": percentile(&v, 99.0),
                            "max": v.iter().cloned().fold(0.0, f64::max) })
                })
                .collect(),
        )
    }
    pub fn otlp(&self) -> Value {
        let spans: Vec<Value> = self
            .spans
            .iter()
            .enumerate()
            .map(|(i, s)| {
                let dur = (s.ms * 1e6) as u64;
                json!({
                    "traceId": self.trace_id, "spanId": format!("{:016x}", i + 1), "name": format!("dscu.{}", s.plane), "kind": 1,
                    "startTimeUnixNano": s.end_ns.saturating_sub(dur).to_string(), "endTimeUnixNano": s.end_ns.to_string(),
                    "attributes": [
                        { "key": "dscu.plane", "value": { "stringValue": s.plane } },
                        { "key": "dscu.name", "value": { "stringValue": s.name } },
                        { "key": "dscu.action_id", "value": { "intValue": s.action_id.to_string() } },
                        { "key": "dscu.origin", "value": { "stringValue": "dscu-driver" } }
                    ]
                })
            })
            .collect();
        json!({ "resourceSpans": [{
            "resource": { "attributes": [
                { "key": "service.name", "value": { "stringValue": "dscu-driver" } },
                { "key": "service.version", "value": { "stringValue": env!("CARGO_PKG_VERSION") } } ] },
            "scopeSpans": [{ "scope": { "name": "dscu.driver", "version": env!("CARGO_PKG_VERSION") }, "spans": spans }]
        }] })
    }
}

