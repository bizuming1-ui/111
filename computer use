        $stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
        foreach ($p in $pts) { Move-VirtualCursor ([int]$p[0]) ([int]$p[1]) }
        $sec = [Math]::Max(0.001, $stopwatch.Elapsed.TotalSeconds)
