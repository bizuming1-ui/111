"""
v16.4 real-machine audit for the WindowManager (called from tests/verify_phase2.py -> `verify163 --real --rounds 10` and from `verify164`).

Windows + --real:   REAL top-level Tk windows (DPI-aware process) —
    1. pointer accuracy  : SetCursorPos + real mouse click at N random physical points inside the target; the target window RECORDS the click it really received
                           (event.x_root/y_root).  error_px = hypot(received - requested).  Gate: max_error_px <= 3.0
    2. hit verification  : WindowManager.verify_hit_target must say TARGET for every point inside the target
    3. coordinate error  : points on the desktop must classify as OUTSIDE_TARGET (never OCCLUDED) -> proves the v16.3 WeChat failure class is detected correctly
    4. real occlusion    : a second real window covers part of the target; prepare_click must (raise | minimise) -> recovered, needs_reobserve=True
    5. screenshot owner  : target sent to background -> screenshot_ownership must restore the foreground and re-verify
Any other OS / no Tk / no display: the Win32-only parts return NOT_VERIFIED_HERE (never silently PASS).  The pure decision logic is always exercised via the unit suite.
"""
from __future__ import annotations

import math
import random
import sys
import time
import unittest
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
IS_WIN = sys.platform == "win32"


def logic_suite() -> dict[str, Any]:
    """Runs tests/unit/test_v16_4.py (FakeBackend) and returns counts — the platform-independent proof of the decision logic."""
    sys.path.insert(0, str(ROOT / "tests" / "unit"))
    import test_v16_4 as T  # noqa: WPS433

    suite = unittest.defaultTestLoader.loadTestsFromModule(T)
    res = unittest.TextTestRunner(stream=open("nul" if IS_WIN else "/dev/null", "w"), verbosity=0).run(suite)
    return {"tests": res.testsRun, "failures": len(res.failures), "errors": len(res.errors), "pass": res.wasSuccessful(),
            "failed_names": [str(t[0]) for t in res.failures + res.errors][:10]}


def real_window_audit(rounds: int = 10) -> dict[str, Any]:
    if not IS_WIN:
        return {"status": "NOT_VERIFIED_HERE", "reason": "requires Windows (Win32 WindowFromPoint / SendInput)"}
    try:
        import ctypes
        import ctypes.wintypes as wt
        import tkinter as tk
    except Exception as e:  # noqa: BLE001
        return {"status": "NOT_VERIFIED_HERE", "reason": f"tkinter unavailable: {e}"}
    from agent_brain.window_manager import GA_ROOT, V_OCCLUDED, V_OUTSIDE_TARGET, V_TARGET, WindowManager

    u32 = ctypes.windll.user32
    try:
        u32.SetProcessDpiAwarenessContext(ctypes.c_void_p(-4))
    except Exception:  # noqa: BLE001
        pass
    wm = WindowManager()
    root = tk.Tk()
    root.title("DSCU-HIT-TARGET")
    root.geometry("760x480+260+160")
    root.attributes("-topmost", False)
    canvas = tk.Canvas(root, bg="#222")
    canvas.pack(fill="both", expand=True)
    got: list[tuple[int, int]] = []
    canvas.bind("<Button-1>", lambda e: got.append((e.x_root, e.y_root)))
    root.update()
    thwnd = wm.root_of(int(root.winfo_id()))
    occ = tk.Toplevel(root)
    occ.title("DSCU-OCCLUDER")
    occ.geometry("420x300+520+300")
    occ.update()
    ohwnd = wm.root_of(int(occ.winfo_id()))
    out: dict[str, Any] = {"status": "PASS", "rounds": rounds, "target_hwnd": thwnd, "occluder_hwnd": ohwnd, "dpi_awareness": "per-monitor-v2 requested"}

    def pump(ms: int = 250) -> None:
        end = time.time() + ms / 1000
        while time.time() < end:
            root.update()
            time.sleep(0.01)

    def click(x: int, y: int) -> float:
        u32.SetCursorPos(int(x), int(y))
        pt = wt.POINT()
        u32.GetCursorPos(ctypes.byref(pt))
        u32.mouse_event(0x0002, 0, 0, 0, 0)
        time.sleep(0.03)
        u32.mouse_event(0x0004, 0, 0, 0, 0)
        return math.hypot(pt.x - x, pt.y - y)

    try:
        # --- bring target to the front and hide the occluder away from the sampling area
        occ.withdraw()
        root.lift()
        wm.be.raise_window(thwnd)
        pump(300)
        rx, ry, rw, rh = root.winfo_rootx(), root.winfo_rooty(), root.winfo_width(), root.winfo_height()
        errs, cursor_errs, hit_ok = [], [], 0
        rnd = random.Random(164)
        for _ in range(rounds):
            x, y = rx + rnd.randint(20, rw - 20), ry + rnd.randint(20, rh - 20)
            rep = wm.verify_hit_target(thwnd, x, y)
            hit_ok += rep.verdict == V_TARGET
            before = len(got)
            cursor_errs.append(click(x, y))
            pump(200)
            if len(got) > before:
                errs.append(math.hypot(got[-1][0] - x, got[-1][1] - y))
            else:
                errs.append(999.0)
        out["pointer_accuracy"] = {"samples": len(errs), "max_error_px": round(max(errs), 3), "mean_error_px": round(sum(errs) / len(errs), 3), "cursor_max_error_px": round(max(cursor_errs), 3),
                                   "received_clicks": sum(e < 900 for e in errs), "window_rect": [rx, ry, rw, rh]}
        out["hit_verification"] = {"verdict_TARGET": hit_ok, "samples": rounds, "pass": hit_ok == rounds}
        # --- coordinate error class: a point that is not inside the target must be OUTSIDE_TARGET (desktop/other window), never OCCLUDED
        outside = [(rx - 40, ry - 40), (rx + rw + 60, ry + rh + 60)]
        vd = [wm.verify_hit_target(thwnd, *p).verdict for p in outside]
        out["outside_target_classification"] = {"verdicts": vd, "pass": all(v == V_OUTSIDE_TARGET for v in vd)}
        # --- real occlusion + recovery
        rec_ok, rec_n = 0, max(3, rounds // 2)
        details: list[str] = []
        for _ in range(rec_n):
            occ.deiconify()
            occ.geometry(f"420x300+{rx + 200}+{ry + 100}")
            occ.lift()
            wm.be.raise_window(ohwnd)
            pump(250)
            px, py = rx + 300, ry + 200
            pre = wm.verify_hit_target(thwnd, px, py)
            rep = wm.prepare_click(thwnd, px, py)
            ok = pre.verdict == V_OCCLUDED and rep.ok and rep.needs_reobserve
            rec_ok += ok
            details.append(f"pre={pre.verdict} post={rep.verdict} actions={rep.actions}")
            pump(150)
        out["occlusion_recovery"] = {"rounds": rec_n, "recovered": rec_ok, "rate": round(rec_ok / rec_n, 3), "detail_tail": details[-2:], "pass": rec_ok == rec_n}
        # --- screenshot ownership
        own_ok, own_n = 0, 3
        for _ in range(own_n):
            wm.be.raise_window(ohwnd) if occ.winfo_viewable() else None
            pump(200)
            r = wm.screenshot_ownership(thwnd, restore=True)
            own_ok += bool(r.ok)
        out["screenshot_ownership"] = {"rounds": own_n, "ok": own_ok, "pass": own_ok == own_n}
        passes = [out["hit_verification"]["pass"], out["outside_target_classification"]["pass"], out["occlusion_recovery"]["pass"], out["screenshot_ownership"]["pass"],
                  out["pointer_accuracy"]["max_error_px"] <= 3.0]
        out["max_error_px"] = out["pointer_accuracy"]["max_error_px"]
        out["status"] = "PASS" if all(passes) else "FAIL"
    except Exception as e:  # noqa: BLE001
        out["status"], out["error"] = "FAIL", f"{type(e).__name__}: {e}"
    finally:
        try:
            root.destroy()
        except Exception:  # noqa: BLE001
            pass
    _ = GA_ROOT
    return out


