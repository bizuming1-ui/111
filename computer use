// Wait-CdpSettled: readyState==complete && inflight==0 && DOM quiet for `quietMs`, bounded by `maxMs`.
export interface PageProbe { readyState(): Promise<string>; inflight(): Promise<number>; mutationAgeMs(): Promise<number> }
export interface SettleResult { settled: boolean; ms: number; inflight: number; readyState: string }

export async function waitSettled(p: PageProbe, opts: { quietMs?: number; maxMs?: number; pollMs?: number; now?: () => number; sleep?: (ms: number) => Promise<void> } = {}): Promise<SettleResult> {
  const quiet = opts.quietMs ?? 120, max = opts.maxMs ?? 2000, poll = opts.pollMs ?? 40
  const now = opts.now ?? (() => performance.now())
  const sleep = opts.sleep ?? ((ms: number) => new Promise<void>(r => setTimeout(r, ms)))
  const t0 = now()
  let rs = '', inf = 0
  for (;;) {
    ;[rs, inf] = await Promise.all([p.readyState(), p.inflight()])
    const age = await p.mutationAgeMs()
    if (rs === 'complete' && inf === 0 && age >= quiet) return { settled: true, ms: Math.round(now() - t0), inflight: inf, readyState: rs }
    if (now() - t0 >= max) return { settled: false, ms: Math.round(now() - t0), inflight: inf, readyState: rs }
    await sleep(poll)
  }
}
