"""Strongly typed mirror of schemas/protocol_v1.json. Every frame that crosses a process boundary is validated here;
a malformed or partially-filled observation raises ProtocolError instead of silently becoming a default."""
from __future__ import annotations

import json
import uuid
from enum import Enum
from pathlib import Path
from typing import Any, Literal

from pydantic import BaseModel, ConfigDict, Field, ValidationError


class ProtocolError(Exception):
    pass


class ErrorCode(str, Enum):
    STALE_EPOCH = "STALE_EPOCH"
    STALE_HWND = "STALE_HWND"
    AMBIGUOUS_TARGET = "AMBIGUOUS_TARGET"
    OCCLUDED = "OCCLUDED"
    UIPI_DENIED = "UIPI_DENIED"
    SECURITY_DENIED = "SECURITY_DENIED"
    NOT_FOUND = "NOT_FOUND"
    TIMEOUT = "TIMEOUT"
    UNSUPPORTED = "UNSUPPORTED"
    INVALID_REQUEST = "INVALID_REQUEST"
    INTERNAL = "INTERNAL"


Channel = Literal["cdp", "uia", "jab", "dxgi_vision"]
Zone = Literal["Toolbar", "Row", "Modal", "Content"]


class Rect(BaseModel):
    model_config = ConfigDict(extra="ignore")
    x: int
    y: int
    w: int
    h: int

    @property
    def center(self) -> tuple[int, int]:
        return self.x + self.w // 2, self.y + self.h // 2


class Element(BaseModel):
    model_config = ConfigDict(extra="ignore")
    ref_id: str
    stable_key: str
    role: str
    name: str
    zone: Zone
    rect: Rect
    value: str | None = None
    enabled: bool = True
    focused: bool = False
    checked: bool | None = None
    occluded: bool = False
    patterns: list[str] = Field(default_factory=list)
    depth: int = 0
    parent_ref: str | None = None
    row_index: int | None = None
    automation_id: str | None = None


class DxgiStats(BaseModel):
    model_config = ConfigDict(extra="ignore")
    capture_backend: Literal["DXGI", "GDI"]
    fallback_reason: str | None = None
    adapter: str = ""
    frame_ms: float
    dirty_rects_count: int
    move_rects_count: int = 0
    acquire_us: int = 0
    readback_us: int = 0
    fresh: bool = True
    width: int = 0
    height: int = 0
    frames_total: int = 0
    dxgi_frames: int = 0
    gdi_frames: int = 0
    access_lost_count: int = 0


class Screenshot(BaseModel):
    model_config = ConfigDict(extra="ignore")
    mime: str
    width: int
    height: int
    b64: str
    scale: float = 1.0
    source_rect: Rect | None = None


class PageInfo(BaseModel):
    model_config = ConfigDict(extra="ignore")
    url: str = ""
    title: str = ""
    ready_state: str = ""
    inflight: int = 0
    target_id: str = ""
    nav_epoch: int = 0
    settled_ms: float = 0


class ObservationEnvelope(BaseModel):
    """No field with a made-up default stands in for a measurement: channel, epoch, hwnd and ts_ms are required."""

    model_config = ConfigDict(extra="ignore")
    v: Literal[1]
    source: Literal["dscu-driver", "cdp-daemon"]
    channel: Channel
    snapshot_epoch: int = Field(ge=0)
    ts_ms: int
    hwnd: int
    elements: list[Element]
    observe_id: str | None = None
    title: str = ""
    process: str = ""
    pid: int = 0
    is_elevated: bool | None = None
    element_count: int = 0
    dxgi_stats: DxgiStats | None = None
    screen_ahash: str | None = None
    screenshot: Screenshot | None = None
    page: PageInfo | None = None
    windows: list[dict[str, Any]] = Field(default_factory=list)
    taint: bool = False
    mem_free_mb: int | None = None
    collected_ms: float = 0
    foreground_is_console: bool = False
    secure_desktop: bool = False
    timing: dict[str, Any] | None = None
    viewport: dict[str, Any] | None = None
    uia_error: dict[str, Any] | None = None
    jab_note: str | None = None


class ActionRequest(BaseModel):
    action_id: str = Field(min_length=1)
    op: str
    target: dict[str, Any] = Field(default_factory=dict)
    args: dict[str, Any] = Field(default_factory=dict)
    expect_epoch: int | None = None
    expect_hwnd: int | None = None
    timeout_ms: int | None = None

    @staticmethod
    def new(op: str, target: dict | None = None, args: dict | None = None, **kw: Any) -> "ActionRequest":
        return ActionRequest(action_id=f"{op}-{uuid.uuid4().hex[:12]}", op=op, target=target or {}, args=args or {}, **kw)


class ActionResult(BaseModel):
    model_config = ConfigDict(extra="allow")
    action_id: str
    ok: bool
    error_code: ErrorCode | None = None
    detail: str = ""
    retryable: bool = False
    strategy: str | None = None
    replayed: bool = False
    hwnd: int | None = None
    new_epoch: int | None = None
    elapsed_ms: float = 0


def parse_observation(d: dict[str, Any]) -> ObservationEnvelope:
    try:
        return ObservationEnvelope.model_validate(d)
    except ValidationError as e:  # surface the first problem, never patch it up
        raise ProtocolError(f"invalid ObservationEnvelope: {e.errors()[0]['loc']} {e.errors()[0]['msg']}") from e


def parse_action_result(d: dict[str, Any]) -> ActionResult:
    try:
        return ActionResult.model_validate(d)
    except ValidationError as e:
        raise ProtocolError(f"invalid ActionResult: {e.errors()[0]['loc']} {e.errors()[0]['msg']}") from e


def load_schema() -> dict[str, Any]:
    return json.loads((Path(__file__).resolve().parent.parent / "schemas" / "protocol_v1.json").read_text(encoding="utf-8"))
