// CUDA / TensorRT-host backend (NVIDIA): 48x32 gray signature + diff + aHash entirely in device memory; only 1.5 KB / 8 B return to the host.
#include <cstdint>
#include <cuda_runtime.h>

__global__ void sig_from_bgra(const uint8_t* __restrict__ bgra, int stride, int x0, int y0, int w, int h, uint8_t* __restrict__ out) {
  const int dx = blockIdx.x, dy = blockIdx.y, t = threadIdx.x;  // 16 threads = 4x4 samples (matches the CPU reference exactly)
  const int sx = t & 3, sy = t >> 2;
  const int px = x0 + ((dx * 4 + sx) * 2 + 1) * w / (48 * 4 * 2);
  const int py = y0 + ((dy * 4 + sy) * 2 + 1) * h / (32 * 4 * 2);
  const uint8_t* p = bgra + (size_t)py * stride + (size_t)px * 4;
  unsigned v = (77u * p[2] + 150u * p[1] + 29u * p[0]) >> 8;
  for (int o = 8; o > 0; o >>= 1) v += __shfl_down_sync(0xFFFFu, v, o, 16);
  if (t == 0) out[dy * 48 + dx] = (uint8_t)(v / 16);
}

__global__ void diff_mask(const uint8_t* a, const uint8_t* b, int thr, int min_px, unsigned long long* mask, unsigned* count) {
  const int bi = threadIdx.x;  // 64 threads, one per 6x4 block
  const int by = bi >> 3, bx = bi & 7;
  int c = 0, total = 0;
  for (int y = 0; y < 4; ++y)
    for (int x = 0; x < 6; ++x) {
      const int o = (by * 4 + y) * 48 + bx * 6 + x;
      const int d = abs((int)a[o] - (int)b[o]);
      c += d >= thr;
    }
  total = c;
  if (total >= min_px) atomicOr(mask, 1ull << bi);
  atomicAdd(count, (unsigned)c);
}

extern "C" int ve_cuda_diff(const uint8_t* d_bgra_prev, const uint8_t* d_bgra_cur, int stride, int x, int y, int w, int h, int thr, unsigned long long* mask_out, unsigned* diff_count_out) {
  uint8_t *sa = nullptr, *sb = nullptr; unsigned long long* m = nullptr; unsigned* c = nullptr;
  if (cudaMalloc(&sa, 1536) || cudaMalloc(&sb, 1536) || cudaMalloc(&m, 8) || cudaMalloc(&c, 4)) return -1;
  cudaMemset(m, 0, 8); cudaMemset(c, 0, 4);
  sig_from_bgra<<<dim3(48, 32), 16>>>(d_bgra_prev, stride, x, y, w, h, sa);
  sig_from_bgra<<<dim3(48, 32), 16>>>(d_bgra_cur, stride, x, y, w, h, sb);
  diff_mask<<<1, 64>>>(sa, sb, thr, 6, m, c);
  int rc = cudaMemcpy(mask_out, m, 8, cudaMemcpyDeviceToHost) | cudaMemcpy(diff_count_out, c, 4, cudaMemcpyDeviceToHost);
  cudaFree(sa); cudaFree(sb); cudaFree(m); cudaFree(c);
  return rc ? -2 : 0;
}
