        items = p.get("items") or []
        sx, sy, ss = locate_search_box(items, self.geo)
        ix, iy, isrc = locate_input_box(items, self.geo)
        cal = Calibration((sx, sy), (ix, iy), ss, isrc, [f"DML={p.get('dml_n', 0)} 框 · OCR={len(_lines)} 行"])
        self.cal = cal
        self._step("calibrate_layout", True, cal.evidence + " · " + cal.notes[0], t0)
        return cal

