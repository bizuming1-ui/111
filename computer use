        catch {
            $detail = $_.Exception.Message
            if ($_.ErrorDetails -and $_.ErrorDetails.Message) { $detail += " | " + (Limit-Text $_.ErrorDetails.Message 300) }
            $lastErr = $detail
            Write-Host "  API 调用失败（第 $attempt 次）: $detail" -ForegroundColor DarkYellow
            if ($detail -match '\b401\b|\b402\b|Authentication|invalid.*key|Insufficient') { break }
            Wait-Safe ([Math]::Min(8, 2 * $attempt) * 1000)
        }
    }
    throw "DeepSeek API 调用失败: $lastErr"
}
function Get-FirstJsonObject([string]$t) {
    # 字符串感知的括号配对：返回文本里「第一个完整的 JSON 对象」；括号出现在字符串里不会干扰；没有完整对象返回 $null
    $s = $t.IndexOf('{')
    if ($s -lt 0) { return $null }
    $depth = 0; $inStr = $false; $esc = $false
    for ($i = $s; $i -lt $t.Length; $i++) {
        $ch = $t[$i]
        if ($inStr) {
            if ($esc) { $esc = $false }
            elseif ($ch -eq '\') { $esc = $true }
            elseif ($ch -eq '"') { $inStr = $false }
            continue
        }
        if ($ch -eq '"') { $inStr = $true; continue }
        if ($ch -eq '{') { $depth++ }
        elseif ($ch -eq '}') {
            $depth--
            if ($depth -eq 0) { return $t.Substring($s, $i - $s + 1) }
        }
    }
    return $null
}
function ConvertFrom-ModelJson([string]$text) {
    # v4 的做法是取「第一个 { 到最后一个 }」——模型输出两个对象时整段非法（日志任务1第1、2步）。
    $first = Get-FirstJsonObject $text
    if ($null -eq $first) { throw "模型输出里没有完整的 JSON 对象: $(Limit-Text $text 200)" }
    $rest = $text.Substring($text.IndexOf($first) + $first.Length)
    if ($rest.IndexOf('{') -ge 0) { Write-Host '  （模型输出了多个 JSON 对象，只执行第一个；其余已忽略）' -ForegroundColor DarkYellow }
    return ($first | ConvertFrom-Json)
}
#endregion
#region ---------- 单个任务的「观察 → 思考 → 操作」循环 ----------
function Invoke-AgentTask([string]$TaskText) {
    $script:Auto = -not [bool]$StepConfirm
    $script:BaseKeys = $null
    $script:BaseTitle = ''
    $script:TaskQty = Get-TaskQuantity $TaskText
    $script:SelectMemo = $null
    if ($script:TaskQty -gt 0 -and -not $NoSafety) { Write-Host "  （安全联锁：识别到任务数量 N=$($script:TaskQty)；删除/归档前会核对已勾选行数必须等于 N）" -ForegroundColor DarkGray }
    $history = New-Object System.Collections.Generic.List[string]
    $descCount = @{}
    $repeatNote = ''
    $lastActed = $false
    $outcome = 'maxsteps'
    $summary = ''
    $finished = $false
    $failCount = 0
    $lastSig = $null
    $sameCount = 0
    $taskStart = Get-Date
    Write-Log @{ type = 'task_start'; task = $TaskText; model = $Model; admin = $script:IsAdmin; mode = $script:Mode; qty = $script:TaskQty }
    try {
        for ($step = 1; $step -le $MaxSteps; $step++) {
            Test-Abort
            Write-Host "── 第 $step 步 ──" -ForegroundColor Cyan
            $obs = Get-Observation
            $sig = ($obs.Text -replace '真实鼠标位置: \(\d+,\d+\)', '')
            # 刚操作完界面却完全没变：很可能是页面/弹窗延迟生效（日志任务3），先自动等一下再观察一次，再交给模型
            if ($lastActed -and $null -ne $lastSig -and $sig -eq $lastSig) {
                Write-Host '  界面暂无变化，稍候重新观察一次（页面可能仍在加载）...' -ForegroundColor DarkGray
                Wait-Safe 900
                $obs = Get-Observation
                $sig = ($obs.Text -replace '真实鼠标位置: \(\d+,\d+\)', '')
            }
            $lastActed = $false
            if ($SaveScreenshots -and $script:RunDir) {
                try { Save-Screenshot (Join-Path $script:RunDir ("task{0:D2}-step{1:D2}.png" -f $script:TaskNo, $step)) }
                catch { Write-Host "  截图失败: $($_.Exception.Message)" -ForegroundColor DarkYellow }
            }
            if ($null -ne $lastSig -and $sig -eq $lastSig) { $sameCount++ } else { $sameCount = 0 }
            $lastSig = $sig
            $stuckNote = ''
            if ($sameCount -ge 1) { $stuckNote = "`n【提示】上一步之后界面没有任何变化（已连续 $sameCount 次），请换一种方法。" }
            $changeNote = ''
            if ($obs.Changes) { $changeNote = "`n`n相对上一轮的界面变化:`n  $($obs.Changes)" }
            # 记录「这一轮模型看到的」基线，下一轮才能做对比
            $script:BaseKeys = $obs.Keys
            $script:BaseTitle = $obs.Foreground.Title
            $hist = if ($history.Count -gt 0) { ($history | Select-Object -Last $HistoryLimit) -join "`n" } else { '（还没有操作）' }
            $shellNote = if ($NoShell) { '禁止使用 run_powershell。' } else { '允许使用 run_powershell。' }
            if ($script:TaskQty -gt 0 -and -not $NoSafety) { $shellNote += " 系统从任务中识别到数量 N=$($script:TaskQty)：勾选请用 select_rows（rows=`"1-$($script:TaskQty)`"），删除/归档前系统会核对已勾选行数必须等于 N，且禁止全选。" }
            $memNote = ''
            if ($MemoryLimit -gt 0 -and $script:Session.Count -gt 0) {
                $memNote = "本会话之前的任务（仅供参考）:`n" + (($script:Session | Select-Object -Last $MemoryLimit) -join "`n") + "`n`n"
            }
            $userContent = "${memNote}【当前任务】: $TaskText`n`n$shellNote 单轮最多 $MaxBatch 个动作（click_many 的 ids 另算，最多 20 个）。`n`n当前任务已执行的操作历史:`n$hist`n`n当前观察:`n$($obs.Text)$changeNote$stuckNote$repeatNote`n`n请输出下一步的 JSON（只输出一个 JSON 对象）。"
            $repeatNote = ''
            $raw = Invoke-DeepSeek $userContent
            # 观察 → 模型返回之间用户可能切换了窗口，这里不更新 ObsHwnd；执行前由 Assert-KeyboardReady / Assert-PhysicalReady 核对
            try { $parsed = ConvertFrom-ModelJson $raw }
            catch {
                Write-Host "  解析失败: $($_.Exception.Message)" -ForegroundColor Red
                $history.Add("第${step}步: 模型输出不是合法 JSON，已忽略（必须只输出一个 JSON 对象；多个动作请放进 actions 数组）")
                $failCount++
                if ($failCount -ge 4) { throw '模型连续输出非法 JSON，已终止当前任务。' }
                continue
            }
            if ($parsed.thought) { Write-Host "  思考: $($parsed.thought)" -ForegroundColor DarkGray }
            $list = @()
            if ($parsed.actions) { $list = @(@($parsed.actions) | Select-Object -First ([Math]::Max(1, $MaxBatch))) }
            else { $list = @($parsed) }
            if ($list.Count -eq 0 -or -not $list[0].action) {
                $history.Add("第${step}步: 模型没有给出 action，已忽略")
                $failCount++
                if ($failCount -ge 4) { throw '模型连续没有给出有效动作，已终止当前任务。' }
                continue
            }
            # ---- 发送前校验：整批先过 Schema，任何一个不合法就一个都不执行 ----
            $bad = $null
            $vi = 0
            foreach ($act in $list) {
                $vi++
                $why = Test-ActionSchema $act $vi
                if ($why) { $bad = "动作 ${vi} ($(Describe-Action $act)): $why"; break }
            }
            if ($bad) {
                Write-Host "  动作未通过校验，未执行任何动作: $bad" -ForegroundColor Red
                $history.Add("第${step}步: 动作未通过校验（未执行任何动作）: $bad")
                Write-Log @{ type = 'invalid'; step = $step; message = $bad }
                $failCount++
                if ($failCount -ge 5) { throw '模型连续给出无效动作，已终止当前任务。' }
                continue
            }
            $idx = 0
            foreach ($action in $list) {
                $idx++
                $desc = Describe-Action $action
                $tag = if ($list.Count -gt 1) { "动作 $idx/$($list.Count)" } else { '动作' }
                Write-Host "  ${tag}: $desc" -ForegroundColor White
                Write-Log @{ type = 'action'; step = $step; thought = "$($parsed.thought)"; action = $action }
                $kind = "$($action.action)".ToLower().Trim()
                if ($kind -eq 'done') {
                    $summary = "$($action.summary)"
                    Write-Host "✔ 完成: $summary" -ForegroundColor Green
                    Write-Log @{ type = 'done'; summary = $summary }
                    $outcome = 'done'
                    $finished = $true
                    break
                }
                if ($kind -eq 'fail') {
                    $summary = "$($action.reason)"
                    Write-Host "✘ 失败: $summary" -ForegroundColor Red
                    Write-Log @{ type = 'fail'; reason = $summary }
                    $outcome = 'fail'
                    $finished = $true
                    break
                }
                if ($DryRun) {
                    $history.Add("第${step}步: $desc → (DryRun 未执行)")
                    continue
                }
                # 批量中后续的 id 动作：如果前一个动作已经把前台窗口换掉，旧编号作废，中止其余
                if ($idx -gt 1 -and (Test-ActionUsesId $action) -and [DsNative4]::GetForegroundWindow() -ne $obs.Foreground.Handle) {
                    $history.Add("第${step}步: $desc → 未执行：前台窗口已变化，批量中后续的控件编号作废，请重新观察")
                    Write-Host '  前台窗口已变化，批量中后续动作作废。' -ForegroundColor DarkYellow
                    break
                }
                $decision = Confirm-Action $desc
                if ($decision -eq 'q') {
                    Write-Host '已由用户结束当前任务。' -ForegroundColor Yellow
                    $outcome = 'quit'
                    $summary = '用户中途结束了任务'
                    $finished = $true
                    break
                }
                if ($decision -eq 'n') {
                    $history.Add("第${step}步: $desc → 用户拒绝执行，请换一种方式")
                    break
                }
                $descCount[$desc] = 1 + [int]$descCount[$desc]
                if ($descCount[$desc] -ge 3) {
                    $repeatNote = "`n【提示】动作「$(Limit-Text $desc 60)」在本任务中已重复执行 $($descCount[$desc]) 次，请确认它是否真的有效果（看「界面变化」），否则换一种方法。"
                }
                try {
                    $result = Invoke-Action $action
                    Write-Host "  结果: $result" -ForegroundColor Green
                    $history.Add("第${step}步: $desc → $result")
                    $failCount = 0
                    if ($kind -notin 'wait', 'run_powershell') { $lastActed = $true }
                }
                catch {
                    if ($_.Exception.Message -like '触发保护*') { throw }
                    $msg = $_.Exception.Message
                    Write-Host "  执行出错: $msg" -ForegroundColor Red
                    $history.Add("第${step}步: $desc → 出错（已完成的部分不会回滚，请重新观察核对）: $msg")
                    Write-Log @{ type = 'error'; step = $step; message = $msg }
                    break   # 批量动作中途出错：中止其余动作，重新观察
                }
                if ($idx -lt $list.Count) { Wait-Safe 150 }
            }
            if ($finished) { break }
            if ($DryRun) {
                Write-Host '  (DryRun) 不执行，仅演示一步后结束当前任务。' -ForegroundColor DarkYellow
                $outcome = 'dryrun'
                $summary = 'DryRun 仅预演'
                $finished = $true
                break
            }
            Wait-Safe $StepDelayMs
        }
        if (-not $finished) {
            $summary = "已达到最大步数 $MaxSteps，任务未确认完成"
            Write-Host $summary -ForegroundColor Yellow
        }
    }
    catch {
        $msg = $_.Exception.Message
        if ($msg -like '触发保护*') { $outcome = 'aborted'; Reset-AbortState }
        else { $outcome = 'error' }
        $summary = $msg
        Write-Host "已停止当前任务: $msg" -ForegroundColor Red
        Write-Log @{ type = 'abort'; message = $msg }
    }
    $elapsed = [int]((Get-Date) - $taskStart).TotalSeconds
    Write-Host "本任务耗时: ${elapsed} 秒" -ForegroundColor DarkGray
    return [pscustomobject]@{ Outcome = $outcome; Summary = $summary }
}
