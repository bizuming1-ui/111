class MailWorld(T.World):
    """UIA-style mail list: rows 1..8 (checkbox + link, zone=Row) + Toolbar delete button."""
    ROW_Y0, ROW_H = 200, 30

    def __init__(self):
        super().__init__("mail")
        self.checked: set[int] = set()
        self.ep = 1

    def elements(self):
        els, n = [], 0
        for r_ in range(1, 9):
            y = self.ROW_Y0 + r_ * self.ROW_H
            for role, name, x, w, st in (("checkbox", "选择", 100, 20, ["checked"] if r_ in self.checked else []), ("link", f"发件人{r_} 主题{r_}", 140, 600, [])):
                n += 1
                els.append({"ref_id": f"@{self.ep}:e{n}", "role": role, "name": name, "value": "", "rect": [x, y, w, 20], "zone": "Row", "stable_key": f"k{n}", "states": st, "row": r_})
        els.append({"ref_id": f"@{self.ep}:e{n + 1}", "role": "button", "name": "删除", "value": "", "rect": [300, 150, 40, 24], "zone": "Toolbar", "stable_key": "kdel", "states": []})
        return els

    def observe(self, req):
        d = super().observe(req)
        d["elements"], d["channel"] = self.elements(), "uia"
        d["snapshot_epoch"] = self.ep
        return d


def mail_obs(world=None):
