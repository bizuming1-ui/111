# ──────────────────────────────── 运行时：释放 → 工具链 → 编译 → 密钥 → 启动 ────────────────────────────────
function Write-Dscu([string]$m, [string]$c = 'Cyan') { Write-Host $m -ForegroundColor $c }
function Install-DscuFiles {
    $stamp = Join-Path $script:DscuRoot '.payload.sha'
    if ((Test-Path $stamp) -and ((Get-Content $stamp -Raw).Trim() -eq $script:DscuSha) -and -not $env:DSCU_FORCE) { return $false }
    $u8 = [Text.UTF8Encoding]::new($false)
    foreach ($k in $script:DscuFiles.Keys) {
        $p = Join-Path $script:DscuRoot ($k -replace '/', '\')
        New-Item -ItemType Directory -Force -Path (Split-Path $p) | Out-Null
        $txt = ([string]$script:DscuFiles[$k]).Replace("$([char]13)$([char]10)", [string][char]10)
        [IO.File]::WriteAllText($p, $txt, $u8)
    }
    Set-Content -Path $stamp -Value $script:DscuSha -Encoding ascii
    return $true
}
function Find-DscuPython {
    foreach ($c in @(@('py','-3.12'), @('py','-3.13'), @('python'), @('python3'))) {
        try {
            $exe = $c[0]; $rest = @($c | Select-Object -Skip 1)
            if (-not (Get-Command $exe -ErrorAction SilentlyContinue)) { continue }
            $v = & $exe @rest -c "import sys;print('%d.%d'%sys.version_info[:2])" 2>$null
            if ($v -and [version]$v -ge [version]'3.12') { return ,@($exe) + $rest }
        } catch { }
    }
    return $null
}
function Confirm-DscuInstall([string]$what, [string]$wingetId) {
    $a = Read-Host "  未检测到 $what。现在用 winget 自动安装？(y/N)"
    if ($a -match '^(y|yes|是)$') { winget install --id $wingetId -e --silent --accept-package-agreements --accept-source-agreements; $env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User') + ";$env:USERPROFILE\.cargo\bin"; return $true }
    return $false
}
function Initialize-DscuPython {
    $py = Find-DscuPython
    if (-not $py) { if (Confirm-DscuInstall 'Python 3.12+' 'Python.Python.3.12') { $py = Find-DscuPython } }
    if (-not $py) { throw '需要 Python 3.12+（统一大脑）。安装后重新粘贴即可。' }
    $venv = Join-Path $script:DscuRoot '.venv'
    $vpy = Join-Path $venv 'Scripts\python.exe'
    if (-not (Test-Path $vpy)) { Write-Dscu '  创建 Python 虚拟环境 ...'; & $py[0] @($py | Select-Object -Skip 1) -m venv $venv }
    & $vpy -c "import pydantic" 2>$null
    if ($LASTEXITCODE) { Write-Dscu '  安装 pydantic（唯一的 Python 依赖）...'; & $vpy -m pip install --quiet --disable-pip-version-check pydantic }
    return $vpy
}
function Build-DscuDriver {
    $exe = Join-Path $script:DscuRoot 'bin\dscu-driver.exe'
    $srcSha = (Get-ChildItem (Join-Path $script:DscuRoot 'crates\dscu-driver') -Recurse -Include *.rs,Cargo.toml,Cargo.lock -File | Sort-Object FullName | Get-FileHash -Algorithm SHA256 | ForEach-Object Hash) -join ''
    $srcSha = [BitConverter]::ToString([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($srcSha))).Replace('-','').ToLower()
    $stamp = Join-Path $script:DscuRoot 'bin\.driver.sha'
    if ((Test-Path $exe) -and (Test-Path $stamp) -and ((Get-Content $stamp -Raw).Trim() -eq $srcSha) -and -not $env:DSCU_FORCE) { return $exe }
    if (-not (Get-Command cargo -ErrorAction SilentlyContinue)) {
        $env:Path += ";$env:USERPROFILE\.cargo\bin"
        if (-not (Get-Command cargo -ErrorAction SilentlyContinue)) {
            Write-Dscu '  Rust 工具链用于编译真·DXGI 驱动（还需要 MSVC 生成工具：winget install Microsoft.VisualStudio.2022.BuildTools --override "--add Microsoft.VisualStudio.Workload.VCTools --passive"）。' Yellow
            if (Confirm-DscuInstall 'Rust (rustup)' 'Rustlang.Rustup') { & rustup default stable-x86_64-pc-windows-msvc | Out-Null }
        }
    }
    if (-not (Get-Command cargo -ErrorAction SilentlyContinue)) { Write-Dscu '  ⚠ 没有 cargo：跳过原生驱动，将使用 Python ctypes 兼容桥（GDI，无 UIA）。' Yellow; return $null }
    Write-Dscu '  编译 dscu-driver.exe（首次约 2~5 分钟；之后按源码哈希缓存）...'
    Push-Location (Join-Path $script:DscuRoot 'crates\dscu-driver')
    try { cargo build --release 2>&1 | ForEach-Object { if ($_ -match 'error|warning: unused|Finished|Compiling dscu') { Write-Host "    $_" -ForegroundColor DarkGray } } } finally { Pop-Location }
    $built = Join-Path $script:DscuRoot 'crates\dscu-driver\target\release\dscu-driver.exe'
    if (-not (Test-Path $built)) { Write-Dscu '  ⚠ 编译失败（常见原因：缺少 MSVC 生成工具）。将使用兼容桥。' Yellow; return $null }
    New-Item -ItemType Directory -Force -Path (Split-Path $exe) | Out-Null
    Copy-Item $built $exe -Force
    Set-Content -Path $stamp -Value $srcSha -Encoding ascii
    return $exe
}
function Initialize-DscuNode {
    $ok = $false
    try { $ok = [int]((node -v) -replace '^v(\d+)\..*', '$1') -ge 22 } catch { }
    if (-not $ok) { if (Confirm-DscuInstall 'Node.js 22+' 'OpenJS.NodeJS.LTS') { try { $ok = [int]((node -v) -replace '^v(\d+)\..*', '$1') -ge 22 } catch { } } }
    if (-not $ok) { Write-Dscu '  ⚠ 没有 Node 22+：浏览器通道（CDP 守护）不可用，其余功能正常。' Yellow }
    return $ok
}
function Start-Dscu {
    Write-Dscu "DeepSeek Computer Use v$($script:DscuVersion) · 统一 Agent 大脑（Python）+ Rust DXGI/UIA 驱动 + TS CDP 守护" 'Green'
    $fresh = Install-DscuFiles
    Write-Dscu ("  工程目录: $($script:DscuRoot)  （" + $(if ($fresh) { '已释放 ' + $script:DscuFiles.Count + ' 个文件' } else { '已是最新，跳过释放' }) + '）')
    $vpy = Initialize-DscuPython
    $nodeOk = Initialize-DscuNode
    $drv = Build-DscuDriver
    if (-not $env:DEEPSEEK_API_KEY) {
        $sec = Read-Host '请输入 DeepSeek API Key（直接回车=跳过，仅 Layer 0 / 确定性技能可用）' -AsSecureString
        $plain = [Net.NetworkCredential]::new('', $sec).Password
        if ($plain) { $env:DEEPSEEK_API_KEY = $plain }
    }
    $env:DSCU_ROOT = $script:DscuRoot; $env:PYTHONPATH = $script:DscuRoot; $env:PYTHONUTF8 = '1'; $env:PYTHONIOENCODING = 'utf-8'
    if ($drv) { $env:DSCU_DRIVER_EXE = $drv }
    if (-not $nodeOk) { $env:DSCU_CDP_ADDR = 'pipe://dscu-cdp-offline' }
    Write-Dscu '  命令：dscu（重新进入）· dscu-verify（Step1 三项实机验收）· dscu-evals（基准套件）· dscu-rebuild（强制重编译）· dscu-uiaccess（管理员窗口 UIPI）' 'DarkGray'
    Push-Location $script:DscuRoot
    try { & $vpy -m agent_brain } finally { Pop-Location }
}
function dscu { Start-Dscu }
function dscu-verify { $env:DSCU_ROOT = $script:DscuRoot; $env:PYTHONPATH = $script:DscuRoot; $env:PYTHONUTF8 = '1'; & (Join-Path $script:DscuRoot '.venv\Scripts\python.exe') (Join-Path $script:DscuRoot 'tests\verify_step1_live.py') }
function dscu-evals { $env:DSCU_ROOT = $script:DscuRoot; $env:PYTHONPATH = $script:DscuRoot; $env:PYTHONUTF8 = '1'; & (Join-Path $script:DscuRoot '.venv\Scripts\python.exe') (Join-Path $script:DscuRoot 'evals\run_suite.py') @args }
function dscu-rebuild { $env:DSCU_FORCE = '1'; try { Start-Dscu } finally { Remove-Item Env:DSCU_FORCE -ErrorAction SilentlyContinue } }
function dscu-uiaccess { & (Join-Path $script:DscuRoot 'scripts\setup-uiaccess.ps1') -Exe (Join-Path $script:DscuRoot 'bin\dscu-driver.exe') }
Start-Dscu
