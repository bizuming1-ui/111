                      f"first={first_code} final={res.code.value} stats={hub_stats} occluder_states={states[-3:]}", first_code=first_code, recovered=hub_stats.get("occluded_recovered", 0))
    finally:
        g.close()
        try:
            import psutil

            for p in psutil.process_iter(["name"]):
                if (p.info["name"] or "").lower() == "mspaint.exe":
                    p.terminate()
        except Exception:  # noqa: BLE001
            pass


