    def build_geometry(self, probe: dict[str, Any], monitors: list[Monitor], client_origin: Optional[tuple[int, int]] = None, *, page_id: Any = None, epoch: int = 0,
                       window_rect: Optional[Rect] = None) -> ViewportGeometry:
        dpr = float(probe.get("dpr") or probe.get("devicePixelRatio") or 1.0)
        iw, ih = int(probe.get("innerWidth") or 0), int(probe.get("innerHeight") or 0)
        sx, sy = float(probe.get("screenX") or 0), float(probe.get("screenY") or 0)
        ow, oh = float(probe.get("outerWidth") or 0), float(probe.get("outerHeight") or 0)
        vv = probe.get("vv") or {}
        iw = int(vv.get("width") or iw)  # visualViewport excludes pinch-zoom / on-screen keyboard
        ih = int(vv.get("height") or ih)
