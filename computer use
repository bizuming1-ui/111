"""Quota queue + Zone-aware interlock + Quota-Zero Auto-Convergence (`agent_brain/quota.py`)."""
from __future__ import annotations
import re
from dataclasses import dataclass, field

_CN = {"零": 0, "一": 1, "二": 2, "两": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9}
DESTRUCTIVE = re.compile(
    r"(删除|刪除|delete|trash|垃圾|移除|remove|discard|丢弃|丟棄|archive|封存|归档|歸檔|永久)", re.I
)
SELECT_ALL = re.compile(r"^\s*(全选|全選|全部|所有|全部选择|选择全部|選取全部|select\s*all|all)\s*$", re.I)


def cn_to_int(s: str) -> int:
    if s.isdigit():
        return int(s)
    total = cur = 0
    for ch in s:
        if ch in _CN:
            cur = _CN[ch]
        elif ch == "十":
            total += (cur or 1) * 10
            cur = 0
        elif ch == "百":
            total += (cur or 1) * 100
            cur = 0
        else:
            return 0
    return total + cur


def get_task_quantities(text: str) -> tuple[list[int], int]:
    if not text or not re.search(
        r"(删|刪|delete|remove|勾|选中|選取|选择|選擇|select|archive|归档|歸檔|封存|垃圾|trash|标记|標記|mark|移动|移至|移到|move)",
        text,
        re.I,
    ):
        return [], 0
    num = r"(\d{1,3}|[零一二两三四五六七八九十百]{1,4})"
    pats = [
        rf"(?:最?前面?|头|first|top)\s*{num}",
        rf"(?:(?<![然之以前])最?后面?|末尾|最末|结尾|尾部|last|bottom)\s*{num}",
        rf"(?<![第\d零一二两三四五六七八九十百]){num}\s*(?:个|個|封|条|條|项|項|则|則|份|篇)",
        rf"(?<![第\d]){num}\s+(?:emails?|mails?|messages?|items?|conversations?|rows?)",
    ]
    found: dict[int, int] = {}
    for p in pats:
        for m in re.finditer(p, text, re.I):
            idx = m.start(1)
            if idx in found:
                continue
            v = cn_to_int(m.group(1))
            if 0 < v <= 500:
                found[idx] = v
    batches = [found[k] for k in sorted(found)]
    return batches, sum(batches)


@dataclass
class Pending:
    count: int
    texts: list[str]
    before: list[int]


@dataclass
class Quota:
    original: list[int]
    remaining: list[int]
    total: int
    done: int = 0
    pending: Pending | None = None
    log: list[str] = field(default_factory=list)

    @classmethod
    def from_task(cls, text: str) -> "Quota | None":
        b, t = get_task_quantities(text)
        return cls(list(b), list(b), t) if b else None

    @property
    def is_quota_zero(self) -> bool:
        return self.total > 0 and self.done >= self.total and len(self.remaining) == 0 and self.pending is None

    def allowed(self) -> list[int]:
        s, acc = set(), 0
        for v in self.remaining:
            s.add(v)
            acc += v
            s.add(acc)
        return sorted(s)

    def register(self, count: int, texts: list[str]) -> None:
        before = list(self.remaining)
        if count in self.remaining:
            self.remaining.remove(count)
        else:
            acc = 0
            for j, v in enumerate(self.remaining):
                acc += v
                if acc == count:
                    del self.remaining[: j + 1]
                    break
            else:
                if count >= acc:
                    self.remaining.clear()
        self.pending = Pending(count, list(texts), before)
        self.log.append(f"register {count} -> {self.remaining}")

    def resolve(self, current_row_texts: list[str]) -> str:
        if self.pending is None:
            return "none"
        p, self.pending = self.pending, None
        present = set(current_row_texts)
        removed = sum(1 for t in p.texts if t and t not in present)
        if removed <= 0:
            self.remaining = list(p.before)
            self.log.append("rollback")
            return "rollback"
        if removed >= p.count:
            self.done += p.count
            self.log.append(f"commit {p.count}")
            return "commit"
        left = p.count - removed
        self.done += removed
        self.remaining = self._partial(p, left)
        self.log.append(f"partial {removed}/{p.count}")
        return "partial"

    def _partial(self, p: Pending, left: int) -> list[int]:
        rem = list(p.before)
        if p.count in rem:
            rem[rem.index(p.count)] = left
        else:
            rem.insert(0, left)
        return rem

    def fmt(self) -> str:
        r = "+".join(map(str, self.remaining)) or "无"
        return f"配额队列 [{'+'.join(map(str, self.original))}]（总目标 {self.total}），已确认删除 {self.done}，剩余 [{r}]"


def interlock_decision(
    *,
    total: int,
    name: str,
    is_master: bool,
    row_count: int,
    on_count: int,
    zone: str,
    allowed: list[int],
    toolbar_twin: bool = False,
    quota_zero: bool = False,
) -> str | None:
    if total <= 0 or row_count <= 0:
        return None
    if quota_zero and DESTRUCTIVE.search(name):
        return "QUOTA_DONE: 任务的数量配额已全部完成，系统自动进入终态收敛"
    if is_master and row_count > total and not quota_zero:
        return f"安全联锁：任务只要求 {total} 个，禁止点击「全选」复选框（共 {row_count} 行）"
    if SELECT_ALL.match(name) and row_count > total:
        return f"安全联锁：禁止使用「{name}」（会选中全部 {row_count} 行）"
    if DESTRUCTIVE.search(name):
        if zone == "Row" and on_count != 1:
            hint = "；本页存在同名 [Zone: Toolbar] 批量按钮，系统将自动改点它" if toolbar_twin else ""
            return f"安全联锁 [Zone: Row]：「{name}」是行内悬浮按钮，只会处理那一行（当前勾选 {on_count} 个）{hint}"
        if zone != "Row":
            ok = [v for v in allowed if v > 0] or [total]
            if on_count not in ok:
                return f"安全联锁 [Zone: Toolbar]：允许的勾选数为剩余子批次 {ok}，当前勾选 {on_count} 个"
    return None
