        match self {
            ParseError => -32700,
            InvalidRequest => -32600,
            MethodNotFound => -32601,
            InvalidParams => -32602,
            UnsupportedVersion => 4001,
            AuthRequired => 4010,
            AuthFailed => 4011,
            PolicyDenied => 4030,
