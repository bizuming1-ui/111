//! UI Automation snapshots with agent-desktop style fail-closed refs: `@<snapshot_epoch>:<ref>`.
//! * every observe bumps the epoch; refs of older epochs are rejected (STALE_EPOCH) - no clicking the wrong control
//! * `skeleton` prunes the tree to interactive nodes; `root` re-snapshots only one subtree
//! * Headless-First: Invoke / Toggle / SelectionItem / ValuePattern are tried before any physical mouse movement
//! * Zone model: Toolbar vs Row vs Modal so "delete" in a toolbar is never confused with a row control
use serde_json::{json, Value};
use std::collections::HashMap;
use std::time::{Duration, Instant};
use windows::core::{Interface, BSTR};
use windows::Win32::Foundation::*;
use windows::Win32::System::Com::*;
use windows::Win32::UI::Accessibility::*;
use windows::Win32::UI::WindowsAndMessaging::*;

pub struct Stored {
    el: IUIAutomationElement,
    pub name: String,
    pub role: &'static str,
    pub rect: [i32; 4],
    pub root_hwnd: isize,
}

pub struct Uia {
    auto: IUIAutomation,
    cache: IUIAutomationCacheRequest,
    walker: IUIAutomationTreeWalker,
    pub epoch: u64,
    refs: HashMap<String, Stored>,
}

#[derive(Clone, Copy, Default)]
struct Ctx {
    toolbar: bool,
    row: bool,
    modal: bool,
}

fn role_of(ct: i32) -> &'static str {
    match ct {
        50000 => "Button", 50001 => "Calendar", 50002 => "CheckBox", 50003 => "ComboBox", 50004 => "Edit",
        50005 => "Hyperlink", 50006 => "Image", 50007 => "ListItem", 50008 => "List", 50009 => "Menu",
        50010 => "MenuBar", 50011 => "MenuItem", 50012 => "ProgressBar", 50013 => "RadioButton",
        50014 => "ScrollBar", 50015 => "Slider", 50016 => "Spinner", 50017 => "StatusBar", 50018 => "Tab",
        50019 => "TabItem", 50020 => "Text", 50021 => "ToolBar", 50022 => "ToolTip", 50023 => "Tree",
        50024 => "TreeItem", 50025 => "Custom", 50026 => "Group", 50027 => "Thumb", 50028 => "DataGrid",
        50029 => "DataItem", 50030 => "Document", 50031 => "SplitButton", 50032 => "Window", 50033 => "Pane",
        50034 => "Header", 50035 => "HeaderItem", 50036 => "Table", 50037 => "TitleBar", 50038 => "Separator",
        _ => "Unknown",
    }
}

fn interactive(role: &str, focusable: bool, named: bool) -> bool {
    matches!(
        role,
        "Button" | "CheckBox" | "ComboBox" | "Edit" | "Hyperlink" | "ListItem" | "MenuItem" | "RadioButton"
            | "Slider" | "Spinner" | "SplitButton" | "TabItem" | "TreeItem" | "DataItem" | "Document"
    ) || (focusable && named && matches!(role, "Custom" | "Group" | "Pane" | "Image" | "Text"))
}

fn patterns_of(role: &str) -> Vec<&'static str> {
    match role {
        "Button" | "Hyperlink" | "MenuItem" | "SplitButton" => vec!["inv"],
        "CheckBox" | "RadioButton" => vec!["tog", "sel"],
        "Edit" | "ComboBox" | "Document" => vec!["val"],
        "ListItem" | "TreeItem" | "TabItem" | "DataItem" => vec!["sel", "inv"],
        _ => vec![],
    }
}

fn fnv(s: &str) -> u64 {
    let mut h = 0xcbf29ce484222325u64;
    for b in s.as_bytes() {
        h ^= *b as u64;
        h = h.wrapping_mul(0x100000001b3);
    }
    h
}

impl Uia {
    pub fn new() -> Result<Uia, String> {
        unsafe {
            let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
            let auto: IUIAutomation =
                CoCreateInstance(&CUIAutomation8, None, CLSCTX_INPROC_SERVER).map_err(|e| format!("CUIAutomation8: {e}"))?;
            let cache = auto.CreateCacheRequest().map_err(|e| e.to_string())?;
            for p in [
                UIA_NamePropertyId, UIA_ControlTypePropertyId, UIA_BoundingRectanglePropertyId,
                UIA_AutomationIdPropertyId, UIA_ClassNamePropertyId, UIA_IsEnabledPropertyId,
                UIA_IsOffscreenPropertyId, UIA_HasKeyboardFocusPropertyId, UIA_IsKeyboardFocusablePropertyId,
            ] {
                cache.AddProperty(p).map_err(|e| e.to_string())?;
            }
            cache.SetTreeScope(TreeScope_Element).map_err(|e| e.to_string())?;
            let walker = auto.ControlViewWalker().map_err(|e| e.to_string())?;
            Ok(Uia { auto, cache, walker, epoch: 0, refs: HashMap::new() })
        }
    }

    /// Snapshot a window (or a previously referenced subtree). Always bumps the epoch.
    pub fn snapshot(&mut self, hwnd: isize, root_ref: Option<&str>, skeleton: bool, max_elements: usize) -> Result<Value, (&'static str, String)> {
        let t0 = Instant::now();
        let root_el = unsafe {
            if let Some(r) = root_ref {
                match self.resolve(r, None) {
                    Ok(s) => s.el.clone(),
                    Err(e) => return Err(e),
                }
            } else {
                self.auto
                    .ElementFromHandleBuildCache(crate::window::hwnd_of(hwnd), &self.cache)
                    .map_err(|e| ("NOT_FOUND", format!("ElementFromHandle: {e}")))?
            }
        };
        let top_class = crate::window::class_of(crate::window::hwnd_of(hwnd));
        self.epoch += 1;
        self.refs.clear();
        let mut out: Vec<Value> = Vec::new();
        let mut visited = 0usize;
        let deadline = Instant::now() + Duration::from_millis(if skeleton { 700 } else { 1300 });
        let ctx = Ctx { modal: top_class == "#32770", ..Default::default() };
        let max_depth = if skeleton { 9 } else { 16 };
        self.walk(&root_el, 0, max_depth, ctx, hwnd, skeleton, max_elements.max(10), deadline, &mut visited, &mut out);
        Ok(json!({
            "elements": out, "visited": visited, "uia_ms": t0.elapsed().as_secs_f64() * 1000.0,
            "truncated": out.len() >= max_elements || Instant::now() >= deadline
        }))
    }

    #[allow(clippy::too_many_arguments)]
    fn walk(&mut self, parent: &IUIAutomationElement, depth: usize, max_depth: usize, ctx: Ctx, root_hwnd: isize,
            skeleton: bool, max_el: usize, deadline: Instant, visited: &mut usize, out: &mut Vec<Value>) {
        if depth >= max_depth || out.len() >= max_el || Instant::now() >= deadline {
            return;
        }
        let mut child = unsafe { self.walker.GetFirstChildElementBuildCache(parent, &self.cache).ok() };
        while let Some(el) = child {
            if out.len() >= max_el || Instant::now() >= deadline || *visited > 4000 {
                return;
            }
            *visited += 1;
            unsafe {
                let ct = el.CachedControlType().map(|c| c.0).unwrap_or(0);
                let role = role_of(ct);
                let offscreen = el.CachedIsOffscreen().map(|b| b.as_bool()).unwrap_or(false);
                let name = el.CachedName().map(|b| b.to_string()).unwrap_or_default();
                let focusable = el.CachedIsKeyboardFocusable().map(|b| b.as_bool()).unwrap_or(false);
                let enabled = el.CachedIsEnabled().map(|b| b.as_bool()).unwrap_or(true);
                let r = el.CachedBoundingRectangle().unwrap_or_default();
                let rect = [r.left, r.top, r.right - r.left, r.bottom - r.top];
                let mut c2 = ctx;
                match role {
                    "ToolBar" | "MenuBar" | "TitleBar" | "Tab" => c2.toolbar = true,
                    "ListItem" | "DataItem" | "TreeItem" => c2.row = true,
                    "Window" if depth > 0 => c2.modal = true,
                    _ => {}
                }
                let inter = interactive(role, focusable, !name.is_empty());
                let sized = rect[2] > 0 && rect[3] > 0;
                let keep = !offscreen && sized && (inter || (!skeleton && !name.is_empty() && matches!(role, "Text" | "TitleBar" | "Window" | "StatusBar")));
                if keep {
                    let id = el.CachedAutomationId().map(|b| b.to_string()).unwrap_or_default();
                    let class = el.CachedClassName().map(|b| b.to_string()).unwrap_or_default();
                    let zone = if c2.modal { "Modal" } else if c2.row { "Row" } else if c2.toolbar { "Toolbar" } else { "Other" };
                    let n = out.len() + 1;
                    let rid = format!("@{}:e{}", self.epoch, n);
                    let key = format!("{:x}", fnv(&format!("{role}|{id}|{class}|{name}|{zone}")));
                    let mut states: Vec<&str> = Vec::new();
                    if !enabled { states.push("disabled"); }
                    if el.CachedHasKeyboardFocus().map(|b| b.as_bool()).unwrap_or(false) { states.push("focused"); }
                    let mut value = String::new();
                    if matches!(role, "Edit" | "ComboBox" | "Document") {
                        if let Some(vp) = pattern::<IUIAutomationValuePattern>(&el, UIA_ValuePatternId) {
                            value = vp.CurrentValue().map(|b| b.to_string()).unwrap_or_default();
                        }
                    }
                    out.push(json!({
                        "ref_id": rid, "role": role, "name": name, "value": value, "rect": rect, "zone": zone,
                        "stable_key": key, "states": states, "patterns": patterns_of(role), "automation_id": id, "depth": depth
                    }));
                    self.refs.insert(rid.clone(), Stored { el: el.clone(), name: name.clone(), role, rect, root_hwnd });
                }
                if matches!(role, "ScrollBar" | "Separator" | "Thumb" | "Image") {
                    // leaf-ish, don't descend
                } else if !(skeleton && offscreen) {
                    self.walk(&el, depth + 1, max_depth, c2, root_hwnd, skeleton, max_el, deadline, visited, out);
                }
                child = self.walker.GetNextSiblingElementBuildCache(&el, &self.cache).ok();
            }
        }
    }

    fn parse(r: &str) -> Option<u64> {
        r.strip_prefix('@')?.split(':').next()?.parse().ok()
    }

    /// Fail-closed resolve: wrong epoch => STALE_EPOCH; element renamed/moved away => STALE_EPOCH.
    pub fn resolve(&self, r: &str, expect_epoch: Option<u64>) -> Result<&Stored, (&'static str, String)> {
        let e = Self::parse(r).ok_or(("NOT_FOUND", format!("bad ref '{r}'")))?;
        if e != self.epoch || expect_epoch.map(|x| x != self.epoch).unwrap_or(false) {
            return Err(("STALE_EPOCH", format!("ref {r} belongs to epoch {e}, current epoch is {}", self.epoch)));
        }
        let s = self.refs.get(r).ok_or(("NOT_FOUND", format!("ref {r} not in snapshot")))?;
        unsafe {
            match s.el.CurrentName() {
                Ok(n) if n.to_string() == s.name => {}
                Ok(n) => return Err(("STALE_EPOCH", format!("element changed: '{}' -> '{}'", s.name, n))),
                Err(e) => return Err(("STALE_EPOCH", format!("element vanished: {e}"))),
            }
        }
        Ok(s)
    }

    /// Headless-first activation. Returns the mechanism used.
    pub fn invoke(&self, r: &str, expect_epoch: Option<u64>) -> Result<&'static str, (&'static str, String)> {
        let s = self.resolve(r, expect_epoch)?;
        unsafe {
            if let Some(p) = pattern::<IUIAutomationInvokePattern>(&s.el, UIA_InvokePatternId) {
                if p.Invoke().is_ok() { return Ok("InvokePattern"); }
            }
            if let Some(p) = pattern::<IUIAutomationTogglePattern>(&s.el, UIA_TogglePatternId) {
                if p.Toggle().is_ok() { return Ok("TogglePattern"); }
            }
            if let Some(p) = pattern::<IUIAutomationSelectionItemPattern>(&s.el, UIA_SelectionItemPatternId) {
                if p.Select().is_ok() { return Ok("SelectionItemPattern"); }
            }
            if let Some(p) = pattern::<IUIAutomationExpandCollapsePattern>(&s.el, UIA_ExpandCollapsePatternId) {
                if p.Expand().is_ok() { return Ok("ExpandCollapsePattern"); }
            }
        }
        Err(("UNSUPPORTED", "no headless pattern available; use a physical click".into()))
    }

    pub fn set_value(&self, r: &str, text: &str, expect_epoch: Option<u64>) -> Result<String, (&'static str, String)> {
        let s = self.resolve(r, expect_epoch)?;
        unsafe {
            let vp = pattern::<IUIAutomationValuePattern>(&s.el, UIA_ValuePatternId)
                .ok_or(("UNSUPPORTED", "no ValuePattern".to_string()))?;
            vp.SetValue(&BSTR::from(text)).map_err(|e| ("UIPI_DENIED", format!("SetValue: {e} (target may be elevated: install uiAccess)")))?;
            Ok(vp.CurrentValue().map(|b| b.to_string()).unwrap_or_default())
        }
    }

    pub fn focus(&self, r: &str, expect_epoch: Option<u64>) -> Result<(), (&'static str, String)> {
        let s = self.resolve(r, expect_epoch)?;
        unsafe { s.el.SetFocus().map_err(|e| ("INTERNAL", format!("SetFocus: {e}"))) }
    }

    /// Center point of a ref + occlusion check against the real top-level window under that point.
    pub fn click_point(&self, r: &str, expect_epoch: Option<u64>) -> Result<(i32, i32, f64), (&'static str, String)> {
        let s = self.resolve(r, expect_epoch)?;
        let (cx, cy) = (s.rect[0] + s.rect[2] / 2, s.rect[1] + s.rect[3] / 2);
        unsafe {
            let h = WindowFromPoint(POINT { x: cx, y: cy });
            let top = GetAncestor(h, GA_ROOT);
            if crate::window::raw(top) != s.root_hwnd && s.root_hwnd != 0 {
                return Err(("OCCLUDED", format!("point ({cx},{cy}) is covered by hwnd {} '{}'", crate::window::raw(top), crate::window::title_of(top))));
            }
        }
        Ok((cx, cy, s.rect[2].min(s.rect[3]) as f64))
    }
}

unsafe fn pattern<T: Interface>(el: &IUIAutomationElement, id: UIA_PATTERN_ID) -> Option<T> {
    el.GetCurrentPatternAs::<T>(id).ok()
}
