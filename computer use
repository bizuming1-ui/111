Add-DscuFile 'packages/cdp-daemon/src/snapshot.ts' 'c18458e8a7b6f4f1980f315b41d8b134ab31f2b0e2dbab9f96ddf4ae6aed8e85' @'
// AXTree + DOMSnapshot(pierce shadow/iframe) fusion with Toolbar / Row / Modal zones.
import type { Cdp } from "./cdp.ts";

type Json = Record<string, any>;
export type Ref = { backendNodeId: number; name: string; role: string; rect: [number, number, number, number]; session: string };
export type Snap = { elements: Json[]; refs: Map<string, Ref>; stats: Json };

const INTERACTIVE = new Set([
  "button", "link", "textbox", "searchbox", "combobox", "checkbox", "radio", "menuitem", "menuitemcheckbox",
  "menuitemradio", "tab", "option", "switch", "slider", "spinbutton", "treeitem", "listbox", "row",
]);
const TOOLBAR_ROLES = new Set(["toolbar", "banner", "navigation", "menubar", "tablist", "menu"]);
const ROW_ROLES = new Set(["row", "listitem", "option", "treeitem", "gridcell", "article"]);
const MODAL_ROLES = new Set(["dialog", "alertdialog"]);

function fnv(s: string): string {
  let h = 0xcbf29ce484222325n;
  for (const ch of Buffer.from(s, "utf8")) { h ^= BigInt(ch); h = (h * 0x100000001b3n) & 0xffffffffffffffffn; }
  return h.toString(16);
}

export async function takeSnapshot(cdp: Cdp, session: string, epoch: number, maxElements: number): Promise<Snap> {
  const t0 = performance.now();
  const [ax, dom, lm] = await Promise.all([
    cdp.send("Accessibility.getFullAXTree", {}, session, 20000),
    cdp.send("DOMSnapshot.captureSnapshot", { computedStyles: ["visibility", "display"], includeDOMRects: true, includePaintOrder: true }, session, 25000),
    cdp.send("Page.getLayoutMetrics", {}, session),
  ]);
  const t1 = performance.now();
  const strings: string[] = dom.strings;
  const S = (i: number) => (i >= 0 ? strings[i] ?? "" : "");
  const vv = lm.cssVisualViewport ?? { clientWidth: 1280, clientHeight: 800 };

  // backendNodeId -> {doc,node}; per-doc viewport offset (iframes accumulate the owner's origin)
  type Loc = { d: number; n: number };
  const byBackend = new Map<number, Loc>();
  const boundsOf = new Map<string, [number, number, number, number]>();
  const docOffset: Array<[number, number]> = [];
  dom.documents.forEach((_: Json, d: number) => (docOffset[d] = [0, 0]));
  const walkDoc = (d: number, ox: number, oy: number) => {
    const doc = dom.documents[d];
    docOffset[d] = [ox - (doc.scrollOffsetX ?? 0), oy - (doc.scrollOffsetY ?? 0)];
    const nodeToLayout = new Map<number, number>();
    (doc.layout?.nodeIndex ?? []).forEach((ni: number, li: number) => nodeToLayout.set(ni, li));
    const cdi: Json = {};
    (doc.nodes.contentDocumentIndex?.index ?? []).forEach((ni: number, k: number) => (cdi[ni] = doc.nodes.contentDocumentIndex.value[k]));
    for (let n = 0; n < doc.nodes.backendNodeId.length; n++) {
      byBackend.set(doc.nodes.backendNodeId[n], { d, n });
      const li = nodeToLayout.get(n);
      if (li !== undefined) {
        const b = doc.layout.bounds[li];
        boundsOf.set(`${d}:${n}`, [b[0] + docOffset[d][0], b[1] + docOffset[d][1], b[2], b[3]]);
        if (cdi[n] !== undefined) walkDoc(cdi[n], b[0] + docOffset[d][0], b[1] + docOffset[d][1]);
      }
    }
  };
  walkDoc(0, 0, 0);

  const attrOf = (d: number, n: number, name: string): string => {
    const at: number[] = dom.documents[d].nodes.attributes[n] ?? [];
    for (let i = 0; i + 1 < at.length; i += 2) if (S(at[i]) === name) return S(at[i + 1]);
    return "";
  };
  const zoneOf = (d: number, n: number, ownRole: string): { zone: string; rowKey: string } => {
    const doc = dom.documents[d];
    let zone = "Other";
    let rowKey = "";
    if (ROW_ROLES.has(ownRole)) { zone = "Row"; rowKey = `${d}:${n}`; }
    let cur = n;
    for (let up = 0; up < 40 && cur >= 0; up++) {
      const tag = S(doc.nodes.nodeName[cur]).toLowerCase();
      const role = attrOf(d, cur, "role").toLowerCase();
      if (MODAL_ROLES.has(role) || tag === "dialog" || attrOf(d, cur, "aria-modal") === "true") return { zone: "Modal", rowKey };
      if (zone !== "Row" && (ROW_ROLES.has(role) || tag === "tr")) { zone = "Row"; rowKey = `${d}:${cur}`; }
      else if (zone === "Other" && (TOOLBAR_ROLES.has(role) || tag === "header" || tag === "nav")) zone = "Toolbar";
      cur = doc.nodes.parentIndex[cur];
    }
    return { zone, rowKey };
  };

  const THREAD_ATTRS = ["data-thread-id", "data-legacy-thread-id", "data-message-id", "data-row-id", "data-item-id", "data-id", "data-key"];
  const threadIdOf = (d: number, n: number): string => {
    const doc = dom.documents[d];
    let cur = n;
    for (let up = 0; up < 14 && cur >= 0; up++) {
      for (const a of THREAD_ATTRS) { const v = attrOf(d, cur, a); if (v) return v; }
      cur = doc.nodes.parentIndex[cur];
    }
    return "";
  };
  const axProp = (node: Json, name: string): any => (node.properties ?? []).find((p: Json) => p.name === name)?.value?.value;
  const elements: Json[] = [];
  const refs = new Map<string, Ref>();
  const rowIndex = new Map<string, number>();
  let candidates = 0, visible = 0;
  for (const node of ax.nodes as Json[]) {
    if (node.ignored || node.backendDOMNodeId === undefined) continue;
    const role = String(node.role?.value ?? "").toLowerCase();
    const name = String(node.name?.value ?? "").trim();
    if (!INTERACTIVE.has(role) && !(role === "generic" && false)) continue;
    candidates++;
    const loc = byBackend.get(node.backendDOMNodeId);
    if (!loc) continue;
    const b = boundsOf.get(`${loc.d}:${loc.n}`);
    if (!b || b[2] < 2 || b[3] < 2) continue;
    if (b[0] + b[2] < 0 || b[1] + b[3] < 0 || b[0] > vv.clientWidth + 4000 || b[1] > vv.clientHeight + 20000) continue;
    const { zone, rowKey } = zoneOf(loc.d, loc.n, role);
    if (role === "row" && !name && zone === "Row") { /* keep: rows are click targets */ }
    visible++;
    if (elements.length >= maxElements) continue;
    const n = elements.length + 1;
    const ref_id = `@${epoch}:c${n}`;
    const rect: [number, number, number, number] = [Math.round(b[0]), Math.round(b[1]), Math.round(b[2]), Math.round(b[3])];
    let row = 0;
    if (rowKey) { if (!rowIndex.has(rowKey)) rowIndex.set(rowKey, rowIndex.size + 1); row = rowIndex.get(rowKey)!; }
    const inViewport = b[0] < vv.clientWidth && b[1] < vv.clientHeight && b[0] + b[2] > 0 && b[1] + b[3] > 0;
    const states: string[] = [];
    if (axProp(node, "checked") === "true" || axProp(node, "checked") === true) states.push("checked");
    if (axProp(node, "disabled")) states.push("disabled");
    if (axProp(node, "focused")) states.push("focused");
    if (!inViewport) states.push("offscreen");
    const value = node.value?.value !== undefined ? String(node.value.value) : "";
    const thread_id = zone === "Row" ? threadIdOf(loc.d, loc.n) : "";
    elements.push({
      ref_id, role, name: name.slice(0, 160), value: value.slice(0, 200), rect, zone, row, ...(thread_id ? { thread_id } : {}),
      stable_key: fnv(`${role}|${name}|${attrOf(loc.d, loc.n, "id")}|${zone}|${rowKey ? "row" : ""}`),
      states, patterns: role === "textbox" || role === "searchbox" || role === "combobox" ? ["val"] : ["inv"],
    });
    refs.set(ref_id, { backendNodeId: node.backendDOMNodeId, name, role, rect, session });
  }
  const t2 = performance.now();
  return {
    elements, refs,
    stats: {
      ax_nodes: ax.nodes.length, dom_nodes: dom.documents.reduce((a: number, d: Json) => a + d.nodes.backendNodeId.length, 0),
      candidates, visible, rows: rowIndex.size, ax_dom_ms: Math.round(t1 - t0), fusion_ms: Math.round(t2 - t1),
    },
  };
}
'@
