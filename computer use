"""OpenTelemetry OTLP/HTTP-JSON span recorder (stdlib only).  Planes: capture / uia / vision / network / input / cdp.
P50/P99 per plane; `flush()` POSTs to OTEL_EXPORTER_OTLP_ENDPOINT (e.g. http://127.0.0.1:4318/v1/traces) or writes a file."""
from __future__ import annotations

import json
import os
import secrets
import time
import urllib.request
from contextlib import contextmanager
from dataclasses import dataclass, field

PLANES = ("capture", "uia", "vision", "network", "input", "cdp")


def _pct(xs: list[float], p: float) -> float:
    if not xs:
        return 0.0
    s = sorted(xs)
    return round(s[int(round((len(s) - 1) * p))], 2)


@dataclass
class Tracer:
    service: str = "dscu-agent-brain"
    trace_id: str = field(default_factory=lambda: secrets.token_hex(16))
    spans: list[dict] = field(default_factory=list)

    @contextmanager
    def span(self, plane: str, name: str = "", **attrs):
        t0, w0 = time.perf_counter(), time.time_ns()
        try:
            yield
        finally:
            self.add(plane, (time.perf_counter() - t0) * 1000.0, name or plane, w0, attrs)

    def add(self, plane: str, ms: float, name: str = "", start_ns: int | None = None, attrs: dict | None = None) -> None:
        s = start_ns or time.time_ns()
        self.spans.append({"traceId": self.trace_id, "spanId": secrets.token_hex(8), "name": name or plane, "kind": 1,
                           "startTimeUnixNano": str(s), "endTimeUnixNano": str(s + int(ms * 1e6)),
                           "attributes": [{"key": "dscu.plane", "value": {"stringValue": plane}}] +
                                         [{"key": k, "value": {"stringValue": str(v)}} for k, v in (attrs or {}).items()],
                           "_ms": ms, "_plane": plane})

    def stats(self) -> dict:
        out = {}
        for pl in PLANES:
            xs = [s["_ms"] for s in self.spans if s["_plane"] == pl]
            if xs:
                out[pl] = {"p50": _pct(xs, 0.5), "p99": _pct(xs, 0.99), "n": len(xs)}
        return out

    def to_otlp(self) -> dict:
        clean = [{k: v for k, v in s.items() if not k.startswith("_")} for s in self.spans]
        return {"resourceSpans": [{"resource": {"attributes": [{"key": "service.name", "value": {"stringValue": self.service}}]},
                                   "scopeSpans": [{"scope": {"name": "dscu.v12"}, "spans": clean}]}]}

    def flush(self, path: str = "") -> str:
        body = json.dumps(self.to_otlp()).encode()
        ep = os.environ.get("OTEL_EXPORTER_OTLP_ENDPOINT", "")
        if ep and not path:
            req = urllib.request.Request(ep.rstrip("/") + ("" if ep.endswith("/v1/traces") else "/v1/traces"), body, {"Content-Type": "application/json"})
            try:
                urllib.request.urlopen(req, timeout=3).read()
                return ep
            except Exception:
                pass
        path = path or os.path.join(os.environ.get("TEMP", "/tmp"), f"dscu-otlp-{int(time.time())}.json")
        with open(path, "wb") as f:
            f.write(body)
        return path
