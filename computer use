        self.events.clear()
        self.pending_note = ""
        self.terminate = None
        self.stats.clear()

    # ------------------------------------------------------------------------------------------ classification
    @staticmethod
    def classify(res: ActionResult) -> str:
        msg = res.message or ""
        if res.code == Code.OCCLUDED or "[OCCLUDED]" in msg:
            return "occluded"
        if res.code == Code.SECURITY_DENIED or "[SECURITY_DENIED]" in msg:
            return "security"
        if CONN_RX.search(msg) and res.code in (Code.INTERNAL, Code.TIMEOUT, Code.UNSUPPORTED):
            return "cdp"
        return "other"

    def total(self) -> int:
        return sum(self.stats.values())

    def trace(self) -> list[dict[str, Any]]:
        return [e.as_dict() for e in self.events]

    def _ev(self, step: int, kind: str, action: str, detail: str, recovered: Optional[bool] = None) -> None:
        self.events.append(RecoveryEvent(time.time(), step, kind, action, detail, recovered))

