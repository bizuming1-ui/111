//! Win32 backing for the ring: CreateFileMappingW / MapViewOfFile + named auto-reset event (frame-ready) + named mutex (single producer).
use crate::ring::{region_size, RingErr, RingView};
use std::ffi::c_void;
use windows::core::PCWSTR;
use windows::Win32::Foundation::{CloseHandle, HANDLE, INVALID_HANDLE_VALUE, WAIT_OBJECT_0};
use windows::Win32::System::Memory::{CreateFileMappingW, MapViewOfFile, OpenFileMappingW, UnmapViewOfFile, FILE_MAP_ALL_ACCESS, MEMORY_MAPPED_VIEW_ADDRESS, PAGE_READWRITE};
use windows::Win32::System::Threading::{CreateEventW, CreateMutexW, SetEvent, WaitForSingleObject};

fn wide(s: &str) -> Vec<u16> { s.encode_utf16().chain(std::iter::once(0)).collect() }

pub struct Mapping { h: HANDLE, view: *mut u8, len: usize }
unsafe impl Send for Mapping {}
unsafe impl Sync for Mapping {}
impl Drop for Mapping {
    fn drop(&mut self) {
        unsafe {
            let _ = UnmapViewOfFile(MEMORY_MAPPED_VIEW_ADDRESS { Value: self.view as *mut c_void });
            let _ = CloseHandle(self.h);
        }
    }
}

pub struct ProducerRing { pub map: Mapping, pub ring: RingView, event: HANDLE, mutex: HANDLE }
unsafe impl Send for ProducerRing {}
impl ProducerRing {
    /// Names: `Local\dscu-ring-v2-<name>` (mapping), `...-evt` (event), `...-mtx` (mutex; second producer fails fast).
    pub fn create(name: &str, slots: u32, slot_size: u32) -> Result<ProducerRing, String> {
        let len = region_size(slots, slot_size);
        unsafe {
            let mtx = CreateMutexW(None, true, PCWSTR(wide(&format!("Local\\dscu-ring-v2-{name}-mtx")).as_ptr())).map_err(|e| format!("mutex: {e}"))?;
            if windows::Win32::Foundation::GetLastError() == windows::Win32::Foundation::ERROR_ALREADY_EXISTS {
                let _ = CloseHandle(mtx);
                return Err("ring already has a producer".into());
            }
            let h = CreateFileMappingW(INVALID_HANDLE_VALUE, None, PAGE_READWRITE, (len as u64 >> 32) as u32, len as u32, PCWSTR(wide(&format!("Local\\dscu-ring-v2-{name}")).as_ptr()))
                .map_err(|e| format!("CreateFileMapping: {e}"))?;
            let v = MapViewOfFile(h, FILE_MAP_ALL_ACCESS, 0, 0, len);
            if v.Value.is_null() { let _ = CloseHandle(h); return Err("MapViewOfFile failed".into()); }
            let ev = CreateEventW(None, false, false, PCWSTR(wide(&format!("Local\\dscu-ring-v2-{name}-evt")).as_ptr())).map_err(|e| format!("event: {e}"))?;
            let ring = RingView::init(v.Value as *mut u8, slots, slot_size, std::process::id()).map_err(|e| format!("{e:?}"))?;
            Ok(ProducerRing { map: Mapping { h, view: v.Value as *mut u8, len }, ring, event: ev, mutex: mtx })
        }
    }
    pub fn signal(&self) { unsafe { let _ = SetEvent(self.event); } }
    pub fn len(&self) -> usize { self.map.len }
}
impl Drop for ProducerRing {
    fn drop(&mut self) { unsafe { let _ = CloseHandle(self.event); let _ = CloseHandle(self.mutex); } }
}

pub struct ConsumerRing { pub map: Mapping, pub ring: RingView, event: HANDLE }
unsafe impl Send for ConsumerRing {}
impl ConsumerRing {
    pub fn open(name: &str, len: usize) -> Result<ConsumerRing, String> {
        unsafe {
            let h = OpenFileMappingW(FILE_MAP_ALL_ACCESS.0, false, PCWSTR(wide(&format!("Local\\dscu-ring-v2-{name}")).as_ptr())).map_err(|e| format!("OpenFileMapping: {e}"))?;
            let v = MapViewOfFile(h, FILE_MAP_ALL_ACCESS, 0, 0, len);
            if v.Value.is_null() { let _ = CloseHandle(h); return Err("MapViewOfFile failed".into()); }
            let ring = RingView::attach(v.Value as *mut u8, len).map_err(|e: RingErr| format!("{e:?}"))?;
            let ev = CreateEventW(None, false, false, PCWSTR(wide(&format!("Local\\dscu-ring-v2-{name}-evt")).as_ptr())).map_err(|e| format!("event: {e}"))?;
            Ok(ConsumerRing { map: Mapping { h, view: v.Value as *mut u8, len }, ring, event: ev })
        }
    }
    /// Event-driven wait for the next frame (no polling sleep). Returns false on timeout.
    pub fn wait_frame(&self, ms: u32) -> bool { unsafe { WaitForSingleObject(self.event, ms) == WAIT_OBJECT_0 } }
}
impl Drop for ConsumerRing {
    fn drop(&mut self) { unsafe { let _ = CloseHandle(self.event); } }
}
