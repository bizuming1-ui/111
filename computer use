@@@FILE@@@ scripts/up_v12.ps1
#Requires -Version 7.0
<# v12 one-shot: Python tests -> golden regression -> (cargo test/bench/fuzz if installed) -> cdp-daemon tests -> vision-engine (cmake) -> then the v11 up.ps1 #>
param([switch]$SkipTests, [switch]$Fuzz, [int]$FuzzRuns = 1000000)
$ErrorActionPreference = 'Continue'; $root = Split-Path -Parent $PSScriptRoot; Push-Location $root
function Step($m) { Write-Host "`n== $m" -ForegroundColor Cyan }
try {
    $py = @('python3', 'python', 'py' | Where-Object { Get-Command $_ -ErrorAction SilentlyContinue })[0]
