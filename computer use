def clean_chrome_argv(exe: str, port: int, profile: str, extra: Optional[list[str]] = None) -> list[str]:
    """Native Chrome launch line.  `--enable-automation` is NEVER passed (it sets navigator.webdriver=true and Google answers signin/rejected)."""
    argv = [exe, f"--remote-debugging-port={port}", f"--user-data-dir={profile}", "--no-first-run", "--no-default-browser-check", "--disable-blink-features=AutomationControlled"]
    for x in extra or []:
        if x and not x.startswith("--enable-automation") and x not in argv:
            argv.append(x)
    return argv


def _http_json(url: str, timeout: float = 1.0) -> Optional[dict[str, Any]]:
    try:
        import urllib.request

        op = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # loopback must bypass the system proxy (v2rayN etc.)
        with op.open(url, timeout=timeout) as r:
            v = json.loads(r.read().decode("utf-8", "replace"))
            return v if isinstance(v, dict) else None
    except Exception:  # noqa: BLE001
        return None


def probe_debug_endpoint(port: int, host: str = "127.0.0.1", timeout: float = 1.0) -> Optional[dict[str, Any]]:
    return _http_json(f"http://{host}:{int(port)}/json/version", timeout)


def _psutil() -> Any:
    try:
        import psutil

        return psutil
    except Exception:  # noqa: BLE001
        return None


def pid_alive(pid: int) -> bool:
    ps = _psutil()
    if not ps or not pid:
        return False
    try:
        return bool(ps.pid_exists(int(pid))) and ps.Process(int(pid)).status() != ps.STATUS_ZOMBIE
    except Exception:  # noqa: BLE001
        return False


def proc_name(pid: int) -> str:
    ps = _psutil()
    try:
        return str(ps.Process(int(pid)).name()).lower() if ps and pid else ""
    except Exception:  # noqa: BLE001
        return ""


def root_browser_pid(pid: int) -> int:
    """Walk up while the parent runs the same executable -> the browser (GUI) main process."""
    ps = _psutil()
    if not ps or not pid:
        return pid
    try:
        p = ps.Process(int(pid))
        name = p.name().lower()
        if name not in BROWSER_EXES:
            return int(pid)
        while True:
            par = p.parent()
            if par is None or par.name().lower() != name:
                break
            p = par
        return int(p.pid)
    except Exception:  # noqa: BLE001
        return pid


def find_browser_pid_by_port(port: int) -> int:
    """Who listens on the DevTools port?  (1) LISTEN socket owner  (2) a browser main process whose command line carries --remote-debugging-port=<port>."""
    ps = _psutil()
    if not ps or not port:
        return 0
    try:
        for c in ps.net_connections(kind="tcp"):
            if c.status == "LISTEN" and c.laddr and int(c.laddr.port) == int(port) and c.pid:
                return root_browser_pid(int(c.pid))
    except Exception:  # noqa: BLE001
        pass
    try:
        for p in ps.process_iter(["name", "cmdline"]):
            nm, cl = str(p.info.get("name") or "").lower(), p.info.get("cmdline") or []
            if nm in BROWSER_EXES and f"--remote-debugging-port={port}" in cl and not any(str(a).startswith("--type=") for a in cl):
                return int(p.pid)
    except Exception:  # noqa: BLE001
        pass
    return 0


def process_tree_pids(pid: int) -> list[int]:
    ps = _psutil()
    if not ps or not pid:
        return []
    try:
        p = ps.Process(int(pid))
        return [int(pid), *[int(c.pid) for c in p.children(recursive=True)]]
    except Exception:  # noqa: BLE001
        return []


def pids_by_exe(exe: str) -> list[int]:
    ps = _psutil()
    out: list[int] = []
    if not ps or not exe:
        return out
    want = exe.lower()
    try:
        for p in ps.process_iter(["name"]):
            if str(p.info.get("name") or "").lower() == want:
                out.append(int(p.pid))
    except Exception:  # noqa: BLE001
        pass
    return out


def _channel_user_data_dir(channel: str = "") -> Path:
    sub = {"stable": r"Google\Chrome", "beta": r"Google\Chrome Beta", "dev": r"Google\Chrome Dev", "canary": r"Google\Chrome SxS"}.get((channel or "stable").lower(), r"Google\Chrome")
    return Path(os.environ.get("LOCALAPPDATA") or "") / sub / "User Data"


def read_devtools_active_port(channel: str = "") -> Optional[tuple[int, str]]:
