"""Five-layer execution router with per-layer circuit breakers (supersedes layers.choose_layer).

L0 CLI-Anything + Native Safe File  ->  L1 TS CDP daemon  ->  L2 Rust UIA/JAB headless @ref
-> L3 Rust DXGI (<5 ms) [+ optional 780M DirectML sidecar]  ->  L4 deepseek-flash SoM (fuse-gated).
A layer whose breaker is open is skipped; the router degrades downwards, never loops.
"""
from __future__ import annotations

import re
import time
from dataclasses import dataclass, field

from .native_files import SaveTextIntent, parse_save_text_intent
from .state_machine import is_self_drawn

BROWSER = re.compile(r"(chrome|edge|brave|gmail|网页|浏览器|https?://|\.com\b|\.cn\b|抖音|b站|bilibili|youtube|google|邮箱|邮件)", re.I)
CANVAS = re.compile(r"(游戏|画布|canvas|webgl|验证码|远程桌面)", re.I)
LAYER_NAMES = {0: "L0 CLI-Anything/Native-File", 1: "L1 TS-CDP", 2: "L2 Rust-UIA/JAB", 3: "L3 Rust-DXGI", 4: "L4 deepseek-flash-SoM"}


@dataclass
class Breaker:
    threshold: int = 3
    cooldown_s: float = 30.0
    fails: int = 0
    opened_at: float = 0.0

    def ok(self) -> None:
        self.fails = 0; self.opened_at = 0.0

    def fail(self) -> None:
        self.fails += 1
        if self.fails >= self.threshold:
            self.opened_at = time.monotonic()

    @property
    def open(self) -> bool:
        if not self.opened_at:
            return False
        if time.monotonic() - self.opened_at > self.cooldown_s:
            self.fails = self.threshold - 1; self.opened_at = 0.0       # half-open: one probe allowed
            return False
        return True


@dataclass
class Decision:
    layer: int
    name: str
    reason: str
    intent: SaveTextIntent | None = None
    tool: str | None = None


@dataclass
class Router:
    cli_tool_for: "callable | None" = None            # task -> tool name | None (CliRouter.route adapter)
    cdp_up: bool = False
    uia_up: bool = False
    dxgi_up: bool = False
    breakers: dict[int, Breaker] = field(default_factory=lambda: {i: Breaker() for i in range(5)})

    def mark(self, layer: int, ok: bool) -> None:
        (self.breakers[layer].ok if ok else self.breakers[layer].fail)()

    def _avail(self, layer: int) -> bool:
        return not self.breakers[layer].open

    def route(self, task: str, *, process: str = "", uia_controls: int | None = None, stalled: bool = False,
              blocked: int = 0) -> Decision:
        intent = parse_save_text_intent(task)
        if intent and self._avail(0):
            return Decision(0, LAYER_NAMES[0], "pure file task: deterministic save_text + read-back verify", intent=intent)
        tool = self.cli_tool_for(task) if self.cli_tool_for else None
        if tool and self._avail(0):
            return Decision(0, LAYER_NAMES[0], f"task names an app with native CLI: {tool}", tool=tool)
        if BROWSER.search(task) and self.cdp_up and blocked < 3 and self._avail(1):
            return Decision(1, LAYER_NAMES[1], "browser task, CDP daemon healthy")
        if CANVAS.search(task) or is_self_drawn(process, uia_controls) or stalled or blocked >= 2:
            if self.dxgi_up and self._avail(3) and not (stalled or blocked >= 2):
                return Decision(3, LAYER_NAMES[3], "UIA blind / self-drawn: DXGI frame + crop")
            return Decision(4, LAYER_NAMES[4], f"visual grounding (stalled={stalled}, blocked={blocked})")
        if self.uia_up and self._avail(2):
            return Decision(2, LAYER_NAMES[2], "native UIA/JAB with @snapshot:ref")
        return Decision(4, LAYER_NAMES[4], "no structured channel healthy")
