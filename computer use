// Heavy pixel data NEVER travels here: frames live in the shared-memory ring (see ring_layout.h); only {ring, seq, rect, ahash} metadata does.
syntax = "proto3";
package dscu.v1;

message Envelope {
  uint32 v = 1;                 // must be 1
  int64  id = 2;
  string method = 3;            // ^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$
  bytes  params_json = 4;       // UTF-8 JSON (kept JSON for forward compatibility with the NDJSON dialect)
  uint64 action_id = 5;         // idempotency key, strictly increasing per session
  uint64 expect_hwnd = 6;       // optimistic lock: foreground HWND
  string expect_fp = 7;         // optimistic lock: 16-hex aHash of the target region (Hamming > 10 => IPC_STALE_REGION)
  string auth = 8;
}
message Error { sint32 code = 1; string kind = 2; string message = 3; bytes data_json = 4; }
message Response { uint32 v = 1; int64 id = 2; bytes result_json = 3; Error error = 4; }

// Metadata that replaces Base64 frames. `ring` names Local\dscu-ring-v2-<ring>; consumer reads slot (seq % slots) under the seqlock.
message FrameRef {
  string ring = 1; uint64 seq = 2; uint32 slot = 3;
  sint32 x = 4; sint32 y = 5; sint32 w = 6; sint32 h = 7;       // ABSOLUTE PHYSICAL px (Per-Monitor DPI v2, may be negative)
  uint32 format = 8;            // 1=BGRA8 2=GRAY8 3=SIG48x32
  uint32 kind = 9;              // 1=full 2=dirty-rect crop 3=signature
  uint64 ahash = 10; uint64 ts_us = 11;
  repeated Rect dirty = 12;
}
message Rect { sint32 x = 1; sint32 y = 2; sint32 w = 3; sint32 h = 4; }

// Domain taint signal pushed by the CDP bridge (Plane 3) to the control plane.
message TaintSignal { string tab = 1; string origin = 2; string level = 3; string reason = 4; uint64 ts_ms = 5; }
#=#=# FILE: proto/ring_layout.h
/* Shared-memory frame ring v2 — single source of truth for C / C++ / CUDA hosts. Mirrors dscu-v9/src/ring.rs and DsV9Ring (C#). */
#ifndef DSCU_RING_LAYOUT_H
#define DSCU_RING_LAYOUT_H
#include <stdint.h>
#define DSR_MAGIC 0x32525344u /* 'D' 'S' 'R' '2' little-endian */
#define DSR_VERSION 2u
#define DSR_HDR 64
#define DSR_SLOT_HDR 64
#pragma pack(push, 1)
typedef struct DsrHeader {
  uint32_t magic, version, slot_count, slot_size;   /* 0..15  slot_count power of two (2..64), slot_size multiple of 8 */
  volatile uint64_t write_seq;                      /* 16     last committed frame number (starts at 1) */
  volatile uint64_t ack_seq;                        /* 24     highest sequence acknowledged by any consumer */
  uint32_t producer_pid, flags;                     /* 32..39 flags bit0 = producer alive */
  uint8_t reserved[24];
} DsrHeader;
typedef struct DsrSlotHeader {
  volatile uint64_t seq;                            /* 0   (n<<1)|1 while being written, n<<1 when committed (seqlock) */
  uint32_t width, height, stride, format, payload_len, kind; /* 8..31  format 1=BGRA8 2=GRAY8 3=SIG48x32; kind 1=full 2=dirty 3=sig */
  int32_t x, y, w, h;                               /* 32..47 absolute physical px */
  uint64_t ahash, ts_us;                            /* 48..63 */
} DsrSlotHeader;
#pragma pack(pop)
/* slot i lives at DSR_HDR + i*(DSR_SLOT_HDR+slot_size); payload follows its header. Consumer: n=write_seq; s1=slot.seq; require s1==n<<1; copy; fence; require slot.seq==s1. */
#endif
#=#=# FILE: schema/ring-v2.json
{
  "schema": "dscu.ring/2",
  "magic": "0x32525344",
  "version": 2,
  "header": { "size": 64, "fields": { "magic": 0, "version": 4, "slot_count": 8, "slot_size": 12, "write_seq": 16, "ack_seq": 24, "producer_pid": 32, "flags": 36 } },
  "slot": { "header_size": 64, "fields": { "seq": 0, "width": 8, "height": 12, "stride": 16, "format": 20, "payload_len": 24, "kind": 28, "x": 32, "y": 36, "w": 40, "h": 44, "ahash": 48, "ts_us": 56 } },
  "names": { "mapping": "Local\\dscu-ring-v2-<name>", "event": "Local\\dscu-ring-v2-<name>-evt", "mutex": "Local\\dscu-ring-v2-<name>-mtx" },
  "formats": { "BGRA8": 1, "GRAY8": 2, "SIG48X32": 3 },
  "kinds": { "full": 1, "dirty": 2, "signature": 3 },
  "protocol": "seqlock: writer sets slot.seq=(n<<1)|1, writes, sets slot.seq=n<<1, then header.write_seq=n; reader requires slot.seq==n<<1 before AND after the copy"
}
