#!/usr/bin/env python3
"""dscu sidecar-dml: optional local vision helper on the AMD Radeon 780M (ONNX Runtime + DirectML). NO CUDA, ever.

Contract (matches the driver / client budget):
  * memory quota  : hard cap --mem-cap-mb (default 3072 = the "< 3 GB" budget). Over the cap -> model unloaded, HTTP 503.
  * idle unload   : model session dropped after --idle-ttl seconds without a request (default 180 = SidecarIdleTtlSec).
  * UMA floor     : refuses to load when available RAM < --mem-floor-mb (default 4096 = MemoryFloorMB).
  * localhost only, bearer token (DSCU_SIDECAR_TOKEN or --token-file); Authorization is never logged.
Endpoints: GET /health | POST /v1/detect | POST /v1/ocr_preannotate | POST /v1/unload
Run `python server.py --selftest` to verify quota / TTL / provider policy without onnxruntime installed.
"""
import argparse, base64, hmac, io, json, os, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

FORBIDDEN_PROVIDERS = ("CUDAExecutionProvider", "TensorrtExecutionProvider")


def avail_mb() -> int:
    try:
        if os.name == "nt":
            import ctypes

            class MS(ctypes.Structure):
                _fields_ = [("l", ctypes.c_ulong), ("ml", ctypes.c_ulong), ("tp", ctypes.c_ulonglong), ("ap", ctypes.c_ulonglong),
                            ("tpf", ctypes.c_ulonglong), ("apf", ctypes.c_ulonglong), ("tv", ctypes.c_ulonglong), ("av", ctypes.c_ulonglong),
                            ("ae", ctypes.c_ulonglong)]
            m = MS(); m.l = ctypes.sizeof(MS)
            ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(m))
            return int(m.ap // (1024 * 1024))
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemAvailable:"):
                    return int(line.split()[1]) // 1024
    except Exception:
        pass
    return 1 << 30


def rss_mb() -> int:
    try:
        if os.name == "nt":
            import ctypes
            from ctypes import wintypes

            class PMC(ctypes.Structure):
                _fields_ = [("cb", wintypes.DWORD), ("pf", wintypes.DWORD), ("peak", ctypes.c_size_t), ("ws", ctypes.c_size_t),
                            ("a", ctypes.c_size_t), ("b", ctypes.c_size_t), ("c", ctypes.c_size_t), ("d", ctypes.c_size_t),
                            ("pagefile", ctypes.c_size_t), ("peakpagefile", ctypes.c_size_t)]
            p = PMC(); p.cb = ctypes.sizeof(PMC)
            ctypes.windll.psapi.GetProcessMemoryInfo(ctypes.windll.kernel32.GetCurrentProcess(), ctypes.byref(p), p.cb)
            return int(p.ws // (1024 * 1024))
        with open("/proc/self/statm") as f:
            return int(f.read().split()[1]) * (os.sysconf("SC_PAGE_SIZE") // 1024) // 1024
    except Exception:
        return 0


def pick_providers(available):
    """DirectML first, CPU fallback; CUDA/TensorRT are never selected even if present."""
    out = [p for p in ("DmlExecutionProvider", "CPUExecutionProvider") if p in available and p not in FORBIDDEN_PROVIDERS]
    return out or ["CPUExecutionProvider"]


class ModelHost:
    def __init__(self, model_path, mem_cap_mb, mem_floor_mb, idle_ttl, clock=time.monotonic, loader=None, avail=avail_mb, rss=rss_mb):
        self.path, self.cap, self.floor, self.ttl = model_path, mem_cap_mb, mem_floor_mb, idle_ttl
        self.clock, self._loader, self._avail, self._rss = clock, loader or self._ort_load, avail, rss
        self.session, self.last = None, clock()
        self.lock = threading.Lock()
        self.loads = self.unloads = 0

    @staticmethod
    def _ort_load(path):
        import onnxruntime as ort  # lazy: the sidecar is optional
        so = ort.SessionOptions()
        so.enable_mem_pattern = False          # required by the DirectML provider
        so.execution_mode = ort.ExecutionMode.ORT_SEQUENTIAL
        so.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL
        provs = pick_providers(ort.get_available_providers())
        assert not any(p in FORBIDDEN_PROVIDERS for p in provs)
        return ort.InferenceSession(path, so, providers=provs)

    def ensure(self):
        with self.lock:
            if self.session is None:
                if self._avail() < self.floor:
                    raise MemoryError(f"available RAM < MemoryFloorMB={self.floor}: sidecar refuses to load (cloud-only degrade)")
                if not self.path or not os.path.exists(self.path):
                    raise FileNotFoundError("model not installed (pass --detect-model <quantized .onnx>)")
                self.session = self._loader(self.path)
                self.loads += 1
            self.last = self.clock()
            return self.session

    def after_request(self):
        if self.session is not None and self._rss() > self.cap:
            self.unload("rss over quota")
            raise MemoryError(f"process RSS exceeded --mem-cap-mb={self.cap}; model unloaded")

    def unload(self, why=""):
        with self.lock:
            if self.session is not None:
                self.session = None
                self.unloads += 1
                import gc; gc.collect()
                return True
            return False

    def tick(self):
        if self.session is not None and (self.clock() - self.last) >= self.ttl:
            return self.unload("idle ttl")
        return False


def nms(boxes, scores, iou=0.5):
    order = sorted(range(len(boxes)), key=lambda i: -scores[i])
    keep = []
    while order:
        i = order.pop(0)
        keep.append(i)
        rest = []
        for j in order:
            ax1, ay1, ax2, ay2 = boxes[i]; bx1, by1, bx2, by2 = boxes[j]
            iw = max(0, min(ax2, bx2) - max(ax1, bx1)); ih = max(0, min(ay2, by2) - max(ay1, by1))
            inter = iw * ih
            union = (ax2 - ax1) * (ay2 - ay1) + (bx2 - bx1) * (by2 - by1) - inter
            if union <= 0 or inter / union < iou:
                rest.append(j)
        order = rest
    return keep


def detect(host, img_bytes, threshold):
    import numpy as np
    from PIL import Image
    sess = host.ensure()
    im = Image.open(io.BytesIO(img_bytes)).convert("RGB")
    w0, h0 = im.size
    inp = sess.get_inputs()[0]
    sz = 640
    shape = [d if isinstance(d, int) else sz for d in inp.shape]
    th, tw = shape[2], shape[3]
    arr = np.asarray(im.resize((tw, th)), dtype=np.float32).transpose(2, 0, 1)[None] / 255.0
    out = sess.run(None, {inp.name: arr})[0]
    out = out[0].T if out.shape[1] < out.shape[2] else out[0]       # YOLO-style (N, 4+C)
    boxes, scores = [], []
    for row in out:
        s = float(row[4:].max())
        if s >= threshold:
            cx, cy, bw, bh = row[:4]
            boxes.append([(cx - bw / 2) * w0 / tw, (cy - bh / 2) * h0 / th, (cx + bw / 2) * w0 / tw, (cy + bh / 2) * h0 / th]); scores.append(s)
    keep = nms(boxes, scores)
    host.after_request()
    return [{"box": [round(v, 1) for v in boxes[i]], "score": round(scores[i], 3)} for i in keep][:200]


def make_handler(host, token):
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):  # never log request lines (no secrets / images in logs)
            pass

        def _send(self, code, obj):
            b = json.dumps(obj).encode()
            self.send_response(code); self.send_header("Content-Type", "application/json"); self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)

        def _auth(self):
            if not token:
                return True
            return hmac.compare_digest(self.headers.get("Authorization", ""), "Bearer " + token)

        def do_GET(self):
            if self.path == "/health":
                return self._send(200, {"ok": True, "loaded": host.session is not None, "rss_mb": rss_mb(), "mem_cap_mb": host.cap, "idle_ttl": host.ttl, "loads": host.loads, "unloads": host.unloads})
            self._send(404, {"error": "not found"})

        def do_POST(self):
            if not self._auth():
                return self._send(401, {"error": "unauthorized"})
            n = int(self.headers.get("Content-Length", "0"))
            if n > 32 * 1024 * 1024:
                return self._send(413, {"error": "too large"})
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
                if self.path == "/v1/unload":
                    return self._send(200, {"unloaded": host.unload()})
                if self.path in ("/v1/detect", "/v1/ocr_preannotate"):
                    img = base64.b64decode(body["image_b64"])
                    return self._send(200, {"detections": detect(host, img, float(body.get("threshold", 0.35)))})
                self._send(404, {"error": "not found"})
            except MemoryError as e:
                self._send(503, {"error": str(e)})
            except FileNotFoundError as e:
                self._send(501, {"error": str(e)})
            except Exception as e:
                self._send(500, {"error": type(e).__name__})
    return H


def selftest():
    t = [0.0]
    fake = ModelHost("m.onnx", mem_cap_mb=3072, mem_floor_mb=4096, idle_ttl=180, clock=lambda: t[0], loader=lambda p: object(), avail=lambda: 16000, rss=lambda: 1000)
    os.path.exists = (lambda orig: (lambda p: True if p == "m.onnx" else orig(p)))(os.path.exists)
    assert pick_providers(["CUDAExecutionProvider", "DmlExecutionProvider", "CPUExecutionProvider"]) == ["DmlExecutionProvider", "CPUExecutionProvider"]
    assert pick_providers(["CUDAExecutionProvider"]) == ["CPUExecutionProvider"], "CUDA must never be selected"
    fake.ensure(); assert fake.session is not None and fake.loads == 1
    t[0] = 179; assert not fake.tick()
    t[0] = 181; assert fake.tick() and fake.session is None, "idle TTL 180s must unload"
    low = ModelHost("m.onnx", 3072, 4096, 180, clock=lambda: t[0], loader=lambda p: object(), avail=lambda: 3000)
    try:
        low.ensure(); raise SystemExit("floor not enforced")
    except MemoryError:
        pass
    big = ModelHost("m.onnx", 3072, 4096, 180, clock=lambda: t[0], loader=lambda p: object(), avail=lambda: 16000, rss=lambda: 4000)
    big.ensure()
    try:
        big.after_request(); raise SystemExit("quota not enforced")
    except MemoryError:
        assert big.session is None
    assert nms([[0, 0, 10, 10], [1, 1, 10, 10], [50, 50, 60, 60]], [0.9, 0.8, 0.7]) == [0, 2]
    print(json.dumps({"selftest": "ok", "checks": ["no-cuda", "idle-ttl-180", "uma-floor", "rss-quota", "nms"]}))


