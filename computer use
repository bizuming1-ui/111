// Client of the shared-memory frame ring v2 (layout: schema/ring-v2.json, dscu-v9/src/ring.rs). Zero Base64, zero JSON, zero pipe copy.
public sealed class DsV9Ring : IDisposable
{
    public const uint Magic = 0x32525344, Version = 2;
    public const int Hdr = 64, SlotHdr = 64;
    MemoryMappedFile _mmf;
    MemoryMappedViewAccessor _v;
    public uint Slots, SlotSize;
