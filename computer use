// Domain-level taint isolation (v12): text read from a page that carries injection signatures is TAINTED and may not flow into
// another registrable domain's input fields, navigations (exfiltration) or the shell.  Mirrors PowerShell Update-TaintState + HITL.
const MULTI_TLD = new Set(["co.uk", "com.cn", "edu.cn", "gov.cn", "org.cn", "net.cn", "com.hk", "co.jp", "com.au", "com.tw"]);
export const INJECTION_PATTERNS: RegExp[] = [
  /ignore (all )?(previous|prior|above) instructions/i, /忽略(之前|以上|所有).{0,6}(指令|提示)/, /you are now (a|an|in) /i, /system prompt/i,
  /invoke-expression|iex\s*\(/i, /powershell\s+-e(nc|ncodedcommand)/i, /(curl|wget)[^\n|]*\|\s*(sh|bash|iex)/i, /<\s*script[\s>]/i, /disregard (the )?(above|user)/i,
];

export function registrableDomain(host: string): string {
  const h = host.toLowerCase().replace(/^\[|\]$/g, "").split(":")[0];
  if (/^\d+\.\d+\.\d+\.\d+$/.test(h)) return h;
  const p = h.split(".");
  if (p.length <= 2) return h;
  const last2 = p.slice(-2).join(".");
  return MULTI_TLD.has(last2) ? p.slice(-3).join(".") : last2;
}
export function domainOf(url: string): string { try { return registrableDomain(new URL(url).hostname); } catch { return ""; } }

export type Sink = { kind: "type" | "navigate" | "download" | "powershell"; domain: string; text?: string; url?: string };
export type Verdict = { allow: boolean; code?: "TAINT_CROSS_DOMAIN" | "TAINT_EXFIL" | "TAINT_SHELL"; reason?: string };

export class TaintLedger {
  private tainted = new Map<string, string[]>();   // domain -> tainted text fragments (>=16 chars)
  findings = 0;

  record(domain: string, text: string): string[] {
    const hits = INJECTION_PATTERNS.filter((r) => r.test(text)).map((r) => r.source);
    if (hits.length) {
      this.findings += hits.length;
      const frags = this.tainted.get(domain) ?? [];
      for (const line of text.split(/\n+/)) if (line.trim().length >= 16 && INJECTION_PATTERNS.some((r) => r.test(line))) frags.push(line.trim().slice(0, 400));
      this.tainted.set(domain, frags);
    }
    return hits;
  }
  isTainted(domain: string): boolean { return this.tainted.has(domain); }
  reset(): void { this.tainted.clear(); this.findings = 0; }

  private overlaps(text: string, frags: string[]): boolean {
    const t = text.toLowerCase();
    return frags.some((f) => { const g = f.toLowerCase(); for (let i = 0; i + 16 <= g.length; i += 8) if (t.includes(g.slice(i, i + 16))) return true; return false; });
  }

  check(s: Sink): Verdict {
    if (this.tainted.size === 0) return { allow: true };
    let url = s.url ?? "";
    try { url = decodeURIComponent(url.replace(/\+/g, " ")); } catch { /* keep raw */ }
    const hay = `${s.text ?? ""}\n${url}`;
    for (const [dom, frags] of this.tainted) {
      if (!this.overlaps(hay, frags)) continue;
      if (s.kind === "powershell") return { allow: false, code: "TAINT_SHELL", reason: `text originating from tainted domain ${dom} must never reach the shell` };
      if (dom !== s.domain && s.kind === "navigate") return { allow: false, code: "TAINT_EXFIL", reason: `URL embeds data read from tainted domain ${dom}` };
      if (dom !== s.domain) return { allow: false, code: "TAINT_CROSS_DOMAIN", reason: `${s.kind} on ${s.domain} uses text read from tainted domain ${dom}` };
    }
    return { allow: true };
  }
}
