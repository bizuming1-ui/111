function Test-V10Artifact([string]$Path, [string]$Kind = '', [int]$MinBytes = 64) {
    # HARNESS.md：不盲信 exit 0。返回 @{ Ok; Kind; Size; Detail }
    $mk = { param($ok, $k, $sz, $d) [pscustomobject]@{ Ok = [bool]$ok; Kind = $k; Size = [int64]$sz; Detail = $d } }
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return (& $mk $false $Kind 0 '文件不存在') }
    $fi = [System.IO.FileInfo]::new($Path); $size = $fi.Length
    if (-not $Kind) { $Kind = switch ($fi.Extension.ToLower()) { '.pdf' { 'pdf' } { $_ -in '.docx', '.xlsx', '.pptx' } { 'ooxml' } { $_ -in '.zip', '.odt', '.ods' } { 'zip' } '.png' { 'png' } '.mp4' { 'mp4' } '.wav' { 'wav' } '.json' { 'json' } default { 'any' } } }
    if ($size -lt $MinBytes) { return (& $mk $false $Kind $size "大小 $size < $MinBytes") }
    $fs = [System.IO.File]::OpenRead($Path); $head = New-Object byte[] 16; [void]$fs.Read($head, 0, 16); $fs.Dispose()
    switch ($Kind) {
        'pdf' {
            $tailBytes = [System.IO.File]::ReadAllBytes($Path); $tail = [System.Text.Encoding]::ASCII.GetString($tailBytes, [Math]::Max(0, $tailBytes.Length - 2048), [Math]::Min(2048, $tailBytes.Length))
            $ok = ([System.Text.Encoding]::ASCII.GetString($head, 0, 5) -eq '%PDF-') -and $tail.Contains('%%EOF')
            return (& $mk $ok $Kind $size $(if ($ok) { '魔数 %PDF- + %%EOF' } else { 'PDF 魔数 / %%EOF 不符' }))
        }
        { $_ -in 'zip', 'ooxml' } {
            try {
                Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction SilentlyContinue
                $z = [System.IO.Compression.ZipFile]::OpenRead($Path); $names = @($z.Entries | ForEach-Object { $_.FullName })
                foreach ($e in $z.Entries) { $s = $e.Open(); $buf = New-Object byte[] 4096; while ($s.Read($buf, 0, 4096) -gt 0) { }; $s.Dispose() }   # 逐成员解压校验 CRC
                $z.Dispose()
                if ($Kind -eq 'ooxml' -and ($names -notcontains '[Content_Types].xml')) { return (& $mk $false $Kind $size '缺少 [Content_Types].xml') }
                return (& $mk $true $Kind $size "ZIP 结构完整（$($names.Count) 个成员）")
            }
            catch { return (& $mk $false $Kind $size "ZIP 损坏: $($_.Exception.Message)") }
        }
        'png' {
            $sig = ($head[0] -eq 0x89 -and $head[1] -eq 0x50 -and $head[2] -eq 0x4E -and $head[3] -eq 0x47)
            if (-not $sig) { return (& $mk $false $Kind $size 'PNG 魔数不符') }
            $ratio = -1.0
            try {
                Add-Type -AssemblyName System.Drawing -ErrorAction Stop
                $bmp = [System.Drawing.Bitmap]::new($Path); $nz = 0; $tot = 0
                for ($y = 0; $y -lt $bmp.Height; $y += [Math]::Max(1, [int]($bmp.Height / 32))) { for ($x = 0; $x -lt $bmp.Width; $x += [Math]::Max(1, [int]($bmp.Width / 32))) { $c = $bmp.GetPixel($x, $y); $tot++; if (($c.R + $c.G + $c.B) -gt 48) { $nz++ } } }
                $bmp.Dispose(); $ratio = $nz / [Math]::Max(1, $tot)
            }
            catch { $ratio = $(if ($size -gt 256) { 1.0 } else { 0.0 }) }   # 无 GDI+（非 Windows）：以体积熵代理
            return (& $mk ($ratio -gt 0.01) $Kind $size ("非黑屏像素 {0:P1}" -f $ratio))
        }
        'mp4' { $ok = ([System.Text.Encoding]::ASCII.GetString($head, 4, 4) -eq 'ftyp'); return (& $mk $ok $Kind $size $(if ($ok) { 'ftyp box' } else { '无 ftyp' })) }
        'wav' { $ok = ([System.Text.Encoding]::ASCII.GetString($head, 0, 4) -eq 'RIFF' -and [System.Text.Encoding]::ASCII.GetString($head, 8, 4) -eq 'WAVE'); return (& $mk $ok $Kind $size $(if ($ok) { 'RIFF/WAVE' } else { 'RIFF 不符' })) }
        'json' { try { [void](Get-Content -LiteralPath $Path -Raw -Encoding UTF8 | ConvertFrom-Json); return (& $mk $true $Kind $size '合法 JSON') } catch { return (& $mk $false $Kind $size "JSON 非法: $($_.Exception.Message)") } }
        default { return (& $mk $true $Kind $size '仅校验体积') }
    }
}
function Resolve-V10CliArgs($Tool, [string[]]$ArgList, [string]$JailRoot = '') {
    # Path Jail + TaintedContext + 元字符拒绝；返回「已解析路径」的参数数组
    $out = [System.Collections.Generic.List[string]]::new()
    $isNet = ($script:V10CliNetwork -contains "$($Tool.Name)") -or ($script:V10CliNetwork -contains [System.IO.Path]::GetFileNameWithoutExtension("$($Tool.Path)"))
    if ($isNet -and ($script:Taint.Tainted -or -not $script:V10AllowNetwork)) { $script:V10.CliBlocked++; throw (New-SecError 'SECURITY_TAINT_BLOCKED' "Layer 0 工具 $($Tool.Name) 具备联网能力；污点上下文 / 未授权外网下载被硬拦截。") }
    $prev = ''
    foreach ($raw in $ArgList) {
        $a = "$raw"
        if ($a -match '[;&|`$<>\r\n]') { $script:V10.CliBlocked++; throw (New-SecError 'SECURITY_EXEC_VIOLATION' "参数含 shell 元字符，已拒绝: $(Limit-Text $a 40)") }
        if ($a -match '^(?i)(https?|ftp)://' -and ($script:Taint.Tainted -or -not $script:V10AllowNetwork)) { $script:V10.CliBlocked++; throw (New-SecError 'SECURITY_TAINT_BLOCKED' "未授权外网 URL 被拒绝: $(Limit-Text $a 60)") }
        $isOutOpt = ($prev -match '^(?i)--?(out|output|o|outdir)$')
        $isInOpt = ($prev -match '^(?i)--?(in|input|i|file|dir|path|project)$')
        if ($a -match '^(?i)(--?(out|output|o|outdir|in|input|i|file|dir|path|project))=(.+)$') {
            $k = $Matches[1]; $v = $Matches[3]; $w = if ($k -match '^(?i)--?(out|output|o|outdir)$') { 'write' } else { 'read' }
            $full = if ($JailRoot) { (Test-SafePath -Path $v -Operation $w -Root $JailRoot) } else { $null }
            if ($JailRoot) { if (-not $full.Ok) { $script:V10.CliBlocked++; throw (New-SecError 'SECURITY_PATH_VIOLATION' "路径牢笼拒绝 $k=$v（$($full.Reason)）") }; $out.Add("$k=$($full.Path)") }
            else { $out.Add("$k=$(Assert-SafePath $v $w)") }
        }
        elseif ($isOutOpt -or $isInOpt -or ($a -notmatch '^-' -and $a -match '([\\/]|\.[A-Za-z0-9]{1,5}$)')) {
            $w = if ($isOutOpt) { 'write' } else { 'read' }
            if ($JailRoot) { $r = Test-SafePath -Path $a -Operation $w -Root $JailRoot; if (-not $r.Ok) { $script:V10.CliBlocked++; throw (New-SecError 'SECURITY_PATH_VIOLATION' "路径牢笼拒绝 $a（$($r.Reason)）") }; $out.Add($r.Path) }
            else { $out.Add((Assert-SafePath $a $w)) }
        }
        else { $out.Add($a) }
        $prev = $a
    }
    return @($out.ToArray())
}
function Invoke-V10Process([string]$Exe, [string[]]$ArgList, [string]$Cwd, [int]$TimeoutSec = 60) {
    $psi = [System.Diagnostics.ProcessStartInfo]::new()
    $ext = [System.IO.Path]::GetExtension($Exe).ToLower()
    $argv = [System.Collections.Generic.List[string]]::new()
    switch ($ext) {
        '.py' { $psi.FileName = $(if (Get-Command python3 -ErrorAction SilentlyContinue) { 'python3' } else { 'python' }); $argv.Add($Exe) }
        '.ps1' { $psi.FileName = 'pwsh'; $argv.Add('-NoProfile'); $argv.Add('-File'); $argv.Add($Exe) }
        { $_ -in '.cmd', '.bat' } { $psi.FileName = 'cmd.exe'; $argv.Add('/d'); $argv.Add('/c'); $argv.Add($Exe) }
        default { $psi.FileName = $Exe }
    }
    foreach ($x in $ArgList) { $argv.Add($x) }
    foreach ($x in $argv) { [void]$psi.ArgumentList.Add($x) }
    if ($Cwd) { $psi.WorkingDirectory = $Cwd }
    $psi.UseShellExecute = $false; $psi.CreateNoWindow = $true; $psi.RedirectStandardOutput = $true; $psi.RedirectStandardError = $true
    $psi.StandardOutputEncoding = [System.Text.Encoding]::UTF8; $psi.StandardErrorEncoding = [System.Text.Encoding]::UTF8
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $p = [System.Diagnostics.Process]::Start($psi)
    $so = $p.StandardOutput.ReadToEndAsync(); $se = $p.StandardError.ReadToEndAsync()
    $done = $false
    while ($sw.Elapsed.TotalSeconds -lt $TimeoutSec) { if ($p.WaitForExit(80)) { $done = $true; break }; Test-Abort }
    if (-not $done) { try { $p.Kill($true) } catch { }; return [pscustomobject]@{ Exit = -9; Out = ''; Err = "超时 ${TimeoutSec}s 已终止"; Ms = [int]$sw.ElapsedMilliseconds } }
    return [pscustomobject]@{ Exit = $p.ExitCode; Out = $so.GetAwaiter().GetResult(); Err = $se.GetAwaiter().GetResult(); Ms = [int]$sw.ElapsedMilliseconds }
}
$script:V10AllowNetwork = $false
function Invoke-V10CliRun($a) {
    $cat = Get-V10CliCatalog
    $name = "$($a.tool)".Trim()
    if (-not $cat.Contains($name)) { throw "Layer 0：工具「$name」不在已发现目录（只允许 cli-anything-* 与白名单无头工具；可用: $((@($cat.Keys)) -join ', ')）" }
    $tool = $cat[$name]
    $jail = if ($script:SafeOn -and $script:WorkspaceRoot) { "$($script:WorkspaceRoot)" } else { '' }
    $args0 = @($a.args | ForEach-Object { "$_" })
    $args1 = @(Resolve-V10CliArgs $tool $args0 $jail)
    if ($tool.Kind -eq 'cli-anything' -and $args1 -notcontains '--json') { $args1 = @('--json') + $args1 }
    $exp = [System.Collections.Generic.List[object]]::new()
    foreach ($e in @($a.expect)) {
