function New-UiaCondition([string[]]$typeNames) {
    $AE = [System.Windows.Automation.AutomationElement]
    $conds = @(foreach ($n in $typeNames) {
            [System.Windows.Automation.PropertyCondition]::new($AE::ControlTypeProperty, [System.Windows.Automation.ControlType]::$n)
        })
    if ($conds.Count -eq 0) { throw 'New-UiaCondition 需要至少一个控件类型' }
    if ($conds.Count -eq 1) { $typeCond = $conds[0] }
    else { $typeCond = [System.Windows.Automation.OrCondition]::new([System.Windows.Automation.Condition[]]$conds) }
    $off = [System.Windows.Automation.PropertyCondition]::new($AE::IsOffscreenProperty, $false)
    return [System.Windows.Automation.AndCondition]::new($typeCond, $off)
}
function Get-UiElements([IntPtr]$hwnd) {
    $result = New-Object System.Collections.Generic.List[object]
    if ($hwnd -eq [IntPtr]::Zero) { return @() }
    $AE = [System.Windows.Automation.AutomationElement]
    try { $root = $AE::FromHandle($hwnd) } catch { return @() }
    $interactive = @('Button', 'Edit', 'MenuItem', 'ListItem', 'TabItem', 'CheckBox', 'RadioButton',
        'ComboBox', 'Hyperlink', 'TreeItem', 'SplitButton', 'Slider', 'DataItem')
    $cond = New-UiaCondition ($interactive + @('Text'))
    $patProps = [ordered]@{
        inv = $AE::IsInvokePatternAvailableProperty
        val = $AE::IsValuePatternAvailableProperty
        tog = $AE::IsTogglePatternAvailableProperty
        sel = $AE::IsSelectionItemPatternAvailableProperty
        exp = $AE::IsExpandCollapsePatternAvailableProperty
        scr = $AE::IsScrollPatternAvailableProperty
    }
    # v4.1：开关状态 / 值 / 选中状态也随 CacheRequest 一次取回（不再受「最多 45 次实时读取」限制）
    $TogP = [System.Windows.Automation.TogglePattern]::ToggleStateProperty
    $ValP = [System.Windows.Automation.ValuePattern]::ValueProperty
    $SelP = [System.Windows.Automation.SelectionItemPattern]::IsSelectedProperty
    $useCache = $true
    $act = $null
    try {
        $cr = [System.Windows.Automation.CacheRequest]::new()
        foreach ($p in @($AE::NameProperty, $AE::AutomationIdProperty, $AE::ControlTypeProperty,
                $AE::BoundingRectangleProperty, $AE::IsEnabledProperty, $AE::NativeWindowHandleProperty,
                $AE::HasKeyboardFocusProperty, $TogP, $ValP, $SelP)) { $cr.Add($p) }
        foreach ($p in $patProps.Values) { $cr.Add($p) }
        $act = $cr.Activate()
    }
    catch { $useCache = $false; $act = $null }
    $col = $null
    try { $col = $root.FindAll([System.Windows.Automation.TreeScope]::Descendants, $cond) }
    catch { $col = $null }
    finally { if ($act) { $act.Dispose() } }
    if ($null -eq $col) { return @() }
    $interCount = 0
    $textCount = 0
    $liveReads = 0
    foreach ($el in $col) {
        if (($interCount + $textCount) -ge $script:ScanCap) { break }   # v4.2：只设扫描上限，预算在按位置排序之后再截断
        try {
            $c = if ($useCache) { $el.Cached } else { $el.Current }
            $r = $c.BoundingRectangle
            if ($r.IsEmpty -or $r.Width -lt 2 -or $r.Height -lt 2) { continue }
            $type = ($c.ControlType.ProgrammaticName -replace '^ControlType\.', '')
            $isText = ($type -eq 'Text')
            $name = $c.Name
            if ([string]::IsNullOrWhiteSpace($name) -and -not $isText) { $name = $c.AutomationId }
            if ($isText -and [string]::IsNullOrWhiteSpace($name)) { continue }
            $pats = @()
            if (-not $isText) {
                foreach ($k in $patProps.Keys) {
                    try {
                        $pv = if ($useCache) { $el.GetCachedPropertyValue($patProps[$k]) } else { $el.GetCurrentPropertyValue($patProps[$k]) }
                        if ($pv -eq $true) { $pats += $k }
                    }
                    catch { }
                }
            }
            $value = ''
            $state = ''
            if (-not $isText) {
                if ($useCache) {
                    try {
                        if ($type -eq 'Edit' -or $type -eq 'ComboBox' -or $pats -contains 'val') {
                            $vv = $el.GetCachedPropertyValue($ValP)
                            if ($vv -is [string]) { $value = $vv }
                        }
                        if ($pats -contains 'tog') {
                            $tv = $el.GetCachedPropertyValue($TogP)
                            if ($tv -is [System.Windows.Automation.ToggleState]) { $state = "$tv".ToLower() }
                        }
                        elseif ($pats -contains 'sel') {
                            $sv = $el.GetCachedPropertyValue($SelP)
                            if ($sv -is [bool]) { $state = if ($sv) { 'selected' } else { '' } }
                        }
                    }
                    catch { }
                }
                elseif ($liveReads -lt 45) {
                    # 缓存不可用时的退路（与 v4 相同的实时读取）
                    if ($type -eq 'Edit' -or $type -eq 'ComboBox') {
                        try {
                            $pat = $null
                            if ($el.TryGetCurrentPattern([System.Windows.Automation.ValuePattern]::Pattern, [ref]$pat)) { $value = $pat.Current.Value }
                        }
                        catch { }
                        $liveReads++
                    }
                    elseif ($pats -contains 'tog') {
                        try {
                            $pat = $null
                            if ($el.TryGetCurrentPattern([System.Windows.Automation.TogglePattern]::Pattern, [ref]$pat)) { $state = "$($pat.Current.ToggleState)".ToLower() }
                        }
                        catch { }
                        $liveReads++
                    }
                    elseif ($pats -contains 'sel') {
                        try {
                            $pat = $null
                            if ($el.TryGetCurrentPattern([System.Windows.Automation.SelectionItemPattern]::Pattern, [ref]$pat)) { $state = if ($pat.Current.IsSelected) { 'selected' } else { '' } }
                        }
                        catch { }
                        $liveReads++
                    }
                }
            }
            if ($isText) { $textCount++ } else { $interCount++ }
            $full = "$name"
            if ($full.Length -gt 300) { $full = $full.Substring(0, 300) }
            $focus = $false
            try { $focus = [bool]$c.HasKeyboardFocus } catch { }
            $result.Add([pscustomobject]@{
                    Type = $type
                    Name = (Limit-Text $name 80)
                    FullName = $full
                    Value = (Limit-Text $value 80)
                    State = $state
                    Enabled = [bool]$c.IsEnabled
                    Focus = $focus
                    Hwnd = [int]$c.NativeWindowHandle
                    Pat = $pats
                    El = $el
                    IsMaster = $false
                    RowIdx = 0
                    RowText = ''
                    cx = [int]($r.Left + $r.Width / 2)
                    cy = [int]($r.Top + $r.Height / 2)
                    L = [int]$r.Left
                    T = [int]$r.Top
                    W = [int]$r.Width
                    H = [int]$r.Height
                })
        }
        catch { continue }
    }
    return $result.ToArray()
}
