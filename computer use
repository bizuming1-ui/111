                ev.append({"type": "status_in", "values": [e.get("equals", "done")]})
            elif e["type"] == "status_in":
                ev.append({"type": "status_in", "values": e.get("values", [])})
        tasks.append({"id": t["id"], "instruction": t["instruction"], "max_steps": t.get("max_steps", 30), "oracle": ev, "cleanup": t.get("cleanup", [])})
    run_dir = ROOT / "eval_runs" / (time.strftime("%Y%m%d-%H%M%S") + f"-legacy-{name}")
    h = W.Harness(run_dir, f"legacy_{name}")
    await h.start()
    try:
        rows = await h.run_tasks(tasks, 1, trials)
    finally:
        await h.stop()
    print(json.dumps(collect(rows, False), ensure_ascii=False))


def main() -> None:
    av = sys.argv[1:]
    if av and av[0] not in ("run", "compare", "selfcheck", "-h", "--help"):
        ap = argparse.ArgumentParser()
        ap.add_argument("suite", nargs="?", default="smoke")
        ap.add_argument("--trials", type=int, default=3)
        a = ap.parse_args(av)
        asyncio.run(legacy(a.suite, a.trials))
        return
    ap = argparse.ArgumentParser(prog="runner.py")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("tiers", nargs="*", default=["all"], help="tier1 | tier2 | waa | all")
    r.add_argument("--rollouts", type=int, default=1)
    r.add_argument("--n", type=int, default=40, help="tier1 samples")
    r.add_argument("--tasks", default="")
    r.add_argument("--run-dir", default="")
    r.add_argument("--label", default="", help="version label stored in summary.json (e.g. v14 / v15)")
    r.add_argument("--scenarios-only", action="store_true")
    r.add_argument("--allow-exec", action="store_true")
    r.add_argument("--allow-destructive", action="store_true")
    c = sub.add_parser("compare")
    c.add_argument("a")
    c.add_argument("b")
    sub.add_parser("selfcheck")
    a = ap.parse_args(av)
    if a.cmd == "compare":
        sys.exit(compare(a.a, a.b))
    if a.cmd == "selfcheck":
        import waa_runner as W

        sys.argv = ["waa_runner.py", "--selfcheck"]
        W.main()
        return
    sys.exit(asyncio.run(run_all(a)))


if __name__ == "__main__":
    main()
