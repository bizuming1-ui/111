def pct(a: list[float], p: float) -> float:
    if not a:
        return 0.0
    s = sorted(a)
    return s[min(len(s) - 1, int(round((len(s) - 1) * p)))]


def wilson(k: int, n: int, z: float = 1.96) -> tuple[float, float]:
    if n == 0:
        return 0.0, 0.0
    p = k / n
    d = 1 + z * z / n
    c = p + z * z / (2 * n)
    m = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n))
    return round(max(0.0, (c - m) / d), 3), round(min(1.0, (c + m) / d), 3)


# ------------------------------------------------------------------------------------------------ task loading
def load_tasks(path: str | Path) -> list[dict[str, Any]]:
    p = Path(path)
    files = sorted(p.rglob("*.json")) if p.is_dir() else [p]
    tasks: list[dict[str, Any]] = []
    for f in files:
        try:
            j = json.loads(f.read_text(encoding="utf-8"))
        except Exception as e:  # noqa: BLE001
            print(f"  ⚠ 跳过无法解析的任务文件 {f}: {e}")
            continue
        for t in (j if isinstance(j, list) else j.get("tasks", [j])):
            if "instruction" not in t:
                continue
            t = dict(t)
            t.setdefault("id", f.stem)
            t["_file"] = str(f)
            if "oracle" not in t and "evaluator" in t:
                t["oracle"] = V.waa_to_oracle(t["evaluator"])  # official WAA schema -> native verifiers
            t.setdefault("oracle", [{"type": "waa:missing_evaluator"}])
            t.setdefault("max_steps", 30)
            tasks.append(t)
    return tasks


# ------------------------------------------------------------------------------------------------ setup steps
class Env:
    def __init__(self, ctx: V.Ctx, allow_exec: bool = False, allow_destructive: bool = False) -> None:
        self.ctx, self.allow_exec, self.allow_destructive = ctx, allow_exec, allow_destructive
        self.servers: list[http.server.ThreadingHTTPServer] = []
        self.log: list[str] = []
        self.procs: list[subprocess.Popen[bytes]] = []

    def run_steps(self, steps: list[dict[str, Any]]) -> bool:
        for raw in steps:
            s = V.fmt(raw, self.ctx)
            t = s.get("type")
            try:
                if t == "create_file":
                    p = Path(s["path"])
                    p.parent.mkdir(parents=True, exist_ok=True)
                    p.write_bytes(base64.b64decode(s["bytes_b64"]) if "bytes_b64" in s else str(s.get("text", "")).encode("utf-8"))
                elif t == "mkdir":
                    Path(s["path"]).mkdir(parents=True, exist_ok=True)
                elif t == "delete_path":
                    p = Path(s["path"])
                    if p.is_dir():
                        shutil.rmtree(p, ignore_errors=True)
                    else:
                        p.unlink(missing_ok=True)
                elif t == "serve_http":
                    d = Path(s["dir"])
                    d.mkdir(parents=True, exist_ok=True)
                    for name, html in (s.get("files") or {}).items():
                        (d / name).write_text(V.fmt(html, self.ctx), encoding="utf-8")
                    h = functools.partial(_Quiet, directory=str(d))
                    srv = http.server.ThreadingHTTPServer(("127.0.0.1", int(s.get("port", 0))), h)
                    threading.Thread(target=srv.serve_forever, daemon=True).start()
                    self.servers.append(srv)
                    self.ctx[s.get("var", "HttpPort")] = str(srv.server_address[1])
                elif t == "sleep":
                    time.sleep(float(s.get("seconds", 1)))
                elif t == "launch":
                    self.procs.append(subprocess.Popen(s["command"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
                elif t == "download":
                    urllib.request.urlretrieve(s["url"], s["path"])
                elif t in ("execute", "command"):
                    if not self.allow_exec:
                        self.log.append(f"SKIP {t}: needs --allow-exec")
                        return False
                    subprocess.run(s["command"] if isinstance(s["command"], list) else s["command"], shell=not isinstance(s["command"], list), timeout=int(s.get("timeout", 60)), check=False)
                elif t == "recycle":
                    ok, msg = V.recycle_file(s["path"])
                    self.log.append(f"recycle {s['path']}: {ok} {msg}")
                    if not ok:
                        return False
                elif t == "empty_recycle_bin":
                    if not self.allow_destructive:
                        self.log.append("SKIP empty_recycle_bin: needs --allow-destructive")
                        return False
                    ok, msg = V.empty_recycle_bin()
                    self.log.append(f"empty_recycle_bin: {ok} {msg}")
                    if not ok:
                        return False
                else:
                    self.log.append(f"unknown setup step {t}")
                    return False
                self.log.append(f"ok {t}")
            except Exception as e:  # noqa: BLE001
                self.log.append(f"FAIL {t}: {e}")
                return False
        return True

    def close(self) -> None:
        for s in self.servers:
            s.shutdown()
        for p in self.procs:
            try:
                p.terminate()
            except Exception:  # noqa: BLE001
                pass


class _Quiet(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *a: Any) -> None:  # noqa: D401
        return


# ------------------------------------------------------------------------------------------------ fault injection
def kill_browser(port: int) -> int:
    """Hard-kill the automation browser (the process tree that owns --remote-debugging-port=<port>) to reproduce `CDP closed`."""
    import psutil

    n = 0
    for p in psutil.process_iter(["pid", "name", "cmdline"]):
        try:
            cl = " ".join(p.info["cmdline"] or [])
            if f"--remote-debugging-port={port}" in cl and "--type=" not in cl:
                for c in p.children(recursive=True):
                    c.kill()
                p.kill()
                n += 1
        except Exception:  # noqa: BLE001
            continue
    return n


# ------------------------------------------------------------------------------------------------ results / judge
@dataclass
class Rollout:
    task_id: str
    k: int
    status: str = ""
    summary: str = ""
    elapsed: float = 0.0
    steps: int = 0
    errors: int = 0
    oracle: dict[str, Any] = field(default_factory=dict)
    facts: dict[str, Any] = field(default_factory=dict)
    setup_ok: bool = True
    dir: str = ""

    @property
    def success(self) -> bool:
        return bool(self.setup_ok and self.oracle.get("positive_ok")) and bool(self.oracle.get("guards_ok", True))

    @property
    def misoperation(self) -> bool:
        return not self.oracle.get("guards_ok", True)


def fact_score(r: Rollout) -> float:
    """bBoN structured-fact judge: objective trajectory facts only (NO oracle access)."""
    f = r.facts
    s = 0.0
    s += 100 if r.status == "done" else 0
    s += 30 if f.get("verifier_pass", 0) > 0 and f.get("verifier_rejects", 0) == 0 else 10 if f.get("verifier_pass", 0) > 0 else 0
    s -= 40 if r.status in ("blocked_security", "failed", "error") else 0
    s -= 5 * r.errors + 10 * f.get("security_denials", 0) + 0.5 * r.steps
    s += 3 * min(2, f.get("recovered", 0))
    return s


