function Get-V9SigFromBitmap($Small) {
    # 48x32 Bitmap → 1536 字节灰度（LockBits 一次拷贝 + C# 位级等价公式；取代 1536 次 GetPixel）。任何失败返回 $null → 调用方走原 GetPixel 循环。
    try {
        if (-not (Test-V9Fast)) { return $null }
        $rect = [System.Drawing.Rectangle]::new(0, 0, 48, 32)
        $bd = $Small.LockBits($rect, [System.Drawing.Imaging.ImageLockMode]::ReadOnly, [System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
        try {
            $stride = [Math]::Abs($bd.Stride); $buf = New-Object 'byte[]' ($stride * 32)
            [System.Runtime.InteropServices.Marshal]::Copy($bd.Scan0, $buf, 0, $buf.Length)
        }
        finally { $Small.UnlockBits($bd) }
        return [DsV9Fast]::SigFromBgra48x32($buf, $stride)
    }
    catch { return $null }
}
