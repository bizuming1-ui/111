@dataclass
class Check:
    name: str
    ok: bool
    detail: str = ""
    kind: str = "misc"  # file | cdp | quota | sanity


@dataclass
class Verdict:
    ok: bool
    checks: list[Check] = field(default_factory=list)
    coverage: str = "none"  # full | partial | none
    diagnosis: str = ""

    def render(self) -> str:
        return " ; ".join(f"{'✓' if c.ok else '✗'}{c.name}({c.detail[:90]})" for c in self.checks) or "（无可程序化核对项）"


class IndependentVerifier:
    def __init__(self, hub: Any, registry: StableObjectRegistry, say: Any = None) -> None:
        self.hub, self.reg = hub, registry
        self.say = say or (lambda m: None)
        self.rejections = 0
        self.passes = 0
        self.last: Optional[Verdict] = None

    # ------------------------------------------------------------------ files
    @staticmethod
    def check_file(path: str | Path, expect_bytes: Optional[bytes] = None, expect_text: Optional[str] = None, min_size: int = 1) -> list[Check]:
        p = Path(path)
        out: list[Check] = []
        if not p.exists() or not p.is_file():
            return [Check("file_exists", False, f"不存在: {p}", "file")]
        data = p.read_bytes()
        out.append(Check("file_exists", True, f"{p.name} · {len(data)} 字节", "file"))
        out.append(Check("file_size", len(data) >= min_size, f"{len(data)} >= {min_size}", "file"))
        ext = p.suffix.lower()
        if ext in MAGIC and ext not in (".txt", ".md"):
            ok = any(data.startswith(m) for m in MAGIC[ext]) or (ext == ".webp" and data[8:12] == b"WEBP") or (ext == ".mp4" and data[4:8] == b"ftyp") or (ext == ".json" and data.lstrip()[:1] in (b"{", b"["))
            out.append(Check("magic_number", ok, f"{ext} 头 {data[:8].hex()}", "file"))
        if ext in TXT_EXTS or expect_text is not None or expect_bytes is not None:
            try:
                txt = data.decode("utf-8")
                out.append(Check("utf8_decodable", True, "UTF-8 OK" + (" (含 BOM)" if data.startswith(b"\xef\xbb\xbf") else ""), "file"))
            except UnicodeDecodeError:
                txt = ""
                out.append(Check("utf8_decodable", False, "不是合法 UTF-8", "file"))
            if expect_text is not None:
                out.append(Check("content_contains", expect_text in txt.lstrip("\ufeff"), f"期望 {expect_text[:30]!r}", "file"))
        if expect_bytes is not None:
            out.append(Check("bytes_exact", data == expect_bytes or data.lstrip(b"\xef\xbb\xbf") == expect_bytes, f"{len(data)} vs {len(expect_bytes)} 字节", "file"))
        return out

    def _derive_files(self, task: str, summary: str) -> list[tuple[Path, Optional[str]]]:
        found: list[tuple[Path, Optional[str]]] = []
        cm = CONTENT_RX.search(task)
        content = cm.group("c").strip().strip("“”\"'") if cm else None
        for m in WIN_PATH.findall(task + " " + summary):
            found.append((Path(m), content))
        if FILE_VERBS.search(task):
            f = re.search(r"(桌面|文档|下载|desktop|documents|downloads)", task, re.I)
            n = NAME_RX.search(task)
            if f and n:
                folder = layer0.known_folder(f.group(1))
                name = n.group(1)
                if "." in name:
                    found.append((folder / name, content))
                else:
                    cands = [folder / (name + e) for e in (".txt", ".docx", ".xlsx", ".pptx", ".png", ".jpg", ".pdf", ".md", ".csv", ".json")]
                    hit = next((c for c in cands if c.exists()), cands[0])
                    found.append((hit, content))
        seen, uniq = set(), []
        for p, c in found:
            k = str(p).lower()
            if k not in seen:
                seen.add(k)
                uniq.append((p, c))
        return uniq

    # ------------------------------------------------------------------ browser
    @staticmethod
    def derive_web_expect(task: str) -> dict[str, Any]:
        t = task.lower()
        exp: dict[str, Any] = {}
        hosts = [urlparse(u).hostname or "" for u in URL_RX.findall(task)]
        for k, v in SITES.items():
            if k in t:
                hosts.append(v)
        hosts = [h for h in hosts if h]
        if hosts:
            exp["host"] = hosts[0]
        sm = SEARCH_RX.search(task)
        if sm and exp.get("host"):
            exp["keyword"] = sm.group(1)
        if NTH_RX.search(task) and re.search(r"视频|video|结果|短片", task, re.I):
            exp["opened_item"] = True
        return exp

    async def probe_cdp(self, needles: list[str]) -> Optional[dict[str, Any]]:
        if not getattr(self.hub, "cdp_up", False):
            return None
        try:
            r = await self.hub.cdp_action({"action": "probe", "needles": needles, "action_id": f"probe-{id(needles)}-{len(needles)}"})
        except Exception as e:  # noqa: BLE001
            return {"error": str(e)}
        if not r.ok:
            return {"error": r.message}
        return dict(r.effect)

    async def _web_checks(self, task: str, summary: str) -> list[Check]:
        exp = self.derive_web_expect(task)
        if not exp:
            return []
        needles = [exp["keyword"]] if exp.get("keyword") else []
        pr = await self.probe_cdp(needles)
        if pr is None:
            return [Check("cdp_probe", False, "任务涉及网页但 CDP 守护进程不可用，无法独立核对页面状态", "cdp")]
        if "error" in pr:
            return [Check("cdp_probe", False, f"CDP 探测失败: {pr['error'][:100]}", "cdp")]
        url, title = str(pr.get("url", "")), str(pr.get("title", ""))
        out: list[Check] = []
        if exp.get("host"):
            host = (urlparse(url).hostname or "").lower()
            core = exp["host"].lower().rstrip(".")
            out.append(Check("url_host", core in host, f"当前 {host or '空'} 期望含 {core}", "cdp"))
        if exp.get("keyword"):
            kw = exp["keyword"].lower()
            u = unquote(url).lower()
            hit = kw in u or kw in title.lower() or bool(pr.get("needles", {}).get(exp["keyword"])) or any(kw in str(v).lower() for v in pr.get("inputs", []))
            out.append(Check("search_keyword", hit, f"关键词 {exp['keyword']!r} 出现在 URL/标题/输入框/DOM", "cdp"))
        if exp.get("opened_item"):
            ok = bool(VIDEO_URL.search(url)) or bool(pr.get("has_video_player"))
            out.append(Check("item_opened", ok, f"URL={url[:90]} player={pr.get('has_video_player')}", "cdp"))
        return out

    # ------------------------------------------------------------------ quota / list objects
    async def _quota_checks(self, task: str, quantity: Optional[int], obs: Any) -> list[Check]:
        if not self.reg.targets_locked or not DESTRUCTIVE.search(task) and not re.search(r"删除|delete|归档|archive|移除", task, re.I):
            return []
        elements = None
        if getattr(self.hub, "cdp_up", False):
            try:
                o = await self.hub.cdp_observe(max_elements=250, settle_ms=800)
                elements = o.elements
            except Exception:  # noqa: BLE001
                elements = None
        if elements is None and obs is not None:
            elements = obs.elements
        if elements is None:
            return [Check("quota_fresh_list", False, "无法取得新鲜列表", "quota")]
        self.reg.observe_rows(elements, self.reg.step)
        targets = [o for o in self.reg.objects.values() if o.is_target]
        still = [o for o in targets if o.current_state != "gone"]
        out = [Check("targets_gone", not still, f"{len(targets) - len(still)}/{len(targets)} 个目标对象已消失" + (f"；仍在: {[o.label[:20] for o in still][:3]}" if still else ""), "quota")]
        if quantity:
            out.append(Check("quota_count", len(targets) - len(still) >= quantity, f"已移除 {len(targets) - len(still)} / 配额 {quantity}", "quota"))
        return out

    # ------------------------------------------------------------------ recycle bin (v15)
    @staticmethod
    def _recycle_checks(task: str) -> list[Check]:
        """Task says 'empty the Recycle Bin' -> independent COM + SHQueryRecycleBinW count must be 0 (fixes the v14 UNVERIFIED verdict of task #3).
        Task says 'put X into the Recycle Bin' -> X must be gone from its folder."""
        out: list[Check] = []
        if not re.search(r"回收站|recycle bin", task, re.I):
            return out
        from . import safe_shell

        if layer0.recycle_empty_intent(task):
            st = safe_shell.wait_recycle_count(0, 6.0)
