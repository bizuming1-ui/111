"""Plane-4 mirror of the dscu-driver-v1 contract (docs/PROTOCOL.md). Equivalence with Rust / TS / PowerShell is enforced by golden vectors."""
from __future__ import annotations
import json
import re
from enum import IntEnum
from pydantic import BaseModel, ConfigDict, Field, ValidationError, field_validator

MAX_LINE = 4 * 1024 * 1024
_METHOD = re.compile(r"^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$")
_HEX16 = re.compile(r"^[0-9a-fA-F]{16}$")

class Code(IntEnum):
    OK = 0
    PARSE_ERROR = -32700
    INVALID_REQUEST = -32600
    UNSUPPORTED_VERSION = 4001
    IPC_IDEMPOTENT_REPLAY = 4090
    IPC_STALE_ACTION_ID = 4091
    IPC_STALE_HWND = 4092
    IPC_STALE_REGION = 4093
    STALE_REF = 4094
    AMBIGUOUS_TARGET = 4095

DRIFT_CODES = {Code.IPC_STALE_HWND, Code.IPC_STALE_REGION, Code.STALE_REF}

class Envelope(BaseModel):
    model_config = ConfigDict(extra="allow", strict=True)
    v: int = 1
    id: int | None = None
    method: str
    params: dict | list | None = None
    action_id: int | None = Field(default=None, ge=0)
    expect_hwnd: int | None = Field(default=None, ge=0)
    expect_fp: str | None = None

    @field_validator("method")
    @classmethod
    def _m(cls, m: str) -> str:
        if not _METHOD.match(m):
            raise ValueError("method syntax")
        return m

    @field_validator("expect_fp")
    @classmethod
    def _fp(cls, f: str | None) -> str | None:
        if f is not None and not _HEX16.match(f):
            raise ValueError("expect_fp")
        return f.lower() if f else f

def decode_line(line: bytes | str) -> tuple[Code, Envelope | None]:
    raw = line.encode() if isinstance(line, str) else line
    if len(raw) > MAX_LINE:
        return Code.INVALID_REQUEST, None
    try:
        obj = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return Code.PARSE_ERROR, None
    if not isinstance(obj, dict):
        return Code.INVALID_REQUEST, None
    if "v" in obj:
        if isinstance(obj["v"], bool) or not isinstance(obj["v"], int):
            return Code.INVALID_REQUEST, None
        if obj["v"] != 1:
            return Code.UNSUPPORTED_VERSION, None
    try:
        return Code.OK, Envelope.model_validate(obj)
    except ValidationError:
        return Code.INVALID_REQUEST, None

def hamming_hex(a: str, b: str) -> int:
    a, b = (a or "").strip(), (b or "").strip()
    if not a or not b or len(a) > 16 or len(b) > 16:
        return 64
    try:
        return bin(int(a, 16) ^ int(b, 16)).count("1")
    except ValueError:
        return 64
