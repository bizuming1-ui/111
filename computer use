#=#=# FILE: dscu-driver/crates/dscu-core/src/idempotency.rs
//! Idempotent action state machine + optimistic locks (mirrors `Test-ActionIdempotency` of v7.1).
//!
//! The v7.1 client stamps EVERY RPC with the current `action_id`, and one logical action may issue several
//! RPCs (e.g. capture + input). Therefore:
//!   * id <  last : exact duplicate of a seen request -> IPC_IDEMPOTENT_REPLAY, otherwise IPC_STALE_ACTION_ID
//!   * id == last : same request fingerprint -> IPC_IDEMPOTENT_REPLAY (IPC retry); a different one is a sub-step
//!   * id >  last : commit a new action group
//! Only side-effecting methods are subject to this (see `engine::is_mutating`).
use crate::protocol::{ErrKind, RpcError};
use serde_json::json;
use std::collections::{HashMap, VecDeque};

#[derive(Default)]
pub struct IdemState {
    last_id: u64,
    seen: HashMap<u64, Vec<String>>,
    order: VecDeque<u64>,
}

#[derive(Default, Clone, Debug)]
pub struct Locks {
    pub expect_hwnd: Option<i64>,
    pub cur_hwnd: Option<i64>,
    pub expect_fp: Option<String>,
    pub cur_fp: Option<String>,
}

enum Class {
    New,
    SubStep,
}

impl IdemState {
    pub fn last_id(&self) -> u64 {
        self.last_id
    }

    pub fn check_and_commit(&mut self, action_id: Option<u64>, fp: &str, locks: &Locks) -> Result<(), RpcError> {
        let id = match action_id {
            Some(n) if n > 0 => n,
            _ => {
                Self::check_locks(locks)?;
                return Ok(());
            }
        };
        let class = if id < self.last_id {
            let dup = self.seen.get(&id).map(|v| v.iter().any(|f| f == fp)).unwrap_or(false);
            return Err(if dup {
                RpcError::new(ErrKind::IdempotentReplay, format!("action_id={id} already executed (IPC retry), duplicate submit refused"))
                    .with_data(json!({ "action_id": id, "last_id": self.last_id }))
            } else {
                RpcError::new(ErrKind::StaleActionId, format!("action_id={id} <= committed max id={} (must be monotonic)", self.last_id))
                    .with_data(json!({ "action_id": id, "last_id": self.last_id }))
            });
        } else if id == self.last_id {
            if self.seen.get(&id).map(|v| v.iter().any(|f| f == fp)).unwrap_or(false) {
                return Err(RpcError::new(ErrKind::IdempotentReplay, format!("action_id={id} request already executed (IPC retry), duplicate submit refused"))
                    .with_data(json!({ "action_id": id, "last_id": self.last_id })));
            }
            Class::SubStep
        } else {
            Class::New
        };
        Self::check_locks(locks)?;
        match class {
            Class::New => {
                self.last_id = id;
                self.seen.insert(id, vec![fp.to_string()]);
                self.order.push_back(id);
                while self.order.len() > 512 {
                    if let Some(old) = self.order.pop_front() {
                        self.seen.remove(&old);
                    }
                }
            }
            Class::SubStep => {
                self.seen.entry(id).or_default().push(fp.to_string());
            }
        }
        Ok(())
    }

    fn check_locks(l: &Locks) -> Result<(), RpcError> {
        if let (Some(e), Some(c)) = (l.expect_hwnd, l.cur_hwnd) {
            if e != c {
                return Err(RpcError::new(ErrKind::StaleHwnd, format!("target window handle changed (expected {e}, current {c}), optimistic lock refused"))
                    .with_data(json!({ "expected": e, "current": c })));
            }
        }
        if let (Some(e), Some(c)) = (&l.expect_fp, &l.cur_fp) {
            let d = crate::ahash::hamming(e, c);
            if d > 10 {
                return Err(RpcError::new(ErrKind::StaleRegion, format!("region fingerprint drift Hamming={d} (>10), UI changed, optimistic lock refused"))
                    .with_data(json!({ "hamming": d, "expected": e, "current": c })));
            }
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    fn nolock() -> Locks {
        Locks::default()
    }
    #[test]
    fn monotonic_and_replay() {
        let mut s = IdemState::default();
        assert!(s.check_and_commit(Some(5), "a", &nolock()).is_ok());
        assert!(s.check_and_commit(Some(5), "b", &nolock()).is_ok()); // sub-step of the same action
        assert_eq!(s.check_and_commit(Some(5), "a", &nolock()).unwrap_err().kind, ErrKind::IdempotentReplay);
        assert!(s.check_and_commit(Some(6), "a", &nolock()).is_ok());
        assert_eq!(s.check_and_commit(Some(5), "a", &nolock()).unwrap_err().kind, ErrKind::IdempotentReplay);
        assert_eq!(s.check_and_commit(Some(5), "zzz", &nolock()).unwrap_err().kind, ErrKind::StaleActionId);
        assert!(s.check_and_commit(None, "x", &nolock()).is_ok());
        assert!(s.check_and_commit(Some(0), "x", &nolock()).is_ok());
    }
    #[test]
    fn locks() {
        let mut s = IdemState::default();
        let l = Locks { expect_hwnd: Some(1), cur_hwnd: Some(2), ..Default::default() };
        assert_eq!(s.check_and_commit(Some(1), "a", &l).unwrap_err().kind, ErrKind::StaleHwnd);
        assert_eq!(s.last_id(), 0, "failed lock must not commit");
        let l = Locks { expect_fp: Some("0000000000000000".into()), cur_fp: Some("00000000000007ff".into()), ..Default::default() };
        assert_eq!(s.check_and_commit(Some(1), "a", &l).unwrap_err().kind, ErrKind::StaleRegion); // 11 bits
        let l = Locks { expect_fp: Some("0000000000000000".into()), cur_fp: Some("00000000000003ff".into()), ..Default::default() };
        assert!(s.check_and_commit(Some(1), "a", &l).is_ok()); // 10 bits: allowed
    }
}
