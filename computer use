$script:V12NativeCs = @'
using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using System.Text;
using System.Threading;
// v12 strongly-typed PUBLIC interop surface (fixes 运行日志1: [DsNative61] 不包含 ShowWindow / GetWindowRect / SetForegroundWindow).
// Private P/Invokes are named _Xxx with EntryPoint; the public wrappers below are the ONLY contract PowerShell may call.
// build_v12.py + `v12 contract` verify every DsNative12 call-site from PowerShell against this public static surface.
public static class DsNative12 {
    [StructLayout(LayoutKind.Sequential)] public struct RECT { public int Left; public int Top; public int Right; public int Bottom; }
    delegate bool EnumProc(IntPtr h, IntPtr l);
    [DllImport("user32.dll", EntryPoint = "ShowWindow")] static extern bool _ShowWindow(IntPtr h, int c);
    [DllImport("user32.dll", EntryPoint = "SetForegroundWindow")] static extern bool _SetForegroundWindow(IntPtr h);
    [DllImport("user32.dll", EntryPoint = "BringWindowToTop")] static extern bool _BringWindowToTop(IntPtr h);
    [DllImport("user32.dll", EntryPoint = "GetForegroundWindow")] static extern IntPtr _GetForegroundWindow();
    [DllImport("user32.dll", EntryPoint = "IsIconic")] static extern bool _IsIconic(IntPtr h);
    [DllImport("user32.dll", EntryPoint = "IsWindow")] static extern bool _IsWindow(IntPtr h);
    [DllImport("user32.dll", EntryPoint = "IsWindowVisible")] static extern bool _IsWindowVisible(IntPtr h);
    [DllImport("user32.dll", EntryPoint = "GetWindowRect")] static extern bool _GetWindowRect(IntPtr h, out RECT r);
    [DllImport("user32.dll", EntryPoint = "GetWindowThreadProcessId")] static extern uint _GetWindowThreadProcessId(IntPtr h, out uint pid);
    [DllImport("user32.dll", EntryPoint = "AttachThreadInput")] static extern bool _AttachThreadInput(uint a, uint b, bool f);
    [DllImport("user32.dll", EntryPoint = "GetWindow")] static extern IntPtr _GetWindow(IntPtr h, uint cmd);
    [DllImport("user32.dll", EntryPoint = "GetWindowLongW")] static extern int _GetWindowLong(IntPtr h, int idx);
    [DllImport("user32.dll", EntryPoint = "SwitchToThisWindow")] static extern void _SwitchToThisWindow(IntPtr h, bool alt);
    [DllImport("user32.dll", EntryPoint = "keybd_event")] static extern void _keybd_event(byte vk, byte scan, uint flags, UIntPtr extra);
    [DllImport("user32.dll", EntryPoint = "EnumWindows")] static extern bool _EnumWindows(EnumProc p, IntPtr l);
    [DllImport("user32.dll", EntryPoint = "EnumChildWindows")] static extern bool _EnumChildWindows(IntPtr h, EnumProc p, IntPtr l);
    [DllImport("user32.dll", EntryPoint = "GetClassNameW", CharSet = CharSet.Unicode)] static extern int _GetClassName(IntPtr h, StringBuilder sb, int max);
    [DllImport("user32.dll", EntryPoint = "GetWindowTextW", CharSet = CharSet.Unicode)] static extern int _GetWindowText(IntPtr h, StringBuilder sb, int max);
    [DllImport("user32.dll", EntryPoint = "SetProcessDpiAwarenessContext")] static extern bool _SetProcessDpiAwarenessContext(IntPtr v);
    [DllImport("kernel32.dll", EntryPoint = "GetCurrentThreadId")] static extern uint _GetCurrentThreadId();
    [DllImport("dwmapi.dll", EntryPoint = "DwmGetWindowAttribute")] static extern int _DwmGetWindowAttribute(IntPtr h, int a, out int v, int sz);

    public static readonly int ContractVersion = 12;

    public static bool ShowWindow(IntPtr h, int cmd) { return _ShowWindow(h, cmd); }
    public static bool SetForegroundWindow(IntPtr h) { return _SetForegroundWindow(h); }
    public static bool BringWindowToTop(IntPtr h) { return _BringWindowToTop(h); }
    public static IntPtr GetForegroundWindow() { return _GetForegroundWindow(); }
    public static bool IsIconic(IntPtr h) { return _IsIconic(h); }
    public static bool IsWindow(IntPtr h) { return _IsWindow(h); }
    public static bool IsWindowVisible(IntPtr h) { return _IsWindowVisible(h); }
    public static int[] GetWindowRect(IntPtr h) { RECT r; if (!_GetWindowRect(h, out r)) return new int[] { 0, 0, 0, 0 }; return new int[] { r.Left, r.Top, r.Right, r.Bottom }; }
    public static uint GetWindowPid(IntPtr h) { uint p; _GetWindowThreadProcessId(h, out p); return p; }
    public static IntPtr GetOwner(IntPtr h) { return _GetWindow(h, 4); }                 // GW_OWNER
    public static long GetExStyle(IntPtr h) { return (long)(uint)_GetWindowLong(h, -20); }
    public static long GetStyle(IntPtr h) { return (long)(uint)_GetWindowLong(h, -16); }
    public static bool IsToolWindow(IntPtr h) { return (GetExStyle(h) & 0x80L) != 0; }  // WS_EX_TOOLWINDOW
    public static bool IsCloaked(IntPtr h) { int c = 0; try { _DwmGetWindowAttribute(h, 14, out c, 4); } catch { } return c != 0; }
    public static bool TrySetPerMonitorDpiV2() { try { return _SetProcessDpiAwarenessContext(new IntPtr(-4)); } catch { return false; } }
    public static string GetClassName(IntPtr h) { StringBuilder sb = new StringBuilder(256); _GetClassName(h, sb, 256); return sb.ToString(); }
    public static string GetWindowText(IntPtr h) { StringBuilder sb = new StringBuilder(512); _GetWindowText(h, sb, 512); return sb.ToString(); }

    // child-window class histogram (Win32 edit surfaces: Edit / RichEdit* / Scintilla / Chrome_RenderWidgetHostHWND ...)
    public static string[] ChildClasses(IntPtr h, int max) {
        List<string> l = new List<string>();
        EnumProc cb = delegate (IntPtr c, IntPtr x) { if (l.Count < max) l.Add(GetClassName(c)); return l.Count < max; };
        _EnumChildWindows(h, cb, IntPtr.Zero); GC.KeepAlive(cb);
        return l.ToArray();
    }
    public static int CountChildClasses(IntPtr h, string prefix) {
        int n = 0; foreach (string c in ChildClasses(h, 400)) if (c.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) n++;
        return n;
    }

    // semantic window rows: hwnd|pid|title|class|visible|owner|toolwindow|iconic|L,T,R,B   (pidFilter=0 -> all)
    public static string[] EnumTopWindows(uint pidFilter) {
        List<string> l = new List<string>();
        EnumProc cb = delegate (IntPtr h, IntPtr x) {
            uint pid = GetWindowPid(h);
            if (pidFilter != 0 && pid != pidFilter) return true;
            if (IsCloaked(h)) return true;
            int[] r = GetWindowRect(h);
            l.Add(h.ToInt64() + "|" + pid + "|" + GetWindowText(h).Replace("|", "/") + "|" + GetClassName(h) + "|" + (IsWindowVisible(h) ? 1 : 0) + "|" +
                  (GetOwner(h) != IntPtr.Zero ? 1 : 0) + "|" + (IsToolWindow(h) ? 1 : 0) + "|" + (IsIconic(h) ? 1 : 0) + "|" + r[0] + "," + r[1] + "," + r[2] + "," + r[3]);
            return true;
        };
        _EnumWindows(cb, IntPtr.Zero); GC.KeepAlive(cb);
        return l.ToArray();
    }

    // restore + foreground with the AttachThreadInput trick, Alt-tap and SwitchToThisWindow as escalating fallbacks
    public static bool ForceForeground(IntPtr h) {
        if (h == IntPtr.Zero || !_IsWindow(h)) return false;
        if (_IsIconic(h)) _ShowWindow(h, 9);                 // SW_RESTORE
        else _ShowWindow(h, 5);                              // SW_SHOW
        for (int i = 0; i < 3; i++) {
            IntPtr fg = _GetForegroundWindow(); uint d; uint fgT = _GetWindowThreadProcessId(fg, out d); uint me = _GetCurrentThreadId();
            bool att = fgT != 0 && fgT != me && _AttachThreadInput(me, fgT, true);
            _SetForegroundWindow(h); _BringWindowToTop(h);
            if (att) _AttachThreadInput(me, fgT, false);
            Thread.Sleep(70);
            if (_GetForegroundWindow() == h) return true;
            if (i == 0) { _keybd_event(0x12, 0, 0, UIntPtr.Zero); _keybd_event(0x12, 0, 2, UIntPtr.Zero); }
            if (i == 1) _SwitchToThisWindow(h, true);
        }
        return _GetForegroundWindow() == h;
    }
}
