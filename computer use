//! JobObject with KILL_ON_JOB_CLOSE: if the driver (or the brain that spawned it) dies, every child it started dies too.
//! No orphaned Notepad / Chrome / cargo processes after a crash — a fix for "workers outlive the task".

#[cfg(windows)]
pub fn init() -> Result<(), String> {
    use windows::Win32::System::JobObjects::*;
    use windows::Win32::System::Threading::GetCurrentProcess;
    unsafe {
        let job = CreateJobObjectW(None, None).map_err(|e| e.to_string())?;
        let mut info = JOBOBJECT_EXTENDED_LIMIT_INFORMATION::default();
        info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
        SetInformationJobObject(job, JobObjectExtendedLimitInformation, &info as *const _ as *const std::ffi::c_void,
            std::mem::size_of::<JOBOBJECT_EXTENDED_LIMIT_INFORMATION>() as u32).map_err(|e| e.to_string())?;
        // Already inside a job (e.g. launched from a terminal job)? Nested jobs are allowed on Win8+.
        AssignProcessToJobObject(job, GetCurrentProcess()).map_err(|e| e.to_string())?;
        std::mem::forget(job); // keep the handle open for the life of the process
    }
    Ok(())
}

