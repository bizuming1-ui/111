function parseRows(spec: string, total: number): Set<number> {
  const out = new Set<number>();
  for (const part of spec.split(/[,，\s]+/).filter(Boolean)) {
    let m: RegExpMatchArray | null;
    if ((m = part.match(/^last:(\d+)$/i))) { for (let i = Math.max(1, total - +m[1] + 1); i <= total; i++) out.add(i); }
