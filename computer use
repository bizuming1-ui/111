"""v18.0 runtime glue: connects the new components into the live Brain loop with ZERO behaviour change when nothing goes wrong.

  observe()      → compute WorldStateDiff vs the previous observation, feed the Evidence-Gated Fallback, return a directive note when a path is closed
  pre()          → refuse (without a model round-trip) an action whose signature already proved fruitless, or an irreversible `send` that already ran
  after()        → remember the last action so the next observation can be diffed against it
  parse_confirmation() / foreground helpers → fix the two HITL defects of the v17.1 log:
        (a) the user answered「我说出了，是发给老虎不抓鼠、y」 and it was treated as NO;   (b) the terminal prompt stole the foreground so the next click missed.
"""
from __future__ import annotations

import re
import sys
from collections import Counter
from typing import Any, Optional

from .recovery import EvidenceGatedFallback, WorldSnapshot, compute_world_diff

MUTATING = {"click", "double_click", "right_click", "key", "type", "scroll", "select_rows", "toolbar_action", "check", "uncheck", "uia_select", "invoke", "set_value", "drag", "hover"}
YES = {"y", "yes", "是", "是的", "确认", "确定", "ok", "okay", "好", "好的", "对", "可以", "发", "发送", "继续", "同意"}
NO = {"n", "no", "否", "不", "不要", "不是", "别", "取消", "算了", "停", "cancel", "stop"}


def parse_confirmation(ans: Any) -> bool:
    """Tolerant but SAFE yes/no.  True only when an explicit affirmative token is the first or last token AND no explicit negative token appears.
    '我说出了，是发给老虎不抓鼠、y' → True ('不抓鼠' is part of a name, not the token '不') ·  'n' / '不' / '算了 y' → False · '' → False."""
    s = str(ans or "").strip().lower()
    if not s:
        return False
    if s in YES:
        return True
    toks = [t for t in re.split(r"[\s,，。.!！?？、;；:：/\\|]+", s) if t]
    if not toks or any(t in NO for t in toks):
        return False
    return toks[-1] in YES or toks[0] in YES


def foreground_hwnd() -> int:
    if sys.platform != "win32":
        return 0
    try:
        import ctypes

        return int(ctypes.windll.user32.GetForegroundWindow() or 0)  # type: ignore[attr-defined]
    except Exception:  # noqa: BLE001
        return 0


def action_signature(a: dict) -> str:
    name = str(a.get("action", ""))
    if a.get("id") is not None:
        tgt = f"id{a['id']}"
    elif "x" in a and "y" in a:
        tgt = f"p{int(a['x']) // 24},{int(a['y']) // 24}"  # same 24-px bucket as the loop detector
    else:
        tgt = str(a.get("name") or a.get("keys") or a.get("text") or a.get("rows") or a.get("direction") or "")[:40]
    return f"{name}:{tgt}"


class V18Runtime:
    def __init__(self, brain: Any = None) -> None:
        self.b = brain
        self.fb = EvidenceGatedFallback(max_no_evidence=2)
        self.prev: Optional[WorldSnapshot] = None
        self.last: Optional[tuple] = None  # (signature, ok, irreversible_key, name)
        self.c: Counter = Counter()
        self.notes: list = []

    def reset_task(self) -> None:
        self.fb.reset()
        self.prev, self.last = None, None
        self.c.clear()
        self.notes.clear()

    # ---------------------------------------------------------------------------------------------------------------
    def observe(self, obs: Any, step: int) -> str:
        """-> directive note ('' when nothing to say)."""
        try:
            ctx = f"{getattr(obs, 'url', '') or ''}|{getattr(obs, 'title', '') or ''}|{getattr(obs, 'fg_hwnd', '') or ''}"
            snap = WorldSnapshot.from_elements(getattr(obs, "elements", []) or [], int(getattr(obs, "snapshot_epoch", 0) or 0), ctx)
            note = ""
            if self.prev is not None and self.last is not None:
                sig, ok, ikey, name = self.last
                diff = compute_world_diff(self.prev, snap, self.fb.ledger)
                self.c["diffs"] += 1
                self.c["diff_nonempty"] += 0 if diff.empty else 1
                if name in MUTATING:
                    dec = self.fb.after_action(sig, ok, diff, ikey, diff.summary())
                    if dec.kind in ("switch_strategy", "handoff", "stop_path"):
                        self.c["paths_closed"] += 1
                        note = f"【证据门控 v18】{dec.reason}。{self.fb.backtrack_hint(diff) if not diff.empty else ''} 不要重复刚才的动作；请换一种定位方法（控件编号 / 键盘 / 另一个通道）。"
                        if dec.kind == "handoff":
                            note += " 若仍无法推进，请 fail 交还用户。"
                    elif not diff.empty:
                        self.c["progress"] += 1
                self.last = None
            self.prev = snap
            if note:
                self.notes.append(note)
            return note
        except Exception as e:  # noqa: BLE001 — the gate must never take the agent down
            self.c["errors"] += 1
            return ""

    def pre(self, a: dict, step: int) -> Optional[str]:
        """-> denial message or None.  Called right before execution."""
        try:
            name = str(a.get("action", ""))
            if name not in MUTATING:
                return None
            sig = action_signature(a)
            ikey = self._ikey(a, sig)
            dec = self.fb.pre_check(sig, ikey)
            if dec is not None:
                self.c["pre_denied"] += 1
                return f"[SECURITY_DENIED] [NO_NEW_EVIDENCE] {dec.reason}"
        except Exception:  # noqa: BLE001
            self.c["errors"] += 1
        return None

    def after(self, a: dict, ok: bool) -> None:
        try:
            sig = action_signature(a)
            self.last = (sig, bool(ok), self._ikey(a, sig) if ok else "", str(a.get("action", "")))
        except Exception:  # noqa: BLE001
            self.c["errors"] += 1

    def _ikey(self, a: dict, sig: str) -> str:
        """only the message SEND is tracked as irreversible inside the generic loop (a Gmail 'delete' legitimately repeats on the next batch)."""
        try:
            from .skills import message_send as _ms

            sess = getattr(getattr(self.b, "_cur_state", None), "msg_session", None)
            if sess is not None and _ms.is_send_action(a):
                return f"send:{sess.request.recipient}:{sess.request.body}"
        except Exception:  # noqa: BLE001
            pass
        return ""

    def summary_line(self) -> str:
        s = self.fb.stats
        return (f"  v18：WorldStateDiff {self.c['diffs']} 次（有新证据 {self.c['diff_nonempty']}）· 无证据即停 {s['stopped_no_evidence']} · 路径关闭 {self.c['paths_closed']} · "
                f"预拦截 {self.c['pre_denied']} · 切换策略 {s['switched']} · 交还人工 {s['handoffs']} · 不可重放拦截 {s['replays_blocked']} · 预计省 Token≈{s['tokens_saved_est']}")
