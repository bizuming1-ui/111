$script:DscuFiles['scripts/setup-uiaccess.ps1'] = @'
#Requires -Version 7.0
#Requires -RunAsAdministrator
<#
.SYNOPSIS  Legally cross the UIPI boundary so dscu-driver can drive ELEVATED windows (Task Manager, admin consoles, UAC-free admin apps).
           1) self-signed code-signing cert  2) manifest with uiAccess="true"  3) sign  4) install under %ProgramFiles% (required by Windows).
           UIAccess is honoured ONLY for signed binaries in a secure location whose cert is trusted - this script does all three.
#>
param([string]$Exe = (Join-Path (Split-Path -Parent $PSScriptRoot) 'bin\dscu-driver.exe'), [string]$InstallDir = "$env:ProgramFiles\DSCU")
$ErrorActionPreference = 'Stop'
if (-not (Test-Path $Exe)) { throw "build first: $Exe not found" }
$mt = Get-ChildItem "${env:ProgramFiles(x86)}\Windows Kits\10\bin\*\x64\mt.exe" -ErrorAction SilentlyContinue | Sort-Object FullName -Descending | Select-Object -First 1
if (-not $mt) { throw 'mt.exe (Windows SDK) not found: winget install Microsoft.WindowsSDK.10.0.22621' }
New-Item -ItemType Directory -Force $InstallDir | Out-Null
$dst = Join-Path $InstallDir 'dscu-driver.exe'
Copy-Item $Exe $dst -Force

$manifest = Join-Path $env:TEMP 'dscu-uiaccess.manifest'
@(
  '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>',
  '<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">',
  '  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">',
  '    <security><requestedPrivileges>',
  '      <requestedExecutionLevel level="asInvoker" uiAccess="true"/>',
  '    </requestedPrivileges></security>',
  '  </trustInfo>',
  '</assembly>'
) -join [Environment]::NewLine | Set-Content -Encoding UTF8 $manifest
& $mt.FullName -nologo -manifest $manifest -outputresource:"$dst;#1"
if ($LASTEXITCODE) { throw 'mt.exe failed' }

$cert = Get-ChildItem Cert:\LocalMachine\My | Where-Object Subject -eq 'CN=DSCU UIAccess' | Select-Object -First 1
if (-not $cert) { $cert = New-SelfSignedCertificate -Type CodeSigningCert -Subject 'CN=DSCU UIAccess' -CertStoreLocation Cert:\LocalMachine\My -NotAfter (Get-Date).AddYears(5) }
foreach ($store in 'Root', 'TrustedPublisher') {
    $s = [System.Security.Cryptography.X509Certificates.X509Store]::new($store, 'LocalMachine'); $s.Open('ReadWrite'); $s.Add($cert); $s.Close()
}
$sig = Set-AuthenticodeSignature -FilePath $dst -Certificate $cert
if ($sig.Status -ne 'Valid') { throw "signing failed: $($sig.Status) $($sig.StatusMessage)" }
Write-Host "✓ signed + uiAccess manifest installed: $dst" -ForegroundColor Green
Write-Host "  Start it from there (set DSCU_DRIVER_EXE=$dst); the driver's `info` call then reports uiaccess=true."
