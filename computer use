@dataclass
class RecycleTask:
    folder_name: str = ""
    folder: Optional[Path] = None
    file: Optional[Path] = None
    empty: bool = False
    open_view: bool = True


_RECYCLE_FILE = re.compile(
    r"(?P<folder>桌面|文档|下载)(?:上|里|中|内)?的?\s*(?P<name>[^\s，,。；;]+?)\s*(?:记事本|文本)?\s*(?:文件|文档)?\s*[，,、]?\s*(?:把它|将其)?\s*"
    r"(?:拖入|拖到|拖进|放入|放进|移入|移到|扔进|丢进|扔到|送入|删除到|删到)\s*回收站")
_EMPTY_INTENT = re.compile(r"清空|清除|清理|清掉|empty|删光|全部删除|所有文件.{0,6}(?:删除|清除)")


def recycle_empty_intent(task: str) -> bool:
    return bool(re.search(r"回收站|recycle", task, re.I) and _EMPTY_INTENT.search(task))


def recycle_file_intent(task: str) -> bool:
    return bool(re.search(r"回收站|recycle|删除|delete|移除", task, re.I))


def find_in_folder(folder: Path, name: str) -> Optional[Path]:
    """Unique, case-insensitive match by exact name / exact stem / (only if unique) substring.  Ambiguity -> None (LLM path decides)."""
    try:
        files = [f for f in folder.iterdir() if f.is_file()]
    except OSError:
        return None
    n = name.lower()
    exact = [f for f in files if f.name.lower() == n or f.stem.lower() == n]
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        return None
    part = [f for f in files if n in f.name.lower()]
    return part[0] if len(part) == 1 else None


def parse_recycle_task(task: str) -> Optional[RecycleTask]:
    """Deterministic Layer 0 for (a) 'put <file on Desktop/Documents/Downloads> into the Recycle Bin [and empty it]' and
    (b) 'open the Recycle Bin and clear it'.  The path is derived from the TASK TEXT + the known-folder API and must resolve to ONE existing file."""
    if not re.search(r"回收站|recycle bin", task, re.I):
        return None
    m = _RECYCLE_FILE.search(task)
    if m:
        folder = known_folder(m.group("folder"))
        f = find_in_folder(folder, m.group("name").strip("“”\"'"))
        if f is None:
            return None
        return RecycleTask(m.group("folder"), folder, f, bool(_EMPTY_INTENT.search(task)))
    if _EMPTY_INTENT.search(task) and not re.search(r"桌面|文档|下载|文件夹|邮件|邮箱|网页", task):
        return RecycleTask(empty=True)
    return None
