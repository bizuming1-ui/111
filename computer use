pub fn foreground() -> i64 {
    unsafe {
        let h = GetForegroundWindow();
        let r = GetAncestor(h, GA_ROOT);
        hwnd_id(if r.0.is_null() { h } else { r })
    }
}

pub fn window_info(h: HWND, fg: i64) -> Option<WindowInfo> {
    unsafe {
        if !IsWindowVisible(h).as_bool() {
            return None;
        }
        let mut t = [0u16; 512];
        let n = GetWindowTextW(h, &mut t);
        let mut c = [0u16; 256];
        let cn = GetClassNameW(h, &mut c);
        let title = String::from_utf16_lossy(&t[..n.max(0) as usize]);
        let class = String::from_utf16_lossy(&c[..cn.max(0) as usize]);
        let mut pid = 0u32;
        GetWindowThreadProcessId(h, Some(&mut pid));
        let mut r = RECT::default();
        let _ = GetWindowRect(h, &mut r);
        let (process, elevated) = proc_info(pid);
        let is_java = class.starts_with("SunAwt") || class == "SWT_Window0" && process.to_lowercase().starts_with("java");
        let id = hwnd_id(h);
        Some(WindowInfo { window_id: id, title, class, pid, process, rect: [r.left, r.top, r.right, r.bottom], is_java, elevated, foreground: id == fg })
    }
}

pub fn list_windows() -> Vec<WindowInfo> {
    let mut v: Vec<HWND> = Vec::new();
    unsafe {
        let _ = EnumWindows(Some(enum_cb), LPARAM(&mut v as *mut _ as isize));
    }
    let fg = foreground();
    v.into_iter()
        .filter_map(|h| window_info(h, fg))
        .filter(|w| !w.title.is_empty() && w.rect[2] > w.rect[0] && w.rect[3] > w.rect[1])
        .collect()
}
