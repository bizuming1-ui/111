    $u = $null; try { $u = [System.Uri]::new($Url) } catch { return [pscustomobject]@{ Origin = 'invalid:'; Level = 'critical'; Tainted = $true } }
    $scheme = $u.Scheme.ToLowerInvariant(); $hostName = "$($u.Host)".ToLowerInvariant()
