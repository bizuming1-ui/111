}

fn proc_info(pid: u32) -> (String, bool) {
    unsafe {
        match OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) {
            Ok(h) => {
                let mut buf = [0u16; 520];
                let mut len = buf.len() as u32;
                let name = if QueryFullProcessImageNameW(h, PROCESS_NAME_WIN32, PWSTR(buf.as_mut_ptr()), &mut len).is_ok() {
                    let full = String::from_utf16_lossy(&buf[..len as usize]);
                    full.rsplit('\\').next().unwrap_or("").to_string()
                } else {
                    String::new()
                };
                let elevated = token_flag(h, TokenElevation);
                let _ = CloseHandle(h);
                (name, elevated)
            }
            Err(_) => (String::new(), true), // access denied for a limited query => a higher-integrity process
        }
    }
}

unsafe extern "system" fn enum_cb(hwnd: HWND, lp: LPARAM) -> BOOL {
