@dataclass
class TextLine:
    rect: list  # [x, y, w, h] SCREEN physical pixels
    text: str
    src: str = "ocr"

    @property
    def cx(self) -> float:
        return self.rect[0] + self.rect[2] / 2.0

    @property
    def cy(self) -> float:
        return self.rect[1] + self.rect[3] / 2.0


def to_lines(items: Iterable[Any]) -> list:
    out = []
    for it in items or []:
        if isinstance(it, TextLine):
            out.append(it)
        elif isinstance(it, dict):
            r, t = it.get("box") or it.get("rect"), it.get("text")
            if r and t and len(r) == 4:
                out.append(TextLine([int(v) for v in r], str(t), str(it.get("text_src") or "ocr")))
        elif isinstance(it, (tuple, list)) and len(it) >= 2 and it[1]:
            out.append(TextLine([int(v) for v in it[0]], str(it[1]), str(it[2]) if len(it) > 2 else "ocr"))
    return out


@dataclass
class WeChatGeometry:
    """Layout of the Weixin 4.x / WeChat 3.9 main window in PHYSICAL pixels (dpi = GetDpiForWindow/96).  Pure arithmetic => unit-testable."""
    x: int
    y: int
    w: int
    h: int
    dpi: float = 1.0

    def d(self, v: float) -> int:
        return int(round(v * self.dpi))

    @property
    def search_rect(self) -> list:
        return [self.x + self.d(54), self.y, self.d(260), self.d(70)]

    @property
    def list_rect(self) -> list:  # left column: search results / conversation list (below the search box)
        return [self.x + self.d(54), self.y + self.d(70), self.d(262), self.h - self.d(70)]

    @property
    def chat_x0(self) -> int:
        return self.x + self.d(300)

    @property
    def header_rect(self) -> list:  # top band of the chat pane: conversation title
        return [self.chat_x0, self.y, self.x + self.w - self.chat_x0, self.d(100)]

    @property
    def input_rect(self) -> list:  # bottom panel: editor
        top = self.y + self.h - self.d(170)
        return [self.chat_x0, top, self.x + self.w - self.chat_x0, self.y + self.h - top]

    @property
    def msg_right_rect(self) -> list:  # right half of the window, between header and editor: where OUR sent bubbles live (x > 50 %)
        x0 = self.x + self.w // 2
        y0 = self.y + self.d(100)
        y1 = self.y + self.h - self.d(170)
        return [x0, y0, self.x + self.w - x0, max(40, y1 - y0)]

    @property
    def input_click(self) -> tuple:
        r = self.input_rect
        return (r[0] + int(r[2] * 0.40), self.y + self.h - self.d(75))

    @staticmethod
    def inside(rect: list, cx: float, cy: float) -> bool:
        return rect[0] <= cx <= rect[0] + rect[2] and rect[1] <= cy <= rect[1] + rect[3]

    def in_list(self, ln: TextLine) -> bool:
        return self.inside(self.list_rect, ln.cx, ln.cy)

    def in_header(self, ln: TextLine) -> bool:
        return self.inside(self.header_rect, ln.cx, ln.cy) and ln.rect[0] >= self.chat_x0 - self.d(8)

    def in_input(self, ln: TextLine) -> bool:
        return self.inside(self.input_rect, ln.cx, ln.cy)

    def in_msg_right(self, ln: TextLine) -> bool:
        return self.inside(self.msg_right_rect, ln.cx, ln.cy) and ln.cx > self.x + self.w * 0.5


def pick_contact(lines: Iterable[TextLine], recipient: str, geo: WeChatGeometry) -> tuple:
    """-> (TextLine|None, section, reason).  EXACT name match only; 联系人 section first, never 群聊/聊天记录/公众号; ambiguity => None."""
    r = cj(recipient)
    left = sorted((l for l in lines if geo.in_list(l)), key=lambda l: (l.rect[1], l.rect[0]))
    section = ""
    exact = []
    near = []
    for l in left:
        t = cj(l.text)
        sec = next((s for s in SECTION_OK + SECTION_BAD + SECTION_NEUTRAL if t == cj(s)), "")
        if sec:
            section = sec
            continue
        if t == r:
            exact.append((section, l))
        elif r and r in t and len(t) <= len(r) + 14:
            near.append((section, l))
    good = [(s, l) for s, l in exact if cj(s) not in {cj(x) for x in SECTION_BAD}]
    if len(good) == 1:
        return good[0][1], good[0][0] or "(无分区标题)", "exact"
    if len(good) > 1:
        pref = [(s, l) for s, l in good if cj(s) in {cj(x) for x in SECTION_OK}]
        if len(pref) == 1:
            return pref[0][1], pref[0][0], "exact(联系人分区优先)"
        return None, "", f"AMBIGUOUS：{len(good)} 个与「{recipient}」完全同名的候选，拒绝猜测"
    if exact:
        return None, "", f"「{recipient}」只出现在 {exact[0][0]} 分区（群聊/聊天记录/公众号），不是联系人"
    if near:
        return None, "", f"没有与「{recipient}」完全同名的联系人（近似项: {near[0][1].text[:20]!r}）；不做模糊点击"
    return None, "", f"搜索结果中没有「{recipient}」（OCR 读到 {len(left)} 行）"


def verify_chat_header(lines: Iterable[TextLine], recipient: str, geo: WeChatGeometry) -> tuple:
    """-> (is_exact_single_chat, group_marker_found, evidence).  Header title must EQUAL the recipient; '(N)' / 群聊 anywhere in the header band => group."""
    r = cj(recipient)
    band = [l for l in lines if geo.in_header(l)]
    texts = [l.text.strip() for l in band]
    if any(CHAT_GROUP_MARK.search(t) and r in cj(t) for t in texts) or any(re.search(r"群聊|群成员", t) for t in texts):
        return False, True, "头部检测到群聊标记：" + " | ".join(t[:20] for t in texts[:4])
    ex = [l for l in band if cj(l.text) == r]
    if ex:
        return True, False, f"头部 {ex[0].src.upper()} 精确读到「{ex[0].text.strip()[:24]}」== 联系人，且无群成员数后缀 → 单聊"
    return False, False, "头部未读到与联系人完全相同的标题（读到: " + (" | ".join(t[:16] for t in texts[:4]) or "空") + "）"


def count_bubbles(lines: Iterable[TextLine], body: str, geo: WeChatGeometry) -> tuple:
    """-> (count of bubbles containing `body` in the right half of the message area, lowest y)."""
    b = cj(body)
    right = sorted((l for l in lines if geo.in_msg_right(l)), key=lambda l: (l.rect[1], l.rect[0]))
    if not b:
        return 0, -1
    n, last_y = 0, -1
    for l in right:
        c = cj(l.text).count(b)
        if c:
            n += c
            last_y = max(last_y, l.rect[1])
    if n == 0 and len(b) > 8:  # long body wrapped over several lines: join up to 5 consecutive right-side lines
        for i in range(len(right)):
            joined = ""
            for l in right[i:i + 5]:
                joined += cj(l.text)
                if b in joined:
                    n += 1
                    last_y = max(last_y, l.rect[1])
                    break
    return n, last_y


def input_text_from_ocr(lines: Iterable[TextLine], geo: WeChatGeometry) -> str:
    rows = sorted((l for l in lines if geo.in_input(l)), key=lambda l: (l.rect[1] // 10, l.rect[0]))
    return "".join(l.text for l in rows)


