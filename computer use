function Get-Observation {
    Test-Abort
    $fg = Get-ForegroundInfo
    $script:ObsHwnd = $fg.Handle
    $sw = [DsNative4]::PrimaryW(); $sh = [DsNative4]::PrimaryH()
    $cursor = [DsNative4]::CursorPos()
