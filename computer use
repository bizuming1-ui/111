        'off' { $script:V11.NoL0 = $true; $script:V11.NoEscape = $true; Write-Host 'v11 的 Layer 0 / 脱困矩阵已关闭（本会话）。' -ForegroundColor Yellow }
        'on' { $script:V11.NoL0 = $false; $script:V11.NoEscape = $false; Write-Host 'v11 的 Layer 0 / 脱困矩阵已开启。' -ForegroundColor Green }
        'brain' {
            if (-not $rest) { Write-Host '用法：v11 brain <任务文本>   （Python 统一大脑；需 python；Rust 驱动 / CDP 守护在线时自动接入）' -ForegroundColor Yellow; return }
            $py = Get-V11Python; if (-not $py) { Write-Host '需要 python 3.10+' -ForegroundColor Yellow; return }
            $x = Export-V11Workspace ''; Push-Location $x.Dir
