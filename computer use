[void](New-Item -ItemType Directory -Force -Path $work)
$exe = Join-Path $work 'dscu-driver.exe'
Copy-Item -LiteralPath $DriverExe -Destination $exe -Force
$manifest = Join-Path $work 'dscu-driver.exe.manifest'
