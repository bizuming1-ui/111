        self.assertNotIn("key", brain.hub.actions)
        self.assertIn("CLOSE_GUARD", "\n".join(out))

    def test_typing_flow_effect_is_measured(self):
        def fn(m, n):
            if "第 1 步观察" in str(m[-1]["content"]):
                return {"thought": "输入", "step": 1, "expect": "编辑器出现文字", "action": "type", "id": 1, "text": "hello world"}
