"""v16.3 Single Coordinate Normalizer - ONE place that converts between every pixel space the agent touches.

Spaces (never mix them implicitly):
  CSS    : CSS logical pixel inside the page viewport (what getBoundingClientRect / elementFromPoint use; already includes page zoom)
  VIEW   : the browser viewport rectangle on the desktop = CSS * dpr, origin = top-left of the *web contents* (below tabs / address bar / bookmarks bar)
  PHYS   : Virtual-Desktop physical pixel (SendInput absolute / UIA BoundingRectangle / GetWindowRect under Per-Monitor-V2). Can be NEGATIVE (monitor left of / above primary)
  DXGI   : pixel inside a (possibly down-scaled) screenshot of ONE monitor: (PHYS - monitor.origin) * scale

Truth hierarchy for the viewport origin (source field):
  1. hwnd-client  : ClientToScreen(0,0) of Chrome_RenderWidgetHostHWND of the attached browser process tree (exact; includes toolbar / bookmarks / infobars / DPI / negative monitors)
  2. screenxy     : window.screenX/Y (DIP) * monitor scale + (outerHeight - innerHeight*zoom) chrome offset (estimate, uncertainty is reported)
  3. injected     : tests / callers that already know the origin
dpr is always `window.devicePixelRatio` (= monitor scale x page zoom): physical px per CSS px, the one number Chrome itself guarantees.

Geometry cache: a ViewportGeometry is only reused while its fingerprint (window rect, dpr, inner size, screenX/Y, page id, epoch) is unchanged.  Window move / resize /
zoom / tab switch / monitor change => `GeometryCache.get()` returns None (stale geometry can never be used to click).
"""
from __future__ import annotations

import ctypes
import hashlib
import math
import sys
import time
from dataclasses import dataclass, field
from typing import Any, Callable, Iterable, Optional

IS_WIN = sys.platform == "win32"

Rect = tuple[int, int, int, int]  # x, y, w, h


@dataclass(frozen=True)
class Monitor:
    index: int
    left: int
    top: int
    right: int
    bottom: int
    dpi: int = 96  # effective DPI (96 = 100%)
    primary: bool = False

    @property
    def scale(self) -> float:
        return self.dpi / 96.0

    @property
    def width(self) -> int:
        return self.right - self.left

    @property
    def height(self) -> int:
        return self.bottom - self.top

    def contains(self, x: float, y: float) -> bool:
        return self.left <= x < self.right and self.top <= y < self.bottom

    def distance2(self, x: float, y: float) -> float:
        dx = max(self.left - x, 0, x - self.right + 1)
        dy = max(self.top - y, 0, y - self.bottom + 1)
        return dx * dx + dy * dy


def monitor_for_point(monitors: Iterable[Monitor], x: float, y: float) -> Optional[Monitor]:
    ms = list(monitors)
    for m in ms:
        if m.contains(x, y):
            return m
    return min(ms, key=lambda m: m.distance2(x, y)) if ms else None


@dataclass(frozen=True)
class ViewportGeometry:
    origin_x: int  # PHYS px of CSS (0,0)
    origin_y: int
    dpr: float  # PHYS px per CSS px
    css_w: int
    css_h: int
    source: str = "injected"  # hwnd-client | screenxy | injected
    monitor: Optional[Monitor] = None
    fingerprint: str = ""
    est_error_px: float = 0.0  # documented uncertainty of the origin source

    @property
    def phys_rect(self) -> Rect:
        return (self.origin_x, self.origin_y, int(round(self.css_w * self.dpr)), int(round(self.css_h * self.dpr)))

    def to_dict(self) -> dict[str, Any]:
