class FakeDxcam:
    """Protocol-faithful stand-in for dxcam 0.0.5 (name-mangled buffer/head/lock + background capture thread). Used ONLY when real dxcam is unavailable."""

    class DXCamera:
        def __init__(self, h=1600, w=2560):
            self._DXCamera__frame_buffer = np.zeros((1, h, w, 4), np.uint8)
            self._DXCamera__head = 0
            self._DXCamera__lock = threading.Lock()
            self._DXCamera__frame_count = 0
            self.is_capturing, self._t, self.h, self.w = False, None, h, w

        def start(self, region=None, target_fps=60, video_mode=False, delay=0):
            self.is_capturing = True

            def loop():
                rng = np.random.default_rng(1)
                while self.is_capturing:
                    with self._DXCamera__lock:
                        self._DXCamera__frame_buffer[0, ::7, ::7] = rng.integers(0, 255, (self.h // 7 + 1, self.w // 7 + 1, 4), dtype=np.uint8)
                        self._DXCamera__frame_count += 1
                    time.sleep(1 / target_fps)

            self._t = threading.Thread(target=loop, daemon=True)
            self._t.start()

        def stop(self):
            self.is_capturing = False

        def get_latest_frame(self):
            return self._DXCamera__frame_buffer[0].copy()

        def grab(self):
            return self._DXCamera__frame_buffer[0].copy()

    @staticmethod
    def create(output_color="BGRA", max_buffer_len=64, **kw):
        return FakeDxcam.DXCamera()


