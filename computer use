def render_elements(obs: Observation) -> tuple[str, dict[int, Element]]:
    order = ordered_elements(obs)
    els: dict[int, Element] = {}
    lines = []
    for i, e in enumerate(order, 1):
        els[i] = e
        cx, cy = e.center
        v = f' value="{e.value[:40]}"' if e.value else ""
        st = (" " + ",".join(e.states)) if e.states else ""
        row = f" R{e.row}" if e.row else ""
        lines.append(f'[{i}] {e.role} "{e.name[:50]}"{v}{st} zone={e.zone}{row} @({cx},{cy})')
