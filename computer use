#region ---------- v9.1 Phase 7.1：运行日志驱动的生产稳定化（只增不改 · Strangler Fig）
# 运行日志暴露的 5 个缺陷与本区块的对应关系：
#   ① 浏览器 CDP 未挂载 → Invoke-CdpTakeover / Invoke-CdpGuardian（强制接管：独立 Profile + 调试端口 + SetForegroundWindow）+ cdp_navigate / cdp_wait_selector 一等公民动作
#   ② REPEAT_EFFECT 误杀无状态导航 → Get-StatelessReason / Register-StatelessAction（enter / ctrl+l / scroll / cdp_navigate / URL 输入豁免；4 次相同且页面未变才拦）
#   ③ 浏览器视觉兜底盲区（工具栏 6~110 个 UIA 控件使 UIA_BLIND<6 永不触发）→ Update-SemanticStall（(标题|URL, aHash) 滑动窗口，连续 2 步无进展 → SEMANTIC_STALL 强制升级视觉）
#   ④ 缺少只读文件校验原语 → file_stat / dir_list（Path Jail 白名单根 + 只读 + 仅返回元数据与布尔校验，不回显内容、不执行脚本）
$script:P71Ver = '9.1-phase7.1'
$script:StatelessActionKinds = @('scroll', 'wait', 'inspect', 'ocr', 'vision_inspect', 'cdp_navigate', 'cdp_wait_selector', 'file_stat', 'dir_list', 'focus_window')
$script:StatelessNavTypeRx = '^\s*(?:(?:https?)://\S+|www\.\S+|(?:[a-z0-9\-]+\.)+[a-z]{2,}(?::\d+)?(?:[/?#]\S*)?)\s*$'
$script:StatelessTrail = [System.Collections.Generic.List[string]]::new()
$script:StatelessLoopMax = 4
$script:SemWin = [System.Collections.Generic.List[object]]::new()
$script:SemStall = [pscustomobject]@{ Active = $false; Streak = 0; Cooldown = 0; Triggers = 0; Where = ''; Why = '' }
$script:SemStallNoteText = ''
$script:SemStallSteps = 2          # 连续 N 步（期间执行过动作）页面签名不变 → 判定语义停滞
$script:SemHashTol = 2             # aHash 汉明距离容差（光标闪烁 / 视频角标不算变化）
$script:ActCounter = 0
$script:CdpTakeoverTries = 0
$script:P71Stats = [pscustomobject]@{ StatelessPass = 0; StallTriggers = 0; Takeovers = 0; CdpNavigate = 0; FileStat = 0; DirList = 0; WaitSelector = 0 }
$script:BrowserIntentRx = '(?i)(浏览器|\bchrome\b|\bedge\b|msedge|\bbrave\b|网页|网站|网址|https?://|\bwww\.|[a-z0-9\-]+\.(com|cn|net|org|io|tv|cc)\b|抖音|百度|淘宝|京东|bilibili|b站|微博|知乎|小红书|youtube|google|bing|github|热榜|上网|搜索一下)'

function Test-AllStatelessKeys([string]$Keys) {
    # 单键或按键序列（空格分隔）全部属于「无状态导航 / 交互键」时返回 $true
    $k = ("$Keys" -replace '\s*\+\s*', '+').Trim().ToLower()
    if ($k -eq '') { return $false }
    $toks = @($k -split '\s+' | Where-Object { $_ })
    if ($toks.Count -lt 1) { return $false }
    foreach ($t in $toks) { if ($t -notmatch $script:SafeRepeatKeys) { return $false } }
    return $true
}
function Get-StatelessReason($a, [string]$kind) {
    # 返回 $null = 有状态动作（照常受动作账本约束）；否则返回豁免原因
    if ($kind -in $script:StatelessActionKinds) { return "stateless:$kind" }
    if ($kind -in 'key', 'hotkey') { if (Test-AllStatelessKeys "$($a.keys)") { return 'stateless-key' } }
    if ($kind -eq 'type') {
        $t = "$($a.text)"
        if ($t.Length -gt 0 -and $t.Length -le 2048 -and $t -match $script:StatelessNavTypeRx) { return 'stateless-nav-type' }
    }
    return $null
}
function Register-StatelessAction($a, [string]$kind, [string]$reason) {
    # 无状态动作不进账本，但留一条轻量轨迹：同一动作连续 N 次且页面签名从未变化 = 空转，拒绝（防止豁免变成死循环）
    if ($kind -in 'key', 'hotkey', 'type', 'scroll', 'cdp_navigate') { $script:P71Stats.StatelessPass++ }
    $key = switch ($kind) { { $_ -in 'key', 'hotkey' } { "key|$("$($a.keys)".Trim().ToLower())" } 'type' { "type|$("$($a.text)".Trim().ToLower())" } 'cdp_navigate' { "nav|$("$($a.url)".Trim().ToLower())" } default { $null } }
    if ($null -eq $key) { return }
    $script:StatelessTrail.Add($key)
    while ($script:StatelessTrail.Count -gt 8) { $script:StatelessTrail.RemoveAt(0) }
    $n = $script:StatelessTrail.Count
    if ($n -ge $script:StatelessLoopMax) {
        $same = $true
        for ($i = $n - $script:StatelessLoopMax; $i -lt $n; $i++) { if ($script:StatelessTrail[$i] -ne $key) { $same = $false; break } }
        if ($same) {
            $script:StatelessTrail.Clear()
            throw "[REPEAT_NOEFFECT] 无状态动作「$(Limit-Text $key 60)」已连续 $($script:StatelessLoopMax) 次且页面签名（标题/URL + 画面哈希）始终没有变化——这是空转而不是进展。请换方法：浏览器任务用 cdp_navigate 直达正确网址 / cdp_wait_selector 等元素；或 vision_inspect 看真实页面（可能是 404 / 登录墙 / 验证码）。"
        }
    }
}
function Reset-SemanticStall([switch]$Full, [int]$Cooldown = 0) {
    $script:SemWin.Clear()
    $script:SemStall.Active = $false; $script:SemStall.Streak = 0; $script:SemStall.Cooldown = $Cooldown
    if ($Full) { $script:SemStall.Triggers = 0; $script:ActCounter = 0; $script:StatelessTrail.Clear(); $script:SemStallNoteText = '' }
}
function Get-SemanticSig($obs) {
    $where = ''
    try { if ($obs.Cdp -and "$($obs.Cdp.Url)") { $where = "$($obs.Cdp.Url)" } } catch { }
    if (-not $where) { try { $where = "$($obs.Foreground.Title)" } catch { } }
    $hash = ''
    try { if ($null -ne $obs.Pix) { $h = Get-RegionAHash ([byte[]]$obs.Pix); if ($h) { $hash = "$h" } } } catch { }
    return [pscustomobject]@{ Where = $where; Hash = $hash; Acts = [int]$script:ActCounter }
}
function Update-SemanticStall($obs) {
    # Semantic Stall Detector：每步一次。记录 (标题|URL, 区域 aHash)；若连续 SemStallSteps 步「期间执行过动作」但页面签名仍相同 → Active
    if ($null -eq $obs) { return }
    $cur = Get-SemanticSig $obs
    $win = $script:SemWin
    $streak = 0
    if ($win.Count -gt 0) {
        $idx = $win.Count - 1
        $next = $cur
        while ($idx -ge 0) {
            $prev = $win[$idx]
            $sameWhere = ($prev.Where -eq $next.Where)
            $sameHash = ((Measure-HashDistance $prev.Hash $next.Hash) -le $script:SemHashTol) -or ([string]::IsNullOrEmpty($prev.Hash) -and [string]::IsNullOrEmpty($next.Hash))
            if ($sameWhere -and $sameHash -and $next.Acts -gt $prev.Acts) { $streak++; $next = $prev; $idx-- } else { break }
        }
    }
    $win.Add($cur)
    while ($win.Count -gt 8) { $win.RemoveAt(0) }
    $script:SemStall.Streak = $streak
    if ($streak -eq 0) { $script:StatelessTrail.Clear() }   # 页面签名变了 = 有进展，空转计数归零
    if ($script:SemStall.Cooldown -gt 0) { $script:SemStall.Cooldown--; $script:SemStall.Active = $false; return }
    if ($streak -ge [int]$script:SemStallSteps) {
        $script:SemStall.Active = $true; $script:SemStall.Where = $cur.Where
        $script:SemStall.Why = "语义停滞：连续 $streak 步动作后页面签名未变（$(Limit-Text $cur.Where 70)；画面哈希 $($cur.Hash)）"
        $script:SemStallNoteText = "【语义停滞】$($script:SemStall.Why)。同一导航 / 输入动作不会带来不同结果：不要再重复地址栏输入或按 Enter；先看图确认页面真实状态（是否 404 /「内容不存在」/ 登录墙 / 验证码 / 弹窗遮挡）；浏览器任务请改用 cdp_navigate 直达正确 URL，并用 cdp_wait_selector 等待目标元素。"
    }
    else { $script:SemStall.Active = $false }
}
function Get-SemanticStallNote { $n = $script:SemStallNoteText; $script:SemStallNoteText = ''; return $n }

