async def status(brain: Brain) -> dict:
    from . import memwatch

    d = await brain.driver.call("info", timeout=5)
    c = None
    if brain.cdp is not None:
        try:
            c = await brain.cdp.info()
        except Exception as e:  # noqa: BLE001
            c = {"error": str(e)}
    return {"driver": d, "cdp": c, "memory": memwatch.stack_report(brain.sup.pids()), "free_mb": memwatch.free_mb()}


async def amain(argv: list[str]) -> int:
    ap = argparse.ArgumentParser("agent_brain")
    ap.add_argument("task", nargs="?")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--model", default=os.environ.get("DEEPSEEK_MODEL", "deepseek-chat"))
    ap.add_argument("--vision-model", default=os.environ.get("DEEPSEEK_VISION_MODEL", "deepseek-flash"))
    ap.add_argument("--no-layer0", action="store_true", help="drive the GUI instead of the deterministic file primitive")
    ap.add_argument("--approve-host", action="append", default=[], help="private host pre-approved by the human (repeatable)")
    a = ap.parse_args(argv)
    key = os.environ.get("DEEPSEEK_API_KEY", "").strip() or None
    brain = Brain(key, interactive=sys.stdin.isatty(), prefer_layer0=not a.no_layer0, approved_hosts=tuple(a.approve_host), model=a.model, vision_model=a.vision_model)
    try:
        await brain.start()
    except BrainError as e:
        print(f"启动失败: {e}")
        return 2
    try:
        if a.status:
            print(json.dumps(await status(brain), ensure_ascii=False, indent=2))
            return 0
        if a.task:
            r = await brain.run_task(a.task)
