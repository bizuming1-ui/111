"""
v18.1 Alternative-Route Recovery Planner — replaces “4 consecutive no-progress steps → hand the task back to the user”.

Log 8388968 task #3: `删除相机文件` → Desktop NOT_FOUND → the model tried a permanent Recycle-Bin delete → SECURITY_DENIED → no alternative existed in its head → 4 idle steps → paused_for_user.
Now every task owns a RouteGraph; a failed edge is recorded as a structured BlockedEdge and the planner IMMEDIATELY selects the next LEGAL route:

    file delete  : Layer0 Desktop/Documents/Downloads locate → recycle_file   ─┐  NOT_FOUND / SECURITY_DENIED / ACTION_NO_EFFECT
                   Recycle-Bin COM locate → already-deleted evidence (or authorized controlled single-item purge)   ─┤  = BlockedEdge → next route
                   controlled GUI (LLM loop with frozen identities + forbidden list + this directive)               ─┘
    web          : API/CLI → CDP/MCP → UIA → DirectML+OCR+SoM

Only two things end a task in a hand-back:  (1) a REAL blocker no route can pass (2FA / login wall / captcha / ambiguous destructive target / user declined),
(2) every legal route is exhausted — and then the report lists every BlockedEdge with its structured reason.  Illegal routes (irreversible without explicit
authorization) are never offered: the planner cannot "find a way" around the safety policy.
"""
from __future__ import annotations

import time
from dataclasses import dataclass, field
from typing import Any, Optional

REAL_BLOCKERS = {"AUTH_WALL", "TWO_FA", "CAPTCHA", "UAC_PROMPT", "USER_DECLINED", "NEEDS_CLARIFICATION", "AMBIGUOUS_TARGET", "OBJECT_IDENTITY_MISMATCH"}
BLOCKING_CODES = {"SECURITY_DENIED", "NOT_FOUND", "ACTION_NO_EFFECT", "UNSUPPORTED", "INTERNAL", "TIMEOUT", "STALE_EPOCH", "OCCLUDED", "UIPI_DENIED", "FOREGROUND_FAILED"}


@dataclass(frozen=True)
class Route:
    route_id: str
    label: str
    layer: int                     # 0 deterministic primitive · 1 API/CLI · 2 structured UI (CDP/UIA) · 3 vision / controlled GUI
    kind: str                      # fs_recycle | bin_evidence | bin_purge | bin_restore | gui_controlled | api_cli | cdp_mcp | uia | dml_ocr_som
    needs_auth: bool = False       # irreversible: only legal when the GoalSpec is explicitly authorized
    llm: bool = False              # executed by the model loop (constrained by the directive) instead of a deterministic primitive
    requires: str = ""             # fact name; planner skips the route (without blocking it) when facts[requires] is False


@dataclass
class BlockedEdge:
    route_id: str
    code: str
    detail: str
    ts: float = field(default_factory=time.time)

    def render(self) -> str:
        return f"{self.route_id}⇒{self.code}（{self.detail[:90]}）"


@dataclass
class Decision:
    action: str                    # run | handoff
    route: Optional[Route] = None
    reason: str = ""
    real_blocker: bool = False
    human_message: str = ""


class RouteGraph:
    def __init__(self, routes: list[Route]) -> None:
        self.routes = {r.route_id: r for r in routes}
        self.order = [r.route_id for r in routes]

    def successors(self, rid: str) -> list[str]:
        i = self.order.index(rid) if rid in self.order else -1
        return self.order[i + 1:]

    @staticmethod
    def for_goal(goal: Any) -> "RouteGraph":
        fs = Route("fs_recycle", "Layer 0：桌面/文档/下载 定位 → recycle_file（可恢复）" + ("→ 受控单文件清理" if getattr(goal, "permanent", False) else ""), 0, "fs_recycle",
                   needs_auth=bool(getattr(goal, "permanent", False)))
        evid = Route("bin_evidence", "回收站 COM 定位 → 已处于删除状态的独立证据", 0, "bin_evidence")
        purge = Route("bin_purge", "回收站 COM → 受控单对象清理（身份冻结·不可逆）", 0, "bin_purge", needs_auth=True)
        restore = Route("bin_restore", "回收站 COM → 还原（undelete 动词）", 0, "bin_restore")
        gui = Route("gui_controlled", "受控 GUI（模型循环：冻结身份 + 禁止列表 + 换路指令）", 3, "gui_controlled", llm=True)
        gui_auth = Route("gui_controlled", gui.label, 3, "gui_controlled", needs_auth=True, llm=True)
        verb, cont = getattr(goal, "verb", "delete"), getattr(goal, "container", "auto")
        if verb == "restore":
            return RouteGraph([restore, gui])
        if cont == "recyclebin":
            return RouteGraph([purge, gui_auth])
        if getattr(goal, "permanent", False):
            return RouteGraph([fs, purge, gui_auth])
        return RouteGraph([fs, evid, gui])

    @staticmethod
    def for_web() -> "RouteGraph":
        return RouteGraph([Route("api_cli", "API / CLI（确定性，无 GUI）", 1, "api_cli"), Route("cdp_mcp", "CDP / chrome-devtools-mcp（DOM 语义）", 2, "cdp_mcp"),
                           Route("uia", "UIA 控件树", 2, "uia"), Route("dml_ocr_som", "DXGI + DirectML + OCR + SoM（视觉）", 3, "dml_ocr_som", llm=True)])


def channel_of(action: dict[str, Any]) -> str:
    """Which web-route a model action belongs to (for BlockedEdge attribution in the LLM loop)."""
    n = str(action.get("action", ""))
    if n in ("run_powershell", "cli_run", "gmail_api") or n.startswith("cli_"):
        return "api_cli"
    if n.startswith("cdp_") or n in ("scroll_to", "select_rows", "toolbar_action"):
        return "cdp_mcp"
    if n.startswith("uia_") or n in ("invoke", "set_value", "focus_window"):
        return "uia"
    return "dml_ocr_som"


class RecoveryPlanner:
    def __init__(self, goal: Any = None, graph: Optional[RouteGraph] = None, max_retries: int = 1, max_reroutes: int = 6) -> None:
        self.goal = goal
        self.graph = graph or (RouteGraph.for_goal(goal) if goal is not None else RouteGraph.for_web())
        self.max_retries = max_retries
        self.max_reroutes = max_reroutes
        self.blocked: list[BlockedEdge] = []
        self.attempted: list[str] = []
        self.retries: dict[str, int] = {}
        self.skipped: dict[str, str] = {}
        self.reroutes = 0
        self.handoffs = 0
        self.current: Optional[str] = None

    # ------------------------------------------------------------------ legality
    def legal(self, r: Route) -> bool:
        if r.needs_auth and not bool(getattr(self.goal, "authorized_irreversible", False)):
            return False
        return True

    def blocked_ids(self) -> set[str]:
        return {b.route_id for b in self.blocked}

    # ------------------------------------------------------------------ decisions
    def next_route(self, facts: Optional[dict[str, Optional[bool]]] = None) -> Decision:
        facts = facts or {}
        real = [b for b in self.blocked if b.code in REAL_BLOCKERS]
        if real:
            return self._handoff(f"真实阻塞：{real[-1].render()}", real=True)
        if self.reroutes > self.max_reroutes:
            return self._handoff(f"换路次数已达上限 {self.max_reroutes}")
        blocked = self.blocked_ids()
        for rid in self.graph.order:
            r = self.graph.routes[rid]
            if rid in blocked:
                continue
            if not self.legal(r):
                self.skipped[rid] = "不合法：不可逆路线缺少任务原文的明确授权"
                continue
            if r.requires and facts.get(r.requires) is False:
                self.skipped[rid] = f"不适用：{r.requires}=False"
                continue
            if rid in self.attempted and self.retries.get(rid, 0) > self.max_retries:
                continue
            if self.current is not None and rid != self.current:
                self.reroutes += 1
            self.current = rid
            if rid not in self.attempted:
                self.attempted.append(rid)
            return Decision("run", r, f"{'重试' if self.retries.get(rid) else '选择'}路线 {rid}：{r.label}")
        return self._handoff("所有合法替代路线已穷尽：" + "；".join(b.render() for b in self.blocked[-4:]) if self.blocked else "没有可用的合法路线")

    def _handoff(self, why: str, real: bool = False) -> Decision:
        self.handoffs += 1
        return Decision("handoff", None, why, real, self.human_report(why))

    def record(self, route_id: str, code: str, detail: str = "") -> Optional[BlockedEdge]:
        """Record a failure on `route_id`.  ACTION_NO_EFFECT/TIMEOUT/STALE_EPOCH get ONE retry on the same route; everything else closes the edge immediately."""
        if code in ("ACTION_NO_EFFECT", "TIMEOUT", "STALE_EPOCH") and self.retries.get(route_id, 0) < self.max_retries:
            self.retries[route_id] = self.retries.get(route_id, 0) + 1
            return None
        edge = BlockedEdge(route_id, code, detail)
        if route_id not in self.blocked_ids():
            self.blocked.append(edge)
        return edge

    def block_if_new(self, route_id: str, code: str, detail: str = "") -> Optional[BlockedEdge]:
        return None if route_id in self.blocked_ids() else self.record(route_id, code, detail)

    # ------------------------------------------------------------------ reporting / LLM directive
    def remaining_routes(self) -> list[Route]:
        b = self.blocked_ids()
        return [self.graph.routes[r] for r in self.graph.order if r not in b and self.legal(self.graph.routes[r])]

    def human_report(self, why: str = "") -> str:
        lines = [why] if why else []
        if self.blocked:
            lines.append("已关闭的路线：" + " | ".join(b.render() for b in self.blocked))
        if self.skipped:
            lines.append("未提供的路线：" + " | ".join(f"{k}（{v}）" for k, v in self.skipped.items()))
        return "\n".join(lines)

    def directive_text(self) -> str:
        """Injected into the next model prompt: what is closed, what is still legal, and the exact next primitive to try."""
        if not self.blocked and not self.remaining_routes():
            return ""
        rem = self.remaining_routes()
        t = ["【自动换路 · Recovery Planner】"]
        if self.blocked:
            t.append("已关闭的路线（不要再尝试）：" + "；".join(b.render() for b in self.blocked))
        if rem:
            t.append("仍然合法的下一条路线：" + " → ".join(f"{r.route_id}（{r.label}）" for r in rem))
            t.append("请立即改用上述第一条路线；不要重复已失败的原语，不要诊断命令空转；每次只做一件事并读回独立证据。")
        else:
            t.append("没有剩余合法路线：请 action=fail 并如实说明已尝试的路线与失败原因。")
        return "\n".join(t)

    def summary(self) -> str:
        return f"路线 {'→'.join(self.attempted) or '-'} · BlockedEdge {len(self.blocked)} · 换路 {self.reroutes} · 交还人工 {self.handoffs}"
