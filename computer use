#Requires -Version 7.0
<#
.SYNOPSIS
  v15 dual-toolchain build of dscu-driver.exe (Rust: DXGI Desktop Duplication + UIA + SendInput, optional uiAccess manifest).
  The py-native tier (dxcam DXGI P50 ~7.8 ms + uiautomation) is NEVER removed: it stays the full-strength fallback whenever no toolchain works.
.EXAMPLE
  pwsh scripts/build_driver.ps1                    # -Target auto: MSVC if installed, else MinGW/LLVM (x86_64-pc-windows-gnu), else stay on py-native
  pwsh scripts/build_driver.ps1 -Target gnu        # force the no-Visual-Studio toolchain (needs MinGW-w64 or llvm-mingw on PATH)
  pwsh scripts/build_driver.ps1 -Target msvc -InstallTools   # winget-install rustup + VS Build Tools first
  pwsh scripts/build_driver.ps1 -UiAccess          # (elevated) additionally sign + install the uiAccess="true" copy into %ProgramFiles%\DSCU (cross-UIPI: controls admin windows)
#>
param(
    [string]$Root = (Split-Path -Parent $PSScriptRoot),
    [ValidateSet('auto', 'msvc', 'gnu', 'none')][string]$Target = 'auto',
    [switch]$InstallTools, [switch]$UiAccess
)
$ErrorActionPreference = 'Stop'
function Step($m) { Write-Host "▶ $m" -ForegroundColor Cyan }
function Warn($m) { Write-Host "  ⚠ $m" -ForegroundColor Yellow }
function Ok($m) { Write-Host "  ✓ $m" -ForegroundColor Green }
function Refresh-Path { $env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User') }

function Has-Msvc {
    $vw = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe'
    if (-not (Test-Path $vw)) { return $false }
    return [bool](& $vw -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath)
}
function Find-MingwGcc {
    foreach ($n in @('x86_64-w64-mingw32-gcc', 'gcc', 'x86_64-w64-mingw32-clang')) {
        $c = Get-Command $n -ErrorAction SilentlyContinue
        if ($c) {
            try { $t = (& $c.Source -dumpmachine 2>$null); if ($t -match 'mingw') { return $c.Source } } catch { }
        }
    }
    return $null
}

$result = [ordered]@{ target = $Target; toolchain = 'none'; driver = $false; reason = '' }
Set-Location $Root
$bin = Join-Path $Root 'bin'; New-Item -ItemType Directory -Force -Path $bin | Out-Null
if ($Target -eq 'none') { Ok 'Target=none → 保持 py-native 驱动'; return }

if ($InstallTools -and -not (Get-Command cargo -ErrorAction SilentlyContinue) -and (Get-Command winget -ErrorAction SilentlyContinue)) {
    Step '安装 Rustup'; winget install -e --id Rustlang.Rustup --accept-source-agreements --accept-package-agreements | Out-Host; Refresh-Path
}
$cargo = Get-Command cargo -ErrorAction SilentlyContinue
if (-not $cargo) { Warn '未找到 cargo（winget install -e --id Rustlang.Rustup，或加 -InstallTools）→ 继续使用 py-native（dxcam DXGI，功能等价）'; return }

$msvc = Has-Msvc
$gcc = Find-MingwGcc
if ($Target -eq 'auto') { $Target = if ($msvc) { 'msvc' } elseif ($gcc) { 'gnu' } else { 'none' } }
if ($Target -eq 'msvc' -and -not $msvc -and $InstallTools -and (Get-Command winget -ErrorAction SilentlyContinue)) {
    Step '安装 VS Build Tools（数 GB）'
    winget install -e --id Microsoft.VisualStudio.2022.BuildTools --accept-source-agreements --accept-package-agreements --override '--quiet --wait --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended' | Out-Host
    Refresh-Path; $msvc = Has-Msvc
}
Write-Host ("  工具链探测：MSVC={0}  MinGW/LLVM={1}  → 选用 {2}" -f $msvc, ($(if ($gcc) { $gcc } else { 'no' })), $Target)
if ($Target -eq 'none' -or ($Target -eq 'msvc' -and -not $msvc) -or ($Target -eq 'gnu' -and -not $gcc)) {
    Warn '所需工具链不可用 → 保持 py-native（dxcam 常驻 DXGI P50≈7.8ms + uiautomation）。免 MSVC 方案：安装 MinGW-w64（winget install -e --id BrechtSanders.WinLibs.POSIX.UCRT）后用 -Target gnu。'
    $result.reason = 'toolchain_missing'; $result | ConvertTo-Json | Set-Content (Join-Path $bin 'driver-build.json'); return
}

Push-Location (Join-Path $Root 'crates\dscu-driver')
try {
    if ($Target -eq 'gnu') {
        Step 'rustup target add x86_64-pc-windows-gnu'
        rustup target add x86_64-pc-windows-gnu 2>&1 | Out-Host
        $env:CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER = $gcc
        cargo build --release --target x86_64-pc-windows-gnu 2>&1 | Out-Host
        $exe = 'target\x86_64-pc-windows-gnu\release\dscu-driver.exe'
    } else {
        cargo build --release 2>&1 | Out-Host
        $exe = 'target\release\dscu-driver.exe'
    }
    if ($LASTEXITCODE -eq 0 -and (Test-Path $exe)) {
        Copy-Item $exe (Join-Path $bin 'dscu-driver.exe') -Force
        $result.toolchain = $Target; $result.driver = $true
        Ok "dscu-driver.exe ($Target) → $bin"
        try { Write-Host ('  DXGI 自检: ' + (& (Join-Path $bin 'dscu-driver.exe') --selftest-dxgi 30)) } catch { Warn "自检未通过：$($_.Exception.Message)" }
    } else { Warn "cargo build ($Target) 失败 → 回退 py-native"; $result.reason = 'cargo_failed' }
} finally { Pop-Location }

# merge into build-info.json so the brain can show the real tier
$bi = Join-Path $bin 'build-info.json'
try {
    $info = if (Test-Path $bi) { Get-Content $bi -Raw | ConvertFrom-Json -AsHashtable } else { @{} }
    $info['rust_driver'] = [bool]$result.driver; $info['tier'] = $(if ($result.driver) { 'rust' } else { 'py-native' }); $info['driver_toolchain'] = $result.toolchain
    ($info | ConvertTo-Json) | Set-Content $bi -Encoding utf8
} catch { Warn "build-info.json 更新失败：$($_.Exception.Message)" }
$result | ConvertTo-Json | Set-Content (Join-Path $bin 'driver-build.json')

if ($UiAccess -and $result.driver) {
    Step 'uiAccess="true"：签名 + 安装到 %ProgramFiles%\DSCU（需要管理员 pwsh）'
    & (Join-Path $Root 'scripts\setup-uiaccess.ps1') -Root $Root
}
'@
