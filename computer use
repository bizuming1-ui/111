  let level: TaintLevel;
  if (CRITICAL_SCHEMES.has(scheme)) level = 'critical';
  else if (scheme === 'https' && allow.some((d) => host === d || host.endsWith('.' + d))) level = 'low';
  else if (scheme === 'https') level = 'high';
  else level = 'critical';
  return { origin, level, tainted: true };
}

const rank: Record<TaintLevel, number> = { low: 0, high: 1, critical: 2 };

/** Tracks per-tab navigation + network facts and emits a signal only when the effective level rises or the origin changes. */
export class OriginMonitor {
  private tabs = new Map<string, { origin: string; level: TaintLevel }>();
  constructor(private allow: readonly string[], private emit: (s: TaintSignal) => void, private now: () => number = Date.now) {}

  navigated(tab: string, url: string): void {
    const c = classifyUrl(url, this.allow);
    this.set(tab, url, c.origin, c.level, 'navigation');
  }
  /** Network.responseReceived: downloads / executables / cross-scheme redirects escalate the tab to critical. */
  response(tab: string, url: string, mime: string, status: number): void {
    const cur = this.tabs.get(tab);
    const c = classifyUrl(url, this.allow);
    let level = c.level; let reason = 'response';
    if (/application\/(x-msdownload|x-msi|octet-stream|x-dosexec|vnd\.microsoft\.portable-executable)/i.test(mime)) { level = 'critical'; reason = 'executable-download'; }
    else if (status >= 300 && status < 400 && cur && cur.origin.startsWith('https://') && c.origin.startsWith('http://')) { level = 'critical'; reason = 'downgrade-redirect'; }
    if (cur && rank[level] <= rank[cur.level]) return;
    this.set(tab, url, c.origin, level, reason);
  }
  closed(tab: string): void { this.tabs.delete(tab); }
  level(tab: string): TaintLevel | undefined { return this.tabs.get(tab)?.level; }

  private set(tab: string, url: string, origin: string, level: TaintLevel, reason: string): void {
    const cur = this.tabs.get(tab);
    if (reason === 'navigation' || !cur || rank[level] > rank[cur.level]) {
      const changed = !cur || cur.origin !== origin || cur.level !== level;
      this.tabs.set(tab, { origin, level });
      if (changed) this.emit({ type: 'taint', tab, url, origin, level, tainted: true, reason, ts: this.now() });
    }
  }
}
