"""Trusted READ-ONLY application discovery (`app.resolve`) — Python fallback twin of the Rust primitive and of
`Resolve-V12App`.  Sources: registry App Paths / Uninstall, Start-Menu .lnk targets, MSIX/UWP AUMID (Get-StartApps),
running processes.  It only *reads* well-known system indexes: no filesystem crawl, no code execution => zero
[SECURITY_AST_VIOLATION] surface, deterministic cold start."""
from __future__ import annotations

import os
import re
import sys
from dataclasses import dataclass, asdict

SOURCE_PRIORITY = {"process": 5, "aumid": 4, "startmenu": 3, "apppaths": 3, "uninstall": 2}


@dataclass
class AppEntry:
    name: str                    # display name ("微信")
    source: str                  # process | aumid | startmenu | apppaths | uninstall
    exe: str = ""                # absolute .exe path (empty for pure UWP)
    aumid: str = ""              # AppUserModelID for shell:AppsFolder activation
    desc: str = ""               # FileDescription / ProductName of the exe (cross-language alias: Weixin <-> 微信)


def _norm(s: str) -> str:
    return re.sub(r"[\s_\-\.]+", "", s.lower().removesuffix(".exe"))


def match_score(query: str, e: AppEntry) -> float:
    q = _norm(query)
    if not q:
        return 0.0
    base = os.path.basename(e.exe.replace("\\", "/")) if e.exe else ""
    fields = [_norm(e.name), _norm(base), _norm(e.desc), _norm(e.aumid.split("!")[0].split("_")[0].split(".")[-1]) if e.aumid else ""]
    best = 0.0
    for i, f in enumerate(fields):
        if not f:
            continue
        if f == q:
            best = max(best, 100.0 if i == 0 else 95.0)
        elif f.startswith(q) or q.startswith(f) and len(f) >= 3:
            best = max(best, 70.0)
        elif q in f or (len(f) >= 3 and f in q):
            best = max(best, 50.0)
    if best == 0.0:
        return 0.0
    return best + SOURCE_PRIORITY.get(e.source, 0) * 0.5 + (2.0 if e.exe and e.aumid else 0.0)


def rank(query: str, entries: list[AppEntry], top: int = 5) -> list[dict]:
    seen: set[str] = set()
    out = []
    for e in sorted(entries, key=lambda x: match_score(query, x), reverse=True):
        sc = match_score(query, e)
        key = (e.exe or e.aumid).lower()
        if sc <= 0 or key in seen:
            continue
        seen.add(key)
        out.append({**asdict(e), "score": round(sc, 2)})
        if len(out) >= top:
            break
    return out


def launch_command(hit: dict) -> list[str] | None:
    """Deterministic activation vector for a resolved hit (never a shell string)."""
    if hit.get("exe", "").lower().endswith(".exe"):
        return [hit["exe"]]
    if hit.get("aumid"):
        return ["explorer.exe", f"shell:AppsFolder\\{hit['aumid']}"]
    return None


def index_windows() -> list[AppEntry]:  # pragma: no cover - Windows only
    """Reads App Paths / Uninstall via winreg; Start-Menu .lnk and AUMID are indexed by the PowerShell/Rust planes."""
    if sys.platform != "win32":
        return []
    import winreg
    out: list[AppEntry] = []
    for hive, sub, src in ((winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths", "apppaths"),
                           (winreg.HKEY_CURRENT_USER, r"SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths", "apppaths")):
        try:
            with winreg.OpenKey(hive, sub) as k:
                for i in range(winreg.QueryInfoKey(k)[0]):
                    n = winreg.EnumKey(k, i)
                    try:
                        with winreg.OpenKey(k, n) as kk:
                            p = str(winreg.QueryValueEx(kk, "")[0]).strip('"')
                        out.append(AppEntry(n.removesuffix(".exe"), src, p))
                    except OSError:
                        pass
        except OSError:
            pass
    return out
