function Invoke-Phase5SelfTest($rec) {
    # ① DsPhase5Native70 LockBits 极速灰度指纹 vs 传统 GetPixel 100% 字节一致性与耗时检验
    $bmpTest = [System.Drawing.Bitmap]::new(48, 32, [System.Drawing.Imaging.PixelFormat]::Format24bppRgb)
    try {
        for ($y = 0; $y -lt 32; $y++) {
            for ($x = 0; $x -lt 48; $x++) {
                $bmpTest.SetPixel($x, $y, [System.Drawing.Color]::FromArgb(($x * 5) % 256, ($y * 7) % 256, (($x + $y) * 3) % 256))
            }
        }
        $swFast = [System.Diagnostics.Stopwatch]::StartNew()
        $sigFast = [DsPhase5Native70]::ExtractGray48x32FromBitmap($bmpTest, $swFast)
        $fastUs = [DsPhase5Native70]::LastCaptureUs
        $sigSlow = New-Object 'byte[]' 1536
        for ($y = 0; $y -lt 32; $y++) {
            for ($x = 0; $x -lt 48; $x++) {
                $c = $bmpTest.GetPixel($x, $y)
                $sigSlow[$y * 48 + $x] = [byte][int]((299 * $c.R + 587 * $c.G + 114 * $c.B) / 1000)
            }
        }
        $diff = Get-PixelDiff $sigFast $sigSlow
        $dxgiHw = [DsPhase5Native70]::ProbeDxgiHardware()
        & $rec 'v7.0 Phase 5：LockBits + DXGI 极速指纹（与 GDI 逐像素 0.0% 误差，单帧提取 < 2ms）' ($null -ne $sigFast -and $sigFast.Length -eq 1536 -and $diff -eq 0.0) ("长度=$($sigFast.Length) 误差=${diff}% 耗时=${fastUs}us DXGI硬件=$dxgiHw")
    }
    finally { $bmpTest.Dispose() }

    # ② 24GB 统一内存（AMD Radeon 780M UMA）水位监控与 < 4096MB 熔断自检
    $mem = [DsPhase5Native70]::GetMemoryTelemetryMB()
    [DsPhase5Native70]::TouchSidecar()
    $tripLow = [DsPhase5Native70]::CheckUmaCircuitBreaker(4096, 3200)
    $unloadedOnTrip = (-not [DsPhase5Native70]::SidecarLoaded)
    [DsPhase5Native70]::TouchSidecar()
    $tripHigh = [DsPhase5Native70]::CheckUmaCircuitBreaker(4096, 8192)
    $keptOnHigh = [DsPhase5Native70]::SidecarLoaded
    & $rec 'v7.0 Phase 5：24GB UMA 内存水位熔断守卫（<4096MB 自动卸载本地侧车并降级 deepseek-flash）' ($mem[0] -gt 0 -and $tripLow -and $unloadedOnTrip -and (-not $tripHigh) -and $keptOnHigh) ("主机内存=$($mem[0])MB 可用=$($mem[1])MB 低水位熔断=$tripLow 侧车卸载=$unloadedOnTrip")

    # ③ SkillStore v2 衰减模型 + 任务 Checkpoint 保存/恢复 + 注入污染拒载
    $now = Get-Date
    $skFresh = [pscustomobject]@{ uses = 4; fails = 0; ts = $now.AddDays(-1).ToString('o') }
    $skStale = [pscustomobject]@{ uses = 1; fails = 3; ts = $now.AddDays(-60).ToString('o') }
    $wFresh = Get-SkillDecayWeight $skFresh $now
    $wStale = Get-SkillDecayWeight $skStale $now
    $cpFile = Save-TaskCheckpoint '打开设置检查显示分辨率' 3 2 @('launch ms-settings:display', 'click 分辨率')
    $cpLoaded = Restore-TaskCheckpoint $cpFile
    try { if ($cpFile -and (Test-Path -LiteralPath $cpFile)) { Remove-Item -LiteralPath $cpFile -Force -ErrorAction SilentlyContinue } } catch { }
    & $rec 'v7.0 Phase 5：SkillStore v2 技能衰减权重与长程状态 Checkpoint 回滚' (($wFresh -gt $wStale * 3.0) -and ($null -ne $cpLoaded) -and ([int]$cpLoaded.step -eq 3)) ("新技能权重=$wFresh 衰减技能权重=$wStale CheckpointStep=$($cpLoaded.step)")

    # ④ Named Pipe IPC 帧协议 + UIPI 清单生成 + 24GB 沙箱内存配额校验
    $rpcJson = [DsPhase5Native70]::BuildPipeRpc(7, 'dxgi_capture', '{"dirtyOnly":true}')
    $mfFile = Export-UiAccessManifest (Join-Path ([System.IO.Path]::GetTempPath()) "dscu-uipi-$PID")
    $mfOk = (Test-Path -LiteralPath $mfFile) -and ([System.IO.File]::ReadAllText($mfFile) -match 'uiAccess="true"')
    try { Remove-Item -LiteralPath ([System.IO.Path]::GetDirectoryName($mfFile)) -Recurse -Force -ErrorAction SilentlyContinue } catch { }
    & $rec 'v7.0 Phase 5：Named Pipe IPC 契约帧 + uiAccess="true" 清单生成' (($rpcJson -match '"method":"dxgi_capture"') -and $mfOk) ("RPC=$rpcJson uiAccessManifest=$mfOk")
}
