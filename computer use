    def from_elements(elements: Any, epoch: int = 0, context: str = "") -> "WorldSnapshot":
        """adapter for protocol.Element lists (the live observation)."""
        d = {}
        for e in elements:
            key = getattr(e, "stable_key", "") or getattr(e, "ref_id", "")
            st = tuple(sorted(str(s).lower() for s in (getattr(e, "states", None) or [])))
            d[key] = (((getattr(e, "name", "") or "")[:60]) + "|" + str(getattr(e, "value", "") or "")[:40], st)
        return WorldSnapshot(int(epoch), d, context)

    def digest(self) -> str:
        h = _v18_hashlib.sha256((self.context + "\n" + "\n".join(f"{k}={v}" for k, v in sorted(self.objects.items()))).encode("utf-8", "replace"))
