}


def verify(specs: list[dict], ctx: Ctx) -> dict[str, Any]:
    results = []
    for raw in specs:
        s = fmt(raw, ctx)
        fn = VERIFIERS.get(s.get("type", ""))
        if fn is None:
            results.append({"type": s.get("type"), "ok": False, "detail": "UNSUPPORTED verifier type (counted as FAIL, never a silent pass)", "negative": bool(s.get("negative"))})
            continue
        try:
            ok, detail = fn(s, ctx)
        except Exception as e:  # noqa: BLE001
            ok, detail = False, f"verifier error: {e}"
        results.append({"type": s["type"], "ok": bool(ok), "detail": detail[:300], "negative": bool(s.get("negative"))})
    pos = [r for r in results if not r["negative"]]
    neg = [r for r in results if r["negative"]]
    return {"ok": all(r["ok"] for r in results), "positive_ok": all(r["ok"] for r in pos), "guards_ok": all(r["ok"] for r in neg), "results": results}


# ---------------------------------------------------------------------------------------------------------------- WAA-schema compatibility
def waa_to_oracle(ev: dict[str, Any]) -> list[dict[str, Any]]:
    """Map the subset of WindowsAgentArena evaluator schema {func, result:{type,path|command}, expected:{type,rules|value}} onto native verifiers.
    Anything not understood is emitted as an UNSUPPORTED spec so the task FAILS loudly instead of being silently skipped."""
    func = ev.get("func")
    funcs = func if isinstance(func, list) else [func]
    res = ev.get("result") or {}
    exp = ev.get("expected") or {}
    out: list[dict[str, Any]] = []
    for i, f in enumerate(funcs):
        r = res[i] if isinstance(res, list) else res
        e = exp[i] if isinstance(exp, list) else exp
        path = (r or {}).get("path") or (r or {}).get("dest") or ""
        rules = (e or {}).get("rules", {}) if isinstance(e, dict) else {}
        if f in ("check_file_exists", "file_exists"):
            out.append({"type": "file_exists", "path": path})
        elif f in ("exact_match", "check_text", "check_file_content") and (r or {}).get("type") in ("vm_file", "local_file"):
            out.append({"type": "file_contains", "path": path, "equals": rules.get("expected", rules.get("value", (e or {}).get("value", "")))})
        elif f == "contains" and (r or {}).get("type") in ("vm_file", "local_file"):
            out.append({"type": "file_contains", "path": path, "text": rules.get("expected", "")})
        elif f == "infeasible":
            out.append({"type": "status_in", "values": ["failed", "blocked_needs_human", "blocked_security"]})
        else:
            out.append({"type": f"waa:{f}", "detail": "unsupported WAA evaluator"})
    return out
