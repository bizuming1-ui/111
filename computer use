// D3D11 + IDXGIKeyedMutex: consume the capture texture shared by dscu-driver WITHOUT leaving VRAM (works on NVIDIA and AMD 780M iGPU).
// Pipeline: AcquireSync(key) -> compute shader (tile diff + dirty mask) -> ReleaseSync -> only {ahash,dirty} cross to the CPU.
#ifdef _WIN32
#include <d3d11.h>
#include <d3dcompiler.h>
#include <dxgi.h>
#include <wrl/client.h>
#include <cstdint>
#include <cstdio>
using Microsoft::WRL::ComPtr;
static const char* kHlsl = R"(
Texture2D<float4> Prev : register(t0); Texture2D<float4> Cur : register(t1); RWStructuredBuffer<uint> Mask : register(u0);
cbuffer C : register(b0) { uint W; uint H; uint Thr; uint TilesX; };
groupshared uint part[256];
[numthreads(256,1,1)] void main(uint3 gid : SV_GroupID, uint gi : SV_GroupIndex) {
  uint px = gid.x * 16 + (gi & 15), py = gid.y * 16 + (gi >> 4); uint d = 0;
  if (px < W && py < H) { int4 a = int4(Prev.Load(int3(px, py, 0)) * 255.0 + 0.5), b = int4(Cur.Load(int3(px, py, 0)) * 255.0 + 0.5); int4 e = abs(a - b); d = e.x + e.y + e.z + e.w; }
  part[gi] = d; GroupMemoryBarrierWithGroupSync();
  for (uint s = 128; s > 0; s >>= 1) { if (gi < s) part[gi] += part[gi + s]; GroupMemoryBarrierWithGroupSync(); }
  if (gi == 0 && part[0] > Thr) { uint t = gid.y * TilesX + gid.x; InterlockedOr(Mask[t >> 5], 1u << (t & 31)); }
})";
struct KeyedDiff {
  ComPtr<ID3D11Device> dev; ComPtr<ID3D11DeviceContext> ctx; ComPtr<ID3D11ComputeShader> cs;
  bool init() {
    if (FAILED(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, nullptr, 0, D3D11_SDK_VERSION, &dev, nullptr, &ctx))) return false;
    ComPtr<ID3DBlob> blob, err;
    if (FAILED(D3DCompile(kHlsl, strlen(kHlsl), nullptr, nullptr, nullptr, "main", "cs_5_0", 0, 0, &blob, &err))) { if (err) std::fputs((const char*)err->GetBufferPointer(), stderr); return false; }
    return SUCCEEDED(dev->CreateComputeShader(blob->GetBufferPointer(), blob->GetBufferSize(), nullptr, &cs));
  }
  // cur must be a shared texture created by dscu-driver with D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX
  bool run(ID3D11Texture2D* cur, UINT64 key, ID3D11ShaderResourceView* prevSrv, ID3D11ShaderResourceView* curSrv, ID3D11UnorderedAccessView* mask, ID3D11Buffer* cb, UINT tx, UINT ty) {
    ComPtr<IDXGIKeyedMutex> km; if (FAILED(cur->QueryInterface(IID_PPV_ARGS(&km)))) return false;
    if (km->AcquireSync(key, 8) != S_OK) return false;                       // writer still inside: skip this frame, never block the agent loop
    ID3D11ShaderResourceView* srvs[2] = {prevSrv, curSrv}; ctx->CSSetShader(cs.Get(), nullptr, 0); ctx->CSSetShaderResources(0, 2, srvs);
    ctx->CSSetUnorderedAccessViews(0, 1, &mask, nullptr); ctx->CSSetConstantBuffers(0, 1, &cb); ctx->Dispatch(tx, ty, 1);
    km->ReleaseSync(key); return true;
  }
};
#endif
