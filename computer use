    return bool(st.get("ok") and any(needle in n for n in names)), f"count={st.get('count')} names={names[:8]}"


def v_registry_value(s: dict, ctx: Ctx) -> tuple[bool, str]:
    if not IS_WIN:
        return False, "registry verifier requires Windows"
    import winreg

    hive = {"HKCU": winreg.HKEY_CURRENT_USER, "HKLM": winreg.HKEY_LOCAL_MACHINE}[s.get("hive", "HKCU")]
    try:
        with winreg.OpenKey(hive, s["key"]) as k:
            val, _ = winreg.QueryValueEx(k, s["name"])
    except OSError as e:
        return False, f"registry read failed: {e}"
    return str(val) == str(s["equals"]), f"{s['key']}\\{s['name']}={val!r}"


def _windows() -> list[tuple[int, str, int]]:
    if not IS_WIN:
        return []
    import ctypes
    from ctypes import wintypes

    out: list[tuple[int, str, int]] = []
    user32 = ctypes.windll.user32  # type: ignore[attr-defined]
    cb_t = ctypes.WINFUNCTYPE(ctypes.c_bool, wintypes.HWND, wintypes.LPARAM)

    def cb(h: int, _: int) -> bool:
        if user32.IsWindowVisible(h):
            n = user32.GetWindowTextLengthW(h)
            buf = ctypes.create_unicode_buffer(n + 1)
            user32.GetWindowTextW(h, buf, n + 1)
            pid = wintypes.DWORD()
            user32.GetWindowThreadProcessId(h, ctypes.byref(pid))
            if buf.value:
                out.append((int(h), buf.value, int(pid.value)))
        return True

    user32.EnumWindows(cb_t(cb), 0)
    return out


def v_window_title_contains(s: dict, ctx: Ctx) -> tuple[bool, str]:
    needle = str(s["text"]).lower()
    hit = [t for _, t, _ in _windows() if needle in t.lower()]
    return bool(hit), f"matches={hit[:3]}"


