@dataclass
class UnifiedObjectRef:
    """The single cross-modal identity.  Every field in the v18 spec is mandatory (defaults are explicit 'unknown' values, never None)."""
    object_id: str
    application_id: str
    window_id: int
    snapshot_epoch: int
    semantic_role: str
    accessible_name: str
    business_identity: str          # e.g. Gmail thread id / sender+subject digest / WeChat contact name  ("" => not a business object)
    dom_identity: str               # CDP backendNodeId / ref / data-thread-id
    uia_identity: str               # UIA AutomationId / RuntimeId / ref
    visual_bbox: tuple              # (x, y, w, h)
    coordinate_space: str           # "screen_physical" | "window_client" | "viewport_css"
    confidence: float               # fused, in [0,1]
    last_seen: float                # time.time()
    state: dict = field(default_factory=dict)   # selected / checked / enabled / focused / expanded ...
    action_role: str = "container"  # target | trigger | navigation | container
    sources: tuple = ()             # which channels corroborate this object
    som_index: Optional[int] = None
    candidate_only: bool = False    # True => produced by OCR/DML only: a *confidence-labelled candidate*, never a destructive authority

    # ---- derived ----
    @property
    def has_structured_evidence(self) -> bool:
        return bool(set(self.sources) & set(STRUCTURED))

    @property
    def verified_identity(self) -> bool:
        """business identity proven by a structured channel (DOM/UIA) — the precondition for any destructive authority."""
        return bool(self.business_identity) and self.has_structured_evidence

    @property
    def selected(self) -> bool:
        return bool(self.state.get("selected") or self.state.get("checked"))

    def validate(self) -> list:
        errs = []
        if self.action_role not in ACTION_ROLES:
            errs.append(f"action_role {self.action_role!r} not in {ACTION_ROLES}")
        if not (0.0 <= self.confidence <= 1.0):
            errs.append("confidence out of range")
        if len(self.visual_bbox) != 4:
            errs.append("visual_bbox must be (x,y,w,h)")
        if not self.object_id:
            errs.append("object_id empty")
        return errs

    def to_dict(self) -> dict:
        d = {k: getattr(self, k) for k in (
            "object_id", "application_id", "window_id", "snapshot_epoch", "semantic_role", "accessible_name", "business_identity", "dom_identity",
            "uia_identity", "visual_bbox", "coordinate_space", "confidence", "last_seen", "state", "action_role", "sources", "som_index", "candidate_only")}
        d["visual_bbox"] = list(self.visual_bbox)
        d["sources"] = list(self.sources)
        return d


@dataclass
class Cand:
    """One raw detection from one channel (before fusion)."""
    source: str
    rect: tuple
    text: str = ""
    role: str = ""
    identity: str = ""         # business identity if the channel knows it (DOM data-thread-id ...)
    native_id: str = ""        # DOM ref / UIA automation id
    conf: float = 0.0
    state: dict = field(default_factory=dict)
    cls: str = ""              # DML class name (icon / text / ...)
    som: Optional[int] = None

    def __post_init__(self) -> None:
        if self.conf <= 0.0:
            self.conf = SOURCE_WEIGHT.get(self.source, 0.5)
        self.rect = tuple(int(round(v)) for v in self.rect)


def _as_cands(source: str, items: Optional[Iterable[Any]]) -> list:
    out = []
    for it in items or []:
        if isinstance(it, Cand):
            out.append(it)
            continue
        if hasattr(it, "model_dump"):
            it = it.model_dump()
        elif not isinstance(it, dict) and hasattr(it, "__dict__"):
            it = dict(vars(it))
        if not isinstance(it, dict):
            continue
        rect = it.get("rect") or it.get("box") or it.get("bbox")
        if not rect or len(rect) != 4:
            continue
        states = it.get("states") or []
        st = dict(it.get("state") or {})
        for s in states if isinstance(states, (list, tuple)) else []:
            sl = str(s).lower()
            if sl in ("selected", "checked", "focused", "expanded", "disabled", "unchecked"):
                st["checked" if sl == "checked" else sl] = True
        if it.get("checked") is not None:
            st["checked"] = bool(it.get("checked"))
        if it.get("selected") is not None:
            st["selected"] = bool(it.get("selected"))
        out.append(Cand(
            source=source, rect=tuple(rect), text=str(it.get("name") or it.get("text") or it.get("accessible_name") or ""),
            role=str(it.get("role") or it.get("semantic_role") or ""), identity=str(it.get("identity") or it.get("thread_id") or it.get("business_identity") or ""),
            native_id=str(it.get("ref_id") or it.get("ref") or it.get("automation_id") or it.get("native_id") or ""),
            conf=float(it.get("conf") or it.get("confidence") or it.get("score") or 0.0), state=st, cls=str(it.get("cls") or it.get("class") or ""),
            som=(int(it["som"]) if it.get("som") is not None else None)))
    return out


# ---------------------------------------------------------------------------------------------------------------- fusion
def infer_action_role(role: str, name: str, in_row: bool = False, cls: str = "") -> str:
    r = (role or "").lower()
    if r in CONTAINER_ROLES:
        return "container"
    if r in TRIGGER_ROLES or cls in ("icon", "button"):
        if TRIGGER_NAME_RX.search(name or "") or r in ("toolbarbutton", "splitbutton"):
            return "trigger"
        return "trigger" if r in ("button", "pushbutton") and not in_row else ("target" if in_row else "navigation")
    if r in NAV_ROLES:
        return "navigation"
    if r in TARGET_ROLES or in_row:
        return "target"
    return "container" if not name else "target"


class ObjectFusionEngine:
    """Cross-modal Spatial-Semantic Fusion.

    score(a,b) = 0.45·IoU + 0.30·containment(max direction) + 0.25·text_similarity  (text term only when both sides carry text; the weights are
    renormalised otherwise).  Anchors are structured channels (DOM first, then UIA); DML/OCR/SoM attach to the best anchor above `merge_threshold`;
    leftovers become `candidate_only` objects with a *confidence label* and NO business identity."""

    def __init__(self, merge_threshold: float = 0.38, dom_uia_threshold: float = 0.50) -> None:
        self.t = merge_threshold
        self.t_du = dom_uia_threshold

    @staticmethod
    def score(a: Cand, b: Cand) -> float:
        g = iou(a.rect, b.rect)
        c = max(containment(a.rect, b.rect), containment(b.rect, a.rect))
        if a.text and b.text:
