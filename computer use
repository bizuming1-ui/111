class FakeWeChat:
    """Scripted WeChat window (Weixin 4.x layout) implementing the WeChatSkill IO protocol."""

    def __init__(self, group_only=False, header_suffix="", prefill="", bubbles=None, confirm=True, enter_sends=True, copy_works=True, name="老虎不抓鼠"):
        self.name = name
        self.win = [100, 50, 1500, 1000]
        self.geo = ms.WeChatGeometry(100, 50, 1500, 1000, 1.0)
        self.group_only, self.header_suffix, self.confirm_answer, self.enter_sends, self.copy_works = group_only, header_suffix, confirm, enter_sends, copy_works
        self.search_active, self.search_text, self.chat_title, self.editor, self.bubbles = False, "", "", prefill, list(bubbles or [])
        self.clip, self.keys, self.sent, self.sel, self.hitl_asked = "orig-clipboard", [], 0, False, False

    async def find_window(self):
        return {"hwnd": 4242, "title": "微信", "rect": list(self.win), "dpi": 1.0}

    async def focus(self, h):
        return True

    async def launch(self):
        return False

    async def sleep(self, s):
        return None

    async def clipboard_get(self):
        return self.clip

    async def clipboard_set(self, t):
        self.clip = t

    async def type_text(self, t):
        self.editor += t

    async def confirm(self, lines, q):
        self.hitl_asked = True
        return self.confirm_answer

    async def key(self, k):
        self.keys.append(k)
        if k == "ctrl+f":
            self.search_active, self.search_text = True, ""
        elif k == "ctrl+a":
            self.sel = True
        elif k == "delete":
            if self.sel and not self.search_active:
                self.editor = ""
            self.sel = False
        elif k == "ctrl+v":
            if self.search_active:
                self.search_text = self.clip
            else:
                self.editor = self.clip if self.sel else self.editor + self.clip
            self.sel = False
        elif k == "ctrl+c":
            if self.sel and not self.search_active and self.copy_works:
                self.clip = self.editor
        elif k == "end":
            self.sel = False
        elif k in ("enter", "ctrl+enter"):
            if not self.search_active and self.editor and (self.enter_sends or k == "ctrl+enter"):
                self.bubbles.append(self.editor)
                self.editor = ""
                self.sent += 1
        elif k == "escape":
            self.search_active = False

    async def click(self, x, y):
        g = self.geo
        if self.search_active and g.inside(g.list_rect, x, y):
            for r, t, _ in self._results():
                if r[1] <= y <= r[1] + r[3]:
                    self.chat_title, self.search_active = t + self.header_suffix, False

    def _results(self):
        g = self.geo
        if not (self.search_active and self.search_text):
            return []
        x, y = g.list_rect[0] + 20, g.list_rect[1] + 10
        out = []
        sec = "群聊" if self.group_only else "联系人"
        out.append(([x, y, 60, 24], sec, "ocr"))
        out.append(([x, y + 40, 140, 24], self.name if not self.group_only else self.name + "交流群", "ocr"))
        if self.group_only:
            out.append(([x, y + 80, 140, 24], self.name, "ocr"))
        return out

    def _screen(self):
        g = self.geo
        ls = list(self._results())
        if self.search_active:
            ls.append(([g.x + 70, g.y + 20, 120, 24], self.search_text, "ocr"))
        if self.chat_title:
            ls.append(([g.chat_x0 + 24, g.y + 30, 140, 28], " ".join(self.chat_title), "ocr"))  # Windows OCR spaces CJK glyphs
        if self.editor:
            ls.append(([g.chat_x0 + 20, g.input_rect[1] + 50, 300, 24], " ".join(self.editor), "ocr"))
        for i, b in enumerate(self.bubbles):
            ls.append(([g.x + g.w - 260, g.msg_right_rect[1] + 40 + 50 * i, 120, 26], " ".join(b), "ocr"))
        return ls

    async def perceive(self, rect):
        out = [(r, t, s) for r, t, s in self._screen() if rect[0] <= r[0] + r[2] / 2 <= rect[0] + rect[2] and rect[1] <= r[1] + r[3] / 2 <= rect[1] + rect[3]]
        return {"lines": out, "dml": True, "dml_n": 5}


