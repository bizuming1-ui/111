        'save_text' { if ([string]::IsNullOrWhiteSpace("$($a.name)") -or [string]::IsNullOrWhiteSpace("$($a.folder)")) { return 'save_text 需要 folder（桌面/文档/下载…）、name，以及 content' }; return $null }
