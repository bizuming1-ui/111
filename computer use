BROWSERS = {"chrome.exe", "msedge.exe", "brave.exe", "vivaldi.exe", "firefox.exe", "opera.exe"}
CRASH_TITLES = re.compile(r"错误报告|已停止工作|停止响应|has stopped working|not responding|Application Error|Error Report|崩溃|WerFault", re.I)
CRASH_PROCS = {"werfault.exe", "wermgr.exe", "dwwin.exe", "crashpad_handler.exe"}
SHELL_CLASSES = {"Progman", "WorkerW", "Shell_TrayWnd", "Shell_SecondaryTrayWnd"}
