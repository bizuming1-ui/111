    catch { if ("$($_.Exception.Message)" -like '触发保护*') { throw }; return $null }
    if ($null -eq $raw -or @($raw.rows).Count -eq 0) { return $null }
    $m = ConvertTo-V92CdpRowModel $raw $CdpObs.Origin @($CdpObs.Items)
    if (@($m.Rows).Count -eq 0) { return $null }
    return $m
}
function Resolve-V92PerceptionChannel($CdpObs, $CdpModel) {
    # 纯路由判定：CDP 可用且能建立行模型 → 'cdp-rows'（含 ≥2 复选框的页面也留在高速通道）；CDP 可用 → 'cdp'；否则 'uia'
    if ($null -eq $CdpObs) { return 'uia' }
    $cbn = @($CdpObs.Items | Where-Object { $_.Type -eq 'CheckBox' }).Count
    if ($cbn -ge 2 -and $null -eq $CdpModel) { return 'uia' }
    if ($null -ne $CdpModel) { return 'cdp-rows' }
    return 'cdp'
}
