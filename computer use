function Get-V9IpcCode([string]$Line) {
    if ([System.Text.Encoding]::UTF8.GetByteCount($Line) -gt 4194304) { return -32600 }
    $doc = $null
    try { $doc = [System.Text.Json.JsonDocument]::Parse($Line) } catch { return -32700 }
    try {
        $r = $doc.RootElement
        if ($r.ValueKind -ne [System.Text.Json.JsonValueKind]::Object) { return -32600 }
        $el = [System.Text.Json.JsonElement]::new()
        if ($r.TryGetProperty('v', [ref]$el)) {
            if ($el.ValueKind -ne [System.Text.Json.JsonValueKind]::Number) { return -32600 }
            $vi = [long]0; if (-not $el.TryGetInt64([ref]$vi)) { return -32600 }
            if ($vi -ne 1) { return 4001 }
        }
        if (-not $r.TryGetProperty('method', [ref]$el) -or $el.ValueKind -ne [System.Text.Json.JsonValueKind]::String) { return -32600 }
        if ($el.GetString() -cnotmatch '^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$') { return -32600 }
        foreach ($k in 'action_id', 'expect_hwnd') {
            if ($r.TryGetProperty($k, [ref]$el) -and $el.ValueKind -ne [System.Text.Json.JsonValueKind]::Null) {
                $u = [uint64]0
                if ($el.ValueKind -ne [System.Text.Json.JsonValueKind]::Number -or -not $el.TryGetUInt64([ref]$u)) { return -32600 }
            }
        }
        if ($r.TryGetProperty('expect_fp', [ref]$el) -and $el.ValueKind -ne [System.Text.Json.JsonValueKind]::Null) {
            if ($el.ValueKind -ne [System.Text.Json.JsonValueKind]::String -or $el.GetString() -notmatch '^[0-9a-fA-F]{16}$') { return -32600 }
        }
        return 0
    }
    finally { $doc.Dispose() }
}
function New-V9Ledger { return @{ Max = [uint64]0; Seen = @{} } }
function Test-V9Lock($L, $ActionId, $ReqFp, $ExpectHwnd, $CurHwnd, $ExpectFp, $CurFp) {
    # 全链路乐观锁：action_id 幂等 → expect_hwnd → expect_fp（Hamming>10）。返回 0 / 4090 / 4091 / 4092 / 4093；漂移(4092/4093)意味着「局部重采再解析」，绝不盲点。
    $id = [uint64]0
    if ($null -ne $ActionId) {
        $id = [uint64]$ActionId
        if ($id -le $L.Max) { if ($L.Seen.ContainsKey("$id") -and $L.Seen["$id"] -eq [long]$ReqFp) { return 4090 } return 4091 }
    }
    if ($null -ne $ExpectHwnd -and [long]$ExpectHwnd -ne [long]$CurHwnd) { return 4092 }
    if ($ExpectFp -and $CurFp -and (Measure-HashDistance "$ExpectFp" "$CurFp") -gt 10) { return 4093 }
    if ($null -ne $ActionId) { $L.Max = $id; $L.Seen["$id"] = [long]$ReqFp }
    return 0
}
function Get-V9ScanCode([string]$Ch) {
    # US 布局 set-1 物理扫描码（KEYEVENTF_SCANCODE）；无映射（中日韩等）返回 $null → 走 Unicode 直输 + IME 中和
    if ($Ch.Length -ne 1) { return $null }
    switch -CaseSensitive ($Ch) { ' ' { return @{ Scan = 0x39; Shift = $false } } "`n" { return @{ Scan = 0x1C; Shift = $false } } "`t" { return @{ Scan = 0x0F; Shift = $false } } '\' { return @{ Scan = 0x2B; Shift = $false } } '|' { return @{ Scan = 0x2B; Shift = $true } } }
    foreach ($row in @(@('1234567890-=', '!@#$%^&*()_+', 0x02), @('qwertyuiop[]', 'QWERTYUIOP{}', 0x10), @('asdfghjkl;''`', 'ASDFGHJKL:"~', 0x1E), @('zxcvbnm,./', 'ZXCVBNM<>?', 0x2C))) {
        $i = $row[0].IndexOf($Ch, [System.StringComparison]::Ordinal); if ($i -ge 0) { return @{ Scan = ($row[2] + $i); Shift = $false } }
        $i = $row[1].IndexOf($Ch, [System.StringComparison]::Ordinal); if ($i -ge 0) { return @{ Scan = ($row[2] + $i); Shift = $true } }
    }
    return $null
}
function ConvertTo-V9AbsCoord([int]$Vx, [int]$Vy, [int]$Vw, [int]$Vh, [int]$Px, [int]$Py) {
