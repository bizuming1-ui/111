/// Find a window by hwnd / title substring / process name (case-insensitive). Skips own windows.
pub fn find(all: &[Win], hwnd: Option<isize>, title: Option<&str>) -> Vec<Win> {
    if let Some(h) = hwnd {
        if h != 0 {
            return all.iter().filter(|w| w.hwnd == h).cloned().collect();
