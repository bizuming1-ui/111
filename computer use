"""Resilient LLM call: EmptyContent -> exponential backoff (max 3 tries); the 3rd try switches to the backup endpoint/model and saves a checkpoint."""
from __future__ import annotations
import asyncio
from dataclasses import dataclass
from typing import Awaitable, Callable, Optional


class EmptyContent(Exception):
    pass


@dataclass
class Target:
    base: str
    model: str
    json_mode: bool = True


async def call_with_empty_retry(call: Callable[[Target], Awaitable[str]], primary: Target, backup: Target, *,
                                checkpoint: Optional[Callable[[str], None]] = None, sleep=asyncio.sleep, base_delay: float = 1.0) -> tuple[str, int, bool]:
    """Returns (content, attempts, used_backup)."""
    target, used_backup = primary, False
    for attempt in range(1, 4):
        try:
            text = await call(target)
            if not text or not text.strip(): raise EmptyContent("API returned empty content")
            return text, attempt, used_backup
        except EmptyContent:
            if attempt == 3:
                if checkpoint: checkpoint("3 consecutive empty responses")
                raise
            if attempt == 2:
                if checkpoint: checkpoint("empty response: failing over to backup endpoint")
                target, used_backup = Target(backup.base, backup.model, False), True
            await sleep(min(8.0, base_delay * 2 ** (attempt - 1)))
    raise EmptyContent("unreachable")
