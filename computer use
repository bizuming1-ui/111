"""SkillStore v2 — procedural memory (jsonl) with 0.5^(days/45) decay and read-only reference semantics (no instruction authority)."""
from __future__ import annotations
import json
import math
import time
from pathlib import Path


class SkillStore:
    def __init__(self, path: str):
        self.path = Path(path); self.path.parent.mkdir(parents=True, exist_ok=True)

    def add(self, task: str, steps: list[str], layer: str, ok: bool = True) -> None:
        with self.path.open("a", encoding="utf-8") as f:
            f.write(json.dumps({"t": time.time(), "task": task, "steps": steps[:12], "layer": layer, "ok": ok}, ensure_ascii=False) + "\n")

    @staticmethod
    def _tokens(s: str) -> set[str]:
        return {s[i:i + 2] for i in range(len(s) - 1)} | set(s.lower().split())

    def recall(self, task: str, k: int = 3) -> list[dict]:
        if not self.path.exists():
            return []
        q, now, scored = self._tokens(task), time.time(), []
        for ln in self.path.read_text("utf-8").splitlines():
            try: r = json.loads(ln)
            except ValueError: continue
            if not r.get("ok"): continue
            t = self._tokens(r["task"]); sim = len(q & t) / max(len(q | t), 1)
            w = sim * math.pow(0.5, (now - r["t"]) / 86400 / 45)
            if w > 0.05: scored.append((w, r))
        return [r for _, r in sorted(scored, key=lambda x: -x[0])[:k]]
