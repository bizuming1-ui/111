function Get-V10CliCatalog([switch]$Refresh) {
    if (-not $Refresh -and $null -ne $script:V10.CliCatalog -and ((Get-Date) - $script:V10.CliCatalogAt).TotalSeconds -lt 60) { return $script:V10.CliCatalog }
    $cat = [ordered]@{}
    $dirs = [System.Collections.Generic.List[string]]::new()
    foreach ($d in @("$env:DSCU_CLI_PATH".Split([System.IO.Path]::PathSeparator)) + @("$env:PATH".Split([System.IO.Path]::PathSeparator))) { if ($d -and -not $dirs.Contains($d)) { $dirs.Add($d) } }
    $skillRoots = @("$env:CLI_ANYTHING_SKILLS_DIR", (Join-Path ([Environment]::GetFolderPath('UserProfile')) '.cli-anything/skills')) | Where-Object { $_ }
    foreach ($d in $dirs) {
        if (-not (Test-Path -LiteralPath $d -PathType Container)) { continue }
        foreach ($f in @(Get-ChildItem -LiteralPath $d -Filter 'cli-anything-*' -File -ErrorAction SilentlyContinue)) {
            $n = [System.IO.Path]::GetFileNameWithoutExtension($f.Name)
            if ($cat.Contains($n)) { continue }
            $app = $n.Substring('cli-anything-'.Length); $skill = ''
            foreach ($sr in $skillRoots) { $sm = Join-Path (Join-Path $sr $app) 'SKILL.md'; if (Test-Path -LiteralPath $sm) { $skill = (@(Get-Content -LiteralPath $sm -TotalCount 12) -join ' ' -replace '\s+', ' '); break } }
            $cat[$n] = [pscustomobject]@{ Name = $n; Path = $f.FullName; Kind = 'cli-anything'; App = $app; Skill = $skill }
        }
    }
    foreach ($app in $script:V10CliApps.Keys) {
        $nat = $script:V10CliApps[$app].Native
        if (-not $nat -or $cat.Contains($nat)) { continue }
        $cmd = Get-Command $nat -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($cmd) { $cat[$nat] = [pscustomobject]@{ Name = $nat; Path = $cmd.Source; Kind = 'headless'; App = $app; Skill = '' } }
    }
    $script:V10.CliCatalog = $cat; $script:V10.CliCatalogAt = Get-Date
    return $cat
}
function Get-V10CliRoute([string]$Task) {
    $cat = Get-V10CliCatalog
    foreach ($app in $script:V10CliApps.Keys) {
        $d = $script:V10CliApps[$app]
        if ($Task -match $d.Rx) { if ($cat.Contains($d.Pkg)) { return $cat[$d.Pkg] }; if ($d.Native -and $cat.Contains($d.Native)) { return $cat[$d.Native] } }
    }
    return $null
}
function Get-V10CliHint([string]$Task) {
