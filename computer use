            double now = sw.Elapsed.TotalMilliseconds;
            x0 = curX; y0 = curY; x1 = x; y1 = y;
            double dx = x1 - x0, dy = y1 - y0;
            double d = Math.Sqrt(dx * dx + dy * dy);
