        self.hits = 0
        self.rebuilds = 0
        self.last_reason = ""

    def invalidate(self, reason: str) -> None:
        if self.geom is not None:
            self.invalidations += 1
        self.geom, self.last_reason = None, reason

    def put(self, g: ViewportGeometry) -> ViewportGeometry:
