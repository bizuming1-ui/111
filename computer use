        status = run(brain.run_task("在记事本里输入 hello world", max_steps=6))
        self.assertEqual(status, "unverified", "\n".join(out))  # v16.2: model claim without an independent goal is NEVER completed_verified
        self.assertIn("效果核验：confirmed", "\n".join(out))

    def test_layer0_file_task_zero_llm(self):
