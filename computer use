        target = args.pop("target", None)
        uses_ref = bool(target and str(target).startswith(("@", "cdp:")))
        return ActionRequest(next(self.ids), action, args=args, target=target,
                             expect_epoch=(obs.snapshot_epoch if (obs and uses_ref) else None))

    def _save(self, layer: int, done: bool = False) -> None:
        q = self.sm.quota.quota
        self.ckpt.save(TaskCheckpoint(self.task_id, self.task, layer, self.sm.steps, self.sm.guard.epoch,
                                      self.history[-40:], None if q is None else {"remaining": q.remaining, "done": q.done, "total": q.total},
                                      self.security.grant_roots(), self.sm.escape.level,
                                      [list(b) for b in self.sm.escape.banned], done))

    def _finish(self, outcome: str, summary: str, layer: int, t0: float) -> dict:
        self.sm.phase = Phase.DONE if outcome == "done" else Phase.FAILED
        self._save(layer, done=outcome == "done")
        return {"outcome": outcome, "summary": summary, "steps": self.sm.steps, "layer": layer,
                "seconds": round(time.perf_counter() - t0, 3), "grants": self.security.grant_roots(),
                "escape_level": self.sm.escape.level, "epoch": self.sm.guard.epoch, "trace": self.sm.trace}

    async def _do(self, layer: int, req: ActionRequest, obs: ObservationEnvelope | None = None) -> tuple[ActionResult, object]:
        v = self.sm.pre_action(req)
        if not v.allow:
            res = ActionResult(req.action_id, False, v.code, v.message)
            self.sm.steps += 1
            self.sm.trace.append({"step": self.sm.steps, "action": req.action, "ok": False, "code": v.code})
            self.history.append(f"{req.action} → 被拦截 {v.code}: {v.message}")
            return res, v
        ex = self.executors[layer]
        t0 = time.perf_counter()
        res = await ex.act(req)
        self.spans.append({"name": req.action, "layer": layer, "dur_ms": round((time.perf_counter() - t0) * 1000, 2), "code": res.code})
        rows_now, row_texts = None, None
        if self.sm.quota.active and layer in (1, 2):
            o2 = await ex.observe()
            rows_now = o2.row_count
            row_texts = [r.name for r in o2.refs if r.zone == "Row"]
        v2 = self.sm.post_action(req, res, rows_now=rows_now, row_texts=row_texts, window_title=(obs.window_title if obs else ""))
        self.router.mark(layer, res.ok or res.code in ("STALE_EPOCH", "QUOTA_DONE"))
        self.history.append(f"{req.action} {json.dumps(req.args, ensure_ascii=False)[:80]} → {res.code} {res.message[:100]}")
        self._save(layer)
        return res, v2

