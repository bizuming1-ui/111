#include "ds_framediff.h"
#include <algorithm>
#include <vector>
#if defined(__AVX2__) || defined(_MSC_VER)
#include <immintrin.h>
#endif
namespace ds {
int hamming(uint64_t a, uint64_t b) { uint64_t x = a ^ b; int n = 0; while (x) { x &= x - 1; ++n; } return n; }
bool cpu_has_avx2() {
#if defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__))
  return __builtin_cpu_supports("avx2");
#elif defined(_MSC_VER)
  int r[4]; __cpuidex(r, 7, 0); return (r[1] & (1 << 5)) != 0;
#else
  return false;
#endif
}
uint64_t ahash64(const uint8_t* p, int w, int h, int stride) {
  if (w < 8 || h < 8) return 0;
  uint32_t cell[64]; uint32_t sum = 0;
  for (int cy = 0; cy < 8; ++cy) for (int cx = 0; cx < 8; ++cx) {
    int x0 = cx * w / 8, x1 = (cx + 1) * w / 8, y0 = cy * h / 8, y1 = (cy + 1) * h / 8;
    int sx = std::max(1, (x1 - x0) / 8), sy = std::max(1, (y1 - y0) / 8);
    uint64_t acc = 0, n = 0;
    for (int y = y0; y < y1; y += sy) { const uint8_t* r = p + (size_t)y * stride; for (int x = x0; x < x1; x += sx) { const uint8_t* q = r + x * 4; acc += (29u * q[0] + 150u * q[1] + 77u * q[2]) >> 8; ++n; } }
    cell[cy * 8 + cx] = n ? (uint32_t)(acc / n) : 0; sum += cell[cy * 8 + cx];
  }
  uint32_t mean = sum / 64; uint64_t hsh = 0;
  for (int i = 0; i < 64; ++i) if (cell[i] >= mean) hsh |= 1ull << i;
  return hsh;
}
static DiffResult finish(const std::vector<uint64_t>& tiles, int tw, int th, int w, int h, const uint8_t* cur, int stride, uint32_t thr) {
  DiffResult r{}; r.total_tiles = (uint32_t)(tw * th); r.dirty = {w, h, 0, 0};
  for (int ty = 0; ty < th; ++ty) for (int tx = 0; tx < tw; ++tx) if (tiles[(size_t)ty * tw + tx] > thr) {
    ++r.dirty_tiles; r.dirty.x0 = std::min(r.dirty.x0, tx * kTile); r.dirty.y0 = std::min(r.dirty.y0, ty * kTile);
    r.dirty.x1 = std::max(r.dirty.x1, std::min(w, (tx + 1) * kTile)); r.dirty.y1 = std::max(r.dirty.y1, std::min(h, (ty + 1) * kTile));
  }
  if (!r.dirty_tiles) r.dirty = {0, 0, 0, 0};
  r.changed_ratio = r.total_tiles ? (double)r.dirty_tiles / r.total_tiles : 0.0;
  r.ahash = ahash64(cur, w, h, stride);
  return r;
}
DiffResult framediff_scalar(const uint8_t* prev, const uint8_t* cur, int w, int h, int stride, uint32_t thr) {
  int tw = (w + kTile - 1) / kTile, th = (h + kTile - 1) / kTile; std::vector<uint64_t> t((size_t)tw * th, 0);
  for (int y = 0; y < h; ++y) {
    const uint8_t* a = prev + (size_t)y * stride; const uint8_t* b = cur + (size_t)y * stride;
    for (int x = 0; x < w; ++x) { uint32_t d = 0; for (int c = 0; c < 4; ++c) d += (uint32_t)std::abs((int)a[x * 4 + c] - (int)b[x * 4 + c]); t[(size_t)(y / kTile) * tw + x / kTile] += d; }
  }
  return finish(t, tw, th, w, h, cur, stride, thr);
}
#if defined(__AVX2__) || defined(_MSC_VER)
#if defined(__GNUC__)
__attribute__((target("avx2")))
#endif
DiffResult framediff_avx2(const uint8_t* prev, const uint8_t* cur, int w, int h, int stride, uint32_t thr) {
  int tw = (w + kTile - 1) / kTile, th = (h + kTile - 1) / kTile; std::vector<uint64_t> t((size_t)tw * th, 0);
  for (int y = 0; y < h; ++y) {
    const uint8_t* a = prev + (size_t)y * stride; const uint8_t* b = cur + (size_t)y * stride;
    for (int tx = 0; tx < tw; ++tx) {
      int x0 = tx * kTile, n = std::min(kTile, w - x0); uint64_t acc = 0; int i = 0;
      for (; i + 8 <= n; i += 8) {                                  // 8 pixels = 32 bytes per SAD
        __m256i va = _mm256_loadu_si256((const __m256i*)(a + (size_t)(x0 + i) * 4)), vb = _mm256_loadu_si256((const __m256i*)(b + (size_t)(x0 + i) * 4));
        __m256i s = _mm256_sad_epu8(va, vb);
        acc += (uint64_t)_mm256_extract_epi64(s, 0) + _mm256_extract_epi64(s, 1) + _mm256_extract_epi64(s, 2) + _mm256_extract_epi64(s, 3);
      }
      for (; i < n; ++i) for (int c = 0; c < 4; ++c) acc += (uint32_t)std::abs((int)a[(size_t)(x0 + i) * 4 + c] - (int)b[(size_t)(x0 + i) * 4 + c]);
      t[(size_t)(y / kTile) * tw + tx] += acc;
    }
  }
  return finish(t, tw, th, w, h, cur, stride, thr);
}
#else
DiffResult framediff_avx2(const uint8_t* p, const uint8_t* c, int w, int h, int s, uint32_t thr) { return framediff_scalar(p, c, w, h, s, thr); }
#endif
DiffResult framediff(const uint8_t* p, const uint8_t* c, int w, int h, int s, uint32_t thr) { return cpu_has_avx2() ? framediff_avx2(p, c, w, h, s, thr) : framediff_scalar(p, c, w, h, s, thr); }
}  // namespace ds
