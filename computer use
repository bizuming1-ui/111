//! Frame sources.  Windows: IDXGIOutputDuplication (GPU copy -> staging -> row-copy straight into the ring slot).
//! Elsewhere (CI / Linux): SyntheticSource with DXGI semantics (unchanged frames cost nothing; only dirty rects are touched).
use crate::ring::FrameMeta;

pub enum Grab { Frame(FrameMeta), Unchanged }
pub trait FrameSource {
    fn name(&self) -> &'static str;
    fn dims(&self) -> (u32, u32);
    /// Write a BGRA frame into `dst` (slot memory).  `Unchanged` => caller publishes nothing.
    fn grab_into(&mut self, dst: &mut [u8]) -> Result<Grab, String>;
}

pub struct SyntheticSource { w: u32, h: u32, tick: u32, primed: bool }
impl SyntheticSource { pub fn new(w: u32, h: u32) -> Self { SyntheticSource { w, h, tick: 0, primed: false } } }
impl FrameSource for SyntheticSource {
    fn name(&self) -> &'static str { "synthetic(non-windows)" }
    fn dims(&self) -> (u32, u32) { (self.w, self.h) }
    fn grab_into(&mut self, dst: &mut [u8]) -> Result<Grab, String> {
        let stride = (self.w * 4) as usize;
        if dst.len() < stride * self.h as usize { return Err("slot too small".into()); }
        self.tick += 1;
        if !self.primed { for (i, p) in dst.chunks_exact_mut(4).enumerate() { let x = (i % self.w as usize) as u32; p.copy_from_slice(&[(x & 255) as u8, 64, 128, 255]); } self.primed = true; }
        else { // dirty rect: a moving 256x64 block (like a cursor/caret/video tile) — everything else is untouched
            let y0 = (self.tick as usize * 8) % (self.h as usize - 64);
            for y in y0..y0 + 64 { let row = &mut dst[y * stride..y * stride + 256 * 4]; for p in row.chunks_exact_mut(4) { p[0] = self.tick as u8; } }
        }
        Ok(Grab::Frame(FrameMeta { w: self.w, h: self.h, stride: stride as u32 }))
    }
}

#[cfg(windows)]
pub mod dxgi {
    use super::*;
    use windows::core::Interface;
    use windows::Win32::Foundation::HMODULE;
    use windows::Win32::Graphics::Direct3D::D3D_DRIVER_TYPE_HARDWARE;
    use windows::Win32::Graphics::Direct3D11::*;
    use windows::Win32::Graphics::Dxgi::Common::*;
    use windows::Win32::Graphics::Dxgi::*;

    pub struct DxgiSource { ctx: ID3D11DeviceContext, dup: IDXGIOutputDuplication, staging: ID3D11Texture2D, w: u32, h: u32, primed: bool }
    unsafe impl Send for DxgiSource {}

    impl DxgiSource {
        pub fn new() -> Result<Self, String> { unsafe { Self::init().map_err(|e| format!("DXGI init: {e}")) } }
        unsafe fn init() -> windows::core::Result<Self> {
            let mut device: Option<ID3D11Device> = None;
            let mut ctx: Option<ID3D11DeviceContext> = None;
            D3D11CreateDevice(None::<&IDXGIAdapter>, D3D_DRIVER_TYPE_HARDWARE, HMODULE::default(), D3D11_CREATE_DEVICE_BGRA_SUPPORT, None, D3D11_SDK_VERSION, Some(&mut device), None, Some(&mut ctx))?;
            let device = device.ok_or_else(windows::core::Error::from_win32)?;
            let ctx = ctx.ok_or_else(windows::core::Error::from_win32)?;
            let dxgi_dev: IDXGIDevice = device.cast()?;
            let adapter = dxgi_dev.GetAdapter()?;
            let output = adapter.EnumOutputs(0)?;
            let output1: IDXGIOutput1 = output.cast()?;
            let dup = output1.DuplicateOutput(&device)?;
            let desc = dup.GetDesc();
            let (w, h) = (desc.ModeDesc.Width, desc.ModeDesc.Height);
            let td = D3D11_TEXTURE2D_DESC { Width: w, Height: h, MipLevels: 1, ArraySize: 1, Format: DXGI_FORMAT_B8G8R8A8_UNORM,
                SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 }, Usage: D3D11_USAGE_STAGING, BindFlags: 0,
                CPUAccessFlags: D3D11_CPU_ACCESS_READ.0 as u32, MiscFlags: 0 };
            let mut staging: Option<ID3D11Texture2D> = None;
            device.CreateTexture2D(&td, None, Some(&mut staging))?;
            Ok(DxgiSource { ctx, dup, staging: staging.ok_or_else(windows::core::Error::from_win32)?, w, h, primed: false })
        }
    }
    impl FrameSource for DxgiSource {
        fn name(&self) -> &'static str { "dxgi(IDXGIOutputDuplication)" }
        fn dims(&self) -> (u32, u32) { (self.w, self.h) }
        fn grab_into(&mut self, dst: &mut [u8]) -> Result<Grab, String> {
            unsafe {
                let mut info = DXGI_OUTDUPL_FRAME_INFO::default();
                let mut res: Option<IDXGIResource> = None;
                let timeout = if self.primed { 0 } else { 250 };
                match self.dup.AcquireNextFrame(timeout, &mut info, &mut res) {
                    Ok(()) => {}
                    Err(e) if e.code() == DXGI_ERROR_WAIT_TIMEOUT => return Ok(Grab::Unchanged),
                    Err(e) => return Err(format!("AcquireNextFrame: {e}")),
                }
                let tex: ID3D11Texture2D = res.ok_or("null resource")?.cast().map_err(|e| format!("cast: {e}"))?;
                self.ctx.CopyResource(&self.staging, &tex);
                let _ = self.dup.ReleaseFrame();
                let mut m = D3D11_MAPPED_SUBRESOURCE::default();
                self.ctx.Map(&self.staging, 0, D3D11_MAP_READ, 0, Some(&mut m)).map_err(|e| format!("Map: {e}"))?;
                let row = (self.w * 4) as usize;
                for y in 0..self.h as usize {
                    let src = std::slice::from_raw_parts((m.pData as *const u8).add(y * m.RowPitch as usize), row);
                    dst[y * row..(y + 1) * row].copy_from_slice(src);
                }
                self.ctx.Unmap(&self.staging, 0);
                self.primed = true;
                Ok(Grab::Frame(FrameMeta { w: self.w, h: self.h, stride: row as u32 }))
            }
        }
    }
}

pub fn best_source() -> (Box<dyn FrameSource>, Option<String>) {
    #[cfg(windows)]
    {
        match dxgi::DxgiSource::new() { Ok(s) => return (Box::new(s), None), Err(e) => return (Box::new(SyntheticSource::new(1920, 1200)), Some(e)) }
    }
    #[cfg(not(windows))]
    { (Box::new(SyntheticSource::new(1920, 1200)), None) }
}
