//! Protocol: schemas/protocol_v1.json (NDJSON over \\.\pipe\dscu-driver-v1). Python is the only brain.
#![cfg_attr(not(windows), allow(dead_code, unused_imports))]

#[cfg(windows)]
mod dxgi;
#[cfg(windows)]
mod input;
#[cfg(windows)]
mod pipe_server;
#[cfg(windows)]
mod uia_ref;
#[cfg(windows)]
