    $v.ZeroStreak = if ($Effective) { 0 } else { $v.ZeroStreak + 1 }
}
function Get-V12Route([int]$Inter, [bool]$UmaTripped = $false, [bool]$LocalUp = $false, [int]$ZeroStreak = -1) {
    $v = $script:V12
    $zs = if ($ZeroStreak -ge 0) { $ZeroStreak } else { $v.ZeroStreak }
    $p = if ($ZeroStreak -ge 0) { $(if ($zs -ge 2) { 0.0 } else { 1.0 }) } elseif ($v.Effects.Count -eq 0) { 1.0 } else { [double](($v.Effects | Measure-Object -Sum).Sum) / $v.Effects.Count }
    $blind = [Math]::Max(0.0, 1.0 - $Inter / [double]$script:V12UiaBlind)
    $u = [Math]::Round(0.6 * (1 - $p) + 0.4 * $blind, 3)
    $vision = if ($LocalUp -and -not $UmaTripped) { 'vision_local' } else { 'vision_cloud' }
    if ($zs -ge 4 -or $u -ge 0.8) { $r = 'keyboard_explore'; $why = "zero_pixel_streak=$zs U=$u" }
    elseif ($Inter -lt $script:V12UiaBlind) { $r = $vision; $why = "uia_blind inter=$Inter<$($script:V12UiaBlind)" }
    elseif ($zs -ge 2) { $r = $vision; $why = "zero_pixel_streak=$zs" }
    else { $r = 'normal'; $why = 'observable' }
    return [pscustomobject]@{ Route = $r; Reason = $why; U = $u; EffectRatio = [Math]::Round($p, 3); EntropyBits = [Math]::Round((Get-V12Shannon $p), 3); ZeroStreak = $zs }
}
function Get-V12PromptHint {
