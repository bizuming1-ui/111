            if k == "ctrl+f":
                self.search_open = True; return ActionResult(rid, True, "OK", k, True)
            if k == "esc":
                return ActionResult(rid, True, "OK", k, False)
            if k == "enter":
                if self.search_open and self.query == self.contact:
                    self.chat, self.search_open, self.query = self.contact, False, ""; return ActionResult(rid, True, "OK", "chat opened", True)
                if self.chat and self.input:
                    self.sent.append((self.chat, self.input)); self.input = ""; return ActionResult(rid, True, "OK", "sent", True)
            return ActionResult(rid, True, "OK", k, False)
        if req.action == "type":
