        const light = req.type === "action" && (req.action === "tabs" || req.action === "probe");
        const run = async () => {
          let out: Json;
          try { out = await d.handle(req); } catch (e) { out = { type: "error", id: req.id, ok: false, code: "INTERNAL", message: String((e as Error).message ?? e) }; }
          if (!sock.destroyed) sock.write(JSON.stringify(out) + "\n");
        };
        if (light) void run(); else d.chain = d.chain.then(run);
      }
    });
    sock.on("error", () => {});
  });
  server.listen(PIPE, () => console.error(`[cdp-daemon] listening on ${PIPE} (browser: ${d.browser})`));
}

main().catch((e) => { console.error("[cdp-daemon] fatal:", e); process.exit(1); });
