"""DeepSeek client: v6.5 KV-prefix-cache layout, thinking OFF by default, vision budget 4096, EmptyContent fast local retry."""
from __future__ import annotations
import asyncio
import json
import re
import urllib.request
from dataclasses import dataclass, field
from typing import Awaitable, Callable

VISION_MAX_TOKENS = 4096
DECISION_MAX_TOKENS = 2400
Transport = Callable[[str, bytes, float], Awaitable[dict]]


class EmptyContent(Exception):
    pass


def build_messages(static_system: str, stable_task: str, dynamic_obs: str, image_b64: str | None = None,
                   detail: str = "low") -> list[dict]:
    """KV-prefix cache layout: [static system][stable task+plan][volatile observation LAST].  The system message and the
    first user part never change across steps, so DeepSeek's disk cache hits the whole prefix."""
    parts: list[dict] = [{"type": "text", "text": stable_task}, {"type": "text", "text": dynamic_obs}]
    if image_b64:
        parts.append({"type": "image_url", "image_url": {"url": "data:image/jpeg;base64," + image_b64, "detail": detail}})
    return [{"role": "system", "content": static_system}, {"role": "user", "content": parts}]


def compact_vision_text(text: str, limit: int = 6000) -> str:
    """Trim SoM context so reasoning tokens never crowd out the JSON answer: keep the head (task/plan) and the tail (observation)."""
    if len(text) <= limit:
        return text
    head, tail = text[:1200], text[-(limit - 1250):]
    return head + "\n…（已精简）…\n" + tail


def vision_detail(reason: str, has_region: bool, prior_low_failed: bool) -> str:
    """detail:'low' by default; 'original' only for local fine positioning (region crop, canvas/blind UIA, or after a low miss)."""
    if has_region or reason in ("UIA_BLIND", "CDP_CANVAS") or prior_low_failed:
        return "original"
    return "low"


def build_payload(model: str, messages: list[dict], max_tokens: int, json_mode: bool = True, thinking_off: bool = True) -> dict:
    p: dict = {"model": model, "messages": messages, "temperature": 0, "max_tokens": max_tokens}
    if json_mode and "reasoner" not in model:
        p["response_format"] = {"type": "json_object"}
    if thinking_off and "reasoner" not in model:
        p["thinking"] = {"type": "disabled"}
    return p


def extract_json(text: str) -> dict:
    s = text.find("{")
    depth, instr, esc = 0, False, False
    for i in range(max(s, 0), len(text)):
        c = text[i]
        if instr:
            esc = (c == "\\" and not esc)
            if c == '"' and not esc: instr = False
            continue
        if c == '"': instr = True
        elif c == "{": depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0: return json.loads(text[s:i + 1])
    raise ValueError("no complete JSON object")


@dataclass
class DeepSeekClient:
    api_key: str
    base_url: str = "https://api.deepseek.com"
    model: str = "deepseek-chat"
    vision_model: str = "deepseek-flash"
    backup_base: str = "https://api.deepseek.com/v1"
    transport: Transport | None = None
    stats: dict = field(default_factory=lambda: {"calls": 0, "empty": 0, "failover": 0, "fast_retry": 0})

    async def _post(self, url: str, body: bytes, timeout: float) -> dict:
        if self.transport:
            return await self.transport(url, body, timeout)
        def go():
            req = urllib.request.Request(url, body, {"Content-Type": "application/json", "Authorization": f"Bearer {self.api_key}"})
            with urllib.request.urlopen(req, timeout=timeout) as r:                        # noqa: S310 (fixed https endpoint)
                return json.loads(r.read().decode())
        return await asyncio.to_thread(go)

    async def chat(self, messages: list[dict], *, vision: bool = False, json_mode: bool = True) -> str:
        model = self.vision_model if vision else self.model
        max_tok = VISION_MAX_TOKENS if vision else DECISION_MAX_TOKENS
        base, think_off, jm, empties = self.base_url.rstrip("/"), True, json_mode, 0
        for attempt in range(6):
            body = json.dumps(build_payload(model, messages, max_tok, jm, think_off)).encode()
            self.stats["calls"] += 1
            try:
                r = await self._post(f"{base}/chat/completions", body, 60)
            except Exception as e:  # noqa: BLE001
                if re.search(r"thinking|reasoning_effort|unknown parameter", str(e), re.I) and think_off:
                    think_off = False; continue
                await asyncio.sleep(min(2 ** attempt * 0.2, 2)); continue
            ch = (r.get("choices") or [{}])[0]
            msg = ch.get("message") or {}
            content = msg.get("content") or ""
            if not content.strip() and msg.get("reasoning_content"):
                try:
                    content = json.dumps(extract_json(msg["reasoning_content"]))          # answer leaked into the reasoning channel
                except ValueError:
                    pass
