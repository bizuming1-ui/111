async def run_task(task: dict, tmp: Path) -> TaskResult:
    ws = str(tmp / task["id"] / "ws"); desk = tmp / task["id"] / "Desktop"; desk.mkdir(parents=True, exist_ok=True)
    folders = {"desktop": str(desk)}
    env: dict = {"desktop": str(desk)}
    fn = task["evaluator"]["func"]
    if fn == "file_exists_with_content":
        brain = AgentBrain(task["instruction"], ws, {}, None, Router(), folders)
        env.update(expect_name="毕祖铭.txt", expect_text="梁梓斌")
    elif fn == "wechat_message_sent":
        w = MockWeChat(); msg = "您好，今晚八点需要开会，请准时参加，谢谢！"
        brain = AgentBrain(task["instruction"], ws, {4: w}, wechat_policy(msg), Router(), folders)
        env.update(world=w, contact=w.contact, message=msg)
    else:
        g = MockGmail(50)
        brain = AgentBrain(task["instruction"], ws, {1: g}, gmail_policy(), Router(cdp_up=True), folders)
        env.update(world=g, expect_deleted=8, expect_rows_left=42)
    brain.max_steps = 40
    # route override for the two GUI scenarios (the real router needs live probes)
    if fn == "wechat_message_sent":
        brain.router.dxgi_up = False
    report = await brain.run()
    ok, detail = VERIFIERS[fn](env, report)
    passed = ok and report["outcome"] == "done" and report["steps"] <= task["max_steps_budget"]
    return TaskResult(task["id"], passed, report["steps"], task["max_steps_budget"], report["outcome"], detail, task["v10_baseline"],
                      {"layer": report["layer"], "grants": report["grants"], "escape_level": report["escape_level"], "epoch": report["epoch"]})


async def run_all() -> list[TaskResult]:
    with tempfile.TemporaryDirectory(prefix="dscu-arena-") as d:
        return [await run_task(t, Path(d)) for t in TASKS]


def emulate_v10_baseline_wechat() -> dict:
    """v10 REPEAT_NOEFFECT rule: same area clicked, 2 no-effect hits -> every later attempt errors; 6 errors -> circuit break."""
    steps, errs, hits = 0, 0, 0
    pts = [(800, 966), (800, 926), (800, 896), (800, 906), (800, 896), (800, 896), (800, 896), (800, 896)]
    for x, y in pts:
