"""REPL entry:  python -m agent_brain [--cdp-profile persistent|ephemeral]   (same prompt/flow as v12/v13: 请输入任务 ...)"""
from __future__ import annotations

import asyncio
import getpass
import os
import re
import subprocess
import sys

from . import cli_anything
from .config import Config
from .orchestrator import Brain

HELP = """可用命令：
  <任意中文/英文任务>      交给统一大脑执行（Layer0/CLI-Anything → 规划 → 观察/决策/独立验证/恢复 循环）
  v15 status               同 v14 status，另含 CDP 自愈/恢复剧本/安全原语状态
  v15 eval tier1|tier2|waa|all   运行 3 层可复现 Benchmark（evals/，归档到 eval_runs/<时间戳>/）
  v15 compare <v14.json> <v15.json>  对比两次评测的客观进步
  v15 recycle              回收站独立核验（COM + SHQueryRecycleBinW）
  v14 status               驱动/CDP/DXGI 流/FG-Gate/Profile/内存/回退原因 实时状态
  v14 bench                100 帧抓屏基准（DXGI P50/P95/P99；目标 P50 < 5 ms）
  v14 verify               运行 Step1 实机验收 tests/verify_step1_live.py
  v14 verify2              运行 Step2 实机验收 tests/verify_step2.py（锁存/多标签/耗时内存/StableObject+Verifier）
  v14 regress              运行单元/日志回归测试（tests/unit）
  v14 eval [suite]         运行评测套件并给出成功率与 95% 置信区间
  v14 cli                  列出 CLI-Anything(cli-hub) 已发现的 Layer-0 工具
  v14 sidecar              查看本地 DirectML 视觉侧车状态（AMD Radeon 780M / onnxruntime-directml）
  v14 profile              查看/说明浏览器 Profile 模式（persistent 复用登录态；启动参数 --cdp-profile ephemeral 为沙箱模式）
  help / exit                （v13 前缀命令仍可使用）
"""


async def status(brain: Brain) -> None:
    h = brain.hub
    brain.say(f"  驱动: {h.driver_kind} · hello={ {k: v for k, v in h.driver_hello.items() if k in ('peer', 'version', 'uiaccess', 'elevated', 'dxgi_active', 'dxgi_reason', 'rss_mb', 'rust_error', 'caps')} }")
    brain.say(f"  CDP: up={h.cdp_up} err={h.cdp_error} hello={ {k: v for k, v in h.cdp_hello.items() if k in ('version', 'browser', 'rss_mb', 'profile_mode', 'profile_dir', 'browser_pids', 'tabs')} }")
    try:
        cs = await h.cdp_status()
        brain.say(f"  CDP 自愈: {cs}")
    except Exception as e:  # noqa: BLE001
        brain.say(f"  CDP 自愈状态不可用：{e}")
    p = brain.perception.stats
    pm = sorted(p["probe_ms"])
    brain.say(f"  感知: FG-Gate 命中 {p['gate_hits']} · 跳过 UIA {p['uia_skipped']} · 实扫 UIA {p['uia_scans']} · fg_probe P50 {pm[len(pm) // 2] if pm else 0:.2f}ms · 视觉锁存 {p['latch_served']}/{p['latch_armed']} · 焦点守卫 {p['auto_refocus']}")
    nat = getattr(h, "_native", None)
    if nat is not None and hasattr(nat, "stream"):
        s = nat.stream
        brain.say(f"  DXGI 流: mode={s.mode} started={s.started} err={s.err or getattr(s, 'err_stream', None)} restarts={s.restarts}")
    rss = h.rss_report()
    brain.say("  内存: " + (" + ".join(f"{k} {v:.0f}MB" for k, v in rss.items()) + f" = {sum(rss.values()):.0f} MB" if rss else "n/a (pip install psutil)"))
    brain.say(f"  CLI-Anything: {', '.join(sorted(brain.cli_tools)) or '未发现（pip install cli-anything-hub 后 cli-hub install <app>）'}")


def _pop_flag(args: list[str], name: str) -> str | None:
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            v = args[i + 1]
            del args[i:i + 2]
            return v
    return None


async def amain() -> int:
    for s in (sys.stdout, sys.stderr):
        try:
            s.reconfigure(encoding="utf-8")  # type: ignore[attr-defined]
        except Exception:
            pass
    args = sys.argv[1:]
    cfg = Config()
    prof = _pop_flag(args, "--cdp-profile")
    if prof:
        cfg.cdp_profile = prof.strip().lower()
    if not cfg.api_key:
        cfg.api_key = getpass.getpass("请输入 DeepSeek API Key（输入时不显示，粘贴后按回车）: ").strip()
    brain = Brain(cfg)
    await brain.start()
    brain.say(f"  🌐 浏览器 Profile 模式：{cfg.cdp_profile}" + (f" → {cfg.auth_profile_dir}（登录一次长期复用；严禁读取主浏览器目录）" if cfg.cdp_profile == "persistent" else "（临时目录，退出即销毁）"))
    try:
        if args and args[0] == "run" and len(args) > 1:
            await brain.run_task(" ".join(args[1:]))
            return 0
        while True:
            try:
                line = (await asyncio.to_thread(input, "请输入任务（help 帮助 / exit 退出）:")).strip()
            except (EOFError, KeyboardInterrupt):
                break
            if not line:
                continue
            low = re.sub(r"^v1[345]\b", "v14", line.lower())
            if line.lower().startswith("v15") and (low.split()[1:2] or [""])[0] in ("recycle", "compare", "eval"):
                low = "v15" + low[3:]
            if low in ("exit", "quit", "q"):
                break
            if low == "help":
                print(HELP)
            elif low == "v14 status":
                await status(brain)
            elif low == "v14 bench":
                r = await brain.hub.drv_bench(100)
                print(r)
            elif low == "v15 recycle":
                from . import safe_shell

                print(await asyncio.to_thread(safe_shell.recycle_bin_status))
            elif low.startswith("v15 compare"):
                await asyncio.to_thread(subprocess.run, [sys.executable, "evals/runner.py", "compare", *line.split()[2:]], cwd=str(cfg.root))
            elif low.startswith("v15 eval"):
                tiers = (low.split()[2:] or ["all"])
                await asyncio.to_thread(subprocess.run, [sys.executable, "evals/runner.py", "run", *tiers], cwd=str(cfg.root), env=dict(os.environ, DEEPSEEK_API_KEY=cfg.api_key))
            elif low == "v14 cli":
                tools = await asyncio.to_thread(cli_anything.discover, True)
                print("  CLI-Anything 工具：" + (", ".join(f"{k}→{v.exe}" for k, v in tools.items()) or "（无）  安装：pip install cli-anything-hub ; cli-hub install gimp"))
            elif low == "v14 sidecar":
                from sidecar import dml_detector

                print(dml_detector.status_text())
            elif low == "v14 profile":
                print(f"  模式={cfg.cdp_profile} 目录={cfg.auth_profile_dir if cfg.cdp_profile == 'persistent' else cfg.data_dir / 'ephemeral-profile'}\n  切换：退出后用  python -m agent_brain --cdp-profile ephemeral  或设置 DSCU_CDP_PROFILE=ephemeral")
            elif low in ("v14 verify", "v14 verify2", "v14 regress") or low.startswith("v14 eval"):
                py = sys.executable
                root = str(cfg.root)
                cmd = {"v14 verify": [py, "tests/verify_step1_live.py"], "v14 verify2": [py, "tests/verify_step2.py"],
                       "v14 regress": [py, "-m", "unittest", "discover", "-s", "tests/unit", "-v"]}.get(low) or [py, "evals/runner.py", *low.split()[2:]]
                await asyncio.to_thread(subprocess.run, cmd, cwd=root, env=dict(os.environ, DEEPSEEK_API_KEY=cfg.api_key))
            else:
                try:
                    await brain.run_task(line)
                except KeyboardInterrupt:
                    print("\n已中断当前任务。")
    finally:
        await brain.stop()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(asyncio.run(amain()))
    except KeyboardInterrupt:
        sys.exit(130)
