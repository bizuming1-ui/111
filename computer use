    """P0-2 gate.  Stateless w.r.t. clicks; state = the registry + the frozen intent."""

    def __init__(self, registry: "_V18Registry") -> None:
        self.reg = registry
        self.intent: Optional[ActionIntent] = None
        self.stats = {"checked": 0, "released_trigger": 0, "released_target": 0, "denied": 0, "oib_avoided": 0}

    def freeze(self, verb: str, target_ids: list, snapshot_epoch: int, outcome: Optional[ExpectedOutcome] = None) -> ActionIntent:
        fs = self.reg.freeze(target_ids, snapshot_epoch)  # raises on stale epoch / visual-only target / low confidence
        out = outcome or ExpectedOutcome("gone_from_view" if verb in ("delete", "archive", "trash") else "state_equals",
                                         tuple((i, (self.reg.get(i).business_identity or self.reg.get(i).accessible_name)) for i in fs.ids), f"{verb} → {len(fs)} 个目标")
        self.intent = ActionIntent(verb, fs.ids, "", out, snapshot_epoch)
        return self.intent

    def selected_targets(self) -> list:
        assert self.intent is not None
        return [self.reg.objects[i] for i in self.intent.target_ids if i in self.reg.objects and self.reg.objects[i].selected]

    def _deny(self, code: str, reason: str, ev: tuple = ()) -> GateVerdict:
        self.stats["denied"] += 1
        return GateVerdict(False, code, reason, ev)

    def check(self, req: UnifiedActionRequest) -> GateVerdict:
        self.stats["checked"] += 1
        try:
            o = self.reg.require_current(req.object_id, req.snapshot_epoch)
        except Exception as e:  # noqa: BLE001
            code = "STALE_EPOCH" if "epoch" in str(e).lower() and "不是当前" in str(e) else "UNKNOWN_OBJECT"
            return self._deny(code, str(e))
        verb = req.verb or (self.intent.verb if self.intent else "")
        destructive = verb in V18_DESTRUCTIVE
