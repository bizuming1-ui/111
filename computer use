            run(c.click(100 + i, 100, 1))
            lat.append((time.perf_counter() - t0) * 1000)
        self.assertLess(max(lat), 700, "tail must be clamped far below the 2 s hang")
        self.assertGreater(c.tel.counters["hard_timeouts"], 0)
        self.assertEqual(c.tel.summary()["all"]["n"] > 0, True)

