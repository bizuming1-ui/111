            ev["build_info"] = json.loads(info.read_text(encoding="utf-8-sig"))
        except ValueError:
            pass
    if exe.exists():
        import hashlib

        ev["sha256"] = hashlib.sha256(exe.read_bytes()).hexdigest()
        try:
            r = subprocess.run([str(exe), "--selftest-dxgi", "30"], capture_output=True, text=True, timeout=60)
            ev["selftest_dxgi"] = (r.stdout or r.stderr).strip()[:400]
            ev["status"] = "PASS" if r.returncode == 0 else "FAIL"
        except Exception as e:  # noqa: BLE001
            ev["status"], ev["reason"] = "FAIL", str(e)[:200]
    else:
        ev["status"] = "NOT_ACTIVE"
        ev["reason"] = "dscu-driver.exe not built: pwsh scripts/build_driver.ps1 -Target gnu -InstallTools"
    return ev


def dml_evidence(n: int = 40) -> dict[str, Any]:
    try:
        from sidecar import dml_detector as D

        det = D.DmlDetector()
        from PIL import Image, ImageDraw

        im = Image.new("RGB", (2560, 1440), (240, 240, 240))
        d = ImageDraw.Draw(im)
        for i in range(8):
            d.rectangle([200 + i * 260, 300 + (i % 3) * 200, 270 + i * 260, 370 + (i % 3) * 200], fill=(10, 10, 10))
        for _ in range(n):
            det.detect(im)
        ev = det.evidence()
        ev["status"] = "PASS" if (ev["execution_provider_bound"] == "DmlExecutionProvider" and ev["inferences"] >= n) else ("NOT_VERIFIED_HERE" if not IS_WIN else "FAIL")
        if ev["status"] != "PASS" and not ev.get("reason"):
            ev["reason"] = f"bound provider = {ev['execution_provider_bound'] or 'none'}"
        return ev
    except Exception as e:  # noqa: BLE001
        return {"status": "NOT_VERIFIED_HERE" if not IS_WIN else "FAIL", "reason": f"{type(e).__name__}: {str(e)[:200]}"}


