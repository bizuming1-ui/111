class CleanChromeLauncher:
    """Spawns a *clean* Chrome (native Popen, no Puppeteer, no --enable-automation) with a DevTools port, records its pid, and is idempotent:
    if the port already answers /json/version the running instance is adopted instead of launching a second one."""

    def __init__(self, port: int = DEFAULT_PORT, profile: str = "", exe: str = "", extra: Optional[list[str]] = None) -> None:
        self.port, self.profile, self.exe = int(port), profile or clean_profile_dir(), exe
        self.extra = list(extra or [])
        self.proc: Optional[subprocess.Popen[bytes]] = None
        self.pid = 0
        self.exe_name = ""
        self.reused = False
        self.launched_at = 0.0
        self.argv_used: list[str] = []

    def argv(self) -> list[str]:
        return clean_chrome_argv(self.exe or find_browser_executable() or "chrome.exe", self.port, self.profile, self.extra_args())

    @staticmethod
    def extra_args() -> list[str]:
        return shlex.split(os.environ.get("DSCU_CLEAN_CHROME_ARGS", ""), posix=not IS_WIN)

    def ready(self) -> Optional[dict[str, Any]]:
        return probe_debug_endpoint(self.port)

    def ensure(self, timeout: float = 25.0) -> dict[str, Any]:
        """Blocking (run in a thread).  Returns the /json/version document; sets pid / exe_name."""
        info = self.ready()
        if info:
            self.reused = True
            self.pid = find_browser_pid_by_port(self.port) or (self.proc.pid if self.proc else 0)
            self.exe_name = proc_name(self.pid) or self.exe_name
            return info
        exe = self.exe or find_browser_executable()
        if not exe:
            raise McpError("未找到 Chrome/Edge 可执行文件：请安装 Chrome，或设置 DSCU_CHROME_EXE=<chrome.exe 完整路径>")
        Path(self.profile).mkdir(parents=True, exist_ok=True)
        self.argv_used = clean_chrome_argv(exe, self.port, self.profile, [*self.extra, *self.extra_args()])
        assert not any(a.startswith("--enable-automation") for a in self.argv_used)
        flags = (0x00000008 | 0x00000200) if IS_WIN else 0  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP: Ctrl+C in the console must not kill the browser
        self.proc = subprocess.Popen(self.argv_used, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=flags, close_fds=True)
        self.launched_at = time.time()
        end = time.time() + timeout
        exited_at = 0.0
        while time.time() < end:
            info = self.ready()
            if info:
                break
            if self.proc.poll() is not None and not exited_at:
                exited_at = time.time()  # hand-off to an already running instance of the same profile? give the port a few more seconds
            if exited_at and time.time() - exited_at > 6.0:
                raise McpError(f"Chrome 进程已退出但调试端口 {self.port} 未开启：多半已有另一个 Chrome 正在使用同一 clean_profile（{self.profile}）且没带调试端口 → 关闭所有该 Profile 的 Chrome 窗口后重试，或设置 DSCU_CLEAN_PORT / DSCU_CLEAN_PROFILE")
            time.sleep(0.2)
        if not info:
            raise McpError(f"Chrome 调试端口 http://127.0.0.1:{self.port}/json/version {timeout:.0f}s 内未就绪")
        self.pid = find_browser_pid_by_port(self.port) or self.proc.pid
        self.exe_name = proc_name(self.pid) or os.path.basename(exe).lower()
        return info

    def terminate(self) -> None:
        pid = self.pid or (self.proc.pid if self.proc else 0)
        ps = _psutil()
        try:
            if ps and pid:
                p = ps.Process(pid)
                kids = p.children(recursive=True)
                p.terminate()
                for c in kids:
                    try:
                        c.terminate()
                    except Exception:  # noqa: BLE001
                        pass
        except Exception:  # noqa: BLE001
            pass
        self.pid = 0


class McpBrowserEngine:
    """Drop-in replacement for the NDJSON `cdp-daemon` client: .lost / .call / .hello / .close  (+ explicit .start())."""

    def __init__(self, cfg: Any = None, env: Optional[dict[str, str]] = None, *, cmd: Optional[list[str]] = None, args: Optional[list[str]] = None) -> None:
        self.cfg = cfg
        self.env = dict(os.environ if env is None else env)
        self._cmd_override, self._args_override = cmd, args
        self.client: Optional[McpStdioClient] = None
        self.epoch = 1
        self.refs: dict[str, dict[str, Any]] = {}
        self.pages: list[dict[str, Any]] = []
        self.page_id: Optional[int] = None
        self.last_url = ""
        self.restarts = 0
        self.crashes = 0
        self.stats: Counter[str] = Counter()
        self.last_diag = ""
        self.replay: dict[str, dict[str, Any]] = {}
        self._lock = asyncio.Lock()
        self._heal_lock = asyncio.Lock()
        self._pid_cache: tuple[float, list[int]] = (0.0, [])
        self.mode = normalize_mode(self.env.get("DSCU_MCP_MODE"))
        self.requested_mode = self.mode
        self.launcher: Optional[CleanChromeLauncher] = None
        self.attached_browser_pid = 0  # v16.1: PID-scoped FG-Gate - only THIS browser's process tree may skip UIA
        self.attached_browser_exe = ""
        self.scope_mode = "unknown"  # pid-tree | exe | unknown
        self.stealth: dict[str, Any] = {}
        self.clean_error = ""
        self.debug_port = 0
        self.last_restart_reason = ""
        self.started_at = 0.0
        self.hello_cache: dict[str, Any] = {}  # live dict shared with DriverHub.cdp_hello (FG-Gate reads browser_pids from it)
        self._in_reselect = False
        self._known_page_ids: set[int] = set()
        self.reselect_log: list[dict[str, Any]] = []  # last 50 No-page-found events (audit trail for verify_phase2)
        self.geo = GeometryService()
        self.last_geometry: dict[str, Any] = {}
        set_per_monitor_dpi_aware()

    # ------------------------------------------------------------------ lifecycle
    @property
    def lost(self) -> bool:
        return self.client is None or not self.client.alive

    def _profile_dir(self) -> Optional[str]:
        if self.env.get("DSCU_MCP_USER_DATA_DIR"):
            return self.env["DSCU_MCP_USER_DATA_DIR"]
        try:
            return str(self.cfg.auth_profile_dir)
        except Exception:  # noqa: BLE001
            return None

    def _argv(self) -> list[str]:
        cmd = self._cmd_override or resolve_command(self.env)
        args = self._args_override if self._args_override is not None else build_args(
            self.mode, profile_dir=self._profile_dir(), browser_url=self.env.get("DSCU_MCP_BROWSER_URL", ""), ws_endpoint=self.env.get("DSCU_MCP_WS_ENDPOINT", ""),
            channel=self.env.get("DSCU_MCP_CHANNEL", ""), headless=self.env.get("DSCU_MCP_HEADLESS") == "1", vision=self.env.get("DSCU_MCP_VISION", "0" if self.mode in (CLEAN_MODE, "autoconnect") else "1") != "0", stealth=self.env.get("DSCU_MCP_STEALTH", "1") != "0",
            executable=self.env.get("DSCU_MCP_EXECUTABLE") or (find_browser_executable() if self.mode in ("profile", "isolated") and not self.env.get("DSCU_MCP_CHANNEL") else ""))
        for f in FORCED_FLAGS:  # privacy flags can never be dropped, even by overrides
            if f not in args:
                args = [f, *args]
        return [*cmd, *args]

    def _log_path(self) -> Optional[Path]:
        try:
            return Path(self.cfg.data_dir) / "chrome-devtools-mcp.log"
        except Exception:  # noqa: BLE001
            return None

    async def _prepare_browser(self) -> None:
        """clean-browser-url: natively launch (or adopt) the clean Chrome BEFORE the MCP server attaches; the MCP server then never owns the browser process,
        so restarting the MCP server can no longer kill the page / login state."""
        if self._args_override is not None:  # explicit full argv (tests / expert override): the caller owns the browser
            return
        if self.mode == CLEAN_MODE:
            port = int(self.env.get("DSCU_CLEAN_PORT") or DEFAULT_PORT)
            if self.launcher is None:
                self.launcher = CleanChromeLauncher(port, self.env.get("DSCU_CLEAN_PROFILE", "") or clean_profile_dir(self.env), self.env.get("DSCU_CHROME_EXE", ""))
            try:
                await asyncio.to_thread(self.launcher.ensure, 25.0)
                self.debug_port = self.launcher.port
                self.env["DSCU_MCP_BROWSER_URL"] = f"http://127.0.0.1:{self.launcher.port}"
                self.attached_browser_pid, self.attached_browser_exe = self.launcher.pid, self.launcher.exe_name
                self.clean_error = ""
            except Exception as e:  # noqa: BLE001
                self.clean_error = str(e)[:400]
                self.mode = "profile"  # degrade to the stealth-stripped Puppeteer launch instead of failing the whole browser engine
                self.stats["clean_fallbacks"] += 1
        elif self.mode == "autoconnect":
            ap = await asyncio.to_thread(read_devtools_active_port, self.env.get("DSCU_MCP_CHANNEL", ""))
            if ap:
                self.debug_port = ap[0]
            else:
                print(autoconnect_hint(self.env.get("DSCU_MCP_CHANNEL", "")), flush=True)
        elif self.mode in ("browser-url", "ws"):
            m = re.search(r":(\d{2,5})", self.env.get("DSCU_MCP_BROWSER_URL", ""))
            self.debug_port = int(m.group(1)) if m else DEFAULT_PORT

    def _attach_scope(self) -> None:
        """Blocking (thread).  Decide WHICH browser process tree this engine controls.  FG-Gate trusts only that tree (never 'any chrome/msedge')."""
        if self._args_override is not None:  # explicit full argv (tests / expert override): the caller owns the browser
            return
        pid, exe = 0, ""
        if self.mode == CLEAN_MODE and self.launcher and self.launcher.pid:
            pid, exe = self.launcher.pid, self.launcher.exe_name
        elif self.mode in ("browser-url", "ws", "autoconnect") and self.debug_port:
            pid = find_browser_pid_by_port(self.debug_port)
            if not pid and self.mode == "autoconnect":
                exe = "chrome.exe"
        elif self.mode in ("profile", "isolated") and self.client and self.client.proc and self.client.proc.pid:
            ps = _psutil()
            try:
                for c in (ps.Process(self.client.proc.pid).children(recursive=True) if ps else []):
                    cl = c.cmdline()
                    if c.name().lower() in BROWSER_EXES and not any(str(a).startswith("--type=") for a in cl):
                        pid = int(c.pid)
                        break
            except Exception:  # noqa: BLE001
                pass
        if pid:
            self.attached_browser_pid, self.attached_browser_exe, self.scope_mode = pid, (proc_name(pid) or exe), "pid-tree"
        elif exe:
            self.attached_browser_pid, self.attached_browser_exe, self.scope_mode = 0, exe, "exe"
        self._pid_cache = (0.0, [])
        self.hello_cache.update(self.scope_info())

    async def _verify_stealth(self) -> None:
        try:
            v = await self.eval_js("() => ({webdriver: navigator.webdriver, ua: navigator.userAgent.slice(0, 90), langs: (navigator.languages || []).join(',')})", None, 15)
            if isinstance(v, dict):
                wd = v.get("webdriver")
                self.stealth = {"webdriver": wd, "clean": wd is not True, "ua": v.get("ua", ""), "mode": self.mode}
                if wd is True:
                    self.stats["webdriver_true"] += 1
        except Exception as e:  # noqa: BLE001
            self.stealth = {"error": str(e)[:100]}

    async def start(self, timeout: float = 90.0) -> None:
        t0 = time.perf_counter()
        await self._prepare_browser()
        argv = self._argv()
        self.client = McpStdioClient(argv, self.env, self._log_path())
        try:
            await self.client.start(timeout)
            self.started_at = time.time()
            await self.refresh_pages()
        except Exception as e:  # noqa: BLE001
            if self.mode == "autoconnect":
                raise McpError(f"autoconnect 失败：{str(e)[:200]}\n{autoconnect_hint(self.env.get('DSCU_MCP_CHANNEL', ''))}") from e
            raise
        await asyncio.to_thread(self._attach_scope)
        await self._verify_stealth()
        self.stats["start_ms"] = int((time.perf_counter() - t0) * 1000)
        self.hello_cache.update(await self.hello())

    async def aclose(self) -> None:
        if self.client:
            await self.client.stop()

    async def restart(self, reason: str, force_browser: bool = False) -> dict[str, Any]:
        async with self._heal_lock:
            t0 = time.perf_counter()
            self.crashes += 1
            last = ""
            for attempt in range(1, 6):
                try:
                    if self.client:
                        await self.client.stop()
                    if force_browser and self.launcher:
                        await asyncio.to_thread(self.launcher.terminate)
                    await asyncio.sleep(0.5 * attempt)
                    await self.start()
                    self.last_restart_reason = reason[:160]
                    self.restarts += 1
                    self.epoch += 1
                    self.refs.clear()
                    restored = False
                    if self.last_url.startswith("http") and (not self.pages or all(p["url"] in ("about:blank", "chrome://newtab/") for p in self.pages)):
                        try:
                            await self._tool("navigate_page", type="url", url=self.last_url)
                            restored = True
                        except McpError:
                            pass
                    return {"healed": True, "browser_respawned": True, "attempt": attempt, "restored_url": restored, "reason": reason[:120], "ms": int((time.perf_counter() - t0) * 1000)}
                except Exception as e:  # noqa: BLE001
                    last = str(e)
            raise McpTransportError(f"MCP supervisor: restart failed after 5 attempts: {last}")

    # ------------------------------------------------------------------ tool plumbing
    def _adapt(self, tool: str, kw: dict[str, Any]) -> dict[str, Any]:
        """Filter kwargs to the live tool schema (server versions differ) and inject the required `pageId` (--pageIdRouting default on)."""
        assert self.client
        props = ((self.client.tools.get(tool) or {}).get("inputSchema") or {}).get("properties") or {}
        out = {k: v for k, v in kw.items() if v is not None and (not props or k in props)}
        if "pageId" in props and "pageId" not in out and self.page_id is not None:
            out["pageId"] = self.page_id
        return out

    def has_tool(self, name: str) -> bool:
        return bool(self.client and name in self.client.tools)

    async def _tool(self, tool: str, timeout: float = 60.0, **kw: Any) -> McpResult:
        if not self.client or not self.client.alive:
            raise McpTransportError(self.client.dead_reason if self.client else "not started")
        if not self.has_tool(tool):
            raise McpError(f"chrome-devtools-mcp 没有工具 {tool}（版本过旧？运行 npm i -g " + pinned_spec() + "）")
        retries = 0
        while True:
            r = await self.client.call_tool(tool, self._adapt(tool, kw), timeout)
            self.stats["tool_calls"] += 1
            if not r.is_error:
                break
            if NO_PAGE_RX.search(r.text) and tool not in PAGE_MGMT_TOOLS and not self._in_reselect and retries < 3:
                retries += 1
                self.stats["no_page_found"] += 1
                if await self.reselect_page(f"{tool}: {r.text[:120]}"):
                    kw.pop("pageId", None)  # a stale explicit pageId must not survive the reselect; _adapt injects the fresh one
                    self.stats["mcp_soft_heal"] += 1
                    continue
            raise McpToolError(f"{tool}: {r.text[:400]}")
        if "restarted or reconnected" in r.text:  # server note: page ids changed
            await self.refresh_pages()
            self.epoch += 1
        return r

    async def _raw(self, tool: str, timeout: float = 40.0, **kw: Any) -> McpResult:
        """Tool call WITHOUT the page-reselect interception (used by the reselect itself to avoid recursion)."""
        if not self.client or not self.client.alive:
            raise McpTransportError(self.client.dead_reason if self.client else "not started")
        if not self.has_tool(tool):
            raise McpError(f"chrome-devtools-mcp 没有工具 {tool}")
        r = await self.client.call_tool(tool, self._adapt(tool, kw), timeout)
        self.stats["tool_calls"] += 1
        if r.is_error:
            raise McpToolError(f"{tool}: {r.text[:300]}")
        return r

    def _target_pages(self) -> list[dict[str, Any]]:
        return target_pages(self.pages)

    def _pick_page(self, pages: list[dict[str, Any]]) -> dict[str, Any]:
        """Choose the page to (re)select: exact last_url > brand-new non-blank tab (target=_blank / popup / new-tab shortcut) > same origin > server-selected > non-blank > newest."""
        from urllib.parse import urlparse

        def origin(u: str) -> str:
            try:
                pu = urlparse(u)
                return f"{pu.scheme}://{pu.netloc}" if pu.netloc else ""
            except ValueError:
                return ""

        blank = ("about:blank", "chrome://newtab/", "chrome://new-tab-page/", "")
        lo = origin(self.last_url)

        def score(p: dict[str, Any]) -> tuple[int, int]:
            s = 0
            u = str(p.get("url") or "")
            if self.last_url and u == self.last_url:
                s = max(s, 100)
            if p["page_id"] not in self._known_page_ids and u not in blank and not u.startswith("devtools://"):
                s = max(s, 90)
            if lo and origin(u) == lo:
                s = max(s, 60)
            if p.get("selected"):
                s = max(s, 40)
            if u not in blank and not u.startswith("devtools://"):
                s = max(s, 20)
            return s, int(p["page_id"])

        pool = [p for p in pages if not is_dev_tab(p)] or pages  # v17.1: never re-select a dev / terminal tab
        return max(pool, key=score)

    async def reselect_page(self, reason: str) -> bool:
        """Transparent Page-Reselect: list_pages -> select_page(best) (or new_page('about:blank') when the browser has none) -> epoch++ -> caller retries the original call."""
        if self.lost:
            return False
        t0 = time.perf_counter()
        ev: dict[str, Any] = {"t": round(time.time(), 3), "reason": reason[:140], "outcome": "failed"}
        self._in_reselect = True
        try:
            pages: list[dict[str, Any]] = []
            for attempt in range(3):
                pages = parse_pages((await self._raw("list_pages", timeout=40)).text)
                if pages:
                    break
                await asyncio.sleep(0.25 * (attempt + 1))
            if not pages:
                if not self.has_tool("new_page"):
                    return False
                await self._raw("new_page", url="about:blank")
                self.stats["new_page_fallbacks"] += 1
                ev["new_page"] = True
                pages = parse_pages((await self._raw("list_pages", timeout=40)).text)
                if not pages:
                    return False
            target = self._pick_page(pages)
            if self.has_tool("select_page"):
                await self._raw("select_page", pageId=target["page_id"], bringToFront=True)
            for pg in pages:
                pg["selected"] = pg["page_id"] == target["page_id"]
            self.pages = pages
            self.page_id = target["page_id"]
            self._known_page_ids = {int(p["page_id"]) for p in pages}
            if str(target.get("url", "")).startswith("http"):
                self.last_url = target["url"]
            self.epoch += 1
            self.refs.clear()
            self.geo.invalidate("page reselect")
            self.stats["page_reselects"] += 1
            self.stats["soft_heals"] += 1
            ev.update(outcome="reselected", page_id=self.page_id, url=str(target.get("url", ""))[:80], pages=len(pages), epoch=self.epoch)
            return True
        except McpTransportError:
            raise
        except McpError as e:
            ev["error"] = str(e)[:140]
            return False
        finally:
            self._in_reselect = False
            ev["ms"] = round((time.perf_counter() - t0) * 1000, 1)
            self.reselect_log.append(ev)
            del self.reselect_log[:-50]

    async def soft_heal(self, reason: str) -> bool:
        """Level-1 healing WITHOUT respawning the MCP server: re-list pages, re-select a live page (open about:blank if the browser has none), bump the epoch."""
        if self.lost:
            return False
        try:
            await self.refresh_pages()
            if not self.pages and self.has_tool("new_page"):
                await self._tool("new_page", url="about:blank")
                await self.refresh_pages()
            if not self.pages:
                return False
            self.epoch += 1
            self.refs.clear()
            self.stats["soft_heals"] += 1
            return True
        except McpError:
            return False

    async def _safe(self, tool: str, **kw: Any) -> McpResult:
        """Tool call with a 3-level ladder: (0) retry transient navigation noise in place  (1) soft heal (page list)  (2) respawn the MCP server - only if it is really dead."""
        last: Optional[McpError] = None
        for attempt in range(3):
            try:
                return await self._tool(tool, **kw)
            except McpTransportError as e:
                last = e
                break
            except McpError as e:
                msg = str(e)
                if TRANSIENT_TEXT_RX.search(msg) and attempt < 2:
                    self.stats["transient_retries"] += 1
                    await asyncio.sleep(0.35 * (attempt + 1))
                    continue
                if HEAL_TEXT_RX.search(msg) or NO_PAGE_RX.search(msg):
                    last = e
                    break
                raise
        assert last is not None
        if not isinstance(last, McpTransportError) and not self.lost:
            self.stats["supervised_retries"] += 1
            if await self.soft_heal(f"{tool}: {last}"):
                try:
                    return await self._tool(tool, **kw)
                except McpTransportError as e2:
                    last = e2
                except McpError as e2:
                    if not (HEAL_TEXT_RX.search(str(e2)) or NO_PAGE_RX.search(str(e2))):
                        raise
                    last = e2
        self.stats["supervised_retries"] += 1
        await self.restart(f"{tool}: {last}")
        return await self._tool(tool, **kw)

    async def refresh_pages(self) -> list[dict[str, Any]]:
        r = await self._tool("list_pages", 40)
        self.pages = parse_pages(r.text)
        sel = next((p for p in self.pages if p["selected"]), self.pages[0] if self.pages else None)
        self.page_id = sel["page_id"] if sel else None
        self._known_page_ids |= {int(p["page_id"]) for p in self.pages}
        if self.pages and not any(p["selected"] for p in self.pages) and not self._in_reselect and self.has_tool("select_page"):
            await self.reselect_page("list_pages shows no selected page")
        if sel and sel["url"].startswith("http"):
            self.last_url = sel["url"]
        return self.pages

    async def eval_js(self, fn: str, uids: Optional[list[str]] = None, timeout: float = 30.0) -> Any:
        kw: dict[str, Any] = {"function": fn}
        if uids:
            kw["args"] = [{"uid": u} for u in uids] if self._args_are_objects() else list(uids)
        r = await self._safe("evaluate_script", timeout=timeout, **kw)
        m = re.search(r"```(?:json)?\s*\n(.*?)\n```", r.text, re.S)
        blob = (m.group(1) if m else r.text).strip()
        try:
            return json.loads(blob)
        except Exception:  # noqa: BLE001
            m2 = re.search(r"(\{.*\}|\[.*\]|true|false|null|-?\d+(?:\.\d+)?|\"(?:[^\"\\]|\\.)*\")\s*$", blob, re.S)
            if m2:
                try:
                    return json.loads(m2.group(1))
                except Exception:  # noqa: BLE001
                    pass
            return blob

    def _args_are_objects(self) -> bool:
        """Some builds take args=[{uid}], others args=['uid'] - read the schema."""
        try:
            items = ((self.client.tools["evaluate_script"]["inputSchema"]["properties"]["args"]) or {}).get("items") or {}  # type: ignore[union-attr]
            return items.get("type") == "object"
        except Exception:  # noqa: BLE001
            return True

    # ------------------------------------------------------------------ diagnostics (no more blind-wait timeouts)
    async def diagnose(self) -> tuple[str, dict[str, Any]]:
        net: list[dict[str, Any]] = []
        con: list[dict[str, Any]] = []
        try:
            net = parse_network((await self._tool("list_network_requests", 20)).text)
        except McpError:
            pass
        try:
            con = parse_console((await self._tool("list_console_messages", 20)).text)
        except McpError:
            pass
        msg, data = summarize_diag(net, con)
        self.last_diag = msg
        self.stats["diagnostics"] += 1
        return msg, data

    # ------------------------------------------------------------------ observe
    async def observe(self, req: dict[str, Any]) -> dict[str, Any]:
        t0 = time.perf_counter()
        max_el = int(req.get("max_elements") or 200)
        settle = int(req.get("settle_ms") or 0)
        async with self._lock:
            if self.lost:
                await self.restart("observe: link down")
            if not self.pages:
                await self.refresh_pages()
            if settle:
                end = time.time() + min(settle, 1500) / 1000
                while time.time() < end:
                    try:
                        if await self.eval_js("() => document.readyState") == "complete":
                            break
                    except McpError:
                        break
                    await asyncio.sleep(0.12)
            snap = (await self._safe("take_snapshot", timeout=60)).text
            self.hello_cache.update(self.scope_info())
            nodes = parse_snapshot(snap)
            els = select_elements(nodes, max_el)
            self.epoch += 1
            self.refs = {}
            root = nodes[0] if nodes else {"name": "", "props": {}}
            url = str(root["props"].get("url") or (next((p["url"] for p in self.pages if p["selected"]), "") or ""))
            if url.startswith("http"):
                self.last_url = url
            # geometry: ONE batched evaluate_script for the first N elements (viewport CSS px); failure is non-fatal
            rects: list[Any] = []
            subset = els[:60]
            if subset:
                try:
                    out = await self.eval_js("(...els) => els.map(e => { const r = e.getBoundingClientRect(); return [Math.round(r.x), Math.round(r.y), Math.round(r.width), Math.round(r.height)]; })",
                                             [e["uid"] for e in subset], 20)
                    rects = out if isinstance(out, list) else []
                except McpError:
                    rects = []
            geom = None
            if rects:
                try:
                    probe = await self.eval_js(VIEWPORT_PROBE_JS, None, 15)
                    if isinstance(probe, dict):
                        geom = await asyncio.to_thread(self.geo.geometry, probe, self.attached_browser_pid, self.page_id, self.restarts * 1000 + self.stats['page_reselects'])
                except McpError:
                    geom = None
            self.last_geometry = geom.to_dict() if geom else {}
            elements = []
            for n, e in enumerate(els):
                ref = f"@{self.epoch}:c{n + 1}"
                self.refs[ref] = {"uid": e["uid"], "role": e["role"], "name": e["name"]}
                rc = rects[n] if n < len(rects) and isinstance(rects[n], list) and len(rects[n]) == 4 else [0, n * 4, 0, 0]
                rc_css = list(rc)
                if geom is not None and n < len(rects) and isinstance(rects[n], list) and len(rects[n]) == 4:
                    rc = self.geo.norm.css_rect_to_phys(geom, rc)  # v16.3: PHYS virtual-desktop px (same space as UIA / SendInput / vision clicks)
                elements.append({"ref_id": ref, "role": e["role"], "name": e["name"][:200], "value": e["value"], "rect": [int(v) for v in rc], "zone": e["zone"],
                                 "stable_key": e["stable_key"], "states": e["states"], "patterns": ["mcp:uid"], "row": e["row"], "occluded": False, "url": e["url"], "rect_css": rc_css})
            canvas_only = False
            diag_msg = ""
            diag: dict[str, Any] = {}
            interactive = [e for e in els if e["role"].lower() not in ("heading", "img", "listitem", "row", "cell", "gridcell")]
            if len(interactive) < 2:
                try:
                    canvas_only = int(await self.eval_js("() => document.querySelectorAll('canvas').length") or 0) > 0 and len(interactive) < 2
                except (McpError, ValueError, TypeError):
                    canvas_only = False
                if len(nodes) <= 3 or canvas_only or len(interactive) == 0:
                    diag_msg, diag = await self.diagnose()
                    if canvas_only:
                        diag_msg = "页面主要由 <canvas> 绘制，a11y 树无可操作节点 → 请 vision_inspect 切回 DXGI+deepseek-flash+DsNative61 物理点击；" + diag_msg
            title = ""
            try:
                title = str(await self.eval_js("() => document.title") or "")[:200]
            except McpError:
                title = str(root.get("name") or "")
            tel: dict[str, Any] = {"engine": "chrome-devtools-mcp", "snapshot_nodes": len(nodes), "elements": len(elements), "total_ms": round((time.perf_counter() - t0) * 1000, 1),
                                   "page_id": self.page_id, "geometry_space": ("virtual_desktop_physical_px" if geom is not None else "viewport_css_px"), "geometry": self.last_geometry, "canvas_only": canvas_only}
            if diag_msg:
                tel["mcp_diagnostics"] = diag_msg
                tel["diag"] = diag
            return {"type": "observation", "id": req.get("id"), "ok": True, "channel": "cdp", "snapshot_epoch": self.epoch, "hwnd": 0, "title": title, "process": "",
                    "url": url or None, "windows": [], "elements": elements, "settled": True, "inflight": 0, "uia_blind": bool(canvas_only), "telemetry": tel}

    # ------------------------------------------------------------------ actions
    def _res(self, req: dict[str, Any], ok: bool, code: str, msg: str, eff: dict[str, Any], t0: float) -> dict[str, Any]:
        return {"type": "action_result", "id": req.get("id"), "action_id": req.get("action_id"), "ok": ok, "code": code, "message": msg, "effect": eff,
                "idempotent_replay": False, "latency_ms": round((time.perf_counter() - t0) * 1000, 1)}

    def _resolve(self, req: dict[str, Any], key: str = "ref") -> tuple[Optional[str], Optional[tuple[str, str]]]:
        ref = str(req.get(key) or "")
        if not ref:
            return None, ("NOT_FOUND", f"{key} required")
        m = re.match(r"@(\d+):", ref)
        ee = req.get("expect_epoch")
        if (m and int(m.group(1)) != self.epoch) or (ee is not None and int(ee) != self.epoch):
            return None, ("STALE_EPOCH", f"ref {ref} 属于旧快照（当前 epoch={self.epoch}）；请重新观察")
        info = self.refs.get(ref)
        if not info:
            return None, ("STALE_EPOCH", f"ref {ref} 不在当前快照中；请重新观察")
        return info["uid"], None

    async def action(self, req: dict[str, Any]) -> dict[str, Any]:
        aid = str(req.get("action_id") or "")
        if aid and aid in self.replay:
            r = dict(self.replay[aid])
            r["id"], r["idempotent_replay"] = req.get("id"), True
            return r
        light = str(req.get("action")) in ("tabs", "probe")
        t0 = time.perf_counter()
        try:
            if light:
                out = await self._action_inner(req, t0)
            else:
                async with self._lock:
                    out = await self._action_inner(req, t0)
        except McpTransportError as e:
            out = await self._supervised(req, t0, str(e))
        except McpError as e:
            msg = str(e)
            if TRANSIENT_TEXT_RX.search(msg):
                self.stats["transient_actions"] += 1
                await asyncio.sleep(0.4)
                out = self._res(req, False, "STALE_EPOCH", f"页面正在导航/刷新（瞬态：{msg[:100]}）；未重启浏览器引擎，请重新观察后再操作", {"transient": True}, t0)
            elif HEAL_TEXT_RX.search(msg):
                out = await self._supervised(req, t0, msg)
            elif "timeout" in msg.lower():
                dm, dd = await self._diag_safe()
                out = self._res(req, False, "TIMEOUT", f"{msg}｜[诊断] {dm}", {"diagnostics": dd}, t0)
            elif STALE_TEXT_RX.search(msg) and req.get("ref"):
                out = self._res(req, False, "STALE_EPOCH", f"元素已失效（{msg[:160]}）；请重新观察后再操作", {}, t0)
            else:
                out = self._res(req, False, "INTERNAL", msg[:500], {}, t0)
        if aid and out.get("code") != "STALE_EPOCH":
            self.replay[aid] = out
            if len(self.replay) > 512:
                self.replay.pop(next(iter(self.replay)))
        return out

    async def _diag_safe(self) -> tuple[str, dict[str, Any]]:
        try:
            return await self.diagnose()
        except Exception as e:  # noqa: BLE001
            return f"诊断不可用: {e}", {}

    SAFE_REPLAY = {"navigate", "new_tab", "key", "scroll", "scroll_into_view", "tabs", "switch_tab", "wait_selector", "wait_settled", "probe", "diagnose", "list_network", "list_console"}

    async def _supervised(self, req: dict[str, Any], t0: float, why: str) -> dict[str, Any]:
        try:
            if not self.lost and await self.soft_heal(why):
                info = {"healed": True, "level": "soft", "browser_respawned": False, "reason": why[:120]}
            else:
                info = await self.restart(why)
        except Exception as e:  # noqa: BLE001
            return self._res(req, False, "INTERNAL", f"[MCP_SUPERVISOR] 重启失败：{e}", {}, t0)
        if str(req.get("action")) in self.SAFE_REPLAY:
            try:
                async with self._lock:
                    out = await self._action_inner(req, time.perf_counter())
                out["effect"] = {**(out.get("effect") or {}), "self_healed": True, "heal": info}
                return out
            except McpError as e2:
                return self._res(req, False, "INTERNAL", str(e2)[:400], {"healed": True}, t0)
        return self._res(req, False, "STALE_EPOCH", f"浏览器连接已由 MCP Supervisor 自愈（epoch={self.epoch}，已按原 Profile 重启并恢复页面）；旧元素 ref 已失效，请重新观察后再操作", {"healed": True, "heal": info}, t0)

    async def _page_state(self) -> dict[str, Any]:
        try:
            v = await self.eval_js("() => ({url: location.href, title: document.title})", None, 15)
            return v if isinstance(v, dict) else {}
        except McpError:
            return {}

    async def _action_inner(self, req: dict[str, Any], t0: float) -> dict[str, Any]:
        a = str(req.get("action", ""))
        healed: Optional[dict[str, Any]] = None
        if self.lost:
            healed = await self.restart(f"action {a}: link down")
        if not self.pages:
            await self.refresh_pages()
        before = await self._page_state() if a not in ("tabs", "probe", "diagnose") else {}
        eff: dict[str, Any] = {"url_before": before.get("url"), "title_before": before.get("title"), "epoch_before": self.epoch, "engine": "chrome-devtools-mcp"}
        if healed:
            eff.update(self_healed=True, heal=healed)

        async def done(msg: str) -> dict[str, Any]:
            after = await self._page_state() if a not in ("tabs", "probe", "diagnose") else {}
            eff.update(url_after=after.get("url"), title_after=after.get("title"), page_changed=bool(after) and (after.get("url") != before.get("url") or after.get("title") != before.get("title")))
            return self._res(req, True, "OK", msg, eff, t0)

        if a == "navigate":
            url = str(req.get("url", ""))
            if not re.match(r"^https?://", url, re.I) and url != "about:blank":
                return self._res(req, False, "SECURITY_DENIED", "only http(s) URLs may be navigated", eff, t0)
            if self.page_id is None:
                await self._safe("new_page", url=url)
                await self.refresh_pages()
            else:
                await self._safe("navigate_page", type="url", url=url, timeout=int(req.get("timeout_ms") or 30000))
            self.last_url = url
            self.epoch += 1
            return await done(f"navigated to {url}")
        if a in ("new_tab", "new_page"):
            url = str(req.get("url", "about:blank"))
            if not re.match(r"^https?://", url, re.I) and url != "about:blank":
                return self._res(req, False, "SECURITY_DENIED", "only http(s) URLs may be opened", eff, t0)
            await self._safe("new_page", url=url)
            await self.refresh_pages()
            self.epoch += 1
            return await done(f"opened new tab {url} (page {self.page_id})")
        if a == "tabs":
            await self.refresh_pages()
            _tp = self._target_pages()
            eff["tabs"] = [{"index": i + 1, "target_id": str(p["page_id"]), "url": p["url"], "selected": p["selected"]} for i, p in enumerate(_tp)]
            eff["hidden_dev_tabs"] = len(self.pages) - len(_tp)
            eff["active_target"] = str(self.page_id)
            return self._res(req, True, "OK", f"{len(self.pages)} tab(s)", eff, t0)
        if a == "switch_tab":
            await self.refresh_pages()
            pick = None
            if req.get("target_id"):
                pick = next((p for p in self.pages if str(p["page_id"]) == str(req["target_id"])), None)
            elif req.get("url_contains"):
                pick = next((p for p in self.pages if str(req["url_contains"]) in p["url"]), None)
            elif req.get("index"):
                i = int(req["index"]) - 1
                _tp = self._target_pages()  # v17.1: `第 N 个标签页` counts USER tabs only
                pick = _tp[i] if 0 <= i < len(_tp) else None
            if not pick:
                return self._res(req, False, "NOT_FOUND", f"no such tab (have {len(self.pages)}): " + " | ".join(f"{i + 1}:{p['url'][:40]}" for i, p in enumerate(self.pages)), eff, t0)
            await self._safe("select_page", pageId=pick["page_id"], bringToFront=True)
            self.page_id = pick["page_id"]
            self.epoch += 1
            self.refs.clear()
            eff["last_switch"] = {"to": pick["page_id"], "url": pick["url"]}
            return await done(f"switched to tab {pick['page_id']} {pick['url'][:60]}")
        if a == "probe":
            needles = [str(x) for x in (req.get("needles") or [])]
            js = ("() => { const nd = __ND__; const body = ((document.body && document.body.innerText) || '').slice(0, 300000);"
                  " const needles = {}; for (const n of nd) needles[n] = body.includes(n);"
                  " const h32 = (s) => { let h = 0x811c9dc5; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; } return h; };"
                  " const lines = body.split(/\\n+/).map(s => s.trim()).filter(s => s.length > 1).slice(0, 700);"
                  " const line_hashes = [...new Set(lines.map(h32))];"
                  " const expanded = [...document.querySelectorAll('[aria-expanded=\"true\"]')].map(e => ((e.innerText || e.getAttribute('aria-label') || e.id || e.tagName) + '').trim().replace(/\\s+/g, ' ').slice(0, 40)).slice(0, 30);"
                  " return {url: location.href, title: document.title, readyState: document.readyState, body_len: body.length,"
                  " inputs: [...document.querySelectorAll('input,textarea')].map(e => e.value).filter(Boolean).slice(0, 12), needles,"
                  " has_video_player: !!document.querySelector('video'), expanded, line_hashes, text_digest: h32(lines.join('\\n')).toString(16),"
                  " n_nodes: document.getElementsByTagName('*').length}; }").replace("__ND__", json.dumps(needles, ensure_ascii=False))
            info = await self.eval_js(js, None, 30)
            if isinstance(info, dict):
                eff.update(info)
            eff.update(tabs=len(self.pages), active_target=str(self.page_id))
            return self._res(req, True, "OK", f"probe {str(eff.get('url', ''))[:80]}", eff, t0)
        if a == "eval":
            if self.env.get("DSCU_ALLOW_EVAL") != "1":
                return self._res(req, False, "SECURITY_DENIED", "eval is disabled", eff, t0)
            eff["value"] = await self.eval_js(str(req.get("expression", "() => null")) if str(req.get("expression", "")).lstrip().startswith(("(", "async", "function")) else f"() => ({req.get('expression', 'null')})")
            return await done("eval ok")
        if a in ("diagnose", "list_network", "list_console"):
            msg, data = await self.diagnose()
            eff["diagnostics"] = data
            return self._res(req, True, "OK", f"[浏览器诊断] {msg}", eff, t0)
        if a == "wait_settled":
            end = time.time() + float(req.get("timeout_ms") or 2500) / 1000
            while time.time() < end:
                if await self.eval_js("() => document.readyState") == "complete":
                    break
                await asyncio.sleep(0.12)
            return await done("settled check")
        if a == "wait_selector":
            # v16.4 Typed Selector Contract: {"by": css|role_name|aria_label|text_contains, "value": ...}.  Playwright-style `text=...` strings are PARSED, never passed to querySelector.
            from .typed_selector import build_finder_js, finder_error, finder_found, parse_selector

            tmo = int(req.get("timeout_ms") or 8000)
            try:
