import asyncio
import json
import os
import re
import shutil
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

from .artifact import ArtifactResult, verify_artifact
from .jail import SecurityError, TaintedContext, assert_safe_path

# app keyword -> (task regex, native headless tool, preferred cli-anything package)
HEADLESS = {
    "libreoffice": (r"(word|excel|ppt|docx|xlsx|pptx|pdf|文档|表格|幻灯|libreoffice|转换.*pdf|导出.*pdf)", "soffice", "cli-anything-libreoffice"),
    "ffmpeg": (r"(ffmpeg|转码|视频.*(转|剪|压缩)|音频.*(转|提取)|mp4|mp3|gif)", "ffmpeg", "cli-anything-ffmpeg"),
    "obs": (r"(\bobs\b|录屏|直播|推流)", "obs-cmd", "cli-anything-obs"),
    "blender": (r"(blender|渲染|3d)", "blender", "cli-anything-blender"),
    "zotero": (r"(zotero|文献)", "zotero", "cli-anything-zotero"),
    "calibre": (r"(calibre|电子书|epub|mobi)", "ebook-convert", "cli-anything-calibre"),
    "mockdoc": (r"(mockdoc|__mock__)", "", "cli-anything-mockdoc"),
}
NETWORK_TOOLS = {"curl", "wget", "yt-dlp", "pip", "npm", "git", "obs-cmd"}
META = re.compile(r"[;&|`$<>\n\r]")
PATH_ARG = re.compile(r"^(--?(out|output|o|in|input|i|file|dir|path|project)(=|$))", re.I)


@dataclass
class CliTool:
    name: str
    path: str
    kind: str                      # cli-anything | headless
    app: str = ""
    skill: dict = field(default_factory=dict)


@dataclass
class CliResult:
    ok: bool
    tool: str
    exit_code: int
    seconds: float
    stdout_json: dict | None
    artifacts: list[ArtifactResult]
    error: str = ""

    def as_dict(self):
        return {"ok": self.ok, "tool": self.tool, "exit": self.exit_code, "sec": round(self.seconds, 3),
                "json": self.stdout_json, "artifacts": [a.as_dict() for a in self.artifacts], "error": self.error}


def _parse_skill_md(p: Path) -> dict:
    meta: dict = {}
    try:
        txt = p.read_text("utf-8", errors="replace")
        m = re.match(r"^---\n(.*?)\n---", txt, re.S)
        if m:
            for ln in m.group(1).splitlines():
                if ":" in ln:
                    k, v = ln.split(":", 1); meta[k.strip()] = v.strip()
    except OSError:
        pass
    return meta


class CliRouter:
    def __init__(self, jail_root: str, taint: TaintedContext | None = None, extra_dirs: list[str] | None = None,
                 allow_network: bool = False, timeout_s: float = 60.0):
        self.root = jail_root
        self.taint = taint or TaintedContext()
        self.extra = [d for d in (extra_dirs or []) + os.environ.get("DSCU_CLI_PATH", "").split(os.pathsep) if d]
        self.allow_network = allow_network
        self.timeout = timeout_s
        self.tools: dict[str, CliTool] = {}

    # ---- discovery -------------------------------------------------------------------------------------------
    def discover(self) -> dict[str, CliTool]:
        self.tools.clear()
        dirs = self.extra + os.environ.get("PATH", "").split(os.pathsep)
        skill_dirs = [Path(os.environ.get("CLI_ANYTHING_SKILLS_DIR", "")) if os.environ.get("CLI_ANYTHING_SKILLS_DIR") else None,
                      Path.home() / ".cli-anything" / "skills"]
        for d in dirs:
            try:
                for f in Path(d).iterdir():
                    n = f.stem if f.suffix.lower() in (".exe", ".cmd", ".bat", ".py", ".ps1") else f.name
                    if n.startswith("cli-anything-") and n not in self.tools and f.is_file():
                        app = n[len("cli-anything-"):]
                        skill = {}
                        for sd in skill_dirs:
                            if sd and (sd / app / "SKILL.md").is_file():
                                skill = _parse_skill_md(sd / app / "SKILL.md"); break
                        self.tools[n] = CliTool(n, str(f), "cli-anything", app, skill)
            except OSError:
                continue
        for app, (_, native, _) in HEADLESS.items():
            exe = native and shutil.which(native)
            if exe and native not in self.tools:
                self.tools[native] = CliTool(native, exe, "headless", app)
        return self.tools

    # ---- routing -----------------------------------------------------------------------------------------------
    def route(self, task: str) -> CliTool | None:
        """Layer-0 hit = task names an app we can drive natively AND the tool is installed. cli-anything wins over raw headless."""
        if not self.tools:
            self.discover()
        for app, (rx, native, pkg) in HEADLESS.items():
            if re.search(rx, task, re.I):
                if pkg in self.tools:
                    return self.tools[pkg]
                if native in self.tools:
                    return self.tools[native]
        return None

    # ---- safety ------------------------------------------------------------------------------------------------
    def validate_args(self, tool: CliTool, args: list[str]) -> list[str]:
        base = Path(tool.path).stem
        if base in NETWORK_TOOLS or tool.name in NETWORK_TOOLS:
            if self.taint.tainted or not self.allow_network:
                raise SecurityError("SECURITY_TAINT_BLOCKED", f"network-capable tool {tool.name} refused (tainted={self.taint.tainted})")
        out: list[str] = []
        for i, a in enumerate(args):
            a = str(a)
            if META.search(a):
                raise SecurityError("SECURITY_EXEC_VIOLATION", f"shell metacharacter in argument {a!r}")
            if re.match(r"^(https?|ftp)://", a, re.I) and (self.taint.tainted or not self.allow_network):
                raise SecurityError("SECURITY_TAINT_BLOCKED", f"unauthorised network URL {a!r}")
            val = a
            if PATH_ARG.match(a) and "=" in a:
                k, val = a.split("=", 1)
                out.append(f"{k}={assert_safe_path(val, self.root, 'write' if re.match(r'^--?(out|output|o)', k, re.I) else 'read')}")
                continue
            if i > 0 and PATH_ARG.match(str(args[i - 1])) and "=" not in str(args[i - 1]):
                op = "write" if re.match(r"^--?(out|output|o)$", str(args[i - 1]), re.I) else "read"
                out.append(str(assert_safe_path(val, self.root, op)))
                continue
            out.append(a)
        return out

    # ---- execution ---------------------------------------------------------------------------------------------
    async def run(self, tool: CliTool, args: list[str], expect: list[dict] | None = None) -> CliResult:
        args = self.validate_args(tool, args)
        expect = expect or []
        checks = []
        for e in expect:                       # jail the declared outputs too
            checks.append((assert_safe_path(e["path"], self.root, "write"), e.get("kind"), int(e.get("min_bytes", 64))))
        if tool.kind == "cli-anything" and "--json" not in args:
            args = ["--json", *args]
        cmd = [tool.path, *args]
        if tool.path.lower().endswith(".py"):
            cmd = [sys.executable, tool.path, *args]
        t0 = time.perf_counter()
        proc = await asyncio.create_subprocess_exec(*cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
                                                    cwd=self.root)
        try:
            so, se = await asyncio.wait_for(proc.communicate(), self.timeout)
        except asyncio.TimeoutError:
            proc.kill(); await proc.wait()
            return CliResult(False, tool.name, -9, time.perf_counter() - t0, None, [], "timeout")
        dt = time.perf_counter() - t0
        js = None
        try:
            js = json.loads(so.decode("utf-8", "replace").strip().splitlines()[-1]) if so.strip() else None
        except (ValueError, IndexError):
            js = None
        self.taint.mark("cli-output", so.decode("utf-8", "replace")[:4000])  # CLI stdout is untrusted data
        arts = [verify_artifact(p, k, mb) for p, k, mb in checks]
        ok = proc.returncode == 0 and all(a.ok for a in arts)    # exit 0 alone is never enough
        err = "" if ok else (se.decode("utf-8", "replace")[:300] or "; ".join(a.detail for a in arts if not a.ok))
        return CliResult(ok, tool.name, proc.returncode or 0, dt, js, arts, err)


class ReplSession:
    """Persistent `cli-anything-<app> repl --json` session: one process, stateful project, undo/redo."""
    def __init__(self, tool: CliTool, cwd: str):
        self.tool, self.cwd, self.proc = tool, cwd, None

    async def start(self):
        cmd = [self.tool.path, "--json", "repl"]
        if self.tool.path.lower().endswith(".py"):
            cmd = [sys.executable, self.tool.path, "--json", "repl"]
        self.proc = await asyncio.create_subprocess_exec(*cmd, stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
                                                         stderr=asyncio.subprocess.DEVNULL, cwd=self.cwd)

    async def send(self, line: str) -> dict:
        assert self.proc and self.proc.stdin and self.proc.stdout
        if META.search(line):
            raise SecurityError("SECURITY_EXEC_VIOLATION", "metacharacter in REPL line")
        self.proc.stdin.write((line + "\n").encode()); await self.proc.stdin.drain()
        raw = await asyncio.wait_for(self.proc.stdout.readline(), 30)
        return json.loads(raw.decode())

    async def undo(self): return await self.send("undo")
    async def redo(self): return await self.send("redo")

    async def close(self):
        if self.proc and self.proc.returncode is None:
            try:
                await self.send("exit")
            except Exception:  # noqa: BLE001
                self.proc.kill()
            await self.proc.wait()
