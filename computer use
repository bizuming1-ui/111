function Invoke-V12SmartFocus([string]$Keyword) {
    $v = $script:V12
    if ($v.NoPreflight -or -not $IsWindows -or [string]::IsNullOrWhiteSpace($Keyword)) { return $null }
    $wins = @(Get-TopWindowList 60); if ($wins.Count -eq 0) { return $null }
    $kw = $Keyword.ToLower().Trim()
    $hit = @($wins | Where-Object { "$($_.Title)".ToLower().Contains($kw) -or "$($_.Process)".ToLower().Contains($kw) })
    if ($hit.Count -eq 0) { return $null }
    $procs = @($hit | ForEach-Object { "$($_.Process)" } | Select-Object -Unique)
    $cands = @($wins | Where-Object { $procs -contains "$($_.Process)" -and "$($_.Process)" })
    $need = ($v.TaskText -match $script:V12NeedInputRx)
    $roHit = @($hit | Where-Object { "$($_.Title)" -match $script:V12ReadOnlyRx })
    if ($cands.Count -lt 2 -and $roHit.Count -eq 0) { return $null }          # 单窗口、非只读 → 完全交给原实现（零退化）
    $v.Preflights++
    $fps = @($cands | Select-Object -First 6 | ForEach-Object { Get-V12WindowFp $_ })
    $pick = Select-V12Window $fps $Keyword $need
    if (-not $pick) { return $null }
    $ok = $false; try { $ok = [DsNative12]::ForceForeground([IntPtr]$pick.Handle) } catch { try { $ok = [DsNative61]::Activate([IntPtr]$pick.Handle) } catch { } }
    if (-not $ok) { return $null }
    $skipped = @($fps | Where-Object { $_.Handle -ne $pick.Handle -and "$($_.Title)" -match $script:V12ReadOnlyRx -and [int]$_.Edit -eq 0 })
    if ($skipped.Count -gt 0 -and "$($pick.Title)" -notmatch $script:V12ReadOnlyRx) { $v.PopupAvoided++ }
    Wait-Safe 160
    return "已切换到窗口: $($pick.Title)（v12 语义指纹预检：类名=$($pick.Class)，可编辑控件=$($pick.Edit)，$(if ($skipped.Count) { "已避开只读/无输入框子窗「$(Limit-Text $skipped[0].Title 20)」" } else { '主窗体' })）"
}
