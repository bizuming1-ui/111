def to_wire(obj: Any) -> dict:
    """dataclass -> JSON-able dict with None fields dropped (the wire never carries nulls)."""
    def clean(x):
        if isinstance(x, dict):
            return {k: clean(v) for k, v in x.items() if v is not None}
        if isinstance(x, list):
            return [clean(i) for i in x]
        if isinstance(x, Enum):
            return x.value
        return x
    return clean(asdict(obj))


def dumps(obj: Any) -> str:
    return json.dumps(to_wire(obj), ensure_ascii=False, separators=(",", ":"))


_SCHEMA: dict | None = None


def load_schema() -> dict:
    global _SCHEMA
    if _SCHEMA is None:
        _SCHEMA = json.loads(SCHEMA_PATH.read_text("utf-8"))
    return _SCHEMA


def _check(inst: Any, sch: dict, root: dict, path: str, errs: list[str]) -> None:
    if "$ref" in sch:
        node = root
        for part in sch["$ref"].lstrip("#/").split("/"):
            node = node[part]
        return _check(inst, node, root, path, errs)
    if "enum" in sch and inst not in sch["enum"]:
        errs.append(f"{path}: {inst!r} not in {sch['enum']}")
        return
    t = sch.get("type")
    py = {"object": dict, "array": list, "string": str, "boolean": bool}
    if t == "integer" and (isinstance(inst, bool) or not isinstance(inst, int)):
        errs.append(f"{path}: expected integer"); return
    if t == "number" and (isinstance(inst, bool) or not isinstance(inst, (int, float))):
        errs.append(f"{path}: expected number"); return
    if t in py and not isinstance(inst, py[t]):
        errs.append(f"{path}: expected {t}"); return
    if isinstance(inst, (int, float)) and not isinstance(inst, bool):
        if "minimum" in sch and inst < sch["minimum"]:
            errs.append(f"{path}: {inst} < minimum {sch['minimum']}")
        if "maximum" in sch and inst > sch["maximum"]:
            errs.append(f"{path}: {inst} > maximum {sch['maximum']}")
    if isinstance(inst, dict):
        for k in sch.get("required", []):
            if k not in inst:
                errs.append(f"{path}: missing required '{k}'")
        for k, sub in sch.get("properties", {}).items():
            if k in inst:
                _check(inst[k], sub, root, f"{path}.{k}", errs)
    if isinstance(inst, list):
        if "minItems" in sch and len(inst) < sch["minItems"]:
            errs.append(f"{path}: fewer than {sch['minItems']} items")
        if "maxItems" in sch and len(inst) > sch["maxItems"]:
            errs.append(f"{path}: more than {sch['maxItems']} items")
        if "items" in sch:
            for i, it in enumerate(inst):
                _check(it, sch["items"], root, f"{path}[{i}]", errs)


def validate(instance: Any, def_name: str) -> list[str]:
    """Return [] when `instance` satisfies #/$defs/<def_name>; otherwise human-readable errors."""
    root = load_schema()
    errs: list[str] = []
    _check(instance, {"$ref": f"#/$defs/{def_name}"}, root, def_name, errs)
    return errs


def schema_enum(def_name: str) -> list[str]:
    return list(load_schema()["$defs"][def_name]["enum"])
