# ====================================================================================================================== outcome of one route attempt
@dataclass
class RouteOutcome:
    status: str                    # done | blocked | clarify | failed | partial
    code: str = "OK"
    detail: str = ""
    rows: list[dict[str, Any]] = field(default_factory=list)
    summary: str = ""


def _fmt(rows: list[dict[str, Any]], limit: int = 12) -> str:
    return " ; ".join(f"{'✓' if r['ok'] else '✗'}{r['name']}({str(r['detail'])[:80]}{'' if r.get('evaluated', True) else ' · 未评估'})" for r in rows[:limit]) + (f" …(+{len(rows) - limit})" if len(rows) > limit else "")


def _coverage(rows: list[dict[str, Any]]) -> str:
    ev = [r for r in rows if r.get("evaluated", True)]
    if not ev or not all(r["ok"] for r in ev):
        return "none"
    return "full" if len(ev) == len(rows) else "partial"


class CoreLoop:
    def __init__(self, orch: Any = None, world: Optional[WorldModel] = None, effectors: Any = None, ledger: Optional[atx.TxLedger] = None,
                 open_view: Optional[Callable[..., Any]] = None, confirm: Optional[atx.ConfirmFn] = None, say: Optional[Say] = None) -> None:
        self.orch = orch
        self._say = say
        self.world = world or self._default_world()
        self.effectors = effectors
        self.open_view = open_view
        data_dir = getattr(getattr(orch, "cfg", None), "data_dir", None)
        self.ledger = ledger or atx.TxLedger(Path(data_dir) / "tx_v181.jsonl" if data_dir else None)
        self.engine = atx.TxEngine(self.ledger, atx.AuthorizationPolicy(), confirm or self._confirm)
        self.goal: Optional[GoalSpec] = None
        self.planner: Optional[RecoveryPlanner] = None
        self.gui_planner = RecoveryPlanner(None, RouteGraph.for_web())
        self.directive = ""
        self.stats = {"goals": 0, "route_runs": 0, "blocked_edges": 0, "reroutes": 0, "handoffs": 0, "llm_fallthrough": 0, "budget_reroutes": 0, "ordinal_goals": 0}
        self._consec_fail: dict[str, int] = {}
        self._tried_channels: list[str] = []
        self._budget_reroutes = 0
        self._good: list[dict[str, Any]] = []

    # ------------------------------------------------------------------ plumbing
    @staticmethod
    def _default_world() -> WorldModel:
        try:
            roots = rb.user_roots()
        except Exception:  # noqa: BLE001
            roots = {}
        fs = FileSystemProvider({"desktop": roots.get("桌面", Path.home() / "Desktop"), "documents": roots.get("文档", Path.home() / "Documents"),
                                 "downloads": roots.get("下载", Path.home() / "Downloads")})
        return WorldModel(CompositeProvider(fs, RecycleBinProvider(rb.ComBackend())),
                          AuthorizedScope({"desktop": fs.roots["desktop"], "documents": fs.roots["documents"], "downloads": fs.roots["downloads"]}))

    def say(self, msg: str) -> None:
        (self._say or getattr(self.orch, "say", None) or print)(msg)

    def _fx(self) -> Any:
        if self.effectors is None:
            self.effectors = SystemEffectors(workspace=getattr(getattr(self.orch, "cfg", None), "workspace", None))
        return self.effectors

    def _backend(self) -> Any:
        return self._fx().backend

    async def _confirm(self, question: str) -> bool:
        hitl = getattr(self.orch, "_hitl", None)
        if hitl is None:
            return os.environ.get("DSCU_AUTO_CONFIRM") == "1"
        return bool(await hitl(["  🛑 不可逆操作需要确认（用户已授权该类操作，但本次选择范围较大）："], question + " 输入 y 确认 / n 取消："))

    def begin_task(self) -> None:
        self.goal = None
        self.planner = None
        self.gui_planner = RecoveryPlanner(None, RouteGraph.for_web())
        self.directive = ""
        self._consec_fail.clear()
        self._tried_channels.clear()
        self._budget_reroutes = 0

    def take_directive(self) -> str:
        d, self.directive = self.directive, ""
        return d

    def observe(self, obs: Any) -> None:
        try:
            self.world.submit_observation(obs)
        except Exception:  # noqa: BLE001  perception must never be broken by the world bus
            pass

    # ================================================================================================================== deterministic core
    async def run(self, st: Any) -> Optional[tuple[str, str]]:
        goal = compile_goal(getattr(st, "task", ""))
        if goal is None:
            return None
        self.begin_task()
        self.goal = goal
        self.stats["goals"] += 1
        self.stats["ordinal_goals"] += 1 if goal.selector.by_ordinal else 0
        planner = self.planner = RecoveryPlanner(goal)
        say = self.say
        say("── 第 1 步 ──")
        say(f"  [Core v18.1: GoalSpec] {goal.describe()}")
        say(f"  🎯 完成标准（唯一裁决依据）：{'；'.join(goal.completion_criteria())}")
        say("  🧭 路线图：" + " → ".join(f"{r.route_id}{'(需授权)' if r.needs_auth else ''}" for r in planner.graph.routes.values()))
        frozen: list[WorldObjectRef] = []
        self._good = []   # evidence rows of COMMITTED transactions only: a superseded failed attempt must not poison the final verdict
        all_rows = self._good
        facts: dict[str, Optional[bool]] = {}
        guard = 0
        while guard < 12:
            guard += 1
            dec = planner.next_route(facts)
            if dec.action == "handoff":
                return self._handoff(dec, goal, all_rows)
            route = dec.route
            assert route is not None
            say(f"  ➜ {dec.reason}")
            self.stats["route_runs"] += 1
            if route.llm:
                return self._fallthrough(goal, planner, frozen)
            ex = {"fs_recycle": self._route_fs_recycle, "bin_evidence": self._route_bin_evidence, "bin_purge": self._route_bin_purge,
                  "bin_restore": self._route_bin_restore}.get(route.kind)
            if ex is None:
                planner.record(route.route_id, "UNSUPPORTED", f"no executor for {route.kind}")
                continue
            out: RouteOutcome = await ex(goal, frozen, facts, {})
            if out.status == "done":
                return await self._finish(goal, self._good + out.rows, out.summary)
            if out.status == "clarify":
                say(f"  🛑 NEEDS_CLARIFICATION：{out.detail}")
                return "needs_clarification", out.detail
            if out.status == "failed":
                say(f"  🛑 {out.detail}")
                return "failed", out.detail
            edge = planner.record(route.route_id, out.code, out.detail)
            if edge is not None:
                self.stats["blocked_edges"] += 1
                say(f"  ⛔ BlockedEdge：{edge.render()} → 自动规划下一条合法路线（不交还用户）")
            else:
                say(f"  ↻ {route.route_id} 返回 {out.code}（{out.detail[:80]}）→ 同路线重试 1 次")
        return self._handoff(Decision("handoff", None, "路线循环保护触发"), goal, all_rows)

    # ------------------------------------------------------------------ shared helpers
    def _live_scope(self, goal: GoalSpec) -> list[str]:
        return [l for l in goal.scope if l in LIVE_LOCATIONS]

    def _freeze(self, frozen: list[WorldObjectRef], sel: Selection, goal: GoalSpec) -> None:
        frozen[:] = list(sel.refs)
        self.say(f"  🧊 目标冻结（{len(frozen)} 个 UnifiedObjectRef；先枚举容器有序列表，再按选择器取子集；之后列表怎么变化都不会改变目标身份）：")
        for r in frozen[:12]:
            self.say(f"     · #{r.ordinal + 1} {r.brief()}")
        if len(frozen) > 12:
            self.say(f"     …另有 {len(frozen) - 12} 个")

    def _progress(self, goal: GoalSpec, frozen: list[WorldObjectRef], location: str) -> RemainingWork:
        cur = self.world.refresh(location)
        rw = recompute_remaining_work(goal, [r for r in frozen if r.location == location], cur, self.ledger.committed_ids(goal.goal_id))
        self.say(f"  📊 剩余工作重算（WorldModel epoch={self.world.location_epoch(location)}）：{rw.summary()}")
        return rw

    def _clarify_selection(self, sel: Selection, goal: GoalSpec) -> RouteOutcome:
        names = "；".join(r.brief() for r in sel.refs[:5])
        if sel.status == "ambiguous":
            return RouteOutcome("clarify", "AMBIGUOUS_TARGET", f"{sel.reason}：{names}。请说明要处理哪一个（写出完整文件名或原位置）。")
        if sel.status == "suggest":
            return RouteOutcome("clarify", "NEEDS_CLARIFICATION", f"{sel.reason}；您是想操作：{names} 吗？请用完整文件名重新下达。")
        return RouteOutcome("clarify", "NEEDS_CLARIFICATION", f"{sel.reason}。为避免误删，不自动缩小/放大范围，请确认数量后重新下达。" + (f"（可选对象：{names}）" if names else ""))

    def _policy_args(self, goal: GoalSpec, frozen: list[WorldObjectRef]) -> dict[str, Any]:
        return {"authorized_text": goal.authorized_irreversible, "frozen_ids": {r.identity for r in frozen}, "selection_size": len(frozen), "select_all": goal.selector.select_all}

    def _tx_failed(self, goal: GoalSpec, res: atx.TxResult) -> RouteOutcome:
        if res.status is atx.TxStatus.DECLINED:
            return RouteOutcome("clarify", "USER_DECLINED", "您未确认不可逆操作，已取消，未做任何修改。")
        return RouteOutcome("blocked", res.code, res.message)

    # ------------------------------------------------------------------ route: live locate → recycle_file  (+ controlled purge when the goal is permanent)
    async def _route_fs_recycle(self, goal: GoalSpec, frozen: list[WorldObjectRef], facts: dict, done: dict) -> RouteOutcome:
        say, fx = self.say, self._fx()
        locs = self._live_scope(goal)
        if not frozen:
            if goal.container == "auto" and not goal.selector.by_name:
                return RouteOutcome("clarify", "NEEDS_CLARIFICATION", "任务没有说明位置（桌面/文档/下载/回收站），无法确定“前面几个/最近几个”指哪个容器。请补充位置，如：删除桌面前面两个文件。")
            cands: list[WorldObjectRef] = []
            for loc in locs:
                cands += await asyncio.to_thread(self.world.refresh, loc)
            sel = resolve_selection(goal, cands)
            say(f"  🔭 WorldModel 跨位置检索（{'/'.join(locs)}）→ 候选 {sel.candidates_total} 个 · 选择结果 {sel.status}")
            if sel.status in ("ambiguous", "suggest", "short"):
                return self._clarify_selection(sel, goal)
            if not sel.ok:
                nm = goal.selector.by_name.text if goal.selector.by_name else ""
                if nm:
                    rep = await asyncio.to_thread(self.world.search, nm, ("recyclebin",))
                    facts["bin_found"] = rep.status in ("bin_only", "bin_ambiguous")
                return RouteOutcome("blocked", "NOT_FOUND", f"{'/'.join(locs)} 中没有匹配「{nm or goal.selector.describe()}」的文件" + (f"（回收站检索：{rep.status}）" if nm else ""))
            self._freeze(frozen, sel, goal)
        rows: list[dict[str, Any]] = []
        for ref in list(frozen):
            if ref.location not in LIVE_LOCATIONS:
                continue
            rw = recompute_remaining_work(goal, [ref], await asyncio.to_thread(self.world.refresh, ref.location), self.ledger.committed_ids(goal.goal_id))
            if not rw.remaining:
                continue
            cur = await asyncio.to_thread(self.world.resolve_current, ref) or ref
            p = Path(cur.path)

            def before(p=p) -> dict[str, Any]:
                return {"count": fx.bin_count(), "ids": {i.bin_path or i.name for i in self._backend().list_items()}}

            def post(ctx: Any, p=p, cur=cur) -> list[dict[str, Any]]:
                out = [atx.row("file_not_exists", not fx.path_exists(p), f"{p} {'已不存在' if not fx.path_exists(p) else '仍存在'}", source="filesystem")]
                c0 = (ctx or {}).get("count")
                if c0 is not None:
                    aft = fx.wait_bin_count(c0 + 1, 6.0)
                    out.append(atx.row("bin_count_plus_one", aft == c0 + 1, f"回收站 {c0}→{aft}", source="SHQueryRecycleBinW+NameSpace(10)"))
                its = self._backend().list_items()
                hit = [i for i in its if rb._score(cur.name, i.name) >= 0.99 and (not i.original or rb.norm(i.original) == rb.norm(str(p)))]
                out.append(atx.row("bin_item_present", bool(hit), f"NameSpace(10) {'已列出' if hit else '未列出'}「{cur.name}」（共 {len(its)} 项）", source="Shell.Application.NameSpace(10)"))
                return out

            tx = atx.ActionTransaction(goal.goal_id, "recycle_file", cur, lambda p=p: fx.recycle_file(p), atx.Reversibility.REVERSIBLE,
                                       [atx.Precondition("target_identity", lambda cur=cur: self.world.check_ref(cur))],
                                       atx.ExpectedWorldDelta(cur.location, lambda loc=cur.location: self.world.identity_set(loc), frozenset({cur.identity})), before, post)
            say(f"  动作: action=recycle_file path={p}（事务 {tx.key[:10]} · 前置=身份/epoch · 后置=文件消失+回收站+1+身份集合精确变化）")
            res = await self.engine.run(tx, **self._policy_args(goal, frozen))
            say(f"  结果: {'✅' if res.ok else '❌'} [{res.code}] {res.message[:160]}")
            rows += res.rows
            if not res.ok:
                if res.status is atx.TxStatus.PRECONDITION_FAILED and res.code == "NOT_FOUND":
                    continue  # vanished between freeze and act → recompute treats it as externally satisfied
                return RouteOutcome("blocked", res.code, res.message, rows)
            self._good += res.rows
            self.world.note_mutation()
            if goal.permanent:  # controlled single-file purge: find EXACTLY the item this transaction created
                po = await self._purge_created(goal, frozen, cur, p)
                rows += po.rows
                if po.status != "done":
                    return RouteOutcome(po.status, po.code, po.detail, rows)

        rws = [recompute_remaining_work(goal, [r], await asyncio.to_thread(self.world.refresh, r.location), self.ledger.committed_ids(goal.goal_id)) for r in frozen if r.location in LIVE_LOCATIONS]
        left = [x for rw in rws for x in rw.remaining]
        say(f"  📊 剩余工作重算：冻结 {len(frozen)} · 剩余 {len(left)}")
        if left:
            return RouteOutcome("blocked", "ACTION_NO_EFFECT", f"仍有 {len(left)} 个目标未消失：{'，'.join(r.name for r in left[:4])}", rows)
        names = "、".join(r.name for r in frozen[:6])
        what = f"已将 {len(frozen)} 个文件（{names}）{'彻底删除（经回收站→受控单对象清理）' if goal.permanent else '移入回收站'}并独立核验"
        return RouteOutcome("done", "OK", "", [], what)

    async def _purge_created(self, goal: GoalSpec, frozen: list[WorldObjectRef], live: WorldObjectRef, p: Path) -> RouteOutcome:
        """After recycle_file for a *permanent* goal: locate the one bin item whose original path == p, purge it as an irreversible transaction."""
        bin_refs = await asyncio.to_thread(self.world.refresh, "recyclebin")
        hit = [b for b in bin_refs if rb.norm(b.path) == rb.norm(str(p)) and rb._score(live.name, b.name) >= 0.99]
        hit.sort(key=lambda b: -(b.time_ts or 0.0))
        if not hit:
            return RouteOutcome("blocked", "NOT_FOUND", "回收站里没有找到刚移入的对象（原路径不匹配）")
        newest = [h for h in hit if h.deleted_text == hit[0].deleted_text]
        if len(newest) != 1:
            return RouteOutcome("blocked", "AMBIGUOUS_TARGET", "回收站里有多个原路径相同且删除时间相同的对象，无法唯一确定要清理哪一个")
        return await self._purge_one(goal, newest[0], {r.identity for r in frozen} | {newest[0].identity}, len(frozen))

    async def _purge_one(self, goal: GoalSpec, ref: WorldObjectRef, frozen_ids: set[str], n: int) -> RouteOutcome:
        be = self._backend()
        cur = await asyncio.to_thread(self.world.resolve_current, ref) or ref
        item = cur.extra.get("item")
        if item is None:
            return RouteOutcome("blocked", "UNSUPPORTED", "该对象没有可用的回收站后备存储信息")
        tx = atx.ActionTransaction(goal.goal_id, "bin_purge", cur, lambda: be.delete_store(item), atx.Reversibility.IRREVERSIBLE,
                                   [atx.Precondition("target_identity", lambda: self.world.check_ref(cur))],
                                   atx.ExpectedWorldDelta("recyclebin", lambda: self.world.identity_set("recyclebin"), frozenset({cur.identity})),
                                   lambda: be.count_api(), lambda ctx: rb.verify_item_gone(item, be, ctx, 6.0))
        self.say(f"  动作: action=recycle_bin_remove_item name={cur.name}（不可逆·事务 {tx.key[:10]} · 目标身份 {cur.identity[:48]}）")
        res = await self.engine.run(tx, authorized_text=goal.authorized_irreversible, frozen_ids=frozen_ids, selection_size=n, select_all=goal.selector.select_all)
        self.say(f"  结果: {'✅' if res.ok else '❌'} [{res.code}] {res.message[:160]}")
        if not res.ok:
            out = self._tx_failed(goal, res)
            out.rows = res.rows
            return out
        self._good += res.rows
        self.world.note_mutation()
        return RouteOutcome("done", "OK", "", [])

    # ------------------------------------------------------------------ route: Recycle Bin COM → already-deleted evidence
    async def _route_bin_evidence(self, goal: GoalSpec, frozen: list[WorldObjectRef], facts: dict, done: dict) -> RouteOutcome:
        say = self.say
        nm = goal.selector.by_name.text if goal.selector.by_name else ""
        if not nm:
            return RouteOutcome("blocked", "NOT_FOUND", "没有名称选择器，无法在回收站按名称取证")
        rep = await asyncio.to_thread(self.world.search, nm, ("desktop", "documents", "downloads", "recyclebin"))
        say(f"  🔭 {rep.describe()}")
        if rep.status in ("live_unique", "live_ambiguous"):   # the file appeared on a live location meanwhile → go back to the reversible primitive
            facts["live_found"] = True
            return RouteOutcome("blocked", "ROUTE_NOT_APPLICABLE", "检索时发现活动副本（不属于“已删除”证据路线），应使用 recycle_file 路线")
        if rep.status not in ("bin_only", "bin_ambiguous"):
            facts["bin_found"] = False
            return RouteOutcome("blocked", "NOT_FOUND", f"桌面/文档/下载/回收站 均没有「{nm}」（检索 {rep.status}）")
        bin_now = await asyncio.to_thread(self.world.refresh, "recyclebin")
        rows: list[dict[str, Any]] = []
        for loc in LIVE_LOCATIONS:
            live = [o for o in await asyncio.to_thread(self.world.refresh, loc) if rb._score(nm, o.name) >= rb.STRICT]
            rows.append(atx.row(f"live_copy_absent[{loc}]", not live, f"{loc} 中{'没有' if not live else '仍有'}「{nm}」的活动副本", source="filesystem"))
        ids = {b.identity for b in bin_now}
        for h in rep.refs():
            rows.append(atx.row("bin_item_present", h.identity in ids, f"NameSpace(10) 列出 {h.brief()}", source="Shell.Application.NameSpace(10)"))
            if h.path:
                ex = self._fx().path_exists(Path(h.path))
                rows.append(atx.row("original_path_vacated", not ex, f"原位置 {h.path} {'已不存在' if not ex else '仍存在'}", source="filesystem"))
        bad = [r for r in rows if not r["ok"]]
        if bad:
            return RouteOutcome("blocked", "ACTION_NO_EFFECT", "取证未通过：" + "；".join(f"{r['name']}" for r in bad), rows)
        first = rep.refs()[0]
        say(f"  ✓ 目标已处于“已删除”状态：{first.brief()}；授权作用域内没有任何活动副本。")
        say("  ℹ 未做永久删除：任务原文没有“彻底/永久/回收站里删除”的授权（如需彻底删除请说：彻底删除回收站里的" + nm + "）。")
        extra = f"（回收站共 {len(rep.refs())} 个同名项）" if len(rep.refs()) > 1 else ""
        return RouteOutcome("done", "OK", "", rows, f"「{first.name}」已处于已删除状态：位于回收站（原位置 {first.path or '未知'}，删除于 {first.deleted_text or '?'}），桌面/文档/下载无活动副本{extra}；未执行永久删除（任务未授权）")

    # ------------------------------------------------------------------ route: Recycle Bin COM → controlled purge / restore of the frozen set
    async def _bin_select(self, goal: GoalSpec, frozen: list[WorldObjectRef], what: str) -> Optional[RouteOutcome]:
        if frozen:
            return None
        items = await asyncio.to_thread(self.world.refresh, "recyclebin")
        self.say(f"  回收站现有 {len(items)} 项（通道 {getattr(self._backend(), 'channel', '?')}）：" + "，".join(f"#{i.ordinal + 1} {i.name}" for i in items[:10]))
        if not items:
            cnt = await asyncio.to_thread(self._fx().bin_count)
            if cnt:  # COM listing failed while the independent counter says non-empty → a different route may still work
                return RouteOutcome("blocked", "INTERNAL", f"COM 枚举为空但 SHQueryRecycleBinW={cnt}：枚举通道异常")
            return RouteOutcome("failed", "NOT_FOUND", "回收站为空，没有可操作的项目")
        sel = resolve_selection(goal, items)
        if sel.status == "empty":
            return RouteOutcome("failed", "NOT_FOUND", f"回收站里没有匹配项：{sel.reason}（现有：{', '.join(i.name for i in items[:8])}）。")
        if sel.status in ("ambiguous", "suggest", "short"):
            return self._clarify_selection(sel, goal)
        self._freeze(frozen, sel, goal)
        return None

    async def _route_bin_purge(self, goal: GoalSpec, frozen: list[WorldObjectRef], facts: dict, done: dict) -> RouteOutcome:
        pre = await self._bin_select(goal, frozen, "purge")
        if pre is not None:
            return pre
        rows: list[dict[str, Any]] = []
        ids = {r.identity for r in frozen}
        for ref in list(frozen):
            rw = recompute_remaining_work(goal, [ref], await asyncio.to_thread(self.world.refresh, "recyclebin"), self.ledger.committed_ids(goal.goal_id))
            if not rw.remaining:
                continue
            out = await self._purge_one(goal, ref, ids, len(frozen))
            rows += out.rows
            if out.status != "done":
                return RouteOutcome(out.status, out.code, out.detail, rows)
            await asyncio.to_thread(self._progress, goal, frozen, "recyclebin")
        rw = await asyncio.to_thread(self._progress, goal, frozen, "recyclebin")
        if rw.remaining:
            return RouteOutcome("blocked", "ACTION_NO_EFFECT", f"仍有 {len(rw.remaining)} 个目标留在回收站", rows)
        names = "、".join(r.name for r in frozen[:6])
        return RouteOutcome("done", "OK", "", [], f"已从回收站永久删除 {len(frozen)} 个对象（{names}）并独立核验（身份集合精确变化、后备存储消失、计数-{len(frozen)}）")

    async def _route_bin_restore(self, goal: GoalSpec, frozen: list[WorldObjectRef], facts: dict, done: dict) -> RouteOutcome:
        pre = await self._bin_select(goal, frozen, "restore")
        if pre is not None:
            return pre
        be, fx = self._backend(), self._fx()
        rows: list[dict[str, Any]] = []
        for ref in list(frozen):
            rw = recompute_remaining_work(goal, [ref], await asyncio.to_thread(self.world.refresh, "recyclebin"), self.ledger.committed_ids(goal.goal_id))
            if not rw.remaining:
                continue
            cur = await asyncio.to_thread(self.world.resolve_current, ref) or ref
            item = cur.extra.get("item")
            if item is None:
                return RouteOutcome("blocked", "UNSUPPORTED", "该对象没有可用的回收站项信息")

            def post(ctx: Any, item=item, cur=cur) -> list[dict[str, Any]]:
                out = rb.verify_item_gone(item, be, None)
                if cur.path:
                    ex = fx.path_exists(Path(cur.path))
                    out.append(atx.row("restored_to_original", ex, f"{cur.path} {'已存在' if ex else '不存在'}", source="filesystem"))
                return out

            tx = atx.ActionTransaction(goal.goal_id, "bin_restore", cur, lambda item=item: be.restore(item), atx.Reversibility.REVERSIBLE,
                                       [atx.Precondition("target_identity", lambda cur=cur: self.world.check_ref(cur))],
                                       atx.ExpectedWorldDelta("recyclebin", lambda: self.world.identity_set("recyclebin"), frozenset({cur.identity})), None, post)
            self.say(f"  动作: action=recycle_bin_restore_item name={cur.name}（事务 {tx.key[:10]}）")
            res = await self.engine.run(tx, **self._policy_args(goal, frozen))
            self.say(f"  结果: {'✅' if res.ok else '❌'} [{res.code}] {res.message[:160]}")
            rows += res.rows
            if not res.ok:
                return RouteOutcome("blocked", res.code, res.message, rows)
            self._good += res.rows
            self.world.note_mutation()
            await asyncio.to_thread(self._progress, goal, frozen, "recyclebin")
        rw = await asyncio.to_thread(self._progress, goal, frozen, "recyclebin")
        if rw.remaining:
            return RouteOutcome("blocked", "ACTION_NO_EFFECT", f"仍有 {len(rw.remaining)} 个目标留在回收站", rows)
        return RouteOutcome("done", "OK", "", [], f"已还原 {len(frozen)} 个对象（{'、'.join(r.name for r in frozen[:6])}）并独立核验")

    # ------------------------------------------------------------------ finishing / handing off
    async def _finish(self, goal: GoalSpec, rows: list[dict[str, Any]], what: str) -> tuple[str, str]:
        say = self.say
        steps = 1
        if goal.open_bin_after and self.open_view is not None:
            steps += 1
            say(f"── 第 {steps} 步 ──")
            try:
                _ok, wrows = await self.open_view("recyclebin")
                rows = rows + list(wrows)
            except Exception as e:  # noqa: BLE001
                rows = rows + [atx.row("shell_window_open", False, f"{e.__class__.__name__}: {str(e)[:80]}")]
        cov = _coverage(rows)
        say(f"  🔎 独立 Oracle：{_fmt(rows)}")
        c = getattr(self.orch, "counters", None)
        if cov == "full":
            if c is not None:
                c["verifier_pass"] += 1
            summary = f"{what}（coverage=full，{len(rows)} 项独立证据全部通过；Core v18.1 共 {steps} 步，0 次 LLM 调用，0 次无故交还用户；{self.planner.summary() if self.planner else ''}）"
            say(f"✔ 完成（completed_verified · coverage=full · GoalEngine 裁决 + 独立 Oracle）: {summary}")
            return "completed_verified", summary
        bad = [r for r in rows if r.get("evaluated", True) and not r["ok"]]
        if c is not None:
            c["verifier_rejects"] += 1
        say(f"⚠ 未能完全验证（coverage={cov}）：{'; '.join(r['name'] + ':' + str(r['detail'])[:60] for r in bad) or '部分证据未评估'}")
        return ("partially_completed" if cov == "partial" else "failed"), f"{what}（coverage={cov}）：{_fmt(bad) if bad else '部分证据未评估'}"

    def _handoff(self, dec: Decision, goal: GoalSpec, rows: list[dict[str, Any]]) -> tuple[str, str]:
        self.stats["handoffs"] += 1
        msg = dec.human_message or dec.reason
        self.say(f"  🛑 {'真实阻塞' if dec.real_blocker else '所有合法替代路线已穷尽'} → 交还用户（附完整 BlockedEdge 清单）：\n{msg}")
        return ("needs_clarification" if dec.real_blocker else "paused_for_user"), msg

    def _fallthrough(self, goal: GoalSpec, planner: RecoveryPlanner, frozen: list[WorldObjectRef]) -> None:
        self.stats["llm_fallthrough"] += 1
        parts = [planner.directive_text()]
        if frozen:
            parts.append("目标冻结集合（只允许操作这些身份，不得更换目标）：" + "；".join(r.brief() for r in frozen[:8]))
        parts.append(f"GoalSpec：{goal.describe()}")
        if goal.irreversible and not goal.authorized_irreversible:
            parts.append("安全约束：任务未授权不可逆操作，禁止永久删除；只允许可恢复的动作。")
        self.directive = "\n".join(p for p in parts if p)
        self.say("  ↪ 确定性路线已全部处理完毕 → 以【冻结目标 + 已关闭路线 + 下一合法路线】约束交给模型循环（最后一条受控 GUI 路线）")
        return None

    # ================================================================================================================== model-loop hooks (alternative-route recovery during the LLM loop)
    def on_step_result(self, action: dict[str, Any], ok: bool, code: str, message: str) -> None:
        name = str(action.get("action", ""))
        ch = channel_of(action)
        if ch not in self._tried_channels:
            self._tried_channels.append(ch)
        if ok:
            self._consec_fail[ch] = 0
            return
        if code == "SECURITY_DENIED" or code == "NOT_FOUND" or code == "ACTION_NO_EFFECT" or code in ("OCCLUDED", "UIPI_DENIED"):
            if self.planner is not None:   # goal-driven task: the *primitive* is closed (SECURITY_DENIED ⇒ never offered again), route stays open
                e = self.planner.block_if_new(f"tool:{name}", code, message[:120])
                if e is not None:
                    self.stats["blocked_edges"] += 1
                    self.directive = self.planner.directive_text()
            self._consec_fail[ch] = self._consec_fail.get(ch, 0) + 1
            if self._consec_fail[ch] >= 2 and self.planner is None:
                e = self.gui_planner.block_if_new(ch, code, message[:120])
                if e is not None:
                    self.stats["blocked_edges"] += 1
                    self.directive = self.gui_planner.directive_text()

    def on_budget_trip(self, trip: Any) -> Optional[str]:
        """no_progress trip → alternative route instead of handing the task back (bounded: ≤ 3 reroutes per task, and only while a legal untried route remains)."""
        if getattr(trip, "kind", "") != "no_progress" or self._budget_reroutes >= 3:
            return None
        pl = self.planner or self.gui_planner
        cur = self._tried_channels[-1] if self._tried_channels else ""
        if self.planner is None and cur:
            pl.block_if_new(cur, "ACTION_NO_EFFECT", "连续无进展")
        untried = [r for r in pl.remaining_routes() if r.route_id not in self._tried_channels or r.llm]
        if self.planner is not None:
            nxt = [r for r in pl.remaining_routes() if r.llm]
        else:
            nxt = [r for r in untried if r.route_id != cur]
        if not nxt:
            return None
        self._budget_reroutes += 1
        self.stats["budget_reroutes"] += 1
        self.stats["reroutes"] += 1
        d = pl.directive_text() or f"【自动换路】请改用路线 {nxt[0].route_id}（{nxt[0].label}）。"
        return d + f"\n（无进展熔断已转为第 {self._budget_reroutes}/3 次自动换路：下一条路线 {nxt[0].route_id}）"

    def summary_line(self) -> str:
        s = self.stats
        wm = self.world
        pl = self.planner.summary() if self.planner else self.gui_planner.summary()
        return (f"  v18.1：GoalSpec {s['goals']}（序数选择器 {s['ordinal_goals']}）· 路线执行 {s['route_runs']} · BlockedEdge {s['blocked_edges']} · 换路 {s['reroutes']}（熔断转换路 {s['budget_reroutes']}）"
                f" · 无故交还 {s['handoffs']} · 事务 提交 {self.engine.stats['committed']}/重放 {self.engine.stats['replayed']}/拒绝 {self.engine.stats['denied']}/无效果 {self.engine.stats['no_effect']}"
                f" · WorldModel 提交 {wm.stats['submits']} 次/重定基 {wm.stats['rebases']}/世界版本 {wm.world_version} · {pl}")
