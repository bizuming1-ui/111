        & $rec '虚拟鼠标平滑度' ($fps -ge 50 -and $gap -lt 80) ("平均 {0:N0} fps，最大帧间隔 {1:N1} ms（共 {2} 帧 / {3:N2} 秒）" -f $fps, $gap, $script:Cur.Frames, $sec)
        $endOk = ([Math]::Abs($script:Cur.X - [int]($w / 2)) -lt 0.5) -and ([Math]::Abs($script:Cur.Y - [int]($h / 2)) -lt 0.5)
        & $rec '虚拟鼠标终点精确（亚像素误差 < 0.5px）' $endOk ("终点 ({0:N2},{1:N2})" -f $script:Cur.X, $script:Cur.Y)
        $real1 = [DsNative61]::CursorPos()
        & $rec '真实鼠标未被占用' (($real0[0] -eq $real1[0]) -and ($real0[1] -eq $real1[1])) ("前 ($($real0[0]),$($real0[1])) 后 ($($real1[0]),$($real1[1]))")
    }
    else { & $rec '虚拟鼠标覆盖层启动' $false '未启动（-NoOverlay 或创建失败）' }
    $tt = [DsTestTarget61]::new()
    $savedMode = $script:Mode
    $cid = 0; $eid = 0
    try {
        if (-not $tt.Start([int]($w / 2 - 160), [int]($h / 2 - 75))) { & $rec '创建自检目标窗口' $false '失败'; return $rows }
        Start-Sleep -Milliseconds 500
        $script:ObsHwnd = $tt.Parent
        $items = @(Get-UiElements $tt.Parent | Sort-Object cy, cx)
        Set-Elements $items
        foreach ($kv in $script:Elements.GetEnumerator()) {
            if ($kv.Value.Type -eq 'CheckBox') { $cid = [int]$kv.Key }
            if ($kv.Value.Type -eq 'Edit') { $eid = [int]$kv.Key }
        }
        & $rec 'UIA 观察到自检控件' (($cid -gt 0) -and ($eid -gt 0)) ("复选框 id=$cid（模式 $(if ($cid) { $script:Elements[$cid].Pat -join ',' })），编辑框 id=$eid")
        if ($cid -gt 0 -and $eid -gt 0) {
            # 0. 状态读回（CacheRequest）
            $tt.SetCheck(1); Start-Sleep -Milliseconds 120
            $o1 = @(Get-UiElements $tt.Parent | Where-Object { $_.Type -eq 'CheckBox' } | Select-Object -First 1)
            $tt.SetCheck(0); Start-Sleep -Milliseconds 120
            $o0 = @(Get-UiElements $tt.Parent | Where-Object { $_.Type -eq 'CheckBox' } | Select-Object -First 1)
            & $rec '观察：复选框状态由缓存一次读回（on / off）' ($o1.Count -gt 0 -and $o0.Count -gt 0 -and $o1[0].State -eq 'on' -and $o0[0].State -eq 'off') "勾选后=[$($o1[0].State)] 取消后=[$($o0[0].State)]"
            # A. UIA
            $script:Mode = 'Uia'
            $tt.SetCheck(0)
            $r0 = [DsNative61]::CursorPos()
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click'; id = $cid }) } catch { $msg = "异常: $($_.Exception.Message)" }
            $r1 = [DsNative61]::CursorPos()
            & $rec '第1层 UIA 点击（勾选复选框）并读回状态' ($tt.GetCheck() -eq 1 -and $r0[0] -eq $r1[0] -and $r0[1] -eq $r1[1] -and $msg -match '读回 on') $msg
            # A2. click_many
            $tt.SetCheck(0)
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click_many'; ids = @($cid) }) } catch { $msg = "异常: $($_.Exception.Message)" }
            & $rec 'click_many 批量点击' ($tt.GetCheck() -eq 1 -and $msg -match '已依次点击 1') $msg
            # A3. 坐标吸附
            $tt.SetCheck(0)
            $cx0 = $script:Elements[$cid].cx; $cy0 = $script:Elements[$cid].cy
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click'; x = $cx0; y = $cy0 }) } catch { $msg = "异常: $($_.Exception.Message)" }
            & $rec '坐标点击自动吸附到控件并走 UIA（Uia 模式下也成功）' ($tt.GetCheck() -eq 1 -and $msg -match 'UIA') $msg
            # A4. v4.2 幂等勾选：已勾选时 check 不动作；uncheck 读回 off
            $tt.SetCheck(1); Start-Sleep -Milliseconds 120
            $ck1 = $null; $ck2 = $null; $ckErr = ''
