const OCCLUSION_FN = `function(x,y){
  let e=document.elementFromPoint(x,y);
  for(let i=0;i<8&&e&&e.shadowRoot;i++){const n=e.shadowRoot.elementFromPoint(x,y); if(!n||n===e)break; e=n;}
