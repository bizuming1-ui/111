import test from 'node:test'
import assert from 'node:assert/strict'
import { EpochLock, ActionLedger } from '../src/epoch.ts'
import { result } from '../src/protocol.ts'
import { handle, type Page } from '../src/daemon.ts'

test('ids minted before a bump are STALE_EPOCH without touching the page', async () => {
  const lock = new EpochLock(); lock.bind([122, 123])
  let touched = 0
  assert.equal((await lock.guard(1, 122, 0, async () => { touched++ })).code, 'OK')
  lock.bump('rows_deleted')
  const r = await lock.guard(2, 122, undefined, async () => { touched++ })
  assert.equal(r.code, 'STALE_EPOCH'); assert.equal(touched, 1)
  lock.bind([122]); assert.equal((await lock.guard(3, 122, lock.current, async () => { touched++ })).code, 'OK')
})

test('raw "No node with given id found" never leaks: converted to STALE_EPOCH and bumps the epoch', async () => {
  const lock = new EpochLock(); lock.bind([7]); const before = lock.current
  const r = await lock.guard(9, 7, undefined, async () => { throw new Error('CDP DOM.resolveNode 错误: No node with given id found') })
  assert.equal(r.code, 'STALE_EPOCH'); assert.equal(lock.current, before + 1)
})

test('unbound refs are STALE_REF; idempotent replay returns IDEMPOTENT_REPLAY', () => {
  const lock = new EpochLock(); assert.equal(lock.check(5), 'STALE_REF')
  const l = new ActionLedger(); l.commit(result(4, true, 'OK', 'clicked', 0))
  assert.equal(l.seen(4)?.code, 'IDEMPOTENT_REPLAY'); assert.equal(l.seen(5), null)
})

test('daemon act: stale expect_epoch rejected, navigate bumps epoch, replay is idempotent', async () => {
  const sent: string[] = []
  const page: Page = { evaluate: async () => JSON.stringify({ rows: [], btns: [], vh: 1000, vw: 1500 }) as any, send: async (m: string) => { sent.push(m); return {} } }
  const a = await handle(page, { cmd: 'act', v: 1, action_id: 101, action: 'cdp_navigate', args: { url: 'https://mail.google.com' } }) as any
  assert.equal(a.ok, true); assert.equal(a.epoch, 1)
  const stale = await handle(page, { cmd: 'act', v: 1, action_id: 102, action: 'click', args: { x: 1, y: 1 }, expect_epoch: 0 }) as any
  assert.equal(stale.code, 'STALE_EPOCH')
  const again = await handle(page, { cmd: 'act', v: 1, action_id: 101, action: 'cdp_navigate', args: { url: 'https://x' } }) as any
  assert.equal(again.code, 'IDEMPOTENT_REPLAY'); assert.equal(sent.filter(m => m === 'Page.navigate').length, 1)
})
