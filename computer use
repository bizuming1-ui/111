        brain, out = self.mk("blocked", lambda m, n: {"thought": "切到微信", "step": 1, "expect": "前台变微信", "action": "focus_window", "title": "微信"})

        async def go():
            await brain.start()
            return await brain.run_task("打开微信，找到联系人老虎不抓鼠，给他发消息：晚上七点开会", max_steps=40)  # v16.4: a body is mandatory (otherwise needs_clarification)

        status = run(go())
        self.assertEqual(status, "paused_for_user", "\n".join(out[-25:]))  # v16.2 canonical terminal status
        self.assertLessEqual(brain.llm.calls, 14, f"too many LLM calls: {brain.llm.calls}")
        text = "\n".join(out)
        self.assertIn("循环检测", text)
        self.assertIn("MASKED", text)

