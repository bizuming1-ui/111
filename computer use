$gz = [IO.MemoryStream]::new([Convert]::FromBase64String(($b64 -replace '\s', '')))
$z = [IO.Compression.GZipStream]::new($gz, [IO.Compression.CompressionMode]::Decompress)
$o = [IO.MemoryStream]::new(); $z.CopyTo($o); $bytes = $o.ToArray()
$sha = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($bytes)).Replace('-', '')
if ($sha -ne '268544644998812C2DA336261865E749C7ECF3D4F11FCA9D8183ED58B2E0EFF2') { throw 'Checksum mismatch: the paste was damaged. Copy the block again.' }
$dir = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'cu'
New-Item -ItemType Directory -Force -Path $dir | Out-Null
$file = Join-Path $dir 'cu.ps1'
[IO.File]::WriteAllBytes($file, [byte[]]((0xEF, 0xBB, 0xBF) + $bytes))
try { Unblock-File -Path $file } catch { }
Write-Host ('Saved ' + $file + '  (sha256 verified)') -ForegroundColor Green
$pw = (Get-Command pwsh -ErrorAction SilentlyContinue).Source
if (-not $pw -and $IsWindows) { $c = Join-Path $env:ProgramFiles 'PowerShell\7\pwsh.exe'; if (Test-Path $c) { $pw = $c } }
if (-not $pw) {
  Write-Host 'PowerShell 7 is required. Install it with:  winget install --id Microsoft.PowerShell -e' -ForegroundColor Yellow
  Write-Host ('Then run:  pwsh -ExecutionPolicy Bypass -File ' + $file) -ForegroundColor Yellow
} else {
  & $pw -NoLogo -ExecutionPolicy Bypass -File $file
}
