$script:DscuFiles['packages/cdp-daemon/src/protocol.ts'] = @'
// Wire protocol v1 (schemas/protocol_v1.json is the single source of truth).
export type ErrorCode =
  | "STALE_EPOCH" | "STALE_HWND" | "AMBIGUOUS_TARGET" | "OCCLUDED" | "UIPI_DENIED" | "SECURITY_DENIED"
  | "NOT_FOUND" | "TIMEOUT" | "UNSUPPORTED" | "INVALID_REQUEST" | "INTERNAL";

export class PErr extends Error {
  constructor(public code: ErrorCode, message: string, public data?: unknown) {
    super(message);
  }
  retryable(): boolean {
    return ["STALE_EPOCH", "OCCLUDED", "TIMEOUT", "STALE_HWND"].includes(this.code);
  }
  toJSON() {
    return { code: this.code, message: this.message, retryable: this.retryable(), data: this.data ?? null };
  }
}

export type Zone = "Toolbar" | "Row" | "Modal" | "Content";

export interface Rect { x: number; y: number; w: number; h: number }

export interface Element {
  ref_id: string;
  stable_key: string;
  role: string;
  name: string;
  value?: string;
  zone: Zone;
  rect: Rect;
  enabled: boolean;
  focused: boolean;
  checked?: boolean;
  occluded: boolean;
  patterns: string[];
  depth: number;
  row_index?: number;
}

export interface RequestFrame { v: 1; id: number | string; kind: string; req?: any }

export const ok = (id: unknown, result: unknown) => ({ v: 1, id, ok: true, result });
export const fail = (id: unknown, e: PErr) => ({ v: 1, id, ok: false, error: e.toJSON() });

/** 48-bit stable hash (two independent 32-bit FNV-1a lanes; no BigInt so it also type-checks under old targets). */
export function fnv(s: string): string {
  let a = 0x811c9dc5, b = 0x01000193 ^ 0x9e3779b9;
  for (const ch of Buffer.from(s, "utf8")) {
    a = Math.imul(a ^ ch, 0x01000193) >>> 0;
    b = Math.imul(b ^ (ch + 31), 0x85ebca6b) >>> 0;
  }
  return ((a >>> 0).toString(16).padStart(8, "0") + (b >>> 0).toString(16).padStart(8, "0")).slice(0, 12);
}

export const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

export function norm(s: string | undefined, n: number): string {
  return (s ?? "").replace(/\s+/g, " ").trim().slice(0, n);
}
