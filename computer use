            v = cn_to_int(m.group(1))
            if 0 < v <= 500:
                found[idx] = v
    batches = [found[k] for k in sorted(found)]
    return batches, sum(batches)


@dataclass
class Pending:
    count: int
    texts: list[str]
    before: list[int]


@dataclass
class Quota:
    original: list[int]
    remaining: list[int]
    total: int
    done: int = 0
    pending: Pending | None = None
    log: list[str] = field(default_factory=list)

    @classmethod
    def from_task(cls, text: str) -> "Quota | None":
        b, t = get_task_quantities(text)
        return cls(list(b), list(b), t) if b else None

    def allowed(self) -> list[int]:
        s, acc = set(), 0
        for v in self.remaining:
            s.add(v); acc += v; s.add(acc)
        return sorted(s)

    def register(self, count: int, texts: list[str]) -> None:
        """Optimistic debit of the sub-batch that `count` ticked rows corresponds to."""
        before = list(self.remaining)
        if count in self.remaining:
            self.remaining.remove(count)
        else:
            acc = 0
            for j, v in enumerate(self.remaining):
                acc += v
                if acc == count:
                    del self.remaining[: j + 1]; break
            else:
                if count >= acc:
                    self.remaining.clear()
        self.pending = Pending(count, list(texts), before)
        self.log.append(f"register {count} -> {self.remaining}")

    def resolve(self, current_row_texts: list[str]) -> str:
        """v10: commit only rows that really vanished from the page (v9.2 committed the whole batch whenever
        the selection fingerprint changed -> 'deleted 13' after one stray row-hover click)."""
        if self.pending is None:
            return "none"
        p, self.pending = self.pending, None
        present = set(current_row_texts)
        removed = sum(1 for t in p.texts if t and t not in present)
        if removed <= 0:
            self.remaining = list(p.before); self.log.append("rollback"); return "rollback"
        if removed >= p.count:
            self.done += p.count; self.log.append(f"commit {p.count}"); return "commit"
        left = p.count - removed
        self.done += removed
        self.remaining = self._partial(p, left)
        self.log.append(f"partial {removed}/{p.count}")
        return "partial"

    def _partial(self, p: Pending, left: int) -> list[int]:
        rem = list(p.before)
        if p.count in rem:
            rem[rem.index(p.count)] = left
        else:
            rem.insert(0, left)
        return rem

    def fmt(self) -> str:
        r = "+".join(map(str, self.remaining)) or "无"
        return f"配额队列 [{'+'.join(map(str, self.original))}]（总目标 {self.total}），已确认删除 {self.done}，剩余 [{r}]"


def interlock_decision(*, total: int, name: str, is_master: bool, row_count: int, on_count: int,
                       zone: str, allowed: list[int], toolbar_twin: bool = False) -> str | None:
    """Pure decision.  zone in {'Toolbar','Row','Unknown'}.  Only [Zone: Row] bulk actions are blocked outright;
    [Zone: Toolbar] is validated against the *remaining* sub-batch quota, never against the consumed Total."""
    if total <= 0 or row_count <= 0:
        return None
    if is_master and row_count > total:
        return f"安全联锁：任务只要求 {total} 个，禁止点击「全选」复选框（共 {row_count} 行）"
    if SELECT_ALL.match(name) and row_count > total:
        return f"安全联锁：禁止使用「{name}」（会选中全部 {row_count} 行）"
    if DESTRUCTIVE.search(name):
        if zone == "Row" and on_count != 1:
            hint = "；本页存在同名 [Zone: Toolbar] 批量按钮，系统将自动改点它" if toolbar_twin else ""
            return f"安全联锁 [Zone: Row]：「{name}」是行内悬浮按钮，只会处理那一行（当前勾选 {on_count} 个）{hint}"
        if zone != "Row":
            ok = [v for v in allowed if v > 0] or [total]
            if on_count not in ok:
                return f"安全联锁 [Zone: Toolbar]：允许的勾选数为剩余子批次 {ok}，当前勾选 {on_count} 个"
    return None
