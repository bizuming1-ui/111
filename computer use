//! WinPlatform: glues DXGI / UIA / JAB / notifications / sidecar supervision to the portable `Platform` trait.
use crate::{dxgi::Dxgi, jab, job::Job, notify, sys, uia};
use dscu_core::platform::*;
use dscu_core::tree::{RawNode, WindowInfo};
use dscu_core::uia_ref::RefEntry;
use std::path::PathBuf;
use std::process::{Child, Command};
use std::sync::Mutex;

#[derive(Clone, Default)]
pub struct WinConfig {
    pub no_dxgi: bool,
    pub no_jab: bool,
    pub sidecar_script: Option<PathBuf>,
    pub python: Option<String>,
}

struct Sidecar {
    child: Child,
    _job: Job,
    endpoint: String,
}

pub struct WinPlatform {
    cfg: WinConfig,
    dxgi: Mutex<Option<Dxgi>>,
    dxgi_err: Mutex<String>,
    sidecar: Mutex<Option<Sidecar>>,
}

impl WinPlatform {
    pub fn new(cfg: WinConfig) -> WinPlatform {
        let p = WinPlatform { cfg, dxgi: Mutex::new(None), dxgi_err: Mutex::new(String::new()), sidecar: Mutex::new(None) };
        p.ensure_dxgi();
        p
    }

    fn ensure_dxgi(&self) {
        if self.cfg.no_dxgi {
            return;
        }
        let mut g = self.dxgi.lock().unwrap();
        if g.is_none() {
            match Dxgi::new() {
                Ok(d) => *g = Some(d),
                Err(e) => *self.dxgi_err.lock().unwrap() = e,
            }
        }
    }
}

impl Platform for WinPlatform {
    fn info(&self) -> PlatformInfo {
        let g = self.dxgi.lock().unwrap();
        PlatformInfo {
            name: "windows".into(),
            os: "windows".into(),
            adapter: g.as_ref().map(|d| format!("{} (0x{:04x})", d.adapter_name, d.vendor_id)).unwrap_or_else(|| format!("unavailable: {}", self.dxgi_err.lock().unwrap())),
            ui_access: sys::ui_access_token(),
            elevated: sys::self_elevated(),
            jab: !self.cfg.no_jab && jab::load().is_some(),
            dxgi: g.is_some(),
        }
    }
    fn screen_rect(&self) -> Rect {
        self.dxgi.lock().unwrap().as_ref().map(|d| d.screen()).unwrap_or_else(sys::screen_rect)
    }
    fn capture_frame(&self, r: Rect, timeout_ms: u32, publish: bool) -> Result<CapturedFrame, PErr> {
        self.ensure_dxgi();
        let mut g = self.dxgi.lock().unwrap();
        match g.as_mut() {
            None => Err(PErr::Unsupported(format!("DXGI unavailable: {}", self.dxgi_err.lock().unwrap()))),
            Some(d) => {
                let res = d.capture(r, timeout_ms, publish);
                if let Err(PErr::Other(m)) = &res {
                    if m.contains("ACCESS_LOST") {
                        *g = None; // recreate on the next call (UAC prompt / desktop switch / resolution change)
                    }
                }
                res
            }
        }
    }
    fn windows(&self) -> Vec<WindowInfo> {
        let jab = if self.cfg.no_jab { None } else { jab::load() };
        sys::list_windows()
            .into_iter()
            .map(|mut w| {
                if !w.is_java {
                    if let Some(j) = jab {
                        if w.class.starts_with("SunAwt") || w.process.to_lowercase().starts_with("java") {
                            w.is_java = j.is_java_window(sys::hwnd_from(w.window_id));
                        }
                    }
                }
                w
            })
            .collect()
    }
    fn foreground(&self) -> i64 {
        sys::foreground()
    }
    fn scan_window(&self, w: &WindowInfo, max_nodes: usize) -> Result<RawNode, PErr> {
        if w.is_java && !self.cfg.no_jab {
            if let Some(j) = jab::load() {
                if let Ok(t) = j.scan(sys::hwnd_from(w.window_id), max_nodes) {
                    return Ok(t);
                }
            }
        }
        uia::scan(w.window_id, max_nodes)
    }
    fn act(&self, w: &WindowInfo, e: &RefEntry, op: &ActOp) -> Result<ActResult, PErr> {
        if e.source == "jab" {
            return jab::load().ok_or_else(|| PErr::Unsupported("Java Access Bridge not installed".into()))?.act(w, e, op);
        }
        uia::act(w, e, op)
    }
    fn notifications(&self) -> Result<Vec<Notification>, PErr> {
        notify::list()
    }
    fn dismiss_notification(&self, id: &str) -> Result<(), PErr> {
        notify::dismiss(id)
    }
    fn open_surface(&self, name: &str) -> Result<(), PErr> {
        notify::open_surface(name)
    }
    fn avail_memory_mb(&self) -> u64 {
        sys::avail_memory_mb()
    }
    fn sidecar_start(&self) -> Result<String, PErr> {
        let mut g = self.sidecar.lock().unwrap();
        if let Some(s) = g.as_mut() {
            if s.child.try_wait().map(|x| x.is_none()).unwrap_or(false) {
                return Ok(s.endpoint.clone());
            }
        }
        let script = self.cfg.sidecar_script.clone().ok_or_else(|| PErr::Unsupported("sidecar-dml/server.py not found".into()))?;
        let port = 18765u16;
        let py = self.cfg.python.clone().unwrap_or_else(|| "python".into());
        let child = Command::new(py)
            .arg(&script)
            .args(["--port", &port.to_string(), "--idle-ttl", "180", "--mem-cap-mb", "3072"])
            .creation_flags_hidden()
            .spawn()
            .map_err(|e| PErr::Other(format!("spawn sidecar: {e}")))?;
        // KILL_ON_JOB_CLOSE + 3 GiB per-process cap: the sidecar can never outlive the driver or exceed the UMA quota
        let job = Job::kill_on_close(Some(3 * 1024 * 1024 * 1024)).map_err(PErr::Other)?;
        job.assign_pid(child.id()).map_err(PErr::Other)?;
        let endpoint = format!("http://127.0.0.1:{port}");
        *g = Some(Sidecar { child, _job: job, endpoint: endpoint.clone() });
        Ok(endpoint)
    }
    fn sidecar_stop(&self) {
        if let Some(mut s) = self.sidecar.lock().unwrap().take() {
            let _ = s.child.kill();
            let _ = s.child.wait();
        }
    }
}

trait HiddenExt {
    fn creation_flags_hidden(&mut self) -> &mut Self;
}
impl HiddenExt for Command {
    fn creation_flags_hidden(&mut self) -> &mut Self {
        use std::os::windows::process::CommandExt;
        self.creation_flags(0x0800_0000) // CREATE_NO_WINDOW
    }
}
