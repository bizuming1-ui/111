#Requires -Version 7.0
<#
  ps_safe_worker.ps1 - one-shot restricted PowerShell executor (compat bridge for the old AST+CLM engine).
  It is NOT a main loop: Python wakes it only when a model asks for run_powershell, it reads ONE JSON request from
  stdin {command,timeout,workspace}, audits the AST (default-deny allow-list), switches to ConstrainedLanguage,
  runs, prints ONE JSON line {ok,output|code,message}, and exits (RSS is released immediately).
#>
$ErrorActionPreference = 'Stop'
[Console]::InputEncoding = [Text.UTF8Encoding]::new($false)
[Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
function Out-Json($o) { [Console]::Out.WriteLine(($o | ConvertTo-Json -Compress -Depth 4)) }

$raw = [Console]::In.ReadToEnd()
try { $req = $raw | ConvertFrom-Json } catch { Out-Json @{ ok = $false; code = 'SECURITY_BAD_REQUEST'; message = 'invalid JSON request' }; exit 0 }
$cmd = [string]$req.command
$ws = [string]$req.workspace
if ([string]::IsNullOrWhiteSpace($cmd)) { Out-Json @{ ok = $false; code = 'SECURITY_BAD_REQUEST'; message = 'empty command' }; exit 0 }

$ReadOnly = @('get-date', 'get-process', 'get-childitem', 'get-content', 'select-object', 'where-object', 'foreach-object', 'sort-object', 'measure-object',
    'format-table', 'format-list', 'out-string', 'write-output', 'write-host', 'test-path', 'get-item', 'get-itemproperty', 'resolve-path', 'join-path',
    'split-path', 'get-location', 'get-service', 'get-startapps', 'get-clipboard', 'start-sleep', 'convertto-json', 'convertfrom-json', 'get-random',
    'group-object', 'compare-object', 'select-string', 'get-cimInstance', 'get-volume', 'get-psdrive', 'get-hotfix', 'get-timezone', 'get-culture', 'get-command',
    'get-process', 'get-ciminstance', 'out-null', 'tee-object', 'get-filehash', 'get-help', 'get-member', 'convertto-csv', 'convertfrom-csv', 'format-hex')
$WriteWs = @('set-content', 'add-content', 'out-file', 'new-item', 'copy-item', 'move-item', 'remove-item', 'rename-item', 'set-clipboard', 'clear-content', 'export-csv')
$Denied = @('add-type', 'new-object', 'invoke-expression', 'iex', 'invoke-command', 'icm', 'start-process', 'saps', 'invoke-webrequest', 'iwr', 'curl', 'wget',
    'invoke-restmethod', 'irm', 'start-bitstransfer', 'set-executionpolicy', 'stop-computer', 'restart-computer', 'stop-process', 'set-itemproperty', 'new-itemproperty',
    'remove-itemproperty', 'register-scheduledtask', 'new-service', 'set-service', 'import-module', 'enter-pssession', 'new-pssession', 'invoke-item', 'ii',
    'format-volume', 'clear-disk', 'initialize-disk', 'set-alias', 'new-alias', 'set-variable', 'invoke-wmimethod', 'invoke-cimmethod', 'reg', 'regedit', 'cmd', 'powershell', 'pwsh')

$tokens = $null; $errs = $null
$ast = [System.Management.Automation.Language.Parser]::ParseInput($cmd, [ref]$tokens, [ref]$errs)
$viol = [System.Collections.Generic.List[string]]::new()
if ($errs.Count -gt 0) { $viol.Add("parse_error: $($errs[0].Message)") }

function Test-InWs([string]$p) {
    try { $full = [IO.Path]::GetFullPath($p, $ws) } catch { return $false }
    return $full.StartsWith([IO.Path]::GetFullPath($ws), [StringComparison]::OrdinalIgnoreCase)
}

foreach ($n in $ast.FindAll({ $true }, $true)) {
    if ($n -is [System.Management.Automation.Language.CommandAst]) {
        $name = $n.GetCommandName()
        if (-not $name) { $viol.Add("dynamic_command: line $($n.Extent.StartLineNumber)"); continue }
        $l = $name.ToLowerInvariant()
        if ($Denied -contains $l) { $viol.Add("denied_command: $name"); continue }
        if ($ReadOnly -contains $l) { continue }
        if ($WriteWs -contains $l) {
            foreach ($el in $n.CommandElements | Select-Object -Skip 1) {
                if ($el -is [System.Management.Automation.Language.StringConstantExpressionAst]) {
                    if ($el.Value -notmatch '^-' -and $l -ne 'set-clipboard' -and -not (Test-InWs $el.Value)) { $viol.Add("path_outside_workspace: $($el.Value)") }
                }
            }
            continue
        }
        $viol.Add("unknown_command: $name (default deny)")
    }
    elseif ($n -is [System.Management.Automation.Language.InvokeMemberExpressionAst] -and $n.Static) {
        $t = $n.Expression.ToString().ToLowerInvariant()
        $ok = @('[environment]', '[datetime]', '[math]', '[string]', '[convert]', '[guid]', '[io.path]', '[system.io.path]', '[system.environment]', '[regex]', '[timespan]')
        if ($ok -notcontains $t -or ($t -match 'environment' -and $n.Member.Value -notin @('GetFolderPath', 'MachineName', 'OSVersion', 'ProcessorCount', 'UserName', 'TickCount64'))) { $viol.Add("static_member_denied: $($n.Extent.Text)") }
    }
    elseif ($n -is [System.Management.Automation.Language.TypeExpressionAst] -or $n -is [System.Management.Automation.Language.ConvertExpressionAst]) {
        $tn = $n.TypeName.FullName.ToLowerInvariant()
        if ($tn -match 'reflection|dllimport|marshal|runtime\.interopservices|activator|assembly|wmi|net\.webclient|diagnostics\.process') { $viol.Add("type_denied: $tn") }
