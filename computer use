def row_business_identity(row: dict) -> str:
    """thread id when the DOM exposes one (FULL id, never truncated); else a digest of sender|subject|time.  Never a row index."""
    tid = str(row.get("thread_id") or row.get("identity") or "").strip()
    if tid:
        return "gmail:" + tid
    h = _g18_hashlib.sha1(f"{row.get('sender', '')}|{row.get('subject', '')}|{row.get('time', '')}".encode("utf-8")).hexdigest()[:14]
    return "gmail:sig:" + h


def row_label(row: dict, identity: str) -> str:
    """human-auditable label for the HITL list: sender · subject · id-tail (v17.1 printed five identical 'thread #thread-f:1')."""
    s, sub = str(row.get("sender", "")).strip()[:16], str(row.get("subject", "")).strip()[:34]
    return f"{s or '?'} · {sub or '(无主题)'} · …{identity[-6:]}"


@_g18_dc
class GmailSnapshot:
    epoch: int
    url: str
    rows: list                     # [{thread_id|identity, sender, subject, time, rect, checked, row}]
    toolbar: list = _g18_field(default_factory=list)   # [{name, rect, ref}]  (bulk-action bar; present once >=1 row is ticked)
    all_loaded: bool = True


@_g18_dc
class GmailRunResult:
    ok: bool
    status: str                    # verified | partial | unverified | refused | aborted
    reason: str = ""
    targets: list = _g18_field(default_factory=list)
    per_item: dict = _g18_field(default_factory=dict)   # identity -> {"gone": bool|None, "trash": bool|None, "verified": bool}
    steps: list = _g18_field(default_factory=list)
    diff: str = ""
    backend: str = ""


class GmailV18Executor:
    """backend protocol (async):  name · snapshot() -> GmailSnapshot · tick(identity, mode='click') -> bool · click_trigger(name, ref) -> bool ·
       press_delete() -> bool (keyboard strategy) · verify(identities) -> {identity: {"gone": bool|None, "trash": bool|None}}"""

    def __init__(self, backend: Any, say: Any = None, confirm: Any = None) -> None:
        self.be = backend
        self.say = say or (lambda m: None)
        self.confirm = confirm
        self.reg = _G18Registry()
        self.gate = _G18Gate(self.reg)
        self.fb = _G18Fallback(("structured_trigger", "keyboard_shortcut", "human_handoff"))
        self.steps: list = []

    def _step(self, name: str, ok: bool, ev: str) -> None:
        self.steps.append({"step": name, "ok": ok, "evidence": ev[:240]})
        self.say(f"  {'✓' if ok else '✗'} [{name}] {ev[:200]}")

    def _fuse(self, snap: GmailSnapshot) -> dict:
        """rows + toolbar -> UnifiedObjectRefs in ONE epoch; returns {identity: object}"""
        dom = []
        for r in snap.rows:
            ident = row_business_identity(r)
            dom.append({"rect": r["rect"], "name": row_label(r, ident), "role": "row", "identity": ident, "ref_id": str(r.get("ref") or ident),
                        "state": {"selected": bool(r.get("checked")), "checked": bool(r.get("checked"))}})
        for t in snap.toolbar:
            dom.append({"rect": t["rect"], "name": t["name"], "role": "button", "ref_id": str(t.get("ref") or t["name"])})
        objs = _G18Fusion().fuse(snapshot_epoch=snap.epoch, application_id="gmail", window_id=0, coordinate_space="viewport_css", dom=dom)
        self.reg.ingest(objs, snap.epoch)
        return {o.business_identity: o for o in objs if o.business_identity}

    async def run(self, front: int, back: int, dry_run: bool = False) -> GmailRunResult:
        be = self.be
        bn = getattr(be, "name", "backend")
        snap = await be.snapshot()
        if "mail.google.com" not in (snap.url or "") and bn != "api":
            self._step("snapshot", False, f"当前页面 {snap.url[:60]!r} 不是 Gmail：拒绝在旧/错误页面上冻结")
            return GmailRunResult(False, "refused", "当前页面不是 Gmail", steps=self.steps, backend=bn)
        n = len(snap.rows)
        if front < 0 or back < 0 or front + back == 0 or front + back > n:
            self._step("snapshot", False, f"需要前 {front} + 后 {back} 封，但快照只有 {n} 行")
            return GmailRunResult(False, "refused", f"行数不足（{n}）", steps=self.steps, backend=bn)
        idents = [row_business_identity(r) for r in snap.rows]
        if len(set(idents)) != len(idents):
            dup = len(idents) - len(set(idents))
            self._step("freeze", False, f"{dup} 个业务身份重复：拒绝冻结（宁可停也不误删）")
            return GmailRunResult(False, "refused", "业务身份不唯一", steps=self.steps, backend=bn)
        by_ident = self._fuse(snap)
        tgt_idents = idents[:front] + (idents[n - back:] if back else [])
        tgt_ids = [by_ident[i].object_id for i in tgt_idents]
        try:
            intent = self.gate.freeze("delete", tgt_ids, snap.epoch)
        except Exception as e:  # noqa: BLE001
            self._step("freeze", False, f"{type(e).__name__}: {e}")
            return GmailRunResult(False, "refused", str(e), steps=self.steps, backend=bn)
        labels = [by_ident[i].accessible_name for i in tgt_idents]
        self._step("freeze", True, f"epoch={snap.epoch} 冻结 {len(tgt_idents)} 个目标（业务身份唯一）：" + "；".join(labels[:5]))
        if self.confirm is not None and not await self.confirm(labels):
            return GmailRunResult(False, "aborted", "用户未确认", tgt_idents, steps=self.steps, backend=bn)
        if dry_run:
            return GmailRunResult(True, "unverified", "dry_run：只冻结，不执行", tgt_idents, steps=self.steps, backend=bn)
        # ---- tick by identity (re-resolved in the live DOM; row indexes are never used)
        before = _G18Snap.from_objects(self.reg.objects.values(), snap.epoch, snap.url)
        for ident in tgt_idents:
            if not await be.tick(ident, "click"):
                self._step("tick", False, f"{ident[-8:]} 勾选失败")
        snap2 = await be.snapshot()
        by2 = self._fuse(snap2)
        diff = _g18_diff(before, _G18Snap.from_objects(self.reg.objects.values(), snap2.epoch, snap2.url), self.fb.ledger)
        sel = {i for i, o in by2.items() if o.selected}
        missing = [i for i in tgt_idents if i not in sel]
        if missing:
            dec = self.fb.after_action("tick:click", False, diff)
            self._step("tick", False, f"{len(missing)} 个目标未处于选中态（{dec.kind}）；改用键盘通道 x 重试一次")
            for ident in missing:
                await be.tick(ident, "keyboard")
            snap2 = await be.snapshot()
            by2 = self._fuse(snap2)
            sel = {i for i, o in by2.items() if o.selected}
            missing = [i for i in tgt_idents if i not in sel]
        extra = sorted(sel - set(tgt_idents))
        if missing or extra:
            self._step("tick", False, f"选中集合与冻结集合不一致：缺 {len(missing)} 个、多 {len(extra)} 个 → 中止（未触发任何破坏性动作）")
            return GmailRunResult(False, "aborted", "选中集合 ≠ 冻结集合", tgt_idents, steps=self.steps, diff=diff.summary(), backend=bn)
        self._step("tick", True, f"epoch={snap2.epoch}：{len(tgt_idents)}/{len(tgt_idents)} 目标 selected=True，且无越界选中")
        # ---- Action Trigger: structured toolbar delete → keyboard shortcut (each gated)
        fired = False
        trig = next((o for o in self.reg.by_role("trigger") if _G18_trigger_ok(o.accessible_name)), None)
        if trig is not None:
            v = self.gate.check(_G18Req("click", trig.object_id, snap2.epoch, None, "delete"))
            self._step("trigger_gate", v.allow, f"{v.code} {v.reason[:120]}")
            if v.allow:
                fired = await be.click_trigger(trig.accessible_name, trig.dom_identity)
        else:
            self._step("trigger_find", False, "快照中没有带『删除』语义的结构化工具栏按钮 → 切换到键盘通道（仍受 selected==冻结集 约束）")
        if not fired and not self.fb.pre_check("trigger:keyboard"):
            fired = await be.press_delete()
            self._step("trigger_keyboard", fired, "键盘删除通道已下发" if fired else "键盘删除通道不可用")
        if not fired:
            return GmailRunResult(False, "aborted", "没有可用且通过门控的删除触发器", tgt_idents, steps=self.steps, diff=diff.summary(), backend=bn)
        self.fb.ledger.record("gmail.delete:" + intent.target_ids[0], f"{len(tgt_idents)} targets")
        # ---- per-item verification
        ver = {}
        for _ in range(4):
            ver = await be.verify(tgt_idents)
            if all((v.get("gone") is True) for v in ver.values()):
                break
            await _g18_asyncio.sleep(0.6)
        per = {}
        for i in tgt_idents:
            v = ver.get(i, {})
            gone, trash = v.get("gone"), v.get("trash")
            per[i] = {"gone": gone, "trash": trash, "verified": bool(gone is True and trash is not False)}
        nver = sum(1 for p in per.values() if p["verified"])
        self._step("verify_each", nver == len(per), f"逐项核验 {nver}/{len(per)} 封确已离开收件箱" + ("且带 TRASH 标签" if bn == "api" else ""))
        status = "verified" if nver == len(per) else ("partial" if nver else "unverified")
        return GmailRunResult(nver == len(per), status, "" if nver == len(per) else f"{len(per) - nver} 封未能核验", tgt_idents, per, self.steps, diff.summary(), bn)


def _G18_trigger_ok(name: str) -> bool:
    return bool(re.search(r"删除|刪除|垃圾|delete|trash|bin\b|move to", name or "", re.I))


class GmailApiBackend:
    """OAuth API lane: 'selection' is a local flag; the trigger is `trash_messages`; verification is the labels oracle (TRASH)."""
    name = "api"

    def __init__(self, skill: "GmailSkill", query: str = "in:inbox") -> None:
        self.sk, self.query, self.epoch, self.sel, self.deleted = skill, query, 0, set(), set()

    async def snapshot(self) -> GmailSnapshot:
        msgs = await _g18_asyncio.to_thread(self.sk.list_messages, self.query, "newest_first", None)
        self.epoch += 1
        rows = [{"thread_id": m.get("id"), "sender": m.get("from", ""), "subject": m.get("subject", ""), "time": m.get("date", ""),
                 "rect": [0, 40 * i, 800, 36], "checked": m.get("id") in self.sel} for i, m in enumerate(msgs) if m.get("id") not in self.deleted]
        tb = [{"name": "删除 (API trash)", "rect": [0, -40, 120, 32]}] if self.sel else []
        return GmailSnapshot(self.epoch, "https://mail.google.com/api", rows, tb, True)

    async def tick(self, identity: str, mode: str = "click") -> bool:
        self.sel.add(identity.replace("gmail:", "", 1))
        return True

    async def click_trigger(self, name: str, ref: str) -> bool:
        ids = sorted(self.sel)
        res = await _g18_asyncio.to_thread(self.sk.trash_messages, ids)
        self.deleted |= {i for i, ok in res.items() if ok}
        return all(res.values()) if res else False

    async def press_delete(self) -> bool:
        return await self.click_trigger("delete", "")

    async def verify(self, identities: list) -> dict:
        ids = [i.replace("gmail:", "", 1) for i in identities]
        lab = await _g18_asyncio.to_thread(self.sk.verify_labels, ids, "TRASH")
        return {i: {"gone": bool(lab.get(i.replace("gmail:", "", 1))), "trash": lab.get(i.replace("gmail:", "", 1))} for i in identities}
