    @staticmethod
    def annotate(path: str, elements: list[Element], src: Optional[list[int]], scale: float) -> None:
        """Screen-coordinate ruler grid + Set-of-Mark numbered boxes so a vision model can read REAL screen coordinates."""
        try:
            from PIL import Image, ImageDraw, ImageFont

            im = Image.open(path).convert("RGBA")
            ov = Image.new("RGBA", im.size, (0, 0, 0, 0))
            d = ImageDraw.Draw(ov)
            try:
                f = ImageFont.load_default(size=13)
            except TypeError:
                f = ImageFont.load_default()
            sx, sy = (src[0], src[1]) if src else (0, 0)
            span_x, span_y = int(im.width / scale), int(im.height / scale)
            step = 100 if span_x > 500 else 50
            x0 = (sx // step + 1) * step
            for X in range(x0, sx + span_x, step):
                px = int((X - sx) * scale)
                d.line([(px, 0), (px, im.height)], fill=(255, 0, 255, 150), width=1)
                d.text((px + 2, 2), f"x{X}", fill=(255, 0, 255, 255), font=f)
            y0 = (sy // step + 1) * step
            for Y in range(y0, sy + span_y, step):
                py = int((Y - sy) * scale)
                d.line([(0, py), (im.width, py)], fill=(0, 160, 255, 150), width=1)
                d.text((2, py + 2), f"y{Y}", fill=(0, 160, 255, 255), font=f)
            palette = [(255, 0, 0), (0, 150, 0), (255, 120, 0), (140, 0, 220), (0, 120, 200)]
            for i, e in enumerate(elements[:MAX_LIST], 1):
                x, y, w, h = e.rect
                x1, y1, x2, y2 = int((x - sx) * scale), int((y - sy) * scale), int((x - sx + w) * scale), int((y - sy + h) * scale)
                if x2 < 0 or y2 < 0 or x1 > im.width or y1 > im.height:
                    continue
                col = palette[i % len(palette)]
                d.rectangle([x1, y1, x2, y2], outline=col + (255,), width=2)
                tw = 8 * len(str(i)) + 6
                d.rectangle([x1, y1, x1 + tw, y1 + 15], fill=col + (230,))
                d.text((x1 + 3, y1 + 1), str(i), fill=(255, 255, 255, 255), font=f)
            Image.alpha_composite(im, ov).convert("RGB").save(path)
        except Exception:  # noqa: BLE001
            pass
