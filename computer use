  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dscu.local/schemas/protocol_v1.json",
  "title": "DSCU Unified IPC Protocol v1 (single source of truth)",
  "description": "NDJSON (one JSON object per line, UTF-8, LF) over: Windows Named Pipe (Rust driver: \\\\.\\pipe\\dscu-driver-v1, TS daemon: \\\\.\\pipe\\dscu-cdp-v1). Every request carries a unique 'id'; the peer answers with the same 'id'. Every observation field is captured live - no default/placeholder values are allowed on the wire.",
  "$defs": {
    "Channel": { "enum": ["cdp", "uia", "jab", "dxgi_vision"] },
    "Zone": { "enum": ["Toolbar", "Row", "Modal", "Other"] },
    "ErrorCode": {
      "enum": ["OK", "STALE_EPOCH", "AMBIGUOUS_TARGET", "OCCLUDED", "UIPI_DENIED", "SECURITY_DENIED", "OBJECT_IDENTITY_MISMATCH",
               "NOT_FOUND", "USER_ACTIVE", "FOREGROUND_FAILED", "TIMEOUT", "UNSUPPORTED", "INTERNAL"]
