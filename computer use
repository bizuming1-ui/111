    elseif ($n -is [System.Management.Automation.Language.VariableExpressionAst]) {
        if ($n.VariablePath.UserPath -match '^(env:|using:|executioncontext|host|pshome|profile)') { $viol.Add("variable_denied: $($n.Extent.Text)") }
    }
}

if ($viol.Count -gt 0) {
    Out-Json @{ ok = $false; code = 'SECURITY_AST_VIOLATION'; message = ('run_powershell 未通过 AST 静态审计（共 {0} 处）：{1}。请改用原生动作（focus_window / launch / app_resolve），不要用 PowerShell 做窗口 P/Invoke。' -f $viol.Count, ($viol -join '; ')) }
    exit 0
}

try {
    $null = New-Item -ItemType Directory -Force -Path $ws
    Set-Location $ws
    $sb = [scriptblock]::Create($cmd)   # must be created BEFORE switching: [scriptblock]::Create is blocked in CLM
    $ExecutionContext.SessionState.LanguageMode = 'ConstrainedLanguage'
    $out = (& $sb *>&1 | Out-String -Width 200)
    Out-Json @{ ok = $true; output = $out.TrimEnd() }
}
catch {
    Out-Json @{ ok = $false; code = 'RUNTIME_ERROR'; message = $_.Exception.Message }
}
