class TestTargetTrigger(unittest.TestCase):
    def setUp(self):
        dom = [{"rect": [10, 100 + i * 40, 600, 36], "name": f"mail {i}", "role": "row", "identity": f"T{i}", "ref_id": f"r{i}", "state": {"selected": i in (0, 1)}} for i in range(5)]
        dom.append({"rect": [100, 60, 40, 40], "name": "删除", "role": "button", "ref_id": "tb"})
        self.objs = ObjectFusionEngine().fuse(snapshot_epoch=3, application_id="gmail", window_id=1, dom=dom)
        self.reg = ObjectRegistry()
        self.reg.ingest(self.objs, 3)
        self.gate = TargetTriggerGate(self.reg)
        self.row = {o.business_identity: o for o in self.objs if o.business_identity}
        self.trig = next(o for o in self.objs if o.action_role == "trigger")

    def test_trigger_released_when_frozen_targets_selected(self):
        self.gate.freeze("delete", [self.row["T0"].object_id, self.row["T1"].object_id], 3)
        v = self.gate.check(UnifiedActionRequest("click", self.trig.object_id, 3, (120, 80), "delete"))
        self.assertTrue(v.allow, v)
        self.assertEqual(v.code, "RELEASED_TRIGGER")
        self.assertEqual(self.gate.stats["oib_avoided"], 1)

    def test_trigger_refused_without_selected_or_with_stray(self):
        self.gate.freeze("delete", [self.row["T0"].object_id], 3)  # T1 is selected too but NOT frozen
        v = self.gate.check(UnifiedActionRequest("click", self.trig.object_id, 3, None, "delete"))
        self.assertFalse(v.allow)
        self.assertEqual(v.code, "SELECTED_OUTSIDE_FROZEN")

    def test_nonfrozen_target_and_stale_epoch_refused(self):
        self.gate.freeze("delete", [self.row["T0"].object_id], 3)
        self.assertEqual(self.gate.check(UnifiedActionRequest("click", self.row["T4"].object_id, 3, None, "delete")).code, "TARGET_NOT_FROZEN")
        self.assertEqual(self.gate.check(UnifiedActionRequest("click", self.trig.object_id, 2, None, "delete")).code, "STALE_EPOCH")

    def test_click_off_the_object_is_refused(self):
        self.gate.freeze("delete", [self.row["T0"].object_id, self.row["T1"].object_id], 3)
        v = self.gate.check(UnifiedActionRequest("click", self.trig.object_id, 3, (300, 400), "delete"))
        self.assertEqual(v.code, "COORD_NOT_ON_OBJECT")

    def test_raw_coordinate_resolves_to_object_first(self):
        self.gate.freeze("delete", [self.row["T0"].object_id, self.row["T1"].object_id], 3)
        self.assertTrue(self.gate.check_point(120, 80, 3, "delete").allow)               # toolbar button
        self.assertFalse(self.gate.check_point(5000, 5000, 3, "delete").allow)          # nothing there + destructive → refuse
        self.assertFalse(self.gate.check_point(50, 100 + 4 * 40 + 5, 3, "delete").allow)  # lands on non-frozen row

    def test_semantics(self):
        self.assertTrue(trigger_semantics_ok("Move to Trash", "delete")[0])
        self.assertFalse(trigger_semantics_ok("标记为已读", "delete")[0])


