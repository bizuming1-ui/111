"""Checkpoint / Rollback — atomic JSON snapshot of task state; rollback hint = Esc / Ctrl+Z first."""
from __future__ import annotations
import json
import os
import tempfile
from pathlib import Path


class CheckpointStore:
    def __init__(self, root: str): self.root = Path(root); self.root.mkdir(parents=True, exist_ok=True)

    def save(self, task_id: str, state: dict) -> Path:
        p = self.root / f"ckpt-{task_id}.json"
        fd, tmp = tempfile.mkstemp(dir=self.root); os.close(fd)
        Path(tmp).write_text(json.dumps(state, ensure_ascii=False), "utf-8"); os.replace(tmp, p); return p

    def load(self, task_id: str) -> dict | None:
        p = self.root / f"ckpt-{task_id}.json"
        return json.loads(p.read_text("utf-8")) if p.exists() else None

    @staticmethod
    def rollback_hint(no_effect_streak: int) -> str:
        return "优先 Esc / Ctrl+Z 回滚上一步误操作，再换一种定位方式" if no_effect_streak >= 2 else ""
