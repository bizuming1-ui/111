function Update-V92MismatchStreak($Resolved, $Obs) {
    $mm = $false; $why = ''; $changed = $false
    foreach ($e in @($Resolved)) {
        if ($e.Outcome -eq 'nochange') { $mm = $true; $why = "第 $($e.Step) 步「$(Limit-Text $e.Desc 40)」没有可验证的效果" }
        elseif ($e.Outcome -eq 'changed') { $changed = $true }
    }
    $txt = ''; try { $txt = "$($Obs.Text)" } catch { }
    if ($txt -match '当前键盘焦点: [^\r\n]*(重命名|Rename|rename)') { $mm = $true; if (-not $why) { $why = '键盘焦点落在「重命名」编辑框（疑似误触发重命名）' } }
    if ($mm) { $script:V92.MismatchStreak++ } elseif ($changed) { $script:V92.MismatchStreak = 0 }
    if ($script:V92.MismatchStreak -ge 2) {
        $script:V92.ReflectNote = "【Micro-Reflection】连续 $($script:V92.MismatchStreak) 步「预期 ≠ 实测」（$why）。先停止叠加新操作：①若怀疑误触发（重命名框 / 弹窗 / 输入法 / 误拖拽），优先 key escape 取消；②若已经产生了不想要的修改（误输入 / 误删 / 误改名），优先 key ctrl+z 回滚；③回滚后重新观察确认状态，再换一种定位方式（换控件编号 / inspect / 快捷键），不要用同样的方法重试。"
        $script:V92.Reflections++; $script:V92.MismatchStreak = 0
    }
}
