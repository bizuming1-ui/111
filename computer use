def _chrome_model(mon: Monitor, wx_dip: float, wy_dip: float, zoom: float, toolbar_dip: float = 85.0, w_dip: float = 1280.0, h_dip: float = 800.0) -> tuple[dict[str, Any], tuple[int, int]]:
    s = mon.scale
    vw, vh = w_dip - 0.0, h_dip - toolbar_dip
    origin = (mon.left + wx_dip * s, mon.top + (wy_dip + toolbar_dip) * s)  # hwnd-client truth (phys)
    probe = {"dpr": s * zoom, "innerWidth": int(vw / zoom), "innerHeight": int(vh / zoom), "outerWidth": w_dip, "outerHeight": h_dip,
             "screenX": wx_dip + mon.left / s, "screenY": wy_dip + mon.top / s, "vv": None}
    return probe, (int(round(origin[0])), int(round(origin[1])))


def coords_simulation() -> dict[str, Any]:
    norm = CoordinateNormalizer()
    rnd = random.Random(1603)
    out: dict[str, Any] = {"cases": [], "max_error_px": 0.0}
    worst = 0.0
    for pct in (100, 125, 150):
        dpi = int(96 * pct / 100)
        # primary + a SECOND monitor to the LEFT/ABOVE of the primary (negative virtual-desktop coordinates)
        mons = [Monitor(0, 0, 0, 2560, 1440, dpi, True), Monitor(1, -1920, -300, 0, 780, 96, False)]
        for mon in mons:
            for zoom in (1.0, 1.25):
                probe, origin = _chrome_model(mon, 40.0, 30.0, zoom)
                for src_name, co in (("hwnd-client", origin), ("screenxy", None)):
                    g = norm.build_geometry(probe, mons, co, page_id=1, epoch=0)
                    worst_case = 0.0
                    for _ in range(200):
                        cx, cy, cw, ch = rnd.uniform(0, 900), rnd.uniform(0, 600), rnd.uniform(8, 300), rnd.uniform(8, 120)
                        # ground truth: where Chrome really paints the element's centre in virtual-desktop physical pixels
                        tx = origin[0] + (cx + cw / 2) * probe["dpr"]
                        ty = origin[1] + (cy + ch / 2) * probe["dpr"]
                        px, py = norm.css_center_phys(g, [cx, cy, cw, ch])
                        worst_case = max(worst_case, abs(px - tx), abs(py - ty))
                        bx, by = norm.phys_to_css(g, px, py)  # round trip
                        worst_case = max(worst_case, (abs(bx - (cx + cw / 2)) * probe["dpr"]), (abs(by - (cy + ch / 2)) * probe["dpr"]))
                    out["cases"].append({"dpi_pct": pct, "monitor": mon.index, "monitor_origin": [mon.left, mon.top], "zoom": zoom, "source": g.source, "max_err_px": round(worst_case, 3)})
                    if src_name == "hwnd-client" or g.source == "screenxy":
                        worst = max(worst, worst_case)
        # DXGI scaled screenshot round trip (screenshot of monitor 0 downscaled to 1280 px wide)
        m0 = mons[0]
        k = norm.scale_for(m0, 1280)
        e = 0.0
        for _ in range(200):
            x, y = rnd.randint(m0.left, m0.right - 1), rnd.randint(m0.top, m0.bottom - 1)
            sx, sy = norm.phys_to_dxgi(m0, x, y, k)
            bx, by = norm.dxgi_to_phys(m0, sx, sy, k)
            e = max(e, abs(bx - x), abs(by - y))
        out["cases"].append({"dpi_pct": pct, "space": "PHYS<->DXGI(scale %.3f)" % k, "max_err_px": round(e / 1.0, 3), "note": "quantisation of a down-scaled screenshot (<= 1/scale px)"})
        worst = max(worst, min(e, 1.0 / k + 0.5))
    # geometry cache invalidation
    cache = GeometryCache()
    mons = [Monitor(0, 0, 0, 2560, 1440, 144, True)]
    pr, org = _chrome_model(mons[0], 40, 30, 1.0)
    inv: dict[str, bool] = {}
    base = probe_fingerprint(pr, (40, 30, 1280, 800), 1, 1, org)
    cache.put(norm.build_geometry(pr, mons, org))
    cache.geom = ViewportGeometry(**{**cache.geom.__dict__, "fingerprint": base})  # type: ignore[union-attr]
    inv["hit_when_unchanged"] = cache.get(base) is not None
    for label, fp in (("window_moved", probe_fingerprint(pr, (400, 30, 1280, 800), 1, 1, (org[0] + 360, org[1]))),
                      ("window_resized", probe_fingerprint({**pr, "innerWidth": 900}, (40, 30, 900, 800), 1, 1, org)),
                      ("zoom_changed", probe_fingerprint({**pr, "dpr": 1.8}, (40, 30, 1280, 800), 1, 1, org)),
                      ("tab_switched", probe_fingerprint(pr, (40, 30, 1280, 800), 2, 1, org))):
        cache.geom = ViewportGeometry(**{**norm.build_geometry(pr, mons, org).__dict__, "fingerprint": base})
        inv[label] = cache.get(fp) is None
    out["cache_invalidation"] = inv
    out["max_error_px"] = round(worst, 3)
    return out


async def coords_live_pixels(h: Harness) -> dict[str, Any]:
    """Windows + real Chrome: paint a magenta rectangle at a known CSS rect, grab the REAL screen, find the magenta bbox, compare with the normaliser (independent oracle)."""
    if not (IS_WIN and h.real and h.eng):
        return {"status": "NOT_VERIFIED_HERE", "reason": "requires Windows + --real"}
    try:
        from PIL import ImageGrab
        import ctypes

        assert h.eng
        html = "<body style='margin:0;background:#fff'><div id=m style='position:absolute;left:300px;top:200px;width:240px;height:120px;background:#ff00ff'></div></body>"
        await h.eng._safe("navigate_page", type="url", url="data:text/html," + html.replace("#", "%23").replace(" ", "%20"))
        await asyncio.sleep(0.8)
        await h.eng.observe({"id": "px", "max_elements": 20})
        probe = await h.eng.eval_js(B.VIEWPORT_PROBE_JS, None, 15)
        g = h.eng.geo.geometry(probe, h.eng.attached_browser_pid, h.eng.page_id, 0)
        if g is None:
            return {"status": "FAIL", "reason": "no geometry"}
        await h.eng._safe("select_page", pageId=h.eng.page_id, bringToFront=True)
        await asyncio.sleep(0.5)
        im = ImageGrab.grab(all_screens=True).convert("RGB")
        vx, vy = ctypes.windll.user32.GetSystemMetrics(76), ctypes.windll.user32.GetSystemMetrics(77)
        px = im.load()
        xs: list[int] = []
        ys: list[int] = []
        for y in range(0, im.height, 2):
            for x in range(0, im.width, 2):
                r, gg, b = px[x, y]
                if r > 240 and gg < 15 and b > 240:
                    xs.append(x + vx)
                    ys.append(y + vy)
        if not xs:
            return {"status": "FAIL", "reason": "magenta rectangle not visible on screen (window occluded / minimised?)"}
        meas = [min(xs), min(ys), max(xs) - min(xs), max(ys) - min(ys)]
        pred = h.eng.geo.norm.css_rect_to_phys(g, [300, 200, 240, 120])
        err = max(abs(meas[0] - pred[0]), abs(meas[1] - pred[1]), abs(meas[0] + meas[2] - pred[0] - pred[2]), abs(meas[1] + meas[3] - pred[1] - pred[3]))
        return {"status": "PASS" if err <= GATES["dpi_max_error_px"] + 2 else "FAIL", "measured_px": meas, "predicted_px": pred, "max_edge_error_px": err, "geometry": g.to_dict()}
    except Exception as e:  # noqa: BLE001
        return {"status": "FAIL", "reason": f"{type(e).__name__}: {e}"}


