"""Tiny Tk ground-truth window used by Tier-1/Tier-2 (real pixels, real input events, ground truth logged by the OS - not by the agent).
modes: click (canvas that logs real click positions) | type (Entry that logs its content) | widgets (button grid with known rects) | occluder (topmost window)
stdout first line:  READY {json}   (window rect + widget rects in physical screen px)."""
import argparse
import ctypes
import json
import sys
import time

try:
    ctypes.windll.shcore.SetProcessDpiAwareness(2)
except Exception:
    pass
import tkinter as tk  # noqa: E402

ap = argparse.ArgumentParser()
ap.add_argument("mode")
ap.add_argument("--out", default="")
ap.add_argument("--geometry", default="900x600+80+80")
ap.add_argument("--topmost", action="store_true")
ap.add_argument("--seconds", type=float, default=120)
a = ap.parse_args()

root = tk.Tk()
root.title("DSCU-GROUND-TRUTH-" + a.mode)
root.geometry(a.geometry)
if a.topmost or a.mode == "occluder":
    root.attributes("-topmost", True)
state = {"minimized": False}
widgets = []


def log(obj):
    if a.out:
        with open(a.out, "a", encoding="utf-8") as f:
            f.write(json.dumps(obj, ensure_ascii=False) + "\n")


if a.mode == "click":
    cv = tk.Canvas(root, bg="#dde", highlightthickness=0)
    cv.pack(fill="both", expand=True)
    cv.bind("<Button-1>", lambda e: log({"t": time.perf_counter(), "x": e.x_root, "y": e.y_root}))
elif a.mode == "type":
    var = tk.StringVar()
    ent = tk.Entry(root, textvariable=var, font=("Consolas", 18))
    ent.pack(fill="x", padx=20, pady=40)
    ent.focus_force()
    var.trace_add("write", lambda *_: log({"t": time.perf_counter(), "text": var.get()}))
elif a.mode == "widgets":
    for r in range(3):
        for c in range(4):
            b = tk.Button(root, text=f"BTN-{r}{c}", width=12, height=2, command=lambda n=f"BTN-{r}{c}": log({"click": n}))
            b.grid(row=r, column=c, padx=24, pady=24)
            widgets.append((f"BTN-{r}{c}", b))
else:
    tk.Label(root, text="OCCLUDER", font=("Arial", 40)).pack(expand=True)
root.bind("<Unmap>", lambda e: state.update(minimized=True) if e.widget is root else None)
root.bind("<Map>", lambda e: state.update(minimized=False) if e.widget is root else None)


def ready():
    root.update_idletasks()
    info = {"x": root.winfo_rootx(), "y": root.winfo_rooty(), "w": root.winfo_width(), "h": root.winfo_height(), "hwnd": root.winfo_id(),
            "widgets": [{"name": n, "cx": w.winfo_rootx() + w.winfo_width() // 2, "cy": w.winfo_rooty() + w.winfo_height() // 2, "w": w.winfo_width(), "h": w.winfo_height()} for n, w in widgets]}
    print("READY " + json.dumps(info), flush=True)


def poll():
    log({"state": "minimized" if state["minimized"] or root.state() == "iconic" else "visible"}) if a.mode == "occluder" else None
    root.after(400, poll)


root.after(600, ready)
root.after(700, poll)
root.after(int(a.seconds * 1000), root.destroy)
root.mainloop()
