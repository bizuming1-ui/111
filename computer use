# 原始响应（不抛异常）：保留 error.data.candidates / reason 等结构化字段，供 AMBIGUOUS_TARGET / STALE_REF 的重试逻辑使用
function Invoke-DscuRaw([string]$Method, $Params = @{}, [int]$TimeoutMs = 5000) {
    if (-not (Connect-DsDriver)) { throw 'dscu-driver 未运行：输入  driver start  （首次需要 driver build）' }
    $script:Drv.Id++
    $req = [ordered]@{ jsonrpc = '2.0'; v = 1; action_id = [long]$script:ActionSeq; id = $script:Drv.Id; method = $Method; params = $Params; auth = $script:Drv.Token } | ConvertTo-Json -Compress -Depth 8
    $script:Drv.Writer.WriteLine($req); $script:Drv.Writer.Flush()
    $t = $script:Drv.Reader.ReadLineAsync()
    if (-not $t.Wait($TimeoutMs)) { throw 'driver rpc timeout' }
    $line = $t.GetAwaiter().GetResult()
    if ([string]::IsNullOrEmpty($line)) { Close-DsDriver; throw 'driver pipe closed' }
    return ($line | ConvertFrom-Json -Depth 30)
}
function Invoke-DscuCall([string]$Method, $Params = @{}, [int]$TimeoutMs = 5000) {
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $o = Invoke-DscuRaw $Method $Params $TimeoutMs
    try { Add-Span 'ipc' ([double]$sw.Elapsed.TotalMilliseconds) $Method } catch { }
    if ($o.error) { throw "driver error $($o.error.code): $($o.error.message)" }
    return $o.result
}

# ---- 与 Get-PixelSig 同一份区域定义（前台窗口可见部分 ∩ 主屏）----
function Get-ViewRegion {
    try {
        $vb = Get-ViewBounds
        $bd = if ($null -ne $vb.Win) { $vb.Win } else { $vb.Screen }
        $s = $vb.Screen
        $l = [int][Math]::Max($bd[0], $s[0]); $t = [int][Math]::Max($bd[1], $s[1]); $r = [int][Math]::Min($bd[2], $s[2]); $b = [int][Math]::Min($bd[3], $s[3])
        if (($r - $l) -lt 16 -or ($b - $t) -lt 16) { return $null }
        return [pscustomobject]@{ X = $l; Y = $t; W = ($r - $l); H = ($b - $t) }
    }
    catch { return $null }
}
# 驱动内一次 RPC 返回 48x32 指纹（无需拷贝整帧）；任何失败返回 $null，调用方回退到原有路径
function Get-DriverSignature([int]$x, [int]$y, [int]$w, [int]$h) {
    if ($NoDriver -or $w -lt 16 -or $h -lt 16) { return $null }
    try {
        if (-not (Connect-DsDriver)) { return $null }
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $r = Invoke-DriverRpc 'capture.signature' @{ x = $x; y = $y; w = $w; h = $h; timeoutMs = 16 } 400
        $b = [Convert]::FromBase64String([string]$r.sig_b64)
        if ($b.Length -ne 1536) { return $null }
        $script:CapStats.Dxgi++; $script:CapStats.DxgiMs += $sw.Elapsed.TotalMilliseconds
        Add-Span 'capture' ([double]$sw.Elapsed.TotalMilliseconds) 'dxgi-sig'
        return , $b
    }
    catch {
        if ("$($_.Exception.Message)" -notlike 'driver error*') { Close-DsDriver; $script:Drv.DownUntil = [datetime]::UtcNow.AddSeconds(30) }
        return $null
    }
}
# 乐观锁指纹：驱动在线 → capture.ahash（同区域、同定义）；否则沿用 v7.1 的 PowerShell 路径
function Get-LiveRegionAHash {
    if (-not $NoDriver) {
        try {
            $rg = Get-ViewRegion
            if ($rg -and (Connect-DsDriver)) {
                $r = Invoke-DriverRpc 'capture.ahash' @{ x = $rg.X; y = $rg.Y; w = $rg.W; h = $rg.H } 400
                if ($r -and $r.ahash -and "$($r.ahash)" -match '^[0-9a-f]{16}$') { return "$($r.ahash)" }
            }
        }
        catch { }
    }
    return (Get-RegionAHash (Get-PixelSig ([IntPtr]::Zero)))
}
# 整数运算版 aHash（与 v7.1 的 double 版逐位一致，已用 21 条由原函数生成的向量对拍）：循环体里不再有 double 装箱 / Measure-Object
function Get-RegionAHash([byte[]]$Sig) {
    if ($null -eq $Sig -or $Sig.Length -ne 1536) { return $null }
    if (Test-V9Fast) { try { $v9h = [DsV9Fast]::AHashHex($Sig); if ($v9h) { return $v9h } } catch { } }   # v9.0：位级等价 C# 快路径（失败落回下方原循环）
    $sums = New-Object 'long[]' 64
    [long]$total = 0
    for ($by = 0; $by -lt 8; $by++) {
        for ($bx = 0; $bx -lt 8; $bx++) {
            [long]$s = 0
            $base = $by * 192 + $bx * 6
            for ($y = 0; $y -lt 4; $y++) {
                $o = $base + $y * 48
                $s += [long]$Sig[$o] + $Sig[$o + 1] + $Sig[$o + 2] + $Sig[$o + 3] + $Sig[$o + 4] + $Sig[$o + 5]
            }
            $sums[$by * 8 + $bx] = $s
            $total += $s
        }
    }
    [uint64]$bits = 0
    for ($i = 0; $i -lt 64; $i++) { if ($sums[$i] * 64 -gt $total) { $bits = $bits -bor ([uint64]1 -shl $i) } }
    return $bits.ToString('x16')
}

