# ================================================================================ transaction journal
@dataclass
class TxEntry:
    seq: int
    step: int
    sig: str
    irreversible: bool
    status: str = "started"  # started | committed | failed | unknown
    t: float = field(default_factory=time.time)
    note: str = ""


IRREVERSIBLE = re.compile(r"delete|remove|send|submit|pay|purchase|post|publish|like|follow|删除|发送|提交|支付|购买|发布|点赞|关注|清空", re.I)


class TaskTransaction:
    """Journal of side-effecting actions.  Irreversible signatures are executed at most once unless the previous attempt is known failed.
    The journal is persisted (JSON lines) so a crashed/killed session can show exactly what was already done."""

    def __init__(self, path: Optional[Path] = None) -> None:
        self.entries: list[TxEntry] = []
        self.path = path
        self.state = "idle"  # idle | active | committed | aborted

    def begin(self) -> None:
        self.state = "active"

    def intend(self, step: int, sig: str, action: dict[str, Any], label: str = "") -> Optional[str]:
        irrev = bool(IRREVERSIBLE.search(f"{action.get('action', '')} {label}")) and action.get("action") not in ("wait", "key", "scroll", "vision_inspect")
        if irrev:
            prev = [e for e in self.entries if e.sig == sig and e.irreversible and e.status in ("committed", "started", "unknown")]
            if prev and not action.get("repeat"):
                return f"[ONCE_GUARD] 不可逆动作 {sig[:50]} 已在第 {prev[-1].step} 步执行过（状态 {prev[-1].status}），不会重复执行；若确需重复请加 \"repeat\":true 并说明原因。"
        e = TxEntry(len(self.entries) + 1, step, sig, irrev)
        self.entries.append(e)
        self._persist(e)
        return None

    def settle(self, ok: bool, effect: str = "") -> None:
        if not self.entries:
            return
        e = self.entries[-1]
        e.status = "committed" if ok and effect != "none" else "failed" if not ok else "unknown"
        e.note = effect
        self._persist(e)

    def commit(self) -> None:
        self.state = "committed"

    def abort(self) -> None:
        self.state = "aborted"

    def _persist(self, e: TxEntry) -> None:
        if not self.path:
            return
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            with open(self.path, "a", encoding="utf-8") as f:
                f.write(json.dumps(e.__dict__, ensure_ascii=False) + "\n")
        except OSError:
            pass


