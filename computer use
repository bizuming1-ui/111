"""Resident-memory accounting for the whole multi-language stack (Python + Rust + Node). Real numbers only:
Windows -> K32GetProcessMemoryInfo (WorkingSetSize / PrivateUsage), Linux -> /proc/<pid>/status (CI)."""
from __future__ import annotations

import ctypes
import os
import sys


def rss_mb(pid: int) -> float:
    if sys.platform == "win32":
        from ctypes import wintypes

        class PMCX(ctypes.Structure):
            _fields_ = [("cb", wintypes.DWORD), ("PageFaultCount", wintypes.DWORD), ("PeakWorkingSetSize", ctypes.c_size_t), ("WorkingSetSize", ctypes.c_size_t),
                        ("QuotaPeakPagedPoolUsage", ctypes.c_size_t), ("QuotaPagedPoolUsage", ctypes.c_size_t), ("QuotaPeakNonPagedPoolUsage", ctypes.c_size_t),
                        ("QuotaNonPagedPoolUsage", ctypes.c_size_t), ("PagefileUsage", ctypes.c_size_t), ("PeakPagefileUsage", ctypes.c_size_t), ("PrivateUsage", ctypes.c_size_t)]

        k32 = ctypes.WinDLL("kernel32", use_last_error=True)
        k32.OpenProcess.restype = wintypes.HANDLE
        h = k32.OpenProcess(0x1000 | 0x0010, False, pid)  # QUERY_LIMITED_INFORMATION | VM_READ
        if not h:
            return 0.0
        try:
            c = PMCX()
            c.cb = ctypes.sizeof(c)
            if k32.K32GetProcessMemoryInfo(h, ctypes.byref(c), c.cb):
                return c.WorkingSetSize / 1048576
            return 0.0
        finally:
            k32.CloseHandle(h)
    try:
        with open(f"/proc/{pid}/status", encoding="utf-8") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) / 1024
    except OSError:
        pass
    return 0.0


def free_mb() -> int | None:
    if sys.platform == "win32":
        from ctypes import wintypes

        class MS(ctypes.Structure):
            _fields_ = [("dwLength", wintypes.DWORD), ("dwMemoryLoad", wintypes.DWORD), ("ullTotalPhys", ctypes.c_ulonglong), ("ullAvailPhys", ctypes.c_ulonglong),
                        ("ullTotalPageFile", ctypes.c_ulonglong), ("ullAvailPageFile", ctypes.c_ulonglong), ("ullTotalVirtual", ctypes.c_ulonglong),
                        ("ullAvailVirtual", ctypes.c_ulonglong), ("ullAvailExtendedVirtual", ctypes.c_ulonglong)]

        m = MS()
        m.dwLength = ctypes.sizeof(m)
        if ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(m)):  # type: ignore[attr-defined]
            return int(m.ullAvailPhys / 1048576)
        return None
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemAvailable:"):
                    return int(line.split()[1]) // 1024
    except OSError:
        pass
    return None


def stack_report(pids: dict[str, int]) -> dict[str, float]:
    out = {name: round(rss_mb(pid), 1) for name, pid in pids.items() if pid}
    out["python"] = round(rss_mb(os.getpid()), 1)
    out["total"] = round(sum(out.values()), 1)
    return out
