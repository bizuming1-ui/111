from .core import AgentBrain
from .entropy_router import EntropyRouter
from .otel import Tracer
from .protocol import ActionRequest, ActionResult, ObservationEnvelope
from .uma import UmaBreaker


@dataclass
class UnifiedBrain(AgentBrain):
    gate: ActionGate = field(default_factory=ActionGate)
    entropy: EntropyRouter = field(default_factory=EntropyRouter)
    tracer: Tracer = field(default_factory=Tracer)
    uma: UmaBreaker = field(default_factory=UmaBreaker)
    local_vision_up: bool = False
    avail_mb: float = 12288.0

    def hint(self, obs: ObservationEnvelope | None) -> str:
        inter = len([r for r in obs.refs if r.role.lower() not in ("text", "pane", "group")]) if obs else 0
        self.uma.update(self.avail_mb)
        rd = self.entropy.route(inter, uma_tripped=self.uma.tripped, local_up=self.local_vision_up)
        g = self.gate
        if g.mode == "open" and rd.route == "normal":
            return ""
        return (f"[V12·STATE] mode={g.mode} route={rd.route} U={rd.uncertainty} effect_ratio={rd.effect_ratio} "
                f"banned_ids={sorted(g.banned_ids)} banned_rects={[(int(x), int(y)) for x, y, _ in g.banned_rects]}")

    async def _do(self, layer: int, req: ActionRequest, obs: ObservationEnvelope | None = None) -> tuple[ActionResult, object]:
        act = {"action": req.action, **(req.args or {})}
        if req.target and "id" not in act:
            act["id"] = req.target
        d = self.gate.check(act)
        if not d.allow:                                            # HARD mask: the executor is never reached
            self.history.append(f"{req.action} → {d.code}:{d.reason}")
            self.sm.steps += 1
            self.tracer.add("input", 0.0, "masked", attrs={"reason": d.reason, "mode": d.mode})
            return ActionResult(req.action_id, False, "SELF_DRAWN_ESCAPE", d.message), d
        with self.tracer.span("input" if req.action in CLICK_KINDS or req.action in ("key", "type") else layer_plane(layer), req.action):
            res, v = await super()._do(layer, req, obs)
        eff = bool(getattr(res, "effect_changed", False)) or res.code == "OK" and req.action not in CLICK_KINDS
        self.gate.observe(act, eff)
        self.entropy.record(eff)
        return res, v


def layer_plane(layer: int) -> str:
    return {0: "input", 1: "cdp", 2: "uia", 3: "vision", 4: "vision"}.get(layer, "network")
