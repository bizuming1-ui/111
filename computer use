//! Event-driven settle: SetWinEventHook (foreground / location / name / show / hide / reorder) -> channel.
//! `wait_quiet` replaces fixed `Start-Sleep` polling: it returns as soon as the UI has been silent for `quiet`.
use std::sync::mpsc::{channel, Receiver, Sender};
use std::sync::{Mutex, OnceLock};
use std::time::{Duration, Instant};
use windows::Win32::Foundation::HWND;
use windows::Win32::UI::Accessibility::{SetWinEventHook, UnhookWinEvent, HWINEVENTHOOK};
use windows::Win32::UI::WindowsAndMessaging::{
    DispatchMessageW, GetMessageW, PostThreadMessageW, TranslateMessage, EVENT_OBJECT_HIDE, EVENT_OBJECT_LOCATIONCHANGE, EVENT_OBJECT_NAMECHANGE,
    EVENT_OBJECT_REORDER, EVENT_OBJECT_SHOW, EVENT_SYSTEM_FOREGROUND, MSG, WINEVENT_OUTOFCONTEXT, WM_QUIT,
};

#[derive(Clone, Copy, Debug)]
pub struct UiEvent { pub event: u32, pub hwnd: isize, pub object: i32, pub child: i32 }

static TX: OnceLock<Mutex<Option<Sender<UiEvent>>>> = OnceLock::new();

unsafe extern "system" fn proc_cb(_h: HWINEVENTHOOK, event: u32, hwnd: HWND, object: i32, child: i32, _tid: u32, _time: u32) {
    // Never panic inside a Win32 callback.
    let _ = std::panic::catch_unwind(|| {
        if let Some(m) = TX.get() {
            if let Ok(g) = m.lock() {
                if let Some(tx) = g.as_ref() {
                    let _ = tx.send(UiEvent { event, hwnd: hwnd.0 as isize, object, child });
                }
            }
        }
    });
}

pub struct WinEventPump { thread: Option<std::thread::JoinHandle<()>>, thread_id: u32, pub rx: Receiver<UiEvent> }

impl WinEventPump {
    pub fn start() -> Result<WinEventPump, String> {
        let (tx, rx) = channel();
        *TX.get_or_init(|| Mutex::new(None)).lock().map_err(|_| "poisoned")? = Some(tx);
        let (tid_tx, tid_rx) = channel::<u32>();
        let th = std::thread::spawn(move || unsafe {
            let tid = windows::Win32::System::Threading::GetCurrentThreadId();
            let mut hooks = Vec::new();
            for (lo, hi) in [(EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND), (EVENT_OBJECT_SHOW, EVENT_OBJECT_HIDE), (EVENT_OBJECT_REORDER, EVENT_OBJECT_LOCATIONCHANGE), (EVENT_OBJECT_NAMECHANGE, EVENT_OBJECT_NAMECHANGE)] {
                let h = SetWinEventHook(lo, hi, None, Some(proc_cb), 0, 0, WINEVENT_OUTOFCONTEXT);
                if !h.is_invalid() { hooks.push(h); }
            }
            let _ = tid_tx.send(tid);
            let mut msg = MSG::default();
            while GetMessageW(&mut msg, None, 0, 0).as_bool() {
                let _ = TranslateMessage(&msg);
                DispatchMessageW(&msg);
            }
            for h in hooks { let _ = UnhookWinEvent(h); }
        });
        let thread_id = tid_rx.recv_timeout(Duration::from_secs(2)).map_err(|e| format!("hook thread: {e}"))?;
        Ok(WinEventPump { thread: Some(th), thread_id, rx })
    }

    /// Wait until no UI event arrived for `quiet`, at most `max`. Returns (settled, events_seen, elapsed).
    pub fn wait_quiet(&self, quiet: Duration, max: Duration) -> (bool, usize, Duration) {
        let t0 = Instant::now();
        let mut seen = 0usize;
        loop {
            let left = max.saturating_sub(t0.elapsed());
            if left.is_zero() { return (false, seen, t0.elapsed()); }
            match self.rx.recv_timeout(quiet.min(left)) {
                Ok(_) => seen += 1,
                Err(_) => return (true, seen, t0.elapsed()),
            }
        }
    }
}

impl Drop for WinEventPump {
    fn drop(&mut self) {
        unsafe { let _ = PostThreadMessageW(self.thread_id, WM_QUIT, windows::Win32::Foundation::WPARAM(0), windows::Win32::Foundation::LPARAM(0)); }
        if let Some(t) = self.thread.take() { let _ = t.join(); }
        if let Some(m) = TX.get() { if let Ok(mut g) = m.lock() { *g = None; } }
    }
}
