"""
v16.4 guard layer: the glue between the Orchestrator and WindowManager / MessageSend / TaskBudget.  Everything here is deterministic (no LLM).

  intent_gate        messaging task without explicit recipient AND body  -> terminal `needs_clarification` BEFORE any model call or GUI action
  pre_action         diagnostic budget (Get-Date/Get-Process spam) · text provenance (never type words the user did not say) · send gate (contact frozen -> single chat ->
                     draft read back -> HITL) · keyboard-focus ownership (GetGUIThreadInfo)
  click_xy           coordinate-space + hit-target verification (WindowFromPoint -> GA_ROOT == target) with bounded raise/minimise recovery that ends in a FORCED re-observe
  screenshot_gate    Screenshot Ownership Guard (foreground HWND == target HWND before a frame may reach the vision model)
  post_action        tracks the verified task target (hwnd parsed from focus_window / app_resolve) and the message session evidence
"""
from __future__ import annotations

import os
import re
import time
from collections import Counter
from typing import Any, Optional

from .budget import TaskBudget, diagnostic_kind
from .protocol import ActionResult, Code
from .skills import message_send as ms
from .window_manager import (SHELL_CLASSES, V_OCCLUDED, V_OUTSIDE_TARGET, V_SAME_APP, V_TARGET_GONE, OwnershipReport, WindowManager, build_default)

HWND_RX = re.compile(r"hwnd\s+(\d+)")


class V164:
    def __init__(self, brain: Any, wm: Optional[WindowManager] = None) -> None:
        self.b = brain
        self.wm: Optional[WindowManager] = wm if wm is not None else build_default(brain.say)
        self.budget = TaskBudget()
        self.task_target = 0
        self.counters: Counter = Counter()
        self.coord_log: list[dict[str, Any]] = []
        brain.verifier.wm = self.wm

    # ------------------------------------------------------------------ lifecycle
    def reset_task(self) -> None:
        self.budget.reset()
        self.task_target = 0
        self.coord_log.clear()
        if self.wm:
            self.wm.release_pins()

    def say(self, m: str) -> None:
        self.b.say(m)

    # ------------------------------------------------------------------ 1) intent completeness
    def intent_gate(self, st: Any) -> Optional[tuple]:
        cl = ms.clarify(st.task)
        if cl is None:
            return None
        if cl.status != "ok":
            self.counters["needs_clarification"] += 1
            self.say("── 意图完整性门控（MessageSendGoal 前置条件）──")
            for ln in cl.question.splitlines():
                self.say("  🛑 " + ln)
            self.say(f"  已解析：联系人={cl.request.recipient or '（缺失）'} · 正文={cl.request.body or '（缺失）'} · 模型调用 0 次 · 界面操作 0 次")
            return "needs_clarification", cl.question
        st.msg_session = ms.MessageSession(cl.request)  # type: ignore[attr-defined]
        self.say(f"  🔒 MessageSend 意图完整：联系人=「{cl.request.recipient}」 正文=「{cl.request.body}」（逐字来自用户原文；不得改写/补全；发送前必须冻结联系人+单聊确认+读回草稿+人工确认）")
        return None

    def directive_note(self, st: Any) -> str:
        s = getattr(st, "msg_session", None)
        if s is None:
            return ""
        return (f"· [MessageSend 契约] 联系人必须是「{s.request.recipient}」，正文必须逐字为「{s.request.body}」；禁止输入任何其它文字（尤其不要自行补“你好”）。"
                "发送前系统会读回草稿并请求人工确认。")

    # ------------------------------------------------------------------ 2) pre-action gates
    def _target(self, eh: int = 0) -> int:
        wm = self.wm
        if wm and self.task_target and wm.be.is_window(self.task_target):
            return self.task_target
        return eh

    async def pre_action(self, a: dict[str, Any], b: Any, st: Any) -> Optional[tuple]:
        name = str(a.get("action", ""))
        # (a) diagnostic budget
        deny = self.budget.gate_diagnostic(a)
        if deny:
            self.counters["diag_denied"] += 1
            return Code.SECURITY_DENIED, deny
        if diagnostic_kind(a) is None:
            self.budget.note_non_diag()
        sess: Optional[ms.MessageSession] = getattr(st, "msg_session", None)
        if sess is not None:
            # (b) text provenance
            if name == "type" and not ms.provenance_ok(str(a.get("text", "")), sess.request):
                self.counters["provenance_denied"] += 1
                return Code.SECURITY_DENIED, (f"[TEXT_PROVENANCE] 拒绝输入「{str(a.get('text', ''))[:30]}」：消息任务只允许输入联系人「{sess.request.recipient}」（搜索）或用户给定的正文"
                                              f"「{sess.request.body}」。不得自行补全内容。")
            # (c) send gate
            if ms.is_send_action(a, b.els) or await self._is_wechat_send_click(a, b):
                return await self._send_gate(a, b, st, sess)
        return None

    async def _is_wechat_send_click(self, a: dict[str, Any], b: Any) -> bool:
        """v17.0 log task #13: `click x=1491 y=1347` (the green send button) bypassed is_send_action() -> no send gate, no proofs.  Pixel clicks in the
        bottom-right corner of the WeChat window are send clicks."""
        if str(a.get("action", "")) not in ("click", "double_click") or a.get("id") is not None or "x" not in a or "y" not in a:
            return False
        wm = self.wm
        hwnd = self._target(self.b._target_hwnd(b))
        w = wm.get(hwnd) if (wm and hwnd) else None
        if not w or str(getattr(w, "process", "")).lower() not in ms.WECHAT_PROCS or not w.rect or len(w.rect) != 4:
            return False
        x, y = int(a["x"]), int(a["y"])
        rx, ry, rw, rh = w.rect
        return x >= rx + rw * 0.72 and y >= ry + rh * 0.84 and x <= rx + rw and y <= ry + rh

    async def _send_gate(self, a: dict[str, Any], b: Any, st: Any, sess: ms.MessageSession) -> Optional[tuple]:
        self.counters["send_gate_checks"] += 1
        wm = self.wm
        hwnd = self._target(self.b._target_hwnd(b))
        sess.chat_hwnd = hwnd
        title = ""
        rect = None
        if wm and hwnd:
            w = wm.get(hwnd)
            if w:
                title, rect = w.title, w.rect
        els = None
        try:
            o = await self.b.hub.drv_observe(channel="uia", hwnd=int(hwnd or 0), max_elements=200)
            els = list(o.elements or [])
        except Exception:  # noqa: BLE001
            els = None
        if not els:
            els = list(b.obs.elements or [])
        frozen = sess.freeze_contact(title, els, rect)
        single = sess.confirm_single_chat(title, els) if frozen else False
        draft = sess.readback_draft(els)
        problems = []
        if sess.draft_readback and not sess.draft_ok:
            problems.append(f"草稿读回为「{sess.draft_readback[:40]}」≠ 用户正文「{sess.request.body}」（多余/错误内容）")
        if sess.single_chat_evidence.startswith("检测到群聊"):
            problems.append(sess.single_chat_evidence)
        if problems:
            self.counters["send_gate_denied"] += 1
            return Code.SECURITY_DENIED, "[MSG_GATE] 禁止发送：" + "；".join(problems) + "。请先修正草稿/切换到正确的单聊窗口。"
        lines = [f"  📨 发送前核验 · 联系人冻结={'✓ ' + sess.contact_evidence if frozen else '✗ UIA 无法读到聊天头部'} · 单聊={'✓ ' + sess.single_chat_evidence if single else '✗ 未能程序化确认'}"
                 f" · 草稿读回={'✓ ' + repr(sess.draft_readback[:30]) if draft else '✗ UIA 读不到输入框值'}"]
        human_attest = not (frozen and single and draft)
        q = (f"确认把「{sess.request.body}」发送给「{sess.request.recipient}」？"
             + ("（程序无法完整读回：请你肉眼确认聊天头部是该联系人的单聊、输入框里正好是这段正文）" if human_attest else "") + " [y/N]")
        ok = await self.b._hitl(lines, q)
        if not ok:
            self.counters["send_gate_denied"] += 1
            return Code.SECURITY_DENIED, "[MSG_GATE] 用户未确认发送，已取消（未发送）。"
        sess.hitl_confirmed = True
        if human_attest:
            sess.contact_frozen = sess.contact_frozen or True
            sess.contact_evidence = sess.contact_evidence or "人工在 HITL 中确认（UIA 不可读）"
            sess.single_chat = True
            sess.single_chat_evidence = sess.single_chat_evidence if sess.single_chat_evidence and not sess.single_chat_evidence.startswith("检测到") else "人工在 HITL 中确认单聊"
            if not draft:
                sess.draft_ok, sess.draft_readback, sess.draft_source = True, sess.request.body, "human_visual_hitl"
        return None

    # ------------------------------------------------------------------ 3) pointer / keyboard ownership
    async def click_xy(self, name: str, a: dict[str, Any], b: Any, st: Any, eh: int) -> ActionResult:
        x, y = int(a["x"]), int(a["y"])
        wm = self.wm
        tgt = self._target(eh)
        if wm is None or not tgt:
            self.counters["click_unguarded"] += 1
            return await self.b._drv(name, b, x=x, y=y, expect_hwnd=eh)
        tw = wm.get(tgt)
        if (not self.task_target) and (tw is None or tw.cls in SHELL_CLASSES or tw.own_console):  # desktop / shell / own-console context: nothing meaningful to verify against
            self.counters["click_unguarded"] += 1
            return await self.b._drv(name, b, x=x, y=y, expect_hwnd=eh)
        rep = wm.prepare_click(tgt, x, y)
        rec = {"t": round(time.time(), 3), "model_xy": [x, y], "phys_xy": [x, y], "target": tgt, "verdict": rep.verdict, "hit_root": rep.hit_root, "target_rect": list(rep.target_rect), "actions": rep.actions}
        self.coord_log.append(rec)
        w_hit = wm.get(rep.hit_root) if rep.hit_root else None
        if rep.verdict == V_OUTSIDE_TARGET and w_hit and w_hit.cls not in SHELL_CLASSES and not w_hit.own_console and wm.root_of(wm.be.foreground()) == rep.hit_root:
            self.say(f"  🎯 目标窗口切换：点 ({x},{y}) 落在前台的另一个应用 {w_hit.label()}，视为用户/智能体已主动切换 → 以它为新目标")
            self.task_target = tgt = rep.hit_root
            rep = wm.prepare_click(tgt, x, y)
            rec["verdict"] = rep.verdict
        if rep.verdict == V_OUTSIDE_TARGET and w_hit and w_hit.cls in ("Shell_TrayWnd", "Shell_SecondaryTrayWnd"):  # taskbar clicks are a legitimate recovery step (loop-detector advice)
            self.counters["click_taskbar"] += 1
            self.say(f"  📐 点击坐标 ({x},{y}) 命中任务栏（合法的窗口切换手段），不按目标窗口拦截")
            return await self.b._drv(name, b, x=x, y=y, expect_hwnd=0)
        if rep.ok and not rep.needs_reobserve:
            self.counters["click_verified"] += 1
            tag = "同进程辅助窗" if rep.verdict == V_SAME_APP else "目标窗口"
            self.say(f"  📐 点击坐标[物理像素 DPI-aware] ({x},{y}) → 命中 {tag} hwnd={rep.hit_root or tgt} ✓（与下发给驱动的坐标完全一致）")
            return await self.b._drv(name, b, x=x, y=y, expect_hwnd=rep.adopt_hwnd or tgt)
        self._arm_fresh_vision()
        if rep.verdict == V_TARGET_GONE:
            return ActionResult(ok=False, code=Code.NOT_FOUND, message="[TARGET_GONE] 目标窗口已不存在；请重新 focus_window/app_resolve。")
        if rep.verdict == V_OUTSIDE_TARGET:
            self.counters["coord_outside_target"] += 1
            hint = ""
            if rep.remap:
                hint = f"（若你给的是窗口内相对坐标，对应屏幕点是 ({rep.remap[0]},{rep.remap[1]})，已验证它命中目标窗口；请显式点击该点，系统不会替你猜。）"
            if rep.remap and os.environ.get("DSCU_COORD_REMAP", "0") == "1":  # opt-in only: auto-clicking a guessed reading of the coordinates can hit the wrong control
                rx, ry, rule = rep.remap
                self.counters["coord_remapped"] += 1
                rec["remap"] = [rx, ry, rule]
                self.say(f"  📐 坐标空间修复（{rule}）：({x},{y}) 不在目标窗口 {tuple(rep.target_rect)} 内 → ({rx},{ry})，已用 WindowFromPoint 验证命中目标")
                return await self.b._drv(name, b, x=rx, y=ry, expect_hwnd=tgt)
            return ActionResult(ok=False, code=Code.NOT_FOUND, message=(f"[COORD_OUTSIDE_TARGET] 点击被拦截（未下发）：{rep.detail}。下一帧会强制提供带坐标网格的最新截图；"
                                                                        f"请只在目标窗口矩形 x∈[{rep.target_rect[0]},{rep.target_rect[0] + rep.target_rect[2]}) y∈[{rep.target_rect[1]},{rep.target_rect[1] + rep.target_rect[3]}) 内取点，"
                                                                        "或改用控件 id / 键盘。最小化或置顶无法解决坐标错位。" + hint))
        if rep.ok and rep.needs_reobserve:
            return ActionResult(ok=False, code=Code.STALE_EPOCH, message=(f"[REOBSERVE] {rep.detail}。本次点击未下发；系统将重新采集 UIA 并强制截图，请基于最新观察重新定位后再点击。"))
        self.counters["occlusion_unrecovered"] += 1
        return ActionResult(ok=False, code=Code.FOREGROUND_FAILED, message=(f"[OCCLUDED_AFTER_RECOVERY] {rep.detail}。遮挡窗 hwnd={rep.occluder_hwnd}；请用 minimize_window/任务栏处理或改用键盘，"
                                                                              "然后重新观察（禁止原地盲点）。"))

    def _arm_fresh_vision(self) -> None:
        try:
            self.b.perception._force_vision_next_turn = True
        except Exception:  # noqa: BLE001
            pass

    def focus_gate(self, a: dict[str, Any], b: Any) -> Optional[ActionResult]:
        """Keyboard actions on the NATIVE route: the real keyboard focus (GetGUIThreadInfo) must belong to the target window."""
        wm = self.wm
        name = str(a.get("action", ""))
        if wm is None or name not in ("type", "key") or self.b._cdp_route(b):
            return None
        tgt = self._target(self.b._target_hwnd(b))
        if not tgt:
            return None
        keys = str(a.get("keys", "")).lower()
        if name == "key" and keys in ("win", "win+d", "win+e"):
            return None
        r = wm.verify_input_focus(tgt)
        if r.ok:
            self.counters["focus_verified"] += 1
            return None
        if r.reason.startswith("目标线程没有键盘焦点") or r.reason.startswith("键盘焦点"):
            # soft path: foreground ownership is verified, the app just does not expose a child focus window (Qt/Electron single-HWND UIs)
            if wm.root_of(wm.be.foreground()) == tgt:
                self.counters["focus_soft_pass"] += 1
                return None
        if wm.be.raise_window(tgt):
            r2 = wm.verify_input_focus(tgt)
            if r2.ok or wm.root_of(wm.be.foreground()) == tgt:
                self.counters["focus_restored"] += 1
                return None
        self.counters["focus_denied"] += 1
        return ActionResult(ok=False, code=Code.FOREGROUND_FAILED, message=f"[FOCUS_NOT_OWNED] 键盘输入被拦截（未发送按键）：{r.reason}。请先 focus_window 并点击目标输入框。")

    # ------------------------------------------------------------------ 4) screenshot ownership
    def screenshot_gate(self) -> Optional[OwnershipReport]:
        wm = self.wm
        if wm is None or not self.task_target or not wm.be.is_window(self.task_target):
            return None
        rep = wm.screenshot_ownership(self.task_target, restore=True)
        if rep.ok:
            if rep.restored:
                self.counters["shot_restored"] += 1
            return rep
        self.counters["shot_blocked"] += 1
        return rep

    # ------------------------------------------------------------------ 5) post action
    def post_action(self, a: dict[str, Any], res: ActionResult, b: Any, st: Any) -> None:
        name = str(a.get("action", ""))
        if res.ok and name in ("focus_window", "app_resolve", "restore_window"):
            m = HWND_RX.search(res.message or "")
            if m:
                self.task_target = int(m.group(1))
        sess = getattr(st, "msg_session", None)
        if sess is not None and res.ok and ms.is_send_action(a, b.els) and sess.hitl_confirmed:
            sess.send_issued = True
            sess.send_step = int(getattr(st, "step", -1))

    # ------------------------------------------------------------------ reporting
    def summary_lines(self) -> list[str]:
        c = self.counters
        out = []
        if self.wm:
            out.append("  v16.4：" + self.wm.summary())
        else:
            out.append("  v16.4：WindowManager 不可用（非 Windows / Win32 初始化失败）→ 点击/截图归属核验降级为 v16.3 行为")
        out.append(f"  v16.4：点击核验通过 {c['click_verified']} · 坐标越界拦截 {c['coord_outside_target']}（重映射 {c['coord_remapped']}）· 遮挡未恢复 {c['occlusion_unrecovered']} · 未受保护点击 {c['click_unguarded']}"
                   f" · 焦点核验 通过 {c['focus_verified']}/软通过 {c['focus_soft_pass']}/恢复 {c['focus_restored']}/拒绝 {c['focus_denied']} · 截图归属 拦截 {c['shot_blocked']}/恢复 {c['shot_restored']}")
        out.append(f"  v16.4：意图门控 需澄清 {c['needs_clarification']} · 文本来源拒绝 {c['provenance_denied']} · 发送门控 检查 {c['send_gate_checks']}/拒绝 {c['send_gate_denied']} · 诊断命令拒绝 {c['diag_denied']}")
        out.append("  " + self.budget.summary())
        return out
