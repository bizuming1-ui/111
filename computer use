@dataclass
class Budget:
    soft_ms: float = 250.0      # over this => recorded as a 'slow op' with its cause
    hard_ms: float = 900.0      # over this => the call is abandoned (asyncio.wait_for) and the alternate path is used
    settle_ms: float = 450.0    # max wait for the UI to settle after an input
    move_ms_max: float = 120.0
    focus_ms: float = 600.0


# ------------------------------------------------------------------------------------------------------------------------ telemetry
class Telemetry:
    def __init__(self) -> None:
        self.samples: dict = {}
        self.tail: list = []
        self.counters = {"ops": 0, "slow": 0, "hard_timeouts": 0, "refocus": 0, "ime_neutralised": 0, "paste_path": 0, "type_path": 0, "readback_fail": 0, "alt_used": 0, "hit_reject": 0}

    def record(self, op: str, ms: float, ok: bool = True, cause: str = "") -> None:
        self.samples.setdefault(op, []).append(ms)
        self.counters["ops"] += 1
        if cause:
            self.tail.append({"op": op, "ms": round(ms, 1), "ok": ok, "cause": cause})
            self.tail = self.tail[-50:]

    @staticmethod
    def pct(vals: list, p: float) -> float:
        if not vals:
            return 0.0
        v = sorted(vals)
        k = max(0, min(len(v) - 1, int(math.ceil(p / 100.0 * len(v))) - 1))
        return round(v[k], 2)

    def summary(self) -> dict:
        allv = [x for v in self.samples.values() for x in v]
        out = {"all": {"n": len(allv), "p50": self.pct(allv, 50), "p95": self.pct(allv, 95), "p99": self.pct(allv, 99), "max": round(max(allv), 1) if allv else 0.0}}
        for op, v in self.samples.items():
            out[op] = {"n": len(v), "p50": self.pct(v, 50), "p95": self.pct(v, 95), "p99": self.pct(v, 99)}
        out["counters"] = dict(self.counters)
        out["tail_causes"] = self.tail[-5:]
        return out


# ------------------------------------------------------------------------------------------------------------------------ trajectory
def min_jerk_path(p0: tuple, p1: tuple, total_ms: float, steps: Optional[int] = None, seed: int = 18) -> list:
    """-> [(x, y, dt_ms)].  Minimum-jerk speed profile s(t)=10t³−15t⁴+6t⁵ on a slightly curved (deterministic, seeded) path; the last point is EXACTLY p1."""
    x0, y0 = p0
    x1, y1 = p1
    dist = math.hypot(x1 - x0, y1 - y0)
    n = steps or int(max(3, min(14, dist / 40.0 + 2)))
    if dist < 2.0:
        return [(x1, y1, 0.0)]
    nx, ny = -(y1 - y0) / dist, (x1 - x0) / dist
    bend = ((seed * 2654435761) % 1000 / 1000.0 - 0.5) * min(30.0, dist * 0.06)
    pts = []
    prev_s = 0.0
    for i in range(1, n + 1):
        t = i / n
        s = 10 * t ** 3 - 15 * t ** 4 + 6 * t ** 5
        off = bend * math.sin(math.pi * s)
        px, py = x0 + (x1 - x0) * s + nx * off, y0 + (y1 - y0) * s + ny * off
        dt = total_ms * (s - prev_s) if i > 1 else total_ms * s
        prev_s = s
        pts.append((int(round(px)), int(round(py)), max(0.0, dt)))
    pts[-1] = (int(x1), int(y1), pts[-1][2])
    return pts


