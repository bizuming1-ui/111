  for (int i = 0; i < N; ++i) (void)framediff(a.data(), b.data(), W, H, S, 64);
  double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count() / N;
  std::printf("vision-engine framediff 1080p: %.3f ms/frame (AVX2=%d) dirty=[%d,%d,%d,%d] tiles=%u\n", ms, (int)cpu_has_avx2(), s.dirty.x0, s.dirty.y0, s.dirty.x1, s.dirty.y1, s.dirty_tiles);
