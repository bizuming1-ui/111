    ap.add_argument("--seed", type=int, default=1620)
    args = ap.parse_args(argv)
    rep = run_all(args)
    out = Path(args.out) if args.out else ROOT / "eval_runs" / f"phase0_1_{time.strftime('%Y%m%d_%H%M%S')}" / "audit_report.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(rep, ensure_ascii=False, indent=2), encoding="utf-8")
    print("═" * 78)
    print(f" DSCU v16.2 · Phase 0/1 验收  —  {'✅ PASS' if rep['pass'] else '❌ FAIL'}   ({rep['duration_s']}s)")
    for k, v in rep["suites"].items():
        print(f"  {'✓' if v['failed'] == 0 else '✗'} {k:<20} {v['passed']}/{v['total']}")
    print("─ 指标 " + "─" * 70)
    for k, v in rep["metrics"].items():
        print(f"  {k:<40} {v}")
    print("─ 验收门槛 " + "─" * 66)
    for k, v in rep["acceptance_gates"].items():
        print(f"  {'✓' if v else '✗'} {k}")
    for k, v in rep["suites"].items():
        for c in v["cases"]:
            if not c["pass"]:
                print(f"  ✗ [{k}] {c['case']} — {c['detail']}")
    print(f"  JSON 审计报告: {out}\n  report_sha256: {rep['report_sha256']}")
    print("═" * 78)
    return 0 if rep["pass"] else 1


if __name__ == "__main__":
    sys.exit(main())
