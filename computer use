    const m = tab.refs.get(tab.epoch);
    const hits = [...(m?.values() ?? [])].filter((e) => e.stable_key === target.stable_key);
    if (hits.length === 0) throw new PErr("NOT_FOUND", "stable_key not in latest snapshot");
    if (hits.length > 1) throw new PErr("AMBIGUOUS_TARGET", `stable_key matches ${hits.length} nodes`);
    return hits[0].backendNodeId;
