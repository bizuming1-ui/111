def step(st, obs, action, res=None, expect="fg=微信"):
    st.step += 1
    st.settle_last(obs)
    res = res or ActionResult(ok=True, code=Code.OK, message="已切换到窗口")
    st.record(st.step, action, expect, obs, res, {})


class TestLoopRecovery(unittest.TestCase):
    def test_log_regression_focus_window_loop_escalates_within_8_steps(self):
        """v12 burned 60 steps. v13 must mask by step 4, force vision+remedy by step ~6 and hand over to a human by step ~8."""
        st, lad, obs = TaskState("打开微信，找到联系人老虎不抓鼠，给他发一条信息"), RecoveryLadder(), mk_obs()
        levels, escalated_at = [], None
        for i in range(1, 12):
            d = lad.evaluate(st, obs)
            levels.append(d.level)
            if d.escalate_human:
                escalated_at = i
                break
            step(st, obs, {"action": "focus_window", "title": "微信"})
        self.assertIsNotNone(escalated_at, "loop never escalated")
        self.assertLessEqual(escalated_at, 9)
        self.assertTrue(any("focus_window" in k for k in st.loop_hits))

    def test_mask_blocks_repeat_then_expires(self):
        st, lad, obs = TaskState("x"), RecoveryLadder(), mk_obs()
        for _ in range(4):
            lad.evaluate(st, obs)
            step(st, obs, {"action": "focus_window", "title": "微信"})
        d = lad.evaluate(st, obs)
        self.assertIn("focus_window", d.masked | set(st.masks))
        gate = ActionGate.check({"action": "focus_window", "title": "微信"}, obs, st, {})
