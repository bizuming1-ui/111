    if sys.platform == "win32":
        from ctypes import wintypes

        class GUID(ctypes.Structure):
            _fields_ = [("a", wintypes.DWORD), ("b", wintypes.WORD), ("c", wintypes.WORD), ("d", ctypes.c_ubyte * 8)]

        g = GUID()
        ctypes.oledll.ole32.CLSIDFromString(KNOWN[kind], ctypes.byref(g))  # type: ignore[attr-defined]
        p = ctypes.c_wchar_p()
        if ctypes.windll.shell32.SHGetKnownFolderPath(ctypes.byref(g), 0, None, ctypes.byref(p)) == 0:  # type: ignore[attr-defined]
            out = Path(p.value or "")
            ctypes.windll.ole32.CoTaskMemFree(p)  # type: ignore[attr-defined]
            return out
    return Path.home() / kind


def safe_name(name: str, default_ext: str = ".txt") -> str:
    n = name.strip().strip('"“”')
    if not n or re.search(r'[<>:"/\\|?*\x00-\x1f]', n) or n.endswith((" ", ".")) or n.split(".")[0].lower() in RESERVED or ".." in n:
        raise PathDenied(f"illegal file name: {name!r}")
    return n if "." in n else n + default_ext


def granted_folder(task: str, folder_word: str | None = None) -> tuple[str, Path] | None:
    word = (folder_word or "").strip().lower()
    for k, v in FOLDERS.items():
        if (word and k == word) or (not word and k in task.lower()):
            return v, known_folder(v)
    return None


@dataclass
class SaveIntent:
    text: str
    name: str
    folder_word: str
    open_notepad: bool


def parse_save_intent(task: str) -> SaveIntent | None:
    """e.g. "打开一个记事本，输入今晚能不能做到，命名为bzm，保存在桌面" (log task #1)."""
    m_text = re.search(r"(?:输入|写入|写上|内容(?:是|为)?)\s*[:：]?\s*(.+?)(?:[，,。；;]\s*(?:并)?(?:命名|取名|文件名|保存|存到|存在|另存)|$)", task)
    m_name = re.search(r"(?:命名为|取名为|文件名(?:为|是)?|名为|叫做?)\s*[“\"]?([^\s，,。；;“”\"]+)", task)
    m_dir = re.search(r"(?:保存|存|放)(?:在|到|于)\s*(桌面|文档|下载|desktop|documents|downloads)", task, re.I)
    if not (m_text and m_name and m_dir):
        return None
    return SaveIntent(m_text.group(1).strip(), m_name.group(1), m_dir.group(1), bool(re.search(r"记事本|notepad", task, re.I)))


def save_text(folder_word: str, name: str, text: str, task: str) -> dict:
    g = granted_folder(task, folder_word)
    if not g:
        raise PathDenied(f"folder '{folder_word}' is not authorised by the task text")
    kind, root = g
    target = (root / safe_name(name)).resolve()
    if root.resolve() not in target.parents:
        raise PathDenied("path escapes the authorised folder")
    data = text.encode("utf-8")
    root.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
    back = target.read_bytes()
    ok = back == data
    return {"ok": ok, "path": str(target), "bytes": len(data), "chars": len(text), "authorised": kind, "readback_equal": ok}


def file_stat(path: str, expect_text: str | None = None) -> dict:
    p = Path(os.path.expandvars(path)).expanduser()
    if not p.exists():
        return {"exists": False, "path": str(p)}
    out = {"exists": True, "path": str(p), "bytes": p.stat().st_size, "mtime": p.stat().st_mtime}
    if expect_text is not None and p.is_file():
        raw = p.read_bytes()
        out["bom"] = raw.startswith(b"\xef\xbb\xbf")
        for enc in ("utf-8-sig", "utf-16", "gbk"):
            try:
                out["contains_expected"] = expect_text in raw.decode(enc)
                out["encoding"] = enc
                break
            except UnicodeError:
                continue
    return out
