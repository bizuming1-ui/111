//! C ABI for in-process, zero-pipe use (Python ctypes / C / C++ / .NET P/Invoke).
//!   int   dscu_init(const char* config_json);   // 0 ok, 1 already initialised, <0 error
//!   char* dscu_call_json(const char* request);  // returns a heap NDJSON-contract response; free with dscu_free
//!   void  dscu_free(char* p);
//!   const char* dscu_version(void);
//!   void  dscu_shutdown(void);
//! The request/response objects are exactly the dscu-driver-v1 envelopes (same engine, same guarantees).
use dscu_core::{Engine, EngineConfig, Platform};
use std::ffi::{c_char, CStr, CString};
use std::panic::catch_unwind;
use std::sync::{Arc, OnceLock};

static ENGINE: OnceLock<Engine> = OnceLock::new();
static VERSION_C: &[u8] = concat!(env!("CARGO_PKG_VERSION"), "\0").as_bytes();

fn platform(mock: bool, no_dxgi: bool, no_jab: bool) -> Arc<dyn Platform> {
    #[cfg(windows)]
    if !mock {
        dscu_win32::init_process();
        return Arc::new(dscu_win32::WinPlatform::new(dscu_win32::WinConfig { no_dxgi, no_jab, ..Default::default() }));
    }
    let _ = (no_dxgi, no_jab, mock);
    Arc::new(dscu_core::mock::MockPlatform::new())
}

const E_NOT_INIT: &str = r#"{"jsonrpc":"2.0","v":1,"id":null,"error":{"code":5000,"message":"INTERNAL: dscu_init not called","data":{"kind":"INTERNAL"}}}"#;
const E_NULL: &str = r#"{"jsonrpc":"2.0","v":1,"id":null,"error":{"code":-32600,"message":"INVALID_REQUEST: null request","data":{"kind":"INVALID_REQUEST"}}}"#;
const E_UTF8: &str = r#"{"jsonrpc":"2.0","v":1,"id":null,"error":{"code":-32700,"message":"PARSE_ERROR: request is not UTF-8","data":{"kind":"PARSE_ERROR"}}}"#;
const E_PANIC: &str = r#"{"jsonrpc":"2.0","v":1,"id":null,"error":{"code":5000,"message":"INTERNAL: panic","data":{"kind":"INTERNAL"}}}"#;

/// # Safety
/// `config_json` must be NULL or a valid NUL-terminated UTF-8 string.
#[no_mangle]
pub unsafe extern "C" fn dscu_init(config_json: *const c_char) -> i32 {
    let cfg_str: Option<String> = if config_json.is_null() { None } else { CStr::from_ptr(config_json).to_str().ok().map(String::from) };
    if !config_json.is_null() && cfg_str.is_none() {
        return -1;
    }
    catch_unwind(move || {
        if ENGINE.get().is_some() {
            return 1;
        }
        let cfg: serde_json::Value = match cfg_str {
            None => serde_json::json!({}),
            Some(s) => match serde_json::from_str(&s) {
                Ok(v) => v,
                Err(_) => return -1,
            },
        };
        let b = |k: &str| cfg.get(k).and_then(|v| v.as_bool()).unwrap_or(false);
        let mut ec = EngineConfig { token: cfg.get("token").and_then(|v| v.as_str()).map(String::from), mock_debug: b("mock"), ..Default::default() };
        if let Some(m) = cfg.get("memory_floor_mb").and_then(|v| v.as_u64()) {
            ec.memory_floor_mb = m;
        }
        if let Some(w) = cfg.get("workspace_root").and_then(|v| v.as_str()) {
            ec.workspace_root = Some(w.to_string());
        }
        let e = Engine::new(platform(b("mock"), b("no_dxgi"), b("no_jab")), ec);
        if ENGINE.set(e).is_ok() { 0 } else { 1 }
    })
    .unwrap_or(-2)
}

/// # Safety
/// `request` must be a valid NUL-terminated UTF-8 string. The returned pointer must be released with `dscu_free`.
#[no_mangle]
pub unsafe extern "C" fn dscu_call_json(request: *const c_char) -> *mut c_char {
    let req: Result<Option<String>, ()> = if request.is_null() { Ok(None) } else { CStr::from_ptr(request).to_str().map(|s| Some(s.to_string())).map_err(|_| ()) };
    let r = catch_unwind(move || {
        let Some(e) = ENGINE.get() else { return E_NOT_INIT.to_string() };
        match req {
            Ok(Some(s)) => e.handle_line(&s),
            Ok(None) => E_NULL.to_string(),
            Err(_) => E_UTF8.to_string(),
        }
    })
    .unwrap_or_else(|_| E_PANIC.to_string());
    CString::new(r).map(|c| c.into_raw()).unwrap_or(std::ptr::null_mut())
}

/// # Safety
/// `p` must come from `dscu_call_json` (or be NULL) and must not be used afterwards.
#[no_mangle]
pub unsafe extern "C" fn dscu_free(p: *mut c_char) {
    if !p.is_null() {
        drop(CString::from_raw(p));
    }
}

#[no_mangle]
pub extern "C" fn dscu_version() -> *const c_char {
    VERSION_C.as_ptr() as *const c_char
}

#[no_mangle]
pub extern "C" fn dscu_shutdown() {
    if let Some(e) = ENGINE.get() {
        e.shutdown.store(true, std::sync::atomic::Ordering::SeqCst);
        e.platform_shutdown();
    }
}
