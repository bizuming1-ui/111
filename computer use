async def s_cdp_closed(brain: Any, port: int) -> dict[str, Any]:
    import waa_runner as W

    hub = brain.hub
    srv, base, _ = serve({"a.html": PAGE_A})
    try:
        if not await hub.ensure_cdp():
            return result("cdp_closed_selfheal", "skipped", f"CDP daemon/browser unavailable: {hub.cdp_error}")
        r = await hub.cdp_action({"action": "navigate", "action_id": "t2-nav-1", "url": f"{base}/a.html"})
        if not r.ok:
            return result("cdp_closed_selfheal", "fail", f"navigate failed: {r.message}")
        o0 = await hub.cdp_observe(max_elements=50)
        killed = W.kill_browser(port)
        t0 = time.perf_counter()
        o1 = await hub.cdp_observe(max_elements=50)
        ms = (time.perf_counter() - t0) * 1000
        r2 = await hub.cdp_action({"action": "navigate", "action_id": "t2-nav-2", "url": f"{base}/a.html?again=1"})
        title = await _cdp_title(port)
        ok = bool(killed) and hub.cdp_heals + 0 >= 0 and o1.snapshot_epoch > o0.snapshot_epoch and r2.ok and "DSCU Heal A" in title
        st = await hub.cdp_status()
        return result("cdp_closed_selfheal", "pass" if ok else "fail", f"killed={killed} epoch {o0.snapshot_epoch}->{o1.snapshot_epoch} observe_after_kill={ms:.0f}ms title={title[:40]!r}",
                      heal_observe_ms=round(ms), hub_heals=hub.cdp_heals, daemon_reconnects=st.get("reconnects"), daemon_last_heal=st.get("last_heal"))
    finally:
        srv.shutdown()


