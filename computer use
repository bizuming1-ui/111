Policy = Callable[[dict], Awaitable[dict]]


def deepseek_policy(client: DeepSeekClient) -> Policy:
    async def decide(ctx: dict) -> dict:
        stable = f"任务：{ctx['task']}\n" + "\n".join(ctx["history"][-12:])
        dyn = f"[epoch {ctx['obs'].snapshot_epoch}] {ctx['obs'].window_title}\n{ctx['obs'].text}\n{ctx['note']}"
        raw = await client.chat(build_messages(SYSTEM_PROMPT, stable, dyn))
