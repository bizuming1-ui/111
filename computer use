@dataclass
class ProbeResult:
    verdict: str  # applied | not_applied | partial | unknown
    detail: str = ""
    applied: list[str] = field(default_factory=list)
    remaining: list[str] = field(default_factory=list)


Probe = Callable[[WalRecord], ProbeResult]


def probe_file_absent(rec: WalRecord) -> ProbeResult:
    paths = [str(p) for p in (rec.probe.get("paths") or rec.targets)]
    if not paths:
        return ProbeResult(UNKNOWN, "no paths recorded")
    gone = [p for p in paths if not Path(p).exists()]
    left = [p for p in paths if Path(p).exists()]
    if not left:
        return ProbeResult(APPLIED, f"all {len(gone)} path(s) no longer exist", gone, [])
    if not gone:
        return ProbeResult(NOT_APPLIED, f"all {len(left)} path(s) still exist", [], left)
    return ProbeResult(PARTIAL, f"{len(gone)} gone / {len(left)} still exist", gone, left)


def make_gmail_probe(skill: Any) -> Probe:
    def probe(rec: WalRecord) -> ProbeResult:
        ids = list(rec.targets)
        if not ids or skill is None or not skill.available():
            return ProbeResult(UNKNOWN, "Gmail API unavailable or no ids recorded")
        try:
            lab = skill.verify_labels(ids, required_label="TRASH")
        except Exception as e:  # noqa: BLE001
            return ProbeResult(UNKNOWN, f"oracle error: {str(e)[:120]}")
        ok = [i for i in ids if lab.get(i) is True]
        miss = [i for i in ids if lab.get(i) is False]
        unk = [i for i in ids if lab.get(i) is None]
        if unk:
            return ProbeResult(UNKNOWN, f"{len(unk)} id(s) could not be read", ok, miss + unk)
        if not miss:
            return ProbeResult(APPLIED, f"all {len(ok)} message(s) carry TRASH", ok, [])
        if not ok:
            return ProbeResult(NOT_APPLIED, f"none of {len(miss)} message(s) carries TRASH", [], miss)
        return ProbeResult(PARTIAL, f"{len(ok)} trashed / {len(miss)} not", ok, miss)

    return probe


def probe_recycle_empty(rec: WalRecord) -> ProbeResult:
    try:
        from . import safe_shell

        st = safe_shell.recycle_bin_status()
    except Exception as e:  # noqa: BLE001
        return ProbeResult(UNKNOWN, f"recycle probe failed: {str(e)[:100]}")
    if not st.get("ok") or not st.get("consistent", True):
        return ProbeResult(UNKNOWN, f"recycle bin unreadable/inconsistent: {st.get('reason')}")
    before = int(rec.meta.get("count_before", -1))
    if st.get("count") == 0:
        return ProbeResult(APPLIED, "recycle bin reports 0 items (SHQueryRecycleBinW + NameSpace(10))")
    if before >= 0 and st.get("count") == before:
        return ProbeResult(NOT_APPLIED, f"recycle bin still holds {before} item(s)")
    return ProbeResult(UNKNOWN, f"recycle bin count={st.get('count')} (before={before}) — cannot attribute")


DEFAULT_PROBES: dict[str, Probe] = {"file_absent": probe_file_absent, "recycle_empty": probe_recycle_empty}


@dataclass
class RecoveryDecision:
    txid: str
    kind: str
    prior_phase: str
    action: str  # mark_committed | resume_allowed | paused_for_user | mark_failed
    probe: ProbeResult
    record: WalRecord
    detail: str = ""

    def as_dict(self) -> dict[str, Any]:
        return {"txid": self.txid, "kind": self.kind, "prior_phase": self.prior_phase, "action": self.action, "probe": self.probe.verdict,
                "detail": self.detail or self.probe.detail, "remaining": self.probe.remaining[:20]}


def recover(wal: WriteAheadLog, probes: dict[str, Probe] | None = None, say: Callable[[str], None] | None = None) -> list[RecoveryDecision]:
    """Scan the WAL for unresolved transactions and settle each against the external oracle.  Side effects are NEVER replayed here —
    `resume_allowed` only reports that the oracle proved the action did not happen; the caller replays after a fresh human confirmation."""
    say = say or (lambda m: None)
    table = {**DEFAULT_PROBES, **(probes or {})}
    out: list[RecoveryDecision] = []
    lat = wal.latest()
    for rec in lat.values():
        if rec.phase == "confirmed":  # the side effect never began (started is fsync'ed first) -> nothing happened
            wal.append(WalRecord(rec.txid, int(time.time() * 1e6), "failed", rec.kind, rec.task, rec.targets, rec.probe, rec.meta, "crash-recovery: confirmed but never started (no side effect)"))
            out.append(RecoveryDecision(rec.txid, rec.kind, rec.phase, "mark_failed", ProbeResult(NOT_APPLIED, "never started"), rec, "confirmed→never started"))
            continue
        if rec.phase not in PENDING:
            continue
        ptype = str(rec.probe.get("type") or ("file_absent" if rec.kind == "file_recycle" else "recycle_empty" if rec.kind == "recycle_empty" else "gmail_labels" if rec.kind == "gmail_trash" else "none"))
        fn = table.get(ptype)
        pr = fn(rec) if fn else ProbeResult(UNKNOWN, f"no external oracle for kind={rec.kind}/{ptype}")
        base = dict(txid=rec.txid, seq=int(time.time() * 1e6), kind=rec.kind, task=rec.task, targets=rec.targets, probe=rec.probe, meta=rec.meta)
        if pr.verdict == APPLIED:
            wal.append(WalRecord(phase="committed", note="crash-recovery: external oracle proves the action took effect (not replayed) — " + pr.detail, **base))
            out.append(RecoveryDecision(rec.txid, rec.kind, rec.phase, "mark_committed", pr, rec))
        elif pr.verdict in (NOT_APPLIED, PARTIAL):
            wal.append(WalRecord(phase="failed", note="crash-recovery: oracle proves NOT applied for " + (",".join(pr.remaining)[:120] or "all targets") + " — resume requires fresh confirmation", **base))
            out.append(RecoveryDecision(rec.txid, rec.kind, rec.phase, "resume_allowed", pr, rec))
        else:
            wal.append(WalRecord(phase="paused_for_user", note="crash-recovery: external state unknown — human adjudication required — " + pr.detail, **base))
            out.append(RecoveryDecision(rec.txid, rec.kind, rec.phase, "paused_for_user", pr, rec))
        say(f"  🛟 WAL 崩溃恢复 {rec.txid} [{rec.kind}] {rec.phase} → {out[-1].action}（外部核验：{pr.verdict}；{pr.detail[:80]}）")
    return out


def adjudicate(wal: WriteAheadLog, txid: str, outcome: str, note: str = "human") -> bool:
    """Human decision for a paused_for_user transaction: outcome = committed | failed."""
    rec = wal.latest().get(txid)
    if rec is None or rec.phase != "paused_for_user" or outcome not in ("committed", "failed"):
        return False
    wal.append(WalRecord(txid=txid, seq=int(time.time() * 1e6), phase=outcome, kind=rec.kind, task=rec.task, targets=rec.targets, probe=rec.probe, meta=rec.meta, note=f"adjudicated by {note}"))
    return True
