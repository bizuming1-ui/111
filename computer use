# ======================================================================================================================= DPAPI token store
class DpapiProtector:
    """Windows DPAPI via ctypes (CryptProtectData / CryptUnprotectData, CRYPTPROTECT_UI_FORBIDDEN, per-user scope + app entropy)."""

    name = "windows-dpapi"

    def __init__(self, entropy: bytes = DPAPI_ENTROPY) -> None:
        self.entropy = entropy

    @staticmethod
    def available() -> bool:
        return sys.platform == "win32"

    def _call(self, data: bytes, protect: bool) -> bytes:
        if not self.available():
            raise TokenProtectionUnavailable("Windows DPAPI 仅在 Windows 上可用；拒绝以明文保存 OAuth Token")
        import ctypes
        from ctypes import wintypes

        class DATA_BLOB(ctypes.Structure):
            _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_char))]

        crypt32 = ctypes.WinDLL("crypt32", use_last_error=True)
        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        fn = crypt32.CryptProtectData if protect else crypt32.CryptUnprotectData
        fn.restype = wintypes.BOOL
        fn.argtypes = [ctypes.POINTER(DATA_BLOB), wintypes.LPCWSTR if protect else ctypes.c_void_p, ctypes.POINTER(DATA_BLOB), ctypes.c_void_p, ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(DATA_BLOB)]
        kernel32.LocalFree.argtypes = [ctypes.c_void_p]
        kernel32.LocalFree.restype = ctypes.c_void_p

        def blob(b: bytes) -> tuple[DATA_BLOB, Any]:
            buf = ctypes.create_string_buffer(b, len(b))
            return DATA_BLOB(len(b), ctypes.cast(buf, ctypes.POINTER(ctypes.c_char))), buf

        inb, _k1 = blob(data)
        ent, _k2 = blob(self.entropy)
        out = DATA_BLOB()
        ok = fn(ctypes.byref(inb), "DSCU Gmail OAuth token" if protect else None, ctypes.byref(ent), None, None, 0x1, ctypes.byref(out))
        if not ok:
            raise TokenProtectionUnavailable(f"DPAPI {'CryptProtectData' if protect else 'CryptUnprotectData'} 失败（WinError {ctypes.get_last_error()}）：该文件只能由加密它的 Windows 用户解密")
        try:
            return ctypes.string_at(out.pbData, out.cbData)
        finally:
            kernel32.LocalFree(ctypes.cast(out.pbData, ctypes.c_void_p))

    def protect(self, data: bytes) -> bytes:
        return self._call(data, True)

    def unprotect(self, blob: bytes) -> bytes:
        return self._call(blob, False)


def default_token_path() -> Path:
    if os.environ.get("DSCU_GMAIL_TOKEN"):
        return Path(os.environ["DSCU_GMAIL_TOKEN"])
    base = os.environ.get("LOCALAPPDATA") or str(Path.home() / ".local" / "share")
