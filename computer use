        "selftest" => println!("{}", st.handle(&json!({"cmd": "ping"}))),
        "serve" => { if let Err(e) = serve(&mut st) { eprintln!("serve: {e}"); std::process::exit(1) } }
        other => { eprintln!("usage: dscu-driver [serve|bench [N]|snapshot [--skeleton] [--root @sN:eM]|selftest]  (got {other})"); std::process::exit(64) }
    }
}
