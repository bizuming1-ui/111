"""Perception layer (Step 2).

 * Force-Vision Latch : `vision_inspect` arms `_force_vision_next_turn`.  The very next *main-loop* observation skips the CDP overlay,
                        captures the screen through DXGI (optionally cropped + 2x zoomed, detail="original"), draws the SoM grid and the
                        numbered element boxes, and auto-resets the latch only after a screenshot was really produced.
 * Fast Foreground Gate: a <2 ms Win32 `fg_probe` decides, BEFORE any UIA work, whether the foreground is the CDP-attached browser.  If yes the
                        394 ms UIA tree walk is skipped entirely (driver is asked for windows + DXGI stats only) and CDP is queried concurrently.
 * Focus Guard         : if the host console (the terminal running this program) stole the foreground while the task works elsewhere,
                        the work window is re-activated (verified) before observing / capturing.
"""
from __future__ import annotations

import asyncio
import re
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Optional

from .protocol import Element, Observation
from .state import BROWSERS, TaskState

MAX_LIST = 80
MAX_SHOT_EDGE = 1800


def choose_channel(*, cdp_up: bool, fg_is_browser: bool, uia_controls: int, stalled_steps: int, blocked_streak: int, forced: Optional[str]) -> str:
    """Perception routing from live signals only (no hard-coded cdp_up=True / uia_controls=None)."""
    if forced:
        return forced
    if fg_is_browser and cdp_up:
        return "cdp"
    if uia_controls >= 6 and not (stalled_steps >= 3 and blocked_streak >= 3):
        return "uia"
    return "dxgi_vision"


def ordered_elements(obs: Observation) -> list[Element]:
    order = sorted(obs.elements, key=lambda e: (0 if "focused" in e.states else 1 if e.zone == "Modal" else 2 if e.zone == "Toolbar" else 3 if e.zone == "Row" else 4))
    return order[:MAX_LIST]


@dataclass
class Bundle:
    obs: Observation
    drv: Observation
    channel: str
    els: dict[int, Element] = field(default_factory=dict)
    epoch_cdp: Optional[int] = None
    shot: Optional[str] = None
    ms: float = 0.0
    note: str = ""
    latched: bool = False  # this turn is a forced-vision turn (vision_inspect latch)
    gate: bool = False  # fast foreground gate passed => UIA scan skipped
    shot_detail: str = "low"
    shot_info: dict[str, Any] = field(default_factory=dict)


class Perception:
    def __init__(self, brain: Any) -> None:
        self.brain = brain
        self._force_vision_next_turn = False
        self.vision_opts: dict[str, Any] = {}
        self._latch_fail = 0
        self._probe_ok = True
        self.stats = {"latch_armed": 0, "latch_served": 0, "gate_hits": 0, "uia_skipped": 0, "uia_scans": 0, "auto_refocus": 0, "probe_ms": []}

    # ------------------------------------------------------------------ latch
    def arm_force_vision(self, detail: str = "low", crop_region: Optional[list[int]] = None, zoom: Optional[float] = None, reason: str = "") -> None:
        d = "original" if str(detail).lower() in ("original", "high", "hd") else "low"
        self._force_vision_next_turn = True
        self._latch_fail = 0
        self.vision_opts = {"detail": d, "crop_region": [int(v) for v in crop_region] if crop_region and len(crop_region) == 4 else None,
                            "zoom": float(zoom) if zoom else (2.0 if crop_region else 1.0), "reason": reason}
        self.stats["latch_armed"] += 1

    @property
    def latch_armed(self) -> bool:
        return self._force_vision_next_turn

    # ------------------------------------------------------------------ helpers
    def _lat(self, k: str, v: float) -> None:
        self.brain.lat[k].append(v)

    async def _fg_probe(self) -> Optional[dict[str, Any]]:
        fn = getattr(self.brain.hub, "drv_fg_probe", None)
        if fn is None or not self._probe_ok:
            return None
        try:
            t0 = time.perf_counter()
            d = await fn()
            ms = (time.perf_counter() - t0) * 1000
            self._lat("fg_probe", ms)
            self.stats["probe_ms"].append(float(d.get("ms", ms)))
            return d if d.get("hwnd") is not None else None
        except Exception:  # noqa: BLE001  (Rust driver without fg_probe, IPC error ...) -> permanently use the classic path
            self._probe_ok = False
            return None

    def _gate_passes(self, p: Optional[dict[str, Any]]) -> bool:
        hub = self.brain.hub
        if not p or not hub.cdp_up:
            return False
        proc = str(p.get("process", "")).lower()
        if proc not in BROWSERS or p.get("own_console") or p.get("system_popup") or p.get("occluded") or p.get("cloaked") or p.get("minimized"):
            return False
        pids = {int(x) for x in (getattr(hub, "cdp_hello", {}) or {}).get("browser_pids", []) if x}
        if pids and int(p.get("pid", 0)) not in pids:
            return False  # a browser, but not the one the CDP daemon is attached to
        return True

    @staticmethod
    def _find_work_window(drv: Observation, browser_pref: bool) -> Optional[int]:
        cands = [w for w in drv.windows if not w.own_console and not w.minimized and not w.cloaked and w.title and (w.cls or "") not in ("Progman", "WorkerW", "Shell_TrayWnd")]
        if browser_pref:
            b = next((w for w in cands if w.process.lower() in BROWSERS), None)
            if b:
                return b.hwnd
        return cands[0].hwnd if cands else None

    async def _guard_focus(self, st: TaskState, hwnd: int) -> bool:
        hub = self.brain.hub
        fn = getattr(hub, "drv_guard_focus", None)
        try:
            if fn is not None:
                r = await fn(hwnd)
                ok = bool(r.get("ok"))
            else:
                r = await self.brain._drv("focus_window", None, hwnd=hwnd)  # type: ignore[arg-type]
                ok = r.ok
        except Exception:  # noqa: BLE001
            return False
        if ok:
            self.stats["auto_refocus"] += 1
            self.brain.counters["auto_refocus"] += 1
        return ok

    # ------------------------------------------------------------------ main entry
    async def observe(self, st: TaskState, *, forced: Optional[str] = None, want_shot: bool = False, main_loop: bool = False) -> Bundle:
        br, hub = self.brain, self.brain.hub
        t0 = time.perf_counter()
        latched = bool(self._force_vision_next_turn and main_loop)
        opts = dict(self.vision_opts) if latched else {}
        if latched:
            forced, want_shot = "dxgi_vision", True
        browser_task = st.target_hint in ("browser", "msedge", "chrome") or re.search(r"https?://|gmail|浏览器|网页|网站|抖音|bilibili|youtube|淘宝|百度", st.task, re.I) is not None
        if browser_task and not hub.cdp_up:
            await hub.ensure_cdp()

        # ---- 1) <2 ms foreground probe + focus guard
        probe = await self._fg_probe()
        work = getattr(st, "work_hwnd", 0)
        if probe and probe.get("hwnd") and not probe.get("own_console") and probe.get("class") not in ("Progman", "WorkerW", "Shell_TrayWnd"):
            st.work_hwnd = work = int(probe["hwnd"])  # type: ignore[attr-defined]
        if probe and probe.get("own_console") and work and (st.step >= 2 or latched):
            if await self._guard_focus(st, work):
                probe = await self._fg_probe() or probe
        gate = self._gate_passes(probe) and forced in (None, "cdp")

        # ---- 2) driver observation (UIA skipped when the gate passed)
        cdp_task: Optional[asyncio.Task[Observation]] = None
        if gate and hub.cdp_up:
            cdp_task = asyncio.create_task(hub.cdp_observe(max_elements=250))
        elif latched and hub.cdp_up:
            cdp_task = asyncio.create_task(asyncio.wait_for(hub.cdp_observe(max_elements=250, settle_ms=700), 6.0))
        if gate or latched or forced == "dxgi_vision":
            drv = await hub.drv_observe(channel="dxgi_vision", max_elements=1)
            self._lat("uia", 0.0)
            self.stats["uia_skipped"] += 1
            if gate:
                self.stats["gate_hits"] += 1
        else:
            drv = await hub.drv_observe(channel="auto", max_elements=160)
            self._lat("uia", float(drv.telemetry.get("uia_ms", 0) or 0))
            self.stats["uia_scans"] += 1
        if drv.dxgi_stats:
            s = drv.dxgi_stats
            c = br.cap_stats.setdefault(s.capture_backend, [0, 0.0])
            c[0] += 1
            c[1] += s.frame_ms
            self._lat("capture", s.frame_ms)
            if s.fallback_reason:
                br.fallback_reasons.add(f"{s.capture_backend}:{s.fallback_reason[:100]}")
        if (not work) or (probe and probe.get("own_console")):
            w = self._find_work_window(drv, bool(browser_task))
            if w and not work:
                st.work_hwnd = work = w  # type: ignore[attr-defined]
        if latched and (drv.fg_window() and drv.fg_window().own_console) and work:  # type: ignore[union-attr]
            if await self._guard_focus(st, work):
                await asyncio.sleep(0.12)

        fg_is_browser = br._fg_is_browser(drv)
        ch = "cdp" if (gate and cdp_task) else choose_channel(cdp_up=hub.cdp_up, fg_is_browser=fg_is_browser or bool(browser_task), uia_controls=len(drv.elements), stalled_steps=st.stalled_steps,
                                                              blocked_streak=st.blocked_streak, forced=forced)
        obs, epoch_cdp, shot, note = drv, None, None, ""
        cdp_obs: Optional[Observation] = None

        # ---- 3) CDP overlay (never on a latched vision turn: the model must SEE the pixels)
        if ch == "cdp" and hub.cdp_up and not latched:
            try:
                c0 = time.perf_counter()
                cdp = await (cdp_task if cdp_task else hub.cdp_observe(max_elements=250))
                self._lat("cdp", (time.perf_counter() - c0) * 1000)
                cdp_obs = cdp
                obs = drv.model_copy(update={"elements": cdp.elements, "channel": "cdp", "url": cdp.url, "title": cdp.title or drv.title, "settled": cdp.settled,
                                             "inflight": cdp.inflight, "snapshot_epoch": cdp.snapshot_epoch, "telemetry": {**drv.telemetry, **{f"cdp_{k}": v for k, v in cdp.telemetry.items()}}})
                epoch_cdp = cdp.snapshot_epoch
                cdp_task = None
            except Exception as e:  # noqa: BLE001
                note = f"[CDP_DEGRADED] CDP 自愈（重连/重启浏览器/重新附着）仍失败，本轮才回退 UIA/视觉：{e}"
                if gate:  # UIA was skipped on the assumption CDP works -> do the real scan now
                    drv = await hub.drv_observe(channel="auto", max_elements=160)
                    self._lat("uia", float(drv.telemetry.get("uia_ms", 0) or 0))
                    obs = drv
                ch = "uia" if len(drv.elements) >= 6 else "dxgi_vision"
        elif latched and cdp_task is not None:
            try:
                cdp_obs = await cdp_task
                epoch_cdp = cdp_obs.snapshot_epoch
            except Exception as e:  # noqa: BLE001
                note = f"视觉轮 CDP 元素不可用（{str(e)[:60]}），仅用像素网格"
        if cdp_task is not None and not cdp_task.done():
            cdp_task.cancel()

        # ---- 4) screenshot (vision channel, SoM, latch)
        shot_info: dict[str, Any] = {}
        detail = opts.get("detail", "low")
        if ch == "dxgi_vision" or want_shot:
            ch = "dxgi_vision" if ch != "cdp" else ch
            shot_path = str(br.cfg.workspace / f"shot_{int(time.time() * 1000)}.png")
            v0 = time.perf_counter()
            region = opts.get("crop_region")
            vo = await hub.drv_observe(channel="dxgi_vision", hwnd=drv.hwnd or 0, screenshot_path=shot_path, screenshot_scale=0.62 if not drv.hwnd and not region else 1.0,
                                       max_elements=1, **({"region": region} if region else {}))
            self._lat("shot", (time.perf_counter() - v0) * 1000)
            if vo.screenshot and "path" in vo.screenshot:
                shot = vo.screenshot["path"]
                src = vo.screenshot.get("src_rect")
                sc = float(vo.screenshot.get("scale", 1.0))
                elems = cdp_obs.elements if (cdp_obs is not None and latched) else obs.elements
                som = self._som_boxes(cdp_obs, drv, elems) if (cdp_obs is not None and latched) else None
                sc, shot_info = self._finish_shot(shot, elems, src, sc, float(opts.get("zoom") or 1.0), detail, som)
                shot_info["capture_ms"] = (vo.dxgi_stats.frame_ms if vo.dxgi_stats else None)
            if ch == "dxgi_vision":
                upd: dict[str, Any] = {"channel": "dxgi_vision", "screenshot": vo.screenshot}
                if latched and cdp_obs is not None:
                    upd.update(elements=cdp_obs.elements, url=cdp_obs.url, title=cdp_obs.title or drv.title, snapshot_epoch=cdp_obs.snapshot_epoch)
                obs = drv.model_copy(update=upd)
        if latched:
            if shot:  # auto-reset ONLY after a real screenshot
                self._force_vision_next_turn = False
                self.vision_opts = {}
                self.stats["latch_served"] += 1
                br.counters["latch_served"] += 1
            else:
                self._latch_fail += 1
                note = (note + "；" if note else "") + f"强制视觉轮截图失败（第 {self._latch_fail} 次）"
                if self._latch_fail >= 2:
                    self._force_vision_next_turn = False
        b = Bundle(obs=obs, drv=drv, channel=obs.channel, epoch_cdp=epoch_cdp, shot=shot, note=note, ms=(time.perf_counter() - t0) * 1000, latched=latched and bool(shot), gate=gate,
                   shot_detail=detail, shot_info=shot_info)
        st.perception_channel = b.channel
        return b

    # ------------------------------------------------------------------ screenshots / SoM
    @staticmethod
    def _som_boxes(cdp: Optional[Observation], drv: Observation, elements: list[Element]) -> Optional[list[list[int]]]:
        """CDP element rects are CSS px in the page viewport.  Calibrate to *screen* px with the browser window rect + daemon viewport metrics."""
        if cdp is None:
            return None
        vp = cdp.telemetry.get("viewport") if cdp.telemetry else None
        win = drv.fg_window() if drv.fg_window() and drv.fg_window().process.lower() in BROWSERS else None  # type: ignore[union-attr]
        if not vp or win is None:
            return None
        try:
            dpr = float(vp.get("dpr", 1.0) or 1.0)
            iw, ih = float(vp["innerWidth"]) * dpr, float(vp["innerHeight"]) * dpr
            wx, wy, ww, wh = win.rect
            border = max(0.0, (ww - iw) / 2.0)
            left, bottom = wx + border, wy + wh - border
            top = bottom - ih
        except Exception:  # noqa: BLE001
            return None
        out = []
        for e in elements:
            x, y, w, h = e.rect
            out.append([int(left + x * dpr), int(top + y * dpr), int(w * dpr), int(h * dpr)])
        return out

    def _finish_shot(self, path: str, elements: list[Element], src: Optional[list[int]], scale: float, zoom: float, detail: str,
                     som: Optional[list[list[int]]]) -> tuple[float, dict[str, Any]]:
        info: dict[str, Any] = {"zoom": zoom, "detail": detail, "som_boxes": bool(som)}
        try:
            from PIL import Image

            im = Image.open(path).convert("RGB")
            if zoom and zoom > 1.01:
                im = im.resize((int(im.width * zoom), int(im.height * zoom)), Image.LANCZOS)
                scale *= zoom
