// vision-engine CPU backend: scalar reference + AVX2 SIMD with runtime dispatch. C++20.
#include "vision_engine.h"
#include <array>
#include <atomic>
#include <bit>
#include <cmath>
#include <cstring>
#if defined(__x86_64__) || defined(_M_X64)
#define VE_X64 1
#if defined(_MSC_VER)
#include <intrin.h>
#endif
#include <immintrin.h>
#endif

namespace {
std::atomic<bool> g_force_scalar{false};

bool cpu_has_avx2() {
#if defined(VE_X64)
#if defined(_MSC_VER)
  int r[4]; __cpuid(r, 0); if (r[0] < 7) return false;
  __cpuidex(r, 7, 0); return (r[1] & (1 << 5)) != 0;
#else
  __builtin_cpu_init(); return __builtin_cpu_supports("avx2");
#endif
#else
  return false;
#endif
}
const bool kAvx2 = cpu_has_avx2();

int diff_count_scalar(const uint8_t* a, const uint8_t* b, int len, int thr) {
  int n = 0;
  for (int i = 0; i < len; ++i) { int d = a[i] > b[i] ? a[i] - b[i] : b[i] - a[i]; n += d >= thr; }
  return n;
}
#if defined(VE_X64)
#if defined(__GNUC__) && !defined(__clang__)
__attribute__((target("avx2")))
#elif defined(__clang__)
__attribute__((target("avx2")))
#endif
int diff_count_avx2(const uint8_t* a, const uint8_t* b, int len, int thr) {
  const __m256i t = _mm256_set1_epi8(static_cast<char>(thr));
  int n = 0, i = 0;
  for (; i + 32 <= len; i += 32) {
    __m256i x = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(a + i));
    __m256i y = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(b + i));
    __m256i d = _mm256_or_si256(_mm256_subs_epu8(x, y), _mm256_subs_epu8(y, x));  // |x-y|
    __m256i ge = _mm256_cmpeq_epi8(_mm256_max_epu8(d, t), d);                     // d >= t
    n += std::popcount(static_cast<unsigned>(_mm256_movemask_epi8(ge)));
  }
  return n + diff_count_scalar(a + i, b + i, len - i, thr);
}
#endif
int diff_count(const uint8_t* a, const uint8_t* b, int len, int thr) {
#if defined(VE_X64)
  if (kAvx2 && !g_force_scalar.load(std::memory_order_relaxed) && thr > 0 && thr < 256) return diff_count_avx2(a, b, len, thr);
#endif
  return diff_count_scalar(a, b, len, thr);
}
}  // namespace

extern "C" {
VE_API uint32_t ve_caps(void) {
  uint32_t c = kAvx2 ? 1u : 0u;
#if defined(VE_HAVE_CUDA)
  c |= 2u;
#endif
#if defined(VE_HAVE_D3D11)
  c |= 4u;
#endif
  return c;
}
VE_API const char* ve_version(void) { return "9.0.0"; }
VE_API void ve_force_scalar(int on) { g_force_scalar.store(on != 0); }

VE_API int ve_ahash(const uint8_t* sig, uint64_t* out) {
  if (!sig || !out) return VE_ERR_ARG;
  uint32_t sums[64]; uint64_t total = 0;
  for (int by = 0; by < 8; ++by)
    for (int bx = 0; bx < 8; ++bx) {
      uint32_t s = 0;
      for (int y = 0; y < 4; ++y) { const uint8_t* r = sig + (by * 4 + y) * 48 + bx * 6; s += r[0] + r[1] + r[2] + r[3] + r[4] + r[5]; }
      sums[by * 8 + bx] = s; total += s;
    }
  uint64_t bits = 0;
  for (int i = 0; i < 64; ++i) if (static_cast<uint64_t>(sums[i]) * 64 > total) bits |= 1ull << i;
  *out = bits;
  return VE_OK;
}

VE_API int ve_pixel_diff_x10(const uint8_t* a, const uint8_t* b, int len, int thr) {
  if (!a || !b || len <= 0 || thr < 0) return VE_ERR_ARG;
  const int n = diff_count(a, b, len, thr);
  return static_cast<int>(std::nearbyint(1000.0 * n / len));  // default FE_TONEAREST = ties-to-even, same as .NET Math.Round
}

VE_API int ve_block_mask(const uint8_t* a, const uint8_t* b, int thr, int min_px, uint64_t* out) {
  if (!a || !b || !out) return VE_ERR_ARG;
  uint64_t m = 0;
  for (int by = 0; by < 8; ++by)
    for (int bx = 0; bx < 8; ++bx) {
      int c = 0;
      for (int y = 0; y < 4; ++y) { const int o = (by * 4 + y) * 48 + bx * 6; c += diff_count_scalar(a + o, b + o, 6, thr); }
      if (c >= min_px) m |= 1ull << (by * 8 + bx);
    }
  *out = m;
  return VE_OK;
}

VE_API int ve_gray_sig_bgra(const uint8_t* bgra, int stride, int x, int y, int w, int h, uint8_t* out) {
  if (!bgra || !out || w < 16 || h < 16 || stride < (x + w) * 4 || x < 0 || y < 0) return VE_ERR_ARG;
  constexpr int K = 4;  // K x K samples per destination cell (24.5k samples total: ~30 us on a 4K surface, no full-frame readback)
  for (int dy = 0; dy < VE_SIG_H; ++dy)
    for (int dx = 0; dx < VE_SIG_W; ++dx) {
      uint32_t acc = 0;
      for (int sy = 0; sy < K; ++sy)
        for (int sx = 0; sx < K; ++sx) {
          const int px = x + ((dx * K + sx) * 2 + 1) * w / (VE_SIG_W * K * 2);
          const int py = y + ((dy * K + sy) * 2 + 1) * h / (VE_SIG_H * K * 2);
          const uint8_t* p = bgra + static_cast<size_t>(py) * stride + static_cast<size_t>(px) * 4;
          acc += (77u * p[2] + 150u * p[1] + 29u * p[0]) >> 8;
        }
      out[dy * VE_SIG_W + dx] = static_cast<uint8_t>(acc / (K * K));
    }
  return VE_OK;
}
}
