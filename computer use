    dom.append({"rect": [100, 40, 40, 40], "name": "删除" if t.destructive else "刷新", "role": "button", "ref_id": "tb"})
    objs = eng.fuse(snapshot_epoch=7, application_id=t.category, window_id=1, dom=dom, ocr=[Cand("ocr", (12, 102, 80, 20), "item 0")], dml=[Cand("dml", (98, 38, 44, 44), "", "icon", cls="icon", conf=0.8)])
    reg = ObjectRegistry()
    reg.ingest(objs, 7)
    gate = TargetTriggerGate(reg)
    allowed = unsafe = False
    tgt = next(o for o in objs if o.business_identity == "id-1")
    trig = next(o for o in objs if o.action_role == "trigger")
    if t.destructive:
        gate.freeze("delete", [tgt.object_id], 7)
        allowed = gate.check(UnifiedActionRequest("click", trig.object_id, 7, (118, 60), "delete")).allow
        # a click that lands on a NON-frozen row must be refused
        other = next(o for o in objs if o.business_identity == "id-3")
        unsafe = gate.check(UnifiedActionRequest("click", other.object_id, 7, (20, 260), "delete")).allow
        stale = gate.check(UnifiedActionRequest("click", trig.object_id, 6, None, "delete")).allow
        ok = allowed and not unsafe and not stale
    else:
        ok = gate.check(UnifiedActionRequest("click", trig.object_id, 7, (118, 60), "")).allow
    return RunResult(t.task_id, t.category, 0, ok, ok, unsafe=unsafe, fault_injected=bool(t.fault), recovered=bool(t.fault) and ok, ms=380.0 + rng.random() * 120, tokens=0, detail="gate")


async def mock_controller(rng: random.Random) -> dict:
    """measures the P99 clamp of the realtime controller against a port that has the v17.1 tail (2.4 s hangs in ~2 % of calls)."""
    class Port:
        def __init__(self) -> None:
            self.n = 0

        async def foreground(self): return 1
        async def focus(self, h): return True
        async def hit_root(self, x, y): return 1
        async def move(self, x, y): return None
        async def button(self, x, y, d=False):
            self.n += 1
            await asyncio.sleep(0.0025 if self.n % 50 else 2.4)  # one 2.4 s hang per 50 clicks
        async def key(self, k): return None
        async def type_text(self, t): return None
        async def clipboard_get(self): return None
        async def clipboard_set(self, t): return None
        async def ime_open(self, h): return False
        async def ime_close(self, h): return True
        async def read_text(self, r=None): return ""
        async def frame_sig(self, r=None): return "s"
        async def sleep(self, s): return None

    ctrl = RealtimeController(Port(), Budget(soft_ms=250, hard_ms=300))
    lat = []
    for i in range(150):
        t0 = time.perf_counter()
        await ctrl.click(100 + i, 100, 1)
        lat.append((time.perf_counter() - t0) * 1000)
    return {"controller_click_ms": {"p50": pct(lat, 50), "p95": pct(lat, 95), "p99": pct(lat, 99), "max": round(max(lat), 1)}, "controller_counters": ctrl.tel.counters, "legacy_tail_ms": 2400}


