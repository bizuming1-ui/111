"""Idempotent action state machine with FULL-CHAIN optimistic locks.
Every mutating action carries action_id + expect_hwnd + expect_fp. State drift (window changed / region fingerprint moved / stale ref)
never produces a blind click: the machine re-snapshots the LOCAL region, re-resolves the target and retries (bounded)."""
from __future__ import annotations
import asyncio
import enum
import time
from dataclasses import dataclass, field
from typing import Awaitable, Callable, Protocol
from .contracts import Code, DRIFT_CODES, hamming_hex

class Verdict(enum.IntEnum):
    OK = 0
    IDEMPOTENT_REPLAY = 4090
    STALE_ACTION_ID = 4091
    STALE_HWND = 4092
    STALE_REGION = 4093

class ActionLedger:
    """Python twin of dscu_v9::ipc::ActionLedger (same golden sequence)."""
    def __init__(self) -> None:
        self.max = 0
        self.seen: dict[int, int] = {}

    def check_commit(self, action_id, req_fp, expect_hwnd, cur_hwnd, expect_fp, cur_fp) -> Verdict:
        if action_id is not None and action_id <= self.max:
            return Verdict.IDEMPOTENT_REPLAY if self.seen.get(action_id) == req_fp else Verdict.STALE_ACTION_ID
        if expect_hwnd is not None and expect_hwnd != cur_hwnd:
            return Verdict.STALE_HWND
        if expect_fp is not None and cur_fp is not None and hamming_hex(expect_fp, cur_fp) > 10:
            return Verdict.STALE_REGION
        if action_id is not None:
            self.max = action_id
            self.seen[action_id] = req_fp
            if len(self.seen) > 4096:
                floor = self.max - 2048
                self.seen = {k: v for k, v in self.seen.items() if k >= floor}
        return Verdict.OK

class State(enum.Enum):
    PLANNED = "planned"; SNAPSHOT = "snapshot"; SENT = "sent"; VERIFIED = "verified"; RESNAPSHOT = "resnapshot"; FAILED = "failed"

@dataclass
class Snapshot:
    hwnd: int
    fp: str
    ref: str | None = None

class Transport(Protocol):
    async def call(self, method: str, params: dict, *, action_id: int | None = None, expect_hwnd: int | None = None, expect_fp: str | None = None) -> dict: ...

@dataclass
class ActionResult:
    ok: bool
    state: State
    attempts: int
    action_ids: list[int] = field(default_factory=list)
    resnapshots: int = 0
    code: int = 0
    detail: str = ""

class ActionStateMachine:
    def __init__(self, transport: Transport, snapshot: Callable[[str | None], Awaitable[Snapshot]], max_resnap: int = 2, clock: Callable[[], float] = time.perf_counter) -> None:
        self.t, self.snapshot, self.max_resnap, self.clock = transport, snapshot, max_resnap, clock
        self._next = 0
        self._lock = asyncio.Lock()
        self.trace: list[tuple[State, float]] = []

    def _aid(self) -> int:
        self._next += 1
        return self._next

    async def execute(self, method: str, params: dict, target: str | None = None) -> ActionResult:
        async with self._lock:  # one mutating action in flight: the UI is a single shared resource
            res = ActionResult(False, State.PLANNED, 0)
            snap = await self.snapshot(target); self._mark(State.SNAPSHOT)
            for attempt in range(1, self.max_resnap + 2):
                res.attempts = attempt
                aid = self._aid(); res.action_ids.append(aid)
                p = dict(params)
                if snap.ref and "ref" in p: p["ref"] = snap.ref
                reply = await self.t.call(method, p, action_id=aid, expect_hwnd=snap.hwnd, expect_fp=snap.fp); self._mark(State.SENT)
                code = int(reply.get("error", {}).get("code", 0)) if isinstance(reply.get("error"), dict) else 0
                if code == 0:
                    res.ok, res.state = True, State.VERIFIED; self._mark(State.VERIFIED); return res
                if code == Code.IPC_IDEMPOTENT_REPLAY:   # retry of an already executed action: success, never re-execute
                    res.ok, res.state, res.code = True, State.VERIFIED, code; return res
                if code in {int(c) for c in DRIFT_CODES} and res.resnapshots < self.max_resnap:
                    res.resnapshots += 1; self._mark(State.RESNAPSHOT)
                    snap = await self.snapshot(target)      # LOCAL re-sample, then re-resolve: no click happened
                    continue
                res.state, res.code = State.FAILED, code
                res.detail = str(reply.get("error", {}).get("message", ""))
                return res
            res.state = State.FAILED
            return res

    def _mark(self, s: State) -> None:
        self.trace.append((s, self.clock()))
