                tok = m.group(2).lower().strip("\"'")
                return "ps:" + tok
            return "ps:cmd:" + _h(re.sub(r"\s+", " ", str(a.get("command", "")).strip().lower()))
        if name in ("launch", "app_resolve"):
            return f"launch:{str(a.get('target') or a.get('name') or '').lower()}"
        return f"tool:{name}"

    @staticmethod
    def alternative_for(a: dict[str, Any], message: str = "") -> str:
        blob = f"{a.get('command', '')} {a.get('target', '')} {a.get('path', '')} {message}"
        for rx, alt in ALTERNATIVES:
            if rx.search(blob):
                return alt
        return DEFAULT_ALT

    def pre_check(self, a: dict[str, Any], step: int = 0) -> Optional[ActionResult]:
        """Block re-submission of an already-denied tool/command WITHOUT calling the worker again (counts as a repeat denial)."""
        if not self.deny:
            return None
        name = str(a.get("action", ""))
        hit: Optional[str] = None
        if name == "run_powershell":
            cmd = str(a.get("command", ""))
            if "ps:cmd:" + _h(re.sub(r"\s+", " ", cmd.strip().lower())) in self.deny:
                hit = "ps:cmd:" + _h(re.sub(r"\s+", " ", cmd.strip().lower()))
            else:
                for k in self.deny:
                    if k.startswith("ps:") and not k.startswith("ps:cmd:"):
                        tok = k[3:]
                        if tok and re.search(r"(?<![\w-])" + re.escape(tok) + r"(?![\w-])", cmd, re.I):
