        }
    }
    catch { }
    $cbLine = ''
    if ($cbTotal -gt 0) {
        $cbLine = "复选框汇总（不含列表行）: 可见共 $cbTotal 个，已勾选 $($cbOnIds.Count) 个" + $(if ($cbOnIds.Count -gt 0) { "（编号 $($cbOnIds -join ',')）" } else { '' })
    }
    $consoleHint = ''
    $isConsole = (Test-IsConsoleWindow $fg.Handle) -or ($fg.Process -in @('pwsh', 'powershell', 'WindowsTerminal', 'conhost', 'OpenConsole'))
    if ($isConsole) { $consoleHint = '（注意：当前前台是运行本脚本的控制台，请先 launch 或 focus_window 切换到目标程序）' }
    $text = @(
        "屏幕分辨率: ${sw}x${sh}  真实鼠标位置: ($($cursor[0]),$($cursor[1]))（虚拟鼠标不会移动它）"
        "前台窗口: [$($fg.Process)] $(Limit-Text $fg.Title 100) $consoleHint"
        $focusLine
        '已打开的窗口:'
        ($windows -join "`n")
        "前台窗口控件（共 $($general.Count) 个，按从上到下、从左到右排序；{...} 为可用的无障碍模式 inv=可调用 val=可写值 tog=开关 sel=可选中 exp=可展开 scr=可滚动）:"
        ($lines -join "`n")
        $cbLine
        $rowBlock
    ) | Where-Object { $_ -ne '' } | ForEach-Object { $_ }
    $text = $text -join "`n"
    $curSet = New-KeySet (Add-OrdinalKeys $baseKeys.ToArray())
    $changes = Get-ObservationDiff $script:BaseKeys $curSet $script:BaseTitle $fg.Title
