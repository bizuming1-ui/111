# ---------- ① 联锁判定（纯函数）：仅 [Zone: Row] 拦批量动作；[Zone: Toolbar] 只对照「剩余子批次配额」----------
function Test-InterlockDecision([int]$qty, [string]$name, [string]$type, [bool]$isMaster, [int]$rowCount, [int]$onCount, [bool]$inRow, [int[]]$allowed = @(), [bool]$twin = $false) {
    if ($qty -le 0 -or $rowCount -le 0) { return $null }
    $nm = "$name".Trim()
    if ($isMaster -and $rowCount -gt $qty) { return "安全联锁：任务只要求 $qty 个，禁止点击「全选」复选框（列表共 $rowCount 行）；请用 select_rows 精确勾选第 1-$qty 行" }
    if ($nm -match $script:SelectAllPattern -and $rowCount -gt $qty) { return "安全联锁：任务只要求 $qty 个，禁止使用「$nm」（会选中全部 $rowCount 行）；请用 select_rows 精确勾选第 1-$qty 行" }
    if ($nm -match $script:DestructivePattern) {
        $okSet = @($allowed | Where-Object { $_ -gt 0 })
        if ($okSet.Count -eq 0) { $okSet = @($qty) }
        if ($inRow) {
            # 行内悬浮按钮只处理「那一行」：仅当恰好勾选 1 行且剩余配额含 1 时才等价
            if (-not ($onCount -eq 1 -and ($okSet -contains 1 -or $qty -eq 1))) {
                $tw = if ($twin) { '；本页存在同名 [Zone: Toolbar] 批量按钮，系统会自动改点它（或用 toolbar_action）' } else { '；请改点 [Zone: Toolbar] 里的批量按钮，或输出 toolbar_action' }
                return "安全联锁 [Zone: Row]：「$(Limit-Text $nm 16)」是行内悬浮按钮，只处理那一行（当前勾选 $onCount 个，剩余配额 $($okSet -join ' / ')）$tw"
            }
        }
        elseif ($okSet -notcontains $onCount) {
            $need = if ($okSet.Count -gt 1) { "剩余子批次 / 前缀和之一（$($okSet -join ' / ')）" } else { "$($okSet[0]) 个" }
            return "安全联锁 [Zone: Toolbar]：当前待执行配额为 $need，但列表实际勾选 $onCount 个，已拒绝「$(Limit-Text $nm 16)」（未发送任何输入）；请先用 select_rows 精确勾选目标行，看到 ✓ 闭环验证通过后再删除"
        }
    }
    return $null
}

# ---------- ① 配额：只确认「真正从页面消失」的行（v9.2 在选择指纹变化时整批确认 → 误点 1 行就记成已删 13）----------
function Register-V10QuotaDelete($Quota, [int]$Count, [string[]]$Texts) {
    if ($null -eq $Quota -or $Count -le 0) { return }
    $before = @($Quota.Remaining); $rem = $Quota.Remaining
    $i = $rem.IndexOf([int]$Count)
    if ($i -ge 0) { $rem.RemoveAt($i) }
    else {
        $acc = 0; $k = -1
        for ($j = 0; $j -lt $rem.Count; $j++) { $acc += $rem[$j]; if ($acc -eq $Count) { $k = $j; break } }
        if ($k -ge 0) { $rem.RemoveRange(0, $k + 1) } elseif ($Count -ge $acc) { $rem.Clear() }
    }
    $Quota.Pending = [pscustomobject]@{ Count = [int]$Count; Sel = ''; Texts = @($Texts); Before = $before }
    $Quota.Log.Add("登记 $Count → 剩余 [$((@($rem)) -join '+')]")
}
function Resolve-V10QuotaPending($Quota, [string[]]$CurrentTexts) {
    if ($null -eq $Quota -or $null -eq $Quota.Pending) { return 'none' }
    $p = $Quota.Pending; $Quota.Pending = $null
    $present = [System.Collections.Generic.HashSet[string]]::new()
    foreach ($t in @($CurrentTexts)) { [void]$present.Add("$t") }
    $removed = 0
    foreach ($t in @($p.Texts)) { if ("$t" -ne '' -and -not $present.Contains("$t")) { $removed++ } }
    if ($removed -le 0) {
        $Quota.Remaining.Clear(); foreach ($v in $p.Before) { $Quota.Remaining.Add([int]$v) }
        $Quota.Log.Add("回滚 $($p.Count)（所选行仍在页面上，删除未生效）"); $script:V92.QuotaRollback++
        return 'rollback'
    }
    if ($removed -ge [int]$p.Count) { $Quota.Done += [int]$p.Count; $Quota.Log.Add("确认 $($p.Count)"); return 'commit' }
    $left = [int]$p.Count - $removed
    $Quota.Done += $removed
    $Quota.Remaining.Clear()
    $rep = $false
    foreach ($v in $p.Before) { if (-not $rep -and [int]$v -eq [int]$p.Count) { $Quota.Remaining.Add([int]$left); $rep = $true } else { $Quota.Remaining.Add([int]$v) } }
    if (-not $rep) { $Quota.Remaining.Insert(0, [int]$left) }
    $Quota.Log.Add("部分确认 $removed/$($p.Count)，剩余该批 $left"); $script:V10.QuotaPartial++
    return 'partial'
}
function Set-V10ActionTarget($a, $tw, [bool]$viaDom) {
    foreach ($p in 'id', 'ids') { if ($a.PSObject.Properties[$p]) { $a.PSObject.Properties.Remove($p) } }
    $a | Add-Member -NotePropertyName x -NotePropertyValue ([int]$tw.cx) -Force
    $a | Add-Member -NotePropertyName y -NotePropertyValue ([int]$tw.cy) -Force
    $a | Add-Member -NotePropertyName force -NotePropertyValue $true -Force
    if ($viaDom) { $a | Add-Member -NotePropertyName __v10tb -NotePropertyValue "$($tw.Name)" -Force }
}
function Test-V10BulkTargets($targets, $a) {
    if (@($targets).Count -eq 0) { return }
    $need = $false
    foreach ($t in $targets) { $nm = "$($t.FullName)"; if (-not $nm) { $nm = "$($t.Name)" }; if ($nm -match $script:DestructivePattern -or $nm -match $script:SelectAllPattern -or [bool]$t.IsMaster) { $need = $true } }
    if (-not $need) { return }
    $m = Get-RowModel $script:ObsHwnd
    $rowCount = @($m.Rows).Count
    if ($rowCount -eq 0) { return }
    $onRows = @($m.Rows | Where-Object { $_.Cb.State -eq 'on' }); $onCount = $onRows.Count
    $q = $script:V92.Quota
    if ($q) { [void](Resolve-V10QuotaPending $q @($m.Rows | ForEach-Object { "$($_.Text)" })) }
    $allowed = @(Get-V92AllowedCounts $q)
    foreach ($t in $targets) {
        $nm = "$($t.FullName)"; if (-not $nm) { $nm = "$($t.Name)" }
        $isDestr = ($nm -match $script:DestructivePattern)
        $ze = if ($t.PSObject.Properties['ZoneEntry']) { $t.ZoneEntry } else { Get-V10ItemZone $t }
        $zone = ''; $rowNo = 0
        if ($ze) { $zone = "$($ze.Zone)"; if ($zone -eq 'Row') { $rowNo = [int]$ze.Row } }
        else { $rowNo = [int](Test-TargetInRow $t @($m.Rows)); $zone = $(if ($rowNo -gt 0) { 'Row' } else { 'Toolbar' }) }
        if ($t.PSObject.Properties['Zone'] -and "$($t.Zone)") { $zone = "$($t.Zone)"; if ($zone -eq 'Toolbar') { $rowNo = 0 } }
        $twin = $null
        if ($isDestr -and $zone -eq 'Row') {
            $twin = Find-V10ToolbarTwin $nm
            if ($twin -and $null -ne $a -and ($allowed.Count -eq 0 -or $allowed -contains $onCount)) {
                Set-V10ActionTarget $a $twin ([bool]($script:V10.Cdp -and $twin.Covered))
                $script:V10.Redirects++
                Write-Host "  ⇢ 区域纠偏：「$(Limit-Text $nm 12)」原落点是 [Zone: Row[$rowNo]]（行内悬浮钮），已改点 $($twin.Tag) 批量按钮 @($($twin.cx),$($twin.cy))" -ForegroundColor DarkYellow
                $zone = 'Toolbar'; $rowNo = 0
            }
        }
        if ($q -and $isDestr -and $zone -ne 'Row' -and $q.Remaining.Count -eq 0 -and $q.Done -gt 0 -and $onCount -gt 0) {
            if ($null -ne $a -and (Test-True $a.repeat)) { continue }
            $script:V92.QuotaBlock++
            throw "安全联锁 [QUOTA_DONE]：任务的数量配额已全部完成（$(Format-V92Quota $q)）；再次「$(Limit-Text $nm 16)」会超出任务要求。若确实需要继续，请先向用户确认并加 `"repeat`":true"
        }
        $why = Test-InterlockDecision $script:TaskQty $nm "$($t.Type)" ([bool]$t.IsMaster) $rowCount $onCount ($zone -eq 'Row') $allowed ([bool]$twin)
        if ($why) {
            if ($zone -eq 'Row') { $why += "（判定依据：DOM 区域模型 [Zone: Row[$rowNo]]）" }
            if ($q) { $script:V92.QuotaBlock++; $why += "（$(Format-V92Quota $q)）" }
            $script:V10.InterlockHits++
            throw $why
        }
        if ($q -and $isDestr -and $zone -ne 'Row' -and $onCount -gt 0) { Register-V10QuotaDelete $q $onCount @($onRows | ForEach-Object { "$($_.Text)" }); $script:V92.QuotaPass++ }
    }
}
function Assert-BulkInterlock($a, [string]$kind) {
    if ($NoSafety -or $script:TaskQty -le 0) { return }
    $targets = [System.Collections.Generic.List[object]]::new()
    if ($kind -in 'click', 'double_click', 'check', 'click_many') {
        $idList = @()
        if ($null -ne $a.ids) { $idList = @($a.ids) } elseif (Test-IdValue $a.id) { $idList = @($a.id) }
        foreach ($i in $idList) { if ((Test-IdValue $i) -and $script:Elements.ContainsKey([int]"$i")) { $targets.Add($script:Elements[[int]"$i"]) } }
        if ($idList.Count -eq 0 -and (Test-NumValue $a.x) -and (Test-NumValue $a.y)) {
            $hitItem = Find-ItemAt ([int]$a.x) ([int]$a.y)
            if ($hitItem) { $targets.Add($hitItem) }
            else {
                $zp = Find-V10ZoneAtPoint ([int]$a.x) ([int]$a.y)   # 视觉 / 坐标点击：没有 UIA 控件也能查到 DOM 区域
                if ($zp) { $targets.Add([pscustomobject]@{ Type = 'Button'; FullName = $zp.Name; Name = $zp.Name; IsMaster = $false; L = $zp.L; T = $zp.T; W = $zp.W; H = $zp.H; ZoneEntry = $zp }) }
            }
        }
    }
    elseif ($kind -in 'key', 'hotkey') {
        if ("$($a.keys)" -match '(?i)(^|[\s+])(delete|del)(\s|$)|shift\+3') {
            $targets.Add([pscustomobject]@{ Type = 'Key'; FullName = 'delete'; Name = 'delete'; IsMaster = $false; L = 0; T = 0; W = 0; H = 0; Zone = 'Toolbar' })
        }
    }
    Test-V10BulkTargets $targets $a
}

# ---------- ① toolbar_action：CDP 原生批量按钮（Layer 1，免视觉；只点 [Zone: Toolbar]）----------
function Resolve-V10LabelRegex([string]$label) {
    $l = "$label".Trim()
    if ($l -match '(?i)(删|刪|delete|trash|垃圾|remove|bin)') { return '(?i)(删除|刪除|delete|trash|移至垃圾桶|移到垃圾桶|move to (trash|bin)|remove)' }
    if ($l -match '(?i)(归档|歸檔|封存|archive)') { return '(?i)(归档|歸檔|封存|archive)' }
    if ($l -match '(?i)(spam|垃圾邮件|垃圾郵件)') { return '(?i)(report spam|垃圾邮件|垃圾郵件)' }
    return '(?i)' + [regex]::Escape($l)
}
function Invoke-V10ToolbarAction($a) {
    $label = "$($a.label)".Trim()
    if ($null -eq $script:Cdp -or -not $script:Cdp.Connected) { throw 'toolbar_action 需要 CDP 浏览器会话（Layer 1）；当前不可用，请改用 click / 控件编号。' }
    $re = Resolve-V10LabelRegex $label
    $raw = Invoke-V10ZoneCollect
    if ($null -eq $raw) { throw 'toolbar_action：页面区域模型采集失败（页面是否仍在加载？）' }
    $all = @(ConvertTo-V10ZoneMap $raw $null)
    $cand = @($all | Where-Object { $_.Name -match $re -and $_.Visible } | Sort-Object { ([int]($_.Zone -ne 'Toolbar')) * 10 + [int][bool]$_.Covered })
    if ($cand.Count -eq 0) { throw "toolbar_action：页面上没有名为「$label」的可见按钮" }
    $b = $cand[0]
    if ($b.Zone -ne 'Toolbar') { throw "toolbar_action：只找到 $($b.Tag) 的候选，行内按钮只处理单行，已拒绝（请先 select_rows 勾选并滚动到工具栏可见）" }
    $gate = [pscustomobject]@{ Type = 'Button'; FullName = $b.Name; Name = $b.Name; IsMaster = $false; L = 0; T = 0; W = 0; H = 0; Zone = 'Toolbar' }
    Test-V10BulkTargets @($gate) $null
    $js = "(function(){var els=[].slice.call(document.querySelectorAll('button,[role=button],[aria-label],[data-tooltip]'));var e=els[$([int]$b.Dom)];if(!e)return JSON.stringify({ok:false});try{e.scrollIntoView({block:'nearest',inline:'nearest'});}catch(x){}var r=e.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2,h=document.elementFromPoint(cx,cy);return JSON.stringify({ok:true,x:cx,y:cy,hit:!!h&&(h===e||e.contains(h)||h.contains(e))});})()"
    $p = (("$((Invoke-CdpMethod 'Runtime.evaluate' @{ expression = $js; returnByValue = $true } 3000).result.value)") | ConvertFrom-Json)
    if (-not $p.ok) { throw 'toolbar_action：按钮已从 DOM 消失（页面已重绘），请重新观察' }
    $via = 'CDP 可信输入事件'
    if ($p.hit) {
        foreach ($ty in 'mouseMoved', 'mousePressed', 'mouseReleased') { [void](Invoke-CdpMethod 'Input.dispatchMouseEvent' @{ type = $ty; x = [double]$p.x; y = [double]$p.y; button = 'left'; clickCount = 1 } 2000) }
    }
    else {
        $via = 'DOM click()（落点被遮挡，直接触发元素本身）'
        [void](Invoke-CdpMethod 'Runtime.evaluate' @{ expression = "(function(){var els=[].slice.call(document.querySelectorAll('button,[role=button],[aria-label],[data-tooltip]'));var e=els[$([int]$b.Dom)];if(e)e.click();})()"; returnByValue = $true } 3000)
    }
    $script:V10.ToolbarClicks++
    return "toolbar_action「$($b.Name)」→ $($b.Tag) $via（Layer 1 · 免视觉）；请在下一轮观察确认提示条 / 行消失"
}

