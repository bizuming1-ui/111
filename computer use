function Get-SkillDecayWeight($Skill, [datetime]$Now = (Get-Date)) {
    if ($null -eq $Skill) { return 0.0 }
    $ageDays = 0.0
    if ($Skill.ts) {
        try { $ageDays = [Math]::Max(0.0, ($Now - [datetime]::Parse("$($Skill.ts)")).TotalDays) } catch { $ageDays = 0.0 }
    }
    $uses = [Math]::Max(1, [int]$Skill.uses)
    $fails = if ($null -ne $Skill.fails) { [Math]::Max(0, [int]$Skill.fails) } else { 0 }
    $succRate = [double]$uses / [double]($uses + $fails * 1.8)
    $timeDecay = [Math]::Exp(-0.025 * $ageDays)
    return [Math]::Round($succRate * $timeDecay * (1.0 + 0.05 * [Math]::Min(5, $uses)), 4)
}

