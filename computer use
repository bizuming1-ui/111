"""Windows Agent Arena adapter.  WAA expects an agent exposing `predict(instruction, obs) -> list[str]` (python-style action strings).
This wraps the v12 ActionGate + EntropyRouter so a WAA run exercises the same masking/routing as production; `--data` points to a WAA tasks dir
(examples/*.json with `instruction`, `config`, `evaluator`).  Offline selftest replays the log-derived fixtures."""
from __future__ import annotations

import glob
import json
import os

from agent_brain.action_gate import ActionGate
from agent_brain.entropy_router import EntropyRouter


class V12WaaAgent:
    def __init__(self, policy):
        self.policy, self.gate, self.router = policy, ActionGate(), EntropyRouter()

    def predict(self, instruction: str, obs: dict) -> list[str]:
        act = self.policy(instruction, obs, self.router.route(int(obs.get("interactive", 99))))
        d = self.gate.check(act)
        if not d.allow:
            return [f"# {d.code}:{d.reason}", "pyautogui.press('tab')"]          # forced keyboard-navigation fallback
        if act["action"] == "click":
            return [f"computer.mouse.click({act['x']}, {act['y']})"]
        return [f"computer.keyboard.write({act.get('text', '')!r})"] if act["action"] == "type" else [f"computer.keyboard.hotkey({act.get('keys', '')!r})"]


def run(data: str | None = None) -> dict:
    tasks = [json.load(open(f, encoding="utf-8")) for f in sorted(glob.glob(os.path.join(data, "examples", "*.json")))] if data else [{"instruction": "selftest"}]
    ag = V12WaaAgent(lambda i, o, r: {"action": "click", "x": 1279, "y": 919, "id": 12})
    for _ in range(2):
        ag.gate.observe({"action": "click", "x": 1279, "y": 919, "id": 12}, False)
    out = ag.predict("selftest", {"interactive": 0})
    return {"benchmark": "WindowsAgentArena", "dataset": data or "selftest-mini", "tasks": len(tasks), "banned_click_translated_to_keyboard": out[-1] == "pyautogui.press('tab')", "sample": out}
