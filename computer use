async def s_recycle(brain: Any, allow_destructive: bool) -> dict[str, Any]:
    from agent_brain import safe_shell
    import verifiers as V

    if not IS_WIN:
        return result("recycle_com_verify", "skipped", "requires Windows")
    p = brain.cfg.workspace / f"dscu_t2_{int(time.time())}.txt"
    p.write_text("t2", encoding="utf-8")
    before = safe_shell.recycle_bin_status()
    ok, msg = safe_shell.recycle_file(p, (brain.cfg.workspace,))
    aft = safe_shell.wait_recycle_count(int(before.get("count") or 0) + 1, 6)
    contains = V.v_recycle_bin_contains({"name": p.stem}, V.Ctx())[0]
    detail = f"recycle={ok} {before.get('count')}→{aft.get('count')} COM_name_hit={contains} file_gone={not p.exists()}"
    good = ok and contains and not p.exists()
    metrics: dict[str, Any] = {"sources": aft.get("sources"), "consistent": aft.get("consistent")}
    if allow_destructive and good:
        e_ok, e_msg = safe_shell.empty_recycle_bin()
        z = safe_shell.wait_recycle_count(0, 8)
        good = good and e_ok and z.get("count") == 0 and z.get("consistent", True)
        detail += f" | empty={e_ok} COM+API count={z.get('count')} {z.get('sources')}"
    elif not allow_destructive:
        detail += " | (清空 + COM 0 残留 需 --allow-destructive)"
    return result("recycle_com_verify", "pass" if good else "fail", detail, **metrics)


async def s_paint_occlusion(brain: Any) -> dict[str, Any]:
    from tier1_micro import Gui
    from agent_brain.protocol import new_action_id
    from agent_brain.state import TaskState

    if not IS_WIN:
        return result("paint_occlusion_recovery", "skipped", "requires Windows")
