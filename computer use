"""Cross-language transport: newline-delimited JSON over TCP loopback (cdp-daemon), Unix Domain Socket, or Windows Named Pipe (dscu-driver)."""
from __future__ import annotations
import asyncio
import json
import sys


async def request(endpoint: str, msg: dict, timeout: float = 5.0) -> dict:
    """endpoint: 'tcp://127.0.0.1:9333', 'unix:///tmp/dscu.sock', or r'\\\\.\\pipe\\dscu-driver-v1'."""
    if endpoint.startswith("tcp://"):
        host, port = endpoint[6:].split(":")
        r, w = await asyncio.wait_for(asyncio.open_connection(host, int(port)), timeout)
    elif endpoint.startswith("unix://"):
        r, w = await asyncio.wait_for(asyncio.open_unix_connection(endpoint[7:]), timeout)
    elif sys.platform == "win32":
        loop = asyncio.get_running_loop()
        r = asyncio.StreamReader()
        proto = asyncio.StreamReaderProtocol(r)
        transport, _ = await loop.create_pipe_connection(lambda: proto, endpoint)  # type: ignore[attr-defined]
        w = asyncio.StreamWriter(transport, proto, r, loop)
    else:
        raise OSError("named pipes are Windows-only")
    try:
        w.write((json.dumps(msg) + "\n").encode())
        await w.drain()
        return json.loads((await asyncio.wait_for(r.readline(), timeout)).decode())
