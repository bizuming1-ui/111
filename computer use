                layer=4,
                name="Layer 4 (deepseek-flash SoM)",
                channel="vision",
                reason=f"Semantic stall or blocked_streak={blocked_streak}",
                directml_allowed=dml_ok,
                vision_detail="original" if blocked_streak >= 2 else "low",
            )

        # Layer 2: Standard desktop app via Rust UIA/JAB Headless @snapshot:ref
        return LayerDecision(
            layer=2,
            name="Layer 2 (Rust UIA/JAB Headless Ref)",
            channel="uia",
