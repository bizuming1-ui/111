//! Physical input: SendInput with Fitts'-law humanized pointer paths, scan-code keyboard, Unicode typing,
//! user-activity yielding, and a JobObject that owns every process the agent launches (KILL_ON_JOB_CLOSE).
use std::sync::atomic::{AtomicU32, Ordering};
use std::thread::sleep;
use std::time::Duration;
use windows::core::PCWSTR;
use windows::Win32::Foundation::*;
use windows::Win32::System::JobObjects::*;
use windows::Win32::System::SystemInformation::GetTickCount;
use windows::Win32::System::Threading::*;
use windows::Win32::UI::Input::KeyboardAndMouse::*;
use windows::Win32::UI::WindowsAndMessaging::*;

static LAST_OWN_TICK: AtomicU32 = AtomicU32::new(0);

fn tick() -> u32 {
    unsafe { GetTickCount() }
}

pub fn user_idle_ms() -> u32 {
    let mut li = LASTINPUTINFO { cbSize: std::mem::size_of::<LASTINPUTINFO>() as u32, dwTime: 0 };
    unsafe {
        if GetLastInputInfo(&mut li).as_bool() {
            return tick().wrapping_sub(li.dwTime);
        }
    }
    u32::MAX
}

/// True when a *human* touched mouse/keyboard after our last synthetic input.
pub fn user_active() -> bool {
    let li_age = user_idle_ms();
    let own_age = tick().wrapping_sub(LAST_OWN_TICK.load(Ordering::Relaxed));
    li_age < 400 && li_age + 60 < own_age
}

fn mark_own() {
    LAST_OWN_TICK.store(tick(), Ordering::Relaxed);
}

fn send(inputs: &[INPUT]) -> u32 {
    mark_own();
    unsafe { SendInput(inputs, std::mem::size_of::<INPUT>() as i32) }
}

pub fn virtual_screen() -> (i32, i32, i32, i32) {
    unsafe {
        (
            GetSystemMetrics(SM_XVIRTUALSCREEN),
            GetSystemMetrics(SM_YVIRTUALSCREEN),
            GetSystemMetrics(SM_CXVIRTUALSCREEN).max(1),
            GetSystemMetrics(SM_CYVIRTUALSCREEN).max(1),
        )
    }
}

pub fn cursor() -> (i32, i32) {
    let mut p = POINT::default();
    unsafe {
        let _ = GetCursorPos(&mut p);
    }
    (p.x, p.y)
}

fn mouse_input(flags: MOUSE_EVENT_FLAGS, dx: i32, dy: i32, data: i32) -> INPUT {
    INPUT {
        r#type: INPUT_MOUSE,
        Anonymous: INPUT_0 {
            mi: MOUSEINPUT { dx, dy, mouseData: data as u32, dwFlags: flags, time: 0, dwExtraInfo: 0 },
        },
    }
}

pub fn move_abs(x: i32, y: i32) {
    let (vx, vy, vw, vh) = virtual_screen();
    let nx = ((x - vx) as i64 * 65535 / (vw - 1).max(1) as i64) as i32;
    let ny = ((y - vy) as i64 * 65535 / (vh - 1).max(1) as i64) as i32;
    send(&[mouse_input(MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK, nx, ny, 0)]);
}

/// Fitts' law: MT = a + b * log2(D / W + 1). Returns (duration_ms).
pub fn fitts_ms(dist: f64, target_w: f64) -> f64 {
    (70.0 + 105.0 * (dist / target_w.max(8.0) + 1.0).log2()).clamp(90.0, 850.0)
}

/// Humanized move along a cubic Bezier with ease-in-out and tiny overshoot-free jitter.
/// Returns Err("USER_ACTIVE") if a human grabbed the mouse mid-flight.
pub fn move_human(tx: i32, ty: i32, target_w: f64, humanize: bool) -> Result<(), &'static str> {
    let (sx, sy) = cursor();
    let dist = (((tx - sx).pow(2) + (ty - sy).pow(2)) as f64).sqrt();
    if !humanize || dist < 3.0 {
        move_abs(tx, ty);
        return Ok(());
    }
    let ms = fitts_ms(dist, target_w);
    let steps = ((ms / 8.0) as i32).max(6);
    let (dx, dy) = ((tx - sx) as f64, (ty - sy) as f64);
    let (nx, ny) = (-dy / dist.max(1.0), dx / dist.max(1.0));
    let bend = (dist * 0.08).min(60.0) * if (sx + sy) % 2 == 0 { 1.0 } else { -1.0 };
    let c1 = (sx as f64 + dx * 0.3 + nx * bend, sy as f64 + dy * 0.3 + ny * bend);
    let c2 = (sx as f64 + dx * 0.7 + nx * bend * 0.5, sy as f64 + dy * 0.7 + ny * bend * 0.5);
    let (mut lx, mut ly) = (sx, sy);
    for i in 1..=steps {
        let t = i as f64 / steps as f64;
        let e = t * t * (3.0 - 2.0 * t);
        let u = 1.0 - e;
        let px = u * u * u * sx as f64 + 3.0 * u * u * e * c1.0 + 3.0 * u * e * e * c2.0 + e * e * e * tx as f64;
        let py = u * u * u * sy as f64 + 3.0 * u * u * e * c1.1 + 3.0 * u * e * e * c2.1 + e * e * e * ty as f64;
        let (ix, iy) = (px.round() as i32, py.round() as i32);
        move_abs(ix, iy);
        lx = ix;
        ly = iy;
        sleep(Duration::from_millis(8));
        let (cx, cy) = cursor();
        if (cx - lx).abs() > 8 || (cy - ly).abs() > 8 {
            return Err("USER_ACTIVE");
        }
        if user_active() {
            return Err("USER_ACTIVE");
        }
    }
    move_abs(tx, ty);
    Ok(())
}

pub fn click(button: &str, count: u32) {
    let (d, u) = match button {
        "right" => (MOUSEEVENTF_RIGHTDOWN, MOUSEEVENTF_RIGHTUP),
        "middle" => (MOUSEEVENTF_MIDDLEDOWN, MOUSEEVENTF_MIDDLEUP),
        _ => (MOUSEEVENTF_LEFTDOWN, MOUSEEVENTF_LEFTUP),
    };
    for i in 0..count {
        send(&[mouse_input(d, 0, 0, 0)]);
        sleep(Duration::from_millis(38));
        send(&[mouse_input(u, 0, 0, 0)]);
        if i + 1 < count {
            sleep(Duration::from_millis(60));
        }
    }
}

pub fn drag(from: (i32, i32), to: (i32, i32), humanize: bool) -> Result<(), &'static str> {
    move_human(from.0, from.1, 24.0, humanize)?;
    send(&[mouse_input(MOUSEEVENTF_LEFTDOWN, 0, 0, 0)]);
    sleep(Duration::from_millis(60));
    let r = move_human(to.0, to.1, 24.0, humanize);
    sleep(Duration::from_millis(60));
    send(&[mouse_input(MOUSEEVENTF_LEFTUP, 0, 0, 0)]);
    r
}

pub fn wheel(amount: i32, horizontal: bool) {
    let f = if horizontal { MOUSEEVENTF_HWHEEL } else { MOUSEEVENTF_WHEEL };
    send(&[mouse_input(f, 0, 0, amount * 120)]);
}

fn kb(vk: u16, scan: u16, flags: KEYBD_EVENT_FLAGS) -> INPUT {
    INPUT {
        r#type: INPUT_KEYBOARD,
        Anonymous: INPUT_0 {
            ki: KEYBDINPUT { wVk: VIRTUAL_KEY(vk), wScan: scan, dwFlags: flags, time: 0, dwExtraInfo: 0 },
        },
    }
}

/// Type arbitrary Unicode text via KEYEVENTF_UNICODE (IME-safe: bypasses the keyboard layout).
pub fn type_text(text: &str) {
    for u in text.encode_utf16() {
        send(&[kb(0, u, KEYEVENTF_UNICODE), kb(0, u, KEYEVENTF_UNICODE | KEYEVENTF_KEYUP)]);
        sleep(Duration::from_millis(4));
    }
}

fn vk_of(tok: &str) -> Option<(u16, bool)> {
    let t = tok.to_lowercase();
    let r = match t.as_str() {
        "ctrl" | "control" => (VK_CONTROL.0, false),
        "shift" => (VK_SHIFT.0, false),
        "alt" | "menu" => (VK_MENU.0, false),
        "win" | "meta" | "super" => (VK_LWIN.0, true),
        "enter" | "return" => (VK_RETURN.0, false),
        "tab" => (VK_TAB.0, false),
        "esc" | "escape" => (VK_ESCAPE.0, false),
        "space" => (VK_SPACE.0, false),
        "backspace" | "bs" => (VK_BACK.0, false),
        "delete" | "del" => (VK_DELETE.0, true),
        "insert" | "ins" => (VK_INSERT.0, true),
        "home" => (VK_HOME.0, true),
        "end" => (VK_END.0, true),
        "pageup" | "pgup" => (VK_PRIOR.0, true),
        "pagedown" | "pgdn" => (VK_NEXT.0, true),
        "up" => (VK_UP.0, true),
        "down" => (VK_DOWN.0, true),
        "left" => (VK_LEFT.0, true),
        "right" => (VK_RIGHT.0, true),
        "#" => return Some((b'3' as u16, false)), // handled by caller with shift
        _ => {
            if let Some(n) = t.strip_prefix('f').and_then(|n| n.parse::<u16>().ok()) {
                if (1..=24).contains(&n) {
                    return Some((VK_F1.0 + n - 1, false));
                }
            }
            if t.chars().count() == 1 {
                let c = t.chars().next().unwrap();
                if c.is_ascii_alphanumeric() {
                    return Some((c.to_ascii_uppercase() as u16, false));
                }
                let vk = unsafe { VkKeyScanW(c as u16) };
                if vk != -1 {
                    return Some(((vk & 0xff) as u16, false));
                }
            }
            return None;
        }
    };
    Some(r)
}

/// "ctrl+s", "alt+f4", "tab tab enter". Returns the normalized list of chords actually sent.
pub fn press(keys: &str) -> Result<Vec<String>, String> {
    let mut sent = Vec::new();
    for chord in keys.split_whitespace() {
        let mut toks: Vec<&str> = chord.split('+').filter(|s| !s.is_empty()).collect();
        let mut shift_extra = false;
        if chord == "#" {
            toks = vec!["shift", "3"];
            shift_extra = true;
        }
        let mut vks: Vec<(u16, bool)> = Vec::new();
        for t in &toks {
            vks.push(vk_of(t).ok_or_else(|| format!("unknown key '{}'", t))?);
        }
        let _ = shift_extra;
        let mut seq = Vec::new();
        for (vk, ext) in &vks {
            let sc = unsafe { MapVirtualKeyW(*vk as u32, MAPVK_VK_TO_VSC) } as u16;
            let mut f = KEYBD_EVENT_FLAGS(0);
            if *ext {
                f |= KEYEVENTF_EXTENDEDKEY;
            }
            seq.push(kb(*vk, sc, f));
        }
        for (vk, ext) in vks.iter().rev() {
            let sc = unsafe { MapVirtualKeyW(*vk as u32, MAPVK_VK_TO_VSC) } as u16;
            let mut f = KEYEVENTF_KEYUP;
            if *ext {
                f |= KEYEVENTF_EXTENDEDKEY;
            }
            seq.push(kb(*vk, sc, f));
        }
        send(&seq);
        sent.push(chord.to_lowercase());
        sleep(Duration::from_millis(35));
    }
    Ok(sent)
}

// ---------------------------------------------------------------- JobObject (process-tree lock)
pub struct Job(HANDLE);
unsafe impl Send for Job {}

impl Job {
    pub fn new() -> Option<Job> {
        unsafe {
            let h = CreateJobObjectW(None, PCWSTR::null()).ok()?;
            let mut info = JOBOBJECT_EXTENDED_LIMIT_INFORMATION::default();
            info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
            SetInformationJobObject(
                h,
                JobObjectExtendedLimitInformation,
                &info as *const _ as *const _,
                std::mem::size_of::<JOBOBJECT_EXTENDED_LIMIT_INFORMATION>() as u32,
            )
            .ok()?;
            Some(Job(h))
        }
    }

    /// Assign by pid (works for processes spawned through ShellExecute too, as long as we can open them).
    pub fn adopt_pid(&self, pid: u32) -> bool {
        unsafe {
            match OpenProcess(PROCESS_SET_QUOTA | PROCESS_TERMINATE, false, pid) {
                Ok(h) => {
                    let ok = AssignProcessToJobObject(self.0, h).is_ok();
                    let _ = CloseHandle(h);
                    ok
                }
                Err(_) => false,
            }
        }
    }
}
