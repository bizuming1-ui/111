    """HxWx3 uint8 RGB -> (1x3xSxS float32 [0,1], scale, pad_x, pad_y).  Aspect preserved, 114-grey padding (Ultralytics convention)."""
    import numpy as np
    from PIL import Image

    h, w = arr.shape[:2]
    r = min(size / h, size / w)
    nw, nh = max(1, int(round(w * r))), max(1, int(round(h * r)))
    im = Image.fromarray(arr).resize((nw, nh), Image.BILINEAR)
    canvas = np.full((size, size, 3), 114, dtype=np.uint8)
    px, py = (size - nw) // 2, (size - nh) // 2
    canvas[py:py + nh, px:px + nw] = np.asarray(im)
    x = (canvas.astype(np.float32) / 255.0).transpose(2, 0, 1)[None]
    return np.ascontiguousarray(x), r, px, py


def nms(boxes: Any, scores: Any, thr: float = 0.5) -> list[int]:
    import numpy as np

    x1, y1, x2, y2 = boxes[:, 0], boxes[:, 1], boxes[:, 2], boxes[:, 3]
    areas = (x2 - x1).clip(0) * (y2 - y1).clip(0)
    order = scores.argsort()[::-1]
    keep: list[int] = []
    while order.size:
        i = int(order[0])
        keep.append(i)
        if order.size == 1:
            break
        rest = order[1:]
        xx1, yy1 = np.maximum(x1[i], x1[rest]), np.maximum(y1[i], y1[rest])
        xx2, yy2 = np.minimum(x2[i], x2[rest]), np.minimum(y2[i], y2[rest])
        inter = (xx2 - xx1).clip(0) * (yy2 - yy1).clip(0)
        iou = inter / (areas[i] + areas[rest] - inter + 1e-9)
        order = rest[iou <= thr]
    return keep


def decode_yolo(out: Any, scale: float, pad_x: int, pad_y: int, src_w: int, src_h: int, conf: float = 0.08, iou: float = 0.45, max_det: int = 150) -> list[dict[str, Any]]:
    """YOLOv8 output [1, 4+nc, N] (cx,cy,w,h in letterbox pixels, then class scores) -> [{'box':[x,y,w,h], 'score', 'cls'}] in SOURCE pixels."""
    import numpy as np

    p = np.asarray(out)[0]
    if p.shape[0] < p.shape[1]:
        p = p.T  # -> [N, 4+nc]
    sc_all = p[:, 4:]
    cls = sc_all.argmax(1)
    sc = sc_all.max(1)
    m = sc >= conf
    p, cls, sc = p[m], cls[m], sc[m]
    if not len(p):
        return []
    cx, cy, w, h = p[:, 0], p[:, 1], p[:, 2], p[:, 3]
    b = np.stack([cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2], 1)
    keep = nms(b, sc, iou)[:max_det]
    res = []
    for i in keep:
        x1 = float(np.clip((b[i, 0] - pad_x) / scale, 0, src_w))
        y1 = float(np.clip((b[i, 1] - pad_y) / scale, 0, src_h))
        x2 = float(np.clip((b[i, 2] - pad_x) / scale, 0, src_w))
        y2 = float(np.clip((b[i, 3] - pad_y) / scale, 0, src_h))
        if x2 - x1 < 4 or y2 - y1 < 4:
            continue
        res.append({"box": [int(x1), int(y1), int(x2 - x1), int(y2 - y1)], "score": round(float(sc[i]), 4), "cls": int(cls[i])})
    return res


def _intersects(a: list[int], b: list[int]) -> float:
    """fraction of `a` covered by `b`"""
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    ix, iy = max(ax, bx), max(ay, by)
    ex, ey = min(ax + aw, bx + bw), min(ay + ah, by + bh)
    if ex <= ix or ey <= iy:
        return 0.0
    return ((ex - ix) * (ey - iy)) / max(1, aw * ah)



def _area(r: list[int]) -> int:
    return max(1, int(r[2])) * max(1, int(r[3]))


def _inter(a: list[int], b: list[int]) -> int:
    ix, iy = max(a[0], b[0]), max(a[1], b[1])
    ex, ey = min(a[0] + a[2], b[0] + b[2]), min(a[1] + a[3], b[1] + b[3])
    return 0 if ex <= ix or ey <= iy else (ex - ix) * (ey - iy)


def iou(a: list[int], b: list[int]) -> float:
    i = _inter(a, b)
    return i / float(_area(a) + _area(b) - i) if i else 0.0


def label_boxes(cands: list[dict[str, Any]], texts: list[tuple[list[int], str, str]], max_label: int = 40) -> list[dict[str, Any]]:
    """v17.1 IoU / spatial-containment fusion of detector boxes and text (UIA names or local OCR lines), all in SCREEN coordinates.

    Assignment rule (1 text -> at most 1 box):  a text goes to the TIGHTEST box that contains >= 50 % of the text area (ties: higher IoU).  A box that is itself
    >= 60 % covered by a wide text line (icon sitting inside a text run) also qualifies.  Several OCR fragments inside one box are concatenated in reading order.
    UIA names always win over OCR (accessibility names are exact, OCR is probabilistic).  Unassigned readable text is kept as text-only items, de-duplicated."""
    assign: dict[int, list[tuple[int, float, float, str, str, list[int]]]] = {}
    taken: set[int] = set()
    for j, (r, t, src) in enumerate(texts):
        if not t or not t.strip() or len(r) != 4:
            continue
        best: Optional[tuple[float, float, int, int]] = None  # (contains-flag, iou, -area, box index)
        for i, c in enumerate(cands):
            b = c["box"]
            cov_t = _inter(r, b) / float(_area(r))
            cov_b = _inter(r, b) / float(_area(b))
            if cov_t >= 0.5 or cov_b >= 0.6:
                key = (1.0 if cov_t >= 0.5 else 0.0, iou(r, b), -_area(b), i)  # prefer: box contains the text > larger IoU > tighter box
                if best is None or key[:3] > best[:3]:
                    best = key
        if best is not None:
            assign.setdefault(best[3], []).append((j, best[0], best[1], t, src, list(r)))
            taken.add(j)
    out: list[dict[str, Any]] = []
    for i, c in enumerate(cands):
        item = dict(c)
        got = assign.get(i, [])
        if got:
            uia = [g for g in got if g[4] == "uia"]
            use = uia or got
            use = sorted(use, key=lambda g: (g[5][1] // 12, g[5][0]))  # reading order (row band, then x)
            txt = " ".join(" ".join(g[3].split()) for g in use)
            item["text"], item["text_src"] = txt[:max_label], ("uia" if uia else use[0][4])
            item["iou"] = round(max(g[2] for g in use), 3)
        else:
            item["text"], item["text_src"], item["iou"] = "", "", 0.0
        out.append(item)
    seen_txt: list[tuple[list[int], str]] = []
    for j, (r, t, src) in enumerate(texts):
        if j in taken or not t or not t.strip() or len(r) != 4:
            continue
        key = " ".join(t.split())
        if any(k == key and iou(r, rr) > 0.6 for rr, k in seen_txt):
            continue
        seen_txt.append((list(r), key))
        out.append({"box": list(r), "score": 0.0, "cls": -1, "text": key[:max_label], "text_src": src, "iou": 0.0})
    out.sort(key=lambda d: (d["box"][1] // 24, d["box"][0]))
    return out


def format_structured(items: list[dict[str, Any]], limit: int = 90) -> str:
    """The text list the text-LLM acts on:  [id] Box(x,y,w,h) text"""
    rows = []
    for i, it in enumerate(items[:limit], 1):
        x, y, w, h = it["box"]
        t = it.get("text") or ""
        t = f'"{t}"' if t else ("(icon)" if it.get("cls", 0) >= 0 else "")  # v17.1: `[id] Box(x,y,w,h) "text"`
        rows.append(f"[{i}] Box({x},{y},{w},{h}) {t}".rstrip())
    return "\n".join(rows)


def ambiguity(items: list[dict[str, Any]]) -> tuple[bool, str]:
    """Decide whether the cheap text path (deepseek-chat) is enough.  Ambiguous => escalate to the vision model."""
    n = len(items)
    if n < 3:
        return True, f"候选框过少({n})"
    if n > 140:
        return True, f"候选框过多({n})"
    labelled = sum(1 for it in items if it.get("text"))
    if labelled / n < 0.25:
        return True, f"带文本比例仅 {labelled}/{n}"
    texts = [it["text"] for it in items if it.get("text")]
    dup = len(texts) - len(set(texts))
    if dup > max(4, len(texts) // 3):
        return True, f"重复文本过多({dup})"
    return False, f"候选 {n} · 带文本 {labelled}"



# ===================================================================================== OCR (optional; never fatal)
# v17.1 ROOT CAUSE of `dml_detector.py:314 RuntimeWarning: coroutine 'ocr_words.<locals>.run' was never awaited`:
#   ocr_words() is called synchronously from code that runs INSIDE the orchestrator's event loop.  `asyncio.run(<coro>)` then raises
#   "asyncio.run() cannot be called from a running event loop" AFTER the coroutine object was created -> the coroutine is never awaited, the
#   generic `except Exception: return []` hid the error, and DirectML boxes silently lost ALL their local OCR text.
# FIX: one persistent daemon thread owns ONE private event loop; every OCR coroutine is scheduled on it with run_coroutine_threadsafe(...).result().
#      That is a real `await` on a loop that is never the caller's loop -> legal from sync code, from inside a running loop and from worker threads.
import asyncio  # noqa: E402
import io  # noqa: E402

OCR_TIMEOUT_S = 20.0
_OCR_STATS: dict[str, Any] = {"calls": 0, "ok": 0, "errors": 0, "lines": 0, "last_error": "", "ms_total": 0.0, "backend": ""}


class _OcrLoopThread:
    """Persistent single-thread event loop dedicated to WinRT OCR (the WinRT OcrEngine is created once per thread and reused)."""

    def __init__(self) -> None:
        self.loop = asyncio.new_event_loop()
        self._ready = threading.Event()
        self.thread = threading.Thread(target=self._main, name="dscu-ocr-loop", daemon=True)
        self.thread.start()
        self._ready.wait(5.0)

    def _main(self) -> None:
        asyncio.set_event_loop(self.loop)
        self._ready.set()
        self.loop.run_forever()

    def run(self, coro: Any, timeout: float = OCR_TIMEOUT_S) -> Any:
        try:
            fut = asyncio.run_coroutine_threadsafe(coro, self.loop)
        except BaseException:
            coro.close()  # scheduling failed -> the coroutine object must still be finalised (no 'never awaited' warning)
            raise
        try:
            return fut.result(timeout)
        except BaseException:
            fut.cancel()
            raise


_OCR_BRIDGE: Optional[_OcrLoopThread] = None
_OCR_BRIDGE_LOCK = threading.Lock()


def _ocr_bridge() -> _OcrLoopThread:
    global _OCR_BRIDGE
    with _OCR_BRIDGE_LOCK:
        if _OCR_BRIDGE is None or not _OCR_BRIDGE.thread.is_alive():
            _OCR_BRIDGE = _OcrLoopThread()
        return _OCR_BRIDGE


def _ocr_available() -> bool:
    try:
        import winrt.windows.media.ocr  # noqa: F401  # type: ignore[import-not-found]

        return True
    except Exception:  # noqa: BLE001
        return False


_WINRT_ENGINE: Any = None


async def _winrt_recognize(png: bytes) -> list[tuple[list[int], str, str]]:
    """Windows.Media.Ocr over the `winrt-*` projection.  Runs ONLY on the dedicated OCR loop (see _OcrLoopThread)."""
    global _WINRT_ENGINE
    from winrt.windows.graphics.imaging import BitmapDecoder  # type: ignore[import-not-found]
    from winrt.windows.media.ocr import OcrEngine  # type: ignore[import-not-found]
    from winrt.windows.storage.streams import DataWriter, InMemoryRandomAccessStream  # type: ignore[import-not-found]

    if _WINRT_ENGINE is None:
        eng = OcrEngine.try_create_from_user_profile_languages()
        if eng is None:  # user profile has no OCR language pack -> try the common ones explicitly
            try:
                from winrt.windows.globalization import Language  # type: ignore[import-not-found]

                for tag in ("zh-Hans-CN", "zh-CN", "en-US"):
                    lang = Language(tag)
                    if OcrEngine.is_language_supported(lang):
                        eng = OcrEngine.try_create_from_language(lang)
                        if eng is not None:
                            break
            except Exception:  # noqa: BLE001
                eng = None
        _WINRT_ENGINE = eng
    eng = _WINRT_ENGINE
    if eng is None:
        return []
    stream = InMemoryRandomAccessStream()
    w = DataWriter(stream)
    w.write_bytes(png)
    await w.store_async()
    stream.seek(0)
    dec = await BitmapDecoder.create_async(stream)
    bmp = await dec.get_software_bitmap_async()
    res = await eng.recognize_async(bmp)
    out: list[tuple[list[int], str, str]] = []
    for ln in res.lines:
        words = list(ln.words)
        if not words:
            continue
        x0 = min(w_.bounding_rect.x for w_ in words)
        y0 = min(w_.bounding_rect.y for w_ in words)
        x1 = max(w_.bounding_rect.x + w_.bounding_rect.width for w_ in words)
        y1 = max(w_.bounding_rect.y + w_.bounding_rect.height for w_ in words)
        out.append(([int(x0), int(y0), int(x1 - x0), int(y1 - y0)], ln.text, "ocr"))
    return out


def _png_bytes(image: Any) -> bytes:
    buf = io.BytesIO()
    image.convert("RGB").save(buf, "PNG")
    return buf.getvalue()


async def ocr_words_async(image: Any, recognizer: Any = None) -> list[tuple[list[int], str, str]]:
    """Async twin: use from `async def` code — plain `await`, no thread bridge needed (the WinRT call still runs on the OCR loop)."""
    if os.environ.get("DSCU_OCR") == "0":
        return []
    png = _png_bytes(image)
    rec = recognizer or _winrt_recognize
    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, lambda: _ocr_bridge().run(rec(png)))


def ocr_words(image: Any, recognizer: Any = None) -> list[tuple[list[int], str, str]]:
    """Windows OCR -> [(rect[x,y,w,h] in IMAGE pixels, text, "ocr")].  Safe from sync code, from inside a running event loop and from threads.
    `recognizer` (async fn: png_bytes -> list) is a test seam; production uses `_winrt_recognize`.  Returns [] (counted in _OCR_STATS) when OCR is unavailable."""
    if os.environ.get("DSCU_OCR") == "0":
        return []
    if recognizer is None and (sys.platform != "win32" or not _ocr_available()):
        return []
    t0 = time.perf_counter()
    _OCR_STATS["calls"] += 1
    try:
        png = _png_bytes(image)
        out = _ocr_bridge().run((recognizer or _winrt_recognize)(png))
        _OCR_STATS["ok"] += 1
        _OCR_STATS["lines"] += len(out)
        _OCR_STATS["backend"] = "injected" if recognizer else "winrt"
        return list(out)
    except Exception as e:  # noqa: BLE001  OCR is optional; but the failure is now RECORDED instead of swallowed
        _OCR_STATS["errors"] += 1
        _OCR_STATS["last_error"] = f"{type(e).__name__}: {str(e)[:120]}"
        return []
    finally:
        _OCR_STATS["ms_total"] += (time.perf_counter() - t0) * 1000


def ocr_stats() -> dict[str, Any]:
    return dict(_OCR_STATS)


# ===================================================================================== detector
class DmlDetector:
    def __init__(self, model: Optional[Path] = None) -> None:
        self.user_model = Path(model or os.environ["DSCU_DML_MODEL"]) if (model or os.environ.get("DSCU_DML_MODEL")) else None
        self.model_path: Path = self.user_model or default_model_path()
        self.is_user_model = self.user_model is not None
        self.sess: Any = None
        self.provider = ""
        self.providers: list[str] = []
        self.adapter = ""
        self.last_use = 0.0
        self.lock = threading.RLock()
        self.timer: Optional[threading.Timer] = None
        self.reason = ""
        self.model_sha = ""
        self.sha_verified = False
        self.lat_ms: list[float] = []
        self.inferences = 0
        self.detections = 0
        self.breaker_until = 0.0
        self.breaker_trips = 0
        self.loaded_at = 0.0
        self.allow_cpu = os.environ.get("DSCU_DML_ALLOW_CPU") == "1"
        self.infer_ms = 0.0
        self.floor = int(os.environ.get("DSCU_TEST_FLOOR_MB", MEMORY_FLOOR_MB)) if self.allow_cpu else MEMORY_FLOOR_MB  # override ONLY in CPU test mode
        self.last: dict[str, Any] = {}  # latest structured result (consumed by the brain's text route)
        self.text_calls = 0
        self.escalations = 0

    # ------------------------------------------------------------------ truth table
    @property
    def trained(self) -> bool:
        return self.sha_verified or (self.is_user_model and self.model_path.exists())

    @property
    def state(self) -> str:
        if self.sess is None:
            return "disabled"
        if self.provider == "DmlExecutionProvider" and self.trained:
            return "enabled"
        return "cpu_fallback"

    def enabled(self) -> bool:
        if os.environ.get("DSCU_DML") == "0" or time.time() < self.breaker_until:
            return False
        if self.sess is not None:
            return self.state == "enabled" or self.allow_cpu
        if not self.model_path.exists():
            self.reason = self.reason or "model_missing（运行 DSCU_MODE=dml-init 或 python -m sidecar.dml_detector --init）"
            return False
        try:
            import onnxruntime as ort

            return ("DmlExecutionProvider" in ort.get_available_providers() or self.allow_cpu) and _free_mb() >= self.floor
        except Exception:  # noqa: BLE001
            return False

    def evidence(self) -> dict[str, Any]:
        return {"model_file": self.model_path.name, "model_path": str(self.model_path), "model_sha256": self.model_sha, "sha256_pinned_ok": self.sha_verified,
                "model_kind": "user_model" if self.is_user_model else "omniparser_icon_detect_yolov8_trained", "builtin_untrained_saliency": False,
                "state": self.state, "execution_provider_bound": self.provider, "providers_in_session": self.providers, "adapter": self.adapter,
                "inferences": self.inferences, "detections_total": self.detections,
                "latency_ms": {"p50": _pct(self.lat_ms, .50), "p95": _pct(self.lat_ms, .95), "p99": _pct(self.lat_ms, .99), "n": len(self.lat_ms)},
                "memory_floor_mb": MEMORY_FLOOR_MB, "idle_unload_s": IDLE_UNLOAD_S, "free_mb": round(_free_mb()), "breaker_trips": self.breaker_trips,
                "breaker_open": time.time() < self.breaker_until, "loaded": self.sess is not None, "reason": self.reason,
                "text_route_calls": self.text_calls, "vision_escalations": self.escalations, "p50_target_ms": P50_TARGET_MS}

    def status(self) -> dict[str, Any]:
        d: dict[str, Any] = {"memory_floor_mb": MEMORY_FLOOR_MB, "idle_unload_s": IDLE_UNLOAD_S, "free_mb": round(_free_mb()), "model": str(self.model_path),
                             "model_exists": self.model_path.exists(), "provider": self.provider, "reason": self.reason, "ocr": _ocr_available()}
        try:
            import onnxruntime as ort

            d["ort_version"] = ort.__version__
            d["providers"] = ort.get_available_providers()
            d["directml"] = "DmlExecutionProvider" in d["providers"]
        except Exception as e:  # noqa: BLE001
            d["ort_version"], d["providers"], d["directml"] = None, [], False
            d["reason"] = d["reason"] or f"onnxruntime not installed ({e.__class__.__name__}); pip install onnxruntime-directml"
        return d

    # ------------------------------------------------------------------ lifecycle
    @staticmethod
    def _adapter_name() -> str:
        if sys.platform != "win32":
            return ""
        try:
            exe = "pwsh" if subprocess.call("where pwsh", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0 else "powershell"
            out = subprocess.run([exe, "-NoProfile", "-Command", "(Get-CimInstance Win32_VideoController | ForEach-Object { $_.Name }) -join '|'"], capture_output=True,
                                 timeout=15, creationflags=0x08000000).stdout.decode("utf-8", "replace").strip()
            return out
        except Exception:  # noqa: BLE001
            return ""

    def load(self) -> bool:
        with self.lock:
            if self.sess is not None:
                self.last_use = time.time()
                return True
            if time.time() < self.breaker_until:
                self.reason = "memory_breaker_open"
                return False
            if _free_mb() < self.floor:
                self.reason = f"memory_floor: free {_free_mb():.0f} MB < {self.floor} MB"
                return False
            try:
                import onnxruntime as ort

                avail = ort.get_available_providers()
                if "DmlExecutionProvider" not in avail and not self.allow_cpu:
                    self.reason = "DirectML provider missing: pip uninstall onnxruntime ; pip install onnxruntime-directml"
                    return False
                if not self.model_path.exists():
                    self.reason = "model_missing（DSCU_MODE=dml-init 自动下载并校验 SHA-256）"
                    return False
                self.model_sha = sha256_file(self.model_path)
                self.sha_verified = (self.model_sha == MODEL_SHA256) and not self.is_user_model
                if not self.is_user_model and not self.sha_verified:
                    self.reason = f"model_sha256_mismatch {self.model_sha[:16]}… ≠ {MODEL_SHA256[:16]}…（拒绝加载）"
                    return False
                so = ort.SessionOptions()
                so.enable_mem_pattern = False  # DirectML requirement
                so.execution_mode = ort.ExecutionMode.ORT_SEQUENTIAL
                so.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL
                prov: list[Any] = []
                if "DmlExecutionProvider" in avail:
                    prov.append(("DmlExecutionProvider", {"device_id": int(os.environ.get("DSCU_DML_DEVICE_ID", "0"))}))
                if self.allow_cpu or not prov:
                    prov.append("CPUExecutionProvider")
                self.sess = ort.InferenceSession(str(self.model_path), sess_options=so, providers=prov)
                self.providers = list(self.sess.get_providers())
                self.provider = self.providers[0] if self.providers else ""
                if "DmlExecutionProvider" in avail and self.provider != "DmlExecutionProvider":
                    self.reason = f"DML 未绑定（实际 {self.providers}）"
                self.adapter = self.adapter or self._adapter_name()
                if not self.reason.startswith("DML 未绑定"):
                    self.reason = ""
            except Exception as e:  # noqa: BLE001
                self.reason = f"load_failed: {e}"
                self.sess = None
                return False
            self.loaded_at = self.last_use = time.time()
            self._arm_timer()
            return True

    def _arm_timer(self) -> None:
        if self.timer:
            self.timer.cancel()
        self.timer = threading.Timer(IDLE_UNLOAD_S + 1, self._idle_check)
        self.timer.daemon = True
        self.timer.start()

    def _idle_check(self) -> None:
        if self.sess is not None and time.time() - self.last_use >= IDLE_UNLOAD_S:
            self.unload("idle>180s")
        elif self.sess is not None:
            self._arm_timer()

    def unload(self, why: str = "manual") -> None:
        with self.lock:
            self.sess = None
            self.reason = f"unloaded: {why}"
        import gc

        gc.collect()

    def _floor_ok(self) -> bool:
        free = _free_mb()
        if free < self.floor:
            self.breaker_trips += 1
            self.breaker_until = time.time() + BREAKER_COOLDOWN_S
            self.unload(f"memory_floor_breaker free={free:.0f}MB<{self.floor}MB")
            return False
        return True

    # ------------------------------------------------------------------ inference
    def detect(self, image: Any, conf: float = 0.08, iou: float = 0.45) -> list[dict[str, Any]]:
        """image: PIL.Image or HxWx3 uint8 RGB ndarray -> [{'box':[x,y,w,h],'score','cls'}] in source pixels ([] + self.reason when unavailable)."""
        import numpy as np

        if not self._floor_ok() or not self.load():
            return []
        arr = np.asarray(image.convert("RGB") if hasattr(image, "convert") else image)
        H, W = arr.shape[:2]
        x, r, px, py = letterbox(arr, IN_W)
        inp = self.sess.get_inputs()[0]
        t0 = time.perf_counter()
        outs = self.sess.run(None, {inp.name: x})
        ms = (time.perf_counter() - t0) * 1000
        self.infer_ms = ms
        self.lat_ms.append(ms)
        del self.lat_ms[:-2000]
        self.inferences += 1
        self.last_use = time.time()
        res = decode_yolo(outs[0], r, px, py, W, H, conf, iou)
        self.detections += len(res)
        return res

    def describe(self, image: Any, uia_texts: Optional[list[tuple[list[int], str]]] = None, use_ocr: bool = True, origin: tuple[int, int] = (0, 0),
                 scale: float = 1.0) -> dict[str, Any]:
        """Boxes + text -> structured list.  `origin`/`scale` map image pixels to SCREEN coordinates: X = origin_x + x / scale.
        `uia_texts` are in SCREEN coordinates (rect, name)."""
        t0 = time.perf_counter()
        cands = self.detect(image)
        ox, oy = origin
        k = 1.0 / scale if scale else 1.0
        screen = [{**c, "box": [int(ox + c["box"][0] * k), int(oy + c["box"][1] * k), int(c["box"][2] * k), int(c["box"][3] * k)]} for c in cands]
        texts: list[tuple[list[int], str, str]] = [(list(r), t, "uia") for r, t in (uia_texts or []) if t and t.strip()]
        if use_ocr and len(texts) < max(6, len(screen) // 4):
            for r, t, src in ocr_words(image):
                texts.append(([int(ox + r[0] * k), int(oy + r[1] * k), int(r[2] * k), int(r[3] * k)], t, src))
        items = label_boxes(screen, texts)
        amb, why = ambiguity(items)
        _ocr_n = sum(1 for it in items if it.get("text_src") == "ocr")
        out = {"items": items, "text": format_structured(items), "ambiguous": amb, "why": why, "ms": round((time.perf_counter() - t0) * 1000, 1),
               "dml_ms": round(self.infer_ms, 2), "ts": time.time(), "ocr_labelled": _ocr_n, "ocr": ocr_stats()}
        self.last = out
        return out

    # ------------------------------------------------------------------ evidence banners
    def startup_banner(self, warmup: int = 6) -> str:
        """Load (if allowed) and run `warmup` REAL inferences on a synthetic UI frame so the startup log already carries measured numbers."""
        if os.environ.get("DSCU_DML") == "0":
            return "  🎮 DirectML 侧车：已被 DSCU_DML=0 关闭"
        try:
            from PIL import Image, ImageDraw

            im = Image.new("RGB", (1920, 1080), (243, 243, 243))
            d = ImageDraw.Draw(im)
            d.rectangle([0, 0, 1920, 48], fill=(32, 32, 32))
            for i in range(8):
                d.rounded_rectangle([40 + i * 150, 80, 150 + i * 150, 126], radius=8, fill=(0, 103, 192))
                d.ellipse([60 + i * 150, 200, 108 + i * 150, 248], fill=(60, 60, 60))
            for _ in range(max(1, warmup)):
                self.detect(im)
        except Exception as e:  # noqa: BLE001
            self.reason = self.reason or f"warmup_failed: {e}"
        return self.banner("启动")

    def evidence_line(self) -> str:
        e = self.evidence()
        l = e["latency_ms"]
        return (f"DirectML={'enabled' if e['state'] == 'enabled' else e['state']} EP={e['execution_provider_bound'] or '-'} model_sha256={e['model_sha256'] or '-'} "
                f"inferences={e['inferences']} dml_p50_ms={l['p50']} dml_p95_ms={l['p95']}")

    def banner(self, phase: str) -> str:
        e = self.evidence()
        if not e["loaded"] and not e["inferences"]:
            return f"  🎮 DirectML 侧车[{phase}]：DirectML=disabled · 原因：{e['reason'] or 'not_loaded'} · 内存地板 {MEMORY_FLOOR_MB}MB（当前空闲 {e['free_mb']}MB）"
        l = e["latency_ms"]
        ok50 = "✓" if l["n"] and l["p50"] <= P50_TARGET_MS else "✗"
        return (f"  🎮 DirectML 侧车[{phase}]：{self.evidence_line()}\n"
                f"       模型={e['model_file']}（{e['model_kind']}；SHA-256 {'与固定值一致' if e['sha256_pinned_ok'] else '用户模型/未固定'}） · 适配器={e['adapter'] or '未知'}"
                f" · p50≤{P50_TARGET_MS:.0f}ms {ok50} · p99={l['p99']}ms · 文本直连 {e['text_route_calls']} 次 / 视觉升级 {e['vision_escalations']} 次"
                f" · 内存地板 {MEMORY_FLOOR_MB}MB（空闲 {e['free_mb']}MB · 熔断 {e['breaker_trips']} 次）")

    _banner = banner  # backward-compatible alias (v16.3 name)

    def shutdown_report(self) -> str:
        txt = self.banner("结束")
        try:
            p = _root() / "eval_runs"
            p.mkdir(parents=True, exist_ok=True)
            (p / "dml_evidence.json").write_text(json.dumps(self.evidence(), ensure_ascii=False, indent=2), encoding="utf-8")
        except Exception:  # noqa: BLE001
            pass
        return txt


_DET: Optional[DmlDetector] = None


def get() -> DmlDetector:
    global _DET
    if _DET is None:
        _DET = DmlDetector()
    return _DET


def status_text() -> str:
    d = get()
    st = d.status()
    return json.dumps({**d.evidence(), **{k: st[k] for k in ("ort_version", "providers", "directml", "ocr") if k in st}}, ensure_ascii=False, indent=2)


def probe(n: int = 60, allow_cpu: bool = False) -> int:
    """Exit 0 only when a TRAINED model is bound to DmlExecutionProvider (or --allow-cpu)."""
    if allow_cpu:
        os.environ["DSCU_DML_ALLOW_CPU"] = "1"
    d = DmlDetector()
    if not d.model_path.exists() and not d.is_user_model:
        p, msg = ensure_model(log=print)
        print("  " + msg)
        d = DmlDetector()
    print(d.startup_banner(warmup=3))
    try:
        from PIL import Image, ImageDraw

        im = Image.new("RGB", (2560, 1600), (250, 250, 250))
        dr = ImageDraw.Draw(im)
        for i in range(10):
            dr.rounded_rectangle([60 + i * 230, 120, 230 + i * 230, 190], radius=10, fill=(0, 103, 192))
        for _ in range(max(1, n)):
            d.detect(im)
    except Exception as e:  # noqa: BLE001
        print(f"  probe error: {e}")
    print(d.banner("基准"))
    print("  " + d.evidence_line())
    e = d.evidence()
    try:
        out = _root() / "eval_runs"
        out.mkdir(parents=True, exist_ok=True)
        (out / "dml_evidence.json").write_text(json.dumps(e, ensure_ascii=False, indent=2), encoding="utf-8")
    except Exception:  # noqa: BLE001
        pass
    return 0 if (e["state"] == "enabled" or (allow_cpu and e["inferences"] > 0)) else 2


def _main(argv: list[str]) -> int:
    if "--init" in argv:
        p, msg = ensure_model(log=print)
        print(("  ✓ " if p else "  ✖ ") + msg)
        return 0 if p else 3
    if "--status" in argv:
        print(status_text())
        return 0
    n = 60
    if "--n" in argv:
        try:
            n = int(argv[argv.index("--n") + 1])
        except (ValueError, IndexError):
            pass
    return probe(n, "--allow-cpu" in argv)


if __name__ == "__main__":
    sys.exit(_main(sys.argv[1:]))
