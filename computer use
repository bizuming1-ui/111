"""Orchestrator: plan -> route layer -> act -> verify -> checkpoint.  Layer 0 short-circuits GUI entirely."""
from __future__ import annotations
import asyncio
import json
import os
import time
from dataclasses import dataclass, field

from .checkpoint import CheckpointStore
from .cli_router import CliRouter
from .jail import TaintedContext
from .keymap import resolve_key_chord
from .layers import choose_layer
from .quota import Quota
from .skillstore import SkillStore


@dataclass
class Brain:
    workspace: str
    taint: TaintedContext = field(default_factory=TaintedContext)
    cli: CliRouter | None = None
    skills: SkillStore | None = None
    ckpt: CheckpointStore | None = None

    def __post_init__(self):
        os.makedirs(self.workspace, exist_ok=True)
        self.cli = self.cli or CliRouter(self.workspace, self.taint)
        self.skills = self.skills or SkillStore(os.path.join(self.workspace, "skills.jsonl"))
        self.ckpt = self.ckpt or CheckpointStore(os.path.join(self.workspace, "checkpoints"))

    async def run_task(self, task: str, cli_args: list[str] | None = None, expect: list[dict] | None = None) -> dict:
        t0 = time.perf_counter()
        tool = self.cli.route(task)
        dec = choose_layer(task, cli_hit=tool is not None, cdp_up=False, uia_controls=None, stalled=False, blocked=0)
        if dec.layer == 0 and tool and cli_args is not None:
            res = await self.cli.run(tool, cli_args, expect)
            self.ckpt.save("last", {"task": task, "layer": 0, "result": res.as_dict()})
            if res.ok:
                self.skills.add(task, [" ".join(cli_args)], "L0")
            return {"layer": dec.as_dict() if hasattr(dec, "as_dict") else dec.__dict__, "result": res.as_dict(),
                    "seconds": round(time.perf_counter() - t0, 3), "quota": None}
        q = Quota.from_task(task)
        return {"layer": dec.__dict__, "quota": q.fmt() if q else None, "seconds": round(time.perf_counter() - t0, 3)}


def main() -> None:
    import argparse
    ap = argparse.ArgumentParser("agent_brain")
    ap.add_argument("task"); ap.add_argument("--workspace", default=os.path.expanduser("~/DeepSeekComputerUse/workspace"))
    ap.add_argument("--keys", help="normalise a key chord and exit")
    a = ap.parse_args()
    if a.keys:
        print(resolve_key_chord(a.keys)); return
    print(json.dumps(asyncio.run(Brain(a.workspace).run_task(a.task)), ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
