"""Path Jail (Assert-SafePath) + TaintedContext — Python twin of the PowerShell zero-trust kernel."""
from __future__ import annotations
import os
import re
from dataclasses import dataclass, field
from pathlib import Path


class SecurityError(Exception):
    def __init__(self, code: str, msg: str):
        super().__init__(f"{code}: {msg}")
        self.code = code


FORBIDDEN_EXT = {".exe", ".dll", ".bat", ".cmd", ".ps1", ".vbs", ".js", ".msi", ".scr", ".lnk", ".com", ".hta"}


def assert_safe_path(path: str, root: str, op: str = "write") -> Path:
    if not path or "\x00" in path:
        raise SecurityError("SECURITY_PATH_VIOLATION", "empty/NUL path")
    if re.search(r"(^|[\\/])\.\.([\\/]|$)", path):
        raise SecurityError("SECURITY_PATH_VIOLATION", f"traversal in {path!r}")
    if re.match(r"^[\\/]{2}", path) or re.match(r"^[A-Za-z]:[\\/]{2}\?", path):
        raise SecurityError("SECURITY_PATH_VIOLATION", f"UNC/device path {path!r}")
    if re.search(r"[*?<>|]", path):
        raise SecurityError("SECURITY_PATH_VIOLATION", f"wildcard in {path!r}")
    rootp = Path(os.path.realpath(root))
    p = Path(path)
    full = Path(os.path.realpath(p if p.is_absolute() else rootp / p))
    try:
        full.relative_to(rootp)
    except ValueError:
        raise SecurityError("SECURITY_PATH_VIOLATION", f"{op} outside jail: {full} (root {rootp})") from None
    if op in ("write", "exec") and full.suffix.lower() in FORBIDDEN_EXT:
        raise SecurityError("SECURITY_EXEC_VIOLATION", f"forbidden extension {full.suffix}")
    return full


INJECTION = re.compile(r"(ignore (all )?(previous|prior) instructions|忽略(之前|以上|所有).{0,6}(指令|提示)|system prompt|you are now|"
                       r"下载并(执行|运行)|powershell\s+-enc|invoke-expression|iex\s*\()", re.I)


@dataclass
class TaintedContext:
    tainted: bool = False
    reasons: list[str] = field(default_factory=list)
    injection: bool = False

    def mark(self, reason: str, text: str = "") -> None:
        self.tainted = True
        self.reasons.append(reason)
        if text and INJECTION.search(text):
