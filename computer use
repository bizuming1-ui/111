    $pgOk = ($null -ne [DsNative61].GetMethod('PressGuard', [System.Reflection.BindingFlags]'NonPublic,Static')) -and ($null -ne [DsNative61].GetField('LastPressDev')) -and ($null -ne [DsNative61].GetField('LastReleaseDev')) -and ($null -ne [DsNative61].GetField('PressGuardFixes'))
