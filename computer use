function Get-DriftTolerance($item) {
    # 漂移 / 重新定位的容差随控件尺寸收紧：半个控件尺寸，8~40 像素。
    # v4.1 用固定 40/80 像素：Gmail 每行约 40 像素、所有复选框同名，旧容差会把相邻一行的复选框当成原来那个。
    $m = [Math]::Min([double]$item.W, [double]$item.H) * 0.5
    return [int][Math]::Max(8.0, [Math]::Min(40.0, $m))
}
function Get-GeoKey($o) { return "$($o.Type)|$([int]$o.L)|$([int]$o.T)|$([int]$o.W)|$([int]$o.H)" }
function Test-InAnyRect($o, $rects) {
    $cx = [double]$o.L + [double]$o.W / 2.0; $cy = [double]$o.T + [double]$o.H / 2.0
    foreach ($q in $rects) {
        if ($cx -ge $q.L -and $cx -le ($q.L + $q.W) -and $cy -ge $q.T -and $cy -le ($q.T + $q.H)) { return $true }
    }
