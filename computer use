WEB_VERB_RX = re.compile(r"点击|点开|点一下|单击|双击|按下|展开|下拉|打开|进入|跳转|切换到?|选择|选中|访问|前往|click|open|expand|go to|switch to|visit", re.I)
WEB_EXCLUDE_RX = re.compile(r"微信|wechat|weixin|记事本|notepad|文件夹|文件|回收站|桌面|word|excel|ppt|powershell|终端|cmd|资源管理器|设置|邮件|邮箱|gmail|删除|发送|输入|填写|搜索|搜一下|search|登录|登陆|保存|新建|创建|关闭|退出", re.I)
WEB_EXPAND_RX = re.compile(r"展开|下拉|菜单|折叠|expand|dropdown|collapse", re.I)
WEB_TAB_RX = re.compile(r"标签页|标签|选项卡|tab\b", re.I)
WEB_NAV_RX = re.compile(r"打开|进入|跳转|访问|前往|官网|网站|链接|首页|open|go to|visit", re.I)
_ORD_RX = re.compile(r"第\s*[一二三四五六七八九十两\d]+\s*(?:个|条|项|篇|行|页|张|位)?|最后一个|最后一条|the\s+(?:first|second|third|last)", re.I)
_FILLER_RX = re.compile(r"一下|一个|这个|那个|页面上的|页面|里面|里的|的|按钮|链接|菜单|选项|栏目|网站|网页|标签页|标签|请|帮我|然后|并且|并|，|,|。|\s+")


def derive_web_action(task: str) -> Optional[dict[str, str]]:
    """None => not a plain web interaction.  NEVER claims tasks that other goals own (search / form fill / file / messaging / gmail / delete ...)."""
    t = (task or "").strip()
    if not t or not WEB_VERB_RX.search(t) or WEB_EXCLUDE_RX.search(t):
        return None
    if URL_RX.search(t):
        return None  # explicit URL navigation is a NavigationGoal
    intent = "expand" if WEB_EXPAND_RX.search(t) else "tab" if WEB_TAB_RX.search(t) and re.search(r"切换|switch", t, re.I) else "navigate" if WEB_NAV_RX.search(t) and not re.search(r"点击|点开|click", t, re.I) else "click"
    tgt = WEB_VERB_RX.sub("", t)
    tgt = _ORD_RX.sub("", tgt)
    tgt = _FILLER_RX.sub("", tgt).strip("：:，,。 ")
    return {"intent": intent, "target": tgt[:40]}


def _norm_url(u: str) -> str:
    u = (u or "").strip()
    return u.split("#", 1)[0].rstrip("/") if u else ""


def _jacc_dist(a: Any, b: Any) -> float:
    sa, sb = set(a or ()), set(b or ())
    if not sa and not sb:
        return 0.0
    return 1.0 - len(sa & sb) / float(len(sa | sb))


@dataclass
class WebState:
    """One (url, title, expanded_states, dom_text_digest) sample of the attached page."""
    url: str = ""
    title: str = ""
    expanded: tuple = ()
    digest: str = ""
    lines: frozenset = frozenset()  # hashed visible text lines (probe)
    names: frozenset = frozenset()  # role|name of observed controls (a11y snapshot)
    tabs: int = 0
    active_target: str = ""
    source: str = ""
    step: int = 0


class WebStateTracker:
    """Collects BEFORE/AFTER page states for WebActionGoal.  Baseline = first sample of the task (probe at task start, else the step-1 observation)."""

    def __init__(self) -> None:
        self.samples: list[WebState] = []
        self.base: Optional[WebState] = None
        self.clicks: list[str] = []
        self.dev_tab_hits = 0

    def reset(self) -> None:
        self.samples, self.base, self.clicks = [], None, []

    @staticmethod
    def from_probe(pr: Optional[dict[str, Any]], step: int = 0) -> Optional[WebState]:
        if not isinstance(pr, dict) or "error" in pr or not pr.get("url"):
            return None
        return WebState(url=str(pr.get("url", "")), title=str(pr.get("title", "")), expanded=tuple(sorted(str(x) for x in (pr.get("expanded") or []))),
                        digest=str(pr.get("text_digest") or ""), lines=frozenset(pr.get("line_hashes") or ()), tabs=int(pr.get("tabs") or 0),
                        active_target=str(pr.get("active_target") or ""), source="cdp_probe", step=step)

    @staticmethod
    def from_obs(obs: Any, step: int = 0) -> Optional[WebState]:
        url = str(getattr(obs, "url", "") or "")
        if not url.startswith(("http://", "https://")):
            return None
        els = list(getattr(obs, "elements", []) or [])
        if not els or str(getattr(obs, "channel", "")) != "cdp":
            return None
        names = frozenset(f"{str(getattr(e, 'role', '')).lower()}|{str(getattr(e, 'name', ''))[:60]}" for e in els if getattr(e, "name", ""))
        exp = tuple(sorted(str(getattr(e, "name", ""))[:40] for e in els if "expanded" in (getattr(e, "states", None) or [])))
        return WebState(url=url, title=str(getattr(obs, "title", "") or ""), expanded=exp, digest=hashlib.sha1("\n".join(sorted(names)).encode()).hexdigest()[:16], names=names,
                        source="a11y_snapshot", step=step)

    def sample(self, obs: Any, step: int) -> None:
        s = self.from_obs(obs, step)
        if s is None:
            return
        self.samples.append(s)
        if len(self.samples) > 60:
            self.samples.pop(1 if len(self.samples) > 2 else 0)
        if self.base is None:
            self.base = s

    def note_click(self, name: str, role: str = "") -> None:
        n = " ".join(str(name or "").split())
        if n:
            self.clicks.append(n[:60])
            del self.clicks[:-12]

    def merged_base(self) -> Optional[WebState]:
        return self.base

    def last(self) -> Optional[WebState]:
        return self.samples[-1] if self.samples else None


def web_transitions(before: WebState, after: WebState, clicks: Optional[list[str]] = None) -> dict[str, Any]:
    """Objective, reproducible state-transition evidence (no model involved)."""
    url_changed = _norm_url(before.url) != _norm_url(after.url)
    title_changed = bool(before.title and after.title and before.title != after.title)
    tab_switched = bool(before.active_target and after.active_target and before.active_target != after.active_target)
    new_expanded = [x for x in after.expanded if x not in before.expanded]
    aria_expanded_true = bool(new_expanded) or (len(after.expanded) > len(before.expanded))
    d_lines = _jacc_dist(before.lines, after.lines) if (before.lines and after.lines) else 0.0
    added_names = len(after.names - before.names) if (before.names and after.names) else 0
    removed_names = len(before.names - after.names) if (before.names and after.names) else 0
    d_names = _jacc_dist(before.names, after.names) if (before.names and after.names) else 0.0
    digest_diff = bool(before.digest and after.digest and before.digest != after.digest and before.source == after.source)
    dom_mutated = d_lines >= 0.02 or d_names >= 0.03 or (added_names + removed_names) >= 2 or (digest_diff and before.source == "cdp_probe" and d_lines >= 0.01)
    return {"url_changed": url_changed, "title_changed": title_changed, "tab_switched": tab_switched, "aria_expanded_true": aria_expanded_true, "dom_mutated": dom_mutated,
            "d_lines": round(d_lines, 3), "d_names": round(d_names, 3), "added": added_names, "removed": removed_names, "new_expanded": new_expanded[:4]}


def web_evidence_text(tr: dict[str, Any]) -> str:
    order = ("dom_mutated", "url_changed", "aria_expanded_true", "tab_switched", "title_changed")
    return " · ".join(f"{'✓' if tr[k] else '✗'}{k}" for k in order)


