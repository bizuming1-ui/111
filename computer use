    use windows::Win32::UI::Shell::ShellExecuteW;
    use windows::Win32::UI::WindowsAndMessaging::*;

    struct Engine {
        cap: Capture,
        uia: Option<Uia>,
        job: Option<input::Job>,
        own: HashSet<u32>,
        replay: HashMap<String, Value>,
        order: VecDeque<String>,
        last_target: isize,
    }

    fn token_flag(class: i32) -> bool {
        unsafe {
            let mut tok = HANDLE::default();
            if OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut tok).is_err() {
                return false;
            }
            let mut v: u32 = 0;
            let mut ret = 0u32;
            let ok = GetTokenInformation(tok, TOKEN_INFORMATION_CLASS(class), Some(&mut v as *mut u32 as *mut _), 4, &mut ret).is_ok();
            let _ = CloseHandle(tok);
            ok && v != 0
        }
    }

    fn rss_mb() -> f64 {
        unsafe {
            let mut c = PROCESS_MEMORY_COUNTERS::default();
            c.cb = std::mem::size_of::<PROCESS_MEMORY_COUNTERS>() as u32;
            if K32GetProcessMemoryInfo(GetCurrentProcess(), &mut c, c.cb).as_bool() {
                return c.WorkingSetSize as f64 / 1048576.0;
            }
        }
        0.0
    }

    fn res(req: &Value, ok: bool, code: &str, msg: impl Into<String>, effect: Value, t0: Instant) -> Value {
        json!({
            "type": "action_result", "id": req["id"], "action_id": req["action_id"], "ok": ok, "code": code,
            "message": msg.into(), "effect": effect, "idempotent_replay": false,
            "latency_ms": (t0.elapsed().as_secs_f64() * 1000.0 * 10.0).round() / 10.0
        })
    }

    impl Engine {
        fn target(&mut self, req_hwnd: Option<isize>, wins: &[wnd::Win]) -> Option<wnd::Win> {
            if let Some(h) = req_hwnd {
                if h != 0 {
                    return wins.iter().find(|w| w.hwnd == h).cloned();
                }
            }
            let fg = wnd::foreground();
            if let Some(w) = wins.iter().find(|w| w.hwnd == fg && !w.own && !wnd::is_shell(w)) {
                return Some(w.clone());
            }
            // foreground is our own console / shell: fall back to the top-most real app window
            wins.iter().find(|w| !w.own && !w.minimized && !w.cloaked && !wnd::is_shell(w) && !w.title.is_empty()).cloned()
        }

        fn hello(&mut self, req: &Value) -> Value {
            if let Some(p) = req["own_pid"].as_u64() {
                self.own = wnd::own_pid_chain(p as u32);
            }
            json!({
                "type": "hello_ack", "id": req["id"], "ok": true, "peer": "dscu-driver", "version": "13.0.0",
                "caps": ["dxgi", "gdi_fallback", "uia_ref", "sendinput", "job_object", "verified_foreground", "occlusion", "idempotent_actions"],
                "uiaccess": token_flag(26), "elevated": token_flag(20), "rss_mb": rss_mb(),
                "dxgi_active": self.cap.backend_reason().is_none(), "dxgi_reason": self.cap.backend_reason()
            })
        }

        fn observe(&mut self, req: &Value) -> Value {
            let t0 = Instant::now();
            let wins = wnd::enum_windows(&self.own);
            let enum_ms = t0.elapsed().as_secs_f64() * 1000.0;
            let channel = req["channel"].as_str().unwrap_or("auto");
            let target = self.target(req["hwnd"].as_i64().map(|v| v as isize), &wins);
            let stats = self.cap.grab();
            let mut env = json!({
                "type": "observation", "id": req["id"], "ok": true, "channel": "uia",
                "snapshot_epoch": self.uia.as_ref().map(|u| u.epoch).unwrap_or(0), "hwnd": 0, "title": "", "process": "",
                "fg_hwnd": wnd::foreground(), "dxgi_stats": stats.to_json(),
                "user_idle_ms": input::user_idle_ms(),
                "screen": { "w": stats.w, "h": stats.h, "virtual": input::virtual_screen() },
                "elements": []
            });
            let mut occ: HashMap<isize, Vec<isize>> = HashMap::new();
            if let Some(t) = &target {
                occ.insert(t.hwnd, wnd::occluders(t, &wins));
                env["hwnd"] = json!(t.hwnd);
                env["title"] = json!(t.title);
                env["process"] = json!(t.process);
                env["class"] = json!(t.class);
                env["rect"] = json!(t.rect);
                self.last_target = t.hwnd;
            }
            let fgw = wins.iter().find(|w| w.hwnd == wnd::foreground()).cloned();
            if let Some(f) = &fgw {
                occ.entry(f.hwnd).or_insert_with(|| wnd::occluders(f, &wins));
            }
            env["windows"] = Value::Array(wins.iter().take(40).map(|w| w.to_json(occ.get(&w.hwnd).map(|v| v.as_slice()).unwrap_or(&[]))).collect());
            let mut uia_ms = 0.0;
            if channel == "jab" {
                env["ok"] = json!(false);
                env["error"] = json!({"code": "UNSUPPORTED", "message": "Java Access Bridge channel not built into this driver revision; use uia or dxgi_vision"});
            } else if channel != "dxgi_vision" {
                if let Some(t) = &target {
                    if self.uia.is_none() {
                        match Uia::new() {
                            Ok(u) => self.uia = Some(u),
                            Err(e) => env["error"] = json!({"code": "INTERNAL", "message": e}),
                        }
                    }
                    if let Some(u) = self.uia.as_mut() {
                        let max = req["max_elements"].as_u64().unwrap_or(220) as usize;
                        match u.snapshot(t.hwnd, req["root"].as_str(), req["skeleton"].as_bool().unwrap_or(false), max) {
                            Ok(v) => {
                                uia_ms = v["uia_ms"].as_f64().unwrap_or(0.0);
                                env["elements"] = v["elements"].clone();
                                env["truncated"] = v["truncated"].clone();
                                env["snapshot_epoch"] = json!(u.epoch);
                            }
                            Err((code, m)) => {
                                env["ok"] = json!(false);
                                env["error"] = json!({"code": code, "message": m});
                            }
                        }
                    }
                }
            } else {
                env["channel"] = json!("dxgi_vision");
            }
            if channel == "auto" && env["elements"].as_array().map(|a| a.len()).unwrap_or(0) < 6 {
                env["uia_blind"] = json!(true);
            }
            if let Some(p) = req["screenshot_path"].as_str() {
                let region = req["region"].as_array().and_then(|a| if a.len() == 4 { Some([a[0].as_i64()? as i32, a[1].as_i64()? as i32, a[2].as_i64()? as i32, a[3].as_i64()? as i32]) } else { None })
                    .or_else(|| target.as_ref().map(|t| t.rect));
                let scale = req["screenshot_scale"].as_f64().unwrap_or(1.0);
                match self.cap.save_png(p, region, scale) {
                    Ok(v) => env["screenshot"] = v,
                    Err(e) => env["screenshot"] = json!({"error": e}),
                }
            }
            env["telemetry"] = json!({"enum_ms": enum_ms, "uia_ms": uia_ms, "total_ms": t0.elapsed().as_secs_f64() * 1000.0, "rss_mb": rss_mb()});
            env
        }

        fn cache(&mut self, key: String, v: &Value) {
            self.order.push_back(key.clone());
            self.replay.insert(key, v.clone());
            while self.order.len() > 512 {
                if let Some(k) = self.order.pop_front() {
                    self.replay.remove(&k);
                }
            }
        }

        fn action(&mut self, req: &Value) -> Value {
            let t0 = Instant::now();
            let aid = req["action_id"].as_str().unwrap_or("").to_string();
            if !aid.is_empty() {
                if let Some(prev) = self.replay.get(&aid) {
                    let mut p = prev.clone();
                    p["id"] = req["id"].clone();
                    p["idempotent_replay"] = json!(true);
                    return p;
                }
            }
            let r = self.action_inner(req, t0);
            if !aid.is_empty() && r["code"] != "USER_ACTIVE" && r["code"] != "STALE_EPOCH" {
                self.cache(aid, &r);
            }
            r
        }

        fn action_inner(&mut self, req: &Value, t0: Instant) -> Value {
            let a = req["action"].as_str().unwrap_or("");
            let expect_epoch = req["expect_epoch"].as_u64();
            let expect_hwnd = req["expect_hwnd"].as_i64().map(|v| v as isize).filter(|v| *v != 0);
            let humanize = req["humanize"].as_bool().unwrap_or(true);
            let wins = wnd::enum_windows(&self.own);
            let fg_before = wnd::foreground();
            let fgw = wins.iter().find(|w| w.hwnd == fg_before).cloned();
            let mut effect = json!({"fg_hwnd_before": fg_before});
            let physical = matches!(a, "click" | "double_click" | "right_click" | "hover" | "type" | "key" | "scroll" | "drag");

            // ---- security gates (defence in depth; Python has its own gate)
            if a == "key" || a == "close_window" {
                let keys = req["keys"].as_str().unwrap_or("").to_lowercase();
                let closing = a == "close_window" || keys.split_whitespace().any(|c| c == "alt+f4");
                if closing {
                    let victim = if a == "close_window" { req["hwnd"].as_i64().map(|v| v as isize).and_then(|h| wins.iter().find(|w| w.hwnd == h).cloned()).or(fgw.clone()) } else { fgw.clone() };
                    match victim {
                        Some(v) if wnd::is_shell(&v) => return res(req, false, "SECURITY_DENIED", format!("refusing to close shell window '{}' ({}) - this opens the Windows shutdown dialog", v.title, v.class), effect, t0),
                        Some(v) if v.own => return res(req, false, "SECURITY_DENIED", "refusing to close the agent's own console/terminal", effect, t0),
                        None if a == "key" => return res(req, false, "SECURITY_DENIED", "alt+f4 with unknown foreground window", effect, t0),
                        _ => {}
                    }
                }
                if keys.split_whitespace().any(|c| matches!(c, "win+r" | "win+x" | "ctrl+alt+delete" | "ctrl+alt+del" | "win+l")) {
                    return res(req, false, "SECURITY_DENIED", format!("key chord '{keys}' is blocked"), effect, t0);
                }
            }

            // ---- foreground contract for physical input
            if physical {
                if let Some(eh) = expect_hwnd {
                    if fg_before != eh {
                        let (ok, how, n) = wnd::force_foreground(eh);
                        effect["refocus"] = json!({"ok": ok, "method": how, "attempts": n});
                        if !ok {
                            let occ = wins.iter().find(|w| w.hwnd == eh).map(|t| wnd::occluders(t, &wins)).unwrap_or_default();
                            effect["occluded_by"] = json!(occ);
                            return res(req, false, "OCCLUDED", format!("expected hwnd {eh} is not foreground and could not be raised (fg={fg_before})"), effect, t0);
                        }
                    }
                }
                if input::user_active() {
                    return res(req, false, "USER_ACTIVE", "a human is using mouse/keyboard; yielded control", effect, t0);
                }
            }

            let out = match a {
                "focus_window" | "restore_window" => {
                    let found = wnd::find(&wins, req["hwnd"].as_i64().map(|v| v as isize), req["title"].as_str());
                    match found.len() {
                        0 => res(req, false, "NOT_FOUND", format!("no window matches {:?}", req["title"]), effect.clone(), t0),
                        n => {
                            if n > 1 && req["hwnd"].is_null() && found[0].process != found[1].process {
                                let list: Vec<String> = found.iter().take(5).map(|w| format!("{}:{}[{}]", w.hwnd, w.title, w.process)).collect();
                                return res(req, false, "AMBIGUOUS_TARGET", format!("{n} windows match: {}", list.join(" | ")), effect, t0);
                            }
                            let t = &found[0];
                            let (ok, how, tries) = wnd::force_foreground(t.hwnd);
                            effect["fg_hwnd_after"] = json!(wnd::foreground());
                            effect["method"] = json!(how);
                            effect["attempts"] = json!(tries);
                            effect["target_hwnd"] = json!(t.hwnd);
                            if ok {
                                effect["fg_title_after"] = json!(wnd::title_of(wnd::hwnd_of(wnd::foreground())));
                                res(req, true, "OK", format!("foreground verified: hwnd {} '{}' via {how}", t.hwnd, t.title), effect.clone(), t0)
                            } else {
                                let occ = wnd::occluders(t, &wins);
                                effect["occluded_by"] = json!(occ);
                                res(req, false, "FOREGROUND_FAILED", format!("all 5 foreground methods failed for hwnd {} '{}' (foreground stayed {}); occluders={:?}", t.hwnd, t.title, wnd::foreground(), occ), effect.clone(), t0)
                            }
                        }
                    }
                }
                "minimize_window" => {
                    let found = wnd::find(&wins, req["hwnd"].as_i64().map(|v| v as isize), req["title"].as_str());
                    match found.first() {
                        Some(w) if wnd::is_shell(w) || w.own => res(req, false, "SECURITY_DENIED", "cannot minimize shell/own window", effect.clone(), t0),
                        Some(w) => { wnd::show(w.hwnd, SW_MINIMIZE); res(req, true, "OK", format!("minimized {}", w.title), effect.clone(), t0) }
                        None => res(req, false, "NOT_FOUND", "no such window", effect.clone(), t0),
                    }
                }
                "close_window" => {
                    let found = wnd::find(&wins, req["hwnd"].as_i64().map(|v| v as isize), req["title"].as_str());
                    match found.first() {
                        Some(w) => { let ok = wnd::post_close(w.hwnd); res(req, ok, if ok { "OK" } else { "UIPI_DENIED" }, format!("WM_CLOSE posted to '{}'", w.title), effect.clone(), t0) }
                        None => res(req, false, "NOT_FOUND", "no such window", effect.clone(), t0),
                    }
                }
                "launch" => {
                    let target = req["target"].as_str().unwrap_or("");
                    if target.is_empty() {
                        return res(req, false, "NOT_FOUND", "empty launch target", effect, t0);
                    }
                    let args = req["args"].as_str().unwrap_or("");
                    if req["lock"].as_bool().unwrap_or(false) {
                        match std::process::Command::new(target).args(args.split_whitespace()).spawn() {
                            Ok(c) => {
                                let locked = self.job.as_ref().map(|j| j.adopt_pid(c.id())).unwrap_or(false);
                                effect["pid"] = json!(c.id());
                                effect["job_locked"] = json!(locked);
                                res(req, true, "OK", format!("spawned pid {} (job_locked={locked})", c.id()), effect.clone(), t0)
                            }
                            Err(e) => res(req, false, "NOT_FOUND", format!("spawn: {e}"), effect.clone(), t0),
                        }
                    } else {
                        let tw: Vec<u16> = target.encode_utf16().chain(std::iter::once(0)).collect();
                        let aw: Vec<u16> = args.encode_utf16().chain(std::iter::once(0)).collect();
                        let h = unsafe { ShellExecuteW(None, w!("open"), PCWSTR(tw.as_ptr()), if args.is_empty() { PCWSTR::null() } else { PCWSTR(aw.as_ptr()) }, PCWSTR::null(), SW_SHOWNORMAL) };
                        let code = h.0 as isize;
                        if code > 32 { res(req, true, "OK", format!("ShellExecute ok: {target}"), effect.clone(), t0) }
                        else { res(req, false, if code == 5 { "UIPI_DENIED" } else { "NOT_FOUND" }, format!("ShellExecute failed code {code}"), effect.clone(), t0) }
                    }
                }
                "invoke" | "set_value" => {
                    let Some(u) = self.uia.as_ref() else { return res(req, false, "STALE_EPOCH", "no UIA snapshot yet", effect, t0) };
                    let r = req["ref"].as_str().unwrap_or("");
                    if a == "invoke" {
                        match u.invoke(r, expect_epoch) {
                            Ok(m) => { effect["mechanism"] = json!(m); res(req, true, "OK", format!("{m} (headless, mouse untouched)"), effect.clone(), t0) }
                            Err((c, m)) => res(req, false, c, m, effect.clone(), t0),
                        }
                    } else {
                        match u.set_value(r, req["text"].as_str().unwrap_or(""), expect_epoch) {
                            Ok(rb) => { effect["readback"] = json!(rb); res(req, true, "OK", "ValuePattern.SetValue + readback", effect.clone(), t0) }
                            Err((c, m)) => res(req, false, c, m, effect.clone(), t0),
                        }
                    }
                }
                "click" | "double_click" | "right_click" | "hover" | "drag" => {
                    let (x, y, tw) = if let Some(r) = req["ref"].as_str() {
                        let Some(u) = self.uia.as_ref() else { return res(req, false, "STALE_EPOCH", "no UIA snapshot yet", effect, t0) };
                        match u.click_point(r, expect_epoch) {
                            Ok(p) => p,
                            Err((c, m)) => return res(req, false, c, m, effect, t0),
                        }
                    } else {
                        (req["x"].as_i64().unwrap_or(-1) as i32, req["y"].as_i64().unwrap_or(-1) as i32, 24.0)
                    };
                    if x < 0 && req["ref"].is_null() {
                        return res(req, false, "NOT_FOUND", "click needs ref or x,y", effect, t0);
                    }
                    // occlusion at the physical point
                    if let Some(eh) = expect_hwnd {
                        let top = unsafe { GetAncestor(WindowFromPoint(POINT { x, y }), GA_ROOT) };
                        if wnd::raw(top) != eh && a != "drag" {
                            effect["covered_by"] = json!(wnd::raw(top));
                            return res(req, false, "OCCLUDED", format!("point ({x},{y}) is covered by hwnd {} '{}'", wnd::raw(top), wnd::title_of(top)), effect, t0);
                        }
                    }
                    let r = if a == "drag" {
                        input::drag((x, y), (req["to_x"].as_i64().unwrap_or(0) as i32, req["to_y"].as_i64().unwrap_or(0) as i32), humanize)
                    } else { input::move_human(x, y, tw, humanize) };
                    if let Err(e) = r { return res(req, false, e, "human took the mouse; yielded", effect, t0); }
                    let (cx, cy) = input::cursor();
                    let err = (((cx - x).pow(2) + (cy - y).pow(2)) as f64).sqrt();
                    effect["cursor_error_px"] = json!(err);
                    if a != "hover" && a != "drag" {
                        std::thread::sleep(std::time::Duration::from_millis(40));
                        match a { "double_click" => input::click("left", 2), "right_click" => input::click("right", 1), _ => input::click("left", 1) }
                    }
                    res(req, true, "OK", format!("{a} at ({x},{y}) physical input"), effect.clone(), t0)
                }
                "type" => {
                    let text = req["text"].as_str().unwrap_or("");
                    if let (Some(r), Some(u)) = (req["ref"].as_str(), self.uia.as_ref()) {
                        let clear = req["clear"].as_bool().unwrap_or(true);
                        match u.resolve(r, expect_epoch) {
                            Ok(_) => {
                                let new_text = if clear { text.to_string() } else { text.to_string() };
                                if clear {
                                    if let Ok(rb) = u.set_value(r, &new_text, expect_epoch) {
                                        effect["readback"] = json!(rb);
                                        effect["mechanism"] = json!("ValuePattern");
                                        return res(req, rb == new_text, if rb == new_text { "OK" } else { "INTERNAL" }, "ValuePattern write + readback", effect.clone(), t0);
                                    }
                                }
                                let _ = u.focus(r, expect_epoch);
                            }
                            Err((c, m)) => return res(req, false, c, m, effect, t0),
                        }
                    }
                    if req["clear"].as_bool().unwrap_or(false) { let _ = input::press("ctrl+a"); let _ = input::press("delete"); }
                    input::type_text(text);
                    effect["mechanism"] = json!("SendInput.Unicode");
                    res(req, true, "OK", format!("typed {} chars via SendInput", text.chars().count()), effect.clone(), t0)
                }
                "key" => match input::press(req["keys"].as_str().unwrap_or("")) {
                    Ok(s) => { effect["sent"] = json!(s); res(req, true, "OK", "keys sent", effect.clone(), t0) }
                    Err(e) => res(req, false, "NOT_FOUND", e, effect.clone(), t0),
                },
                "scroll" => {
                    let n = req["amount"].as_i64().unwrap_or(3) as i32;
                    let dir = req["direction"].as_str().unwrap_or("down");
                    input::wheel(if dir == "up" || dir == "left" { n } else { -n }, dir == "left" || dir == "right");
                    res(req, true, "OK", format!("scrolled {dir} {n}"), effect.clone(), t0)
                }
                other => res(req, false, "UNSUPPORTED", format!("unknown action '{other}'"), effect.clone(), t0),
            };
            let mut out = out;
            std::thread::sleep(std::time::Duration::from_millis(if physical { 50 } else { 10 }));
            let fa = wnd::foreground();
            out["effect"]["fg_hwnd_after"] = json!(fa);
            out["effect"]["fg_title_after"] = json!(wnd::title_of(wnd::hwnd_of(fa)));
            out
        }

        fn handle(&mut self, req: &Value) -> Value {
            match req["type"].as_str().unwrap_or("") {
                "hello" => self.hello(req),
                "observe" => self.observe(req),
                "action" => self.action(req),
                "capture_bench" => {
                    let mut v = bench(&mut self.cap, req["frames"].as_u64().unwrap_or(100) as u32);
                    v["id"] = req["id"].clone();
                    v
                }
                "shutdown" => json!({"type": "bye", "id": req["id"], "ok": true}),
                t => json!({"type": "error", "id": req["id"], "ok": false, "code": "UNSUPPORTED", "message": format!("unknown type {t}")}),
            }
        }
    }

    pub fn run() {
        unsafe {
            let _ = SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
        }
        let args: Vec<String> = std::env::args().collect();
        let argv = |k: &str| args.iter().position(|a| a == k).and_then(|i| args.get(i + 1)).cloned();
        let mut cap = Capture::new();
        if let Some(n) = argv("--selftest-dxgi") {
            let v = bench(&mut cap, n.parse().unwrap_or(100));
            println!("{}", v);
            return;
        }
        let pipe = argv("--pipe").unwrap_or_else(|| r"\\.\pipe\dscu-driver-v1".to_string());
        let token = std::env::var("DSCU_TOKEN").ok().filter(|t| !t.is_empty());
        let (tx, rx) = channel::<pipe_server::Job>();
        std::thread::spawn(move || pipe_server::serve(&pipe, tx, token));
        let mut eng = Engine {
            cap, uia: None, job: input::Job::new(), own: HashSet::new(),
            replay: HashMap::new(), order: VecDeque::new(), last_target: 0,
        };
        eprintln!("[dscu-driver] engine ready (dxgi_active={})", eng.cap.backend_reason().is_none());
        for (req, reply) in rx {
            let resp = eng.handle(&req);
            let _ = reply.send(resp);
        }
    }
}
