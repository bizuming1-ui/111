from __future__ import annotations

import hashlib
import json
import re
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Iterable, Optional

from .protocol import Element, Observation

SELF_DRAWN_PROCS = {"weixin.exe", "wechat.exe", "wechatappex.exe", "wxwork.exe", "qq.exe", "qqnt.exe", "dingtalk.exe", "feishu.exe", "lark.exe",
                    "telegram.exe", "discord.exe", "steam.exe", "cloudmusic.exe", "qqmusic.exe", "wps.exe", "wpp.exe", "et.exe"}
ACTION_WORDS = re.compile(r"^(select|star|archive|delete|more|checkbox|选择|星标|归档|删除|更多|标记|snooze|mark)", re.I)
CLICKS = ("click", "double_click", "right_click")


def h64(s: str) -> str:
    return hashlib.blake2b(s.encode("utf-8", "ignore"), digest_size=8).hexdigest()


def sha256_file(path: str | Path, limit: int = 256 * 1024 * 1024) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        n = 0
        while True:
            b = f.read(1 << 20)
            if not b:
                break
            h.update(b)
            n += len(b)
            if n > limit:
                break
    return h.hexdigest()


def _extra(e: Element, name: str) -> str:
    ex = getattr(e, "model_extra", None) or {}
    v = ex.get(name)
    return str(v) if v not in (None, "") else ""


# ================================================================================ stable object identity
@dataclass
class StableObject:
    stable_id: str
    kind: str  # web_row | file | uia | generic
    label: str
    original_state: str = "present"
    current_state: str = "present"
    expected_state: Optional[str] = None
    is_target: bool = False
    locator: dict[str, Any] = field(default_factory=dict)
    first_step: int = 0
    last_seen_step: int = 0
    history: list[str] = field(default_factory=list)

    def set_state(self, state: str, step: int) -> None:
        if state != self.current_state:
            self.history.append(f"s{step}:{self.current_state}->{state}")
            self.current_state = state

    @property
    def satisfied(self) -> bool:
        return self.expected_state is None or self.current_state == self.expected_state


@dataclass
class Preflight:
    ok: bool
    reason: str = ""
    stable_id: str = ""
    drifted: bool = False
    old_row: Optional[int] = None
    new_row: Optional[int] = None


class StableObjectRegistry:
    def __init__(self) -> None:
        self.objects: dict[str, StableObject] = {}
        self.targets_locked = False
        self.baseline_rows: Optional[int] = None
        self.last_rows: dict[int, str] = {}  # current row number -> stable_id
        self.step = 0
        self.hits: dict[str, int] = {}  # v15: activation counter per perception channel (cdp / uia / dxgi_vision)

    # ---------------------------------------------------------------- identity derivation
    @staticmethod
    def row_groups(elements: Iterable[Element]) -> dict[int, list[Element]]:
        g: dict[int, list[Element]] = {}
        for e in elements:
            if e.zone == "Row" and e.row:
                g.setdefault(int(e.row), []).append(e)
        return dict(sorted(g.items()))

    @staticmethod
    def row_signature(group: list[Element]) -> tuple[str, str]:
        """(identity string, human label).  Priority: DOM data-thread-id  >  hash(sender+subject+timestamp  ~ the row's content-bearing names)."""
        for e in group:
            tid = _extra(e, "thread_id")
            if tid:
                return f"tid:{tid}", f"thread {tid[:12]}"
        parts: list[str] = []
        for e in group:
            aid = _extra(e, "automation_id")
            if e.role.lower() in ("listitem", "dataitem") and (e.name or "").strip() and not aid:
                parts.append((e.name or "").strip()[:120])  # v15: UIA list item (Explorer file / Recycle-Bin row / mail row) identity = its content name
                continue
            if e.role.lower() in ("checkbox", "switch"):
                continue
            nm = (e.name or "").strip()
            if not nm or ACTION_WORDS.match(nm):
                continue
            parts.append(nm[:120])
        if not parts:  # last resort: structural keys (still not the row number)
            parts = [e.stable_key for e in group]
        sig = " | ".join(parts)
        return sig, sig[:60]

    def observe_rows(self, elements: Iterable[Element], step: int = 0, channel: str = "") -> list[StableObject]:
        """Register/refresh row objects after EVERY list observation; detects disappearance of tracked objects."""
        self.step = step or self.step
        groups = self.row_groups(elements)
        seen: dict[str, int] = {}
        dup: dict[str, int] = {}
        cur_rows: dict[int, str] = {}
        out: list[StableObject] = []
        for row, grp in groups.items():
            sig, label = self.row_signature(grp)
            k = dup.get(sig, 0)
            dup[sig] = k + 1
            sid = "row:" + h64(f"{sig}#{k}")
            checked = any(e.role.lower() == "checkbox" and "checked" in e.states for e in grp)
            o = self.objects.get(sid)
            if o is None:
                o = StableObject(sid, "web_row", label, locator={"row": row, "orig_row": row, "sig": sig[:200]}, first_step=step)
                self.objects[sid] = o
            o.locator["row"] = row
            o.locator["ref_ids"] = [e.ref_id for e in grp]
            o.last_seen_step = step
            o.set_state("checked" if checked else "present", step)
            seen[sid] = row
            cur_rows[row] = sid
            out.append(o)
        if groups and self.baseline_rows is None:
            self.baseline_rows = len(groups)
        if groups:  # an empty/transitional list must not mark everything "gone"
            for sid, o in self.objects.items():
                if o.kind == "web_row" and sid not in seen and o.current_state != "gone":
                    o.set_state("gone", step)
        self.last_rows = cur_rows
        if groups and channel:
            self.hits[channel] = self.hits.get(channel, 0) + 1
        return out

    def lock_targets(self, elements: Iterable[Element], n: int, expected: str = "gone", step: int = 0) -> list[StableObject]:
        """Freeze the *first n objects* (by identity) as targets of the task, once."""
        if self.targets_locked or n <= 0:
            return [o for o in self.objects.values() if o.is_target]
        rows = self.observe_rows(elements, step)
        for o in rows[:n]:
            o.is_target = True
            o.expected_state = expected
        self.targets_locked = bool(rows)
        return [o for o in self.objects.values() if o.is_target]

    def remaining_targets(self, elements: Optional[Iterable[Element]] = None) -> list[tuple[StableObject, int]]:
        if elements is not None:
            self.observe_rows(elements, self.step)
        rows = {sid: r for r, sid in self.last_rows.items()}
        return [(o, rows[o.stable_id]) for o in self.objects.values() if o.is_target and o.stable_id in rows]

    def gone_targets(self) -> list[StableObject]:
        return [o for o in self.objects.values() if o.is_target and o.current_state == "gone"]

    # ---------------------------------------------------------------- guards
    def translate_rows(self, requested: set[int], elements: Iterable[Element]) -> tuple[set[int], list[str]]:
        """Model said 'rows 1-3' using row numbers that were true BEFORE the list shifted.  Map to *current* rows of the real targets."""
        notes: list[str] = []
        if not self.targets_locked:
            return set(requested), notes
        self.observe_rows(elements, self.step)
        rem = self.remaining_targets()
        target_rows = {r for _, r in rem}
        if not rem:
            notes.append("所有目标对象（stable_id）均已不在列表中：无需再选择任何行。")
            return set(), notes
        non_targets = {r for r in requested if r in self.last_rows and r not in target_rows}
        keep = {r for r in requested if r in target_rows}
        if non_targets:
            lbl = "; ".join(f"R{r}={self.objects[self.last_rows[r]].label[:24]!r}" for r in sorted(non_targets))
            notes.append(f"StableObject 防误删：请求行 {sorted(non_targets)} 不是任务目标（{lbl}），已剔除。")
        if keep != set(requested) or non_targets or len(keep) != len(target_rows):
            drift = [(o.label[:20], o.locator.get("orig_row", o.locator.get("row")), r) for o, r in rem]
            notes.append(f"列表已漂移：剩余目标按 stable_id 重新定位为当前行 {sorted(target_rows)}（{drift[:4]}）。")
            keep = set(target_rows)
        return keep, notes

    def preflight_row_click(self, el: Element, elements: Iterable[Element]) -> Preflight:
        """Before an action on a row element: the object it belongs to must still exist, and must be a target (when targets are locked)."""
        if not el.row or not self.targets_locked:
            return Preflight(True)
        self.observe_rows(elements, self.step)
        sid = self.last_rows.get(int(el.row), "")
        if not sid:
            return Preflight(False, f"R{el.row} 对应的对象已不存在（列表已变化）")
        o = self.objects[sid]
        if not o.is_target:
            return Preflight(False, f"R{el.row}={o.label[:30]!r} 不是任务目标对象（stable_id={sid}），拒绝操作", sid)
        old = o.locator.get("orig_row")
        return Preflight(True, "", sid, drifted=(old != int(el.row)), old_row=old, new_row=int(el.row))

    # ---------------------------------------------------------------- state tracking
    def expect(self, state: str, only_targets: bool = True) -> None:
        for o in self.objects.values():
            if o.is_target or not only_targets:
                o.expected_state = state

    def mismatches(self) -> list[StableObject]:
        return [o for o in self.objects.values() if o.is_target and not o.satisfied]

    # ---------------------------------------------------------------- non-row objects
    def register_file(self, path: str | Path) -> StableObject:
        p = Path(path)
        try:
            canon = str(p.resolve())
        except OSError:
            canon = str(p)
        digest = sha256_file(p) if p.exists() and p.is_file() else ""
        sid = "file:" + h64(canon.lower())
        o = self.objects.get(sid)
        if o is None:
            o = StableObject(sid, "file", canon, original_state=("sha256:" + digest[:16]) if digest else "absent", locator={"path": canon, "sha256": digest})
            o.current_state = o.original_state
            self.objects[sid] = o
        return o

    def check_file(self, sid: str) -> tuple[bool, str]:
        o = self.objects[sid]
        p = Path(o.locator["path"])
        if not p.exists():
            o.set_state("absent", self.step)
            return False, "文件不存在"
        d = sha256_file(p)
        o.set_state("sha256:" + d[:16], self.step)
        want = o.expected_state
        return (want is None or o.current_state == want), f"sha256={d[:16]}"

    @staticmethod
    def uia_identity(el: Element) -> str:
        rid, aid = _extra(el, "runtime_id"), _extra(el, "automation_id")
        return f"uia:{h64(rid + '|' + aid + '|' + el.role + '|' + (el.name or '')[:60])}" if (rid or aid) else f"uia:{el.stable_key}"

    def register_uia(self, el: Element) -> StableObject:
