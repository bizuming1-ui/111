            self._tracer = trace.get_tracer("dscu")
        except Exception:
            self._tracer = None

    @contextmanager
    def span(self, stage: str, **attrs):
        t0 = time.perf_counter_ns(); w0 = time.time_ns()
        ctx = self._tracer.start_as_current_span(f"dscu.{stage}") if self._tracer else None
        if ctx: ctx.__enter__()
        try:
            yield
        finally:
            dur = (time.perf_counter_ns() - t0) / 1e6
            self.spans.append({"stage": stage, "ms": dur, "start_ns": w0, "attrs": attrs})
            if ctx: ctx.__exit__(None, None, None)

    def add(self, stage: str, ms: float, **attrs) -> None:
