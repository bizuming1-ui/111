fn do_click(x: i32, y: i32, d: bool) -> Result<(), String> { input::win::click(x, y, d) }
#[cfg(not(windows))]
fn do_click(_x: i32, _y: i32, _d: bool) -> Result<(), String> { Err("input injection is Windows-only".into()) }

fn pct(v: &mut Vec<u64>, p: f64) -> u64 { v.sort_unstable(); v[((v.len() as f64 - 1.0) * p).round() as usize] }

fn bench(st: &mut State, n: usize) -> Value {
    let _ = st.capture();                                  // prime (first frame is a full copy)
    let mut us: Vec<u64> = Vec::with_capacity(n);
    for _ in 0..n { let t = Instant::now(); let _ = st.capture(); us.push(t.elapsed().as_micros() as u64); }
    let (p50, p99) = (pct(&mut us.clone(), 0.5), pct(&mut us, 0.99));
    // worst case: every pixel changed -> full-frame copy into the ring (what a busy video/game screen costs)
    let (w, h) = st.src.dims(); let full = vec![7u8; (w * h * 4) as usize]; let m = ring::FrameMeta { w, h, stride: w * 4 };
    let mut fu: Vec<u64> = (0..(n / 4).max(20)).map(|_| { let t = Instant::now(); let _ = st.ring.write_frame(m, &full); t.elapsed().as_micros() as u64 }).collect();
    let full_p50 = pct(&mut fu, 0.5);
    json!({"ok": true, "backend": st.src.name(), "frames": n, "p50_ms": p50 as f64 / 1000.0, "p99_ms": p99 as f64 / 1000.0,
           "full_frame_copy_p50_ms": full_p50 as f64 / 1000.0, "target_ms": 5.0, "pass": (p50 as f64 / 1000.0) < 5.0})
}

fn serve_stream<S: std::io::Read + Write>(st: &mut State, s: S) {
    let mut rd = BufReader::new(s);
    let mut line = String::new();
    loop {
        line.clear();
        match rd.read_line(&mut line) { Ok(0) | Err(_) => break, Ok(_) => {} }
        let out = match serde_json::from_str::<Value>(line.trim()) { Ok(v) => st.handle(&v), Err(e) => json!({"ok": false, "error": e.to_string()}) };
        let w = rd.get_mut();
        if writeln!(w, "{}", out).is_err() || w.flush().is_err() { break; }
    }
}

#[cfg(windows)]
fn serve(st: &mut State) -> Result<(), String> {
    use std::os::windows::io::FromRawHandle;
    use windows::core::w;
    use windows::Win32::Storage::FileSystem::PIPE_ACCESS_DUPLEX;
    use windows::Win32::System::Pipes::*;
    loop {
        let h = unsafe { CreateNamedPipeW(w!(r"\\.\pipe\dscu-driver-v1"), PIPE_ACCESS_DUPLEX, PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT, 1, 1 << 20, 1 << 20, 0, None) };
        if h.is_invalid() { return Err("CreateNamedPipeW failed".into()); }
        let _ = unsafe { ConnectNamedPipe(h, None) };
        let f = unsafe { std::fs::File::from_raw_handle(h.0 as *mut _) };
        serve_stream(st, f);                                   // dropping File closes the handle
    }
}
#[cfg(not(windows))]
fn serve(st: &mut State) -> Result<(), String> {
    use std::os::unix::net::UnixListener;
    let p = std::env::temp_dir().join("dscu-driver-v1.sock"); let _ = std::fs::remove_file(&p);
    let l = UnixListener::bind(&p).map_err(|e| e.to_string())?;
    eprintln!("dscu-driver listening on {}", p.display());
    for c in l.incoming().flatten() { serve_stream(st, c); }
    Ok(())
}

fn main() {
    let args: Vec<String> = std::env::args().skip(1).collect();
    let mut st = match State::new() { Ok(s) => s, Err(e) => { eprintln!("init failed: {e}"); std::process::exit(2) } };
    match args.first().map(String::as_str).unwrap_or("serve") {
        "bench" => { let n = args.get(1).and_then(|x| x.parse().ok()).unwrap_or(300); println!("{}", bench(&mut st, n)); }
        "snapshot" => {
            let skel = args.iter().any(|a| a == "--skeleton");
            let root = args.iter().position(|a| a == "--root").and_then(|i| args.get(i + 1)).cloned();
            println!("{}", st.snapshot(skel, root.as_deref()).unwrap_or_else(|e| json!({"ok": false, "error": e})));
