"""Window semantic fingerprint + editability preflight scoring (v12).  Mirrors `Get-V12FocusScore` (PowerShell) and
`window.probe` (Rust IUIAutomationCacheRequest).  Purpose: never focus a read-only popup ("xxx 的聊天记录") when an input
surface is needed.  Pure function => deterministic, fixture-tested."""
from __future__ import annotations

import re
from dataclasses import dataclass

READONLY_TITLE = re.compile(r"(聊天记录|记录|历史|history|\blog\b|详情|详细|预览|preview|viewer|查看|只读|read-?only|收藏|favorites?|通知|notification)", re.I)


@dataclass
class WindowFp:
    title: str
    process: str = ""
    cls: str = ""
    visible: bool = True
    owned: bool = False          # has an owner window (popup/dialog)
    tool_window: bool = False    # WS_EX_TOOLWINDOW
    iconic: bool = False
    area: int = 0
    edit: int = 0                # Edit/Document controls found by ONE cached UIA subtree request
    nodes: int = 0


def focus_score(fp: WindowFp, keyword: str, need_input: bool) -> float:
    if not fp.visible:
        return -100.0
    kw, t = keyword.lower().strip(), fp.title.lower().strip()
    s = 0.0
    if kw and t == kw:
        s += 40
    elif kw and kw in t:
        s += 25
    elif kw and kw in fp.process.lower():
        s += 15
    if not fp.owned and not fp.tool_window:
        s += 20
    if fp.edit > 0:
        s += 35 if need_input else 10
    elif need_input:
        s -= 15
        if READONLY_TITLE.search(fp.title):
            s -= 30
    if fp.owned and need_input:
        s -= 10
    s += min(10.0, fp.area / 200_000.0)
    if fp.iconic:
        s -= 5
    return round(s, 2)


def pick_window(cands: list[WindowFp], keyword: str, need_input: bool) -> WindowFp | None:
    ranked = sorted(cands, key=lambda c: focus_score(c, keyword, need_input), reverse=True)
    if not ranked:
        return None
    top = ranked[0]
    if need_input and top.edit == 0 and READONLY_TITLE.search(top.title):
        # sibling rule: a read-only popup of a process never wins when a main window of the same process exists
        sib = [c for c in ranked if c is not top and c.visible and c.process.lower() == top.process.lower()
               and not c.tool_window and not c.owned and not READONLY_TITLE.search(c.title)]
        if sib:
            return max(sib, key=lambda c: (c.edit, c.area))
    return top
