    def __init__(self, windows: list, foreground: Optional[int] = None) -> None:
        self.wins = list(windows)
        self.fg = foreground if foreground is not None else (windows[0].hwnd if windows else 0)
        self.focus: dict = {}
        self.children: dict = {}
        self.log: list = []
        self.raise_works = True
        self.minimize_works = True

    def _renumber(self) -> None:
        self.wins = [WinInfo(**{**w.__dict__, "z": i}) for i, w in enumerate(self.wins)]

    def enum_windows(self) -> list:
        self._renumber()
        return [w for w in self.wins if w.visible]

    def window_from_point(self, x: int, y: int) -> int:
        for w in self.wins:
            if w.visible and not w.minimized and not (w.ex_style & WS_EX_TRANSPARENT) and w.contains(x, y):
                return w.hwnd
        return 0

    def ancestor(self, hwnd: int, flag: int) -> int:
        return self.children.get(hwnd, hwnd)

    def foreground(self) -> int:
        return self.fg

    def is_window(self, hwnd: int) -> bool:
        return any(w.hwnd == hwnd for w in self.wins)

    def gui_thread_info(self, hwnd: int) -> dict:
        return {"ok": 1, "focus": self.focus.get(self.fg, self.fg), "active": self.fg, "capture": 0, "caret": 0}

    def client_origin(self, hwnd: int) -> tuple:
        w = next(w for w in self.wins if w.hwnd == hwnd)
        return w.rect

    def raise_window(self, hwnd: int) -> bool:
        self.log.append(f"raise:{hwnd}")
        if not self.raise_works:
            return False
        i = next((k for k, w in enumerate(self.wins) if w.hwnd == hwnd), None)
        if i is None:
            return False
        w = self.wins.pop(i)
        self.wins.insert(0, WinInfo(**{**w.__dict__, "minimized": False}))
        self.fg = hwnd
        return True

    def minimize(self, hwnd: int) -> bool:
        self.log.append(f"minimize:{hwnd}")
        if not self.minimize_works:
            return False
        self.wins = [WinInfo(**{**w.__dict__, "minimized": True}) if w.hwnd == hwnd else w for w in self.wins]
        return True

    def pin_topmost(self, hwnd: int, on: bool) -> None:
        self.log.append(f"pin:{hwnd}:{on}")


