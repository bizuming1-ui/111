        rep.ok, rep.verdict, rep.detail = True, V_CLICK_THROUGH, "命中点击穿透覆盖层"
        return rep
    if not rep.in_target_rect:
        kind = "桌面/任务栏" if hit_root.cls in SHELL_CLASSES else hit_root.label()
        rep.verdict, rep.occluder_hwnd = V_OUTSIDE_TARGET, 0
        rep.detail = (f"点 ({x},{y}) 不在目标窗口矩形 {tuple(target.rect)} 内，实际落在 {kind} → 这是【坐标空间错位】而不是遮挡："
                      f"最小化/置顶无法修复，需要重新定位坐标")
        return rep
    rep.verdict, rep.occluder_hwnd = V_OCCLUDED, hit_root.hwnd
    rep.detail = f"目标窗口内的点 ({x},{y}) 被 {hit_root.label()} 遮挡"
    return rep


def candidate_remaps(target: WinInfo, client: tuple, point: tuple) -> list:
    """Plausible coordinate-space repairs for a point that missed the target.  Only offsets (no guessing of scale) and only if the shifted point is INSIDE the target."""
    x, y = point
    tx, ty, tw, th = target.rect
    cx, cy, cw, ch = client
    out: list = []
    if 0 <= x < tw and 0 <= y < th:
        out.append((tx + x, ty + y, "window_relative→screen"))
    if 0 <= x < cw and 0 <= y < ch:
        out.append((cx + x, cy + y, "client_relative→screen"))
    seen: set = set()
    uniq = []
    for c in out:
        if (c[0], c[1]) not in seen:
            seen.add((c[0], c[1]))
            uniq.append(c)
    return uniq


class WindowManager:
    def __init__(self, backend: Any = None, say: Optional[Callable[[str], None]] = None) -> None:
        self.be: Any = backend or Win32Backend()
        self.say = say or (lambda m: None)
        self.stats: dict = {"hit_checks": 0, "hit_ok": 0, "outside_target": 0, "occluded": 0, "occ_recovered": 0, "occ_failed": 0, "same_app": 0,
                            "focus_checks": 0, "focus_fail": 0, "shot_checks": 0, "shot_blocked": 0, "shot_restored": 0, "remaps": 0}
        self._pinned: set = set()

    # ------------------------------------------------------------------ queries
    def windows(self) -> list:
        return self.be.enum_windows()

    def get(self, hwnd: int, wins: Optional[list] = None) -> Optional[WinInfo]:
        if not hwnd:
            return None
        for w in (wins if wins is not None else self.windows()):
            if w.hwnd == hwnd:
                return w
        return None

    def root_of(self, hwnd: int) -> int:
        if not hwnd:
            return 0
        return self.be.ancestor(hwnd, GA_ROOT) or hwnd

    def find_by_process(self, names: Iterable[str], title_hint: str = "", wins: Optional[list] = None) -> list:
        """Main-window candidates of the given process names, best first (title match, titled, non-minimised, biggest area)."""
        ns = {n.lower() for n in names if n}
        res = [w for w in (wins if wins is not None else self.windows()) if w.process.lower() in ns and not w.own_console and not w.cloaked and w.cls not in SHELL_CLASSES]
        th = title_hint.lower()
        res.sort(key=lambda w: (not (th and th in w.title.lower()), not w.title, w.minimized, -(w.rect[2] * w.rect[3]), w.z))
        return res

    # ------------------------------------------------------------------ click ownership
    def verify_hit_target(self, target_hwnd: int, x: int, y: int, wins: Optional[list] = None) -> HitReport:
        """WindowFromPoint(phys_x, phys_y) -> GetAncestor(GA_ROOT) must equal target_hwnd (or be a same-PID helper)."""
        self.stats["hit_checks"] += 1
        wins = wins if wins is not None else self.windows()
        target = self.get(target_hwnd, wins) if self.be.is_window(target_hwnd) else None
        h = self.be.window_from_point(int(x), int(y))
        root_h = (self.be.ancestor(h, GA_ROOT) or h) if h else 0
        root = self.get(root_h, wins) if root_h else None
        if root is None and root_h:  # non-enumerated root (tool window / layered shell surface): still describe it
            root = WinInfo(hwnd=root_h, title="", cls="?")
        rep = classify_hit(target, (int(x), int(y)), int(h or 0), root)
        if rep.ok:
            self.stats["hit_ok"] += 1
            if rep.verdict == V_SAME_APP:
                self.stats["same_app"] += 1
        elif rep.verdict == V_OUTSIDE_TARGET:
            self.stats["outside_target"] += 1
            if target is not None:
                for cx, cy, rule in candidate_remaps(target, self.be.client_origin(target.hwnd), (int(x), int(y))):
                    h2 = self.be.window_from_point(cx, cy)
                    r2 = (self.be.ancestor(h2, GA_ROOT) or h2) if h2 else 0
                    r2w = self.get(r2, wins)
                    if r2 == target.hwnd or (target.pid and r2w is not None and r2w.pid == target.pid):
                        rep.remap = (cx, cy, rule)
                        break
        elif rep.verdict == V_OCCLUDED:
            self.stats["occluded"] += 1
        return rep

    def prepare_click(self, target_hwnd: int, x: int, y: int, *, allow_remap: bool = True, max_rounds: int = 3) -> HitReport:
        """verify -> (OUTSIDE_TARGET: report the coordinate error + a verified remap candidate, never minimise/pin)
        -> (OCCLUDED: raise target, minimise the identified occluder, pin as last resort) -> re-verify.
        If ANY layout-changing action ran, `needs_reobserve=True`: the caller must re-capture UIA + screenshot and re-ground the point (no blind click)."""
        rep = self.verify_hit_target(target_hwnd, x, y)
        if rep.ok or rep.verdict == V_TARGET_GONE:
            return rep
        if rep.verdict == V_OUTSIDE_TARGET:
            if allow_remap and rep.remap:
                self.stats["remaps"] += 1
                rep.actions.append(f"remap:{rep.remap[2]}→({rep.remap[0]},{rep.remap[1]})")
                rep.detail += f"；候选修复 {rep.remap[2]} → ({rep.remap[0]},{rep.remap[1]}) 已验证命中目标窗口"
            return rep
        actions: list = []
        occ = rep.occluder_hwnd
        for rnd in range(max_rounds):
            if rnd == 0:
                ok = self.be.raise_window(target_hwnd)
                actions.append(f"raise_target:{'ok' if ok else 'fail'}")
            elif rnd == 1 and occ:
                w = self.get(occ)
                if w is None or w.cloaked:
                    actions.append("occluder_gone")
                elif w.own_console:
                    self.be.pin_topmost(target_hwnd, True)
                    self._pinned.add(target_hwnd)
                    actions.append("pin_target(own console above target)")
                elif w.cls in SHELL_CLASSES:
                    actions.append(f"skip_shell:{w.cls}")
                else:
                    ok = self.be.minimize(occ)
                    actions.append(f"minimize_occluder:{w.process}:{'ok' if ok else 'fail'}")
            else:
                self.be.pin_topmost(target_hwnd, True)
                self._pinned.add(target_hwnd)
                actions.append("pin_target")
            if IS_WIN:
                time.sleep(0.05)
            nr = self.verify_hit_target(target_hwnd, x, y)
            if nr.ok:
                self.stats["occ_recovered"] += 1
                nr.actions = actions
                nr.needs_reobserve = True
                nr.detail = f"遮挡已清除（{', '.join(actions)}）。窗口布局已变化 → 必须重新采集 UIA + 截图后再点击，禁止沿用旧坐标"
                return nr
            occ = nr.occluder_hwnd or occ
            rep = nr
        self.stats["occ_failed"] += 1
        rep.actions = actions
        rep.needs_reobserve = True
        rep.detail += f"；已尝试 {', '.join(actions)} 仍被遮挡"
        return rep

    def release_pins(self) -> None:
        for h in list(self._pinned):
            try:
                self.be.pin_topmost(h, False)
            except Exception:  # noqa: BLE001
                pass
        self._pinned.clear()

    # ------------------------------------------------------------------ keyboard ownership
    def verify_input_focus(self, target_hwnd: int) -> FocusReport:
        """GetGUIThreadInfo: the REAL keyboard focus must live inside the target (same root or same PID) before any typing."""
        self.stats["focus_checks"] += 1
        fg = self.be.foreground()
        fg_root = self.root_of(fg)
        gi = self.be.gui_thread_info(target_hwnd or fg)
        focus = int(gi.get("focus", 0) or 0)
        f_root = self.root_of(focus) if focus else 0
        rep = FocusReport(False, target_hwnd, fg_root=fg_root, focus_hwnd=focus, focus_root=f_root, active_hwnd=int(gi.get("active", 0) or 0))
        wins = self.windows()
        tw = self.get(target_hwnd, wins)
        fgw = self.get(fg_root, wins) or WinInfo(fg_root)
        fcw = self.get(f_root, wins) or WinInfo(f_root)
        if tw is None:
            rep.reason = "目标窗口不存在"
        elif fg_root != target_hwnd and fgw.pid != tw.pid:
            rep.reason = f"前台是 {fgw.label()}，不是目标 {tw.label()}"
        elif not focus:
            rep.reason = "目标线程没有键盘焦点控件（hwndFocus=0）：先点击输入框"
        elif f_root != target_hwnd and fcw.pid != tw.pid:
            rep.reason = f"键盘焦点 hwnd={focus} 属于其它窗口 {f_root}"
        else:
            rep.ok = True
            rep.reason = f"键盘焦点 hwnd={focus} 位于目标窗口内"
        if not rep.ok:
            self.stats["focus_fail"] += 1
        return rep

    # ------------------------------------------------------------------ screenshot ownership
    def screenshot_ownership(self, target_hwnd: int, *, restore: bool = True) -> OwnershipReport:
        """A frame may be sent to the vision model only if foreground root == target_hwnd (or a same-PID owned popup).  Otherwise try ONE verified restore, then re-check."""
        self.stats["shot_checks"] += 1
        if not target_hwnd:
            return OwnershipReport(True, 0, reason="无指定目标窗口（全屏桌面任务）")
        wins = self.windows()
        tw = self.get(target_hwnd, wins)

        def owner_ok() -> tuple:
            fg_root = self.root_of(self.be.foreground())
            fw = self.get(fg_root, wins) or WinInfo(fg_root)
            ok = fg_root == target_hwnd or bool(tw and tw.pid and fw.pid == tw.pid and not fw.own_console)
            return ok, fg_root, fw

        ok, fg_root, fw = owner_ok()
        if ok:
            return OwnershipReport(True, target_hwnd, fg_root, fw.title, fw.process, "前台窗口 == 目标窗口")
        restored = False
        if restore and tw is not None and self.be.raise_window(target_hwnd):
            wins = self.windows()
            tw = self.get(target_hwnd, wins)
            ok, fg_root, fw = owner_ok()
            restored = ok
            if ok:
                self.stats["shot_restored"] += 1
                return OwnershipReport(True, target_hwnd, fg_root, fw.title, fw.process, "已验证式恢复前台后重新核验通过", restored=True)
        self.stats["shot_blocked"] += 1
        what = "智能体自己的终端" if fw.own_console else fw.label()
        return OwnershipReport(False, target_hwnd, fg_root, fw.title, fw.process,
                               f"截图归属失败：当前前台是 {what}，目标窗口 hwnd={target_hwnd}。该帧禁止送入视觉模型（会把终端当成浏览器/微信去定位控件）", restored=restored)

    def summary(self) -> str:
        s = self.stats
        return (f"WindowManager：命中核验 {s['hit_ok']}/{s['hit_checks']}（同进程放行 {s['same_app']} · 坐标越界 {s['outside_target']} · 真遮挡 {s['occluded']}→恢复 {s['occ_recovered']}/失败 {s['occ_failed']}"
                f" · 坐标重映射 {s['remaps']}）· 焦点核验失败 {s['focus_fail']}/{s['focus_checks']} · 截图归属拦截 {s['shot_blocked']}/{s['shot_checks']}（恢复 {s['shot_restored']}）")


def build_default(say: Optional[Callable[[str], None]] = None) -> Optional[WindowManager]:
    """Real WindowManager on Windows; None elsewhere (callers must treat None as 'guard unavailable' and say so)."""
    if not IS_WIN:
        return None
    try:
        return WindowManager(Win32Backend(), say)
    except Exception:  # noqa: BLE001
        return None
