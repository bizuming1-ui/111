//! UI Automation backend. One cross-process call caches the whole control-view subtree
//! (`ElementFromHandleBuildCache` + `TreeScope_Subtree`), instead of thousands of per-element round trips.
use dscu_core::platform::{ActOp, ActResult, PErr};
use dscu_core::tree::{RawNode, WindowInfo};
use dscu_core::uia_ref::{pick_match, LiveCand, RefEntry};
use std::cell::RefCell;
use windows::core::BSTR;
use windows::Win32::System::Com::*;
use windows::Win32::UI::Accessibility::*;

thread_local! {
    static COM: RefCell<Option<IUIAutomation>> = const { RefCell::new(None) };
}

pub fn with_uia<R>(f: impl FnOnce(&IUIAutomation) -> Result<R, PErr>) -> Result<R, PErr> {
    COM.with(|c| {
        if c.borrow().is_none() {
            unsafe {
                let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
                let a: IUIAutomation = CoCreateInstance(&CUIAutomation8, None, CLSCTX_INPROC_SERVER).map_err(|e| PErr::Other(format!("CoCreateInstance(CUIAutomation8): {e}")))?;
                *c.borrow_mut() = Some(a);
            }
        }
        f(c.borrow().as_ref().unwrap())
    })
}

pub fn role_of(ct: i32) -> &'static str {
    match ct {
        50000 => "button", 50001 => "calendar", 50002 => "checkbox", 50003 => "combobox", 50004 => "edit", 50005 => "hyperlink", 50006 => "image",
        50007 => "listitem", 50008 => "list", 50009 => "menu", 50010 => "menubar", 50011 => "menuitem", 50012 => "progressbar", 50013 => "radiobutton",
        50014 => "scrollbar", 50015 => "slider", 50016 => "spinner", 50017 => "statusbar", 50018 => "tab", 50019 => "tabitem", 50020 => "text",
        50021 => "toolbar", 50022 => "tooltip", 50023 => "tree", 50024 => "treeitem", 50025 => "custom", 50026 => "group", 50027 => "thumb",
        50028 => "datagrid", 50029 => "dataitem", 50030 => "document", 50031 => "splitbutton", 50032 => "window", 50033 => "pane", 50034 => "header",
        50035 => "headeritem", 50036 => "table", 50037 => "titlebar", 50038 => "separator", _ => "custom",
    }
}

const PROPS: [UIA_PROPERTY_ID; 11] = [
    UIA_NamePropertyId, UIA_ControlTypePropertyId, UIA_AutomationIdPropertyId, UIA_ClassNamePropertyId, UIA_BoundingRectanglePropertyId, UIA_IsEnabledPropertyId,
    UIA_IsOffscreenPropertyId, UIA_IsKeyboardFocusablePropertyId, UIA_IsPasswordPropertyId, UIA_ValueValuePropertyId, UIA_ValueIsReadOnlyPropertyId,
];
const PATTERNS: [(UIA_PATTERN_ID, &str); 7] = [
    (UIA_InvokePatternId, "invoke"), (UIA_TogglePatternId, "toggle"), (UIA_ValuePatternId, "value"), (UIA_SelectionItemPatternId, "selection_item"),
    (UIA_ExpandCollapsePatternId, "expand_collapse"), (UIA_ScrollPatternId, "scroll"), (UIA_RangeValuePatternId, "range_value"),
];

fn cache_request(a: &IUIAutomation, live: bool) -> Result<IUIAutomationCacheRequest, PErr> {
    unsafe {
        let cr = a.CreateCacheRequest().map_err(|e| PErr::Other(e.to_string()))?;
        for p in PROPS {
            cr.AddProperty(p).map_err(|e| PErr::Other(e.to_string()))?;
        }
        for (p, _) in PATTERNS {
            cr.AddPattern(p).map_err(|e| PErr::Other(e.to_string()))?;
        }
        cr.SetTreeScope(TreeScope_Subtree).map_err(|e| PErr::Other(e.to_string()))?;
        let cond = a.ControlViewCondition().map_err(|e| PErr::Other(e.to_string()))?;
        cr.SetTreeFilter(&cond).map_err(|e| PErr::Other(e.to_string()))?;
        cr.SetAutomationElementMode(if live { AutomationElementMode_Full } else { AutomationElementMode_None }).map_err(|e| PErr::Other(e.to_string()))?;
        Ok(cr)
    }
}

/// Identity key = control type | automationId | class | name | raw DFS path. Any drift changes the key and the
/// core falls back to (automation_id, role, name) matching with fail-closed ambiguity handling.
fn node_of(e: &IUIAutomationElement, path: &str, budget: &mut usize, elems: &mut Option<&mut Vec<IUIAutomationElement>>) -> RawNode {
    unsafe {
        *budget = budget.saturating_sub(1);
        let name = e.CachedName().map(|b| b.to_string()).unwrap_or_default();
        let ct = e.CachedControlType().map(|c| c.0).unwrap_or(50025);
        let aid = e.CachedAutomationId().map(|b| b.to_string()).unwrap_or_default();
        let class = e.CachedClassName().map(|b| b.to_string()).unwrap_or_default();
        let r = e.CachedBoundingRectangle().unwrap_or_default();
        let password = e.CachedIsPassword().map(|b| b.as_bool()).unwrap_or(false);
        let mut patterns = vec![];
        for (pid, label) in PATTERNS {
            if e.GetCachedPattern(pid).is_ok() {
                patterns.push(label.to_string());
            }
        }
        let value = if !password && patterns.iter().any(|p| p == "value") {
            e.GetCachedPatternAs::<IUIAutomationValuePattern>(UIA_ValuePatternId).ok().and_then(|v| v.CachedValue().ok()).map(|b| b.to_string()).filter(|s| !s.is_empty())
        } else {
            None
        };
        if let Some(v) = elems.as_mut() {
            v.push(e.clone());
        }
        let mut children = vec![];
        if let Ok(arr) = e.GetCachedChildren() {
            let n = arr.Length().unwrap_or(0);
            for i in 0..n {
                if *budget == 0 {
                    break;
                }
                if let Ok(c) = arr.GetElement(i) {
                    children.push(node_of(&c, &format!("{path}.{i}"), budget, elems));
                }
            }
        }
        RawNode {
            key: format!("{ct}|{aid}|{class}|{name}|{path}"),
            role: role_of(ct).to_string(),
            name,
            automation_id: aid,
            class,
            rect: [r.left, r.top, r.right, r.bottom],
            enabled: e.CachedIsEnabled().map(|b| b.as_bool()).unwrap_or(true),
            offscreen: e.CachedIsOffscreen().map(|b| b.as_bool()).unwrap_or(false),
            focusable: e.CachedIsKeyboardFocusable().map(|b| b.as_bool()).unwrap_or(false),
            password,
            patterns,
            value,
            source: "uia".into(),
            children,
        }
    }
}

pub fn scan(hwnd: i64, max_nodes: usize) -> Result<RawNode, PErr> {
    with_uia(|a| unsafe {
        let cr = cache_request(a, false)?;
        let el = a.ElementFromHandleBuildCache(crate::sys::hwnd_from(hwnd), &cr).map_err(|e| PErr::NotFound(format!("ElementFromHandle: {e}")))?;
        let mut budget = max_nodes;
        Ok(node_of(&el, "0", &mut budget, &mut None))
    })
}

fn flatten(n: &RawNode, out: &mut Vec<LiveCand>) {
    out.push(LiveCand { index: out.len(), key: n.key.clone(), role: n.role.clone(), name: n.name.clone(), automation_id: n.automation_id.clone(), rect: n.rect });
    n.children.iter().for_each(|c| flatten(c, out));
}

pub fn act(w: &WindowInfo, e: &RefEntry, op: &ActOp) -> Result<ActResult, PErr> {
    with_uia(|a| unsafe {
        let cr = cache_request(a, true)?;
        let el = a.ElementFromHandleBuildCache(crate::sys::hwnd_from(w.window_id), &cr).map_err(|x| PErr::Stale(format!("window not reachable: {x}")))?;
        let mut elems: Vec<IUIAutomationElement> = Vec::new();
        let mut budget = 20000usize;
        let raw = node_of(&el, "0", &mut budget, &mut Some(&mut elems));
        let mut live = vec![];
        flatten(&raw, &mut live);
        let idx = pick_match(e, &live).map_err(|er| match er.kind {
            dscu_core::protocol::ErrKind::AmbiguousTarget => PErr::Ambiguous(er.data.and_then(|d| d["candidates"].as_array().cloned()).unwrap_or_default()),
            _ => PErr::Stale(er.message),
        })?;
        let target = &elems[idx];
        let rc = live[idx].rect;
        let ok = |p: &str| Ok(ActResult { pattern: p.into(), detail: "ok".into(), rect: Some(rc) });
        let np = |m: &str| PErr::NoPattern(m.to_string());
        match (op.kind.as_str(), op.pattern.as_str()) {
            ("locate", _) => ok("locate"),
            (_, "invoke") => {
                target.GetCurrentPatternAs::<IUIAutomationInvokePattern>(UIA_InvokePatternId).map_err(|_| np("invoke"))?.Invoke().map_err(|x| PErr::Other(format!("Invoke: {x}")))?;
                ok("invoke")
            }
            (_, "toggle") => {
                target.GetCurrentPatternAs::<IUIAutomationTogglePattern>(UIA_TogglePatternId).map_err(|_| np("toggle"))?.Toggle().map_err(|x| PErr::Other(format!("Toggle: {x}")))?;
                ok("toggle")
            }
            (_, "select") => {
                target.GetCurrentPatternAs::<IUIAutomationSelectionItemPattern>(UIA_SelectionItemPatternId).map_err(|_| np("select"))?.Select().map_err(|x| PErr::Other(format!("Select: {x}")))?;
                ok("select")
            }
            (k, "expand") | (k, "expand_collapse") => {
                let p = target.GetCurrentPatternAs::<IUIAutomationExpandCollapsePattern>(UIA_ExpandCollapsePatternId).map_err(|_| np("expand_collapse"))?;
                if k == "collapse" { p.Collapse() } else { p.Expand() }.map_err(|x| PErr::Other(format!("ExpandCollapse: {x}")))?;
                ok("expand_collapse")
            }
            (_, "value") => {
                let p = target.GetCurrentPatternAs::<IUIAutomationValuePattern>(UIA_ValuePatternId).map_err(|_| np("value"))?;
                if p.CurrentIsReadOnly().map(|b| b.as_bool()).unwrap_or(false) {
                    return Err(np("value is read-only"));
                }
                p.SetValue(&BSTR::from(op.text.clone().unwrap_or_default())).map_err(|x| PErr::Other(format!("SetValue: {x}")))?;
                ok("value")
            }
            (_, "scroll") => {
                let p = target.GetCurrentPatternAs::<IUIAutomationScrollPattern>(UIA_ScrollPatternId).map_err(|_| np("scroll"))?;
                let v = if op.amount < 0 { ScrollAmount_LargeDecrement } else { ScrollAmount_LargeIncrement };
                p.Scroll(ScrollAmount_NoAmount, v).map_err(|x| PErr::Other(format!("Scroll: {x}")))?;
                ok("scroll")
            }
            (_, "focus") => {
                target.SetFocus().map_err(|x| PErr::Other(format!("SetFocus: {x}")))?;
                ok("focus")
            }
            _ => Err(np("unsupported op")),
        }
    })
}
