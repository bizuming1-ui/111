    [DllImport("user32.dll")] static extern bool SetProcessDpiAwarenessContext(IntPtr v);
    [DllImport("user32.dll")] static extern uint GetDpiForSystem();
    [DllImport("dwmapi.dll")] static extern int DwmGetWindowAttribute(IntPtr h, int attr, out int val, int size);
    static uint ownTick = 0;
    public static void InitDpi() {
        try { SetProcessDpiAwarenessContext(new IntPtr(-4)); } catch { }
        try { SetProcessDPIAware(); } catch { }
    }
    public static double DpiScale() { try { return GetDpiForSystem() / 96.0; } catch { return 1.0; } }
    public static int PrimaryW() { return GetSystemMetrics(0); }
    public static int PrimaryH() { return GetSystemMetrics(1); }
    public static int VirtX() { return GetSystemMetrics(76); }
    public static int VirtY() { return GetSystemMetrics(77); }
    public static int VirtW() { return GetSystemMetrics(78); }
    public static int VirtH() { return GetSystemMetrics(79); }
    public static int[] CursorPos() { POINT p = new POINT(); GetCursorPos(out p); return new int[] { p.X, p.Y }; }
    public static void SetCursor(int x, int y) { SetCursorPos(x, y); }
    // 距离「用户」最后一次输入的毫秒数；本进程自己 SendInput 产生的输入不计入
    public static int UserIdleMs() {
        LASTINPUTINFO li = new LASTINPUTINFO();
        li.cbSize = (uint)Marshal.SizeOf(typeof(LASTINPUTINFO));
        if (!GetLastInputInfo(ref li)) return 99999;
        uint now = GetTickCount();
        if (ownTick != 0) {
            int diff = unchecked((int)(ownTick - li.dwTime));
            if (diff >= 0 && diff < 150) return 99999;
        }
        uint idle = unchecked(now - li.dwTime);
        return (int)Math.Min(99999u, idle);
    }
    static void Send(INPUT[] a) {
        if (a.Length == 0) return;
        SendInput((uint)a.Length, a, Marshal.SizeOf(typeof(INPUT)));
        ownTick = GetTickCount();
    }
    static INPUT Mouse(uint flags, int data) {
        INPUT i = new INPUT(); i.type = 0; i.U.mi.dwFlags = flags; i.U.mi.mouseData = data; return i;
    }
    static INPUT KeyIn(int vk, bool up, bool ext) {
        INPUT i = new INPUT(); i.type = 1;
        i.U.ki.wVk = (ushort)vk;
        i.U.ki.wScan = (ushort)MapVirtualKey((uint)vk, 0);
        i.U.ki.dwFlags = (up ? 2u : 0u) | (ext ? 1u : 0u);
        return i;
    }
    static INPUT UniIn(char c, bool up) {
        INPUT i = new INPUT(); i.type = 1;
        i.U.ki.wVk = 0; i.U.ki.wScan = (ushort)c;
        i.U.ki.dwFlags = 0x4u | (up ? 2u : 0u);
        return i;
    }
    static uint BtnDown(int b) { return b == 1 ? 0x08u : (b == 2 ? 0x20u : 0x02u); }
    static uint BtnUp(int b) { return b == 1 ? 0x10u : (b == 2 ? 0x40u : 0x04u); }
    public static void Key(int vk, bool up, bool ext) { Send(new INPUT[] { KeyIn(vk, up, ext) }); }
    public static void UnicodeText(string s) {
        List<INPUT> list = new List<INPUT>();
        for (int i = 0; i < s.Length; i++) {
            char c = s[i];
            if (c == '\r') {
                if (i + 1 < s.Length && s[i + 1] == '\n') continue;
                list.Add(KeyIn(0x0D, false, false)); list.Add(KeyIn(0x0D, true, false)); continue;
            }
            if (c == '\n') { list.Add(KeyIn(0x0D, false, false)); list.Add(KeyIn(0x0D, true, false)); continue; }
            if (c == '\t') { list.Add(KeyIn(0x09, false, false)); list.Add(KeyIn(0x09, true, false)); continue; }
            list.Add(UniIn(c, false)); list.Add(UniIn(c, true));
            if (list.Count >= 200) { Send(list.ToArray()); list.Clear(); Thread.Sleep(4); }
        }
        if (list.Count > 0) Send(list.ToArray());
    }
    static void Restore(POINT old, int lastX, int lastY) {
        POINT now = new POINT(); GetCursorPos(out now);
        // 只有指针仍停在我们放的位置才归位；用户中途动了鼠标就不抢
        if (Math.Abs(now.X - lastX) <= 3 && Math.Abs(now.Y - lastY) <= 3) SetCursorPos(old.X, old.Y);
    }
    public static void PhysicalClick(int x, int y, int button, int count, bool restore) {
        POINT old = new POINT(); GetCursorPos(out old);
        SetCursorPos(x, y); Thread.Sleep(25);
        for (int i = 0; i < count; i++) {
            Send(new INPUT[] { Mouse(BtnDown(button), 0) }); Thread.Sleep(25);
            Send(new INPUT[] { Mouse(BtnUp(button), 0) });
            Thread.Sleep(i + 1 < count ? 45 : 15);
        }
        if (restore) Restore(old, x, y);
    }
    public static void PhysicalHover(int x, int y, int ms) {
        POINT old = new POINT(); GetCursorPos(out old);
        SetCursorPos(x, y); Thread.Sleep(ms);
        Restore(old, x, y);
    }
    public static void PhysicalDrag(int x1, int y1, int x2, int y2, int steps) {
        POINT old = new POINT(); GetCursorPos(out old);
        SetCursorPos(x1, y1); Thread.Sleep(30);
        Send(new INPUT[] { Mouse(0x02u, 0) }); Thread.Sleep(40);
        for (int i = 1; i <= steps; i++) {
            double t = (double)i / steps; t = t * t * (3 - 2 * t);
            SetCursorPos((int)Math.Round(x1 + (x2 - x1) * t), (int)Math.Round(y1 + (y2 - y1) * t));
            Thread.Sleep(8);
        }
        SetCursorPos(x2, y2); Thread.Sleep(40);
        Send(new INPUT[] { Mouse(0x04u, 0) });
        Thread.Sleep(15);
        Restore(old, x2, y2);
    }
    public static void PhysicalWheel(int x, int y, int notches, bool restore) {
        POINT old = new POINT(); GetCursorPos(out old);
        SetCursorPos(x, y); Thread.Sleep(30);
        int dir = notches >= 0 ? 1 : -1;
        for (int i = 0; i < Math.Abs(notches); i++) { Send(new INPUT[] { Mouse(0x0800u, 120 * dir) }); Thread.Sleep(25); }
        Thread.Sleep(15);
        if (restore) Restore(old, x, y);
    }
    // ---- 窗口查询 ----
    public static string WinText(IntPtr h) { StringBuilder sb = new StringBuilder(512); GetWindowText(h, sb, 512); return sb.ToString(); }
    public static string WinClass(IntPtr h) { StringBuilder sb = new StringBuilder(256); GetClassName(h, sb, 256); return sb.ToString(); }
    public static uint WinPid(IntPtr h) { uint p = 0; GetWindowThreadProcessId(h, out p); return p; }
    public static int[] WinRect(IntPtr h) { RECT r = new RECT(); GetWindowRect(h, out r); return new int[] { r.Left, r.Top, r.Right, r.Bottom }; }
    public static IntPtr Root(IntPtr h) { if (h == IntPtr.Zero) return h; return GetAncestor(h, 2); }
    public static IntPtr RootAt(int x, int y) {
        POINT p = new POINT(); p.X = x; p.Y = y;
        IntPtr h = WindowFromPoint(p);
        if (h == IntPtr.Zero) return h;
        return GetAncestor(h, 2);
    }
    public static IntPtr DeepChildAt(IntPtr top, int sx, int sy) {
        IntPtr cur = top;
        for (int i = 0; i < 12; i++) {
            POINT p = new POINT(); p.X = sx; p.Y = sy;
            if (!ScreenToClient(cur, ref p)) break;
            IntPtr c = ChildWindowFromPointEx(cur, p, 0x7u);
            if (c == IntPtr.Zero || c == cur) break;
            cur = c;
        }
        return cur;
    }
    public static bool PostClick(IntPtr h, int sx, int sy, int button, int count) {
        POINT p = new POINT(); p.X = sx; p.Y = sy;
        if (!ScreenToClient(h, ref p)) return false;
        IntPtr l = new IntPtr(((p.Y & 0xFFFF) << 16) | (p.X & 0xFFFF));
        uint down = button == 1 ? 0x0204u : (button == 2 ? 0x0207u : 0x0201u);
        uint up = button == 1 ? 0x0205u : (button == 2 ? 0x0208u : 0x0202u);
        uint dbl = button == 1 ? 0x0206u : (button == 2 ? 0x0209u : 0x0203u);
        IntPtr mk = new IntPtr(button == 1 ? 0x0002 : (button == 2 ? 0x0010 : 0x0001));
        PostMessage(h, 0x0200u, IntPtr.Zero, l);
        Thread.Sleep(15);
        for (int i = 0; i < count; i++) {
            PostMessage(h, (i == 0) ? down : dbl, mk, l); Thread.Sleep(20);
            PostMessage(h, up, IntPtr.Zero, l); Thread.Sleep(30);
        }
