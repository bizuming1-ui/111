$script:VK = @{
    ctrl = 0x11; control = 0x11; alt = 0x12; shift = 0x10; win = 0x5B; windows = 0x5B; cmd = 0x5B; lwin = 0x5B
    enter = 0x0D; return = 0x0D; tab = 0x09; esc = 0x1B; escape = 0x1B; space = 0x20
    backspace = 0x08; delete = 0x2E; del = 0x2E; insert = 0x2D
    up = 0x26; down = 0x28; left = 0x25; right = 0x27
    home = 0x24; end = 0x23; pageup = 0x21; pagedown = 0x22
    apps = 0x5D; printscreen = 0x2C; capslock = 0x14
    '-' = 0xBD; '=' = 0xBB; ',' = 0xBC; '.' = 0xBE; '/' = 0xBF; ';' = 0xBA; "'" = 0xDE
    '[' = 0xDB; ']' = 0xDD; '\' = 0xDC; '`' = 0xC0
}
$script:ExtendedVK = @(0x26, 0x28, 0x25, 0x27, 0x24, 0x23, 0x21, 0x22, 0x2D, 0x2E, 0x5B, 0x5D)
function Resolve-VK([string]$name) {
    $name = $name.Trim().ToLower()
    if ($script:VK.ContainsKey($name)) { return [byte]$script:VK[$name] }
    if ($name -match '^f([1-9]|1[0-2])$') { return [byte](0x6F + [int]$Matches[1]) }
    if ($name.Length -eq 1) {
        $code = [int][char]$name.ToUpper()
        if (($code -ge 65 -and $code -le 90) -or ($code -ge 48 -and $code -le 57)) { return [byte]$code }
    }
    throw "不支持的按键: '$name'"
}
function Send-KeyCombo([string]$combo) {
    $parts = @($combo.ToLower().Split('+') | ForEach-Object { $_.Trim() } | Where-Object { $_ })
    if ($parts.Count -eq 0) { throw 'keys 不能为空' }
    $codes = @($parts | ForEach-Object { Resolve-VK $_ })
    $down = New-Object System.Collections.Generic.List[int]
    try {
        foreach ($c in $codes) {
            [DsNative4]::Key([int]$c, $false, [bool]($script:ExtendedVK -contains [int]$c))
            $down.Add([int]$c)
            Start-Sleep -Milliseconds 12
        }
    }
    finally {
        # 无论中途是否出错，都倒序松开，绝不留下「卡住的修饰键」
        for ($i = $down.Count - 1; $i -ge 0; $i--) {
            [DsNative4]::Key($down[$i], $true, [bool]($script:ExtendedVK -contains $down[$i]))
            Start-Sleep -Milliseconds 12
        }
    }
}
function Send-KeySequence([string]$seq) {
    $norm = ($seq -replace '\s*\+\s*', '+').Trim()
    $items = @($norm -split '\s+' | Where-Object { $_ })
    if ($items.Count -eq 0) { throw 'keys 不能为空' }
    foreach ($it in $items) { Send-KeyCombo $it; Start-Sleep -Milliseconds 40 }
}
function Send-Text([string]$text) {
    if ($text.Length -le 400) {
        [DsNative4]::UnicodeText($text)   # Unicode 直输：不动剪贴板，中文 / Emoji 均可
        Start-Sleep -Milliseconds ([Math]::Min(500, 40 + $text.Length))
        return
    }
    $old = $null
    try { $old = Get-Clipboard -Raw -ErrorAction SilentlyContinue } catch { $old = $null }
    Set-Clipboard -Value $text
    Start-Sleep -Milliseconds 60
    Send-KeyCombo 'ctrl+v'
    Start-Sleep -Milliseconds 400
    if ($null -ne $old -and $old -ne '') { try { Set-Clipboard -Value $old } catch { } }
}
function Assert-KeyboardReady {
    $fg = [DsNative4]::GetForegroundWindow()
    if (Test-IsConsoleWindow $fg) { throw '前台窗口是运行本脚本的控制台，已拒绝发送按键/文本（防止输入到自己）。请先 launch / focus_window 切换到目标程序。' }
    if ($script:ObsHwnd -ne [IntPtr]::Zero -and $fg -ne $script:ObsHwnd) {
        throw "前台窗口已变化（观察时 [$([DsNative4]::WinText($script:ObsHwnd))]，现在 [$([DsNative4]::WinText($fg))]），为避免输入到错误窗口已取消，请重新观察。"
    }
    Wait-UserIdle
}
