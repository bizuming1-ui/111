//! Secret hygiene: nothing sensitive may reach logs, spans or error payloads.
use serde_json::Value;

const SENSITIVE_KEYS: [&str; 10] = ["text", "password", "passwd", "secret", "token", "auth", "api_key", "apikey", "authorization", "text_b64"];

pub fn redact_str(s: &str) -> String {
    let mut out = String::with_capacity(s.len());
    let b = s.as_bytes();
    let mut i = 0;
    while i < b.len() {
        let rest = &s[i..];
        if rest.starts_with("sk-") {
            let n = rest[3..].bytes().take_while(|c| c.is_ascii_alphanumeric() || *c == b'-' || *c == b'_').count();
            if n >= 16 {
                out.push_str("sk-***");
                i += 3 + n;
                continue;
            }
        }
        if rest.len() >= 7 && rest[..7].eq_ignore_ascii_case("bearer ") {
            let n = rest[7..].bytes().take_while(|c| !c.is_ascii_whitespace()).count();
            out.push_str("Bearer ***");
            i += 7 + n;
            continue;
        }
        let ch = rest.chars().next().unwrap();
        out.push(ch);
        i += ch.len_utf8();
    }
    out
}

pub fn redact_value(v: &Value) -> Value {
    match v {
        Value::Object(m) => Value::Object(
            m.iter()
                .map(|(k, val)| {
                    let kl = k.to_ascii_lowercase();
                    if SENSITIVE_KEYS.contains(&kl.as_str()) {
                        let n = match val {
                            Value::String(s) => s.chars().count(),
                            _ => 0,
                        };
                        (k.clone(), Value::String(format!("<redacted:{n}>")))
                    } else {
                        (k.clone(), redact_value(val))
                    }
                })
                .collect(),
        ),
        Value::Array(a) => Value::Array(a.iter().map(redact_value).collect()),
        Value::String(s) => Value::String(redact_str(s)),
        o => o.clone(),
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use serde_json::json;
    #[test]
    fn redacts() {
        let v = redact_value(&json!({"method":"uia.act","params":{"ref":"@s1:e1","text":"hunter2","note":"key sk-abcdefghijklmnopqrstuv ok"}}));
        let s = v.to_string();
        assert!(!s.contains("hunter2") && !s.contains("abcdefghijklmnop") && s.contains("<redacted:7>"));
        assert_eq!(redact_str("Authorization: Bearer abc.def"), "Authorization: Bearer ***");
    }
}
