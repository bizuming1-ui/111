        self.say(f"  🧠 统一大脑 v15 · 驱动={self.hub.driver_kind} · 版本 {hello.get('version')} · uiAccess={hello.get('uiaccess')} · 管理员={hello.get('elevated')}")
        if hello.get("rust_error"):
            self.say(f"  ⚠ Rust 驱动未接管，原因：{hello['rust_error']}（已显式回退 py-native，功能等价、性能较低）")
        try:
            self.cli_tools = await asyncio.to_thread(cli_anything.discover)
            if self.cli_tools:
                self.say(f"  🧰 CLI-Anything Layer-0：发现 {len(self.cli_tools)} 个可用工具（{', '.join(sorted(self.cli_tools)[:8])}）")
        except Exception:  # noqa: BLE001
            self.cli_tools = {}
        if self.llm is None and self.cfg.api_key:
            self.llm = DeepSeek(self.cfg.api_key, self.cfg.base_url, self.cfg.model, self.cfg.vision_model)

    async def stop(self) -> None:
        if self.llm is not None and hasattr(self.llm, "aclose"):
            await self.llm.aclose()
        await self.hub.close()

    # ------------------------------------------------------------------ perception
    def _fg_is_browser(self, d: Observation) -> bool:
        fg = d.fg_window()
        return bool(fg and fg.process.lower() in BROWSERS and not fg.own_console)

    async def observe(self, st: TaskState, *, forced: Optional[str] = None, want_shot: bool = False, main_loop: bool = False) -> Bundle:
        return await self.perception.observe(st, forced=forced, want_shot=want_shot, main_loop=main_loop)

    _annotate = staticmethod(Perception.annotate)

    # ------------------------------------------------------------------ prompt assembly
    def _obs_text(self, st: TaskState, b: Bundle, directive: Directive, last_result: str, delta: str) -> str:
        o = b.obs
        fg = o.fg_window()
        lines = [f"【第 {st.step} 步观察】"]
        if last_result:
            lines.append("上一步结果: " + last_result)
        s = o.dxgi_stats
        scr = f"{s.width}x{s.height} 抓屏={s.capture_backend}/{s.frame_ms:.1f}ms/脏矩形={s.dirty_rects_count}" if s else "n/a"
        lines.append(f"[感知通道] {b.channel}（cdp_up={self.hub.cdp_up}, 控件={len(o.elements)}, 停滞步={st.stalled_steps}, 连续受阻={st.blocked_streak}）  屏幕: {scr}")
        if fg:
            lines.append(f'[前台] hwnd={fg.hwnd} {fg.process} "{fg.title[:60]}"' + ("（这是运行本脚本的控制台）" if fg.own_console else ""))
        if o.url:
            lines.append(f"[URL] {o.url[:140]}  settled={o.settled} 相关在途请求={o.inflight}")
        tw = o.target_window()
        if tw and tw.hwnd != (fg.hwnd if fg else 0):
            lines.append(f'[目标窗口] hwnd={tw.hwnd} {tw.process} "{tw.title[:50]}"')
        occ = describe_occluders(o)
        if occ:
            lines.append("[遮挡] " + occ)
        top = [w for w in o.windows if not w.own_console][:7]
        lines.append("[窗口] " + " | ".join(f"{w.process}:{w.title[:22]}" for w in top))
        txt, _ = render_elements(o)
        lines.append("[控件]\n" + (txt or "（无）"))
        if delta:
            lines.append("[界面变化] " + delta)
        recent = st.ledger[-5:]
        if recent:
            lines.append("[动作账本] " + " ; ".join(f"#{e.step} {e.sig[:48]}→{e.effect}" + (f"({e.code})" if e.code != "OK" else "") for e in recent))
        so = self.registry.summary()
        if so:
            lines.append("[稳定对象] " + so)
        if directive.text:
            lines.append("[系统指令]\n" + directive.text)
        if b.note:
            lines.append("[提示] " + b.note)
        return "\n".join(lines)

    @staticmethod
    def _delta(st: TaskState, b: Bundle) -> str:
        fp = obs_fingerprint(b.obs)
        prev = st.last_fp
        st.last_fp = fp
        if prev is None:
            return ""
        if prev["win"] != fp["win"]:
            return "前台/标题/URL 已变化"
        if prev["els"] != fp["els"]:
            return f"控件集合变化（{prev['n']}→{fp['n']}）"
        return "控件列表与上一轮完全相同（上一步可能没生效或页面仍在加载）"

    async def _llm(self, messages: list[dict[str, Any]], vision: bool = False, max_tokens: Optional[int] = None) -> Reply:
        if self.llm is None:
            raise ApiKeyError("未配置 DeepSeek API Key")
        r = await self.llm.chat(messages, vision=vision, max_tokens=max_tokens)
        self.lat["decision" if not vision else "vision"].append(r.ms)
        return r

    async def plan(self, st: TaskState, b: Bundle) -> Optional[dict[str, Any]]:
        txt = f"【任务】{st.task}\n\n【当前观察】\n" + self._obs_text(st, b, Directive(), "", "")
        try:
            r = await self._llm([{"role": "system", "content": PLANNER_PROMPT}, {"role": "user", "content": txt}], max_tokens=900)
        except ApiKeyError:
            raise
        except ApiError as e:
            self.say(f"  （规划失败，直接执行：{e}）")
            return None
        st.llm_calls += 1
        st.tokens_in += r.prompt_tokens
        st.tokens_out += r.completion_tokens
        try:
            p = extract_json(r.text)
        except ValueError:
            return None
        self.say("【执行计划】")
        self.say(f"  目标: {p.get('goal', '')}")
        self.say(f"  完成证据: {'; '.join(p.get('done_when', []))}")
        for i, s in enumerate(p.get("steps", []), 1):
            self.say(f"  {'→' if i == 1 else '·'} {i}. {s.get('act', '')} ｜方法: {s.get('how', '')} ｜核实: {s.get('verify', '')}")
        if p.get("risks"):
            self.say("  风险: " + "；".join(p["risks"]))
        return p

    def _compact(self) -> None:
        if sum(len(m["content"]) if isinstance(m["content"], str) else 400 for m in self.history) < 60000:
            return
        k = max(4, len(self.history) // 2) // 2 * 2
        head = self.history[:k]
        digest = "\n".join(("A:" if m["role"] == "assistant" else "U:") + str(m["content"])[:160].replace("\n", " ") for m in head)
        self.history = [self.history[0], {"role": "user", "content": SUMMARY_HEADER + "\n" + digest[:3000]}] + self.history[k:]
        self.counters["compactions"] += 1

    async def decide(self, st: TaskState, b: Bundle, directive: Directive, last_result: str, delta: str, plan: Optional[dict[str, Any]]) -> tuple[dict[str, Any], Reply]:
        text = self._obs_text(st, b, directive, last_result, delta)
        vf = getattr(self.llm, "vision_failures", 0)
        vision = b.channel == "dxgi_vision" and b.shot is not None and ((b.latched and vf < 5) or (st.vision_rounds < 14 and vf < 3))
        if vision:
            st.vision_rounds += 1
            detail = b.shot_detail if b.latched else ("low" if st.vision_rounds % 3 else "original")
            self.counters["vision_calls"] += 1
            if b.latched:
                self.counters["vision_latched_calls"] += 1
            cap = "（附图=强制视觉轮：DXGI 真实截图 + 屏幕坐标网格 x*/y* + SoM 红框编号（与上方[控件]编号一致）；坐标点击请加 vision_grounded:true）" if b.latched else "（附图：屏幕坐标网格 x*/y* 标注真实屏幕坐标；红框编号=控件编号）"
            content: Any = [{"type": "text", "text": text + "\n" + cap}, image_part(b.shot, detail)]
        else:
            content = text
        if not self.history:
            head = f"【当前任务】{st.task}"
            if plan:
                head += "\n【执行计划】" + json.dumps(plan, ensure_ascii=False)[:1500]
            self.history.append({"role": "user", "content": head})
        msgs = [{"role": "system", "content": SYSTEM_PREFIX}] + self.history + [{"role": "user", "content": content}]
        reply = await self._llm(msgs, vision=vision)
        try:
            data = extract_json(reply.text)
        except ValueError:
            msgs.append({"role": "assistant", "content": reply.text})
            msgs.append({"role": "user", "content": "你的输出不是合法 JSON。只输出一个 JSON 对象。"})
            reply = await self._llm(msgs, vision=False)
            data = extract_json(reply.text)
        st.llm_calls += 1
        st.tokens_in += reply.prompt_tokens
        st.tokens_out += reply.completion_tokens
        st.cache_hit += reply.cache_hit
        # append-only history keeps the KV prefix stable (image never enters history)
        self.history.append({"role": "user", "content": text})
        self.history.append({"role": "assistant", "content": reply.text})
        self._compact()
        return data, reply

    # ------------------------------------------------------------------ execution
    async def _drv(self, action: str, b: Optional[Bundle], **kw: Any) -> ActionResult:
        t0 = time.perf_counter()
        r = await self.hub.drv_action({"action": action, "action_id": new_action_id(), **kw})
        self.lat["input"].append((time.perf_counter() - t0) * 1000)
        return r

    async def _cdp(self, action: str, **kw: Any) -> ActionResult:
        if not self.hub.cdp_up:
            await self.hub.ensure_cdp()
        if not self.hub.cdp_up:
            return ActionResult(ok=False, code=Code.UNSUPPORTED, message=f"CDP 守护进程不可用：{self.hub.cdp_error}")
        t0 = time.perf_counter()
        r = await self.hub.cdp_action({"action": action, "action_id": new_action_id(), **kw})
        self.lat["network"].append((time.perf_counter() - t0) * 1000)
        return r

    async def _focus(self, b: Bundle, **kw: Any) -> ActionResult:
        """Verified focus + autonomous remedy ladder (minimize blockers once, then report evidence)."""
        r = await self._drv("focus_window", b, **kw)
        if r.code in (Code.FOREGROUND_FAILED, Code.OCCLUDED):
            self.counters["focus_remedies"] += 1
            tid = r.effect.get("target_hwnd")
            blockers = r.effect.get("occluded_by") or []
            by = {w.hwnd: w for w in b.drv.windows}
            tproc = by[tid].process.lower() if tid in by else ""
            done = []
            for h in blockers[:4]:
                w = by.get(h)
                if w and not w.own_console and w.process.lower() != tproc and (w.cls or "") not in ("Progman", "WorkerW", "Shell_TrayWnd"):
                    m = await self._drv("minimize_window", b, hwnd=h)
                    done.append(f"{w.process}:{w.title[:18]}→{'已最小化' if m.ok else m.code.value}")
            await asyncio.sleep(0.25)
            r2 = await self._drv("focus_window", b, **({"hwnd": tid} if tid else kw))
            if r2.ok:
                r2.message = f"{r2.message}（自动清理遮挡窗口：{'; '.join(done) or '无可最小化的窗口'}）"
                return r2
            r2.message = f"{r.message}；自动清理 [{'; '.join(done) or '无'}] 后重试仍失败：{r2.message}"
            return r2
        return r

    def _target_hwnd(self, b: Bundle) -> int:
        fg = b.drv.fg_window()
        if fg and not fg.own_console:
            return fg.hwnd
        return b.drv.hwnd

    async def _wait_window(self, match: Callable[[Any], bool], seconds: float = 4.0) -> Optional[Any]:
        end = time.time() + seconds
        while time.time() < end:
            o = await self.hub.drv_observe(channel="dxgi_vision", max_elements=1)
            for w in o.windows:
                if match(w):
                    return w
            await asyncio.sleep(0.3)
        return None

    async def _run_ps(self, command: str, timeout: int = 60) -> str:
        worker = self.cfg.root / "workers" / "ps_safe_worker.ps1"
        pw = "pwsh"
        req = json.dumps({"command": command, "timeout": timeout, "workspace": str(self.cfg.workspace)}, ensure_ascii=False)
        try:
            p = await asyncio.to_thread(subprocess.run, [pw, "-NoProfile", "-NonInteractive", "-File", str(worker)], input=req.encode("utf-8"), capture_output=True, timeout=timeout + 15)
        except Exception as e:  # noqa: BLE001
            return f"[SAFE_WORKER_ERROR] {e}"
        try:
            j = json.loads(p.stdout.decode("utf-8", "replace").strip().splitlines()[-1])
        except Exception:
            return f"[SAFE_WORKER_ERROR] {p.stderr.decode('utf-8', 'replace')[:300]}"
        if not j.get("ok"):
            return f"[{j.get('code', 'SECURITY_AST_VIOLATION')}] {j.get('message', '')}"
        return str(j.get("output", ""))[:2500]

    async def execute(self, a: dict[str, Any], b: Bundle, st: TaskState) -> ActionResult:
        name = a.get("action", "")
        els = b.els
        o = b.obs
        eh = self._target_hwnd(b)
        sel = els.get(a.get("id")) if a.get("id") is not None else None

        async def once(act: str, e: Element, bb: Bundle, **kw: Any) -> ActionResult:
            if e.is_cdp:
                return await self._cdp(act, ref=e.ref_id, expect_epoch=bb.epoch_cdp, **kw)
            return await self._drv(act, bb, ref=e.ref_id, expect_epoch=bb.drv.snapshot_epoch, expect_hwnd=self._target_hwnd(bb), **kw)

        async def on_element(act: str, e: Element, **kw: Any) -> ActionResult:
            r = await once(act, e, b, **kw)
            for _ in range(3):  # a human grabbed the mouse: yield, then retry the same action
                if r.code != Code.USER_ACTIVE:
                    break
                self.counters["user_active_waits"] += 1
                await asyncio.sleep(2.0)
                r = await once(act, e, b, **kw)
            if r.code == Code.STALE_EPOCH:  # self-healing ref: re-observe and re-resolve by stable_key once
                self.counters["stale_epoch"] += 1
                nb = await self.observe(st, forced=b.channel if b.channel != "dxgi_vision" else None)
                cand = [x for x in nb.obs.elements if x.stable_key == e.stable_key]
                if len(cand) == 1:
                    self.counters["stale_healed"] += 1
                    r = await once(act, cand[0], nb, **kw)
                    r.message += "（STALE_EPOCH 已按 stable_key 自动重绑一次）"
                elif len(cand) > 1:
                    r = ActionResult(ok=False, code=Code.AMBIGUOUS_TARGET, message=f"STALE_EPOCH 后有 {len(cand)} 个同 stable_key 控件，无法唯一重绑")
            return r

        try:
            if name in ("click", "double_click", "right_click", "hover"):
                if sel is not None:
                    return await on_element(name, sel)
                if "x" in a and "y" in a:
                    return await self._drv(name, b, x=int(a["x"]), y=int(a["y"]), expect_hwnd=eh)
                return ActionResult(ok=False, code=Code.NOT_FOUND, message="需要 id 或 x,y")
            if name == "type":
                text = str(a.get("text", ""))
                if sel is not None:
                    r = await on_element("type", sel, text=text, clear=bool(a.get("clear", True)), enter=bool(a.get("enter", False)))
                    if r.ok and a.get("enter") and not sel.is_cdp:
                        await self._drv("key", b, keys="enter", expect_hwnd=eh)
                    return r
                if b.channel == "cdp" and self.hub.cdp_up:
                    return ActionResult(ok=False, code=Code.NOT_FOUND, message="浏览器中 type 需要输入框 id")
                r = await self._drv("type", b, text=text, clear=bool(a.get("clear", False)), expect_hwnd=eh)
                if r.ok and a.get("enter"):
                    await self._drv("key", b, keys="enter", expect_hwnd=eh)
                return r
            if name == "key":
                if b.channel == "cdp" and self.hub.cdp_up:
                    return await self._cdp("key", keys=str(a.get("keys", "")))
                return await self._drv("key", b, keys=str(a.get("keys", "")), expect_hwnd=eh)
            if name == "scroll":
                if b.channel == "cdp" and self.hub.cdp_up:
                    return await self._cdp("scroll", direction=a.get("direction", "down"), amount=int(a.get("amount", 5)))
                return await self._drv("scroll", b, direction=a.get("direction", "down"), amount=int(a.get("amount", 5)), expect_hwnd=eh)
            if name == "drag":
                f, t = els.get(a.get("from_id")), els.get(a.get("to_id"))
                fx, fy = f.center if f else (int(a.get("from_x", 0)), int(a.get("from_y", 0)))
                tx, ty = t.center if t else (int(a.get("to_x", 0)), int(a.get("to_y", 0)))
                return await self._drv("drag", b, x=fx, y=fy, to_x=tx, to_y=ty, expect_hwnd=eh)
            if name in ("check", "uncheck"):
                want = name == "check"
                msgs, ok = [], True
                for i in a.get("ids", []):
                    e = els.get(i)
                    if e is None:
                        ok = False
                        msgs.append(f"{i}:不存在")
                        continue
                    if ("checked" in e.states) == want:
                        msgs.append(f"{i}:已是目标状态")
                        continue
                    r = await on_element("click", e)
                    ok &= r.ok
                    msgs.append(f"{i}:{r.code.value}")
                return ActionResult(ok=ok, code=Code.OK if ok else Code.INTERNAL, message="; ".join(msgs) + "（下一轮用 states 核验）")
            if name == "toolbar_action":
                key = str(a.get("name", "")).lower()
                cands = [e for e in o.elements if e.zone == "Toolbar" and key and key in e.name.lower()]
                if len(cands) != 1:
                    return ActionResult(ok=False, code=Code.AMBIGUOUS_TARGET if cands else Code.NOT_FOUND, message=f"[Zone: Toolbar] 匹配 {len(cands)} 个：{[c.name for c in cands][:5]}")
                num = next((i for i, e in els.items() if e.ref_id == cands[0].ref_id), None)
                if num is not None:
                    gate = ActionGate.check({"action": "click", "id": num}, o, st, els)
                    if gate:
                        return ActionResult(ok=False, code=gate[0], message=gate[1])
                r = await on_element("click", cands[0])
                r.message = "[Zone: Toolbar] " + r.message
                return r
            if name == "select_rows":
                return await self._select_rows(str(a.get("rows", "")), b, st)
            if name == "focus_window":
                return await self._focus(b, title=str(a.get("title", "")), hwnd=a.get("hwnd"))
            if name == "minimize_blockers":
                t = o.target_window() or o.fg_window()
                by = {w.hwnd: w for w in o.windows}
                out = []
                for h in (t.occluded_by if t else [])[:5]:
                    w = by.get(h)
                    if w and not w.own_console and (w.cls or "") not in ("Progman", "WorkerW", "Shell_TrayWnd"):
                        m = await self._drv("minimize_window", b, hwnd=h)
                        out.append(f"{w.process}:{w.title[:20]}={'ok' if m.ok else m.code.value}")
                return ActionResult(ok=bool(out), code=Code.OK if out else Code.NOT_FOUND, message="已处理遮挡窗口：" + ("; ".join(out) or "没有可最小化的遮挡窗口"))
            if name in ("launch", "app_resolve"):
                return await self._launch(str(a.get("target") or a.get("name") or ""), str(a.get("args", "")), b, st, activate_first=(name == "app_resolve"))
            if name == "cdp_navigate":
                r = await self._cdp("navigate", url=str(a.get("url", "")))
                if r.ok:
                    w = await self._wait_window(lambda w: w.process.lower() in BROWSERS and not w.own_console, 3.0)
                    if w:
                        f = await self._focus(b, hwnd=w.hwnd)
                        r.message += f"；浏览器前台：{'已验证' if f.ok else f.message[:80]}"
                    self.counters["cdp_navigate"] += 1
                return r
            if name == "cdp_wait_selector":
                return await self._cdp("wait_selector", selector=str(a.get("selector", "")), text=str(a.get("text", "")), timeout_ms=int(a.get("timeout", 8000)))
            if name == "save_text":
                ft = layer0.FileTask(str(a.get("folder", "桌面")), layer0.known_folder(str(a.get("folder", "桌面"))), str(a.get("name", "note")) + ("" if "." in str(a.get("name", "note")) else ".txt"), str(a.get("text", "")), "notepad")
                ok, msg, _ = layer0.write_verified(ft)
                return ActionResult(ok=ok, code=Code.OK if ok else Code.INTERNAL, message=("✅ " if ok else "❌ ") + msg)
            if name in ("verify_text_file", "file_stat"):
                p = Path(str(a.get("path", "")))
                if not p.is_absolute():
                    p = layer0.known_folder("桌面") / p
                if not p.exists():
                    return ActionResult(ok=False, code=Code.NOT_FOUND, message=f"文件不存在: {p}")
                data = p.read_bytes()
                exp = a.get("expect_text")
                match = (exp in data.decode("utf-8", "replace")) if exp is not None else None
                return ActionResult(ok=match is not False, code=Code.OK if match is not False else Code.INTERNAL, message=f"✅ 文件存在 {p}（{len(data)} 字节）" + (f" · 内容{'与要求一致' if match else '不一致'}" if match is not None else ""))
            if name == "dir_list":
                p = layer0.known_folder(str(a["path"])) if str(a.get("path")) in layer0.KNOWN_FOLDERS else Path(str(a.get("path", "")))
                items = sorted(p.glob(str(a.get("pattern", "*"))), key=lambda x: x.stat().st_mtime, reverse=True)[: int(a.get("limit", 30))]
                return ActionResult(ok=True, code=Code.OK, message="; ".join(f"{i.name}({i.stat().st_size}B)" for i in items) or "（空）")
            if name == "open_known_folder":
                ok, msg, view = await asyncio.to_thread(safe_shell.open_known_folder, str(a.get("name") or a.get("folder") or ""))
                if not ok:
                    return ActionResult(ok=False, code=Code.SECURITY_DENIED if "SECURITY_DENIED" in msg else Code.INTERNAL, message=msg)
                want = (lambda w: (not w.own_console) and safe_shell.window_is_recycle(w.title)) if view == "recyclebin" else (lambda w: (not w.own_console) and w.process.lower() == "explorer.exe" and w.title not in ("", "Program Manager"))  # noqa: E731
                w = await self._wait_window(want, 5.0)
                if w:
                    f = await self._focus(b, hwnd=w.hwnd)
                    return ActionResult(ok=True, code=Code.OK, message=f"{msg}；窗口已出现「{w.title[:30]}」，前台{'已验证' if f.ok else '未能置顶：' + f.message[:60]}")
                return ActionResult(ok=True, code=Code.OK, message=msg + "；5 秒内未确认到窗口标题（可 vision_inspect 查看）")
            if name == "recycle_bin_status":
                stt = await asyncio.to_thread(safe_shell.recycle_bin_status)
                if not stt.get("ok"):
                    return ActionResult(ok=False, code=Code.UNSUPPORTED, message=f"回收站独立核验不可用：{stt.get('reason')}")
                return ActionResult(ok=True, code=Code.OK, message=f"回收站真实项目数={stt['count']}（独立来源 {stt['sources']}，一致={stt.get('consistent')}）" + (f"；名称：{', '.join(stt.get('names', [])[:12])}" if stt.get("names") else ""))
            if name == "recycle_file":
                if not layer0.recycle_file_intent(st.task):
                    return ActionResult(ok=False, code=Code.SECURITY_DENIED, message="[SECURITY_DENIED] 任务原文没有删除/回收站意图，recycle_file 被拒绝")
                raw = str(a.get("path", ""))
                pth = Path(raw)
                if not pth.is_absolute():
                    parts = re.split(r"[\\/]", raw, maxsplit=1)
                    base = layer0.known_folder(parts[0]) if parts[0] in layer0.KNOWN_FOLDERS else layer0.known_folder("桌面")
                    pth = base / (parts[1] if len(parts) > 1 and parts[0] in layer0.KNOWN_FOLDERS else raw)
                before = await asyncio.to_thread(safe_shell.recycle_bin_status)
                ok, msg = await asyncio.to_thread(safe_shell.recycle_file, pth, (self.cfg.workspace,))
                if ok and before.get("ok"):
                    aft = await asyncio.to_thread(safe_shell.wait_recycle_count, int(before["count"]) + 1, 4.0)
                    msg += f"；回收站项目数 {before['count']}→{aft.get('count')}" + ("" if aft.get("count") == before["count"] + 1 else "（⚠ 数量未+1：该盘回收站可能被禁用/文件过大而被永久删除）")
                return ActionResult(ok=ok, code=Code.OK if ok else (Code.SECURITY_DENIED if "SECURITY_DENIED" in msg else Code.INTERNAL), message=msg)
            if name == "empty_recycle_bin":
                if not layer0.recycle_empty_intent(st.task):
                    return ActionResult(ok=False, code=Code.SECURITY_DENIED, message="[SECURITY_DENIED] 任务原文没有“清空/清除回收站”的明确意图，empty_recycle_bin 被拒绝（不可逆）")
                ok, msg = await asyncio.to_thread(safe_shell.empty_recycle_bin)
                if ok:
                    aft = await asyncio.to_thread(safe_shell.wait_recycle_count, 0, 8.0)
                    ok = bool(aft.get("ok") and aft.get("count") == 0)
                    msg += f"；独立核验 count={aft.get('count')}（{aft.get('sources')}）"
                return ActionResult(ok=ok, code=Code.OK if ok else Code.INTERNAL, message=msg)
            if name == "scroll_to":
                return await self._cdp("scroll_into_view", text=str(a.get("text", "")), ref=(els[a["id"]].ref_id if a.get("id") in els and els[a["id"]].is_cdp else ""))
            if name == "run_powershell":
                out = await self._run_ps(str(a.get("command", "")), int(a.get("timeout", 60)))
                bad = out.startswith("[SECURITY") or out.startswith("[SAFE_WORKER")
                return ActionResult(ok=not bad, code=Code.SECURITY_DENIED if bad else Code.OK, message="命令输出: " + out)
            if name == "wait":
                await asyncio.sleep(min(10.0, float(a.get("seconds", 1))))
                return ActionResult(ok=True, code=Code.OK, message="已等待")
            if name == "vision_inspect":
                reg = a.get("crop_region") or a.get("region")
                self.perception.arm_force_vision(str(a.get("detail", "low")), reg if isinstance(reg, list) else None, a.get("zoom"), str(a.get("reason", "")))
                self.counters["vision_inspect"] += 1
                return ActionResult(ok=True, code=Code.OK, message="视觉通道已锁存：下一轮强制 Vision(" + self.cfg.vision_model + ")·DXGI + SoM 网格截图（成功后自动复位）")
            if name in ("list_tabs", "switch_tab"):
                return await self._cdp("tabs" if name == "list_tabs" else "switch_tab", index=a.get("index"), url_contains=a.get("url_contains", ""), target_id=a.get("target_id", ""))
            if name in ("cli_tool", "cli_help"):
                tool = str(a.get("tool", ""))
                if name == "cli_help":
                    out = await asyncio.to_thread(cli_anything.help_text, tool)
                    return ActionResult(ok=bool(out), code=Code.OK if out else Code.NOT_FOUND, message=out[:1800] or f"未发现工具 {tool}")
                res = await asyncio.to_thread(cli_anything.run_json, tool, str(a.get("args", "")), int(a.get("timeout", 120)))
                return ActionResult(ok=res.ok, code=Code.OK if res.ok else Code.INTERNAL, message=res.render()[:1800])
            if name in ("inspect", "ocr"):
                return ActionResult(ok=False, code=Code.UNSUPPORTED, message=f"{name} 未内置；请用 vision_inspect（坐标网格截图）")
        except IpcError as e:
            return ActionResult(ok=False, code=Code.INTERNAL, message=f"IPC: {e}")
        return ActionResult(ok=False, code=Code.UNSUPPORTED, message=f"未知动作 {name}")

    async def _select_rows(self, spec: str, b: Bundle, st: TaskState) -> ActionResult:
        want: set[int] = set()
        for part in re.split(r"[,，]", spec):
            m = re.fullmatch(r"\s*(\d+)\s*(?:-\s*(\d+))?\s*", part)
            if m:
                want |= set(range(int(m.group(1)), int(m.group(2) or m.group(1)) + 1))
        if not want:
            return ActionResult(ok=False, code=Code.NOT_FOUND, message="rows 格式如 1-5")
        notes: list[str] = []
        if self.registry.targets_locked:
            want, notes = self.registry.translate_rows(want, b.obs.elements)
            if not want:
                return ActionResult(ok=True, code=Code.OK, message="；".join(notes) or "无目标行需要选择")
            self.counters["stable_translate"] += 1
        for attempt in range(2):
            nb = b if attempt == 0 else await self.observe(st, forced="cdp")
            boxes = {e.row: e for e in nb.obs.elements if e.zone == "Row" and e.role.lower() == "checkbox" and e.row}
            todo = [e for r_, e in boxes.items() if (r_ in want) != ("checked" in e.states)]
            for e in todo:
                r = await (self._cdp("click", ref=e.ref_id, expect_epoch=nb.epoch_cdp) if e.is_cdp else self._drv("click", nb, ref=e.ref_id, expect_epoch=nb.drv.snapshot_epoch, expect_hwnd=self._target_hwnd(nb)))
                if not r.ok:
                    return ActionResult(ok=False, code=r.code, message=f"select_rows 点击 R{e.row} 失败: {r.message}")
            await asyncio.sleep(0.8)
            vb = await self.observe(st, forced="cdp" if self.hub.cdp_up else None)
            checked = {e.row for e in vb.obs.elements if e.zone == "Row" and e.role.lower() == "checkbox" and "checked" in e.states}
            if checked == want:
                self.registry.observe_rows(vb.obs.elements, st.step)
                return ActionResult(ok=True, code=Code.OK, message=f"select_rows {spec}：✓ 闭环验证通过（复扫一致）：当前共勾选 {len(checked)} 行（R{sorted(checked)}）" + ("；" + "；".join(notes) if notes else ""))
            b = vb
        return ActionResult(ok=False, code=Code.INTERNAL, message=f"select_rows 闭环未通过：期望 {sorted(want)}，实际 {sorted(checked)}")

    async def _launch(self, target: str, args: str, b: Bundle, st: TaskState, activate_first: bool) -> ActionResult:
        if not target:
            return ActionResult(ok=False, code=Code.NOT_FOUND, message="缺少 target")
        info = layer0.resolve_app(target)
        proc_hint = (Path(str(info["target"])).stem if info and info["kind"] == "path" else target).lower()
        al = {x.lower() for x in layer0.ALIASES.get(target, [])} | {proc_hint, target.lower()}
        match = lambda w: (not w.own_console) and (w.process.lower().replace(".exe", "") in al or any(x in w.title.lower() for x in al if len(x) > 1))  # noqa: E731
        existing = next((w for w in b.drv.windows if match(w)), None)
        if existing and (activate_first or True):
            r = await self._focus(b, hwnd=existing.hwnd)
            r.message = f"已有窗口 {existing.process}「{existing.title[:24]}」→ 不重复启动；" + r.message
            if r.ok:
                st.launched.add(existing.process.lower())
                return r
        if st.crashes.get(proc_hint + ".exe", 0) >= 2 or st.crashes.get(proc_hint, 0) >= 2:
            return ActionResult(ok=False, code=Code.SECURITY_DENIED, message=f"[UNSTABLE_APP] {target} 已崩溃 ≥2 次，禁止再次启动。请 fail 并说明需要人工修复。")
        tgt = str(info["target"]) if info else target
        r = await self._drv("launch", b, target=tgt, args=args)
        if r.ok:
            w = await self._wait_window(match, 6.0)
            r.message = f"启动「{target}」→ {info['via'] if info else 'ShellExecute'}：{tgt}；" + (f"窗口已出现 {w.process}「{w.title[:24]}」" if w else "6 秒内未出现匹配窗口（应用可能崩溃/需要登录/启动慢）")
            if w:
                st.launched.add(w.process.lower())
                f = await self._focus(b, hwnd=w.hwnd)
                r.message += f"；前台{'已验证' if f.ok else '未能置顶：' + f.message[:80]}"
            else:
                r.ok, r.code = False, Code.NOT_FOUND
        return r

    async def _apply_intervention(self, iv: Intervention, b: Bundle, st: TaskState) -> Bundle:
        """Execute one rung of the Recovery Playbook (activate -> Ctrl+F -> 2x zoom relocate -> rollback) and re-observe."""
        self.say(f"  🛟 恢复剧本 · {iv.stage}")
        self.counters["playbook_" + iv.stage] += 1
        for a in iv.auto_actions:
            if a["action"] == "focus_window":
                r = await self._focus(b, hwnd=a.get("hwnd"))
            else:
                r = await self._drv(a["action"], b, keys=str(a.get("keys", "")), expect_hwnd=self._target_hwnd(b))
            self.say(f"    ↳ {a['action']} {a.get('keys', '')} → [{r.code.value}] {r.message[:80]}")
            await asyncio.sleep(0.2)
        if iv.arm_vision:
            self.perception.arm_force_vision(iv.arm_vision.get("detail", "low"), iv.arm_vision.get("crop_region"), iv.arm_vision.get("zoom"), iv.arm_vision.get("reason", ""))
        if iv.auto_actions or iv.arm_vision:
            await asyncio.sleep(0.2)
            return await self.observe(st, main_loop=True)
        return b

    # ------------------------------------------------------------------ the task loop
    async def run_task(self, task: str, max_steps: Optional[int] = None) -> str:
        self.task_no += 1
        self.history = []
        st = TaskState(task, max_steps=max_steps or self.cfg.max_steps)
        say = self.say
        say(f"\n╭─ 任务 #{self.task_no} ─────────────────────────")
        status, summary = "maxsteps", ""
        try:
            status, summary = await self._run(st)
        except ApiKeyError as e:
            status, summary = "api_key", str(e)
            say(f"✖ {e}")
        except (ApiError, IpcError) as e:
            status, summary = "error", str(e)
            say(f"✖ 运行出错：{e}")
        except asyncio.CancelledError:
            status = "cancelled"
            raise
        self._report(st, status, summary)
        say(f"╰─ 任务 #{self.task_no} 结束（{status}）──────────\n")
        return status

    async def _run(self, st: TaskState) -> tuple[str, str]:
        say = self.say
        l0 = layer0.parse_file_task(st.task)
        if l0:
            return await self._layer0_file(l0, st)
        self.recovery.reset()
        rt = layer0.parse_recycle_task(st.task)
        if rt is not None:
            return await self._layer0_recycle(rt, st)
        plan: Optional[dict[str, Any]] = None
        last_result = ""
        self.registry = StableObjectRegistry()
        self.verifier.reg = self.registry
        self.verifier.rejections = 0
        self.playbook.reset()
        self.tx = TaskTransaction(self.cfg.data_dir / "tx_journal.jsonl")
        self.tx.begin()
        st.quantity0 = st.quantity  # type: ignore[attr-defined]
        destructive_step = -9
        forced: Optional[str] = None
        for step in range(1, st.max_steps + 1):
            st.step = step
            if time.time() - st.t0 > st.max_seconds:
                return "timeout", "超过任务时限"
            say(f"── 第 {step} 步 ──")
            b = await self.observe(st, forced=forced, main_loop=True)
            forced = None
            settled = st.settle_last(b.obs)
            if settled is not None:
                say(f"  ↳ 上一步效果核验：{settled.effect}（{settled.sig[:50]}）")
            directive = self.ladder.evaluate(st, b.obs)
            _note = self.recovery.take_note()
            _deny = self.recovery.deny_summary()
            if _note or _deny:
                directive.text = (directive.text + "\n" if directive.text else "") + "\n".join(x for x in (_note, _deny) if x)
            if directive.auto_remedy == "minimize_blockers" and b.obs.target_window() and b.obs.target_window().occluded_by and st.step > 1 and (st.stalled_steps >= 1 or st.loop_hits):
                rr = await self.execute({"action": "minimize_blockers"}, b, st)
                self.counters["auto_remedies"] += 1
                directive.text += f"\n· 系统已自动执行 minimize_blockers：{rr.message}"
            if settled is not None:
                self.tx.settle(settled.code == "OK", settled.effect)
                iv = self.playbook.feed(settled.action, settled.effect, b.obs, settled.evidence.get("click_xy"))
                if iv is not None:
                    if iv.escalate_human:
                        self.counters["human_escalations"] += 1
                        say(f"  🛑 {iv.text}")
                        return "blocked_needs_human", iv.text
                    b = await self._apply_intervention(iv, b, st)
                    directive.text = (directive.text + "\n" if directive.text else "") + iv.text
            if directive.force_channel and b.channel != directive.force_channel:
                self.counters["forced_channel"] += 1
                b = await self.observe(st, forced=directive.force_channel)
            if directive.escalate_human:
                self.counters["human_escalations"] += 1
                say(f"  🛑 {directive.reason}")
                return "blocked_needs_human", directive.reason
            _, b.els = render_elements(b.obs)
            if b.obs.elements and b.obs.channel in ("cdp", "uia", "dxgi_vision"):
                self.registry.observe_rows(b.obs.elements, step, b.obs.channel)
                if st.quantity and not self.registry.targets_locked and re.search(r"删除|delete|归档|archive|移除|勾选|选中|select|标记", st.task, re.I):
                    tg = self.registry.lock_targets(b.obs.elements, st.quantity, "gone", step)
                    if tg:
                        say(f"  🔖 StableObject 已锁定 {len(tg)} 个目标（按内容身份而非行号）：" + "；".join(f"{o.label[:18]}" for o in tg[:5]))
                if destructive_step == step - 1:
                    mm = self.registry.mismatches()
                    if mm:
                        directive.text += f"\n· [StableObject 比对] 删除后以下目标 current≠expected：" + "；".join(f"{o.label[:20]} {o.current_state}→{o.expected_state}" for o in mm[:4])
            ch_label = {"cdp": f"CDP(nodes={len(b.obs.elements)}, inflight={b.obs.inflight})", "uia": f"UIA({len(b.obs.elements)} 个控件)", "dxgi_vision": f"Vision({self.cfg.vision_model})·DXGI"}[b.channel]
            if b.channel == "dxgi_vision" and b.latched:
                ch_label += "·强制视觉轮(latch)" + (f"·crop+{b.shot_info.get('zoom', 1):.0f}x" if b.shot_info.get("zoom", 1) > 1.01 else "") + ("·SoM" if b.shot_info.get("som_boxes") else "")
            gate_lbl = " · FG-Gate:跳过UIA" if b.gate else ""
            say(f"  [Perception: {ch_label}] 驱动={self.hub.driver_kind} 感知 {b.ms:.0f}ms{gate_lbl}" + (f" · {b.note}" if b.note else ""))
            self._dump_obs(step, b)
            if directive.text:
                for ln in directive.text.splitlines():
                    say("  " + ln)
            if plan is None and step == 1:
                plan = await self.plan(st, b) or {}
            delta = self._delta(st, b)
            data, reply = await self.decide(st, b, directive, last_result, delta, plan)
            say(f"  耗时: 决策 {reply.ms:.0f}ms（{reply.model}） · Token 入 {reply.prompt_tokens}（缓存命中 {reply.hit_pct}%）出 {reply.completion_tokens}（≈{reply.tok_per_s:.1f} tok/s）")
            say(f"  思考: {str(data.get('thought', ''))[:160]}")
            if data.get("expect"):
                say(f"  预期: {str(data['expect'])[:140]}")
            actions = data.get("actions") if isinstance(data.get("actions"), list) else [data]
            results: list[str] = []
            for k, a in enumerate(actions, 1):
                name = a.get("action", "")
                brief = " ".join(f"{kk}={str(v)[:40]}" for kk, v in a.items() if kk not in ("thought", "step", "expect", "action", "actions"))
                say(f"  动作{'' if len(actions) == 1 else f' {k}/{len(actions)}'}: action={name} {brief}")
                if name == "done":
                    ledger_bad = st.ledger and st.ledger[-1].effect in ("none", "error") and st.ledger[-1].action.get("action") not in ("wait", "inspect", "vision_inspect")
                    if ledger_bad and not getattr(st, "_done_rejected", False):
                        st._done_rejected = True  # type: ignore[attr-defined]
                        msg = "[DONE_REJECTED] 上一步动作的效果是 none/error，请先在最新观察里核对完成证据再 done。"
                        say("  结果: " + msg)
                        results.append(msg)
                        break
                    verdict = await self.verifier.verify_done(st.task, str(a.get("summary", "")), st, b.obs, getattr(st, "quantity0", None))
                    say(f"  🔎 独立验证器：{'放行 ✓' if verdict.ok else '拒绝 ✗'} · 覆盖={verdict.coverage} · {verdict.render()[:300]}")
                    if not verdict.ok:
                        self.counters["verifier_rejects"] += 1
                        if self.verifier.rejections >= 3:
                            self.tx.abort()
                            say(f"✖ 失败（独立验证器 3 次拒绝）：{verdict.diagnosis}")
                            return "failed", verdict.diagnosis
                        msg = f"[VERIFIER_REJECTED] {verdict.diagnosis}（第 {self.verifier.rejections}/3 次；请按诊断继续执行，不要重复宣布 done）"
                        say("  结果: " + msg[:300])
                        results.append(msg)
                        break
                    self.counters["verifier_pass"] += 1
                    self.tx.commit()
                    say(f"✔ 完成: {a.get('summary', '')}" + (f"  〔{verdict.diagnosis[:60]}〕" if verdict.diagnosis else ""))
                    return "done", str(a.get("summary", ""))
                if name == "fail":
                    say(f"✖ 失败: {a.get('reason', '')}")
                    return "failed", str(a.get("reason", ""))
                if name == "replan":
                    plan = await self.plan(st, b) or plan
                    results.append("已重新规划")
                    continue
                if self.registry.targets_locked:  # quota reflects the *remaining* stable targets (list shifts after each delete)
                    st.quantity = max(1, len(self.registry.remaining_targets(b.obs.elements))) if st.quantity else st.quantity
                gate = ActionGate.check(a, b.obs, st, b.els)
                sel_el = b.els.get(a.get("id")) if a.get("id") is not None else None
                if not gate and sel_el is not None and self.registry.targets_locked and name in ("click", "double_click", "right_click") and sel_el.zone == "Row":
                    pf = self.registry.preflight_row_click(sel_el, b.obs.elements)
                    if not pf.ok:
                        gate = (Code.SECURITY_DENIED, f"[STABLE_ID] {pf.reason}")
                if not gate:
                    msg = self.tx.intend(step, action_sig(a, b.els), a, sel_el.name if sel_el is not None else str(a.get("name", "")))
                    if msg:
                        gate = (Code.SECURITY_DENIED, msg)
                if gate:
                    res = ActionResult(ok=False, code=gate[0], message=gate[1])
                    self.counters["gate_denied"] += 1
                else:
                    _t_act = time.perf_counter()
                    pre = self.recovery.pre_check(a, step)
                    if pre is not None:
                        res = pre
                        self.counters["gate_denied"] += 1
                    else:
                        res = await self.execute(a, b, st)
                        res = await self.recovery.handle(self, a, res, b, st)
                    if name == "toolbar_action" and re.search(r"删除|delete|归档|archive|移除", str(a.get("name", "")), re.I):
                        destructive_step = step
                self._dump_action(step, a, res, (time.perf_counter() - locals().get("_t_act", time.perf_counter())) * 1000)
                ent = st.record(step, a, str(data.get("expect", "")), b.obs, res, b.els)
                if "x" in a and "y" in a:
                    ent.evidence["click_xy"] = (int(a["x"]), int(a["y"]))
                elif sel_el is not None:
                    ent.evidence["click_xy"] = sel_el.center
                mark = "结果" if res.ok else "执行出错"
                say(f"  {mark}: [{res.code.value}] {res.message[:360]}")
                if self.recovery.terminate:
                    tm = self.recovery.terminate
                    msg = f"安全终止：{tm['key']} 被安全策略连续拒绝 2 次。可行替代：{tm['alternative']}"
                    say(f"  🛑 {msg}")
                    self.tx.abort()
                    return "blocked_security", msg
                results.append(f"{name}→[{res.code.value}] {res.message[:200]}")
                if not res.ok:
                    break
            last_result = " | ".join(results)
            await asyncio.sleep(0.15)
        return "maxsteps", f"已达到最大步数 {st.max_steps}，任务未确认完成"

    async def _layer0_file(self, ft: layer0.FileTask, st: TaskState) -> tuple[str, str]:
        say = self.say
        say("── 第 1 步 ──")
        say(f"  [Layer 0: Native Safe File] 纯文件任务：确定性写盘 + 字节级回读校验，免 LLM / 免 GUI 点击；授权目录（来自任务原文）：{ft.folder_name} → {ft.folder}")
        say(f"  动作: action=save_text folder={ft.folder_name} name={Path(ft.filename).stem} chars={len(ft.content)}")
        ok, msg, p = layer0.write_verified(ft)
        say(f"  结果: {'✅' if ok else '❌'} {msg}")
        if not ok:
            return "failed", msg
        say("── 第 2 步 ──")
        say(f"  动作: action=open_file app=notepad path={p}")
        title_note = "（未取得窗口标题）"
        try:
            await self.hub.drv_action({"action": "launch", "action_id": new_action_id(), "target": "notepad.exe", "args": f'"{p}"'})
            w = await self._wait_window(lambda w: w.process.lower() == "notepad.exe" and Path(ft.filename).stem.lower() in w.title.lower(), 5.0)
            if w:
