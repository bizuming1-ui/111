        if e.code != "OK":
            e.effect = "error"
        elif a in ("focus_window", "restore_window"):
            want = (e.action.get("title") or "").lower()
            fg = obs.fg_window()
            hit = bool(fg and (want in fg.title.lower() or want in fg.process.lower()))
            e.effect = "confirmed" if hit else "none"
            e.evidence["fg"] = f"{fg.process}:{fg.title}" if fg else "?"
        elif a in ("wait", "inspect", "ocr", "vision_inspect", "file_stat", "dir_list"):
            e.effect = "unknown"
        elif a in ("done", "fail"):
            e.effect = "unknown"
        else:
            e.effect = "confirmed" if changed else "none"
        e.evidence["changed"] = changed
        self.stalled_steps = self.stalled_steps + 1 if (e.effect == "none" and e.action.get("action") not in ("wait",)) else 0
        self.blocked_streak = self.blocked_streak + 1 if (e.effect in ("none", "error")) else 0
        return e

    def record(self, step: int, action: dict[str, Any], expect: str, pre: Observation, res: ActionResult, els: dict[int, Element]) -> Entry:
        sig = action_sig(action, els)
        ent = Entry(step=step, sig=sig, action=action, expect=expect, pre_fp=obs_fingerprint(pre), code=res.code.value, message=res.message[:300])
        fg = pre.fg_window()
        ent.target_proc = fg.process if fg else ""
        if res.code != Code.OK:
            ent.effect = "error"
        self.ledger.append(ent)
        self.sig_window.append(sig)
        if res.code == Code.OK and action.get("action") in ("launch", "app_resolve"):
            self.launched.add(str(action.get("target") or action.get("name") or "").lower())
        return ent

    def update_crashes(self, obs: Observation) -> list[str]:
        seen: list[str] = []
        for w in obs.windows:
            if w.process.lower() in CRASH_PROCS or CRASH_TITLES.search(w.title or ""):
                key = w.process.lower() + "|" + w.title
                seen.append(key)
        for k in set(seen):
            if k not in getattr(self, "_crash_seen", set()):
                self.crashes[k.split("|")[0]] += 1
                if self.target_hint:
                    self.crashes[self.target_hint + ".exe"] += 1
        self._crash_seen = set(seen)
        return seen

    # ---- loop detection --------------------------------------------------------
    def detect_loop(self) -> Optional[tuple[str, str]]:
        w = list(self.sig_window)
        if len(w) >= 3:
            last = w[-1]
            recent = w[-6:]
            same = recent.count(last)
            noeff = [e for e in self.ledger[-6:] if e.sig == last and e.effect in ("none", "error")]
            if same >= 3 and len(noeff) >= 2:
                return ("repeat", last)
        if len(w) >= 6 and len(set(w[-6:])) <= 2 and len({e.effect for e in self.ledger[-6:]} - {"confirmed"}) >= 1:
            noeff = sum(1 for e in self.ledger[-6:] if e.effect in ("none", "error"))
            if noeff >= 4:
                return ("pingpong", "|".join(sorted(set(w[-6:]))))
        return None

    def mask_active(self, name: str) -> bool:
        return self.masks.get(name, 0) > 0

    def tick_masks(self) -> None:
        for k in list(self.masks):
            self.masks[k] -= 1
            if self.masks[k] <= 0:
                del self.masks[k]


def extract_quantity(task: str) -> Optional[int]:
    m = re.search(r"(?:前面|前边|前|first|top)\s*(\d{1,3})\s*(?:条|封|个|行|项|份|items?|emails?|rows?)?", task, re.I)
    if m:
        return int(m.group(1))
    cn = {"一": 1, "二": 2, "两": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9, "十": 10}
    m = re.search(r"前(?:面|边)?\s*([一二两三四五六七八九十])\s*(?:条|封|个|行|项)", task)
    return cn.get(m.group(1)) if m else None


def guess_target(task: str) -> str:
    for k, v in {"微信": "weixin", "wechat": "weixin", "记事本": "notepad", "notepad": "notepad", "计算器": "calc",
                 "excel": "excel", "word": "winword", "chrome": "chrome", "浏览器": "browser", "gmail": "browser", "edge": "msedge"}.items():
        if k in task.lower():
            return v
    return ""


