      expression: "({url:location.href,title:document.title,rs:document.readyState,iw:innerWidth,ih:innerHeight,sx:screenX,sy:screenY,ow:outerWidth,oh:outerHeight,dpr:devicePixelRatio,scrollY:scrollY})",
      returnByValue: true,
