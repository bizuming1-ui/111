}
function Send-Raw($Conn, [string]$Line, [int]$TimeoutMs = 5000) {
    $Conn.Wr.WriteLine($Line); $Conn.Wr.Flush()
    $t = $Conn.Rd.ReadLineAsync()
    if (-not $t.Wait($TimeoutMs)) { throw 'rpc timeout' }
    return ($t.GetAwaiter().GetResult() | ConvertFrom-Json -Depth 30)
