            STATE["roots_cap"] = "roots" in caps
            send({"jsonrpc": "2.0", "id": rid, "result": {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}}, "serverInfo": {"name": "fake_chrome_devtools", "version": "0.0-test"}}})
