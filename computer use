    if p["drv_up"]:
        ex[2] = DriverExecutor(p["drv"]); ex[3] = ex[2]
        ex[4] = ex[2]
    key = os.environ.get("DEEPSEEK_API_KEY", "")
    policy = deepseek_policy(DeepSeekClient(key)) if key else None
    router = Router(cdp_up=p["cdp_up"], uia_up=p["drv_up"], dxgi_up=p["drv_up"])
