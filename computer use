# ====================================================================================================================== the model
class WorldModel:
    def __init__(self, provider: Optional[LocationProvider] = None, scope: Optional[AuthorizedScope] = None, clock: Callable[[], float] = time.time,
                 ttl: Optional[dict[str, float]] = None) -> None:
        self.provider = provider
        self.scope = scope or AuthorizedScope({})
        self.clock = clock
        self.ttl = dict(DEFAULT_TTL_S, **(ttl or {}))
        self._lock = threading.RLock()
        self._epochs: dict[str, int] = {c: 0 for c in CHANNELS}
        self._snaps: dict[str, ObservationSnapshot] = {}
        self._objects: dict[str, tuple[int, list[WorldObjectRef]]] = {}   # location → (epoch, ordered refs)
        self._loc_epoch: dict[str, int] = {}
        self.world_version = 0       # bumps on every committed mutation (note_mutation) — a cheap "anything changed?" counter
        self.stats = {"submits": 0, "refreshes": 0, "rebases": 0, "stale_refs": 0, "searches": 0}

    # ---------------------------------------------------------------- write side (perception + Layer-0 tools only)
    def submit(self, channel: str, payload: Any = None, *, epoch: Optional[int] = None, hwnd: int = 0, note: str = "", ts: Optional[float] = None) -> ObservationSnapshot:
        with self._lock:
            if channel not in self._epochs:
                self._epochs[channel] = 0
            if epoch is None:
                epoch = self._epochs[channel] + 1
            if epoch < self._epochs[channel]:   # out-of-order / replayed snapshot: never move truth backwards
                return self._snaps.get(channel) or ObservationSnapshot(channel, self._epochs[channel], self.clock(), None)
            self._epochs[channel] = int(epoch)
            snap = ObservationSnapshot(channel, int(epoch), self.clock() if ts is None else ts, payload, int(hwnd or 0), note)
            self._snaps[channel] = snap
            self.stats["submits"] += 1
            return snap

    def submit_observation(self, obs: Any) -> Optional[ObservationSnapshot]:
        """Accept the existing protocol.Observation (duck-typed: channel / snapshot_epoch / hwnd / elements / windows / title)."""
        if obs is None:
            return None
        ch = {"dxgi_vision": "dxgi_dml", "jab": "uia"}.get(str(getattr(obs, "channel", "") or ""), str(getattr(obs, "channel", "") or "uia"))
        snap = self.submit(ch, {"title": getattr(obs, "title", ""), "url": getattr(obs, "url", ""), "n_elements": len(getattr(obs, "elements", []) or [])},
                           epoch=int(getattr(obs, "snapshot_epoch", 0) or 0) or None, hwnd=int(getattr(obs, "hwnd", 0) or 0))
        wins = getattr(obs, "windows", None)
        if wins:
            self.submit("window_manager", [{"hwnd": getattr(w, "hwnd", 0), "title": getattr(w, "title", ""), "pid": getattr(w, "pid", 0), "z": getattr(w, "z", 0)} for w in wins])
        return snap

    def note_mutation(self) -> int:
        with self._lock:
            self.world_version += 1
            return self.world_version

    def refresh(self, location: str) -> list[WorldObjectRef]:
        """Read the container from its provider, stamp every object with a fresh epoch, publish the snapshot."""
        if self.provider is None or not self.scope.allows_location(location):
            return []
        objs = self.provider.list(location)
        with self._lock:
            ch = _LOC_CHANNEL.get(location, "filesystem")
            snap = self.submit(ch, [o.identity for o in objs], note=location)
            now = self.clock()
            stamped = [WorldObjectRef(**{**o.__dict__, "epoch": snap.epoch, "observed_at": now, "ordinal": i}) for i, o in enumerate(objs)]
            self._objects[location] = (snap.epoch, stamped)
            self._loc_epoch[location] = snap.epoch
            self.stats["refreshes"] += 1
            return list(stamped)

    # ---------------------------------------------------------------- read side
    def view(self) -> "WorldView":
        return WorldView(self)

    def epoch(self, channel: str) -> int:
        return self._epochs.get(channel, 0)

    def location_epoch(self, location: str) -> int:
        return self._loc_epoch.get(location, 0)

    def latest(self, channel: str) -> Optional[ObservationSnapshot]:
        return self._snaps.get(channel)

    def age(self, channel: str) -> float:
        s = self._snaps.get(channel)
        return float("inf") if s is None else max(0.0, self.clock() - s.ts)

    def is_fresh(self, channel: str, max_age: Optional[float] = None) -> bool:
        return self.age(channel) <= (self.ttl.get(channel, 2.0) if max_age is None else max_age)

    def objects(self, location: str, *, fresh: bool = True) -> list[WorldObjectRef]:
        """Ordered listing of one container.  `fresh=True` re-reads when the cached snapshot is older than its TTL (or missing)."""
        ent = self._objects.get(location)
        if ent is None or (fresh and not self.is_fresh(_LOC_CHANNEL.get(location, "filesystem"))):
            return self.refresh(location)
        return list(ent[1])

    def identity_set(self, location: str, *, force: bool = True) -> set[str]:
        return {o.identity for o in (self.refresh(location) if force else self.objects(location))}

    def resolve_current(self, ref: WorldObjectRef, *, force: bool = True) -> Optional[WorldObjectRef]:
        """Re-base a frozen ref onto the CURRENT listing by identity (epoch-bump self-heal).  None ⇒ the object is gone (or changed identity)."""
        cur = self.refresh(ref.location) if force else self.objects(ref.location)
        for o in cur:
            if o.identity == ref.identity:
                if o.epoch != ref.epoch:
                    self.stats["rebases"] += 1
                return o
        self.stats["stale_refs"] += 1
        return None

    def check_ref(self, ref: WorldObjectRef) -> tuple[bool, str, str]:
        """Precondition for an action on `ref` → (ok, code, detail).  Distinguishes 'gone' (NOT_FOUND) from 'same name, different object' (OBJECT_IDENTITY_MISMATCH)
        and from 'object content changed since it was frozen' (STALE_EPOCH)."""
        cur = self.resolve_current(ref)
        if cur is None:
            twin = [o for o in self.objects(ref.location, fresh=False) if o.name == ref.name]
            if twin:
                return False, "OBJECT_IDENTITY_MISMATCH", f"同名对象「{ref.name}」仍在，但已不是被冻结的那一个（身份 {ref.identity} 已不存在）"
            return False, "NOT_FOUND", f"{ref.brief()} 已不在 {ref.location}"
        if ref.fingerprint and cur.fingerprint and ref.fingerprint != cur.fingerprint:
            return False, "STALE_EPOCH", f"对象内容在冻结后发生变化（{ref.fingerprint} → {cur.fingerprint}）"
        return True, "OK", "身份与状态一致"

    # ---------------------------------------------------------------- cross-location search
    def search(self, query: str, scope: Optional[Sequence[str]] = None, *, min_score: float = 0.99) -> SearchReport:
        """Locate a named target across the AUTHORIZED scope.  Live locations always win over the Recycle Bin (a live copy is the thing the user means)."""
        from .skills import recycle_bin as rb

        self.stats["searches"] += 1
        q = rb.clean_reference(query)
        rep = SearchReport("none", query=q)
        if not q or q in rb.GENERIC:
            return rep
        locs = [l for l in (scope or ALL_LOCATIONS) if self.scope.allows_location(l)]
        near: list[SearchHit] = []
        live: list[SearchHit] = []
        binh: list[SearchHit] = []
        for loc in locs:
            rep.queried.append(loc)
            try:
                objs = self.refresh(loc)
            except Exception as e:  # noqa: BLE001  one broken oracle must not blind the others
                rep.errors[loc] = f"{e.__class__.__name__}: {str(e)[:80]}"
                continue
            n = 0
            for o in objs:
                if o.is_dir:
                    continue
                s = rb._score(q, o.name)
                if s >= min_score:
                    (binh if loc == "recyclebin" else live).append(SearchHit(o, s))
                    n += 1
                elif s >= 0.86:
                    near.append(SearchHit(o, s))
            rep.by_location[loc] = n
        if live:
            top = max(h.score for h in live)
            tied = [h for h in live if abs(h.score - top) < 0.02]
            rep.hits = tied
            rep.status = "live_unique" if len(tied) == 1 else "live_ambiguous"
        elif binh:
            top = max(h.score for h in binh)
            tied = [h for h in binh if abs(h.score - top) < 0.02]
            rep.hits = tied
            rep.status = "bin_only" if len(tied) == 1 else "bin_ambiguous"
        elif near:
            rep.hits = sorted(near, key=lambda h: -h.score)[:5]
            rep.status = "suggest"
        return rep

    # ---------------------------------------------------------------- consistency
    def consistency(self, channels: Iterable[str] = ("uia", "cdp", "window_manager", "filesystem", "shell_com")) -> ConsistencyReport:
        used = [c for c in channels if c in self._snaps]
        stale = [c for c in used if not self.is_fresh(c)]
        ts = [self._snaps[c].ts for c in used]
        skew = (max(ts) - min(ts)) if len(ts) > 1 else 0.0
        conflicts: list[str] = []
        loc_ids = {l: {o.identity for o in objs} for l, (_, objs) in self._objects.items()}
        for a in LIVE_LOCATIONS:
            for b in ("recyclebin",):
                both = {i.split(":", 1)[1] for i in loc_ids.get(a, set())} & {i.split(":", 1)[1] for i in loc_ids.get(b, set())}
                if both:
                    conflicts.append(f"{a} 与 {b} 同时包含 {sorted(both)[:2]}")
        return ConsistencyReport(not stale and not conflicts, {c: self._epochs.get(c, 0) for c in used}, stale, skew, conflicts)


