"""Long-horizon task state: plan, quota ledger, action ledger, blocked targets, checkpoint. The LLM never has to remember
how many mails were deleted or which action already took effect - the ledger is the memory and the interlock."""
from __future__ import annotations

import json
import re
import time
from dataclasses import asdict, dataclass, field
from pathlib import Path
from typing import Any

DELETE_WORDS = re.compile(r"删除|删掉|清除|清空|移到垃圾|移至垃圾|归档|delete|archive|trash|remove", re.I)
CN_NUM = {"一": 1, "二": 2, "两": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9, "十": 10}


def _num(s: str) -> int:
    return int(s) if s.isdigit() else CN_NUM.get(s, 0)


@dataclass
class QuotaBatch:
    where: str  # front | back
    n: int
    done: bool = False

    def rows_spec(self) -> str:
        return f"1-{self.n}" if self.where == "front" else f"last:{self.n}"


@dataclass
class Quota:
    batches: list[QuotaBatch] = field(default_factory=list)
    deleted: int = 0

    @property
    def total(self) -> int:
        return sum(b.n for b in self.batches)

    @property
    def remaining(self) -> int:
        return sum(b.n for b in self.batches if not b.done)

    def next_batch(self) -> QuotaBatch | None:
        return next((b for b in self.batches if not b.done), None)

    def fmt(self) -> str:
        return "[" + "+".join(f"{b.n}{'✓' if b.done else ''}" for b in self.batches) + f"]（总目标 {self.total}，已确认删除 {self.deleted}，剩余 {self.remaining}）"

    @staticmethod
    def from_task(task: str) -> "Quota | None":
        if not DELETE_WORDS.search(task):
            return None
        n = r"(\d+|[一二两三四五六七八九十])"
        found: list[tuple[int, QuotaBatch]] = []
        for m in re.finditer(r"(?:前面?|最前面?|开头)\s*" + n + r"\s*(?:个|封|条|行)?", task):
            found.append((m.start(), QuotaBatch("front", _num(m.group(1)))))
        for m in re.finditer(r"(?:后面?|最后面?|末尾|最后)\s*" + n + r"\s*(?:个|封|条|行)?", task):
            found.append((m.start(), QuotaBatch("back", _num(m.group(1)))))
        found = [(p, b) for p, b in sorted(found, key=lambda t: t[0]) if b.n > 0]
        return Quota([b for _, b in found]) if found else None


@dataclass
class Record:
    step: int
    sig: str
    op: str
    ok: bool
    effect: str  # effective | no_effect | unverified | failed
    code: str | None = None


@dataclass
class Ledger:
    records: list[Record] = field(default_factory=list)
    err_count: dict[str, int] = field(default_factory=dict)

    def add(self, r: Record) -> None:
        self.records.append(r)
        if r.code:
            k = f"{r.sig}|{r.code}"
            self.err_count[k] = self.err_count.get(k, 0) + 1

    def repeated_effect(self, sig: str, toggle_like: bool) -> Record | None:
        if not toggle_like:
            return None
        return next((r for r in self.records if r.sig == sig and r.effect == "effective"), None)

    def same_error_streak(self, sig: str, code: str) -> int:
        return self.err_count.get(f"{sig}|{code}", 0)

    def blocked_streak(self) -> int:
        n = 0
        for r in reversed(self.records):
            if r.effect in ("failed", "no_effect"):
                n += 1
            else:
                break
        return n

    def lines(self, limit: int = 12) -> str:
        out = [f"  #{r.step} {r.op} → {r.effect}{('/' + r.code) if r.code else ''}" for r in self.records[-limit:]]
        return "\n".join(out) or "  （无）"


@dataclass
class TaskState:
    task: str
    task_no: int
    workspace: Path
    plan: str = ""
    step: int = 0
    history: list[str] = field(default_factory=list)
    ledger: Ledger = field(default_factory=Ledger)
    quota: Quota | None = None
    last_selected: list[int] = field(default_factory=list)
    pending_batch: QuotaBatch | None = None
    blocked_targets: dict[str, str] = field(default_factory=dict)  # "kind:target" -> reason (human said no / policy said no)
    stalled_obs: int = 0
    started: float = field(default_factory=time.perf_counter)
    layer_trace: list[dict[str, Any]] = field(default_factory=list)
    user_answers: list[str] = field(default_factory=list)

    def checkpoint(self) -> None:
        try:
            self.workspace.mkdir(parents=True, exist_ok=True)
            d = {"task": self.task, "step": self.step, "plan": self.plan, "history": self.history[-40:], "quota": asdict(self.quota) if self.quota else None,
                 "blocked": self.blocked_targets, "ledger": [asdict(r) for r in self.ledger.records[-60:]], "ts": time.time()}
            (self.workspace / "checkpoint.json").write_text(json.dumps(d, ensure_ascii=False, indent=1), encoding="utf-8")
        except OSError:
            pass


def history_window(history: list[str], limit: int = 14, chunk: int = 4) -> str:
    """KV-cache friendly sliding window: the window start only moves in blocks of `chunk`, so the prompt prefix is stable
    for `chunk` consecutive steps instead of being rewritten every step."""
    n = len(history)
    if n == 0:
        return "（还没有操作）"
    start = 0
    if n > limit:
        start = -(-(n - limit) // chunk) * chunk
    start = min(start, n - 1)
    return "\n".join(history[start:])
