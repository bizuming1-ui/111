function Resolve-KeyChord([string]$Sequence) {
    # '#' → 'shift+3'，'ctrl+#' → 'ctrl+shift+3'，'Ctrl + Shift + S' → 'ctrl+shift+s'；未知键抛「不支持的按键」（与 Resolve-VK 同文案）
    $order = @{ ctrl = 0; alt = 1; shift = 2; win = 3 }
    $out = [System.Collections.Generic.List[string]]::new()
    $seq = ("$Sequence" -replace '\s*\+\s*(?=\S)', '+').Trim()
    foreach ($chord in @($seq -split '\s+' | Where-Object { $_ })) {
        $mods = [System.Collections.Generic.List[string]]::new(); $keys = [System.Collections.Generic.List[string]]::new()
        foreach ($raw in @(Split-V10Chord $chord)) {
            $tok = [string]$raw
            if ($tok.Length -gt 1) { $l = $tok.ToLower(); if ($script:V10KeyAlias.ContainsKey($l)) { $tok = [string]$script:V10KeyAlias[$l] } else { $tok = $l } }
            if ($tok.Length -eq 1 -and $script:V10ShiftSym.ContainsKey($tok)) { if (-not $mods.Contains('shift')) { $mods.Add('shift') }; $keys.Add([string]$script:V10ShiftSym[$tok]) }
            elseif ($tok -in 'ctrl', 'alt', 'shift', 'win') { if (-not $mods.Contains($tok)) { $mods.Add($tok) } }
            elseif ($tok.Length -eq 1 -and $tok -match '^[A-Za-z0-9\-=\[\];'',./\\`]$') { $keys.Add($tok.ToLower()) }
            elseif ($tok -match '^(enter|tab|esc|space|backspace|delete|insert|up|down|left|right|home|end|pageup|pagedown|apps|printscreen|capslock|f([1-9]|1[0-9]|2[0-4])|numpad[0-9])$') { $keys.Add($tok) }
            else { throw "不支持的按键: '$raw'" }
        }
        if ($mods.Count -eq 0 -and $keys.Count -eq 0) { continue }
        $sorted = @($mods | Sort-Object { $order[$_] })
        $out.Add((@($sorted) + @($keys)) -join '+')
    }
    if ($out.Count -eq 0) { throw 'keys 不能为空' }
    return ($out -join ' ')
}
