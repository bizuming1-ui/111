            return self._deny("COORD_NOT_ON_OBJECT", f"点击落点 {tuple(req.point)} 不在对象 {o.object_id} 自己的 bbox {tuple(o.visual_bbox)} 内（坐标漂移）")
        # ---- Action Trigger: released by (frozen+selected target) AND (semantic verification), independent of whatever row shares the pixel
        if o.action_role == "trigger":
            if not destructive:
                return GateVerdict(True, "RELEASED_NAV", "非破坏性触发器", ())
            if self.intent is None or not self.intent.target_ids:
                return self._deny("TARGETS_NOT_FROZEN", "尚未冻结任何 Action Target；先冻结并选中目标，再点击触发器")
            sel = self.selected_targets()
            if not sel:
                return self._deny("NO_SELECTED_TARGET", "冻结目标当前没有处于 selected=True 的对象；先勾选目标再点触发器")
            frozen = set(self.intent.target_ids)
            stray = [x for x in self.reg.objects.values() if x.action_role == "target" and x.selected and x.object_id not in frozen]
            if stray:
                return self._deny("SELECTED_OUTSIDE_FROZEN", f"有 {len(stray)} 个未授权对象也处于选中状态（如 {stray[0].accessible_name[:20]!r}），点击触发器会波及它们")
