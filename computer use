// Resident CDP daemon.  Protocol: newline-delimited JSON on tcp://127.0.0.1:9333
//   {"cmd":"ping"} | {"cmd":"zones"} | {"cmd":"toolbar_click","label":"delete|archive"} | {"cmd":"settled"}
import net from 'node:net'
import { spawn } from 'node:child_process'
import { ZONE_COLLECTOR_JS, tagAll, pickBulkButton, DESTRUCTIVE, type BtnNode, type RowNode } from './zone.ts'
import { waitSettled, type PageProbe } from './settled.ts'
import { EpochLock, ActionLedger } from './epoch.ts'
import { result, type ActionResult } from './protocol.ts'

export interface Page { evaluate<T = unknown>(expr: string): Promise<T>; send(method: string, params?: object): Promise<any> }

export class CdpPage implements Page {
  private id = 0
  private pending = new Map<number, (v: any) => void>()
  private ws: WebSocket
  private constructor(ws: WebSocket) {
    this.ws = ws
    ws.addEventListener('message', ev => { const m = JSON.parse(String(ev.data)); const f = this.pending.get(m.id); if (f) { this.pending.delete(m.id); f(m) } })
  }
  static async attach(port = 9222): Promise<CdpPage> {
    const list = await (await fetch(`http://127.0.0.1:${port}/json`)).json() as Array<{ type: string; webSocketDebuggerUrl: string }>
    const t = list.find(x => x.type === 'page'); if (!t) throw new Error('no page target')
    const ws = new WebSocket(t.webSocketDebuggerUrl)
    await new Promise<void>((ok, bad) => { ws.addEventListener('open', () => ok()); ws.addEventListener('error', () => bad(new Error('ws error'))) })
    return new CdpPage(ws)
  }
  send(method: string, params: object = {}) {
    const id = ++this.id
    return new Promise<any>((res, rej) => { this.pending.set(id, m => (m.error ? rej(new Error(m.error.message)) : res(m.result))); this.ws.send(JSON.stringify({ id, method, params })) })
  }
  async evaluate<T>(expr: string) { const r = await this.send('Runtime.evaluate', { expression: expr, returnByValue: true }); return r.result.value as T }
}

/** Isolated-profile takeover: never touches the user's daily Chrome profile. */
export function launchIsolated(chromePath: string, profileDir: string, port = 9222) {
  return spawn(chromePath, [`--remote-debugging-port=${port}`, `--user-data-dir=${profileDir}`, '--remote-allow-origins=*', '--no-first-run', 'about:blank'], { detached: true, stdio: 'ignore' })
}

export async function readZones(page: Page) {
  const raw = JSON.parse(await page.evaluate<string>(ZONE_COLLECTOR_JS)) as { rows: RowNode[]; btns: BtnNode[]; vh: number; vw: number }
  return { tagged: tagAll(raw.btns, raw.rows, raw.vh, raw.vw), rows: raw.rows.length }
}

/** Per-daemon anti-race state: snapshot_epoch lock + idempotent action ledger (protocol.v1). */
export const ctx = { lock: new EpochLock(), ledger: new ActionLedger() }

async function act(page: Page, msg: any): Promise<ActionResult> {
  const id = Number(msg.action_id ?? 0)
  const replay = ctx.ledger.seen(id); if (replay) return replay
  const stale = ctx.lock.check(null, msg.expect_epoch === undefined ? undefined : Number(msg.expect_epoch))
  if (stale) return result(id, false, stale, 'snapshot_epoch moved; re-observe', ctx.lock.current)
  const a = msg.args ?? {}
  let out: ActionResult
  switch (msg.action) {
    case 'cdp_navigate': case 'navigate':
      await page.send('Page.navigate', { url: String(a.url) }); ctx.lock.bump('navigate'); out = result(id, true, 'OK', 'navigated', ctx.lock.current); break
    case 'click': case 'double_click': {
      for (const type of ['mouseMoved', 'mousePressed', 'mouseReleased']) await page.send('Input.dispatchMouseEvent', { type, x: Number(a.x), y: Number(a.y), button: 'left', clickCount: msg.action === 'double_click' ? 2 : 1 })
      out = result(id, true, 'OK', 'clicked', ctx.lock.current); break
    }
    case 'toolbar_action': {
      const r: any = await handle(page, { cmd: 'toolbar_click', label: a.label })
      if (r.ok) ctx.lock.bump('toolbar_action')   // rows will disappear / re-render: every node id minted so far is now stale
      out = result(id, !!r.ok, r.ok ? 'OK' : 'AMBIGUOUS_TARGET', r.ok ? `clicked ${r.clicked}` : String(r.error), ctx.lock.current, r.ok ? r : undefined); break
    }
    case 'click_node': {      // target "cdp:<backendNodeId>"; resolveNode failure -> STALE_EPOCH, never a raw CDP error
      const nid = Number(String(msg.target).split(':')[1])
      out = await ctx.lock.guard(id, nid, msg.expect_epoch === undefined ? undefined : Number(msg.expect_epoch), async () => {
        const o = await page.send('DOM.resolveNode', { backendNodeId: nid })
        await page.send('Runtime.callFunctionOn', { objectId: o.object.objectId, functionDeclaration: 'function(){this.click()}' })
      }); break
    }
    default: out = result(id, false, 'UNSUPPORTED', `unsupported action ${msg.action}`, ctx.lock.current)
  }
  ctx.ledger.commit(out); return out
}

export async function handle(page: Page, msg: any) {
  switch (msg.cmd) {
    case 'epoch': return { ok: true, epoch: ctx.lock.current }
    case 'act': return act(page, msg)
    case 'snapshot': {
      const z = await readZones(page)
      const refs = z.tagged.map(b => ({ ref: `cdp:${b.id}`, role: 'button', name: b.name, zone: b.zone.kind, epoch: ctx.lock.current }))
      ctx.lock.bind(z.tagged.map(b => Number(b.id)).filter(n => Number.isFinite(n)))
      return { ok: true, epoch: ctx.lock.current, row_count: z.rows, refs, process: 'chrome' }
    }
    case 'ping': return { ok: true, v: '11.0.0', protocol: 1, epoch: ctx.lock.current, rss_mb: Math.round(process.memoryUsage().rss / 1048576) }
    case 'zones': { const z = await readZones(page); return { ok: true, rows: z.rows, buttons: z.tagged.filter(b => DESTRUCTIVE.test(b.name)).map(b => ({ id: b.id, name: b.name, tag: b.tag, visible: b.visible, covered: !!b.covered })) } }
    case 'toolbar_click': {
      const re = new RegExp(String(msg.label ?? 'delete|删除|刪除'), 'i')
      const z = await readZones(page); const b = pickBulkButton(z.tagged, re)
      if (!b) return { ok: false, error: 'no [Zone: Toolbar] button matches' }
      if (b.zone.kind !== 'Toolbar') return { ok: false, error: `only ${b.tag} candidates; refusing row-scoped action` }
      const x = b.box.l + b.box.w / 2, y = b.box.t + b.box.h / 2
      for (const type of ['mouseMoved', 'mousePressed', 'mouseReleased']) await page.send('Input.dispatchMouseEvent', { type, x, y, button: 'left', clickCount: 1 })
      return { ok: true, clicked: b.name, tag: b.tag, x, y }
    }
    case 'settled': {
      const probe: PageProbe = {
        readyState: () => page.evaluate<string>('document.readyState'),
        inflight: async () => Number(await page.evaluate<number>('(performance.getEntriesByType("resource").filter(e=>e.responseEnd===0).length)')),
        mutationAgeMs: async () => Number(await page.evaluate<number>('(window.__dscuLastMut ? performance.now() - window.__dscuLastMut : 9999)'))
      }
      return { ok: true, ...(await waitSettled(probe)) }
    }
    default: return { ok: false, error: `unknown cmd ${msg.cmd}` }
  }
}

export function serve(page: Page, port = 9333) {
  const srv = net.createServer(sock => {
    let buf = ''
    sock.on('data', async d => {
      buf += d.toString('utf8'); let i
      while ((i = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, i); buf = buf.slice(i + 1)
        let out: unknown; try { out = await handle(page, JSON.parse(line)) } catch (e) { out = { ok: false, error: String(e) } }
        sock.write(JSON.stringify(out) + '\n')
      }
    })
  })
  return new Promise<net.Server>(r => srv.listen(port, '127.0.0.1', () => r(srv)))
}

if (process.argv[1] && process.argv[1].endsWith('daemon.ts')) {
  // DSCU_MOCK=1: fixture page (no browser) — used by tests/verify_v10.py for the resident-memory gate
  const mock: Page = { evaluate: async () => JSON.stringify({ rows: [], btns: [], vh: 1000, vw: 1500 }) as any, send: async () => ({}) }
  const page = process.env.DSCU_MOCK ? mock : await CdpPage.attach(Number(process.env.DSCU_CDP_PORT ?? 9222))
  await serve(page, Number(process.env.DSCU_DAEMON_PORT ?? 9333))
  console.log('dscu cdp-daemon listening on 127.0.0.1:' + (process.env.DSCU_DAEMON_PORT ?? 9333))
}
