        "fallback_reason": { "type": "string", "description": "mandatory when capture_backend != DXGI" },
        "width": { "type": "integer" }, "height": { "type": "integer" },
        "frame_hash": { "type": "string", "description": "64-bit aHash of the frame, hex" },
        "timed_out_reused_frame": { "type": "boolean" }
      }
    },
    "ObserveRequest": {
      "type": "object",
      "required": ["type", "id"],
