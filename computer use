"""ScreenSpot-Pro grounding adapter: metric = click point inside the annotated bbox.  Real data: --data <ScreenSpot-Pro dir with annotations/*.json>
(items: {img_filename, instruction, bbox:[x0,y0,x1,y1], ui_type}).  Predictor plug-in: --predictor module:function(item)->(x,y)."""
from __future__ import annotations

import glob
import importlib
import json
import os

SELFTEST = [
    {"instruction": "Save button", "bbox": [100, 40, 160, 70], "ui_type": "text", "hint": [130, 55]},
    {"instruction": "icon-only gear", "bbox": [900, 10, 930, 40], "ui_type": "icon", "hint": [915, 25]},
    {"instruction": "search box", "bbox": [300, 80, 700, 110], "ui_type": "text", "hint": [500, 95]},
]


def load(data: str | None) -> tuple[str, list[dict]]:
    if not data:
        return "selftest-mini", SELFTEST
    items = []
    for f in glob.glob(os.path.join(data, "annotations", "*.json")):
        d = json.load(open(f, encoding="utf-8"))
        items += d if isinstance(d, list) else [d]
    return os.path.basename(data.rstrip("/\\")), items


def run(data: str | None = None, predictor: str | None = None) -> dict:
    name, items = load(data)
    if predictor:
        mod, fn = predictor.split(":")
        pred = getattr(importlib.import_module(mod), fn)
    else:
        pred = lambda it: tuple(it.get("hint", [(it["bbox"][0] + it["bbox"][2]) / 2, (it["bbox"][1] + it["bbox"][3]) / 2]))  # noqa: E731
    hit = {"text": [0, 0], "icon": [0, 0]}
    for it in items:
        x, y = pred(it); b = it["bbox"]; t = it.get("ui_type", "text")
        hit.setdefault(t, [0, 0]); hit[t][1] += 1; hit[t][0] += int(b[0] <= x <= b[2] and b[1] <= y <= b[3])
    tot = sum(v[1] for v in hit.values()); ok = sum(v[0] for v in hit.values())
    return {"benchmark": "ScreenSpot-Pro", "dataset": name, "n": tot, "accuracy": round(ok / tot, 4) if tot else 0.0, "by_type": {k: v for k, v in hit.items() if v[1]}}
