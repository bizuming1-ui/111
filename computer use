    $eiOk = ((Get-ErrorInfo '光标定位失败（按下前）：目标').Code -eq 'CURSOR_FIX') -and ((Get-ErrorInfo '你正在使用鼠标，已让出控制权（按下前发现光标偏离目标 9px，未点击）。').Code -eq 'USER_ACTIVE')
