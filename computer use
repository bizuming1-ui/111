"""Unified cognitive state machine — the supervisor that sits between the LLM policy and every executor.

It encodes, as deterministic code (not prompt text), the three death-spirals of the v10.0 runtime log:

  #2  WeChat (self-drawn, UIA-blind): same coordinate clicked 11x with zero pixel change -> circuit break.
      => SelfDrawnEscape: after 2 no-effect clicks the coordinate is BANNED and a 3-rung ladder runs:
         rung 1 hotkey probe (focus + Ctrl+F) -> rung 2 2x crop re-grounding (detail="original")
         -> rung 3 forced foreground + focus verification.
  #3  Gmail 6+2: quota hit 8/8 at step ~12, then 52 more steps of select/uncheck on stale nodes.
      => QuotaFinalizer: quota zero AND rows really vanished -> terminal 'done' immediately; every later
         selection/delete attempt is converted into that terminal verdict.
      => EpochGuard: refs minted before a structural change answer STALE_EPOCH (no CDP round-trip, no
         `No node with given id found`).
  #1  Notepad: handled by security.py (intent-scoped grants) + native_files.py (Layer-0 save).
"""
from __future__ import annotations

import math
from dataclasses import dataclass, field
from enum import Enum

from .epoch import EpochGuard
from .protocol import ActionRequest, ActionResult, ErrorCode
from .quota import Quota
from .security import SecurityDenied, SecurityPolicy

SELF_DRAWN_PROCS = {"weixin", "wechat", "wechatappex", "wxwork", "qq", "qqnt", "dingtalk", "feishu", "lark", "telegram",
                    "discord", "slack", "spotify", "steam", "cloudmusic", "neteasecloudmusic"}
PASSIVE_ACTIONS = {"done", "fail", "wait", "inspect", "observe", "file_stat", "dir_list", "locate_file", "verify_text_file",
                   "vision_inspect", "ocr", "replan", "focus_window"}
DESTRUCTIVE = ("delete", "删除", "刪除", "remove", "trash", "archive", "归档", "歸檔", "移至垃圾箱", "移到回收站")


class Phase(str, Enum):
    ACT = "ACT"; ESCAPE = "ESCAPE"; FINALIZE = "FINALIZE"; DONE = "DONE"; FAILED = "FAILED"


def is_self_drawn(process: str, uia_controls: int | None = None) -> bool:
    p = process.lower().removesuffix(".exe")
    return p in SELF_DRAWN_PROCS or (uia_controls is not None and uia_controls < 6)


@dataclass
class EscapePlan:
    level: int
    name: str
    actions: list[dict]
    note: str


@dataclass
class SelfDrawnEscape:
    RADIUS: float = 48.0
    clicks: list[tuple[float, float, bool]] = field(default_factory=list)
    banned: list[tuple[float, float]] = field(default_factory=list)
    level: int = 0

    def observe_click(self, x: float, y: float, changed: bool) -> None:
        self.clicks.append((x, y, changed))
        del self.clicks[:-8]
        if changed:                       # a click that did something: the app is responsive, ladder resets
            self.level = 0
            self.banned.clear()

    @staticmethod
    def _d(a, b) -> float:
        return math.hypot(a[0] - b[0], a[1] - b[1])

    def triggered(self) -> bool:
        if len(self.clicks) < 2:
            return False
        a, b = self.clicks[-2], self.clicks[-1]
        return (not a[2]) and (not b[2]) and self._d(a, b) <= self.RADIUS

    def is_banned(self, x: float, y: float) -> bool:
        return any(self._d((x, y), bxy) <= self.RADIUS for bxy in self.banned)

    def next_plan(self, window_title: str, region: list[float] | None = None) -> EscapePlan | None:
        last = self.clicks[-1] if self.clicks else (0.0, 0.0, False)
        self.banned.append((last[0], last[1]))
        self.clicks.clear()
        self.level += 1
        title = window_title or "foreground"
        if self.level == 1:
            return EscapePlan(1, "hotkey_probe", [
                {"action": "focus_window", "title": title},
                {"action": "key", "keys": "ctrl+f"}],
                f"自绘软件脱困 L1：坐标 ({last[0]:.0f},{last[1]:.0f}) 连续 2 次无像素变化，已封禁该坐标；"
                f"已置顶窗口并按 Ctrl+F 探测搜索框。请直接 type 目标名称（不要再点同一位置）。")
        if self.level == 2:
            reg = region or [max(last[0] - 240, 0), max(last[1] - 160, 0), 480, 320]
            return EscapePlan(2, "crop_2x_regrounding", [
                {"action": "vision_crop", "region": reg, "scale": 2, "detail": "original"}],
                "自绘软件脱困 L2：已对目标区域做 2x 高清裁剪（detail=original）。请只依据新裁剪图重新定位，"
                "坐标必须离已封禁点 ≥48px。")
        if self.level == 3:
            return EscapePlan(3, "force_foreground_verify", [
                {"action": "focus_window", "title": title, "force_topmost": True},
                {"action": "verify_foreground", "title": title},
                {"action": "key", "keys": "esc"}],
                "自绘软件脱困 L3：已强制置顶并核验前台焦点（Esc 关闭遮挡浮层）。若仍无变化，请 replan 换软件通道（CLI/URI scheme/剪贴板粘贴）。")
        return None


@dataclass
class QuotaFinalizer:
    quota: Quota | None
    rows_start: int | None = None
    removed_rows: int = 0

    @classmethod
    def for_task(cls, task: str) -> "QuotaFinalizer":
        return cls(Quota.from_task(task))

    @property
    def active(self) -> bool:
        return self.quota is not None

    @property
    def zero(self) -> bool:
        q = self.quota
        return q is not None and not q.remaining and q.pending is None and q.done >= q.total > 0

    def confirmed(self, rows_now: int | None) -> bool:
        """Quota 8/8 AND the list really shrank (when we can see the row count)."""
        if not self.zero:
            return False
        if rows_now is None or self.rows_start is None:
            return True
        return rows_now < self.rows_start

    def note(self) -> str:
        return self.quota.fmt() if self.quota else ""


@dataclass
class Verdict:
    allow: bool = True
    code: str = "OK"
    message: str = ""
    terminal: str | None = None        # 'done' | 'fail'
    summary: str = ""


def _xy(req: ActionRequest) -> tuple[float, float] | None:
    a = req.args or {}
    if "x" in a and "y" in a:
        return float(a["x"]), float(a["y"])
    return None


@dataclass
class StateMachine:
    task: str
    policy: SecurityPolicy
    guard: EpochGuard = field(default_factory=EpochGuard)
    process: str = ""
    quota: QuotaFinalizer = field(init=False)
    escape: SelfDrawnEscape = field(default_factory=SelfDrawnEscape)
    phase: Phase = Phase.ACT
    steps: int = 0
    trace: list[dict] = field(default_factory=list)
    pending_plan: EscapePlan | None = None

    def __post_init__(self) -> None:
        self.quota = QuotaFinalizer.for_task(self.task)
        self.policy.grant_from_intent(self.task)          # Intent-Scoped Path Grant at task init

    def on_observation(self, obs) -> None:
        """Sync epoch from the executor and (re)bind every ref of this observation to it."""
        if obs.snapshot_epoch > self.guard.clock.epoch:
            self.guard.clock.epoch = obs.snapshot_epoch
        self.guard.bind([r.ref for r in obs.refs])

    # ---------------------------------------------------------------------------------------------- pre
    def pre_action(self, req: ActionRequest) -> Verdict:
        if self.phase in (Phase.DONE, Phase.FAILED):
            return Verdict(False, ErrorCode.INTERNAL.value, "task already terminal")
        act = req.action
        if self.quota.zero and act not in PASSIVE_ACTIONS and self.quota.confirmed(None):
            self.phase = Phase.FINALIZE
            return Verdict(False, ErrorCode.QUOTA_DONE.value, f"quota complete ({self.quota.note()})",
                           terminal="done", summary=f"配额已清零并核验：{self.quota.note()}")
        if act not in PASSIVE_ACTIONS and (req.expect_epoch is not None or req.target):
            code = self.guard.check(req.target if (req.target or "").startswith(("@", "cdp:")) else None, req.expect_epoch)
            if code:
                return Verdict(False, code, f"{code}: re-observe (epoch now {self.guard.epoch})")
        xy = _xy(req)
        if xy and act in ("click", "double_click", "right_click") and self.escape.is_banned(*xy):
            return Verdict(False, ErrorCode.SELF_DRAWN_ESCAPE.value,
                           f"coordinate ({xy[0]:.0f},{xy[1]:.0f}) is banned after 2 no-effect clicks; use the escape ladder")
        path = (req.args or {}).get("path")
        if path and act in ("save_text", "write_file", "read_file", "file_stat", "dir_list", "move_file"):
            op = "read" if act in ("read_file", "file_stat", "dir_list") else "write"
            try:
                self.policy.check(str(path), op)
            except SecurityDenied as e:
                return Verdict(False, ErrorCode.SECURITY_DENIED.value, str(e))
        return Verdict()

    # --------------------------------------------------------------------------------------------- post
    def post_action(self, req: ActionRequest, res: ActionResult, *, rows_now: int | None = None,
                    row_texts: list[str] | None = None, window_title: str = "") -> Verdict:
        self.steps += 1
        self.trace.append({"step": self.steps, "action": req.action, "ok": res.ok, "code": res.code})
        if res.code == ErrorCode.STALE_EPOCH.value or res.code == ErrorCode.STALE_REF.value:
            self.guard.invalidate("executor_reported_" + res.code)
        if res.epoch is not None and res.epoch > self.guard.epoch:
            self.guard.clock.epoch = res.epoch
        xy = _xy(req)
        if xy and req.action in ("click", "double_click", "right_click") and res.ok:
            self.escape.observe_click(xy[0], xy[1], bool(res.effect_changed))
        # structural change => epoch bump (CDP node ids / UIA refs minted earlier are now invalid)
        if req.action in ("toolbar_action", "delete", "archive", "navigate", "cdp_navigate") and res.ok:
            self.guard.invalidate(f"structural:{req.action}")
        if self.quota.active and self.quota.rows_start is None and rows_now is not None:
            self.quota.rows_start = rows_now
        if self.quota.active and req.action == "toolbar_action" and res.ok:
            label = str((req.args or {}).get("label", ""))
            if any(w in label.lower() for w in DESTRUCTIVE):
                texts = list((res.data or {}).get("selected_texts", []))
                if texts:
                    self.quota.quota.register(len(texts), texts)
                    self.quota.quota.resolve(row_texts or [])
        if self.quota.confirmed(rows_now):
            self.phase = Phase.FINALIZE
            return Verdict(True, "OK", "quota complete", terminal="done",
                           summary=f"配额清零并核验（列表行数 {self.quota.rows_start}→{rows_now}）：{self.quota.note()}")
        if self.escape.triggered():
            plan = self.escape.next_plan(window_title)
            if plan is None:
                self.phase = Phase.FAILED
                return Verdict(False, ErrorCode.REPEAT_NOEFFECT.value, "escape ladder exhausted", terminal="fail",
                               summary="自绘软件三级脱困均无效：请改用 CLI / URI scheme / 剪贴板通道或人工介入")
            self.pending_plan = plan
            self.phase = Phase.ESCAPE
            return Verdict(True, ErrorCode.SELF_DRAWN_ESCAPE.value, plan.note)
        return Verdict()
