async def s_v16_delete_polarity(brain: Any, allow_destructive: bool) -> dict[str, Any]:
    import uuid
    from types import SimpleNamespace

    from agent_brain import layer0, safe_shell
    from agent_brain.state_machine import StableObjectRegistry
    from agent_brain.verifier import IndependentVerifier

    if not IS_WIN:
        return result("v16_delete_polarity", "skipped", "requires a real Windows desktop (Recycle Bin)")
    name = f"dscu_v16_{uuid.uuid4().hex[:6]}"
    f = layer0.known_folder("桌面") / f"{name}.txt"
    f.write_text("v16 polarity probe", encoding="utf-8")
    ver = IndependentVerifier(brain.hub, StableObjectRegistry(), lambda m: None)
    st = SimpleNamespace(step=1, ledger=[])
    try:
        rec_ok, rec_msg = safe_shell.recycle_file(f)
        task = f"帮我把桌面上的{name}记事本删除"
        if allow_destructive:
            safe_shell.empty_recycle_bin()
            task += "，并且清空回收站里面的文件"
        v = await ver.verify_done(task, f"已将桌面 {f} 移入回收站", st, None)
        neg = await ver.verify_done(f"在桌面新建一个记事本，命名为{name}，保存", f"已保存 {f}", st, None)  # control: create-task + missing file MUST still be rejected
        names = [c.name for c in v.checks]
        good = rec_ok and v.ok and "file_not_exists" in names and "file_exists" not in names and (not neg.ok)
        return result("v16_delete_polarity", "pass" if good else "fail", f"recycled={rec_ok} verdict_ok={v.ok} checks={v.render()[:240]} negative_control_rejected={not neg.ok}",
                      verifier_accept=1.0 if v.ok else 0.0, destructive=allow_destructive)
    finally:
        try:
            f.unlink(missing_ok=True)
        except OSError:
            pass


