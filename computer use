"""Zero-Trust Security Engine + Intent-Scoped Path Grant (`agent_brain/security.py`).
Fixes v10.0 Task #1 Failure: When the user prompt explicitly specifies a legitimate user directory
(e.g. '保存在桌面' / 'Desktop' / '文档' / 'Documents'), the security engine grants scoped read/write
access to that exact directory during task initialization without weakening Path Jail or AST defense."""
from __future__ import annotations
from dataclasses import dataclass, field
from pathlib import Path
import os
import re


class SecurityError(Exception):
    def __init__(self, code: str, msg: str):
        super().__init__(f"{code}: {msg}")
        self.code = code
        self.msg = msg


FORBIDDEN_EXTENSIONS = {
    ".exe", ".dll", ".bat", ".cmd", ".ps1", ".vbs", ".js",
    ".msi", ".scr", ".lnk", ".com", ".hta", ".reg", ".sys",
}

SENSITIVE_DIR_FRAGMENTS = (
    "windows",
    "system32",
    "syswow64",
    "program files",
    ".ssh",
    ".gnupg",
    ".aws",
    "startup",
)

INJECTION_REGEX = re.compile(
    r"(ignore (all )?(previous|prior) instructions|"
    r"忽略(之前|以上|所有).{0,6}(指令|提示)|"
    r"system prompt|you are now|"
    r"下载并(执行|运行)|"
    r"powershell\s+-enc|"
    r"invoke-expression|iex\s*\(|"
    r"frombase64string|net\.webclient)",
    re.I,
)

SHELL_META_REGEX = re.compile(r"[;&|`$<>\r\n]")

USER_FOLDER_PATTERNS: list[tuple[str, str, re.Pattern[str]]] = [
    ("Desktop", "桌面", re.compile(r"(桌面|desktop)", re.I)),
    ("Documents", "文档", re.compile(r"(文档|文檔|documents|my documents)", re.I)),
    ("Downloads", "下载", re.compile(r"(下载|下載|downloads)", re.I)),
    ("Pictures", "图片", re.compile(r"(图片|圖片|相册|pictures)", re.I)),
]


@dataclass
class TaintedContext:
    tainted: bool = False
    reasons: list[str] = field(default_factory=list)
    injection: bool = False

    def mark(self, reason: str, text: str = "") -> None:
        self.tainted = True
        self.reasons.append(reason)
        if text and INJECTION_REGEX.search(text):
            self.injection = True


@dataclass
class IntentPathGrantEngine:
    """Grants scoped directory read/write permissions derived strictly from the trusted initial user prompt."""
    workspace_root: Path
    user_home: Path
    granted_roots: dict[str, Path] = field(default_factory=dict)
    alias_map: dict[str, Path] = field(default_factory=dict)

    @classmethod
    def from_user_intent(
        cls,
        task_prompt: str,
        workspace_root: str | Path,
        user_home: str | Path | None = None,
    ) -> "IntentPathGrantEngine":
        ws = Path(os.path.realpath(workspace_root))
        ws.mkdir(parents=True, exist_ok=True)
        home = Path(os.path.realpath(user_home or os.path.expanduser("~")))
        engine = cls(workspace_root=ws, user_home=home)
        engine.alias_map["工作区"] = ws
        engine.alias_map["workspace"] = ws
        engine.alias_map["$ws"] = ws

        # Never grant permissions if the prompt itself contains injection patterns
        if not task_prompt or INJECTION_REGEX.search(task_prompt):
            return engine

        for folder_en, folder_cn, rx in USER_FOLDER_PATTERNS:
            if rx.search(task_prompt):
                target = home / folder_en
                target.mkdir(parents=True, exist_ok=True)
                canon = Path(os.path.realpath(target))
                if not cls._is_sensitive(canon):
                    engine.granted_roots[folder_en] = canon
                    engine.alias_map[folder_en.lower()] = canon
                    engine.alias_map[folder_cn] = canon
        return engine

    @staticmethod
    def _is_sensitive(path: Path) -> bool:
        low = str(path).lower().replace("\\", "/")
        return any( f"/{frag}" in low or low.endswith(f"/{frag}") for frag in SENSITIVE_DIR_FRAGMENTS )

    def resolve_user_path(self, raw_path: str) -> Path:
        cleaned = raw_path.strip().strip('"').strip("'")
        norm = cleaned.replace("\\", "/")
        for alias, root in self.alias_map.items():
            prefix_slash = f"{alias}/"
            if norm.lower() == alias.lower():
                return root
            if norm.lower().startswith(prefix_slash.lower()):
                rel = norm[len(prefix_slash):].lstrip("/")
                return Path(os.path.realpath(root / rel))
        # Handle Windows-style C:\Users\<user>\Desktop\file.txt when running on POSIX simulator or matching home
        m_win = re.match(r"^[A-Za-z]:/Users/[^/]+/(Desktop|Documents|Downloads|Pictures)(?:/(.*))?$", norm, re.I)
        if m_win:
            folder = m_win.group(1).capitalize()
            rel = m_win.group(2) or ""
            base = self.granted_roots.get(folder)
            if base is not None:
                return Path(os.path.realpath(base / rel))
        p = Path(cleaned)
        if p.is_absolute():
            return Path(os.path.realpath(p))
        return Path(os.path.realpath(self.workspace_root / p))

    def allowed_roots(self) -> list[Path]:
        return [self.workspace_root, *self.granted_roots.values()]


def assert_safe_path(
    path: str,
    root: str | Path,
    op: str = "write",
    intent_engine: IntentPathGrantEngine | None = None,
    taint: TaintedContext | None = None,
) -> Path:
    if not path or "\x00" in path:
        raise SecurityError("SECURITY_DENIED", "Empty or NUL byte in path")
    if re.search(r"(^|[\\/])\.\.([\\/]|$)", path):
        raise SecurityError("SECURITY_DENIED", f"Path traversal '..' refused in {path!r}")
    if re.match(r"^[\\/]{2}", path) or re.match(r"^[A-Za-z]:[\\/]{2}\?", path):
        raise SecurityError("SECURITY_DENIED", f"UNC/device path refused: {path!r}")
    if re.search(r"[*?<>|]", path):
        raise SecurityError("SECURITY_DENIED", f"Wildcard or illegal char refused: {path!r}")
    if taint and taint.injection and op in ("write", "delete", "exec"):
        raise SecurityError("SECURITY_DENIED", "Write/exec blocked under active prompt injection taint")

    rootp = Path(os.path.realpath(root))
    if intent_engine is not None:
        full = intent_engine.resolve_user_path(path)
        valid_roots = intent_engine.allowed_roots()
    else:
        p = Path(path)
        full = Path(os.path.realpath(p if p.is_absolute() else rootp / p))
        valid_roots = [rootp]

    inside_any = False
    for r in valid_roots:
        try:
            full.relative_to(r)
            inside_any = True
            break
        except ValueError:
            continue

    if not inside_any:
        raise SecurityError(
            "SECURITY_DENIED",
            f"Operation {op!r} outside workspace & intent-granted roots: {full} (allowed: {[str(x) for x in valid_roots]})",
        )

    if op in ("write", "exec") and full.suffix.lower() in FORBIDDEN_EXTENSIONS:
        raise SecurityError("SECURITY_DENIED", f"Forbidden executable extension: {full.suffix}")

    return full


def audit_powershell_script(
    script: str,
    intent_engine: IntentPathGrantEngine,
    taint: TaintedContext | None = None,
) -> tuple[bool, str]:
    """Static AST-equivalent policy auditor for PowerShell worker commands with Intent-Scoped Path Grant."""
    if taint and taint.tainted:
        return False, "SECURITY_DENIED: Tainted context forbids run_powershell"
    if re.search(
        r"(?i)(\b(Invoke-Expression|iex|Add-Type|Invoke-WebRequest|iwr|curl|wget|Start-Process|"
        r"Register-ScheduledTask|FromBase64String|Net\.WebClient)\b|(?<!\w)-(enc|encodedcommand)\b)",
        script,
    ):
        return False, "SECURITY_DENIED: Forbidden cmdlet or reflection/encoded construct"
    # Extract quoted string path literals and verify they stay within workspace or intent-granted roots
    for m in re.finditer(r"['\"]([A-Za-z]:\\[^'\"]+|\\\\[^'\"]+|\.\.[/\\][^'\"]*)['\"]", script):
        lit = m.group(1)
        try:
            assert_safe_path(lit, intent_engine.workspace_root, "read", intent_engine=intent_engine, taint=taint)
        except SecurityError as exc:
            return False, str(exc)
    return True, "OK"


