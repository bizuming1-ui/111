    r("误操作率：同目录旁观文件(decoy)完整性", mis_bad == 0, f"{mis_bad}/{mis_n} 被误改/误删")
    r.verified_success_rate = tot_v / tot_n if tot_n else 0.0  # type: ignore[attr-defined]
    r.false_success_rate = (tot_fs + (tot_faults - tot_caught)) / (tot_n + tot_faults) if (tot_n + tot_faults) else 0.0  # type: ignore[attr-defined]
    r.misoperation_rate = mis_bad / mis_n if mis_n else 0.0  # type: ignore[attr-defined]
    r.mode, r.per_op, r.n = mode, stats, n  # type: ignore[attr-defined]
    return r


