def mails(n, checked=(), unread=(0, 1, 2), start=0):
    out = []
    for r in range(1, n + 1):
        i = r + start
        sel = r in checked
        prefix = ("已經揀選， " if sel else "") + ("未讀， " if (r - 1) in unread else "")
        out.append(Element(ref_id=f"@3:c{i * 10}", role="row", name=f"{prefix}sender{r} , subject-{r} , 10月{r}日", rect=[10, 100 + r * 30, 900, 28], zone="Row", stable_key=f"r{r}", states=[], row=r))
        out.append(Element(ref_id=f"@3:c{i * 10 + 1}", role="checkbox", name="選取", rect=[12, 100 + r * 30, 20, 20], zone="Row", stable_key=f"cb{r}", states=["checked"] if sel else [], row=r))
    return out


def filler(k):
