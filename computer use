def _h(s: str) -> str:
    return hashlib.blake2b(s.encode("utf-8", "ignore"), digest_size=6).hexdigest()


@dataclass
class RecoveryEvent:
    t: float
    step: int
    kind: str  # occluded | security | cdp | terminate
    action: str
    detail: str
    recovered: Optional[bool] = None

    def as_dict(self) -> dict[str, Any]:
        return {"t": round(self.t, 3), "step": self.step, "kind": self.kind, "action": self.action, "detail": self.detail[:300], "recovered": self.recovered}


@dataclass
class RecoveryEngine:
    deny: dict[str, str] = field(default_factory=dict)  # key -> reason
    denial_count: Counter[str] = field(default_factory=Counter)
    events: list[RecoveryEvent] = field(default_factory=list)
    pending_note: str = ""
    terminate: Optional[dict[str, str]] = None
    stats: Counter[str] = field(default_factory=Counter)

    def reset(self) -> None:
