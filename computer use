def serve(files: dict[str, str]) -> tuple[http.server.ThreadingHTTPServer, str, Path]:
    import tempfile

    d = Path(tempfile.mkdtemp(prefix="dscu_t2_www_"))
    for n, h in files.items():
        (d / n).write_text(h, encoding="utf-8")

    class Q(http.server.SimpleHTTPRequestHandler):
        def log_message(self, *a: Any) -> None:
            return

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), functools.partial(Q, directory=str(d)))
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv, f"http://127.0.0.1:{srv.server_address[1]}", d


