Add-DscuFile 'evals/tier1_micro.py' 'b04e20c70740a346ace004cbc38c6d0c2eab5f9df954c1b04f9ccaad652fb5b1' @'
"""Tier 1 - single-action micro-benchmarks, measured on the REAL machine (no mocks, no canned numbers).

 click_error_px     : N real SendInput clicks through the driver onto a Tk canvas; ground truth = the OS click position reported by Tk (<Button-1> x_root,y_root)
 keyboard_ms        : per-keystroke driver latency P50/P99 + end-to-end text integrity read back from a Tk Entry
 capture_ms         : dxcam/DXGI frame time P50/P99 (driver's own frame_ms + wall time per observe)
 fg_gate_ms         : fg_probe round-trip P50/P99
 som_localization   : UIA elements vs ground-truth Tk button rects (hit rate within tolerance, centre error px) + SoM overlay pixel check

Non-Windows hosts: every metric is reported as {"status":"skipped","reason":...} - never invented.
Run:  python evals/tier1_micro.py [--n 40] [--out file.json]
"""
from __future__ import annotations

import argparse
import asyncio
import json
import math
import os
import random
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, os.environ.get("DSCU_BRAIN_ROOT") or str(ROOT))

IS_WIN = sys.platform == "win32"


def pct(a: list[float], p: float) -> float:
    if not a:
        return 0.0
    s = sorted(a)
    return round(s[min(len(s) - 1, int(round((len(s) - 1) * p)))], 3)


def stats(a: list[float]) -> dict[str, Any]:
    return {"n": len(a), "p50": pct(a, .5), "p95": pct(a, .95), "p99": pct(a, .99), "mean": round(sum(a) / len(a), 3) if a else 0.0, "max": round(max(a), 3) if a else 0.0}


def skipped(reason: str) -> dict[str, Any]:
    return {"status": "skipped", "reason": reason}


class Gui:
    """Spawn evals/_gui_target.py; returns (process, ready-info, out-file)."""

    def __init__(self, mode: str, geometry: str = "900x600+80+80", topmost: bool = False, seconds: float = 90) -> None:
        self.out = Path(tempfile.mkdtemp(prefix="dscu_t1_")) / f"{mode}.jsonl"
        cmd = [sys.executable, str(ROOT / "evals" / "_gui_target.py"), mode, "--out", str(self.out), "--geometry", geometry, "--seconds", str(seconds)] + (["--topmost"] if topmost else [])
        self.p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, encoding="utf-8")
        self.info: dict[str, Any] = {}
        t0 = time.time()
        while time.time() - t0 < 15:
            line = self.p.stdout.readline() if self.p.stdout else ""
            if line.startswith("READY "):
                self.info = json.loads(line[6:])
                break
        if not self.info:
            self.close()
            raise RuntimeError("GUI ground-truth window did not start")

    def events(self) -> list[dict[str, Any]]:
        if not self.out.exists():
            return []
        return [json.loads(x) for x in self.out.read_text(encoding="utf-8").splitlines() if x.strip()]

    def close(self) -> None:
        try:
            self.p.terminate()
        except Exception:  # noqa: BLE001
            pass


async def bench(hub: Any, n: int) -> dict[str, Any]:
    from agent_brain.protocol import new_id

    out: dict[str, Any] = {}
    # ---- fg gate + capture
    fg = []
    for _ in range(max(60, n * 3)):
        t0 = time.perf_counter()
        try:
            await hub.drv_fg_probe()
        except Exception as e:  # noqa: BLE001
            out["fg_gate_ms"] = skipped(f"fg_probe unsupported: {e}")
            break
        fg.append((time.perf_counter() - t0) * 1000)
    if fg:
        out["fg_gate_ms"] = stats(fg)
    frame, wall = [], []
    for _ in range(max(40, n)):
        t0 = time.perf_counter()
        o = await hub.drv_observe(channel="dxgi_vision", max_elements=1)
        wall.append((time.perf_counter() - t0) * 1000)
        if o.dxgi_stats:
            frame.append(float(o.dxgi_stats.frame_ms))
            out.setdefault("capture_backend", o.dxgi_stats.capture_backend)
    out["capture_ms"] = {"frame": stats(frame), "observe_wall": stats(wall)}
    try:
        out["capture_bench_100"] = await hub.drv_bench(100)
    except Exception as e:  # noqa: BLE001
        out["capture_bench_100"] = skipped(str(e))

    # ---- click accuracy
    g = Gui("click")
    try:
        await asyncio.sleep(0.8)
        i = g.info
        rnd = random.Random(1234)
        targets = [(i["x"] + rnd.randint(40, i["w"] - 40), i["y"] + rnd.randint(40, i["h"] - 40)) for _ in range(n)]
        lat = []
        for (x, y) in targets:
            t0 = time.perf_counter()
            await hub.drv_action({"action": "click", "action_id": new_id("a"), "x": x, "y": y, "expect_hwnd": 0})
            lat.append((time.perf_counter() - t0) * 1000)
            await asyncio.sleep(0.05)
        await asyncio.sleep(0.5)
        ev = [e for e in g.events() if "x" in e]
        errs = []
        for (x, y), e in zip(targets, ev):
            errs.append(math.hypot(e["x"] - x, e["y"] - y))
        out["click_error_px"] = {**stats(errs), "delivered": len(ev), "requested": len(targets), "delivery_rate": round(len(ev) / max(1, len(targets)), 3), "latency_ms": stats(lat)}
    except Exception as e:  # noqa: BLE001
        out["click_error_px"] = skipped(f"click bench failed: {e}")
    finally:
        g.close()

    # ---- keyboard
    g = Gui("type")
    try:
        await asyncio.sleep(0.8)
        await hub.drv_action({"action": "click", "action_id": new_id("a"), "x": g.info["x"] + 200, "y": g.info["y"] + 60, "expect_hwnd": 0})
        text = "dscu" * 10
        lat = []
        for ch in text:
            t0 = time.perf_counter()
            await hub.drv_action({"action": "key", "action_id": new_id("a"), "keys": ch, "expect_hwnd": 0})
            lat.append((time.perf_counter() - t0) * 1000)
        await hub.drv_action({"action": "type", "action_id": new_id("a"), "text": "中文ABC123", "clear": False, "expect_hwnd": 0})
        await asyncio.sleep(0.6)
        evs = [e for e in g.events() if "text" in e]
        final = evs[-1]["text"] if evs else ""
        out["keyboard_ms"] = {**stats(lat), "final_text": final, "integrity": final == text + "中文ABC123"}
    except Exception as e:  # noqa: BLE001
        out["keyboard_ms"] = skipped(f"keyboard bench failed: {e}")
    finally:
        g.close()

    # ---- SoM / UIA localisation accuracy against ground-truth widgets
    g = Gui("widgets")
    try:
        await asyncio.sleep(1.2)
        o = await hub.drv_observe(channel="auto", max_elements=250)
        truth = g.info["widgets"]
        matched, errs = 0, []
        for w in truth:
            best = None
            for e in o.elements:
                if e.role.lower() in ("button",) and w["name"].lower() in (e.name or "").lower():
                    cx, cy = e.center
                    d = math.hypot(cx - w["cx"], cy - w["cy"])
                    best = d if best is None or d < best else best
            if best is not None and best <= 12:
                matched += 1
                errs.append(best)
        res: dict[str, Any] = {"widgets": len(truth), "hits_within_12px": matched, "hit_rate": round(matched / max(1, len(truth)), 3), "centre_error_px": stats(errs), "channel": o.channel, "elements_seen": len(o.elements)}
        try:
            from PIL import Image

            from agent_brain.perception import Perception

            shot = Path(tempfile.mkdtemp(prefix="dscu_som_")) / "s.png"
            s0 = await hub.drv_observe(channel="dxgi_vision", max_elements=1)
            png = getattr(s0, "screenshot_path", None) or (s0.dxgi_stats and getattr(s0.dxgi_stats, "path", None))
            if png and Path(png).exists():
                Image.open(png).save(shot)
