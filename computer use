@dataclass(frozen=True)
class ObjectDecision:
    ok: bool
    code: str        # OK | STALE_EPOCH | UNKNOWN_OBJECT | VISUAL_ONLY_NO_BUSINESS_IDENTITY | LOW_CONFIDENCE
