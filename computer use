        elif meth == "tools/call":
            send({"jsonrpc": "2.0", "id": rid, "result": call(m["params"]["name"], m["params"].get("arguments") or {})})
        elif rid == "srv-roots-1" and "result" in m and ARGV_FILE:
            with open(ARGV_FILE + ".roots", "w", encoding="utf-8") as f:
                json.dump(m["result"], f)
        elif rid is not None and meth:
            send({"jsonrpc": "2.0", "id": rid, "result": {}})


if __name__ == "__main__":
    main()
