//! Hard isolation of tainted-session child processes: Restricted Token (DISABLE_MAX_PRIVILEGE) + Low Mandatory Integrity Level.
use std::ffi::c_void;
use std::mem::size_of;
use windows::core::{PCWSTR, PWSTR};
use windows::Win32::Foundation::{CloseHandle, HANDLE, HLOCAL, LocalFree};
use windows::Win32::Security::Authorization::ConvertStringSidToSidW;
use windows::Win32::Security::{CreateRestrictedToken, SetTokenInformation, TokenIntegrityLevel, DISABLE_MAX_PRIVILEGE, SID_AND_ATTRIBUTES, TOKEN_ALL_ACCESS, TOKEN_MANDATORY_LABEL};
use windows::Win32::System::Threading::{CreateProcessAsUserW, GetCurrentProcess, OpenProcessToken, CREATE_NO_WINDOW, CREATE_SUSPENDED, PROCESS_INFORMATION, STARTUPINFOW};

/// SDDL SID of the Low integrity level.
pub const LOW_IL_SID: &str = "S-1-16-4096";
/// SE_GROUP_INTEGRITY attribute value (winnt.h).
const SE_GROUP_INTEGRITY: u32 = 0x0000_0020;

/// Start `cmdline` suspended under a restricted, Low-IL token. Returns (pid, process handle, thread handle); caller assigns the job then resumes.
pub fn spawn_low_il_suspended(cmdline: &str) -> Result<(u32, HANDLE, HANDLE), String> {
    unsafe {
        let mut cur = HANDLE::default();
        OpenProcessToken(GetCurrentProcess(), TOKEN_ALL_ACCESS, &mut cur).map_err(|e| format!("OpenProcessToken: {e}"))?;
        let mut restricted = HANDLE::default();
        let r = CreateRestrictedToken(cur, DISABLE_MAX_PRIVILEGE, None, None, None, &mut restricted);
        let _ = CloseHandle(cur);
        r.map_err(|e| format!("CreateRestrictedToken: {e}"))?;
        let sddl: Vec<u16> = LOW_IL_SID.encode_utf16().chain(std::iter::once(0)).collect();
        let mut sid = windows::Win32::Security::PSID::default();
        ConvertStringSidToSidW(PCWSTR(sddl.as_ptr()), &mut sid).map_err(|e| format!("ConvertStringSidToSid: {e}"))?;
        let tml = TOKEN_MANDATORY_LABEL { Label: SID_AND_ATTRIBUTES { Sid: sid, Attributes: SE_GROUP_INTEGRITY } };
        let set = SetTokenInformation(restricted, TokenIntegrityLevel, &tml as *const _ as *const c_void, size_of::<TOKEN_MANDATORY_LABEL>() as u32);
        let _ = LocalFree(HLOCAL(sid.0));
        if let Err(e) = set { let _ = CloseHandle(restricted); return Err(format!("SetTokenInformation(IL): {e}")); }
        let mut cmd: Vec<u16> = cmdline.encode_utf16().chain(std::iter::once(0)).collect();
        let si = STARTUPINFOW { cb: size_of::<STARTUPINFOW>() as u32, ..Default::default() };
        let mut pi = PROCESS_INFORMATION::default();
        let res = CreateProcessAsUserW(restricted, PCWSTR::null(), PWSTR(cmd.as_mut_ptr()), None, None, false, CREATE_SUSPENDED | CREATE_NO_WINDOW, None, PCWSTR::null(), &si, &mut pi);
        let _ = CloseHandle(restricted);
        res.map_err(|e| format!("CreateProcessAsUser: {e}"))?;
        Ok((pi.dwProcessId, pi.hProcess, pi.hThread))
    }
}
