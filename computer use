# ---------- Quota-Zero 自动收尾 + snapshot_epoch ----------
function Test-V11QuotaZero {
    try { $q = $script:V92.Quota; return [bool]($q -and $q.Remaining.Count -eq 0 -and $q.Done -gt 0 -and $q.Done -ge $q.Total -and -not $q.Pending) } catch { return $false }
}
function Set-V11ParentTerminal([string]$Outcome, [string]$Summary) {
    # 把当前任务循环（Invoke-AgentTask 帧）的 $outcome / $summary / $finished 置为终态：循环在本动作返回后立即收敛
    for ($i = 1; $i -le 16; $i++) {
        $f = Get-Variable -Name finished -Scope $i -ErrorAction SilentlyContinue
        if ($null -eq $f -or $f.Value -isnot [bool]) { continue }
        if ($null -eq (Get-Variable -Name outcome -Scope $i -ErrorAction SilentlyContinue)) { continue }
        if ($null -eq (Get-Variable -Name history -Scope $i -ErrorAction SilentlyContinue)) { continue }
        Set-Variable -Name outcome -Value $Outcome -Scope $i; Set-Variable -Name summary -Value $Summary -Scope $i; Set-Variable -Name finished -Value $true -Scope $i
        return $true
    }
    return $false
}
function Complete-V11QuotaZero {
    $s = "配额清零自动收尾：$(Format-V92Quota $script:V92.Quota)；列表行已真实消失，再操作只会超出任务要求。"
    if (Set-V11ParentTerminal 'done' $s) { $script:V11.QuotaFinal++; Write-Host "✔ 完成: $s" -ForegroundColor Green; try { Write-Log @{ type = 'done'; summary = $s; via = 'quota_zero' } } catch { }; return $s }
    return $null
}
$script:V11Orig_AssertBulkInterlock = ${function:Assert-BulkInterlock}
function Assert-BulkInterlock($a, [string]$kind) {
    try { return (& $script:V11Orig_AssertBulkInterlock $a $kind) }
    catch { if ("$($_.Exception.Message)" -match '\[QUOTA_DONE\]') { [void](Complete-V11QuotaZero) }; throw }
}
$script:ActionNames = @($script:ActionNames) + @('locate_file', 'save_text')
$script:V11Orig_TestActionSchema = ${function:Test-ActionSchema}
function Test-ActionSchema($a, [int]$index) {
    switch ("$($a.action)".ToLower().Trim()) {
