//! Named file mappings (`Local\dscu-frame-<pid>-<slot>-<gen>`): the client maps the pixels directly (no pipe copy).
use std::ffi::c_void;
use windows::core::PCWSTR;
use windows::Win32::Foundation::{CloseHandle, HANDLE, INVALID_HANDLE_VALUE};
use windows::Win32::System::Memory::{CreateFileMappingW, MapViewOfFile, UnmapViewOfFile, FILE_MAP_ALL_ACCESS, MEMORY_MAPPED_VIEW_ADDRESS, PAGE_READWRITE};

pub struct Shm {
    handle: HANDLE,
    view: *mut u8,
    pub size: usize,
    pub name: String,
}
unsafe impl Send for Shm {}

impl Shm {
    pub fn create(name: &str, size: usize) -> Result<Shm, String> {
        let w: Vec<u16> = name.encode_utf16().chain(std::iter::once(0)).collect();
        unsafe {
            let h = CreateFileMappingW(INVALID_HANDLE_VALUE, None, PAGE_READWRITE, (size as u64 >> 32) as u32, size as u32, PCWSTR(w.as_ptr())).map_err(|e| format!("CreateFileMapping: {e}"))?;
            let v = MapViewOfFile(h, FILE_MAP_ALL_ACCESS, 0, 0, size);
            if v.Value.is_null() {
                let _ = CloseHandle(h);
                return Err("MapViewOfFile failed".into());
            }
            Ok(Shm { handle: h, view: v.Value as *mut u8, size, name: name.to_string() })
        }
    }
    pub fn as_mut_slice(&mut self) -> &mut [u8] {
        unsafe { std::slice::from_raw_parts_mut(self.view, self.size) }
    }
}

impl Drop for Shm {
    fn drop(&mut self) {
        unsafe {
            let _ = UnmapViewOfFile(MEMORY_MAPPED_VIEW_ADDRESS { Value: self.view as *mut c_void });
            let _ = CloseHandle(self.handle);
        }
    }
}

/// Two alternating slots so a client still reading frame N is never overwritten by frame N+1.
pub struct ShmRing {
    slots: [Option<Shm>; 2],
    next: usize,
    gen: u32,
}

impl ShmRing {
    pub fn new() -> Self {
        ShmRing { slots: [None, None], next: 0, gen: 0 }
    }
    pub fn slot(&mut self, need: usize) -> Result<&mut Shm, String> {
        let i = self.next;
        self.next = (self.next + 1) % 2;
        let ok = self.slots[i].as_ref().map(|s| s.size >= need).unwrap_or(false);
        if !ok {
            self.gen += 1;
            self.slots[i] = None; // release the old mapping before creating the bigger one
            let size = need.max(1 << 20).next_power_of_two().max(need);
            let name = format!("Local\\dscu-frame-{}-{}-{}", std::process::id(), i, self.gen);
            self.slots[i] = Some(Shm::create(&name, size)?);
        }
        Ok(self.slots[i].as_mut().unwrap())
    }
}
