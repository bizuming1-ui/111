//! criterion: shared-memory ring publish/read vs the NDJSON+Base64 baseline it replaces (run on Windows for DXGI-vs-LockBits via `dscu-driver bench`).
use criterion::{criterion_group, criterion_main, Criterion, Throughput};
use dscu::shm::{Meta, Ring};

fn b64(data: &[u8]) -> String { const T: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"; let mut o = String::with_capacity(data.len() * 4 / 3 + 4); for c in data.chunks(3) { let n = (c[0] as u32) << 16 | (*c.get(1).unwrap_or(&0) as u32) << 8 | *c.get(2).unwrap_or(&0) as u32; o.push(T[(n >> 18) as usize & 63] as char); o.push(T[(n >> 12) as usize & 63] as char); o.push(if c.len() > 1 { T[(n >> 6) as usize & 63] as char } else { '=' }); o.push(if c.len() > 2 { T[n as usize & 63] as char } else { '=' }); } o }

fn bench(c: &mut Criterion) {
    let (w, h) = (1920usize, 1080usize);
    let frame = vec![0x5Au8; w * h * 4];
    let ring = Ring::new_heap(3, frame.len());
    let m = Meta { w: w as u32, h: h as u32, stride: (w * 4) as u32, ..Default::default() };
    let mut g = c.benchmark_group("frame_transport_1080p");
    g.throughput(Throughput::Bytes(frame.len() as u64));
    g.sample_size(30);
    g.bench_function("shm_ring_write(seqlock)", |b| b.iter(|| ring.write(&m, &frame).unwrap()));
    g.bench_function("shm_ring_write+read_latest", |b| b.iter(|| { ring.write(&m, &frame).unwrap(); ring.read_latest().unwrap() }));
    g.bench_function("ndjson_base64_baseline", |b| b.iter(|| { let s = format!("{{\"frame\":\"{}\"}}", b64(&frame)); s.len() }));
    g.finish();
}
criterion_group!(benches, bench);
criterion_main!(benches);
