// CUDA / TensorRT-class path: identical contract to framediff.cpp, executed fully in VRAM (< 1 ms @1080p on an RTX-class GPU).
#include <cstdint>
#include <cuda_runtime.h>
// grid = (tiles_x, tiles_y), block = 256 threads; one 16x16 tile per block; shared-memory reduction of |prev-cur| over BGRA bytes.
__global__ void ds_tile_diff(const uint8_t* __restrict__ prev, const uint8_t* __restrict__ cur, int w, int h, int stride, uint32_t thr, uint32_t* dirty_mask, int tiles_x) {
  __shared__ uint32_t part[256];
  int px = blockIdx.x * 16 + (threadIdx.x & 15), py = blockIdx.y * 16 + (threadIdx.x >> 4);
  uint32_t d = 0;
  if (px < w && py < h) { const uchar4 a = *(const uchar4*)(prev + (size_t)py * stride + px * 4), b = *(const uchar4*)(cur + (size_t)py * stride + px * 4);
    d = abs((int)a.x - (int)b.x) + abs((int)a.y - (int)b.y) + abs((int)a.z - (int)b.z) + abs((int)a.w - (int)b.w); }
  part[threadIdx.x] = d; __syncthreads();
  for (int s = 128; s > 0; s >>= 1) { if (threadIdx.x < s) part[threadIdx.x] += part[threadIdx.x + s]; __syncthreads(); }
  if (threadIdx.x == 0 && part[0] > thr) { int t = blockIdx.y * tiles_x + blockIdx.x; atomicOr(&dirty_mask[t >> 5], 1u << (t & 31)); }
}
extern "C" int ds_cuda_framediff(const uint8_t* d_prev, const uint8_t* d_cur, int w, int h, int stride, uint32_t thr, uint32_t* d_mask, cudaStream_t st) {
  int tx = (w + 15) / 16, ty = (h + 15) / 16;
  cudaMemsetAsync(d_mask, 0, ((size_t)tx * ty + 31) / 32 * 4, st);
  ds_tile_diff<<<dim3(tx, ty), 256, 0, st>>>(d_prev, d_cur, w, h, stride, thr, d_mask, tx);
  return (int)cudaGetLastError();
}
