        'videos' { [Environment]::GetFolderPath('MyVideos') }
        default { '' }
    }
    if ([string]::IsNullOrWhiteSpace($p)) { return $null }
    return $p
}
function Get-V11IntentFolders([string]$Text) {
    $out = [System.Collections.Generic.List[string]]::new()
    foreach ($kv in $script:V11FolderWords.GetEnumerator()) {
        foreach ($w in $kv.Value) {
            $hit = if ($w -match '[\u4e00-\u9fff]') { $Text.Contains($w) } else { [regex]::IsMatch($Text, "(?i)\b$([regex]::Escape($w))\b") }
            if ($hit) { [void]$out.Add($kv.Key); break }
        }
    }
    return @($out)
}
function Set-V11IntentGrants([string]$TaskText) {
    # 授权只来自用户任务原文（绝不来自观察 / 网页 / 工具输出 = 提示词注入防火墙）；只读写，永不含 delete / exec；敏感目录黑名单先于授权
    $script:V11.Grants.Clear()
    foreach ($k in (Get-V11IntentFolders $TaskText)) {
        $d = Get-V11KnownFolder $k
        if (-not $d -or -not [System.IO.Directory]::Exists($d)) { continue }
        $sr = $null; try { $sr = Get-SecSensitiveReason $d } catch { }
        if ($sr) { continue }
        [void]$script:V11.Grants.Add($d)
    }
}
$script:V11Orig_TestSafePath = ${function:Test-SafePath}
function Test-SafePath {
    param([string]$Path, [ValidateSet('read', 'write', 'delete', 'exec')][string]$Operation = 'write', [string]$Root = '', [switch]$AllowWildcard)
    $r = & $script:V11Orig_TestSafePath -Path $Path -Operation $Operation -Root $Root -AllowWildcard:$AllowWildcard
    if ($r.Ok -or $Operation -notin 'read', 'write' -or $script:V11.Grants.Count -eq 0 -or "$($r.Reason)" -ne 'outside_workspace') { return $r }
    try {
        $base = if ($Root) { $Root } else { $script:WorkspaceRoot }
        $c = ConvertTo-CanonWinPath ([Environment]::ExpandEnvironmentVariables($Path)) $base -AllowWildcard:$AllowWildcard
        if (-not $c.Ok) { return $r }
        if ($Operation -eq 'write' -and ([System.IO.Path]::GetExtension("$($c.Path)").ToLower() -in $script:V11ForbiddenExt)) { return $r }
        $sr = Get-SecSensitiveReason $c.Path; if ($sr) { return $r }
        foreach ($g in $script:V11.Grants) {
            if (Test-SecPathInside $c.Path $g) {
                if ($IsWindows) { try { $at = [System.IO.File]::GetAttributes($c.Path); if ($at -band [System.IO.FileAttributes]::ReparsePoint) { return $r } } catch { } }
                $script:V11.GrantHits++
                return [pscustomobject]@{ Ok = $true; Path = $c.Path; Reason = '' }
            }
        }
    }
    catch { }
    return $r
}

# ---------- Layer 0 · Native Safe File：纯文件任务 = 确定性写盘 + 回读校验（免 LLM / 免 GUI）----------
$script:V11RxContent = '(?:输入|写入|写上|写下|内容(?:是|为)?)[:：]?\s*(?<c>.+?)\s*[，,。；;]?\s*(?=(?:并|然后|再)?(?:命名|名为|取名|文件名|叫做?|另存|保存|存(?:在|到|于|放)|放(?:在|到)|$))'
$script:V11RxName = '(?:命名为|名为|取名为?|文件名(?:为|是)?|叫做?)\s*(?<n>.+?)\s*(?=[，,。；;]|(?:并|然后|再)?(?:保存|存(?:在|到|于|放)|放(?:在|到))|$)'
$script:V11RxFolder = '(?:保存|存|放)(?:在|到|于)?\s*(?:我的)?\s*(?<f>桌面|文档|下载|图片|音乐|视频|desktop|documents|downloads)'
function ConvertTo-V11Unquote([string]$s) {
    # 注意：PowerShell 把 “ ” ‘ ’ 当作引号字符，源码里一律用码点，避免整份脚本被误解析
    $q = [char[]]@([char]34, [char]39, [char]0x201C, [char]0x201D, [char]0x2018, [char]0x2019, [char]0x300C, [char]0x300D, [char]0x300E, [char]0x300F, [char]0x300A, [char]0x300B)
    return $s.Trim().Trim($q).Trim()
}
function Resolve-V11SaveTextIntent([string]$Task) {
    if ($Task -notmatch '(?i)(记事本|notepad|文本文档|文本文件|\.txt|txt)') { return $null }
    $opt = [System.Text.RegularExpressions.RegexOptions]::Singleline -bor [System.Text.RegularExpressions.RegexOptions]::IgnoreCase
    $fm = [regex]::Match($Task, $script:V11RxFolder, $opt); $nm = [regex]::Match($Task, $script:V11RxName, $opt)
    if (-not ($fm.Success -and $nm.Success)) { return $null }
    $cm = [regex]::Match($Task, $script:V11RxContent, $opt)
    $fw = $fm.Groups['f'].Value.ToLower()
    $key = $null
    foreach ($kv in $script:V11FolderWords.GetEnumerator()) { if (@($kv.Value | ForEach-Object { $_.ToLower() }) -contains $fw) { $key = $kv.Key; break } }
    if (-not $key) { return $null }
    return [pscustomobject]@{ Content = $(if ($cm.Success) { ConvertTo-V11Unquote $cm.Groups['c'].Value } else { '' }); Name = (ConvertTo-V11Unquote $nm.Groups['n'].Value); Folder = $key }
}
function ConvertTo-V11FileName([string]$Name, [string]$DefaultExt = '.txt') {
    $n = ([regex]::Replace($Name, '[<>:"/\\|?*\x00-\x1f]', '_')).Trim().TrimEnd('.', ' ')
    if (-not $n) { $n = 'untitled' }
    if (-not [System.IO.Path]::GetExtension($n)) { $n += $DefaultExt }
    return $n
}
function Save-V11TextFile([string]$FolderKey, [string]$Name, [string]$Content, [string]$OnExists = 'rename') {
    $dir = Get-V11KnownFolder $FolderKey
    if (-not $dir -or -not [System.IO.Directory]::Exists($dir)) { throw "未找到已知文件夹「$FolderKey」" }
    $sr = $null; try { $sr = Get-SecSensitiveReason $dir } catch { }
    if ($sr) { throw "[SECURITY_PATH_VIOLATION] 目录属于敏感区域（$sr），拒绝写入" }
    $fn = ConvertTo-V11FileName $Name
    $ext = [System.IO.Path]::GetExtension($fn).ToLower()
    if ($ext -in $script:V11ForbiddenExt) { throw "[SECURITY_EXEC_VIOLATION] 禁止写入可执行类型 $ext" }
    $target = [System.IO.Path]::Combine($dir, $fn); $renamed = $false
    if ([System.IO.File]::Exists($target)) {
        if ($OnExists -eq 'fail') { throw "文件已存在：$target" }
        if ($OnExists -eq 'rename') {
            $stem = [System.IO.Path]::GetFileNameWithoutExtension($fn); $i = 2
            while ([System.IO.File]::Exists($target)) { $target = [System.IO.Path]::Combine($dir, "$stem ($i)$ext"); $i++ }
            $renamed = $true
        }
    }
    $bytes = [System.Text.UTF8Encoding]::new($false).GetBytes($Content)
    $tmp = [System.IO.Path]::Combine($dir, ".dscu-$([guid]::NewGuid().ToString('N').Substring(0, 8)).tmp")
    try {
        [System.IO.File]::WriteAllBytes($tmp, $bytes)
        if ($OnExists -eq 'overwrite' -and [System.IO.File]::Exists($target)) { [System.IO.File]::Move($tmp, $target, $true) } else { [System.IO.File]::Move($tmp, $target) }
    }
    finally { if ([System.IO.File]::Exists($tmp)) { Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue } }
    $back = [System.IO.File]::ReadAllBytes($target)
    $same = ($back.Length -eq $bytes.Length) -and (-not (Compare-Object $back $bytes -SyncWindow 0))
    return [pscustomobject]@{ Ok = [bool]$same; Path = $target; Bytes = $back.Length; Chars = $Content.Length; Renamed = $renamed; Dir = $dir }
}
function Invoke-V11SaveTextAction($a) {
    $key = $null
    $f = "$($a.folder)".Trim().ToLower()
    foreach ($kv in $script:V11FolderWords.GetEnumerator()) { if ($kv.Key -eq $f -or @($kv.Value | ForEach-Object { $_.ToLower() }) -contains $f) { $key = $kv.Key; break } }
    if (-not $key) { throw 'save_text 需要 folder：桌面 / 文档 / 下载 / 图片 / 音乐 / 视频' }
    if ($script:V11.Grants.Count -eq 0 -or -not ($script:V11.Grants | Where-Object { $_ -ieq (Get-V11KnownFolder $key) })) { throw (New-SecError 'SECURITY_PATH_VIOLATION' "任务原文没有提到「$f」，没有该目录的写授权（Intent-Scoped Path Grant 只来自用户原话）。") }
    $r = Save-V11TextFile $key "$($a.name)" "$($a.content)" $(if ($a.on_exists) { "$($a.on_exists)" } else { 'rename' })
    return "save_text：$(if ($r.Ok) { '✅ 已写入并字节级回读校验通过' } else { '❌ 回读不一致' }) — $($r.Path)（$($r.Bytes) 字节 / $($r.Chars) 字符 UTF-8$(if ($r.Renamed) { '；同名已存在，已自动改名，未覆盖' })）"
}
function Invoke-V11LocateFile($a) {
    $name = "$($a.name)".Trim(); if (-not $name) { throw 'locate_file 需要 name' }
    $name = [System.IO.Path]::GetFileName($name)
    $stem = [System.IO.Path]::GetFileNameWithoutExtension($name)
    $roots = @($script:WorkspaceRoot) + @($script:V11.Grants) | Where-Object { $_ -and [System.IO.Directory]::Exists($_) } | Select-Object -Unique
    $hits = [System.Collections.Generic.List[object]]::new()
    foreach ($r in $roots) {
        try { foreach ($f in (Get-ChildItem -LiteralPath $r -Filter "$stem*" -File -Recurse -Depth 2 -ErrorAction SilentlyContinue | Select-Object -First 20)) { [void]$hits.Add($f) } } catch { }
    }
    $viaRecent = ''
    if ($IsWindows) {
        try {   # 「最近使用」快捷方式记录了文件的真实路径：另存为对话框存到哪儿，一查便知（只读元数据）
            $rd = Join-Path ([Environment]::GetFolderPath('ApplicationData')) 'Microsoft\Windows\Recent'
            $sh = New-Object -ComObject WScript.Shell
            foreach ($l in (Get-ChildItem -LiteralPath $rd -Filter "$stem*.lnk" -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 5)) {
                $t = $sh.CreateShortcut($l.FullName).TargetPath
                if ($t -and [System.IO.File]::Exists($t)) { $viaRecent += "`n  [最近使用→真实路径] $t  $((Get-Item -LiteralPath $t).Length) 字节  $((Get-Item -LiteralPath $t).LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))" }
            }
        } catch { }
    }
    $lines = @($hits | Sort-Object LastWriteTime -Descending | ForEach-Object { "  [文件] $($_.FullName)  $($_.Length) 字节  $($_.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss'))" })
    if ($lines.Count -eq 0 -and -not $viaRecent) { return "locate_file：在 工作区 / 已授权目录（$(@($script:V11.Grants) -join ' | ')）内未找到「$name」；保存可能没有成功，请回到记事本用 Ctrl+Shift+S 重新另存为，或用 save_text 直接写盘。" }
    return "locate_file「$name」命中 $($lines.Count) 项：`n$($lines -join "`n")$viaRecent"
}

$script:V11Orig_InvokeAgentTask = ${function:Invoke-AgentTask}
function Invoke-AgentTask([string]$TaskText) {
    try { $script:V11.Task = $TaskText; Set-V11IntentGrants $TaskText } catch { }
    if (-not $script:V11.NoL0 -and -not $DryRun) {
        $it = $null; try { $it = Resolve-V11SaveTextIntent $TaskText } catch { }
        if ($it) { $res = $null; try { $res = Invoke-V11L0SaveText $TaskText $it } catch { Write-Host "  Layer 0 异常，回退 GUI 层：$($_.Exception.Message)" -ForegroundColor DarkYellow; $script:V11.L0Fail++ }; if ($res) { return $res } }
    }
    return (& $script:V11Orig_InvokeAgentTask $TaskText)
}
function Invoke-V11L0SaveText([string]$TaskText, $it) {
    $kw = @{ desktop = '桌面'; documents = '文档'; downloads = '下载'; pictures = '图片'; music = '音乐'; videos = '视频' }[$it.Folder]
    Write-Host '── 第 1 步 ──' -ForegroundColor Cyan
    Write-Host "  [Layer 0: Native Safe File] 纯文件任务：确定性写盘 + 字节级回读校验，免 LLM / 免 GUI 点击；授权目录（来自任务原文）：$kw → $(Get-V11KnownFolder $it.Folder)" -ForegroundColor DarkCyan
    $desc = "action=save_text folder=$kw name=$($it.Name) chars=$($it.Content.Length)"
    Write-Host "  动作: $desc" -ForegroundColor White
    $d = Confirm-Action $desc
    if ($d -ne 'y') { Write-Host '  已跳过 Layer 0，交给逐步确认的 GUI 流程。' -ForegroundColor DarkYellow; return $null }
    $r = Save-V11TextFile $it.Folder $it.Name $it.Content 'rename'
    Write-Log @{ type = 'layer0'; action = 'save_text'; path = $r.Path; bytes = $r.Bytes; ok = $r.Ok; renamed = $r.Renamed }
    if (-not $r.Ok) { Write-Host '  结果: 回读不一致，回退 GUI 层。' -ForegroundColor Red; $script:V11.L0Fail++; return $null }
    Write-Host "  结果: ✅ 已写入 $($r.Path)（$($r.Bytes) 字节 / $($r.Chars) 字符 UTF-8，无 BOM）$(if ($r.Renamed) { '；同名文件已存在 → 自动改名，未覆盖' })" -ForegroundColor Green
    Write-Host '── 第 2 步 ──' -ForegroundColor Cyan
    Write-Host "  动作: action=open_file app=notepad path=$($r.Path)" -ForegroundColor White
    $shown = ''
    try {
        if ($IsWindows) {
            Start-Process -FilePath 'notepad.exe' -ArgumentList @("`"$($r.Path)`"") | Out-Null
            $stem = [System.IO.Path]::GetFileNameWithoutExtension($r.Path); $sw = [System.Diagnostics.Stopwatch]::StartNew()
            while ($sw.ElapsedMilliseconds -lt 4000 -and -not $shown) {
                Start-Sleep -Milliseconds 200
                $w = Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowTitle -like "*$stem*" } | Select-Object -First 1
                if ($w) { $shown = $w.MainWindowTitle }
            }
        }
    } catch { }
    Write-Host "  结果: $(if ($shown) { "已在记事本中展示：[$shown]" } else { '已请求用记事本打开（窗口标题未能确认，不影响文件本身）' })" -ForegroundColor Green
    Write-Host '── 第 3 步 ──' -ForegroundColor Cyan
    Write-Host "  动作: action=verify_text_file path=$($r.Path)" -ForegroundColor White
    $txt = [System.IO.File]::ReadAllText($r.Path, [System.Text.Encoding]::UTF8)
    $ok = ($txt -ceq $it.Content)
    Write-Host "  结果: $(if ($ok) { '✅ 文件存在 · 内容与要求完全一致' } else { '❌ 内容不一致' })" -ForegroundColor $(if ($ok) { 'Green' } else { 'Red' })
    if (-not $ok) { $script:V11.L0Fail++; return $null }
    $summary = "已保存并核验：$($r.Path)（$($r.Bytes) 字节；Layer 0 共 3 步，0 次 LLM 调用）"
    Write-Host "✔ 完成: $summary" -ForegroundColor Green
    Write-Log @{ type = 'done'; summary = $summary; layer = 0 }
    $script:V11.L0++
    return [pscustomobject]@{ Outcome = 'done'; Summary = $summary }
}

# ---------- Self-Drawn App 脱困矩阵（微信等 UIA 盲区软件）----------
function Get-V11FgTitle { try { return "$([DsNative61]::WinText([DsNative61]::GetForegroundWindow()))" } catch { return '' } }
function Test-V11Banned($a) {
    if ($script:V11.Banned.Count -eq 0) { return $false }
    $px = $a.PSObject.Properties['x']; $py = $a.PSObject.Properties['y']
    if ($null -eq $px -or $null -eq $py) { return $false }
    foreach ($b in $script:V11.Banned) { if ([Math]::Sqrt([Math]::Pow([double]$px.Value - $b[0], 2) + [Math]::Pow([double]$py.Value - $b[1], 2)) -le 48) { return $true } }
    return $false
}
function Invoke-V11EscapeLadder($a, [string]$kind, [switch]$NoSend) {
    $px = $a.PSObject.Properties['x']; $py = $a.PSObject.Properties['y']
    if ($null -eq $px -or $null -eq $py) { return $null }
    $v = $script:V11; $x = [int]$px.Value; $y = [int]$py.Value
    $v.EscLevel++; $v.EscTotal++
    [void]$v.Banned.Add(@([double]$x, [double]$y))
    $title = Get-V11FgTitle
    switch ($v.EscLevel) {
        1 {
            if (-not $NoSend) { try { [void](Focus-WindowByTitle $title) } catch { }; try { Send-KeySequence 'ctrl+f' } catch { }; Start-Sleep -Milliseconds 180 }
            return "[SELF_DRAWN_ESCAPE] 自绘软件脱困 L1：坐标 ($x,$y) 连续 2 次无像素变化，已封禁该坐标（48px）；已置顶窗口 [$(Limit-Text $title 30)] 并按下 Ctrl+F 探测搜索框。界面已变化：请重新观察，直接 type 目标名称（不要再点同一位置）。"
        }
        2 {
            $v.HiRes = $true; $script:BlockErrStreak = [Math]::Max([int]$script:BlockErrStreak, 2)   # 强制下一步走视觉：2x 高清（detail=original）
            return "[SELF_DRAWN_ESCAPE] 自绘软件脱困 L2：已升级为 2x 高清重定位（下一步强制视觉，detail=original）。请只依据新截图重新定位，坐标必须离已封禁点 ≥48px；也可改用快捷键 / 键盘导航。"
        }
        3 {
            if (-not $NoSend) { try { [void](Focus-WindowByTitle $title) } catch { }; try { Send-KeySequence 'esc' } catch { }; Start-Sleep -Milliseconds 150 }
            $fg = Get-V11FgTitle
            return "[SELF_DRAWN_ESCAPE] 自绘软件脱困 L3：已强制置顶并核验焦点（前台=[$(Limit-Text $fg 30)]），Esc 已关闭可能的遮挡浮层。若仍无变化请 replan，换通道（CLI / URI scheme / 剪贴板粘贴 / 键盘导航）。"
        }
        default { return $null }
    }
}
$script:V11Orig_AssertRepeatGuard = ${function:Assert-RepeatGuard}
function Assert-RepeatGuard($a, [string]$kind) {
    if (-not $script:V11.NoEscape -and $kind -in 'click', 'double_click', 'right_click' -and (Test-V11Banned $a) -and -not (Test-True $a.force)) {
        throw "[SELF_DRAWN_ESCAPE] 坐标 ($($a.x),$($a.y)) 已被封禁（此前 2 次点击无像素变化）。界面已变化的证据不足，请按脱困提示换通道（Ctrl+F / 2x 裁剪 / 键盘导航），不要再点这个位置。"
    }
    try { return (& $script:V11Orig_AssertRepeatGuard $a $kind) }
    catch {
        $m = "$($_.Exception.Message)"
        if (-not $script:V11.NoEscape -and $m -match '^\[REPEAT_NOEFFECT\]' -and $kind -in 'click', 'double_click', 'right_click') {
            $e = $null; try { $e = Invoke-V11EscapeLadder $a $kind } catch { }
            if ($e) { throw $e }
        }
        throw
    }
}
