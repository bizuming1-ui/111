use std::sync::atomic::Ordering;
use std::sync::Arc;
use tokio::io::{AsyncBufReadExt, AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, BufReader};

#[derive(Default)]
struct Args {
    pipe: Option<String>,
    alias: Option<String>,
    no_alias: bool,
    token_file: Option<PathBuf>,
    stdio: bool,
    mock: bool,
    parent_pid: Option<u32>,
    workspace: Option<String>,
    memory_floor_mb: Option<u64>,
    sidecar_ttl: Option<u64>,
    no_dxgi: bool,
    no_jab: bool,
    open_acl: bool,
    selftest: bool,
    no_job: bool,
    no_auth: bool,
}

fn parse_args() -> Args {
    let mut a = Args::default();
    let mut it = std::env::args().skip(1);
    while let Some(k) = it.next() {
        match k.as_str() {
            "--pipe" => a.pipe = it.next(),
            "--alias" => a.alias = it.next(),
            "--no-alias" => a.no_alias = true,
            "--token-file" => a.token_file = it.next().map(PathBuf::from),
            "--stdio" => a.stdio = true,
            "--mock" => a.mock = true,
            "--parent-pid" => a.parent_pid = it.next().and_then(|s| s.parse().ok()),
            "--workspace" => a.workspace = it.next(),
            "--memory-floor-mb" => a.memory_floor_mb = it.next().and_then(|s| s.parse().ok()),
            "--sidecar-ttl" => a.sidecar_ttl = it.next().and_then(|s| s.parse().ok()),
            "--no-dxgi" => a.no_dxgi = true,
            "--no-jab" => a.no_jab = true,
            "--open-acl" => a.open_acl = true,
            "--selftest" => a.selftest = true,
            "--no-job" => a.no_job = true,
            "--no-auth" => a.no_auth = true,
            "--version" | "-V" => {
                println!("dscu-driver {}", dscu_core::engine::VERSION);
                std::process::exit(0);
            }
            "--help" | "-h" => {
                println!("dscu-driver [--pipe NAME] [--alias NAME|--no-alias] [--token-file PATH] [--stdio] [--mock] [--parent-pid N] [--workspace DIR]\n            [--memory-floor-mb N] [--sidecar-ttl SEC] [--no-dxgi] [--no-jab] [--open-acl] [--selftest] [--no-job] [--no-auth]");
                std::process::exit(0);
            }
            other => eprintln!("ignoring unknown argument {other}"),
        }
    }
    a
}

fn default_token_file() -> PathBuf {
    let base = std::env::var_os("LOCALAPPDATA").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
    base.join("DeepSeekComputerUse").join("driver.token")
}

/// Reuse a well-formed existing token (so a running PowerShell client keeps working across daemon restarts), else mint one.
fn load_or_create_token(path: &PathBuf) -> std::io::Result<String> {
    if let Ok(t) = std::fs::read_to_string(path) {
        let t = t.trim().to_string();
        if t.len() >= 32 && t.bytes().all(|c| c.is_ascii_hexdigit()) {
            return Ok(t);
        }
    }
    let mut b = [0u8; 32];
    getrandom::getrandom(&mut b).map_err(|e| std::io::Error::new(std::io::ErrorKind::Other, e.to_string()))?;
    let t: String = b.iter().map(|x| format!("{x:02x}")).collect();
    if let Some(p) = path.parent() {
        std::fs::create_dir_all(p)?;
    }
    std::fs::write(path, &t)?;
    #[cfg(windows)]
    {
        // owner-only ACL (best effort; %LOCALAPPDATA% is already per-user)
        if let Ok(user) = std::env::var("USERNAME") {
            let _ = std::process::Command::new("icacls").arg(path).args(["/inheritance:r", "/grant:r"]).arg(format!("{user}:F")).output();
        }
    }
    Ok(t)
}

async fn serve_stream<R: AsyncRead + Unpin, W: AsyncWrite + Unpin>(rd: R, mut wr: W, engine: Arc<Engine>) {
    let mut rd = BufReader::with_capacity(65536, rd);
    let mut line = String::new();
    loop {
        line.clear();
        let n = match (&mut rd).take(MAX_LINE_BYTES as u64 + 1).read_line(&mut line).await {
            Ok(n) => n,
            Err(_) => break,
        };
        if n == 0 || line.len() > MAX_LINE_BYTES {
            break;
        }
        let l = line.trim().to_string();
        if l.is_empty() {
            continue;
        }
        let eng = engine.clone();
        let resp = match tokio::task::spawn_blocking(move || eng.handle_line(&l)).await {
            Ok(r) => r,
            Err(_) => r#"{"jsonrpc":"2.0","v":1,"id":null,"error":{"code":5000,"message":"INTERNAL: handler panicked","data":{"kind":"INTERNAL"}}}"#.to_string(),
        };
        if wr.write_all(resp.as_bytes()).await.is_err() || wr.write_all(b"\n").await.is_err() || wr.flush().await.is_err() {
            break;
        }
        if engine.shutdown.load(Ordering::SeqCst) {
            break;
        }
    }
}

fn build_platform(a: &Args) -> (Arc<dyn Platform>, Option<Arc<MockPlatform>>) {
    if a.mock {
        let m = Arc::new(MockPlatform::new());
        return (m.clone(), Some(m));
    }
    #[cfg(windows)]
    {
        dscu_win32::init_process();
        let exe_dir = std::env::current_exe().ok().and_then(|p| p.parent().map(|x| x.to_path_buf()));
        let script = exe_dir.as_ref().map(|d| d.join("sidecar-dml").join("server.py")).filter(|p| p.exists());
        let cfg = dscu_win32::WinConfig { no_dxgi: a.no_dxgi, no_jab: a.no_jab, sidecar_script: script, python: std::env::var("DSCU_PYTHON").ok() };
        return (Arc::new(dscu_win32::WinPlatform::new(cfg)), None);
    }
    #[cfg(not(windows))]
    {
        eprintln!("dscu-driver: native backend is Windows-only; falling back to --mock");
        let m = Arc::new(MockPlatform::new());
        (m.clone(), Some(m))
    }
}

#[cfg(windows)]
mod winpipe {
    use super::*;
    use std::ffi::c_void;
    use tokio::net::windows::named_pipe::ServerOptions;
    use windows::core::{PCWSTR, PWSTR};
    use windows::Win32::Foundation::{LocalFree, HANDLE, HLOCAL};
    use windows::Win32::Security::Authorization::*;
    use windows::Win32::Security::*;
    use windows::Win32::System::Threading::*;

    pub struct Sa {
        sa: SECURITY_ATTRIBUTES,
        _sd: PSECURITY_DESCRIPTOR,
    }
    unsafe impl Send for Sa {}
    unsafe impl Sync for Sa {}

    fn user_sid() -> Option<String> {
        unsafe {
            let mut tok = HANDLE::default();
            OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut tok).ok()?;
            let mut need = 0u32;
            let _ = GetTokenInformation(tok, TokenUser, None, 0, &mut need);
            let mut buf = vec![0u8; need as usize];
            GetTokenInformation(tok, TokenUser, Some(buf.as_mut_ptr() as *mut c_void), need, &mut need).ok()?;
            let tu = &*(buf.as_ptr() as *const TOKEN_USER);
            let mut s = PWSTR::null();
            ConvertSidToStringSidW(tu.User.Sid, &mut s).ok()?;
            let out = s.to_string().ok();
            let _ = LocalFree(HLOCAL(s.0 as *mut c_void));
            out
        }
    }

    /// DACL: current user + SYSTEM only (no Everyone read). Falls back to the default DACL if SDDL conversion fails.
    pub fn make_sa() -> Option<Sa> {
        let sid = user_sid()?;
        let sddl: Vec<u16> = format!("D:P(A;;GA;;;{sid})(A;;GA;;;SY)").encode_utf16().chain(std::iter::once(0)).collect();
        unsafe {
            let mut sd = PSECURITY_DESCRIPTOR::default();
            ConvertStringSecurityDescriptorToSecurityDescriptorW(PCWSTR(sddl.as_ptr()), SDDL_REVISION_1, &mut sd, None).ok()?;
            Some(Sa { sa: SECURITY_ATTRIBUTES { nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32, lpSecurityDescriptor: sd.0, bInheritHandle: false.into() }, _sd: sd })
        }
    }

    pub async fn serve(name: String, engine: Arc<Engine>, sa: Option<Arc<Sa>>) -> std::io::Result<()> {
        let full = format!(r"\\.\pipe\{name}");
        let mk = |first: bool| -> std::io::Result<tokio::net::windows::named_pipe::NamedPipeServer> {
            let mut o = ServerOptions::new();
            o.first_pipe_instance(first).reject_remote_clients(true).max_instances(64);
            match &sa {
                Some(s) => unsafe { o.create_with_security_attributes_raw(&full, &s.sa as *const _ as *mut c_void) },
                None => o.create(&full),
            }
        };
        let mut server = mk(true)?;
        loop {
            server.connect().await?;
            let conn = server;
            server = mk(false)?; // next instance first, so clients never see ERROR_PIPE_BUSY
            let eng = engine.clone();
            tokio::spawn(async move {
                let (r, w) = tokio::io::split(conn);
                serve_stream(r, w, eng).await;
            });
        }
    }

    pub fn watch_parent(pid: u32, engine: Arc<Engine>) {
        std::thread::spawn(move || unsafe {
            if let Ok(h) = OpenProcess(PROCESS_SYNCHRONIZE, false, pid) {
                WaitForSingleObject(h, INFINITE);
                engine.shutdown.store(true, Ordering::SeqCst);
                std::thread::sleep(std::time::Duration::from_millis(200));
                std::process::exit(0);
            }
        });
    }
}

#[tokio::main]
async fn main() {
    let a = parse_args();
    let token = if a.no_auth {
        None
    } else {
        let p = a.token_file.clone().unwrap_or_else(default_token_file);
        match load_or_create_token(&p) {
            Ok(t) => Some(t),
            Err(e) => {
                eprintln!("dscu-driver: cannot create token file {}: {e}", p.display());
                std::process::exit(2);
            }
        }
    };
    let pipe = a.pipe.clone().unwrap_or_else(|| "dscu-driver-v1".into());
    let alias = if a.no_alias { None } else { Some(a.alias.clone().unwrap_or_else(|| "ds_computer_use_v7".into())) };
    let mut cfg = EngineConfig { token: token.clone(), workspace_root: a.workspace.clone(), mock_debug: a.mock, ..Default::default() };
    if let Some(m) = a.memory_floor_mb {
        cfg.memory_floor_mb = m;
    }
    if let Some(t) = a.sidecar_ttl {
        cfg.sidecar_ttl_sec = t;
    }
    cfg.pipes = std::iter::once(pipe.clone()).chain(alias.clone()).collect();

    #[cfg(windows)]
    if !a.no_job && !a.mock {
        // whole process tree (sidecar, helpers) dies with the driver: KILL_ON_JOB_CLOSE
        if let Ok(j) = dscu_win32::job::Job::kill_on_close(None) {
            let _ = j.assign_self();
            std::mem::forget(j);
        }
    }

    let (platform, mock) = build_platform(&a);
    let engine = Arc::new(Engine::new(platform.clone(), cfg));
    if let Some(m) = mock {
        engine.set_mock_hook(Box::new(move |w, mode| m.mutate(w, mode)));
    }
    let pi = platform.info();
    eprintln!("dscu-driver {} | pipe=\\\\.\\pipe\\{} | backend={} adapter={} uiAccess={} elevated={} jab={}", dscu_core::engine::VERSION, pipe, pi.name, pi.adapter, pi.ui_access, pi.elevated, pi.jab);

    if a.selftest {
        for req in [
            r#"{"v":1,"id":1,"method":"driver.info","params":{}}"#,
            r#"{"v":1,"id":2,"method":"capture.bench","params":{"n":60,"w":1920,"h":1080}}"#,
            r#"{"v":1,"id":3,"method":"window.list","params":{}}"#,
        ] {
            let mut v: serde_json::Value = serde_json::from_str(req).unwrap();
            if let Some(t) = &token {
                v["auth"] = serde_json::json!(t);
            }
            println!("{}", engine.handle_line(&v.to_string()));
        }
        return;
    }

    let eng_tick = engine.clone();
    tokio::spawn(async move {
        loop {
            tokio::time::sleep(std::time::Duration::from_secs(1)).await;
            let e = eng_tick.clone();
            let _ = tokio::task::spawn_blocking(move || e.tick()).await;
            if eng_tick.shutdown.load(Ordering::SeqCst) {
                tokio::time::sleep(std::time::Duration::from_millis(300)).await;
                std::process::exit(0);
            }
        }
    });

    if a.stdio {
        serve_stream(tokio::io::stdin(), tokio::io::stdout(), engine).await;
        return;
    }

    #[cfg(windows)]
    {
        if let Some(pid) = a.parent_pid {
            winpipe::watch_parent(pid, engine.clone());
        }
        let sa = if a.open_acl { None } else { winpipe::make_sa().map(Arc::new) };
        if sa.is_none() && !a.open_acl {
            eprintln!("dscu-driver: warning: could not build the user-only pipe DACL; using default ACL + token auth");
        }
        let mut tasks = vec![tokio::spawn(winpipe::serve(pipe.clone(), engine.clone(), sa.clone()))];
        if let Some(al) = alias {
            tasks.push(tokio::spawn(winpipe::serve(al, engine.clone(), sa.clone())));
        }
        for t in tasks {
            if let Ok(Err(e)) = t.await {
                eprintln!("dscu-driver: pipe server stopped: {e} (is another dscu-driver already running?)");
                std::process::exit(3);
            }
        }
    }
    #[cfg(not(windows))]
    {
        let _ = alias;
        eprintln!("named pipes are Windows-only; use --stdio");
    }
}
