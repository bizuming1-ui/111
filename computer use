"""
v16.4 independent oracles for the three new strongly-typed goals (AppWindowGoal / FormFieldGoal / MessageSendGoal).

Every oracle reads an INDEPENDENT source (Win32 window manager, psutil, a fresh UIA observe, a live CDP form probe) — never the model's summary.
A check whose source cannot be read is returned with evaluated=False (=> coverage can never become `full`).  Returned rows are plain dicts so this module has
no import cycle with verifier.py:  {name, ok, detail, kind, evaluated, source}.
"""
from __future__ import annotations

import re
import unicodedata
from typing import Any, Optional

from .procnames import process_names_for
from .skills import message_send as ms

UIA_MIN_ELEMENTS = 3
APP_RX = re.compile(r"^\s*(?:请|帮我|帮忙|麻烦)?\s*(?:你)?(?:打开|启动|运行|开启|open|launch|start)\s*(?:一下)?\s*(?:我的)?(?P<app>[^，,。；;！!\s]{1,24}?)\s*(?:应用|软件|程序|客户端|app|窗口)?\s*[。.!！]?\s*$", re.I)
NOT_APP = re.compile(r"网站|网页|网址|http|www\.|\.com|文件夹|文件|目录|回收站|桌面$|设置$|新建|保存", re.I)
FORM_RX = re.compile(r"(?:输入|填入|填写|键入|填上)\s*(?:一下)?\s*(?:我的|我)?\s*(?P<field>手机号码|手机号|手机|电话号码|电话|邮箱地址|邮箱|电子邮件|验证码|用户名|账号|账户|姓名|名字|昵称|地址|金额|搜索词)?\s*(?:是|为|:|：)?\s*(?P<val>[^\s，,。；;]{1,80})", re.I)
PHONE_RX = re.compile(r"(?<!\d)(?:\+?86[- ]?)?(1[3-9]\d[- ]?\d{4}[- ]?\d{4})(?!\d)")
EMAIL_RX = re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+")
FIELD_KIND = {"手机号码": "phone", "手机号": "phone", "手机": "phone", "电话号码": "phone", "电话": "phone", "邮箱地址": "email", "邮箱": "email", "电子邮件": "email",
              "验证码": "code", "用户名": "username", "账号": "username", "账户": "username", "姓名": "name", "名字": "name", "昵称": "name", "地址": "address", "金额": "amount", "搜索词": "search"}
KIND_KEYWORDS = {"phone": ("手机", "电话", "phone", "tel", "mobile", "cell", "号码"), "email": ("邮箱", "邮件", "email", "mail"), "code": ("验证码", "code", "otp", "captcha", "verify"),
                 "username": ("用户", "账号", "账户", "user", "account", "login"), "name": ("姓名", "名字", "昵称", "name"), "address": ("地址", "address"), "amount": ("金额", "amount", "price"),
                 "search": ("搜索", "search", "query", "q")}
SECRET_RX = re.compile(r"密码|password|passwd|口令|cvv|银行卡|信用卡|身份证", re.I)


def derive_app_goal(task: str) -> Optional[dict[str, Any]]:
    if NOT_APP.search(task) or ms.is_message_task(task):
        return None
    m = APP_RX.match(task)
    if not m:
        return None
    app = m.group("app").strip()
    if not app or len(app) < 1:
        return None
    return {"query": app, "process_names": tuple(process_names_for(app))}


def normalize_value(kind: str, s: str) -> str:
    s = unicodedata.normalize("NFKC", s or "")
    s = re.sub(r"[\u200b\u200c\u200d\ufeff]", "", s)
    if kind == "phone":
        d = re.sub(r"\D", "", s)
        if len(d) > 11 and d.startswith("0086"):
            d = d[4:]
        if len(d) > 11 and d.startswith("86"):
            d = d[2:]
        return d
    if kind == "email":
        return s.strip().lower()
    if kind in ("code", "amount"):
        return re.sub(r"[\s,]", "", s)
    return re.sub(r"\s+", " ", s).strip()


def derive_form_goal(task: str) -> Optional[dict[str, Any]]:
    """`输入我的手机号码13226113973` -> {kind: phone, hint: 手机号码, expected: 13226113973}.  Secrets (passwords / card numbers) are never auto-verified."""
    if SECRET_RX.search(task) or ms.is_message_task(task):
        return None
    m = FORM_RX.search(task)
    if not m:
        return None
    fld = (m.group("field") or "").strip()
    val = (m.group("val") or "").strip()
    kind = FIELD_KIND.get(fld, "")
    pm = PHONE_RX.search(task)
    em = EMAIL_RX.search(task)
    if kind == "phone" or (not kind and pm and not em):
        if pm:
            return {"kind": "phone", "hint": fld or "手机号", "expected": normalize_value("phone", pm.group(1))}
    if kind == "email" or (not kind and em):
        if em:
            return {"kind": "email", "hint": fld or "邮箱", "expected": normalize_value("email", em.group(0))}
    if not val or len(val) < 1 or val in ("内容", "文字", "文本", "一下"):
        return None
    return {"kind": kind or "text", "hint": fld, "expected": normalize_value(kind or "text", val)}


def row(name: str, ok: bool, detail: str, kind: str, evaluated: bool = True, source: str = "") -> dict[str, Any]:
    return {"name": name, "ok": ok, "detail": detail, "kind": kind, "evaluated": evaluated, "source": source}


def _unavailable(names: tuple, kind: str, why: str) -> list[dict[str, Any]]:
    return [row(n, True, f"未能由独立数据源评估：{why}", kind, evaluated=False, source="unavailable") for n in names]


async def _uia_elements(ver: Any, hwnd: int, n: int = 80) -> Optional[list]:
    try:
        o = await ver.hub.drv_observe(channel="uia", hwnd=int(hwnd), max_elements=n)
        return list(o.elements or [])
    except Exception:  # noqa: BLE001
        return None


# --------------------------------------------------------------------------------------------------------- AppWindowGoal
APP_POST = ("app_process_running", "app_window_visible", "app_window_foreground", "app_uia_loaded")


def _proc_running(names: tuple) -> Optional[bool]:
    try:
        import psutil

        want = {n.lower() for n in names}
        return any(str(p.info.get("name") or "").lower() in want for p in psutil.process_iter(["name"]))
    except Exception:  # noqa: BLE001
        return None


async def check_app_window(ver: Any, query: str, names: tuple, title_hint: str = "") -> list[dict[str, Any]]:
    wm = getattr(ver, "wm", None)
    if wm is None:
        return _unavailable(APP_POST, "window", "WindowManager 不可用（非 Windows 或初始化失败）")
    wins = wm.windows()
    cands = wm.find_by_process(names, title_hint or query, wins) if names else []
    if not cands:  # unknown process name -> title match
        q = query.lower()
        cands = [w for w in wins if q and q in w.title.lower() and not w.own_console]
    run = _proc_running(names) if names else None
    out = [row("app_process_running", bool(cands) or bool(run), f"进程 {','.join(names) or '?'} " + (f"运行中={run}" if run is not None else "psutil 不可用") + f" · 窗口 {len(cands)} 个", "window", source="psutil+win32_enum")]
    main = next((w for w in cands if not w.minimized and w.rect[2] >= 200 and w.rect[3] >= 120), None)
    out.append(row("app_window_visible", main is not None, (f"主窗口 {main.label()} 尺寸 {main.rect[2]}x{main.rect[3]}" if main else "没有可见的主窗口（可能最小化/托盘/云窗口）"), "window", source="win32_enum"))
    if main is None:
        out.append(row("app_window_foreground", False, "无主窗口可核对前台", "window", source="win32_foreground"))
        out.append(row("app_uia_loaded", False, "无主窗口可读取 UIA", "window", source="uia"))
        return out
    fg_root = wm.root_of(wm.be.foreground())
    fgw = wm.get(fg_root, wins)
    fg_ok = fg_root == main.hwnd or bool(fgw and fgw.pid == main.pid)
    out.append(row("app_window_foreground", fg_ok, f"前台 hwnd={fg_root}（{fgw.label() if fgw else '?'}）{'==' if fg_ok else '≠'} 主窗口 hwnd={main.hwnd}", "window", source="win32_foreground"))
    els = await _uia_elements(ver, main.hwnd)
    if els is None:
        out.append(row("app_uia_loaded", True, "UIA 读取失败（未评估）", "window", evaluated=False, source="uia"))
    else:
        named = [e for e in els if str(getattr(e, "name", "") or getattr(e, "value", "")).strip()]
        if len(els) >= UIA_MIN_ELEMENTS and named:
            out.append(row("app_uia_loaded", True, f"UIA 控件 {len(els)} 个（命名 {len(named)}）≥ {UIA_MIN_ELEMENTS}：{'、'.join(str(getattr(e, 'name', ''))[:8] for e in named[:5])}", "window", source="uia"))
        else:  # UIA-poor app (Qt/Electron/custom): degrade explicitly to Win32 structure evidence, never silently
            struct = bool(main.title) and main.rect[2] >= 400 and main.rect[3] >= 300 and not main.cloaked
            out.append(row("app_uia_loaded", struct, f"UIA 仅 {len(els)} 个控件（应用未暴露无障碍树）→ 降级为 Win32 结构证据：标题={main.title[:12]!r} 尺寸={main.rect[2]}x{main.rect[3]}", "window", source="win32_structure(degraded)"))
    return out


# --------------------------------------------------------------------------------------------------------- FormFieldGoal
FORM_POST = ("form_target_identity", "form_field_semantic", "form_readback_equal")


def _semantic_match(kind: str, hint: str, field: dict[str, Any]) -> tuple[bool, str]:
    blob = " ".join(str(field.get(k, "")) for k in ("placeholder", "name", "id", "aria", "label", "autocomplete", "near", "type")).lower()
    kws = list(KIND_KEYWORDS.get(kind, ())) + ([hint.lower()] if hint else [])
    if kind == "phone" and str(field.get("type", "")).lower() == "tel":
        return True, "type=tel"
    for k in kws:
        if k and k in blob:
            return True, f"属性含「{k}」"
    return (not kws), ("无语义要求" if not kws else f"输入框属性无「{'/'.join(kws[:4])}」: {blob[:50]!r}")


async def check_form_field(ver: Any, kind: str, hint: str, expected: str, st: Any = None, obs: Any = None) -> list[dict[str, Any]]:
    wm = getattr(ver, "wm", None)
    out: list[dict[str, Any]] = []
    fgw = None
    if wm is not None:
        wins = wm.windows()
        fgw = wm.get(wm.root_of(wm.be.foreground()), wins)
    pr = await ver.probe_cdp([]) if getattr(ver.hub, "cdp_up", False) else None
    fields: list[dict[str, Any]] = []
    src = ""
    ident = ""
    ident_ok = False
    if isinstance(pr, dict) and "error" not in pr:
        try:  # richer than the legacy probe: placeholders / labels / active element
            r = await ver.hub.cdp_action({"action": "form_probe", "action_id": f"form-{id(obs)}"})
            if r.ok and isinstance(r.effect.get("inputs"), list):
                fields = [f for f in r.effect["inputs"] if isinstance(f, dict)]
                pr = {**pr, **{k: r.effect.get(k) for k in ("url", "title") if r.effect.get(k)}}
        except Exception:  # noqa: BLE001
            pass
        if not fields and isinstance(pr.get("inputs"), list):
            fields = [{"value": v, "visible": True} for v in pr["inputs"]]
        url, title = str(pr.get("url", "")), str(pr.get("title", ""))
        bad = url.startswith(("chrome-error://", "about:blank", "edge-error://")) or not url
        fg_bad = bool(fgw and fgw.own_console)
        ident_ok = not bad and not fg_bad
        ident = f"页面 {url[:60]}「{title[:20]}」前台={fgw.label() if fgw else '?'}"
        src = "cdp_form_probe"
    elif fgw is not None and not fgw.own_console:
        els = await _uia_elements(ver, fgw.hwnd, 120)
        if els is None and obs is not None:
            els = list(getattr(obs, "elements", []) or [])
        if els is not None:
            fields = [{"value": str(getattr(e, "value", "") or ""), "label": str(getattr(e, "name", "")), "aria": str(getattr(e, "name", "")), "visible": True, "type": str(getattr(e, "role", ""))}
                      for e in els if str(getattr(e, "role", "")).lower() in ("edit", "textbox", "document", "combobox", "input")]
            src = "uia_value"
            ident_ok = True
            ident = f"窗口 {fgw.label()}"
    if not src:
        return _unavailable(FORM_POST, "form", "既没有可用的浏览器 CDP 探针，也没有可读的前台 UIA 输入框")
    out.append(row("form_target_identity", ident_ok, ident or "目标身份不明", "form", source=src))
    hit = [f for f in fields if normalize_value(kind, str(f.get("value", ""))) == expected and expected]
    out.append(row("form_readback_equal", bool(hit), (f"读回值 {hit[0].get('value')!r} →归一化 {normalize_value(kind, str(hit[0].get('value', '')))!r} == 期望 {expected!r}" if hit
                                                      else f"没有任何输入框读回为 {expected!r}（现有值: {[str(f.get('value', ''))[:16] for f in fields if f.get('value')][:5]}）"), "form", source=src))
    if hit:
        ok, why = _semantic_match(kind, hint, hit[0])
        out.append(row("form_field_semantic", ok, f"输入框语义 {why}", "form", source=src))
    else:
        out.append(row("form_field_semantic", False, "未找到值匹配的输入框，无法判定语义", "form", source=src))
    return out


# --------------------------------------------------------------------------------------------------------- MessageSendGoal
MSG_POST = ("msg_intent_complete", "msg_recipient_frozen", "msg_single_chat_window", "msg_draft_readback", "msg_hitl_confirmed", "msg_bubble_verified")


async def check_message_send(ver: Any, recipient: str, body: str, st: Any = None, obs: Any = None) -> list[dict[str, Any]]:
    sess: Optional[ms.MessageSession] = getattr(st, "msg_session", None)
    out = [row("msg_intent_complete", bool(recipient.strip() and body.strip()), f"recipient={recipient!r} body={'有' if body.strip() else '缺失'}（缺失即 NEEDS_CLARIFICATION，严禁脑补）", "message", source="task_text")]
    if sess is None:
        for n in MSG_POST[1:]:
            out.append(row(n, False, "没有发送会话证据（未经过 MessageSend 门控，不可能发生合规发送）", "message", source="message_gate"))
        return out
    out.append(row("msg_recipient_frozen", sess.contact_frozen, sess.contact_evidence or "联系人未冻结", "message", source="dml+ocr/uia" if "OCR" in (sess.contact_evidence or "") else "uia/window_title"))
    out.append(row("msg_single_chat_window", sess.single_chat, sess.single_chat_evidence or "未确认单聊窗口", "message", source="uia/window_title"))
    out.append(row("msg_draft_readback", sess.draft_ok, f"读回={sess.draft_readback[:30]!r} 来源={sess.draft_source or '无'}", "message", source=sess.draft_source or "none"))
    out.append(row("msg_hitl_confirmed", sess.hitl_confirmed, "发送前人工确认" + ("已通过" if sess.hitl_confirmed else "未通过"), "message", source="hitl"))
    wm = getattr(ver, "wm", None)
    els = None
    if sess.chat_hwnd:
        els = await _uia_elements(ver, sess.chat_hwnd, 200)
    if els is None and obs is not None:
        els = list(getattr(obs, "elements", []) or [])
    if getattr(sess, "bubble_verified", False):  # v17.1: WeChatSkill proof (DirectML boxes + OCR, right half of the chat, before/after count)
        out.append(row("msg_bubble_verified", True, sess.bubble_evidence[:200], "message", source=sess.bubble_source or "dml+ocr"))
    elif not sess.send_issued:
        out.append(row("msg_bubble_verified", False, "发送动作从未执行", "message", source="message_gate"))
    elif not els:
        out.append(row("msg_bubble_verified", True, "聊天窗口 UIA 不可读（微信 Qt 窗口可能未暴露消息列表）→ 无法独立核验气泡", "message", evaluated=False, source="uia"))
    else:
        found = sess.bubble_present(els)
        out.append(row("msg_bubble_verified", found, f"聊天记录中{'找到' if found else '未找到'}正文气泡「{body[:20]}」（UIA 元素 {len(els)} 个）", "message", source="uia"))
    _ = wm
    return out
