async def run_stale_epoch(h: Harness, rounds: int) -> dict[str, Any]:
    refused = clicked = 0
    for r in range(rounds):
        assert h.eng
        o1 = await h.eng.observe({"id": f"s{r}a", "max_elements": 60})
        old = next((e["ref_id"] for e in o1["elements"] if e["role"] in ("button", "link", "checkbox")), None)
        await h.eng.observe({"id": f"s{r}b", "max_elements": 60})  # epoch advances -> `old` is stale
        sent: list[str] = []
        cl = h.eng.client
        assert cl
        orig = cl.call_tool

        async def spy(name: str, args: dict[str, Any], timeout: float = 60.0) -> Any:
            sent.append(name)
            return await orig(name, args, timeout)

        cl.call_tool = spy  # type: ignore[method-assign]
        try:
            res = await h.eng.action({"action": "click", "ref": old, "action_id": f"st{r}-{time.time_ns()}"})
        finally:
            cl.call_tool = orig  # type: ignore[method-assign]
        if res.get("code") == "STALE_EPOCH" and not res.get("ok"):
            refused += 1
        if any(n in ("click", "dblclick", "fill", "hover", "drag", "upload_file", "click_at") for n in sent):  # a stale ref must never reach the browser
            clicked += 1
    return {"rounds": rounds, "refused_stale_epoch": refused, "rate": round(refused / rounds, 4), "stale_clicks_executed": clicked}


