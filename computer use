//! Physical input (SendInput) with a Fitts'-law motion model + JobObject process-tree lock.
//! Unicode text goes through KEYEVENTF_UNICODE (IME-independent, safe for Chinese); chords use scan-accurate VKs.
use std::ffi::c_void;
use std::sync::atomic::{AtomicU64, Ordering};
use std::time::Duration;
use windows::core::PCWSTR;
use windows::Win32::Foundation::*;
use windows::Win32::System::JobObjects::*;
use windows::Win32::System::Threading::GetCurrentProcess;
use windows::Win32::UI::Input::KeyboardAndMouse::*;
use windows::Win32::UI::WindowsAndMessaging::*;

static RNG: AtomicU64 = AtomicU64::new(0x9E3779B97F4A7C15);
fn rnd() -> f64 {
    let mut x = RNG.load(Ordering::Relaxed) ^ crate::sys::now_ms().wrapping_mul(0x2545F4914F6CDD1D);
    x ^= x << 13;
    x ^= x >> 7;
    x ^= x << 17;
    RNG.store(x, Ordering::Relaxed);
    (x >> 11) as f64 / (1u64 << 53) as f64
}

fn send(inputs: &[INPUT]) -> Result<(), String> {
    let n = unsafe { SendInput(inputs, std::mem::size_of::<INPUT>() as i32) };
    if (n as usize) != inputs.len() {
        // SendInput returns 0 when blocked by UIPI (target is higher integrity and we have no uiAccess)
        return Err("UIPI_DENIED".into());
    }
    Ok(())
}

fn mouse_input(dx: i32, dy: i32, data: i32, flags: MOUSE_EVENT_FLAGS) -> INPUT {
    INPUT { r#type: INPUT_MOUSE, Anonymous: INPUT_0 { mi: MOUSEINPUT { dx, dy, mouseData: data as u32, dwFlags: flags, time: 0, dwExtraInfo: 0 } } }
}

fn abs_coords(x: i32, y: i32) -> (i32, i32) {
    unsafe {
        let (vx, vy) = (GetSystemMetrics(SM_XVIRTUALSCREEN), GetSystemMetrics(SM_YVIRTUALSCREEN));
        let (vw, vh) = (GetSystemMetrics(SM_CXVIRTUALSCREEN).max(1), GetSystemMetrics(SM_CYVIRTUALSCREEN).max(1));
        ((((x - vx) as i64 * 65535) / vw as i64) as i32, (((y - vy) as i64 * 65535) / vh as i64) as i32)
    }
}

pub fn cursor_pos() -> (i32, i32) {
    let mut p = POINT::default();
    unsafe {
        let _ = GetCursorPos(&mut p);
    }
    (p.x, p.y)
}

fn move_abs(x: i32, y: i32) -> Result<(), String> {
    let (ax, ay) = abs_coords(x, y);
    send(&[mouse_input(ax, ay, 0, MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK)])
}

/// Fitts' law movement time: MT = a + b*log2(D/W + 1)  (a=50ms, b=120ms/bit), clamped, scaled by `speed` (1.0 = human).
pub fn fitts_ms(dist: f64, width: f64, speed: f64) -> f64 {
    let mt = 50.0 + 120.0 * (dist / width.max(8.0) + 1.0).log2();
    (mt / speed.max(0.05)).clamp(15.0, 900.0)
}

/// Minimum-jerk quadratic-Bezier path from the current cursor to (x,y); `target_w` is the target width in px.
pub fn move_to(x: i32, y: i32, target_w: f64, speed: f64) -> Result<f64, String> {
    let (sx, sy) = cursor_pos();
    let (dx, dy) = ((x - sx) as f64, (y - sy) as f64);
    let dist = (dx * dx + dy * dy).sqrt();
    if dist < 2.0 {
        return Ok(0.0);
    }
    let total = fitts_ms(dist, target_w, speed);
    let steps = ((total / 8.0).round() as i32).max(2);
    let (nx, ny) = (-dy / dist, dx / dist);
    let bend = (rnd() - 0.5) * 0.18 * dist;
    let (cx, cy) = (sx as f64 + dx * 0.5 + nx * bend, sy as f64 + dy * 0.5 + ny * bend);
    for i in 1..=steps {
        let t = i as f64 / steps as f64;
        let e = t * t * t * (10.0 - 15.0 * t + 6.0 * t * t);
        let u = 1.0 - e;
        let px = u * u * sx as f64 + 2.0 * u * e * cx + e * e * x as f64;
        let py = u * u * sy as f64 + 2.0 * u * e * cy + e * e * y as f64;
        move_abs(px.round() as i32, py.round() as i32)?;
        std::thread::sleep(Duration::from_micros((total * 1000.0 / steps as f64) as u64));
    }
    move_abs(x, y)?;
    Ok(total)
}

pub fn click(x: i32, y: i32, button: &str, count: u32, target_w: f64, speed: f64) -> Result<f64, String> {
    let ms = move_to(x, y, target_w, speed)?;
    let (down, up) = match button {
        "right" => (MOUSEEVENTF_RIGHTDOWN, MOUSEEVENTF_RIGHTUP),
        "middle" => (MOUSEEVENTF_MIDDLEDOWN, MOUSEEVENTF_MIDDLEUP),
        _ => (MOUSEEVENTF_LEFTDOWN, MOUSEEVENTF_LEFTUP),
    };
    std::thread::sleep(Duration::from_millis((30.0 + rnd() * 40.0) as u64));
    for _ in 0..count.max(1) {
        send(&[mouse_input(0, 0, 0, down)])?;
        std::thread::sleep(Duration::from_millis((35.0 + rnd() * 35.0) as u64));
        send(&[mouse_input(0, 0, 0, up)])?;
        std::thread::sleep(Duration::from_millis(60));
    }
    Ok(ms)
}

pub fn scroll(dy_notches: i32) -> Result<(), String> {
    send(&[mouse_input(0, 0, dy_notches * 120, MOUSEEVENTF_WHEEL)])
}

fn key_input(vk: u16, scan: u16, flags: KEYBD_EVENT_FLAGS) -> INPUT {
    INPUT { r#type: INPUT_KEYBOARD, Anonymous: INPUT_0 { ki: KEYBDINPUT { wVk: VIRTUAL_KEY(vk), wScan: scan, dwFlags: flags, time: 0, dwExtraInfo: 0 } } }
}

pub fn type_text(text: &str, per_char_ms: u64) -> Result<usize, String> {
    let mut n = 0usize;
    for u in text.encode_utf16() {
        if u == 10 {
            tap_vk(0x0D, false)?;
        } else if u == 13 {
            continue;
        } else {
            send(&[key_input(0, u, KEYEVENTF_UNICODE), key_input(0, u, KEYEVENTF_UNICODE | KEYEVENTF_KEYUP)])?;
        }
        n += 1;
        if per_char_ms > 0 {
            std::thread::sleep(Duration::from_millis(per_char_ms + (rnd() * per_char_ms as f64 * 0.5) as u64));
        }
    }
    Ok(n)
}

fn is_extended(vk: u16) -> bool {
    matches!(vk, 0x21..=0x28 | 0x2D | 0x2E | 0x5B | 0x5C | 0x6F | 0x90 | 0xA3 | 0xA5)
}

fn scan_of(vk: u16) -> u16 {
    unsafe { MapVirtualKeyW(vk as u32, MAPVK_VK_TO_VSC) as u16 }
}

fn tap_vk(vk: u16, ext: bool) -> Result<(), String> {
    let f = if ext || is_extended(vk) { KEYEVENTF_EXTENDEDKEY } else { KEYBD_EVENT_FLAGS(0) };
    send(&[key_input(vk, scan_of(vk), f), key_input(vk, scan_of(vk), f | KEYEVENTF_KEYUP)])
}

pub fn vk_for(name: &str) -> Option<u16> {
    let n = name.trim().to_lowercase();
    let v = match n.as_str() {
        "ctrl" | "control" | "ctl" => 0x11,
        "alt" | "option" | "menu" => 0x12,
        "shift" => 0x10,
        "win" | "windows" | "cmd" | "super" | "meta" => 0x5B,
        "enter" | "return" => 0x0D,
        "tab" => 0x09,
        "esc" | "escape" => 0x1B,
        "space" | "spacebar" => 0x20,
        "backspace" | "bksp" => 0x08,
        "delete" | "del" => 0x2E,
        "insert" | "ins" => 0x2D,
        "home" => 0x24,
        "end" => 0x23,
        "pageup" | "pgup" => 0x21,
        "pagedown" | "pgdn" | "pgdown" => 0x22,
        "left" => 0x25,
        "up" => 0x26,
        "right" => 0x27,
        "down" => 0x28,
        "capslock" => 0x14,
        "printscreen" | "prtsc" => 0x2C,
        "-" | "minus" => 0xBD,
        "=" | "plus" | "equals" => 0xBB,
        "," => 0xBC,
        "." => 0xBE,
        "/" => 0xBF,
        ";" => 0xBA,
        _ => {
            if n.len() == 1 {
                let c = n.as_bytes()[0];
                if c.is_ascii_alphabetic() {
                    return Some(c.to_ascii_uppercase() as u16);
                }
                if c.is_ascii_digit() {
                    return Some(c as u16);
                }
            }
            if let Some(rest) = n.strip_prefix('f') {
                if let Ok(k) = rest.parse::<u16>() {
                    if (1..=24).contains(&k) {
                        return Some(0x70 + k - 1);
                    }
                }
            }
            return None;
        }
    };
    Some(v)
}

/// "ctrl+shift+s" or a sequence "tab tab enter" / "ctrl+a ctrl+c".
pub fn press_keys(spec: &str) -> Result<usize, String> {
    let mut count = 0;
    for chord in spec.split_whitespace() {
        let parts: Vec<&str> = chord.split('+').filter(|s| !s.is_empty()).collect();
        if parts.is_empty() {
            continue;
        }
        let mut vks = vec![];
        for p in &parts {
            vks.push(vk_for(p).ok_or_else(|| format!("UNKNOWN_KEY:{p}"))?);
        }
        let (mods, key) = vks.split_at(vks.len() - 1);
        for m in mods {
            send(&[key_input(*m, scan_of(*m), if is_extended(*m) { KEYEVENTF_EXTENDEDKEY } else { KEYBD_EVENT_FLAGS(0) })])?;
        }
        tap_vk(key[0], false)?;
        for m in mods.iter().rev() {
            let f = if is_extended(*m) { KEYEVENTF_EXTENDEDKEY } else { KEYBD_EVENT_FLAGS(0) };
            send(&[key_input(*m, scan_of(*m), f | KEYEVENTF_KEYUP)])?;
        }
        count += 1;
        std::thread::sleep(Duration::from_millis(25));
    }
    Ok(count)
}

pub fn focus_window(h: HWND) -> Result<(), String> {
    unsafe {
        if IsIconic(h).as_bool() {
            let _ = ShowWindow(h, SW_RESTORE);
        }
        // The Alt-tap trick lifts the foreground lock so SetForegroundWindow is honoured.
        let _ = send(&[key_input(0x12, 0, KEYBD_EVENT_FLAGS(0)), key_input(0x12, 0, KEYEVENTF_KEYUP)]);
        let _ = SetForegroundWindow(h);
        for _ in 0..10 {
            if GetForegroundWindow() == h {
                return Ok(());
            }
            std::thread::sleep(Duration::from_millis(30));
        }
    }
    Err("FOCUS_NOT_GRANTED".into())
}

// ---------------------------------------------------------------------------------------------------------------------
// JobObject process-tree lock
// ---------------------------------------------------------------------------------------------------------------------
pub struct JobGuard {
    job: HANDLE,
}
unsafe impl Send for JobGuard {}
unsafe impl Sync for JobGuard {}

impl JobGuard {
    pub fn create(mem_limit_mb: usize) -> Result<JobGuard, String> {
        unsafe {
            let job = CreateJobObjectW(None, PCWSTR::null()).map_err(|e| format!("CreateJobObject:{e}"))?;
            let mut info = JOBOBJECT_EXTENDED_LIMIT_INFORMATION::default();
            info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE | JOB_OBJECT_LIMIT_PROCESS_MEMORY;
            info.ProcessMemoryLimit = mem_limit_mb * 1048576;
            SetInformationJobObject(job, JobObjectExtendedLimitInformation, &info as *const _ as *const c_void, std::mem::size_of::<JOBOBJECT_EXTENDED_LIMIT_INFORMATION>() as u32)
                .map_err(|e| format!("SetInformationJobObject:{e}"))?;
            Ok(JobGuard { job })
        }
    }
    pub fn assign(&self, process: HANDLE) -> Result<(), String> {
        unsafe { AssignProcessToJobObject(self.job, process).map_err(|e| format!("AssignProcessToJobObject:{e}")) }
    }
    #[allow(dead_code)]
    pub fn assign_self(&self) -> Result<(), String> {
        self.assign(unsafe { GetCurrentProcess() })
    }
}
