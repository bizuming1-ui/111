//! Shared-memory frame ring v2 (single producer / multiple consumers, lock-free seqlock slots).
//! Layout is shared with C++ (`proto/ring_layout.h`), C# (`DsV9Ring`), TypeScript and Python (`schema/ring-v2.json`).
//!
//! header (64 B): magic u32 | version u32 | slot_count u32 | slot_size u32 | write_seq u64 | ack_seq u64 | pid u32 | flags u32
//! slot   (64 B header + slot_size payload): seq u64 | w u32 | h u32 | stride u32 | fmt u32 | len u32 | kind u32 |
//!        x i32 | y i32 | rw i32 | rh i32 | ahash u64 | ts_us u64      (seq = n<<1 | 1 while writing, n<<1 when committed)
use std::sync::atomic::{fence, AtomicU64, Ordering};

pub const MAGIC: u32 = 0x3252_5344; // bytes 'D' 'S' 'R' '2'
pub const VERSION: u32 = 2;
pub const HDR: usize = 64;
pub const SLOT_HDR: usize = 64;
pub const FMT_BGRA8: u32 = 1;
pub const FMT_GRAY8: u32 = 2;
pub const FMT_SIG48X32: u32 = 3;
pub const KIND_FULL: u32 = 1;
pub const KIND_DIRTY: u32 = 2;
pub const KIND_SIG: u32 = 3;

#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
pub struct FrameMeta {
    pub width: u32,
    pub height: u32,
    pub stride: u32,
    pub format: u32,
    pub kind: u32,
    pub x: i32,
    pub y: i32,
    pub w: i32,
    pub h: i32,
    pub ahash: u64,
    pub ts_us: u64,
}

#[derive(Debug, PartialEq, Eq)]
pub enum RingErr {
    BadMagic,
    BadVersion(u32),
    BadGeometry,
    TooLarge { need: usize, cap: usize },
    Torn,
}

pub fn region_size(slots: u32, slot_size: u32) -> usize {
    HDR + slots as usize * (SLOT_HDR + slot_size as usize)
}

#[derive(Debug, PartialEq, Eq)]
pub struct Read {
    pub seq: u64,
    pub skipped: u64,
    pub meta: FrameMeta,
}

pub struct RingView {
    base: *mut u8,
    slots: u32,
    slot_size: u32,
}
unsafe impl Send for RingView {}
unsafe impl Sync for RingView {}

impl RingView {
    /// # Safety
    /// `base` must point to `region_size(slots, slot_size)` writable bytes, 8-byte aligned, alive for the view's lifetime.
    pub unsafe fn init(base: *mut u8, slots: u32, slot_size: u32, pid: u32) -> Result<RingView, RingErr> {
        if !(2..=64).contains(&slots) || !slots.is_power_of_two() || slot_size == 0 || slot_size % 8 != 0 {
            return Err(RingErr::BadGeometry);
        }
        std::ptr::write_bytes(base, 0, region_size(slots, slot_size));
        let v = RingView { base, slots, slot_size };
        v.w32(0, MAGIC);
        v.w32(4, VERSION);
        v.w32(8, slots);
        v.w32(12, slot_size);
        v.w32(32, pid);
        v.w32(36, 1);
        Ok(v)
    }
    /// # Safety
    /// `base` must point to a region of at least `len` bytes previously initialised by a producer.
    pub unsafe fn attach(base: *mut u8, len: usize) -> Result<RingView, RingErr> {
        if len < HDR {
            return Err(RingErr::BadGeometry);
        }
        let tmp = RingView { base, slots: 0, slot_size: 0 };
        if tmp.r32(0) != MAGIC {
            return Err(RingErr::BadMagic);
        }
        if tmp.r32(4) != VERSION {
            return Err(RingErr::BadVersion(tmp.r32(4)));
        }
        let (slots, slot_size) = (tmp.r32(8), tmp.r32(12));
        if !(2..=64).contains(&slots) || !slots.is_power_of_two() || slot_size == 0 || region_size(slots, slot_size) > len {
            return Err(RingErr::BadGeometry);
        }
        Ok(RingView { base, slots, slot_size })
    }

    fn w32(&self, off: usize, v: u32) { unsafe { (self.base.add(off) as *mut u32).write_unaligned(v) } }
    fn r32(&self, off: usize) -> u32 { unsafe { (self.base.add(off) as *const u32).read_unaligned() } }
    fn atom(&self, off: usize) -> &AtomicU64 { unsafe { AtomicU64::from_ptr(self.base.add(off) as *mut u64) } }
    fn slot_off(&self, n: u64) -> usize { HDR + (n % self.slots as u64) as usize * (SLOT_HDR + self.slot_size as usize) }

    pub fn slots(&self) -> u32 { self.slots }
    pub fn slot_size(&self) -> u32 { self.slot_size }
    pub fn write_seq(&self) -> u64 { self.atom(16).load(Ordering::Acquire) }
    pub fn ack(&self, seq: u64) { self.atom(24).fetch_max(seq, Ordering::AcqRel); }
    pub fn acked(&self) -> u64 { self.atom(24).load(Ordering::Acquire) }

    /// Producer: publish one frame. Returns the committed sequence number (starts at 1).
    pub fn publish(&self, m: &FrameMeta, payload: &[u8]) -> Result<u64, RingErr> {
        if payload.len() > self.slot_size as usize {
            return Err(RingErr::TooLarge { need: payload.len(), cap: self.slot_size as usize });
        }
        let n = self.write_seq() + 1;
        let so = self.slot_off(n);
        let seq = self.atom(so);
        seq.store((n << 1) | 1, Ordering::Relaxed);
        fence(Ordering::Release);
        unsafe {
            let p = self.base.add(so);
            (p.add(8) as *mut u32).write_unaligned(m.width);
            (p.add(12) as *mut u32).write_unaligned(m.height);
            (p.add(16) as *mut u32).write_unaligned(m.stride);
            (p.add(20) as *mut u32).write_unaligned(m.format);
            (p.add(24) as *mut u32).write_unaligned(payload.len() as u32);
            (p.add(28) as *mut u32).write_unaligned(m.kind);
            (p.add(32) as *mut i32).write_unaligned(m.x);
            (p.add(36) as *mut i32).write_unaligned(m.y);
            (p.add(40) as *mut i32).write_unaligned(m.w);
            (p.add(44) as *mut i32).write_unaligned(m.h);
            (p.add(48) as *mut u64).write_unaligned(m.ahash);
            (p.add(56) as *mut u64).write_unaligned(m.ts_us);
            std::ptr::copy_nonoverlapping(payload.as_ptr(), p.add(SLOT_HDR), payload.len());
        }
        seq.store(n << 1, Ordering::Release);
        self.atom(16).store(n, Ordering::Release);
        Ok(n)
    }

    /// Consumer: copy the newest frame newer than `last_seen` into `out`. `Ok(None)` = nothing new.
    pub fn read_latest(&self, last_seen: u64, out: &mut Vec<u8>) -> Result<Option<Read>, RingErr> {
        for _ in 0..8 {
            let n = self.write_seq();
            if n == 0 || n <= last_seen {
                return Ok(None);
            }
            let so = self.slot_off(n);
            let seq = self.atom(so);
            let s1 = seq.load(Ordering::Acquire);
            if s1 != n << 1 {
                std::hint::spin_loop();
                continue;
            }
            let (meta, len) = unsafe {
                let p = self.base.add(so) as *const u8;
                let len = (p.add(24) as *const u32).read_unaligned() as usize;
                let m = FrameMeta {
                    width: (p.add(8) as *const u32).read_unaligned(),
                    height: (p.add(12) as *const u32).read_unaligned(),
                    stride: (p.add(16) as *const u32).read_unaligned(),
                    format: (p.add(20) as *const u32).read_unaligned(),
                    kind: (p.add(28) as *const u32).read_unaligned(),
                    x: (p.add(32) as *const i32).read_unaligned(),
                    y: (p.add(36) as *const i32).read_unaligned(),
                    w: (p.add(40) as *const i32).read_unaligned(),
                    h: (p.add(44) as *const i32).read_unaligned(),
                    ahash: (p.add(48) as *const u64).read_unaligned(),
                    ts_us: (p.add(56) as *const u64).read_unaligned(),
                };
                if len > self.slot_size as usize {
                    return Err(RingErr::BadGeometry);
                }
                out.clear();
                out.extend_from_slice(std::slice::from_raw_parts(p.add(SLOT_HDR), len));
                (m, len)
            };
            let _ = len;
            fence(Ordering::Acquire);
            if seq.load(Ordering::Relaxed) == s1 {
                return Ok(Some(Read { seq: n, skipped: n - last_seen - 1, meta }));
            }
        }
        Err(RingErr::Torn)
    }
}

