@dataclass
class AuthorizedScope:
    """Where the agent may LOOK for and ACT on user files without asking.  Everything else needs an explicit path in the task text."""
    roots: dict[str, Path]
    locations: tuple[str, ...] = ALL_LOCATIONS

    def allows_location(self, loc: str) -> bool:
        return loc in self.locations

    def allows_path(self, p: str | Path) -> bool:
        q = _norm_path(str(p))
        return any(q == _norm_path(str(r)) or q.startswith(_norm_path(str(r)) + os.sep) for loc, r in self.roots.items() if loc in self.locations)


