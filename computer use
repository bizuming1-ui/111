// dscu cdp-daemon: NDJSON server on \\.\pipe\dscu-cdp-v1 (Windows) or 127.0.0.1:<port> (--tcp, dev/CI only).
import { createServer, Socket } from "node:net";
import { join } from "node:path";
import { runAction } from "./actions.js";
import { BrowserManager } from "./browser.js";
import { observePage } from "./fusion.js";
import { PErr, fail, ok } from "./protocol.js";

function arg(name: string, def?: string): string | undefined {
  const i = process.argv.indexOf(name);
  return i >= 0 ? process.argv[i + 1] : def;
}

const pipeName = arg("--pipe", "dscu-cdp-v1")!;
const tcp = arg("--tcp");
const port = Number(arg("--port", process.env.DSCU_CDP_PORT ?? "9333"));
const profile = arg("--profile", join(process.env.LOCALAPPDATA ?? process.env.HOME ?? ".", "DeepSeekComputerUse", "chrome-profile"))!;
const mgr = new BrowserManager(port, profile, !process.argv.includes("--no-launch"));
const idem = new Map<string, any>();
const started = Date.now();
let epochHint = 0;

async function handle(req: any): Promise<unknown> {
  switch (req.kind) {
    case "ping": return { pong: true, ts_ms: Date.now() };
    case "info": {
      const m = process.memoryUsage();
      return { name: "cdp-daemon", version: "13.0.0", protocol: 1, pid: process.pid, node: process.version, browser_port: port, browser_up: await mgr.up(), launched_browser: mgr.spawned, rss_mb: Math.round(m.rss / 1048576), heap_mb: Math.round(m.heapUsed / 1048576), uptime_ms: Date.now() - started, kinds: ["ping", "info", "observe", "action", "shutdown"] };
    }
    case "observe": {
      const q = req.req ?? {};
      const want = q.want ?? {};
      const tab = await mgr.tab(q.target);
      const t0 = Date.now();
      const o = await observePage(tab, { settle: want.settle !== false, maxNodes: want.max_nodes, includeOffscreen: want.include_offscreen, skeleton: want.skeleton });
      epochHint = o.snapshot_epoch;
      return { v: 1, source: "cdp-daemon", observe_id: q.observe_id ?? null, ts_ms: Date.now(), hwnd: 0, title: o.page.title, process: "browser", ...o, collected_ms: Date.now() - t0 };
    }
    case "action": {
      const a = req.req ?? {};
      if (!a.action_id) return { action_id: "", ok: false, error_code: "INVALID_REQUEST", detail: "action_id (idempotency key) is required" };
      const prev = idem.get(a.action_id);
      if (prev) return { ...prev, replayed: true };
      const t0 = Date.now();
      try {
        const r = await runAction(mgr, a);
        const tab = mgr.activeId ? mgr.tabs.get(mgr.activeId) : undefined;
        const out = { action_id: a.action_id, ok: true, replayed: false, elapsed_ms: Date.now() - t0, new_epoch: tab?.epoch ?? epochHint, ...r };
        if (idem.size > 2000) idem.clear();
        idem.set(a.action_id, out);
        return out;
      } catch (e) {
        const pe = e instanceof PErr ? e : new PErr("INTERNAL", String((e as Error)?.message ?? e));
        return { action_id: a.action_id, ok: false, replayed: false, error_code: pe.code, detail: pe.message, retryable: pe.retryable(), data: pe.data, elapsed_ms: Date.now() - t0 };
      }
    }
    case "shutdown": setTimeout(() => process.exit(0), 50); return { bye: true };
    default: throw new PErr("INVALID_REQUEST", `unknown kind '${req.kind}'`);
  }
}

function serve(sock: Socket) {
  let buf = "";
  let chain: Promise<void> = Promise.resolve();
  sock.setEncoding("utf8");
  sock.on("data", (d: string) => {
    buf += d;
    if (buf.length > 8 << 20) { sock.destroy(); return; }
    let i: number;
    while ((i = buf.indexOf("\n")) >= 0) {
      const line = buf.slice(0, i).trim();
      buf = buf.slice(i + 1);
      if (!line) continue;
      chain = chain.then(async () => {
        let id: unknown = null;
        try {
          const req = JSON.parse(line);
          id = req.id ?? null;
          if (req.v !== 1) throw new PErr("INVALID_REQUEST", "unsupported protocol version (need v=1)");
          sock.write(JSON.stringify(ok(id, await handle(req))) + "\n");
        } catch (e) {
          const pe = e instanceof PErr ? e : new PErr("INTERNAL", String((e as Error)?.message ?? e));
          sock.write(JSON.stringify(fail(id, pe)) + "\n");
        }
      });
    }
  });
  sock.on("error", () => undefined);
}

const server = createServer(serve);
server.on("error", (e) => { console.error("[cdp-daemon] fatal:", e.message); process.exit(1); });
if (tcp) {
  const [host, p] = tcp.includes(":") ? tcp.split(":") : ["127.0.0.1", tcp];
  server.listen(Number(p), host, () => console.error(`[cdp-daemon] tcp ${host}:${p} chrome-port=${port}`));
} else {
  const path = process.platform === "win32" ? `\\\\.\\pipe\\${pipeName}` : `/tmp/${pipeName}.sock`;
  server.listen(path, () => console.error(`[cdp-daemon] pipe ${path} chrome-port=${port} profile=${profile}`));
}
process.on("unhandledRejection", (e) => console.error("[cdp-daemon] unhandled:", e));
