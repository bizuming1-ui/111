  if (!o2) return JSON.stringify({ ok: false, why: 'norow', n: all.length });
  if (op === 'read') return JSON.stringify({ ok: true, c: state(o2.cb) });
  if (op === 'toggle') { o2.cb.click(); return JSON.stringify({ ok: true, c: state(o2.cb) }); }
