//! dscu-driver — `serve` (Named Pipe / UDS ndjson), `bench`, `snapshot`, `selftest`.
mod capture;
mod input;
mod jobobj;
mod protocol;
mod ring;
mod snapshot;
mod uia;

use capture::{best_source, FrameSource, Grab};
use protocol::{ActionLedger, EpochClock, Gate};
use ring::Ring;
use serde_json::{json, Value};
use std::io::{BufRead, BufReader, Write};
use std::time::Instant;

pub const PIPE_NAME: &str = r"\\.\pipe\dscu-driver-v1";

fn ring_path() -> std::path::PathBuf {
    std::env::var_os("DSCU_RING").map(Into::into).unwrap_or_else(|| std::env::temp_dir().join("dscu-v9-ring.bin"))
}

struct State { src: Box<dyn FrameSource>, ring: Ring, snap_no: u32, last: Option<snapshot::Snapshot>, warn: Option<String>, clock: EpochClock, ledger: ActionLedger }

impl State {
    fn new() -> Result<State, String> {
        let (src, warn) = best_source();
        let (w, h) = src.dims();
        let ring = Ring::create(&ring_path(), 3, (w * h * 4) as usize).map_err(|e| e.to_string())?;
        Ok(State { src, ring, snap_no: 0, last: None, warn, clock: EpochClock::default(), ledger: ActionLedger::default() })
    }
    fn capture(&mut self) -> Result<Value, String> {
        let t = Instant::now();
        let src = &mut self.src;
        let n = self.ring.write_with(|d| match src.grab_into(d)? { Grab::Frame(m) => Ok(Some(m)), Grab::Unchanged => Ok(None) })?;
        Ok(json!({"ok": true, "seq": n, "backend": self.src.name(), "us": t.elapsed().as_micros() as u64, "ring": ring_path()}))
    }
    fn snapshot(&mut self, skel: bool, root: Option<&str>) -> Result<Value, String> {
        let raw = uia::collect_foreground(1500)?;
        self.snap_no += 1;
        let mut s = snapshot::build(self.snap_no, &raw);
        self.last = Some(s.clone());
        if let Some(r) = root { s = snapshot::subtree(&s, r).ok_or_else(|| format!("unknown ref {r}"))?; }
        if skel { s = snapshot::skeleton(&s, 2, 24); }
        Ok(json!({"ok": true, "snapshot": s, "epoch": self.clock.get(), "snapshot_epoch": self.clock.get()}))
    }
    /// Unified ActionRequest -> ActionResult (idempotent by action_id, optimistic-locked by expect_epoch).
    fn act(&mut self, v: &Value) -> Value {
        let id = v["action_id"].as_u64().unwrap_or(0);
        match self.ledger.begin(id, v["expect_epoch"].as_u64(), &self.clock) {
            Gate::Replay(r) | Gate::Reject(r) => return r,
            Gate::Proceed => {}
        }
        let a = &v["args"];
        let t = Instant::now();
        let kind = v["action"].as_str().unwrap_or("");
        let r: Result<(), String> = match kind {
            "key" => do_key(a["keys"].as_str().unwrap_or("")),
            "type" => do_type(a["text"].as_str().unwrap_or("")),
            "click" | "double_click" => do_click(a["x"].as_i64().unwrap_or(0) as i32, a["y"].as_i64().unwrap_or(0) as i32, kind == "double_click"),
            other => Err(format!("UNSUPPORTED:{other}")),
        };
        if r.is_ok() && matches!(kind, "key" | "click" | "double_click") { self.clock.bump(); }
        let mut out = match r {
            Ok(()) => protocol::result(id, true, "OK", kind, self.clock.get()),
            Err(e) if e.starts_with("UNSUPPORTED:") => protocol::result(id, false, "UNSUPPORTED", &e, self.clock.get()),
            Err(e) => protocol::result(id, false, "INTERNAL", &e, self.clock.get()),
        };
        out["ok"] = json!(out["code"] == "OK");
        out["elapsed_ms"] = json!(t.elapsed().as_secs_f64() * 1000.0);
        self.ledger.commit(id, &out);
        out
    }
    fn handle(&mut self, v: &Value) -> Value {
        let r = match v["cmd"].as_str().unwrap_or("") {
            "ping" => Ok(json!({"ok": true, "v": "11.0.0", "protocol": protocol::PROTOCOL_VERSION, "epoch": self.clock.get(), "backend": self.src.name(), "warn": self.warn, "jab": uia::probe_jab(), "pid": std::process::id()})),
            "capture" => self.capture(),
            "snapshot" => self.snapshot(v["skeleton"].as_bool().unwrap_or(false), v["root"].as_str()),
            "bench" => Ok(bench(self, v["n"].as_u64().unwrap_or(200) as usize)),
            "epoch" => Ok(json!({"ok": true, "epoch": self.clock.get()})),
            "act" => Ok(self.act(v)),
            c => Err(format!("unknown cmd {c:?}")),
        };
        r.unwrap_or_else(|e| json!({"ok": false, "error": e}))
    }
}

