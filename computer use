def percentile(vals: list[float], p: float) -> float:
    """Nearest-rank percentile (same definition as the PowerShell Pct function)."""
    if not vals:
        return 0.0
    s = sorted(vals)
    k = max(0, min(len(s) - 1, math.ceil(p / 100.0 * len(s)) - 1))
