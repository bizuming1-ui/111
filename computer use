def mk_obs(fg_title="桌面整理", fg_proc="DesktopOrganizer.exe", fg_cls="Fences", elements=None, extra_windows=None, pix="0" * 16, target_occluded=True):
    wins = [
        {"hwnd": 10, "title": fg_title, "process": fg_proc, "class": fg_cls, "rect": [0, 0, 2560, 1600], "z": 0, "occluded_by": []},
        {"hwnd": 20, "title": "微信", "process": "Weixin.exe", "class": "Qt51514QWindowIcon", "rect": [900, 300, 800, 700], "z": 3, "occluded_by": [10] if target_occluded else []},
    ] + (extra_windows or [])
    return parse_observation({"type": "observation", "id": "x", "ok": True, "channel": "uia", "snapshot_epoch": 1, "hwnd": 20, "title": "微信", "process": "Weixin.exe",
                              "fg_hwnd": 10, "windows": wins, "elements": elements or [], "dxgi_stats": {"capture_backend": "DXGI", "dirty_rects_count": 3, "frame_ms": 2.1, "frame_hash": pix}})


def step(st, obs, action, res=None, expect="fg=微信"):
    st.step += 1
    st.settle_last(obs)
    res = res or ActionResult(ok=True, code=Code.OK, message="已切换到窗口")
    st.record(st.step, action, expect, obs, res, {})


class TestLoopRecovery(unittest.TestCase):
    def test_log_regression_focus_window_loop_escalates_within_8_steps(self):
        """v12 burned 60 steps. v13 must mask by step 4, force vision+remedy by step ~6 and hand over to a human by step ~8."""
        st, lad, obs = TaskState("打开微信，找到联系人老虎不抓鼠，给他发一条信息"), RecoveryLadder(), mk_obs()
        levels, escalated_at = [], None
        for i in range(1, 12):
            d = lad.evaluate(st, obs)
            levels.append(d.level)
            if d.escalate_human:
                escalated_at = i
                break
            step(st, obs, {"action": "focus_window", "title": "微信"})
        self.assertIsNotNone(escalated_at, "loop never escalated")
        self.assertLessEqual(escalated_at, 9)
        self.assertTrue(any("focus_window" in k for k in st.loop_hits))

    def test_mask_blocks_repeat_then_expires(self):
        st, lad, obs = TaskState("x"), RecoveryLadder(), mk_obs()
        for _ in range(4):
            lad.evaluate(st, obs)
            step(st, obs, {"action": "focus_window", "title": "微信"})
        d = lad.evaluate(st, obs)
        self.assertIn("focus_window", d.masked | set(st.masks))
        gate = ActionGate.check({"action": "focus_window", "title": "微信"}, obs, st, {})
        self.assertIsNotNone(gate)
        self.assertEqual(gate[0], Code.SECURITY_DENIED)

    def test_crash_dialog_counts_and_escalates(self):
        st, lad = TaskState("打开微信发消息"), RecoveryLadder()
        for i in range(3):
            o = mk_obs(extra_windows=[{"hwnd": 30 + i, "title": "错误报告", "process": "WeChatCrashReporter.exe", "class": "#32770", "rect": [941, 356, 678, 512], "z": 1}], target_occluded=False)
            d = lad.evaluate(st, o)
            lad.evaluate(st, mk_obs(target_occluded=False))  # dialog closed in between -> next appearance counts again
        self.assertGreaterEqual(st.crashes["weixin.exe"], 3)
        self.assertTrue(d.escalate_human or lad.evaluate(st, o).escalate_human)

    def test_confirmed_progress_never_flagged_as_loop(self):
        st, lad = TaskState("x"), RecoveryLadder()
        for i in range(8):
            o = mk_obs(pix=f"{(1 << i):016x}", fg_title=f"page {i}")
            lad.evaluate(st, o)
            step(st, o, {"action": "click", "x": 100 + i * 50, "y": 200}, expect="page changes")
        self.assertFalse(st.detect_loop())


