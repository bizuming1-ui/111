"""
v16.4 Token / Diagnostic / No-progress circuit breaker (per task).

v16.3 log, task #8:  14 model calls, 227,871 input tokens, 69 s, ended `failed` — the model alternated vision_inspect x4, `Get-Date` x3, `Get-Process chrome`, and a
broken selector.  None of those calls could change the world, yet each one re-sent the whole context (input grew 3.3k -> 31.6k tokens/call).

Three independent brakes (all env-tunable, all logged, all deterministic — no LLM involved):
  * max_consecutive_no_progress   (default 4)    consecutive steps that neither changed the world nor were a successful input action
  * diagnostic budget             (default 3 total, 2 consecutive, identical command at most once)   `Get-Date` / `Get-Process` / `hostname` ... are "diagnostic noise"
  * token_budget_per_task         (default 160000 prompt+completion tokens; 80% => warning; also max_model_calls=40)
`check()` returns a BudgetTrip (kind/message/terminal status) that the orchestrator turns into a clean terminal state instead of burning another call.
"""
from __future__ import annotations

import os
import re
from dataclasses import dataclass, field
from typing import Any, Optional

DIAG_CMDLETS = {
    "get-date", "get-process", "get-location", "get-host", "get-service", "hostname", "whoami", "get-computerinfo", "get-ciminstance", "get-wmiobject",
    "get-random", "get-uptime", "get-timezone", "get-culture", "get-command", "get-alias", "get-psdrive", "get-variable", "get-executionpolicy", "pwd", "echo", "write-output",
    "write-host", "date", "ps", "gps", "gl", "ver", "systeminfo", "tasklist",
}
NON_PROGRESS_ACTIONS = {"vision_inspect", "inspect", "wait", "replan", "cdp_wait_selector", "screenshot", "observe"}
INPUT_ACTIONS = {"click", "double_click", "right_click", "type", "key", "scroll", "drag", "cdp_navigate", "launch", "app_resolve", "focus_window", "set_value", "invoke",
                 "recycle_file", "empty_recycle_bin", "save_text", "open_file"}


def _env_int(name: str, default: int) -> int:
    try:
        return max(1, int(os.environ.get(name, default)))
    except ValueError:
        return default


@dataclass
class BudgetConfig:
    max_consecutive_no_progress: int = field(default_factory=lambda: _env_int("DSCU_MAX_NO_PROGRESS", 4))
    max_diagnostic_calls: int = field(default_factory=lambda: _env_int("DSCU_MAX_DIAG_CALLS", 3))
    max_consecutive_diagnostics: int = field(default_factory=lambda: _env_int("DSCU_MAX_CONSEC_DIAG", 2))
    token_budget_per_task: int = field(default_factory=lambda: _env_int("DSCU_TOKEN_BUDGET", 160_000))
    max_model_calls: int = field(default_factory=lambda: _env_int("DSCU_MAX_MODEL_CALLS", 40))


@dataclass
class BudgetTrip:
    kind: str  # no_progress | tokens | model_calls | diagnostics
    message: str
    status: str  # terminal status handed to the orchestrator


def diagnostic_kind(action: dict[str, Any]) -> Optional[str]:
    """Normalised command if this run_powershell call is a pure diagnostic (reads nothing task-relevant), else None."""
    if str(action.get("action", "")) != "run_powershell":
        return None
    cmd = str(action.get("command", "")).strip()
    if not cmd:
        return None
    segs = [s.strip() for s in re.split(r"[;|\n]", cmd) if s.strip()]
    if not segs:
        return None
    for s in segs:
        first = re.split(r"\s+", s, maxsplit=1)[0].lower().lstrip("&.(")
        if first in ("select-object", "select", "format-table", "ft", "format-list", "fl", "out-string", "where-object", "?", "sort-object", "measure-object"):
            continue  # pipeline decoration of a diagnostic
        if first not in DIAG_CMDLETS and not s.lower().startswith("$psversiontable"):
            return None
    return re.sub(r"\s+", " ", cmd.lower())[:160]


class TaskBudget:
    def __init__(self, cfg: Optional[BudgetConfig] = None) -> None:
        self.cfg = cfg or BudgetConfig()
        self.reset()

    def reset(self) -> None:
        self.prompt_tokens = 0
        self.completion_tokens = 0
        self.model_calls = 0
        self.no_progress_streak = 0
        self.diag_total = 0
        self.diag_streak = 0
        self.diag_seen: set[str] = set()
        self.diag_denied = 0
        self.warned = False
        self.tripped: Optional[BudgetTrip] = None
        self.max_streak_seen = 0

    # ------------------------------------------------------------------ accounting
    @property
    def tokens(self) -> int:
        return self.prompt_tokens + self.completion_tokens

    def on_model_call(self, prompt_tokens: int, completion_tokens: int) -> None:
        self.model_calls += 1
        self.prompt_tokens += int(prompt_tokens or 0)
        self.completion_tokens += int(completion_tokens or 0)

    def on_step(self, action: dict[str, Any], ok: bool, effect: str = "unknown") -> bool:
        """Record one executed step; returns True when the step made progress."""
        name = str(action.get("action", ""))
        diag = diagnostic_kind(action) is not None
        progress = bool(ok) and not diag and name not in NON_PROGRESS_ACTIONS and (effect == "confirmed" or name in INPUT_ACTIONS)
        if progress:
            self.no_progress_streak = 0
        else:
            self.no_progress_streak += 1
            self.max_streak_seen = max(self.max_streak_seen, self.no_progress_streak)
        return progress

    # ------------------------------------------------------------------ gates
    def gate_diagnostic(self, action: dict[str, Any]) -> Optional[str]:
        """Return a denial message when this diagnostic call must NOT run (the model gets the message as the action result — zero cost, no execution)."""
        key = diagnostic_kind(action)
        if key is None:
            self.diag_streak = 0
            return None
        why = ""
        if key in self.diag_seen:
            why = "同一条诊断命令已经执行过，结果不会变化"
        elif self.diag_streak >= self.cfg.max_consecutive_diagnostics:
            why = f"已连续 {self.diag_streak} 次诊断命令而没有改变任何状态"
        elif self.diag_total >= self.cfg.max_diagnostic_calls:
            why = f"本任务诊断命令已达上限 {self.cfg.max_diagnostic_calls} 次"
        if why:
            self.diag_denied += 1
            self.no_progress_streak += 1
            self.max_streak_seen = max(self.max_streak_seen, self.no_progress_streak)
            return (f"[DIAG_BUDGET] 拒绝执行诊断命令：{why}。Get-Date/Get-Process/hostname 之类的命令不会推进任务。"
                    "请改用：① 重新观察后基于控件/元素 id 操作；② cdp_wait_selector 使用强类型选择器 {\"by\":\"text_contains\",\"value\":\"…\"}；"
                    "③ 点击前确认目标窗口在前台；④ 无法继续就 action=fail 说明原因。")
        self.diag_seen.add(key)
        self.diag_total += 1
        self.diag_streak += 1
        return None

    def note_non_diag(self) -> None:
        self.diag_streak = 0

    def check(self) -> Optional[BudgetTrip]:
        c = self.cfg
        if self.tripped:
            return self.tripped
        if self.tokens >= c.token_budget_per_task:
            self.tripped = BudgetTrip("tokens", f"Token 预算熔断：本任务已消耗 {self.tokens} ≥ 上限 {c.token_budget_per_task}（输入 {self.prompt_tokens} / 输出 {self.completion_tokens}，{self.model_calls} 次模型调用）。"
                                      "为避免继续空耗，任务暂停；可 DSCU_TOKEN_BUDGET=300000 提高上限或把任务拆小。", "failed")
        elif self.model_calls >= c.max_model_calls:
            self.tripped = BudgetTrip("model_calls", f"模型调用熔断：本任务已调用 {self.model_calls} 次 ≥ 上限 {c.max_model_calls}。", "failed")
        elif self.no_progress_streak >= c.max_consecutive_no_progress:
            self.tripped = BudgetTrip("no_progress", f"无进展熔断：连续 {self.no_progress_streak} 步没有改变界面/文件状态（上限 {c.max_consecutive_no_progress}；诊断拒绝 {self.diag_denied} 次；"
                                      f"已用 {self.tokens} tok / {self.model_calls} 次调用）。已暂停并交还用户，避免空耗 Token。", "paused_for_user")
        return self.tripped

    def warn_text(self) -> Optional[str]:
        if not self.warned and self.tokens >= 0.8 * self.cfg.token_budget_per_task:
            self.warned = True
            return f"⚠ Token 已用 {self.tokens}/{self.cfg.token_budget_per_task}（≥80%）：请尽快收敛或 fail。"
        return None

    def summary(self) -> str:
        c = self.cfg
        t = f" · 熔断={self.tripped.kind}" if self.tripped else ""
        return (f"预算：Token {self.tokens}/{c.token_budget_per_task} · 模型调用 {self.model_calls}/{c.max_model_calls} · 最长无进展连击 {self.max_streak_seen}/{c.max_consecutive_no_progress}"
                f" · 诊断命令 {self.diag_total}/{c.max_diagnostic_calls}（拒绝 {self.diag_denied}）{t}")
