from __future__ import annotations

import json
import os
import re
import sys

PAGES = [{"id": 1, "url": "about:blank", "title": "", "sel": True}]
STATE = {"sid": 0, "next_page": 2, "values": {}, "title_override": {}, "clicks": [], "scroll_top": 0, "scroll_max": 1200}
FAKE_DPR = float(os.environ.get("FAKE_DPR", "1.25"))
FAKE_SCROLL_BROKEN = set(filter(None, os.environ.get("FAKE_SCROLL_BROKEN", "").split(",")))  # strategies that do nothing, e.g. "scrollTo"
ARGV_FILE = os.environ.get("FAKE_ARGV_FILE", "")

SCHEMA_PID = {"pageId": {"type": "number"}}


def tool(name: str, props: dict, req: list | None = None) -> dict:
    return {"name": name, "description": name, "inputSchema": {"type": "object", "properties": props, "required": req or []}}


TOOLS = [
    tool("list_pages", {}), tool("take_snapshot", {**SCHEMA_PID, "verbose": {"type": "boolean"}}, ["pageId"]),
    tool("click", {**SCHEMA_PID, "uid": {"type": "string"}, "dblClick": {"type": "boolean"}}, ["pageId", "uid"]),
    tool("hover", {**SCHEMA_PID, "uid": {"type": "string"}}), tool("fill", {**SCHEMA_PID, "uid": {"type": "string"}, "value": {"type": "string"}}),
    tool("press_key", {**SCHEMA_PID, "key": {"type": "string"}}), tool("type_text", {**SCHEMA_PID, "text": {"type": "string"}}),
    tool("navigate_page", {**SCHEMA_PID, "type": {"type": "string"}, "url": {"type": "string"}, "timeout": {"type": "integer"}}),
    tool("new_page", {"url": {"type": "string"}, "background": {"type": "boolean"}}), tool("select_page", {**SCHEMA_PID, "bringToFront": {"type": "boolean"}}),
    tool("wait_for", {**SCHEMA_PID, "text": {"type": "array"}, "timeout": {"type": "integer"}}),
    tool("list_network_requests", {**SCHEMA_PID}), tool("list_console_messages", {**SCHEMA_PID}),
    tool("upload_file", {**SCHEMA_PID, "uid": {"type": "string"}, "filePaths": {"type": "array"}}),
    tool("drag", {**SCHEMA_PID, "from_uid": {"type": "string"}, "to_uid": {"type": "string"}}),
    tool("evaluate_script", {**SCHEMA_PID, "function": {"type": "string"}, "args": {"type": "array", "items": {"type": "object"}}}),
