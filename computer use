"""Golden Log-Regression Suite: replays evals/fixtures/log_golden.json (distilled from 运行日志 + 运行日志1) through the v12 planes.
Exit code 0 only if every case is green (原失败项转绿 + 已成功项零退化)."""
from __future__ import annotations

import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.dirname(HERE))

from agent_brain import native_contract                      # noqa: E402
from agent_brain.action_gate import ActionGate                # noqa: E402
from agent_brain.app_resolver import AppEntry, rank           # noqa: E402
from agent_brain.entropy_router import EntropyRouter          # noqa: E402
from agent_brain.quota import get_task_quantities             # noqa: E402
from agent_brain.router import Router                         # noqa: E402
from agent_brain.uma import UmaBreaker                        # noqa: E402
from agent_brain.window_fp import WindowFp, pick_window       # noqa: E402


def load() -> dict:
    with open(os.path.join(HERE, "fixtures", "log_golden.json"), encoding="utf-8") as f:
        return json.load(f)


def run_case(c: dict) -> tuple[bool, str]:
    k = c["kind"]
    if k == "intent":
        it = Router().route(c["task"]).intent
        e = c["expect"]
        ok = bool(it) and it.folder_key == e["folder"] and it.name == e["name"] and it.content == e["content"] \
            and len(it.content.encode("utf-8")) == e["utf8_bytes"]
        return ok, f"{it}"
    if k == "resolve":
        hits = rank(c["query"], [AppEntry(**x) for x in c["index"]])
        e = c["expect"]
        top = hits[0] if hits else {}
        ok = bool(top) and top["score"] >= e["min_score"] and (top.get("exe") == e.get("top_exe", top.get("exe"))) and (top.get("aumid") == e.get("top_aumid", top.get("aumid")))
        return ok, json.dumps(top, ensure_ascii=False)
    if k == "gate_replay":
        g, bad = ActionGate(), []
        for i, s in enumerate(c["steps"], 1):
            d = g.check(s["act"])
            got = "allow" if d.allow else f"masked:{d.reason}"
            if got != s["expect"]:
                bad.append(f"step{i}: {got} != {s['expect']}")
            if d.allow and s["then"] != "none":
                g.observe(s["act"], s["then"] == "effect")
            if "mode" in s and g.mode != s["mode"]:
                bad.append(f"step{i}: mode {g.mode} != {s['mode']}")
        return not bad, "; ".join(bad) or f"final mode={g.mode} masked={g.masked_total} switches={g.switches}"
    if k == "route":
        r, bad = EntropyRouter(), []
        for i, s in enumerate(c["steps"], 1):
            d = r.route(s["inter"], uma_tripped=s.get("uma_tripped", False), local_up=s.get("local_up", False), zero_streak=s["zero"])
            if d.route != s["expect"]:
                bad.append(f"step{i}: {d.route} != {s['expect']}")
        return not bad, "; ".join(bad) or "ok"
    if k == "quota":
        parts, total = get_task_quantities(c["task"])
        return parts == c["expect"]["parts"] and total == c["expect"]["total"], f"{parts} total={total}"
    if k == "uma":
        u, bad = UmaBreaker(), []
        for s in c["series"]:
            if u.update(s["avail_mb"]) != s["tripped"]:
                bad.append(f"{s['avail_mb']}MB -> {u.tripped}")
        return not bad, "; ".join(bad) or "no flapping"
    if k == "focus":
        cands = [WindowFp(**x) for x in c["candidates"]]
        p = pick_window(cands, c["keyword"], c["need_input"])
        return bool(p) and p.title == c["expect"]["title"], p.title if p else "None"
    if k == "contract":
        bad = native_contract.scan(c["csharp"] + "\n" + c["snippet"])
        return bool(bad) == c["expect_violation"], "; ".join(bad) or "clean"
    return False, f"unknown kind {k}"


def main() -> int:
    data, fails = load(), 0
    print("== golden log regression (运行日志 + 运行日志1) ==")
    for c in data["cases"]:
        ok, d = run_case(c)
        fails += 0 if ok else 1
        print(f"  [{'PASS' if ok else 'FAIL'}] {c['id']:<42} {c['source']}  {'' if ok else d}")
    print(f"golden: {len(data['cases']) - fails}/{len(data['cases'])} green")
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
