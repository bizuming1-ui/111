        cm = CONTENT_RX.search(task)
        content = cm.group("c").strip().strip("“”\"'") if cm else None
        for m in WIN_PATH.findall(task + " " + summary):
            found.append((Path(m), content))
        if FILE_VERBS.search(task):
            f = re.search(r"(桌面|文档|下载|desktop|documents|downloads)", task, re.I)
            n = NAME_RX.search(task)
            if f and n:
                folder = layer0.known_folder(f.group(1))
                name = n.group(1)
                if "." in name:
                    found.append((folder / name, content))
                else:
                    cands = [folder / (name + e) for e in (".txt", ".docx", ".xlsx", ".pptx", ".png", ".jpg", ".pdf", ".md", ".csv", ".json")]
                    hit = next((c for c in cands if c.exists()), cands[0])
                    found.append((hit, content))
        seen, uniq = set(), []
        for p, c in found:
            k = str(p).lower()
            if k not in seen:
                seen.add(k)
                uniq.append((p, c))
        return uniq

    # ------------------------------------------------------------------ browser
    @staticmethod
    def derive_web_expect(task: str) -> dict[str, Any]:
        t = task.lower()
        exp: dict[str, Any] = {}
        hosts = [urlparse(u).hostname or "" for u in URL_RX.findall(task)]
        for k, v in SITES.items():
            if k in t:
                hosts.append(v)
        hosts = [h for h in hosts if h]
        if hosts:
            exp["host"] = hosts[0]
        sm = SEARCH_RX.search(task)
        if sm:
            exp["keyword"] = sm.group(1)  # v16.2: a search task is verifiable even without a named site (keyword must appear in URL query / title / input)
        if NTH_RX.search(task) and re.search(r"视频|video|结果|短片", task, re.I):
            exp["opened_item"] = True
        return exp

    async def probe_cdp(self, needles: list[str]) -> Optional[dict[str, Any]]:
        if not getattr(self.hub, "cdp_up", False):
            return None
        try:
            r = await self.hub.cdp_action({"action": "probe", "needles": needles, "action_id": f"probe-{id(needles)}-{len(needles)}"})
        except Exception as e:  # noqa: BLE001
            return {"error": str(e)}
        if not r.ok:
            return {"error": r.message}
        return dict(r.effect)

    async def _web_checks(self, task: str, summary: str) -> list[Check]:
        exp = self.derive_web_expect(task)
        if not exp:
            return []
        needles = [exp["keyword"]] if exp.get("keyword") else []
        pr = await self.probe_cdp(needles)
        if pr is None:
            return [Check("page_loaded", True, "任务涉及网页但浏览器引擎不可用，无法独立核对页面状态（未评估）", "cdp", evaluated=False, source="cdp_probe")]
        if "error" in pr:
            return [Check("page_loaded", True, f"CDP 探测失败: {pr['error'][:100]}（未评估）", "cdp", evaluated=False, source="cdp_probe")]
        url, title = str(pr.get("url", "")), str(pr.get("title", ""))
        out: list[Check] = []
        bad_page = url.startswith(("chrome-error://", "about:blank", "edge-error://")) or bool(re.search(r"ERR_[A-Z_]+|无法访问此网站|找不到|can.?t be reached|404 not found|DNS_PROBE", title, re.I)) or pr.get("settled") is False
        out.append(Check("page_loaded", not bad_page, f"url={url[:70] or '空'} title={title[:30]!r} settled={pr.get('settled')}", "cdp", source="cdp_probe"))
        if exp.get("host"):
            host = (urlparse(url).hostname or "").lower()
            core = exp["host"].lower().rstrip(".")
            out.append(Check("url_host", core in host, f"当前 {host or '空'} 期望含 {core}", "cdp", source="cdp_probe"))
        if exp.get("keyword"):
            kw = exp["keyword"].lower()
            u = unquote(url).lower()
            hit = kw in u or kw in title.lower() or bool(pr.get("needles", {}).get(exp["keyword"])) or any(kw in str(v).lower() for v in pr.get("inputs", []))
            out.append(Check("search_keyword", hit, f"关键词 {exp['keyword']!r} 出现在 URL/标题/输入框/DOM", "cdp", source="cdp_probe"))
        if exp.get("opened_item"):
            ok = bool(VIDEO_URL.search(url)) or bool(pr.get("has_video_player"))
            out.append(Check("item_opened", ok, f"URL={url[:90]} player={pr.get('has_video_player')}", "cdp", source="cdp_probe"))
        return out

    # ------------------------------------------------------------------ quota / list objects
    async def _quota_checks(self, task: str, quantity: Optional[int], obs: Any) -> list[Check]:
        if not self.reg.targets_locked or not DESTRUCTIVE.search(task) and not re.search(r"删除|delete|归档|archive|移除", task, re.I):
            return []
        elements = None
        if getattr(self.hub, "cdp_up", False):
            try:
                o = await self.hub.cdp_observe(max_elements=250, settle_ms=800)
                elements = o.elements
            except Exception:  # noqa: BLE001
                elements = None
        if elements is None and obs is not None:
            elements = obs.elements
        if elements is None:
            return [Check("quota_fresh_list", False, "无法取得新鲜列表", "quota")]
        self.reg.observe_rows(elements, self.reg.step)
        targets = [o for o in self.reg.objects.values() if o.is_target]
        still = [o for o in targets if o.current_state != "gone"]
        out = [Check("targets_gone", not still, f"{len(targets) - len(still)}/{len(targets)} 个目标对象已消失" + (f"；仍在: {[o.label[:20] for o in still][:3]}" if still else ""), "quota", source="fresh_dom_list")]
        if quantity:
            out.append(Check("quota_count", len(targets) - len(still) >= quantity, f"已移除 {len(targets) - len(still)} / 配额 {quantity}", "quota", source="fresh_dom_list"))
        return out

    # ------------------------------------------------------------------ recycle bin (v15)
    @staticmethod
    def _recycle_checks(task: str) -> list[Check]:
        """Task says 'empty the Recycle Bin' -> independent COM + SHQueryRecycleBinW count must be 0 (fixes the v14 UNVERIFIED verdict of task #3).
        Task says 'put X into the Recycle Bin' -> X must be gone from its folder."""
        out: list[Check] = []
        if not re.search(r"回收站|recycle bin", task, re.I):
            return out
        from . import safe_shell

        if layer0.recycle_empty_intent(task):
            st = safe_shell.wait_recycle_count(0, 6.0)
            if st.get("ok"):
                out.append(Check("recycle_bin_empty", st.get("count") == 0 and st.get("consistent", True),
                                 f"独立核验 count={st.get('count')} 来源={st.get('sources')}", "recycle", source="SHQueryRecycleBinW+NameSpace(10)"))
            else:
                out.append(Check("recycle_bin_empty", True, f"无法独立读取回收站（{st.get('reason')}）→ 未评估，不计入覆盖", "recycle", evaluated=False, source="shell_api"))
        m = layer0._RECYCLE_FILE.search(task)
        if m:
            folder = layer0.known_folder(m.group("folder"))
            nm = m.group("name").strip("“”\"'").lower()
            left = [f.name for f in folder.glob("*") if f.is_file() and (f.stem.lower() == nm or f.name.lower() == nm)] if folder.exists() else []
            out.append(Check("file_left_folder", not left, f"{folder} 中{'仍有 ' + ','.join(left) if left else '已无 ' + nm}", "recycle"))
        return out

    # ------------------------------------------------------------------ sanity
    @staticmethod
    def _sanity(st: Any, obs: Any) -> list[Check]:
        out: list[Check] = []
        if obs is not None:
            bad = [w for w in obs.windows if w.process.lower() in CRASH_PROCS or CRASH_TITLES.search(w.title or "")]
            out.append(Check("no_crash_window", not bad, "无崩溃/错误报告窗口" if not bad else f"存在 {bad[0].process}:{bad[0].title[:30]}", "sanity"))
        led = getattr(st, "ledger", [])
        if led:
            e = led[-1]
            act = e.action.get("action")
            bad = e.code != "OK" and act not in READONLY_OK_ACTIONS and not (e.code == "NOT_FOUND" and act in READONLY_PROBE_ACTIONS)
            out.append(Check("last_action_ok", not bad, f"{e.sig[:40]}→{e.code}/{e.effect}", "sanity"))
        return out

    # ------------------------------------------------------------------ entry points
    # ------------------------------------------------------------------ v16 polarity-aware assertions
    @staticmethod
    def assert_file_not_exists(target: tuple) -> Check:
        """DELETE_OR_CLEAR tasks: the file must be GONE (never `file_exists == True`)."""
        if target[0] == "path":
            p = target[1]
            gone = not Path(p).exists()
            return Check("file_not_exists", gone, f"{'已不存在' if gone else '仍存在'}: {p}", "file", source="filesystem")
        _, folder, nm = target
        try:
            left = [f.name for f in Path(folder).iterdir() if f.is_file() and (f.name.lower() == nm.lower() or f.stem.lower() == nm.lower())] if Path(folder).exists() else []
        except OSError:
            left = []
        return Check("file_not_exists", not left, f"{folder} 中{'已无 ' + nm + '.*' if not left else '仍有 ' + ', '.join(left)}", "file", source="filesystem")

    @staticmethod
    def assert_recycle_bin_empty() -> Check:
        """SHQueryRecycleBinW + COM Shell.Application NameSpace(10) must both report 0 items."""
        from . import safe_shell

        st = safe_shell.wait_recycle_count(0, 6.0)
        if st.get("ok"):
            return Check("recycle_bin_empty", st.get("count") == 0 and st.get("consistent", True), f"独立核验 count={st.get('count')} 来源={st.get('sources')}", "recycle", source="SHQueryRecycleBinW+NameSpace(10)")
        return Check("recycle_bin_empty", True, f"无法独立读取回收站（{st.get('reason')}）→ 未评估，不计入覆盖", "recycle", evaluated=False, source="shell_api")

    def derive_assertions(self, task: str, summary: str) -> tuple[list[tuple[Path, Optional[str]]], list[tuple]]:
        pol = task_polarity(task)
        exist = self._derive_files(task, summary)
        if pol in ("CREATE_OR_SAVE", "NONE"):
            return exist, []
        absent = delete_targets(task, summary)
        if pol == "DELETE_OR_CLEAR":
            return [], absent
        keep: list[tuple[Path, Optional[str]]] = []  # MIXED: per file, the LAST clause that mentions it decides
        ev = clause_events(task)
        for p, c in exist:
            last = None
            for pol_i, cl in ev:
                if p.stem and p.stem.lower() in cl.lower():
                    last = pol_i
            if last == "DELETE_OR_CLEAR":
                absent.append(("path", p))
            else:
                keep.append((p, c))
        return keep, absent

    async def verify_done(self, task: str, summary: str, st: Any, obs: Any, quantity: Optional[int] = None) -> Verdict:
        checks: list[Check] = []
        exist, absent = self.derive_assertions(task, summary)
        self.last_polarity = task_polarity(task)
        for p, content in exist:
            checks += self.check_file(p, expect_text=content)
            if p.exists():
                o = self.reg.register_file(p)
                o.set_state("sha256:" + sha256_file(p)[:16], getattr(st, "step", 0))
        for tgt in absent:
            checks.append(self.assert_file_not_exists(tgt))
        checks += await self._web_checks(task, summary)
        checks += await self._quota_checks(task, quantity, obs)
        checks += await asyncio.to_thread(self._recycle_checks, task)
        checks += self._sanity(st, obs)
        goals = self.derive_goals(task, summary, exist, absent, quantity)
        checks += await self._v164_checks(goals, st, obs)
        checks += await self._goal_extra_checks(goals)
        checks = self._placeholders(goals, checks)
        v = self.finalize(checks, goals)
        if not v.ok:
            v.diagnosis = "独立验证器未放行：" + "；".join(f"{c.name}: {c.detail}" for c in checks if not c.ok)[:600]
            self.rejections += 1
        else:
            self.passes += 1
            if v.coverage == "none":
                v.diagnosis = "UNVERIFIED：任务没有可程序化核对的终态（GoalSchema 为空 / 必需后置条件均无法由独立数据源评估）→ 不提交事务，不计为完成"
            elif v.coverage == "partial":
                v.diagnosis = f"PARTIAL：必需后置条件 {v.required_passed}/{v.required_total} 已独立验证，其余无法评估 → 不提交事务"
        self.last = v
        return v

    # ------------------------------------------------------------------ v16.2 GoalSchema machinery
    def derive_goals(self, task: str, summary: str, exist: list, absent: list, quantity: Optional[int]) -> list["GoalSchema"]:
        goals: list[GoalSchema] = []
        for p, content in exist:
            if p.suffix.lower() == ".pptx":
                goals.append(PptCreateGoal(str(p), _ppt_pages(task)))
            else:
                goals.append(FileCreateGoal(str(p), content))
        for tgt in absent:
            goals.append(FileDeleteGoal(tuple(str(x) for x in tgt)))
        exp = self.derive_web_expect(task)
        if exp:
            goals.append(NavigationGoal(exp.get("host", ""), exp.get("keyword", ""), bool(exp.get("opened_item"))))
        if re.search(r"回收站|recycle bin", task, re.I) and layer0.recycle_empty_intent(task):
            goals.append(RecycleBinEmptyGoal())
        if self.reg.targets_locked and (DESTRUCTIVE.search(task) or re.search(r"删除|delete|归档|archive|移除", task, re.I)):
            goals.append(QuotaGoal(quantity or 0))
        # ---- v16.4 strongly-typed goals (only when no earlier goal already owns the task)
        from . import goal_checks as gc
        from .skills import message_send as _ms

        _mr = _ms.parse_message_request(task)
        if _mr is not None:
            goals.append(MessageSendGoal(_mr.recipient, _mr.body))
        elif not goals:
            _fg = gc.derive_form_goal(task)
            if _fg:
                goals.append(FormFieldGoal(_fg["kind"], _fg["hint"], _fg["expected"]))
            else:
                _ag = gc.derive_app_goal(task)
                if _ag:
                    goals.append(AppWindowGoal(_ag["query"], tuple(_ag["process_names"])))
                else:
                    _wa = derive_web_action(task)  # v17.1: plain web click / open / expand / jump (tasks #9/#10/#11)
                    if _wa and (self.web.base is not None or self.web.samples):
                        goals.append(WebActionGoal(_wa["intent"], _wa["target"]))
        return goals

    async def _v164_checks(self, goals: list["GoalSchema"], st: Any, obs: Any) -> list[Check]:
        from . import goal_checks as gc

        rows: list[dict[str, Any]] = []
        for g in goals:
            try:
                if isinstance(g, AppWindowGoal):
                    rows += await gc.check_app_window(self, g.query, tuple(g.process_names), g.title_hint)
                elif isinstance(g, FormFieldGoal):
                    rows += await gc.check_form_field(self, g.field_kind, g.field_hint, g.expected, st, obs)
                elif isinstance(g, MessageSendGoal):
                    rows += await gc.check_message_send(self, g.recipient, g.body, st, obs)
                elif isinstance(g, WebActionGoal):
                    for c in await self._web_action_checks(g, st, obs):
                        rows.append({"name": c.name, "ok": c.ok, "detail": c.detail, "kind": c.kind, "evaluated": c.evaluated, "source": c.source})
            except Exception as e:  # noqa: BLE001  an oracle crash must never become a pass
                rows.append(gc.row(g.required_postconditions()[0], True, f"oracle 异常 {type(e).__name__}: {str(e)[:80]}（未评估）", g.oracle_kind(), evaluated=False, source="error"))
        return [Check(r["name"], r["ok"], r["detail"], r["kind"], evaluated=r["evaluated"], source=r["source"]) for r in rows]

    # ------------------------------------------------------------------ v17.1 WebActionGoal oracle
    async def capture_web_baseline(self, task: str) -> Optional[WebState]:
        """Called ONCE before the first action of a web-interaction task: (url, title, expanded_states, dom_text_digest) through the CDP/MCP probe."""
        self.web.reset()
        wa = derive_web_action(task)
        if wa is None or not getattr(self.hub, "cdp_up", False):
            return None
        pr = await self.probe_cdp([wa["target"]] if wa["target"] else [])
        s = self.web.from_probe(pr, 0)
        if s is not None:
            self.web.base = s
        return s

    async def _web_action_checks(self, g: "WebActionGoal", st: Any, obs: Any) -> list[Check]:
        pr = await self.probe_cdp([g.target] if g.target else [])
        after = self.web.from_probe(pr, getattr(st, "step", 0))
        last = self.web.last()
        before = self.web.base or (self.web.samples[0] if self.web.samples else None)
        if after is None and last is not None:
            after = last
        if before is None or after is None:
            why = "没有动作前的页面快照" if before is None else "动作后页面不可读"
            return [Check("web_page_sane", True, f"{why}（未评估）", "cdp", evaluated=False, source="cdp_probe"),
                    Check("web_state_transition", True, f"{why}（未评估）", "cdp", evaluated=False, source="cdp_probe")]
        # a11y-snapshot corroboration is compared like-with-like (first vs last observation of THIS task)
        first_obs, last_obs = (self.web.samples[0], self.web.samples[-1]) if self.web.samples else (None, None)
        tr = web_transitions(before, after, self.web.clicks)
        if first_obs is not None and last_obs is not None and first_obs is not last_obs:
            tr2 = web_transitions(first_obs, last_obs, self.web.clicks)
            for k in ("dom_mutated", "aria_expanded_true", "url_changed", "tab_switched", "title_changed"):
                tr[k] = bool(tr[k] or tr2[k])
            tr["added"], tr["removed"] = max(tr["added"], tr2["added"]), max(tr["removed"], tr2["removed"])
        url, title = after.url, after.title
        bad = url.startswith(("chrome-error://", "about:blank", "edge-error://", "devtools://", "chrome-extension://")) or not url or bool(re.search(r"ERR_[A-Z_]+|无法访问此网站|can.?t be reached|404 not found|DNS_PROBE|chrome-devtools-mcp", title, re.I))
        out = [Check("web_page_sane", not bad, f"url={url[:70] or '空'} title={title[:30]!r}", "cdp", source=after.source or "cdp_probe")]
        strong = tr["url_changed"] or tr["aria_expanded_true"] or tr["tab_switched"]
        hay = " ".join([url, title, " ".join(after.expanded), " ".join(sorted(after.names))[:6000], " ".join(self.web.clicks)])
        tgt = (g.target or "").strip()
        tgt_hit = (not tgt) or (len(tgt) < 2) or (tgt.lower() in unquote(hay).lower())
        ok = (strong or tr["dom_mutated"]) and not bad and (strong or tgt_hit)
        if g.intent == "expand":
            ok = ok and (tr["aria_expanded_true"] or tr["dom_mutated"])
        detail = web_evidence_text(tr) + f" · 控件 +{tr['added']}/-{tr['removed']}" + (f" · 展开={tr['new_expanded'][:2]}" if tr["new_expanded"] else "") + (f" · 目标「{tgt}」{'✓' if tgt_hit else '✗未出现在页面/点击记录'}" if tgt else "")
        if tr["url_changed"]:
            detail += f" · {before.url[:42]} → {after.url[:60]}"
        out.append(Check("web_state_transition", bool(ok), detail, "cdp", source=(before.source or "") + "→" + (after.source or "")))
        return out

    async def _goal_extra_checks(self, goals: list["GoalSchema"]) -> list[Check]:
        out: list[Check] = []
        for g in goals:
            if isinstance(g, PptCreateGoal):
                out += await asyncio.to_thread(check_pptx, Path(g.path), g.min_slides)
        return out

    @staticmethod
    def _placeholders(goals: list["GoalSchema"], checks: list[Check]) -> list[Check]:
        """Every REQUIRED postcondition of every goal must appear in the evidence; a missing one becomes an explicit evaluated=False check (=> never `full`)."""
        have = {c.name for c in checks}
        for g in goals:
            for name in g.required_postconditions():
                if name not in have:
                    checks.append(Check(name, True, "未能由独立数据源评估", g.oracle_kind(), evaluated=False, source="unavailable"))
                    have.add(name)
        return checks

    @staticmethod
    def finalize(checks: list[Check], goals: list["GoalSchema"]) -> Verdict:
        goal_names = {n for g in goals for n in g.required_postconditions()}
        for c in checks:
            c.required = c.kind != "sanity" and (not goal_names or c.name in goal_names or c.kind in ("file", "cdp", "quota", "recycle", "ppt", "gmail"))
        req = [c for c in checks if c.required]
        bad = [c for c in checks if not c.ok]
        passed = [c for c in req if c.evaluated and c.ok]
        if not goals or not req:
            cov = "none"
        elif len(passed) == len(req) and not bad:
            cov = "full"
        elif passed:
            cov = "partial"
        else:
            cov = "none"
        v = Verdict(ok=not bad, checks=checks, coverage=cov, goals=[g.as_dict() for g in goals], required_total=len(req), required_passed=len(passed))
        v.status = terminal_from_verdict(v)
        return v

    def verify_written_file(self, path: Path, data: bytes) -> Verdict:
        cs = self.check_file(path, expect_bytes=data)
        bad = [c for c in cs if not c.ok]
        v = Verdict(ok=not bad, checks=cs, coverage="full", diagnosis="" if not bad else "；".join(f"{c.name}:{c.detail}" for c in bad),
                    goals=[FileCreateGoal(str(path), None).as_dict()], required_total=len(cs), required_passed=len(cs) - len(bad))
        v.status = terminal_from_verdict(v)
        if bad:
            self.rejections += 1
        else:
            self.passes += 1
            o = self.reg.register_file(path)
            o.set_state("sha256:" + sha256_file(path)[:16], 0)
        self.last = v
        return v


# ======================================================================================================================= v16.2 terminal states + strongly-typed goals
class TaskStatus(str, Enum):
    completed_verified = "completed_verified"
    partially_completed = "partially_completed"
    unverified = "unverified"
    paused_for_user = "paused_for_user"
    failed = "failed"
    aborted = "aborted"


TERMINAL_STATUSES = tuple(x.value for x in TaskStatus)
_LEGACY = {"done": "unverified", "blocked_needs_human": "paused_for_user", "blocked_security": "aborted", "maxsteps": "failed", "timeout": "failed", "error": "failed",
           "api_key": "aborted", "cancelled": "aborted", "failed": "failed"}


EXTRA_TERMINAL = ("needs_clarification",)  # v16.4: intent-completeness gate (no GUI action was taken); reported next to `failed`, never counted as success


def canonical_status(raw: str) -> str:
    """Map any internal/legacy status string onto the six sanctioned terminal states ('done' is NEVER assumed to be verified); v16.4 adds needs_clarification."""
    if raw in EXTRA_TERMINAL:
        return raw
    return raw if raw in TERMINAL_STATUSES else _LEGACY.get(raw, "failed")


def terminal_from_verdict(v: "Verdict") -> str:
    """Hard invariant: only coverage == full (all required postconditions passed on independent oracles) may yield completed_verified."""
    if not v.ok:
        return TaskStatus.failed.value
    return {"full": TaskStatus.completed_verified, "partial": TaskStatus.partially_completed}.get(v.coverage, TaskStatus.unverified).value


def may_commit(v: "Verdict") -> bool:
    return bool(v.ok and v.coverage == "full" and v.required_total > 0 and v.required_passed == v.required_total)


@dataclass(frozen=True)
class GoalSchema:
    def required_postconditions(self) -> tuple[str, ...]:
        return ()

    def oracle_kind(self) -> str:
        return "misc"

    def as_dict(self) -> dict[str, Any]:
        d = {k: getattr(self, k) for k in self.__dataclass_fields__}
