    def report(self) -> dict:
        return self.tel.summary()


# ------------------------------------------------------------------------------------------------------------------------ Windows port
class Win32Port:
    """Real Windows implementation (ctypes, no third-party deps).  Every sync Win32 call runs in a worker thread so `wait_for` can abandon it."""

    VK = {"ctrl": 0x11, "control": 0x11, "alt": 0x12, "shift": 0x10, "win": 0x5B, "enter": 0x0D, "return": 0x0D, "esc": 0x1B, "escape": 0x1B, "tab": 0x09, "delete": 0x2E,
          "del": 0x2E, "backspace": 0x08, "space": 0x20, "end": 0x23, "home": 0x24, "left": 0x25, "up": 0x26, "right": 0x27, "down": 0x28, "pageup": 0x21, "pagedown": 0x22}

    def __init__(self) -> None:
        if sys.platform != "win32":
            raise ControllerError("PLATFORM", "Win32Port 只能在 Windows 上使用")
        import ctypes

        self.ct = ctypes
        self.u = ctypes.windll.user32  # type: ignore[attr-defined]
        self.k = ctypes.windll.kernel32  # type: ignore[attr-defined]
        try:
            self.u.SetProcessDPIAware()
        except Exception:  # noqa: BLE001
            pass

    # -- sync helpers -------------------------------------------------------------------------------------------------
    def _vk(self, k: str) -> int:
        k = k.strip().lower()
        if k in self.VK:
            return self.VK[k]
        if re.fullmatch(r"f([1-9]|1[0-2])", k):
            return 0x6F + int(k[1:])
        if len(k) == 1:
            return self.u.VkKeyScanW(ord(k)) & 0xFF
        raise ControllerError("KEY", f"未知按键 {k!r}")

    def _send_vk(self, vk: int, up: bool) -> None:
        self.u.keybd_event(vk, 0, 0x0002 if up else 0, 0)

    def _key_sync(self, keys: str) -> None:
        parts = [self._vk(p) for p in re.split(r"\s*\+\s*", keys.strip()) if p]
        for vk in parts:
            self._send_vk(vk, False)
        for vk in reversed(parts):
            self._send_vk(vk, True)

    def _type_sync(self, text: str) -> None:
        ct = self.ct
        from ctypes import wintypes

        class KI(ct.Structure):
            _fields_ = [("wVk", wintypes.WORD), ("wScan", wintypes.WORD), ("dwFlags", wintypes.DWORD), ("time", wintypes.DWORD), ("dwExtraInfo", ct.c_void_p)]

        class MI(ct.Structure):
            _fields_ = [("dx", wintypes.LONG), ("dy", wintypes.LONG), ("mouseData", wintypes.DWORD), ("dwFlags", wintypes.DWORD), ("time", wintypes.DWORD), ("dwExtraInfo", ct.c_void_p)]

        class U(ct.Union):
            _fields_ = [("ki", KI), ("mi", MI)]

        class INP(ct.Structure):
            _fields_ = [("type", wintypes.DWORD), ("u", U)]

        units = text.encode("utf-16-le")
        for i in range(0, len(units), 2):
            cu = int.from_bytes(units[i:i + 2], "little")
            for flags in (0x0004, 0x0004 | 0x0002):  # KEYEVENTF_UNICODE (+KEYUP)
                inp = INP(1, U(ki=KI(0, cu, flags, 0, None)))
                self.u.SendInput(1, ct.byref(inp), ct.sizeof(INP))

    def _fg(self) -> int:
        return int(self.u.GetForegroundWindow() or 0)

    def _focus_sync(self, hwnd: int) -> bool:
        ct = self.ct
        if self.u.IsIconic(hwnd):
            self.u.ShowWindow(hwnd, 9)
        fg = self.u.GetForegroundWindow()
        cur = self.k.GetCurrentThreadId()
        tgt = self.u.GetWindowThreadProcessId(hwnd, None)
        fgt = self.u.GetWindowThreadProcessId(fg, None) if fg else 0
        try:
            if fgt and fgt != cur:
                self.u.AttachThreadInput(cur, fgt, True)
            if tgt and tgt != cur:
                self.u.AttachThreadInput(cur, tgt, True)
            self.u.BringWindowToTop(hwnd)
            self.u.SetForegroundWindow(hwnd)
        finally:
            if fgt and fgt != cur:
                self.u.AttachThreadInput(cur, fgt, False)
            if tgt and tgt != cur:
                self.u.AttachThreadInput(cur, tgt, False)
        del ct
        return self._fg() == hwnd

    def _hit_sync(self, x: int, y: int) -> int:
        from ctypes import wintypes

        pt = wintypes.POINT(int(x), int(y))
        h = self.u.WindowFromPoint(pt)
        return int(self.u.GetAncestor(h, 2) or h or 0) if h else 0  # GA_ROOT

    def _button_sync(self, x: int, y: int, double: bool) -> None:
        self.u.SetCursorPos(int(x), int(y))
        for _ in range(2 if double else 1):
            self.u.mouse_event(0x0002, 0, 0, 0, 0)
            self.u.mouse_event(0x0004, 0, 0, 0, 0)

    def _ime_sync(self, hwnd: int, op: str) -> bool:
        ime = self.ct.windll.imm32.ImmGetDefaultIMEWnd(hwnd)  # type: ignore[attr-defined]
        if not ime:
            return False
        if op == "get":
            return bool(self.u.SendMessageW(ime, 0x0283, 0x0005, 0))  # WM_IME_CONTROL / IMC_GETOPENSTATUS
        self.u.SendMessageW(ime, 0x0283, 0x0006, 0)  # IMC_SETOPENSTATUS=0 (close => English/direct input)
        return True

    # -- async port ---------------------------------------------------------------------------------------------------
    async def foreground(self) -> int:
        return await asyncio.to_thread(self._fg)

    async def focus(self, hwnd: int) -> bool:
        return await asyncio.to_thread(self._focus_sync, int(hwnd))

    async def hit_root(self, x: int, y: int) -> int:
        return await asyncio.to_thread(self._hit_sync, x, y)

    async def move(self, x: int, y: int) -> None:
        await asyncio.to_thread(self.u.SetCursorPos, int(x), int(y))

    async def button(self, x: int, y: int, double: bool = False) -> None:
        await asyncio.to_thread(self._button_sync, x, y, double)

    async def key(self, keys: str) -> None:
        await asyncio.to_thread(self._key_sync, keys)

    async def type_text(self, text: str) -> None:
        await asyncio.to_thread(self._type_sync, text)

    async def clipboard_get(self) -> Optional[str]:
        from .skills.wechat_io import _Clip

        return await asyncio.to_thread(_Clip.get)

    async def clipboard_set(self, text: str) -> None:
        from .skills.wechat_io import _Clip

        await asyncio.to_thread(_Clip.set, text)

    async def ime_open(self, hwnd: int) -> bool:
        return await asyncio.to_thread(self._ime_sync, int(hwnd), "get")

    async def ime_close(self, hwnd: int) -> bool:
        return await asyncio.to_thread(self._ime_sync, int(hwnd), "set")

    async def read_text(self, rect: Optional[list] = None) -> str:
        """editor read-back: select-all + copy through a clipboard sentinel (proves the copy happened)."""
        sentinel = f"__rt_sentinel_{time.time_ns()}__"
        await self.clipboard_set(sentinel)
        await self.key("ctrl+a")
        await self.key("ctrl+c")
        await asyncio.sleep(0.08)
        got = await self.clipboard_get()
        return "" if (got is None or got == sentinel) else got

    async def frame_sig(self, rect: Optional[list] = None) -> str:
        def _sig() -> str:
            from PIL import ImageGrab

            img = ImageGrab.grab(bbox=tuple(int(v) for v in ([rect[0], rect[1], rect[0] + rect[2], rect[1] + rect[3]] if rect else (0, 0, 0, 0))) if rect else None, all_screens=True)
            g = img.convert("L").resize((16, 16))
            px = list(g.getdata())
            avg = sum(px) / len(px)
            return "".join("1" if p > avg else "0" for p in px)

        return await asyncio.to_thread(_sig)

    async def sleep(self, s: float) -> None:
        await asyncio.sleep(s)
