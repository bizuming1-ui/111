// Minimal CDP client (Node >= 22 global WebSocket) + isolated browser takeover.
import { spawn } from "node:child_process";
import { existsSync } from "node:fs";

type Json = Record<string, any>;
type Pending = { resolve: (v: any) => void; reject: (e: Error) => void; method: string; timer: NodeJS.Timeout };

export class Cdp {
  private ws!: WebSocket;
  private seq = 0;
  private pending = new Map<number, Pending>();
  private handlers = new Map<string, Array<(p: Json, sessionId?: string) => void>>();
  closed = false;
  onClose?: () => void;

  static async connect(wsUrl: string): Promise<Cdp> {
    const c = new Cdp();
    c.ws = new WebSocket(wsUrl);
    await new Promise<void>((res, rej) => {
      c.ws.addEventListener("open", () => res(), { once: true });
      c.ws.addEventListener("error", () => rej(new Error("CDP websocket error")), { once: true });
    });
    c.ws.addEventListener("message", (ev: MessageEvent) => c.onMessage(String(ev.data)));
    c.ws.addEventListener("close", () => {
      c.closed = true;
      for (const [, p] of c.pending) { clearTimeout(p.timer); p.reject(new Error("CDP closed")); }
      c.pending.clear();
      try { c.onClose?.(); } catch { /* ignore */ }
    });
    return c;
  }

  private onMessage(raw: string) {
    let m: Json;
    try { m = JSON.parse(raw); } catch { return; }
    if (m.id !== undefined) {
      const p = this.pending.get(m.id);
      if (!p) return;
      this.pending.delete(m.id);
      clearTimeout(p.timer);
      if (m.error) p.reject(new Error(`${p.method}: ${m.error.message ?? JSON.stringify(m.error)}`));
      else p.resolve(m.result ?? {});
    } else if (m.method) {
      for (const h of this.handlers.get(m.method) ?? []) { try { h(m.params ?? {}, m.sessionId); } catch { /* handler isolation */ } }
    }
  }

  on(method: string, cb: (p: Json, sessionId?: string) => void) {
    const l = this.handlers.get(method) ?? [];
    l.push(cb);
    this.handlers.set(method, l);
  }

  send(method: string, params: Json = {}, sessionId?: string, timeoutMs = 15000): Promise<any> {
    if (this.closed) return Promise.reject(new Error("CDP closed"));
    const id = ++this.seq;
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => { this.pending.delete(id); reject(new Error(`${method}: timeout ${timeoutMs}ms`)); }, timeoutMs);
      this.pending.set(id, { resolve, reject, method, timer });
      const msg: Json = { id, method, params };
      if (sessionId) msg.sessionId = sessionId;
      this.ws.send(JSON.stringify(msg));
    });
  }

  close() { try { this.ws.close(); } catch { /* ignore */ } }
}

