#=#=# FILE: dscu-driver/crates/dscu-core/src/ahash.rs
//! 48x32 grayscale fingerprint + 64-bit aHash. Bit-exact with `Get-RegionAHash` of the v7.1 client
//! (verified against vectors produced by the original PowerShell function, see testvectors/ahash.json).
pub const SIG_W: usize = 48;
pub const SIG_H: usize = 32;
pub const SIG_LEN: usize = SIG_W * SIG_H;

/// 48x32 gray -> 8x8 block means (6x4 px each) -> bit i (i = by*8+bx) set when block > mean of all blocks.
/// Integer arithmetic: block > mean  <=>  sum_i * 64 > total   (no float rounding, exact ties handled).
pub fn ahash_from_sig(sig: &[u8]) -> Option<u64> {
    if sig.len() != SIG_LEN {
        return None;
    }
    let mut sums = [0u32; 64];
    for by in 0..8 {
        for bx in 0..8 {
            let mut s = 0u32;
            for y in 0..4 {
                let row = (by * 4 + y) * SIG_W + bx * 6;
                for x in 0..6 {
                    s += sig[row + x] as u32;
                }
            }
            sums[by * 8 + bx] = s;
        }
    }
    let total: u64 = sums.iter().map(|s| *s as u64).sum();
    let mut bits = 0u64;
    for (i, s) in sums.iter().enumerate() {
        if (*s as u64) * 64 > total {
            bits |= 1u64 << i;
        }
    }
    Some(bits)
}

pub fn ahash_hex(sig: &[u8]) -> Option<String> {
    ahash_from_sig(sig).map(|b| format!("{b:016x}"))
}

/// Hamming distance between two 16-hex-digit hashes; 64 when either is invalid (same as `Measure-HashDistance`).
pub fn hamming(a: &str, b: &str) -> u32 {
    match (u64::from_str_radix(a.trim(), 16), u64::from_str_radix(b.trim(), 16)) {
        (Ok(x), Ok(y)) if a.trim().len() <= 16 && b.trim().len() <= 16 => (x ^ y).count_ones(),
        _ => 64,
    }
}

/// BGRA (or BGRX) pixels -> 48x32 gray signature. Gray = (299R + 587G + 114B) / 1000 (integer, as in DsPhase5Native70).
/// Each output cell box-averages up to 8x8 sample points of its source rectangle: O(1536*64) regardless of region size.
pub fn gray_sig_from_bgra(data: &[u8], stride: usize, w: usize, h: usize) -> Vec<u8> {
    let mut out = vec![0u8; SIG_LEN];
    if w == 0 || h == 0 || data.len() < stride * (h - 1) + w * 4 {
        return out;
    }
    for cy in 0..SIG_H {
        let y0 = cy * h / SIG_H;
        let y1 = (((cy + 1) * h) / SIG_H).max(y0 + 1).min(h);
        let sy = ((y1 - y0) / 8).max(1);
        for cx in 0..SIG_W {
            let x0 = cx * w / SIG_W;
            let x1 = (((cx + 1) * w) / SIG_W).max(x0 + 1).min(w);
            let sx = ((x1 - x0) / 8).max(1);
            let (mut acc, mut n) = (0u32, 0u32);
            let mut y = y0;
            while y < y1 {
                let row = y * stride;
                let mut x = x0;
                while x < x1 {
                    let p = row + x * 4;
                    let (b, g, r) = (data[p] as u32, data[p + 1] as u32, data[p + 2] as u32);
                    acc += (299 * r + 587 * g + 114 * b) / 1000;
                    n += 1;
                    x += sx;
                }
                y += sy;
            }
            out[cy * SIG_W + cx] = (acc / n.max(1)) as u8;
        }
    }
    out
}

/// Fraction (0..100, 1 decimal) of cells whose luminance differs by >= 10 (same as `Get-PixelDiff`).
pub fn pixel_diff_pct(a: &[u8], b: &[u8]) -> Option<f64> {
    if a.is_empty() || a.len() != b.len() {
        return None;
    }
    let n = a.iter().zip(b).filter(|(x, y)| (**x as i32 - **y as i32).abs() >= 10).count();
    Some((1000.0 * n as f64 / a.len() as f64).round() / 10.0)
}

