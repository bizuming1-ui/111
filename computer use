using System;
using System.Runtime.InteropServices;
using System.Text;

// DsJob63：Win32 Job Object 配额（KILL_ON_JOB_CLOSE：代理退出 / 急停时强制清理派生进程树）+ 最终路径解析（GetFinalPathNameByHandle）+ 硬链接计数
public static class DsJob63 {
    [StructLayout(LayoutKind.Sequential)] struct IO_COUNTERS { public ulong ReadOperationCount, WriteOperationCount, OtherOperationCount, ReadTransferCount, WriteTransferCount, OtherTransferCount; }
    [StructLayout(LayoutKind.Sequential)] struct JOBOBJECT_BASIC_LIMIT_INFORMATION { public long PerProcessUserTimeLimit; public long PerJobUserTimeLimit; public uint LimitFlags; public UIntPtr MinimumWorkingSetSize; public UIntPtr MaximumWorkingSetSize; public uint ActiveProcessLimit; public UIntPtr Affinity; public uint PriorityClass; public uint SchedulingClass; }
    [StructLayout(LayoutKind.Sequential)] struct JOBOBJECT_EXTENDED_LIMIT_INFORMATION { public JOBOBJECT_BASIC_LIMIT_INFORMATION BasicLimitInformation; public IO_COUNTERS IoInfo; public UIntPtr ProcessMemoryLimit; public UIntPtr JobMemoryLimit; public UIntPtr PeakProcessMemoryUsed; public UIntPtr PeakJobMemoryUsed; }
    [StructLayout(LayoutKind.Sequential)] struct JOBOBJECT_BASIC_UI_RESTRICTIONS { public uint UIRestrictionsClass; }
    [StructLayout(LayoutKind.Sequential)] struct JOBOBJECT_BASIC_ACCOUNTING_INFORMATION { public long TotalUserTime, TotalKernelTime, ThisPeriodTotalUserTime, ThisPeriodTotalKernelTime; public uint TotalPageFaultCount, TotalProcesses, ActiveProcesses, TotalTerminatedProcesses; }
    [StructLayout(LayoutKind.Sequential)] struct FILETIME2 { public uint Lo, Hi; }
    [StructLayout(LayoutKind.Sequential)] struct BY_HANDLE_FILE_INFORMATION { public uint FileAttributes; public FILETIME2 CreationTime, LastAccessTime, LastWriteTime; public uint VolumeSerialNumber, FileSizeHigh, FileSizeLow, NumberOfLinks, FileIndexHigh, FileIndexLow; }

    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern IntPtr CreateJobObjectW(IntPtr attrs, string name);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool SetInformationJobObject(IntPtr job, int cls, IntPtr info, uint cb);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool QueryInformationJobObject(IntPtr job, int cls, IntPtr info, uint cb, IntPtr ret);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool AssignProcessToJobObject(IntPtr job, IntPtr process);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool TerminateJobObject(IntPtr job, uint code);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool CloseHandle(IntPtr h);
    [DllImport("kernel32.dll")] static extern IntPtr GetCurrentProcess();
    [DllImport("kernel32.dll", SetLastError = true)] static extern IntPtr OpenProcess(uint access, bool inherit, uint pid);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern IntPtr CreateFileW(string name, uint access, uint share, IntPtr sec, uint disp, uint flags, IntPtr tmpl);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern uint GetFinalPathNameByHandleW(IntPtr h, StringBuilder buf, uint len, uint flags);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool GetFileInformationByHandle(IntPtr h, out BY_HANDLE_FILE_INFORMATION info);
    [DllImport("user32.dll")] static extern uint GetWindowThreadProcessId(IntPtr hwnd, out uint pid);

    const uint KILL_ON_CLOSE = 0x2000, ACTIVE_PROC = 0x8, PROC_MEM = 0x100;
    static IntPtr guard = IntPtr.Zero, exec = IntPtr.Zero, apps = IntPtr.Zero;
    static uint execMax = 32; static ulong execMem = 2147483648UL;
    public static string LastError = "";

    static IntPtr NewJob(uint flags, uint maxProc, ulong procMem, uint uiMask) {
        IntPtr j = CreateJobObjectW(IntPtr.Zero, null);
        if (j == IntPtr.Zero) { LastError = "CreateJobObjectW " + Marshal.GetLastWin32Error(); return IntPtr.Zero; }
        var ext = new JOBOBJECT_EXTENDED_LIMIT_INFORMATION();
        ext.BasicLimitInformation.LimitFlags = flags;
        if ((flags & ACTIVE_PROC) != 0) ext.BasicLimitInformation.ActiveProcessLimit = maxProc;
        if ((flags & PROC_MEM) != 0) ext.ProcessMemoryLimit = new UIntPtr(procMem);
        int sz = Marshal.SizeOf(typeof(JOBOBJECT_EXTENDED_LIMIT_INFORMATION));
        IntPtr p = Marshal.AllocHGlobal(sz);
        try {
            Marshal.StructureToPtr(ext, p, false);
            if (!SetInformationJobObject(j, 9, p, (uint)sz)) { LastError = "SetInformationJobObject(limits) " + Marshal.GetLastWin32Error(); CloseHandle(j); return IntPtr.Zero; }
        } finally { Marshal.FreeHGlobal(p); }
        if (uiMask != 0) {
            var ui = new JOBOBJECT_BASIC_UI_RESTRICTIONS(); ui.UIRestrictionsClass = uiMask;
            int sz2 = Marshal.SizeOf(typeof(JOBOBJECT_BASIC_UI_RESTRICTIONS)); IntPtr p2 = Marshal.AllocHGlobal(sz2);
            try { Marshal.StructureToPtr(ui, p2, false); if (!SetInformationJobObject(j, 4, p2, (uint)sz2)) LastError = "SetInformationJobObject(ui) " + Marshal.GetLastWin32Error(); }
            finally { Marshal.FreeHGlobal(p2); }
        }
        return j;
    }
    // 守护作业：本进程自己加入，KILL_ON_JOB_CLOSE：代理进程退出（含崩溃 / 被杀）时，所有派生子进程树由系统强制清理
    public static bool InitGuard() {
        if (guard != IntPtr.Zero) return true;
        IntPtr j = NewJob(KILL_ON_CLOSE, 0, 0, 0);
        if (j == IntPtr.Zero) return false;
        if (!AssignProcessToJobObject(j, GetCurrentProcess())) { LastError = "AssignProcessToJobObject(self) " + Marshal.GetLastWin32Error(); CloseHandle(j); return false; }
        guard = j; return true;
    }
    // 执行作业：run_process 子进程：进程数上限（防 fork 炸弹）+ 单进程内存上限 + UI 限制（禁止切桌面 / 改显示 / 注销 / 读写剪贴板 / 访问外部窗口句柄）
    public static bool InitExec(uint maxProcesses, ulong procMemBytes) {
        if (exec != IntPtr.Zero) return true;
        execMax = maxProcesses; execMem = procMemBytes;
        exec = NewJob(KILL_ON_CLOSE | ACTIVE_PROC | PROC_MEM, maxProcesses, procMemBytes, 0xFF);
        return exec != IntPtr.Zero;
    }
    // 应用作业：launch 启动的 GUI 程序（浏览器等）：只有 KILL_ON_CLOSE，没有进程数 / UI 限制
    public static bool InitApps() {
        if (apps != IntPtr.Zero) return true;
        apps = NewJob(KILL_ON_CLOSE, 0, 0, 0);
        return apps != IntPtr.Zero;
    }
    static bool AssignTo(IntPtr job, int pid) {
        if (job == IntPtr.Zero) return false;
        IntPtr h = OpenProcess(0x0101, false, (uint)pid);   // PROCESS_SET_QUOTA | PROCESS_TERMINATE
        if (h == IntPtr.Zero) { LastError = "OpenProcess " + Marshal.GetLastWin32Error(); return false; }
        try { if (!AssignProcessToJobObject(job, h)) { LastError = "Assign " + Marshal.GetLastWin32Error(); return false; } return true; }
        finally { CloseHandle(h); }
    }
    public static bool AssignExec(int pid) { return AssignTo(exec, pid); }
    public static bool AssignApps(int pid) { return AssignTo(apps, pid); }
    public static int Active(bool execJob) {
        IntPtr j = execJob ? exec : apps; if (j == IntPtr.Zero) return -1;
        int sz = Marshal.SizeOf(typeof(JOBOBJECT_BASIC_ACCOUNTING_INFORMATION)); IntPtr p = Marshal.AllocHGlobal(sz);
        try { if (!QueryInformationJobObject(j, 1, p, (uint)sz, IntPtr.Zero)) return -1; return (int)((JOBOBJECT_BASIC_ACCOUNTING_INFORMATION)Marshal.PtrToStructure(p, typeof(JOBOBJECT_BASIC_ACCOUNTING_INFORMATION))).ActiveProcesses; }
        finally { Marshal.FreeHGlobal(p); }
    }
    // 终止执行作业里的整棵进程树，随后重建一个干净的执行作业（已终止的作业不再复用）
    public static bool KillExec() {
        if (exec == IntPtr.Zero) return false;
        bool ok = TerminateJobObject(exec, 1);
        CloseHandle(exec); exec = IntPtr.Zero;
        exec = NewJob(KILL_ON_CLOSE | ACTIVE_PROC | PROC_MEM, execMax, execMem, 0xFF);
        return ok;
    }
    public static bool KillApps() { return apps != IntPtr.Zero && TerminateJobObject(apps, 1); }
    public static int PidOfWindow(IntPtr hwnd) { uint pid; GetWindowThreadProcessId(hwnd, out pid); return (int)pid; }

    // 最终路径：打开句柄后让系统解析符号链接 / 目录联接 / 8.3 短名 / 大小写，返回真实路径（去掉 \\?\ 前缀）；失败返回 null
    public static string FinalPath(string path) {
        IntPtr h = CreateFileW(path, 0, 7, IntPtr.Zero, 3, 0x02000000, IntPtr.Zero);   // 访问 0 + FILE_FLAG_BACKUP_SEMANTICS：目录也能开
        if (h == new IntPtr(-1)) return null;
        try {
            var sb = new StringBuilder(1024);
            uint n = GetFinalPathNameByHandleW(h, sb, (uint)sb.Capacity, 0);
            if (n == 0 || n >= sb.Capacity) return null;
            string s = sb.ToString();
            if (s.StartsWith(@"\\?\UNC\")) return @"\\" + s.Substring(8);
            if (s.StartsWith(@"\\?\")) return s.Substring(4);
            return s;
        } finally { CloseHandle(h); }
    }
    public static int LinkCount(string path) {
        IntPtr h = CreateFileW(path, 0, 7, IntPtr.Zero, 3, 0x02000000, IntPtr.Zero);
        if (h == new IntPtr(-1)) return -1;
        try { BY_HANDLE_FILE_INFORMATION fi; if (!GetFileInformationByHandle(h, out fi)) return -1; return (int)fi.NumberOfLinks; }
        finally { CloseHandle(h); }
    }
}
