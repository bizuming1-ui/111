            $fp.Tool = [DsNative12]::IsToolWindow($h); $fp.Iconic = [DsNative12]::IsIconic($h); $fp.Area = [Math]::Max(0, ($r[2] - $r[0])) * [Math]::Max(0, ($r[3] - $r[1]))
