LIVE_LOCATIONS = ("desktop", "documents", "downloads")
ALL_LOCATIONS = LIVE_LOCATIONS + ("recyclebin",)
CHANNELS = ("uia", "cdp", "dxgi_dml", "ocr", "window_manager", "filesystem", "shell_com")
DEFAULT_TTL_S = {"uia": 2.0, "cdp": 2.0, "dxgi_dml": 1.5, "ocr": 3.0, "window_manager": 1.0, "filesystem": 3.0, "shell_com": 3.0}
_LOC_CHANNEL = {"recyclebin": "shell_com", "desktop": "filesystem", "documents": "filesystem", "downloads": "filesystem"}
_SKIP_NAMES = re.compile(r"^(?:desktop\.ini|thumbs\.db|\.ds_store)$|^~\$|\.(?:tmp|lnk\.tmp)$", re.I)


def _norm_path(p: str) -> str:
    return os.path.normcase(os.path.normpath(str(p))) if p else ""


def parse_shell_time(text: str) -> Optional[float]:
    """'2026/‎11/‎28 ‏‎18:10' (Explorer text with invisible LRM/RLM marks) → epoch seconds (local time).  None when unparsable."""
    s = re.sub(r"[\u200e\u200f\u202a-\u202e]", "", str(text or ""))
    m = re.search(r"(\d{4})[/\-.年](\d{1,2})[/\-.月](\d{1,2})日?\s*(?:(\d{1,2}):(\d{2}))?", s)
    if not m:
        return None
    try:
        import datetime as _dt

        y, mo, d = int(m.group(1)), int(m.group(2)), int(m.group(3))
        h, mi = int(m.group(4) or 0), int(m.group(5) or 0)
        return _dt.datetime(y, mo, d, h, mi).timestamp()
    except (ValueError, OverflowError):
        return None


# ====================================================================================================================== object identity
@dataclass(frozen=True)
class WorldObjectRef:
    """A frozen, cross-channel object reference (the WorldModel's `UnifiedObjectRef`; `to_unified()` bridges to unified_object.UnifiedObjectRef)."""
    location: str                  # desktop | documents | downloads | recyclebin
    name: str
    path: str = ""                 # live: absolute path · recyclebin: ORIGINAL path
    bin_path: str = ""             # recyclebin: backing `$R….ext`
    deleted_text: str = ""
    time_ts: Optional[float] = None
    size: int = 0
    is_dir: bool = False
    ordinal: int = 0               # 0-based position in the container's listing at `epoch`
    epoch: int = 0                 # snapshot epoch of the listing this ref was read from
    observed_at: float = 0.0
    source: str = ""
    fingerprint: str = ""          # live: "size:mtime" — object changed ⇒ fingerprint changed
    extra: dict = field(default_factory=dict, compare=False, hash=False)

    @property
    def identity(self) -> str:
        if self.location == "recyclebin":
            if self.bin_path:
                return "bin:" + _norm_path(self.bin_path)
            return f"bin:{unicodedata.normalize('NFKC', self.name).lower()}|{_norm_path(self.path)}|{self.deleted_text}|{self.size}"
        return "fs:" + _norm_path(self.path)

    def brief(self) -> str:
        if self.location == "recyclebin":
            return f"{self.name}（回收站#{self.ordinal + 1}；原位置 {self.path or '未知'}；{self.size}B；删除于 {self.deleted_text or '?'}）"
        return f"{self.name}（{self.location}；{self.path}；{self.size}B）"

    def to_unified(self) -> Any:
        """Bridge to the v18.0 cross-modal identity (unified_object.UnifiedObjectRef) so GUI-route fallbacks share ONE identity vocabulary."""
        from .unified_object import UnifiedObjectRef  # lazy: keeps this module dependency-free

        return UnifiedObjectRef(object_id=self.identity, application_id="explorer.exe", window_id=0, snapshot_epoch=self.epoch, semantic_role="listitem",
                                accessible_name=self.name, business_identity=self.identity, dom_identity="", uia_identity="", visual_bbox=(0, 0, 0, 0),
                                coordinate_space="screen_physical", confidence=1.0, last_seen=self.observed_at, state={"location": self.location},
                                action_role="target", sources=("shell_com" if self.location == "recyclebin" else "filesystem",))


# ====================================================================================================================== providers (oracles)
class LocationProvider(Protocol):
    def list(self, location: str) -> list[WorldObjectRef]: ...  # ordered exactly as the user would count them


class FileSystemProvider:
    """Lists FILES of the authorized live folders.  Order = Explorer's default (name, case-insensitive).  Never recurses; never follows reparse points."""

    def __init__(self, roots: dict[str, Path]) -> None:
        self.roots = {k: Path(v) for k, v in roots.items()}

    def list(self, location: str) -> list[WorldObjectRef]:
        root = self.roots.get(location)
        if root is None or not root.is_dir():
            return []
        out: list[WorldObjectRef] = []
        try:
            entries = sorted(root.iterdir(), key=lambda p: unicodedata.normalize("NFKC", p.name).casefold())
        except OSError:
            return []
        for p in entries:
            try:
                if _SKIP_NAMES.search(p.name) or p.is_symlink():
                    continue
                st = p.stat()
                out.append(WorldObjectRef(location=location, name=p.name, path=str(p), time_ts=st.st_mtime, size=int(st.st_size), is_dir=p.is_dir(),
                                          ordinal=len(out), source="filesystem", fingerprint=f"{int(st.st_size)}:{int(st.st_mtime)}"))
            except OSError:
                continue
        return out


class RecycleBinProvider:
    """Recycle Bin through a recycle_bin.ShellBackend (production: ComBackend → Shell.Application.NameSpace(10); tests: FakeBackend)."""

    def __init__(self, backend: Any) -> None:
        self.backend = backend

    def list(self, location: str) -> list[WorldObjectRef]:
        if location != "recyclebin":
            return []
        out: list[WorldObjectRef] = []
        for i, it in enumerate(self.backend.list_items()):
            out.append(WorldObjectRef(location="recyclebin", name=it.name, path=it.original, bin_path=it.bin_path, deleted_text=it.deleted, time_ts=parse_shell_time(it.deleted),
                                      size=int(it.size or 0), is_dir=bool(it.is_dir), ordinal=i, source="shell_com", extra={"item": it}))
        return out


class CompositeProvider:
    def __init__(self, fs: Optional[LocationProvider], bin_: Optional[LocationProvider]) -> None:
        self.fs, self.bin = fs, bin_

    def list(self, location: str) -> list[WorldObjectRef]:
        p = self.bin if location == "recyclebin" else self.fs
        return p.list(location) if p is not None else []


