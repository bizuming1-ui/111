class TailPort:
    def __init__(self, hang_every=0, hwnd=1):
        self.n, self.hang, self.hwnd, self.clip, self.text, self.keys = 0, hang_every, hwnd, "", "", []

    async def foreground(self): return self.hwnd
    async def focus(self, h): return True
    async def hit_root(self, x, y): return self.hwnd if x < 1000 else 7
    async def move(self, x, y): return None

    async def button(self, x, y, d=False):
        self.n += 1
        await asyncio.sleep(2.0 if (self.hang and self.n % self.hang == 0) else 0.001)

    async def key(self, k):
        self.keys.append(k)
        if k == "ctrl+v":
            self.text = self.clip
        if k == "delete":
            self.text = ""

    async def type_text(self, t): self.text += t
    async def clipboard_get(self): return self.clip
    async def clipboard_set(self, t): self.clip = t
    async def ime_open(self, h): return True
    async def ime_close(self, h): return True
    async def read_text(self, r=None): return self.text
    async def frame_sig(self, r=None): return "s"
    async def sleep(self, s): return None


class TestRealtime(unittest.TestCase):
