#=#=# FILE: dscu-v9/benches/fingerprint.rs
//! criterion: Rust aHash / pixel-diff vs the PowerShell `Get-RegionAHash` baseline (run `-VerifyPhase7 -Bench` to print both).
use criterion::{criterion_group, criterion_main, Criterion};
use dscu_v9::{ahash, ring};
use std::hint::black_box;

fn bench(c: &mut Criterion) {
    let a: Vec<u8> = (0..1536).map(|i| ((i * 37) % 256) as u8).collect();
    let b: Vec<u8> = a.iter().map(|v| v.wrapping_add(((*v as usize) % 3) as u8 * 9)).collect();
    c.bench_function("ahash_48x32", |bn| bn.iter(|| ahash::ahash_from_sig(black_box(&a))));
    c.bench_function("pixel_diff_48x32", |bn| bn.iter(|| ahash::pixel_diff_pct(black_box(&a), black_box(&b), 10)));
    c.bench_function("block_mask_48x32", |bn| bn.iter(|| ahash::block_mask(black_box(&a), black_box(&b), 10, 6)));
    let (_h, v) = ring::HeapRing::new(8, 8 << 20).unwrap();
    let frame = vec![7u8; 1920 * 1080 * 4];
    let m = ring::FrameMeta { width: 1920, height: 1080, stride: 7680, format: ring::FMT_BGRA8, kind: ring::KIND_FULL, ..Default::default() };
    c.bench_function("ring_publish_1080p_bgra", |bn| bn.iter(|| v.publish(black_box(&m), black_box(&frame)).unwrap()));
    let mut out = Vec::new();
    c.bench_function("ring_read_1080p_bgra", |bn| bn.iter(|| v.read_latest(0, &mut out).unwrap()));
}
criterion_group!(benches, bench);
criterion_main!(benches);
