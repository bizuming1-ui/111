        from agent_brain.orchestrator import Brain

        self.cfg = Config()
        if not self.cfg.api_key:
            raise SystemExit("需要 DEEPSEEK_API_KEY（LLM 任务评测）。Tier-1 与 Tier-2 的无 LLM 场景无需密钥。")
        self.brain = Brain(self.cfg, say=lambda m: None)
        await self.brain.start()

    async def stop(self) -> None:
        if self.brain:
            await self.brain.stop()

    def meta(self) -> dict[str, Any]:
        from agent_brain.prompts import PLANNER_PROMPT, SYSTEM_PREFIX

        return {"version": VERSION, "model": self.cfg.model, "vision_model": self.cfg.vision_model, "driver": self.brain.hub.driver_kind,
                "system_prompt_sha256": hashlib.sha256(SYSTEM_PREFIX.encode()).hexdigest()[:16], "planner_prompt_sha256": hashlib.sha256(PLANNER_PROMPT.encode()).hexdigest()[:16],
                "python": sys.version.split()[0], "platform": sys.platform, "ts": time.strftime("%F %T")}

    async def rollout(self, task: dict[str, Any], k: int) -> Rollout:
