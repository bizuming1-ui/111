                            x.children.retain(|c| c.role != "button");
                        } else {
                            let dups: Vec<RawNode> = x.children.iter().filter(|c| c.role == "button").map(|c| RawNode { key: format!("{}#dup", c.key), ..c.clone() }).collect();
                            x.children.extend(dups);
                        }
                        x.children.iter_mut().for_each(|c| walk(c, mode));
                    }
                    walk(root, mode);
                }
