using System;
using System.IO.MemoryMappedFiles;
using System.Threading;

// v9.0 Plane-2 in-process accelerators (pure BCL, no unsafe, no Windows-only calls except named mappings).
// Every routine is bit-exact with the PowerShell function it accelerates (verified by -SelfTest / -VerifyPhase7 against golden vectors).
public static class DsV9Fast
{
    public const int SigLen = 1536;

    // == Get-RegionAHash (48x32 gray -> 64-bit aHash) ==
    public static ulong AHash(byte[] sig)
    {
        long[] sums = new long[64];
        long total = 0;
        for (int by = 0; by < 8; by++)
            for (int bx = 0; bx < 8; bx++)
            {
                long s = 0;
                int b = by * 192 + bx * 6;
                for (int y = 0; y < 4; y++)
                {
                    int o = b + y * 48;
                    s += sig[o] + sig[o + 1] + sig[o + 2] + sig[o + 3] + sig[o + 4] + sig[o + 5];
                }
                sums[by * 8 + bx] = s;
                total += s;
            }
        ulong bits = 0;
        for (int i = 0; i < 64; i++) if (sums[i] * 64 > total) bits |= 1UL << i;
        return bits;
    }
    public static string AHashHex(byte[] sig)
    {
        if (sig == null || sig.Length != SigLen) return null;
        return AHash(sig).ToString("x16");
    }

    // == Get-PixelDiff: % of samples with |a-b| >= thr, [Math]::Round(x, 1) exactly as the PowerShell original ==
    public static double PixelDiffPct(byte[] a, byte[] b, int thr)
    {
        if (a == null || b == null || a.Length != b.Length || a.Length == 0) return -1.0;
        int n = 0;
        for (int i = 0; i < a.Length; i++)
        {
            int d = a[i] - b[i];
            if (d < 0) d = -d;
            if (d >= thr) n++;
        }
        return Math.Round(100.0 * n / a.Length, 1);
    }

    // 8x8 dirty-block mask (bit by*8+bx set when >= minPx of the block's 24 samples differ by >= thr)
    public static ulong BlockMask(byte[] a, byte[] b, int thr, int minPx)
    {
        if (a == null || b == null || a.Length != SigLen || b.Length != SigLen) return 0;
        ulong m = 0;
        for (int by = 0; by < 8; by++)
            for (int bx = 0; bx < 8; bx++)
            {
                int c = 0;
                for (int y = 0; y < 4; y++)
                {
                    int o = (by * 4 + y) * 48 + bx * 6;
                    for (int x = 0; x < 6; x++)
                    {
                        int d = a[o + x] - b[o + x];
                        if (d < 0) d = -d;
                        if (d >= thr) c++;
                    }
                }
                if (c >= minPx) m |= 1UL << (by * 8 + bx);
            }
        return m;
    }

    // == 48x32 BGRA(32bpp) -> gray signature with the SAME formula as Get-PixelSig: [byte][int](0.299*R + 0.587*G + 0.114*B) ==
    // [int] of a double in PowerShell rounds half-to-even, identical to Math.Round(double).
    public static byte[] SigFromBgra48x32(byte[] bgra, int stride)
    {
        if (bgra == null || stride < 48 * 4 || bgra.Length < stride * 31 + 48 * 4) return null;
        byte[] sig = new byte[SigLen];
        for (int y = 0; y < 32; y++)
        {
            int row = y * stride;
            for (int x = 0; x < 48; x++)
            {
                int p = row + x * 4;
                double g = 0.299 * bgra[p + 2] + 0.587 * bgra[p + 1] + 0.114 * bgra[p];
                sig[y * 48 + x] = (byte)(int)Math.Round(g);
            }
        }
        return sig;
    }

    // == canonical v9 signature straight from a full BGRA surface (same grid as vision-engine / CUDA / HLSL) ==
    public static byte[] GraySigFromSurface(byte[] bgra, int stride, int x, int y, int w, int h)
    {
        if (bgra == null || w < 16 || h < 16 || x < 0 || y < 0 || stride < (x + w) * 4 || bgra.Length < (long)stride * (y + h)) return null;
        byte[] sig = new byte[SigLen];
        const int K = 4;
        for (int dy = 0; dy < 32; dy++)
            for (int dx = 0; dx < 48; dx++)
            {
                uint acc = 0;
                for (int sy = 0; sy < K; sy++)
                    for (int sx = 0; sx < K; sx++)
                    {
                        int px = x + ((dx * K + sx) * 2 + 1) * w / (48 * K * 2);
                        int py = y + ((dy * K + sy) * 2 + 1) * h / (32 * K * 2);
                        int p = py * stride + px * 4;
                        acc += (uint)((77 * bgra[p + 2] + 150 * bgra[p + 1] + 29 * bgra[p]) >> 8);
                    }
                sig[dy * 48 + dx] = (byte)(acc / (K * K));
            }
        return sig;
    }
}

