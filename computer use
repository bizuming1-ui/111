#Requires -Version 7.0
# =====================================================================
#  CU 2.0 - DeepSeek Computer Use  (single file, PowerShell 7, Windows)
#
#  Run as file :  pwsh -ExecutionPolicy Bypass -File .\cu.ps1 "your task"
#  Self test   :  pwsh -ExecutionPolicy Bypass -File .\cu.ps1 /test
#  Or paste this whole script into a pwsh window and press Enter.
#
#  Env (optional): DEEPSEEK_API_KEY, CU_MODEL, CU_STEPS, CU_YOLO=1
#  Failsafe      : move the mouse to the top-left corner (0,0) to abort.
#
#  How it sees the PC (DeepSeek API is text-only, so no screenshots):
#    [BROWSER] DOM of a Chrome/Edge tab controlled over DevTools protocol
#    [UI]      Windows UI Automation tree of the foreground window
#  How it acts: DOM actions (b_*), mouse/keyboard (user32), PowerShell.
# =====================================================================

try { [Console]::OutputEncoding = [Text.Encoding]::UTF8 } catch { }
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

if (-not ('CU.Native' -as [type])) {
    Add-Type -TypeDefinition @'
using System;
using System.Text;
using System.Runtime.InteropServices;
namespace CU {
  public static class Native {
    [DllImport("user32.dll")] public static extern bool SetProcessDPIAware();
    [DllImport("user32.dll")] public static extern bool SetCursorPos(int x, int y);
    [DllImport("user32.dll")] public static extern void mouse_event(uint flags, int dx, int dy, int data, UIntPtr extra);
    [DllImport("user32.dll")] public static extern void keybd_event(byte vk, byte scan, uint flags, UIntPtr extra);
    [DllImport("user32.dll")] public static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr h);
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr h, int cmd);
    [DllImport("user32.dll")] public static extern bool IsIconic(IntPtr h);
    [DllImport("user32.dll")] public static extern uint GetWindowThreadProcessId(IntPtr h, out uint pid);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] public static extern int GetWindowText(IntPtr h, StringBuilder sb, int max);
    public static string Title(IntPtr h) { var sb = new StringBuilder(256); GetWindowText(h, sb, 256); return sb.ToString(); }
    public static int PidOf(IntPtr h) { uint p; GetWindowThreadProcessId(h, out p); return (int)p; }
