// [Zone: Toolbar] vs [Zone: Row[id]] model — pure, DOM-free (unit-testable).  The in-page collector (ZONE_COLLECTOR_JS)
// only gathers geometry/ancestry facts; every decision is made here.
export interface Box { l: number; t: number; w: number; h: number }
export interface RowNode { idx: number; box: Box }
export interface BtnNode {
  id: number; name: string; box: Box; visible: boolean; covered?: boolean
  ancestorToolbar: boolean       // closest([role=toolbar]) or an ancestor with position fixed|sticky
  ancestorFixedSticky: boolean
  ancestorRowIdx: number | null  // DOM-closest row candidate (1-based) — may be a giant virtual container
}
export type Zone = { kind: 'Toolbar' } | { kind: 'Row'; row: number }

export const DESTRUCTIVE = /(删除|刪除|delete|trash|垃圾|移除|remove|discard|丢弃|丟棄|archive|封存|归档|歸檔|永久|report spam|垃圾邮件)/i

/** A "real" row is row-sized: a giant virtual-scroll container (e.g. 1062x2244 in the v9.2 log) is NOT a row. */
export function isRealRow(r: RowNode, vh: number, vw: number): boolean {
  return r.box.w > 0 && r.box.h > 0 && r.box.h <= Math.max(180, vh * 0.3) && r.box.w <= vw * 1.05
}
const inside = (b: Box, x: number, y: number) => x >= b.l && x <= b.l + b.w && y >= b.t && y <= b.t + b.h

export function classify(btn: BtnNode, rows: RowNode[], vh: number, vw: number): Zone {
  if (btn.ancestorToolbar || btn.ancestorFixedSticky) return { kind: 'Toolbar' }
  const real = rows.filter(r => isRealRow(r, vh, vw))
  if (btn.ancestorRowIdx != null) {
    const r = real.find(x => x.idx === btn.ancestorRowIdx)
    if (r && btn.box.h <= r.box.h * 1.2) return { kind: 'Row', row: r.idx }
  }
  const cx = btn.box.l + btn.box.w / 2, cy = btn.box.t + btn.box.h / 2
  const hit = real.filter(r => inside(r.box, cx, cy)).sort((a, b) => a.box.h - b.box.h)[0]
  return hit ? { kind: 'Row', row: hit.idx } : { kind: 'Toolbar' }
}

export interface TaggedBtn extends BtnNode { zone: Zone; tag: string }
export function tagAll(btns: BtnNode[], rows: RowNode[], vh: number, vw: number): TaggedBtn[] {
  return btns.map(b => {
    const zone = classify(b, rows, vh, vw)
    return { ...b, zone, tag: zone.kind === 'Toolbar' ? '[Zone: Toolbar]' : `[Zone: Row[${zone.row}]]` }
  })
}

/** Toolbar bulk buttons first (visible, uncovered), then everything else; Row buttons never outrank a Toolbar twin. */
export function pickBulkButton(tagged: TaggedBtn[], label: RegExp = DESTRUCTIVE): TaggedBtn | null {
  const m = tagged.filter(b => label.test(b.name) && b.visible)
  const rank = (b: TaggedBtn) => (b.zone.kind === 'Toolbar' ? 0 : 10) + (b.covered ? 5 : 0)
  return m.sort((a, b) => rank(a) - rank(b))[0] ?? null
}

/** In-page collector. Returns plain facts (CSS px). Run via Runtime.evaluate / callFunctionOn. */
export const ZONE_COLLECTOR_JS = `(function () {
  var CB = 'input[type=checkbox],[role=checkbox]', SEL = '[role=row],tr,[role=listitem],li,[role=option]';
  var vh = innerHeight, vw = innerWidth;
  function box(e) { var r = e.getBoundingClientRect(); return { l: r.left, t: r.top, w: r.width, h: r.height }; }
  var rowEls = [].slice.call(document.querySelectorAll(SEL)).filter(function (r) {
    if (!r.querySelector(CB)) return false;
    var ns = r.querySelectorAll(SEL); for (var k = 0; k < ns.length; k++) if (ns[k].querySelector(CB)) return false;
    var b = r.getBoundingClientRect(); return b.width > 0 && b.height > 0;
  });
  var rows = rowEls.map(function (r, i) { return { idx: i + 1, box: box(r) }; });
  function anc(e) {
    var tb = !!e.closest('[role=toolbar],[gh=mtb],[gh=tm]'), fs = false;
    for (var p = e; p && p.nodeType === 1; p = p.parentElement) {
      var pos = getComputedStyle(p).position; if (pos === 'fixed' || pos === 'sticky') { fs = true; break; }
    }
    var row = e.closest(SEL), idx = row ? rowEls.indexOf(row) + 1 : 0;
    return { tb: tb, fs: fs, idx: idx > 0 ? idx : null };
  }
  var out = [], els = [].slice.call(document.querySelectorAll('button,[role=button],[aria-label],[data-tooltip]'));
  for (var i = 0; i < els.length && out.length < 400; i++) {
    var e = els[i], b = e.getBoundingClientRect(); if (b.width < 2 || b.height < 2) continue;
    var cs = getComputedStyle(e); if (cs.visibility === 'hidden' || cs.display === 'none') continue;
    var nm = e.getAttribute('aria-label') || e.getAttribute('data-tooltip') || e.getAttribute('title') || (e.innerText || '').trim();
    if (!nm) continue;
    var a = anc(e), hit = document.elementFromPoint(b.left + b.width / 2, b.top + b.height / 2);
    out.push({ id: i, name: nm.slice(0, 80), box: box(e), visible: b.bottom > 0 && b.top < vh && b.right > 0 && b.left < vw,
      covered: !!hit && hit !== e && !e.contains(hit) && !hit.contains(e), ancestorToolbar: a.tb, ancestorFixedSticky: a.fs, ancestorRowIdx: a.idx });
  }
  return JSON.stringify({ rows: rows, btns: out, vh: vh, vw: vw });
})()`
