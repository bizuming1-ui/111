//! DsV9Ring — single-producer / multi-consumer shared-memory frame ring (file-backed mmap, seqlock slots).
//! Layout: [Header 64B][Slot0 hdr 64B | data][Slot1 ...].  Readers copy out and validate the slot seq (no locks, no syscalls).
use memmap2::MmapMut;
use std::fs::OpenOptions;
use std::sync::atomic::{AtomicU64, Ordering};

const MAGIC: &[u8; 8] = b"DSV9RING";
const HDR: usize = 64;
const SHDR: usize = 64;

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct FrameMeta { pub w: u32, pub h: u32, pub stride: u32 }

pub struct Ring { mmap: MmapMut, slots: usize, slot_bytes: usize }

impl Ring {
    pub fn create(path: &std::path::Path, slots: usize, slot_bytes: usize) -> std::io::Result<Ring> {
        let total = HDR + slots * (SHDR + slot_bytes);
        let f = OpenOptions::new().read(true).write(true).create(true).truncate(true).open(path)?;
        f.set_len(total as u64)?;
        let mut mmap = unsafe { MmapMut::map_mut(&f)? };
        mmap[0..8].copy_from_slice(MAGIC);
        mmap[8..12].copy_from_slice(&1u32.to_le_bytes());
        mmap[12..16].copy_from_slice(&(slots as u32).to_le_bytes());
        mmap[16..24].copy_from_slice(&(slot_bytes as u64).to_le_bytes());
        Ok(Ring { mmap, slots, slot_bytes })
    }
    pub fn open(path: &std::path::Path) -> std::io::Result<Ring> {
        let f = OpenOptions::new().read(true).write(true).open(path)?;
        let mmap = unsafe { MmapMut::map_mut(&f)? };
        if &mmap[0..8] != MAGIC { return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "bad DSV9RING magic")); }
        let slots = u32::from_le_bytes(mmap[12..16].try_into().unwrap()) as usize;
        let slot_bytes = u64::from_le_bytes(mmap[16..24].try_into().unwrap()) as usize;
        Ok(Ring { mmap, slots, slot_bytes })
    }
    fn atom(&self, off: usize) -> &AtomicU64 { unsafe { &*(self.mmap.as_ptr().add(off) as *const AtomicU64) } }
    fn write_idx(&self) -> &AtomicU64 { self.atom(24) }
    fn slot_off(&self, i: usize) -> usize { HDR + i * (SHDR + self.slot_bytes) }
    pub fn frames_written(&self) -> u64 { self.write_idx().load(Ordering::Acquire) }
    pub fn slot_bytes(&self) -> usize { self.slot_bytes }

    /// Zero-copy producer: `fill` writes pixels straight into the slot (e.g. DXGI Map -> slot).  Return Err/None to abort without publishing.
    pub fn write_with<F>(&mut self, fill: F) -> Result<u64, String>
    where F: FnOnce(&mut [u8]) -> Result<Option<FrameMeta>, String> {
        let n = self.write_idx().load(Ordering::Relaxed);
        let off = self.slot_off((n as usize) % self.slots);
        let seq = self.atom(off).load(Ordering::Relaxed);
        self.atom(off).store(seq | 1, Ordering::Release);                       // odd = being written
        let sb = self.slot_bytes;
        let data = &mut self.mmap[off + SHDR..off + SHDR + sb];
        let r = fill(data);
        match r {
            Ok(Some(m)) => {
                let len = (m.h as usize * m.stride as usize).min(sb) as u32;
                let hdr = &mut self.mmap[off + 8..off + 32];
                hdr[0..4].copy_from_slice(&m.w.to_le_bytes());
                hdr[4..8].copy_from_slice(&m.h.to_le_bytes());
                hdr[8..12].copy_from_slice(&m.stride.to_le_bytes());
                hdr[12..16].copy_from_slice(&len.to_le_bytes());
                self.atom(off).store((seq | 1) + 1, Ordering::Release);             // even = stable
                self.write_idx().store(n + 1, Ordering::Release);
                Ok(n + 1)
            }
            Ok(None) => { self.atom(off).store((seq | 1) + 1, Ordering::Release); Ok(n) }   // unchanged frame: nothing published
            Err(e) => { self.atom(off).store((seq | 1) + 1, Ordering::Release); Err(e) }
        }
    }
    pub fn write_frame(&mut self, m: FrameMeta, px: &[u8]) -> Result<u64, String> {
        if px.len() > self.slot_bytes { return Err("frame larger than slot".into()); }
        self.write_with(|d| { d[..px.len()].copy_from_slice(px); Ok(Some(m)) })
    }
    /// Lock-free consumer: copy the newest stable frame (seqlock retry; never returns a torn frame).
    pub fn read_latest(&self, out: &mut Vec<u8>) -> Option<(u64, FrameMeta)> {
        for _ in 0..64 {
            let n = self.frames_written();
            if n == 0 { return None; }
            let off = self.slot_off(((n - 1) as usize) % self.slots);
            let s1 = self.atom(off).load(Ordering::Acquire);
            if s1 & 1 == 1 { std::hint::spin_loop(); continue; }
            let h = &self.mmap[off + 8..off + 24];
            let m = FrameMeta { w: u32::from_le_bytes(h[0..4].try_into().unwrap()), h: u32::from_le_bytes(h[4..8].try_into().unwrap()), stride: u32::from_le_bytes(h[8..12].try_into().unwrap()) };
            let len = u32::from_le_bytes(h[12..16].try_into().unwrap()) as usize;
            out.clear(); out.extend_from_slice(&self.mmap[off + SHDR..off + SHDR + len.min(self.slot_bytes)]);
            if self.atom(off).load(Ordering::Acquire) == s1 { return Some((n, m)); }
        }
        None
    }
}

