//! Java Access Bridge: WindowsAccessBridge-64.dll is loaded dynamically (no link-time dependency; absent => feature off).
//! Swing/AWT (SunAwtFrame) windows are walked through JAB and mapped into the same RawNode model as UIA,
//! so they receive ordinary `@snapshot:ref` handles.
use dscu_core::platform::{ActOp, ActResult, PErr};
use dscu_core::tree::{RawNode, WindowInfo};
use dscu_core::uia_ref::{pick_match, LiveCand, RefEntry};
use std::ffi::c_void;
use std::sync::OnceLock;
use windows::core::{s, w};
use windows::Win32::Foundation::{BOOL, HWND};
use windows::Win32::System::LibraryLoader::{GetProcAddress, LoadLibraryW};
use windows::Win32::UI::WindowsAndMessaging::{DispatchMessageW, PeekMessageW, TranslateMessage, MSG, PM_REMOVE};

#[repr(C)]
pub struct AccessibleContextInfo {
    name: [u16; 1024],
    description: [u16; 1024],
    role: [u16; 256],
    role_en_us: [u16; 256],
    states: [u16; 256],
    states_en_us: [u16; 256],
    index_in_parent: i32,
    children_count: i32,
    x: i32,
    y: i32,
    width: i32,
    height: i32,
    accessible_component: BOOL,
    accessible_action: BOOL,
    accessible_selection: BOOL,
    accessible_text: BOOL,
    accessible_interfaces: BOOL,
}
#[repr(C)]
pub struct ActionInfo {
    name: [u16; 256],
}
#[repr(C)]
pub struct Actions {
    count: i32,
    info: [ActionInfo; 256],
}
#[repr(C)]
pub struct ActionsToDo {
    count: i32,
    actions: [ActionInfo; 32],
}

type FnIsJava = unsafe extern "C" fn(HWND) -> BOOL;
type FnCtxFromHwnd = unsafe extern "C" fn(HWND, *mut i32, *mut i64) -> BOOL;
type FnInfo = unsafe extern "C" fn(i32, i64, *mut AccessibleContextInfo) -> BOOL;
type FnChild = unsafe extern "C" fn(i32, i64, i32) -> i64;
type FnRelease = unsafe extern "C" fn(i32, i64);
type FnGetActions = unsafe extern "C" fn(i32, i64, *mut Actions) -> BOOL;
type FnDo = unsafe extern "C" fn(i32, i64, *mut ActionsToDo, *mut i32) -> BOOL;
type FnSetText = unsafe extern "C" fn(i32, i64, *const u16) -> BOOL;
type FnFocus = unsafe extern "C" fn(i32, i64) -> BOOL;

pub struct Jab {
    is_java: FnIsJava,
    ctx_from_hwnd: FnCtxFromHwnd,
    info: FnInfo,
    child: FnChild,
    release: FnRelease,
    get_actions: FnGetActions,
    do_actions: FnDo,
    set_text: FnSetText,
    focus: FnFocus,
}
unsafe impl Send for Jab {}
unsafe impl Sync for Jab {}

static JAB: OnceLock<Option<Jab>> = OnceLock::new();

pub fn load() -> Option<&'static Jab> {
    JAB.get_or_init(|| unsafe {
        let lib = LoadLibraryW(w!("WindowsAccessBridge-64.dll")).ok()?;
        macro_rules! sym {
            ($n:expr) => {
                std::mem::transmute(GetProcAddress(lib, $n)?)
            };
        }
        let run: unsafe extern "C" fn() = sym!(s!("Windows_run"));
        // JAB needs a message-pumping thread that called Windows_run()
        std::thread::Builder::new().name("dscu-jab-pump".into()).spawn(move || {
            run();
            let mut m = MSG::default();
            loop {
                while PeekMessageW(&mut m, None, 0, 0, PM_REMOVE).as_bool() {
                    let _ = TranslateMessage(&m);
                    DispatchMessageW(&m);
                }
                std::thread::sleep(std::time::Duration::from_millis(8));
            }
        }).ok()?;
        std::thread::sleep(std::time::Duration::from_millis(250)); // bridge handshake with running JVMs
        Some(Jab {
            is_java: sym!(s!("isJavaWindow")),
            ctx_from_hwnd: sym!(s!("getAccessibleContextFromHWND")),
            info: sym!(s!("getAccessibleContextInfo")),
            child: sym!(s!("getAccessibleChildFromContext")),
            release: sym!(s!("releaseJavaObject")),
            get_actions: sym!(s!("getAccessibleActions")),
            do_actions: sym!(s!("doAccessibleActions")),
            set_text: sym!(s!("setTextContents")),
            focus: sym!(s!("requestFocus")),
        })
    })
    .as_ref()
}

fn ws(a: &[u16]) -> String {
    let n = a.iter().position(|c| *c == 0).unwrap_or(a.len());
    String::from_utf16_lossy(&a[..n])
}

fn norm_role(r: &str) -> String {
    let l = r.to_lowercase();
    match l.as_str() {
        "push button" => "button".into(),
        "check box" => "checkbox".into(),
        "radio button" => "radiobutton".into(),
        "text" | "password text" => "edit".into(),
        "label" => "text".into(),
        "menu item" => "menuitem".into(),
        "page tab" => "tabitem".into(),
        "combo box" => "combobox".into(),
        "frame" | "dialog" => "window".into(),
        other => other.replace(' ', "_"),
    }
}

impl Jab {
    pub fn is_java_window(&self, h: HWND) -> bool {
        unsafe { (self.is_java)(h).as_bool() }
    }

    unsafe fn read(&self, vm: i32, ac: i64, path: &str, budget: &mut usize, flat: &mut Option<&mut Vec<(Vec<i32>, i32, i64)>>, idx_path: &mut Vec<i32>) -> Option<RawNode> {
        let mut info: Box<AccessibleContextInfo> = Box::new(std::mem::zeroed());
        if !(self.info)(vm, ac, &mut *info).as_bool() {
            return None;
        }
        *budget = budget.saturating_sub(1);
        let (name, role_en, states) = (ws(&info.name), ws(&info.role_en_us), ws(&info.states_en_us).to_lowercase());
        let role = norm_role(&role_en);
        let mut patterns = vec![];
        if info.accessible_action.as_bool() {
            patterns.push(if role == "checkbox" || role == "radiobutton" { "toggle" } else { "invoke" }.to_string());
        }
        if (role == "edit") && states.contains("editable") {
            patterns.push("value".into());
        }
        if info.accessible_selection.as_bool() {
            patterns.push("selection_item".into());
        }
        let mut node = RawNode {
            key: format!("jab:{path}|{role}|{name}"),
            role,
            name,
            enabled: states.contains("enabled"),
            offscreen: !states.contains("showing"),
            focusable: states.contains("focusable"),
            password: role_en.to_lowercase().contains("password"),
            patterns,
            rect: [info.x, info.y, info.x + info.width, info.y + info.height],
            source: "jab".into(),
            ..Default::default()
        };
        let _ = flat;
        let _ = idx_path;
        for i in 0..info.children_count.max(0) {
            if *budget == 0 {
                break;
            }
            let c = (self.child)(vm, ac, i);
            if c == 0 {
                continue;
            }
            if let Some(n) = self.read(vm, c, &format!("{path}.{i}"), budget, &mut None, &mut vec![]) {
                node.children.push(n);
            }
            (self.release)(vm, c);
        }
        Some(node)
    }

    pub fn scan(&self, hwnd: HWND, max_nodes: usize) -> Result<RawNode, PErr> {
        unsafe {
            let (mut vm, mut ac) = (0i32, 0i64);
            if !(self.ctx_from_hwnd)(hwnd, &mut vm, &mut ac).as_bool() || ac == 0 {
                return Err(PErr::NotFound("JAB: no accessible context for this window (is the Java Access Bridge enabled? run `jabswitch -enable`)".into()));
            }
            let mut budget = max_nodes;
            let r = self.read(vm, ac, "0", &mut budget, &mut None, &mut vec![]);
            (self.release)(vm, ac);
            r.ok_or_else(|| PErr::Other("JAB: failed to read root context".into()))
        }
    }

    /// Walk to the child context addressed by the dotted path stored in the node key.
    unsafe fn ctx_at(&self, vm: i32, root: i64, key: &str) -> Option<i64> {
        let path = key.strip_prefix("jab:")?.split('|').next()?;
        let mut cur = root;
        for seg in path.split('.').skip(1) {
            let i: i32 = seg.parse().ok()?;
            let c = (self.child)(vm, cur, i);
            if cur != root {
                (self.release)(vm, cur);
            }
            if c == 0 {
                return None;
            }
            cur = c;
        }
        Some(cur)
    }

    pub fn act(&self, w: &WindowInfo, e: &RefEntry, op: &ActOp) -> Result<ActResult, PErr> {
        let raw = self.scan(crate::sys::hwnd_from(w.window_id), 20000)?;
        let mut live = vec![];
        fn fl(n: &RawNode, o: &mut Vec<LiveCand>) {
            o.push(LiveCand { index: o.len(), key: n.key.clone(), role: n.role.clone(), name: n.name.clone(), automation_id: String::new(), rect: n.rect });
            n.children.iter().for_each(|c| fl(c, o));
        }
        fl(&raw, &mut live);
        let idx = pick_match(e, &live).map_err(|er| match er.kind {
            dscu_core::protocol::ErrKind::AmbiguousTarget => PErr::Ambiguous(er.data.and_then(|d| d["candidates"].as_array().cloned()).unwrap_or_default()),
            _ => PErr::Stale(er.message),
        })?;
        let rc = live[idx].rect;
        if op.kind == "locate" {
            return Ok(ActResult { pattern: "locate".into(), detail: "ok".into(), rect: Some(rc) });
        }
        unsafe {
            let (mut vm, mut root) = (0i32, 0i64);
            if !(self.ctx_from_hwnd)(crate::sys::hwnd_from(w.window_id), &mut vm, &mut root).as_bool() {
                return Err(PErr::Stale("JAB context vanished".into()));
            }
            let ctx = self.ctx_at(vm, root, &live[idx].key).ok_or_else(|| PErr::Stale("JAB path no longer valid".into()));
            let r = ctx.and_then(|c| {
                let res = match op.pattern.as_str() {
                    "jab_action" => {
                        let mut acts: Box<Actions> = Box::new(std::mem::zeroed());
                        if !(self.get_actions)(vm, c, &mut *acts).as_bool() || acts.count < 1 {
                            Err(PErr::NoPattern("no accessible action".into()))
                        } else {
                            let mut todo: Box<ActionsToDo> = Box::new(std::mem::zeroed());
                            todo.count = 1;
                            todo.actions[0].name = acts.info[0].name;
                            let mut fail = 0i32;
                            if (self.do_actions)(vm, c, &mut *todo, &mut fail).as_bool() { Ok("jab_action") } else { Err(PErr::Other(format!("doAccessibleActions failed at {fail}"))) }
                        }
                    }
                    "jab_set_text" => {
                        let t: Vec<u16> = op.text.clone().unwrap_or_default().encode_utf16().chain(std::iter::once(0)).collect();
                        if (self.set_text)(vm, c, t.as_ptr()).as_bool() { Ok("jab_set_text") } else { Err(PErr::NoPattern("setTextContents refused".into())) }
                    }
                    "jab_focus" => if (self.focus)(vm, c).as_bool() { Ok("jab_focus") } else { Err(PErr::Other("requestFocus failed".into())) },
                    _ => Err(PErr::NoPattern("unsupported jab op".into())),
                };
                (self.release)(vm, c);
                res
            });
            (self.release)(vm, root);
            r.map(|p| ActResult { pattern: p.into(), detail: "ok".into(), rect: Some(rc) })
        }
    }
}

