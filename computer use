"""Deterministic app skills executed through the SAME live IPC chain as the LLM loop (observe -> act -> verify).
They are the procedural memory for well-understood apps; the LLM handles everything unknown."""
from __future__ import annotations

import asyncio
import re
import time
from pathlib import Path
from typing import TYPE_CHECKING, Any

from . import layer0
from .protocol import ActionRequest

if TYPE_CHECKING:  # pragma: no cover
    from .orchestrator import Brain


async def _wait_window(brain: "Brain", process: str, title_has: str | None = None, timeout: float = 10.0) -> dict[str, Any] | None:
    t0 = time.perf_counter()
    while time.perf_counter() - t0 < timeout:
        env = await brain.driver.observe({"want": {"uia": False, "windows": True, "ahash": False}, "target": {}})
        for w in env.windows:
            if process.lower() in str(w.get("process", "")).lower() and (not title_has or title_has.lower() in str(w.get("title", "")).lower()):
                return w
        await asyncio.sleep(0.15)
    return None


def _find(env, roles: tuple[str, ...], name_has: tuple[str, ...] = ()):
    best = None
    for e in env.elements:
        if e.role in roles and (not name_has or any(n.lower() in e.name.lower() for n in name_has)) and not e.occluded:
            if best is None or e.rect.w * e.rect.h > best.rect.w * best.rect.h:
                best = e
    return best


async def notepad_gui_save(brain: "Brain", intent: layer0.SaveIntent, task: str) -> dict[str, Any]:
    """Drive the REAL Notepad GUI: launch -> UIA/SendInput text entry -> Ctrl+S -> file dialog -> verify bytes on disk."""
    kind, root = layer0.granted_folder(task, intent.folder_word) or (_ for _ in ()).throw(layer0.PathDenied("folder not authorised by task"))
    target = root / layer0.safe_name(intent.name)
    if target.exists():
        target.unlink()  # a stale file would make the verification meaningless
    steps: list[str] = []
    r = await brain.act(ActionRequest.new("launch", args={"target": "notepad.exe"}), who="driver")
    steps.append(f"launch notepad -> {r.strategy or r.error_code}")
    if not r.ok:
        return {"ok": False, "steps": steps, "error": r.detail}
    w = await _wait_window(brain, "notepad", timeout=12)
    if not w:
        return {"ok": False, "steps": steps, "error": "Notepad window did not appear"}
    await brain.act(ActionRequest.new("focus_window", args={"hwnd": w["hwnd"]}), who="driver")
    env = await brain.driver.observe({"want": {"uia": True, "windows": False}, "target": {"hwnd": w["hwnd"]}})
    steps.append(f"UIA snapshot epoch={env.snapshot_epoch} controls={env.element_count} walk={env.timing or ''}")
    edit = _find(env, ("Document", "Edit"))
    if edit:
        r = await brain.act(ActionRequest.new("set_value", {"ref_id": edit.ref_id}, {"text": intent.text, "clear": True}, expect_epoch=env.snapshot_epoch, expect_hwnd=env.hwnd), who="driver")
        steps.append(f"set_value({edit.role} '{edit.name}') -> strategy={r.strategy} ok={r.ok} {r.error_code or ''}")
    else:  # self-drawn editor: keyboard path (Unicode SendInput)
        r = await brain.act(ActionRequest.new("type", args={"text": intent.text}, expect_hwnd=w["hwnd"]), who="driver")
        steps.append(f"type -> {r.strategy} ok={r.ok}")
    if not r.ok:
        return {"ok": False, "steps": steps, "error": f"{r.error_code}: {r.detail}"}
    await brain.act(ActionRequest.new("key", args={"keys": "ctrl+s"}, expect_hwnd=w["hwnd"]), who="driver")
    t0 = time.perf_counter()
    name_edit = None
    denv = None
    while time.perf_counter() - t0 < 8 and not name_edit:
        fg = await brain.driver.observe({"want": {"uia": True, "windows": False}, "target": {}})
        if fg.process.lower().startswith("notepad") and any(k in fg.title for k in ("另存为", "Save As", "保存", "Save")):
            name_edit = _find(fg, ("Edit", "ComboBox"), ("文件名", "File name", "name"))
            denv = fg
        await asyncio.sleep(0.2)
    if not name_edit or not denv:
        return {"ok": False, "steps": steps + ["save dialog not found"], "error": "save dialog did not appear"}
    r = await brain.act(ActionRequest.new("set_value", {"ref_id": name_edit.ref_id}, {"text": str(target), "clear": True}, expect_epoch=denv.snapshot_epoch, expect_hwnd=denv.hwnd), who="driver")
    steps.append(f"dialog filename -> strategy={r.strategy} ok={r.ok}")
    await brain.act(ActionRequest.new("key", args={"keys": "enter"}), who="driver")
    await asyncio.sleep(0.6)
    fg = await brain.driver.observe({"want": {"uia": False, "windows": False}, "target": {}})
    if "确认" in fg.title or "Confirm" in fg.title:  # overwrite prompt: default button is Yes
        await brain.act(ActionRequest.new("key", args={"keys": "alt+y"}), who="driver")
    for _ in range(40):
        if target.exists() and target.stat().st_size > 0:
            break
        await asyncio.sleep(0.15)
    st = layer0.file_stat(str(target), intent.text)
    ok = bool(st.get("exists") and st.get("contains_expected"))
    steps.append(f"verify on disk: {st}")
    return {"ok": ok, "steps": steps, "path": str(target), "stat": st}


URL_RE = re.compile(r"https?://[^\s，,。)）]+")


async def chrome_navigate_read(brain: "Brain", url: str) -> dict[str, Any]:
    """Drive Chrome through the TS CDP daemon: navigate (isolated profile), settle, read live DOM/AX facts."""
    if brain.cdp is None:
        return {"ok": False, "error": "cdp-daemon is not running"}
    host = (re.sub(r"^https?://", "", url).split("/")[0].split(":")[0]).lower()
    args: dict[str, Any] = {"url": url}
    if host in brain.cfg_approved_hosts:
        args["allow_private"] = True
    r = await brain.act(ActionRequest.new("navigate", args=args), who="cdp")
    if not r.ok:
        return {"ok": False, "error": f"{r.error_code}: {r.detail}"}
    env = await brain.cdp.observe({"want": {"settle": True, "max_nodes": 120}})
    heads = [e.name for e in env.elements if e.role == "heading"][:5]
    links = [e.name for e in env.elements if e.role == "link"][:5]
    return {"ok": True, "url": env.page.url if env.page else "", "title": env.page.title if env.page else "", "headings": heads, "links": links, "elements": env.element_count, "timing": env.timing,
            "epoch": env.snapshot_epoch, "navigate": {k: v for k, v in r.model_dump().items() if k in ("url", "title", "settled", "settle_ms")}}
