  CHECK(s.dirty.x0 == 192 && s.dirty.y0 == 96 && s.dirty.x1 == 272 && s.dirty.y1 == 144);                   // tile-aligned union
  CHECK(s.dirty_tiles == v.dirty_tiles && s.dirty.x0 == v.dirty.x0 && s.dirty.y1 == v.dirty.y1 && s.ahash == v.ahash);   // scalar == AVX2 exactly
