// OmniParser V2 (quantised INT8 icon_detect) sidecar: ONNX Runtime + DirectML EP (AMD 780M iGPU / any DX12 GPU) or CUDA EP (NVIDIA).
// Honors the 24GB-UMA breaker: refuses to load below 4096 MB available, unloads after 180 s idle, restores only at 4096+768 MB.
#ifdef _WIN32
#include <windows.h>
#include <onnxruntime_cxx_api.h>
#include <dml_provider_factory.h>
#include <atomic>
#include <chrono>
#include <cstdio>
#include <memory>
#include <string>
#include <vector>
using Clock = std::chrono::steady_clock;
static double avail_mb() { MEMORYSTATUSEX m{sizeof(m)}; GlobalMemoryStatusEx(&m); return m.ullAvailPhys / 1048576.0; }
struct Box { float x0, y0, x1, y1, score; };
class OmniParser {
  Ort::Env env{ORT_LOGGING_LEVEL_WARNING, "dscu-omniparser"}; std::unique_ptr<Ort::Session> s; Clock::time_point last = Clock::now(); bool tripped = false; std::wstring model;
public:
  explicit OmniParser(std::wstring m) : model(std::move(m)) {}
  bool breaker() { double a = avail_mb(); if (!tripped && a < 4096) tripped = true; else if (tripped && a >= 4096 + 768) tripped = false; if (tripped) s.reset(); return tripped; }
  void idle_unload() { if (s && Clock::now() - last > std::chrono::seconds(180)) s.reset(); }
  bool load(bool cuda) {
    if (breaker()) return false;                                            // tripped: caller falls back to cloud deepseek-flash
    Ort::SessionOptions o; o.SetGraphOptimizationLevel(GraphOptimizationLevel::ORT_ENABLE_ALL);
    if (cuda) { OrtCUDAProviderOptions c{}; o.AppendExecutionProvider_CUDA(c); } else { o.SetExecutionMode(ExecutionMode::ORT_SEQUENTIAL); o.DisableMemPattern(); Ort::ThrowOnError(OrtSessionOptionsAppendExecutionProvider_DML(o, 0)); }
    s = std::make_unique<Ort::Session>(env, model.c_str(), o); return true;
  }
