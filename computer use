    # ------------------------------------------------------------------------------------------------------------ deadline guard
    async def _g(self, op: str, coro: Any, hard_ms: Optional[float] = None) -> Any:
        hard = (hard_ms or self.b.hard_ms) / 1000.0
        t0 = time.perf_counter()
        try:
            r = await asyncio.wait_for(coro, timeout=hard)
        except asyncio.TimeoutError:
            ms = (time.perf_counter() - t0) * 1000
            self.tel.counters["hard_timeouts"] += 1
            self.tel.record(op, ms, False, f"hard_deadline>{hard * 1000:.0f}ms")
            raise ControllerTimeout("HARD_DEADLINE", f"{op} 超过硬截止 {hard * 1000:.0f} ms（P99 长尾被截断；改走备用路径）") from None
        ms = (time.perf_counter() - t0) * 1000
        self.tel.record(op, ms, True, f"slow>{self.b.soft_ms:.0f}ms" if ms > self.b.soft_ms else "")
        if ms > self.b.soft_ms:
            self.tel.counters["slow"] += 1
