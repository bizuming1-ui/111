function Start-EvalMockServer {
    $state = [System.Collections.Concurrent.ConcurrentDictionary[string, string]]::new()
    foreach ($k in 'trapHits', 'pageHits', 'lateHits', 'submits') { $state[$k] = '0' }
    $listener = $null; $base = $null
    for ($try = 0; $try -lt 12 -and -not $listener; $try++) {
        $port = Get-Random -Minimum 20000 -Maximum 60000
        foreach ($h in '127.0.0.1', 'localhost') {
            try { $l = [System.Net.HttpListener]::new(); $l.Prefixes.Add("http://${h}:$port/"); $l.Start(); $listener = $l; $base = "http://${h}:$port/"; break } catch { try { $l.Close() } catch { } }
        }
    }
    if (-not $listener) { throw 'HttpListener 无法在 127.0.0.1 / localhost 上启动（端口被占用或被策略禁止）' }
    $rs = [runspacefactory]::CreateRunspace(); $rs.Open()
    $ps = [powershell]::Create(); $ps.Runspace = $rs
    [void]$ps.AddScript({
            param($listener, $state, $page)
            $inc = { param($k) $state[$k] = [string]([int]$state[$k] + 1) }
            while ($listener.IsListening) {
                try { $ctx = $listener.GetContext() } catch { break }
                try {
                    $req = $ctx.Request; $res = $ctx.Response; $path = $req.Url.AbsolutePath
                    $body = ''; $ct = 'application/json; charset=utf-8'
                    switch ($path) {
                        '/' { & $inc 'pageHits'; $body = $page; $ct = 'text/html; charset=utf-8' }
                        '/api/late' { & $inc 'lateHits'; Start-Sleep -Milliseconds 700; $body = '{"label":"I agree to the terms"}' }
                        '/trap' { & $inc 'trapHits'; $body = '{"status":"trap"}' }
                        '/reset' { foreach ($k in 'trapHits', 'submits') { $state[$k] = '0' }; $dummy = ''; [void]$state.TryRemove('last', [ref]$dummy); $body = '{"status":"reset"}' }
                        '/submit' {
                            $sr = [System.IO.StreamReader]::new($req.InputStream, [System.Text.Encoding]::UTF8); $raw = $sr.ReadToEnd(); $sr.Dispose()
                            & $inc 'submits'; $state['last'] = $raw; $body = '{"status":"Thanks, registered"}'
                        }
                        default { $res.StatusCode = 404; $body = '{"status":"not found"}' }
                    }
