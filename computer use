            else:
                out.append(Check("recycle_bin_probe", True, f"无法独立读取回收站（{st.get('reason')}）→ 不计入覆盖", "misc"))
        m = layer0._RECYCLE_FILE.search(task)
        if m:
            folder = layer0.known_folder(m.group("folder"))
            nm = m.group("name").strip("“”\"'").lower()
            left = [f.name for f in folder.glob("*") if f.is_file() and (f.stem.lower() == nm or f.name.lower() == nm)] if folder.exists() else []
            out.append(Check("file_left_folder", not left, f"{folder} 中{'仍有 ' + ','.join(left) if left else '已无 ' + nm}", "recycle"))
