    async def _wal_recovery(self) -> None:
        """Startup: settle every started/unknown/verifying transaction against an EXTERNAL read-only oracle.  Never blind-replays irreversible actions."""
        if not self.wal.path.exists():
            return
        sk = self._gmail_skill()
        probes = {"gmail_labels": make_gmail_probe(sk)}
        decisions = await asyncio.to_thread(wal_recover, self.wal, probes, self.say)
        self.wal_decisions = decisions
        if not decisions:
            return
        self.say(f"  🛟 WAL 崩溃恢复：处理了 {len(decisions)} 条未决事务（已提交 {sum(d.action == 'mark_committed' for d in decisions)} · 可恢复 {sum(d.action == 'resume_allowed' for d in decisions)} · 交人工 {sum(d.action == 'paused_for_user' for d in decisions)}）")
        for d in decisions:
            if d.action == "paused_for_user":
                self.say(f"  🛑 事务 {d.txid}（{d.kind}）外部状态无法确认 → paused_for_user：请人工核对后用 `v16 wal resolve {d.txid} committed|failed` 裁决；系统绝不会盲目重放删除/发送。")
            elif d.action == "resume_allowed":
                self.pending_resume.append(d)
                self.say(f"  ↩ 事务 {d.txid}（{d.kind}）外部核验证明上次动作【未生效】（剩余 {len(d.probe.remaining)} 项）→ 允许恢复；输入 `v16 wal resume {d.txid}` 并经确认后重新执行。")

    async def resume_transaction(self, txid: str) -> tuple[str, str]:
        d = next((x for x in self.pending_resume if x.txid == txid), None)
        if d is None:
            return "failed", f"没有可恢复的事务 {txid}"
        if d.kind == "gmail_trash":
            sk = self._gmail_skill()
            ids = list(d.probe.remaining)
            if sk is None or not ids:
                return "paused_for_user", "Gmail API 不可用，无法恢复"
            self.tx = WalTransaction(self.wal, d.record.task)
            if not await self._hitl([f"  ↩ 恢复被中断的 Gmail 删除：{len(ids)} 封（外部核验确认它们仍未进入 TRASH）"], "确认继续执行？[y/N]"):
                return "aborted", "用户拒绝恢复"
            return await self._gmail_execute(sk, ids, d.record.task, st=None, txn=self.tx, query=str(d.record.meta.get("query", "")))
        if d.kind == "file_recycle":
            ok_all = True
            for pth in d.probe.remaining:
                ok, msg = await asyncio.to_thread(safe_shell.recycle_file, pth, (self.cfg.workspace,))
                ok_all = ok_all and ok
            return ("completed_verified", "已恢复回收") if ok_all and all(not Path(x).exists() for x in d.probe.remaining) else ("failed", "恢复失败")
        return "paused_for_user", f"{d.kind} 不支持自动恢复"

    async def _gmail_execute(self, sk: "gmail_skill.GmailSkill", ids: list[str], task: str, st: Optional[TaskState], txn: WalTransaction, query: str = "", txid: str = "") -> tuple[str, str]:
        say = self.say
        t0 = time.perf_counter()
        txid = txid or txn.create("gmail_trash", {"type": "gmail_labels", "required_label": "TRASH"}, {"query": query})
        if txn.ops.get(txid) == "created":
            txn.freeze(txid, ids, {"type": "gmail_labels", "required_label": "TRASH"}, {"query": query})
            txn.confirm(txid, "hitl")
        txn.start(txid)  # fsync'ed BEFORE the first trash request leaves the process
        try:
            res = await asyncio.to_thread(sk.trash_messages, ids)
        except Exception as e:  # noqa: BLE001
            txn.mark_unknown(txid, f"trash call raised: {str(e)[:100]}")
            res = {}
            say(f"  ⚠ trash 调用异常（{str(e)[:100]}）→ 事务标记 unknown，改由外部 Oracle 判定")
        txn.verifying(txid, "independent verify_labels")
        cov, lab = await asyncio.to_thread(sk.verify_all, ids, "TRASH")
        self.counters["gmail_api_calls"] += sk.stats["calls"]
        goal = GmailTrashGoal(tuple(ids))
        checks = [Check(f"label_TRASH:{i}", lab.get(i) is True, f"{i[:10]} labelIds {'含' if lab.get(i) else '不含/不可读'} TRASH", "gmail", evaluated=lab.get(i) is not None, source="gmail_api.labels") for i in ids]
        v = Verdict(ok=not any(c.evaluated and not c.ok for c in checks), checks=checks, coverage=cov, goals=[goal.as_dict()], required_total=len(ids), required_passed=sum(1 for i in ids if lab.get(i) is True))
        v.status = terminal_from_verdict(v)
        say(f"  🔎 独立验证器（Gmail labels 逐 ID 核验）：{v.required_passed}/{len(ids)} 带 TRASH · 覆盖={cov} · 重试(429)={sk.stats['retries_429']} 刷新={sk.stats['refreshes']} · {time.perf_counter() - t0:.1f}s")
        if cov == "full":
            txn.finish(txid, True, f"all {len(ids)} ids carry TRASH")
            txn.commit()
            return "completed_verified", f"Gmail API 已将 {len(ids)} 封邮件移入垃圾箱（可 30 天内恢复），并逐 ID 独立核验 labelIds 含 TRASH（覆盖=full）"
        bad = [i for i in ids if lab.get(i) is not True]
        if cov == "partial":
            txn.finish(txid, False, f"partial: {len(bad)} not trashed")
            txn.mark_unverified("partial")
            return "partially_completed", f"仅 {v.required_passed}/{len(ids)} 封确认进入 TRASH；未确认：{', '.join(b[:10] for b in bad[:6])}"
        txn.finish(txid, False, "none carries TRASH")
        return "failed", "Gmail API 已发出 trash 请求但没有任何一封被独立核验到 TRASH 标签"

    async def _run_gmail_skill(self, g: dict[str, Any], sk: "gmail_skill.GmailSkill", st: TaskState) -> Optional[tuple[str, str]]:
        say = self.say
        say(f"  ⚡ Layer-0 GmailSkill（两阶段闭环）：{g['intent']} · q={g['query']!r} · 选择={g['selection']}（失败自动回落浏览器通道，且浏览器通道同样强制冻结 stable_id）")
        t0 = time.perf_counter()
        txn = WalTransaction(self.wal, st.task)
        self.tx = txn
        try:
            if g["intent"] == "list":
                msgs = await asyncio.to_thread(sk.list_messages, g["query"], g.get("order", "newest_first"), g["count"])
                for m in msgs:
                    say(f"    · {'●' if 'UNREAD' in m['labels'] else '○'} {m['sender'][:30]} ｜ {m['subject'][:50]} ｜ {m['date'][:25]}")
                return "completed_verified", f"Gmail API 读取 {len(msgs)} 封（{g['query']}），耗时 {time.perf_counter() - t0:.1f}s（只读，数据来自 API 本身）"
            # ---------- phase 1: freeze the exact message_id set
            try:
                fz = await asyncio.to_thread(sk.freeze_targets, g)
            except gmail_skill.GmailSelectionError as e:
                say(f"  🛑 无法冻结目标：{e}")
                return "paused_for_user", str(e)
            txid = txn.create("gmail_trash", {"type": "gmail_labels", "required_label": "TRASH"}, {"query": fz.query, "fingerprint": fz.fingerprint})
            txn.freeze(txid, fz.ids, {"type": "gmail_labels", "required_label": "TRASH"}, {"query": fz.query, "fingerprint": fz.fingerprint})
            self.counters["gmail_api_calls"] += sk.stats["calls"]
            # ---------- HITL: show sender+subject+time of every frozen id, then require explicit confirmation
            if not await self._hitl(sk.render_summary(fz), f"确认将以上 {len(fz.ids)} 封邮件移入垃圾箱？（可 30 天内恢复）[y/N]"):
                txn.finish(txid, False, "user declined")
                txn.abort()
                return "aborted", "用户在确认环节拒绝，未执行任何删除"
            txn.confirm(txid, "hitl")
            return await self._gmail_execute(sk, fz.ids, st.task, st, txn, fz.query, txid)
        except gmail_skill.GmailAuthError as e:
            say(f"  ⚠ Gmail 授权问题：{str(e)[:160]} → 回落浏览器通道")
            return None
        except Exception as e:  # noqa: BLE001
            say(f"  ⚠ Gmail API 不可用：{str(e)[:160]} → 回落浏览器通道")
            return None

    async def _launch(self, target: str, args: str, b: Bundle, st: TaskState, activate_first: bool) -> ActionResult:
        if not target:
            return ActionResult(ok=False, code=Code.NOT_FOUND, message="缺少 target")
        info = layer0.resolve_app(target)
        proc_hint = (Path(str(info["target"])).stem if info and info["kind"] == "path" else target).lower()
        al = {x.lower() for x in layer0.ALIASES.get(target, [])} | {proc_hint, target.lower()} | {n.replace(".exe", "") for n in procnames.process_names_for(target)}
        match = lambda w: (not w.own_console) and (w.process.lower().replace(".exe", "") in al or any(x in w.title.lower() for x in al if len(x) > 1))  # noqa: E731
        existing = next((w for w in b.drv.windows if match(w)), None)
        if existing and (activate_first or True):
            r = await self._focus(b, hwnd=existing.hwnd)
            r.message = f"已有窗口 {existing.process}「{existing.title[:24]}」→ 不重复启动；" + r.message
            if r.ok:
                st.launched.add(existing.process.lower())
                return r
        if not existing and not re.match(r"^[a-z]+://|[\\/]", target, re.I):  # v16.1: title/process list had no match -> driver-side Win32 process-name lookup + AttachThreadInput focus
            fr = await self._drv("focus_window", b, title=target)
            if fr.ok:
                st.launched.add(str(fr.effect.get("resolved_by", target)).lower())
                fr.message = f"按进程名兜底找到已有窗口（{fr.effect.get('resolved_by', '')}）→ 不重复启动；" + fr.message
                return fr
        if st.crashes.get(proc_hint + ".exe", 0) >= 2 or st.crashes.get(proc_hint, 0) >= 2:
            return ActionResult(ok=False, code=Code.SECURITY_DENIED, message=f"[UNSTABLE_APP] {target} 已崩溃 ≥2 次，禁止再次启动。请 fail 并说明需要人工修复。")
        tgt = str(info["target"]) if info else target
        r = await self._drv("launch", b, target=tgt, args=args)
        if r.ok:
            w = await self._wait_window(match, 6.0)
            r.message = f"启动「{target}」→ {info['via'] if info else 'ShellExecute'}：{tgt}；" + (f"窗口已出现 {w.process}「{w.title[:24]}」" if w else "6 秒内未出现匹配窗口（应用可能崩溃/需要登录/启动慢）")
            if w:
                st.launched.add(w.process.lower())
                f = await self._focus(b, hwnd=w.hwnd)
                r.message += f"；前台{'已验证' if f.ok else '未能置顶：' + f.message[:80]}"
            else:
                r.ok, r.code = False, Code.NOT_FOUND
        return r

    async def _apply_intervention(self, iv: Intervention, b: Bundle, st: TaskState) -> Bundle:
        """Execute one rung of the Recovery Playbook (activate -> Ctrl+F -> 2x zoom relocate -> rollback) and re-observe."""
        self.say(f"  🛟 恢复剧本 · {iv.stage}")
        self.counters["playbook_" + iv.stage] += 1
        for a in iv.auto_actions:
            if a["action"] == "focus_window":
                r = await self._focus(b, hwnd=a.get("hwnd"))
            else:
                r = await self._drv(a["action"], b, keys=str(a.get("keys", "")), expect_hwnd=self._target_hwnd(b))
            self.say(f"    ↳ {a['action']} {a.get('keys', '')} → [{r.code.value}] {r.message[:80]}")
            await asyncio.sleep(0.2)
        if iv.arm_vision:
            self.perception.arm_force_vision(iv.arm_vision.get("detail", "low"), iv.arm_vision.get("crop_region"), iv.arm_vision.get("zoom"), iv.arm_vision.get("reason", ""))
        if iv.auto_actions or iv.arm_vision:
            await asyncio.sleep(0.2)
            return await self.observe(st, main_loop=True)
        return b

    # ------------------------------------------------------------------ the task loop
    async def run_task(self, task: str, max_steps: Optional[int] = None) -> str:
        self.task_no += 1
        self.history = []
        st = TaskState(task, max_steps=max_steps or self.cfg.max_steps)
        say = self.say
        say(f"\n╭─ 任务 #{self.task_no} ─────────────────────────")
        status, summary = "maxsteps", ""
        try:
            status, summary = await self._run(st)
        except ApiKeyError as e:
            status, summary = "api_key", str(e)
            say(f"✖ {e}")
        except (ApiError, IpcError) as e:
            status, summary = "error", str(e)
            say(f"✖ 运行出错：{e}")
        except asyncio.CancelledError:
            status = "cancelled"
            raise
        self.last_raw_status = status
        status = canonical_status(status)
        self._report(st, status, summary)
        say(f"╰─ 任务 #{self.task_no} 结束（{status}）──────────\n")
        return status

    async def _epoch_freeze(self, st: TaskState, b: Bundle, segments: list[dict[str, Any]], step: int) -> list:
        """v17.1 (log task #14): freeze head/tail targets on ONE CDP snapshot.  The 250-control cap used to cut the list, so `tail 3` was the last 3 of a TRUNCATED
        list and the checked rows changed identity (state words) -> self-inflicted OBJECT_IDENTITY_MISMATCH.  Now: refuse empty/stale sets; extend the snapshot when truncated."""
        say = self.say
        obs = b.obs
        must = "mail.google.com" if re.search(r"gmail|谷歌邮|google\s*mail", st.task, re.I) else ""
        res = freeze_same_epoch(self.registry, list(obs.elements), segments, "gone", step, epoch=int(getattr(obs, "snapshot_epoch", 0) or 0), channel=str(obs.channel),
                                url=str(obs.url or ""), url_must_contain=must, cap=250)
        if not res.ok and res.truncated and self.hub.cdp_up:
            try:
                full = await self.hub.cdp_observe(max_elements=900)  # extended snapshot = a NEW epoch; freeze from THAT one
                res = freeze_same_epoch(self.registry, list(full.elements), segments, "gone", step, epoch=int(full.snapshot_epoch), channel="cdp", url=str(full.url or ""), url_must_contain=must, cap=900)
                say(f"  🧊 扩展快照 epoch={full.snapshot_epoch}（{len(full.elements)} 控件）用于冻结尾部目标")
            except Exception as e:  # noqa: BLE001
                say(f"  ⚠ 扩展快照失败：{str(e)[:80]}")
        if not res.ok:
            say(f"  ⏳ 目标冻结推迟：{res.reason}")
            return []
        st.freeze_epoch = res.epoch  # type: ignore[attr-defined]
        say(f"  🧊 同一快照 epoch={res.epoch} 内完成列表提取 + 目标冻结（{res.rows_seen} 行 → {len(res.targets)} 个目标；身份=去状态词内容签名/thread_id，与勾选无关）")
        return res.targets

    async def _epoch_select(self, st: TaskState, targets: list) -> None:
        """After the HITL confirmation: ONE fresh snapshot, re-resolve every frozen identity inside it, tick exactly those rows in the SAME epoch (fail-closed)."""
        say = self.say
        if not self.hub.cdp_up or not targets:
            return
        try:
            snap = await self.hub.cdp_observe(max_elements=900)
            els = list(snap.elements)
            self.registry.observe_rows(els, st.step)
            rows = {sid: r for r, sid in self.registry.last_rows.items()}
            missing = [o for o in targets if o.stable_id not in rows]
            if missing:
                say(f"  🛑 同快照勾选中止：{len(missing)} 个冻结目标不在最新快照（{'；'.join(o.label[:16] for o in missing[:3])}）→ 保持 fail-closed，不勾选任何行")
                return
            groups = self.registry.row_groups(els)
            done = 0
            for o in targets:
                cb = next((e for e in groups.get(rows[o.stable_id], []) if e.role.lower() == "checkbox"), None)
                if cb is None:
                    continue
                if "checked" in cb.states:
                    done += 1
                    continue
                r = await self._cdp("click", ref=cb.ref_id, expect_epoch=int(snap.snapshot_epoch))
                done += 1 if r.ok else 0
            say(f"  ☑ 同一快照 epoch={snap.snapshot_epoch} 内已勾选 {done}/{len(targets)} 个冻结目标（下一轮观察会回读 checked 状态）")
        except Exception as e:  # noqa: BLE001
            say(f"  ⚠ 同快照勾选未完成：{type(e).__name__}: {str(e)[:100]}（模型仍可用 select_rows）")

    async def _run_wechat_skill(self, st: TaskState) -> Optional[tuple[str, str]]:
        """v17.1: deterministic WeChatSkill (0 LLM calls).  None => not applicable / could not start -> the model loop (with all send gates) continues."""
        from .skills import message_send as _ms

        sess = getattr(st, "msg_session", None)
        if sess is None or os.environ.get("DSCU_WECHAT_SKILL", "1") == "0" or not _ms.is_wechat_request(st.task):
            return None
        from .skills import wechat_io as _wio

        say = self.say
        self.counters["wechat_skill_runs"] = self.counters.get("wechat_skill_runs", 0) + 1
        say("── WeChatSkill（确定性闭环：Ctrl+F 搜索 → 联系人冻结 → 单聊核验 → 草稿读回 → HITL → 发送 → 右半区气泡核验；0 次模型调用）──")
        from .skills import wechat_real as _wr

        _ctrl = None
        try:
            from .realtime_controller import RealtimeController, Win32Port

            _ctrl = RealtimeController(Win32Port())
        except Exception:  # noqa: BLE001
            _ctrl = None
        skill = _wr.WeChatRealSkill(_wio.WeChatWinIO(self), sess, say, dry_run=(os.environ.get("DSCU_WECHAT_DRYRUN", "0") == "1"), controller=_ctrl)
        try:
            res = await skill.run()
        except Exception as e:  # noqa: BLE001
            say(f"  ⚠ WeChatSkill 异常 {type(e).__name__}: {str(e)[:120]} → 回退到模型循环（发送门控仍然生效）")
            return None
        if res.status == "fallback":
            say(f"  ↩ WeChatSkill 未能自动完成：{res.reason} → 回退到模型循环（发送门控仍然生效）")
            return None
        if res.status == "aborted":
            return "aborted", res.reason
        if res.status == "dry_run_verified":  # v18: --dry-run-no-send calibration (DSCU_WECHAT_DRYRUN=1) — nothing was sent, by design
            say(f"✔ 校准完成（dry-run，未发送）: {res.summary}")
            return "completed_verified", res.summary
        if res.status != "sent_verified":
            say(f"✖ 失败（WeChatSkill）：{res.reason}")
            return "failed", res.reason
        self.registry = StableObjectRegistry()
        self.verifier.reg = self.registry
        self.verifier.rejections = 0
        self.gate.rebind(self.registry)
        verdict = await self.verifier.verify_done(st.task, res.summary, st, None, None)
        say(f"  🔎 独立验证器：{'放行 ✓' if verdict.ok else '拒绝 ✗'} · 覆盖={verdict.coverage} · {verdict.render()[:420]}")
        if verdict.ok and may_commit(verdict):
            self.counters["verifier_pass"] += 1
            say(f"✔ 完成（completed_verified · 覆盖=full · 必需后置条件 {verdict.required_passed}/{verdict.required_total} 全部独立通过）: {res.summary}")
            return "completed_verified", res.summary
        self.counters["verifier_unverified"] += 1
        say(f"⚠ 未完全验证（覆盖={verdict.coverage}）: {verdict.diagnosis[:200]}")
        return ("partially_completed" if verdict.coverage == "partial" else "failed"), f"{res.summary}（{verdict.diagnosis[:120]}）"

    async def _run(self, st: TaskState) -> tuple[str, str]:
        say = self.say
        self.v164.reset_task()
        self.v18.reset_task()
        self.core.begin_task()
        self._cur_state = st
        _ig = self.v164.intent_gate(st)  # v16.4: messaging task without explicit recipient AND body -> needs_clarification, 0 model calls, 0 GUI actions
        if _ig is not None:
            return _ig
        _wr = await self._run_wechat_skill(st)  # v17.1: deterministic WeChatSkill (None => fall through to the model loop)
        if _wr is not None:
            return _wr
        l0 = layer0.parse_file_task(st.task)
        if l0:
            return await self._layer0_file(l0, st)
        self.recovery.reset()
        try:  # v17.1 WebActionGoal: (url, title, expanded_states, dom_text_digest) BEFORE the first action
            await self.verifier.capture_web_baseline(st.task)
        except Exception:  # noqa: BLE001
            pass
        rt = layer0.parse_recycle_task(st.task)
        if rt is not None:
            return await self._layer0_recycle(rt, st)
        _core = await self.core.run(st) if (sys.platform == "win32" or os.environ.get("DSCU_CORE_FORCE") == "1") else None  # v18.1: GoalSpec → RouteGraph → transactions (replaces v17 file/bin branches)
        if _core is not None:
            return _core
        _l17 = await layer0_v17.run(self, st)  # v17 (open_view only since v18.1): fuzzy Desktop file delete · open Shell views with oracle · single-item Recycle-Bin delete/restore
        if _l17 is not None:
            return _l17
        gm = gmail_skill.parse_gmail_task(st.task)
        st.gmail_spec = gm  # type: ignore[attr-defined]
        if gm is not None and os.environ.get("DSCU_GMAIL_API", "1") != "0":
            skill = self.gmail or gmail_skill.GmailSkill()
            if skill.available():
                _gr = await self._run_gmail_skill(gm, skill, st)
                if _gr is not None:
                    return _gr
            elif gm["intent"] == "trash":
                say("  ℹ 未配置加密 Gmail OAuth（运行 `DSCU_MODE=gmail-auth` 或任务提示符内 `v16 gmail-auth` 一次即可，Token 由 Windows DPAPI 加密）→ 走浏览器通道（v16.3 已启用 No page found 透明重选页自愈）：先冻结目标 stable_id，禁止裸坐标绕过。")
        plan: Optional[dict[str, Any]] = None
        last_result = ""
        self.registry = StableObjectRegistry()
        self.verifier.reg = self.registry
        self.verifier.rejections = 0
        self.playbook.reset()
        self.tx = WalTransaction(self.wal, st.task)
        self.tx.begin()
        self.gate.rebind(self.registry)
        gui_frozen_hitl = False
        st.quantity0 = st.quantity  # type: ignore[attr-defined]
        destructive_step = -9
        forced: Optional[str] = None
        for step in range(1, st.max_steps + 1):
            st.step = step
            if time.time() - st.t0 > st.max_seconds:
                return "timeout", "超过任务时限"
            _trip = self.v164.budget.check()
            if _trip is not None:
                _rr = self.core.on_budget_trip(_trip)  # v18.1: no_progress → alternative route (≤3 per task) instead of handing the task back
                if _rr:
                    self.v164.budget.tripped = None
                    self.v164.budget.no_progress_streak = 0
                    say(f"  🔀 无进展熔断 → 自动换路（不交还用户）：{_rr.splitlines()[-1][:160]}")
                    self.core.directive = (self.core.directive + "\n" + _rr).strip()
                    _trip = None
            if _trip is not None:
                self.tx.abort()
                say(f"  🔌 {_trip.message}")
                return _trip.status, _trip.message
            _bw = self.v164.budget.warn_text()
            if _bw:
                say("  " + _bw)
            say(f"── 第 {step} 步 ──")
            b = await self.observe(st, forced=forced, main_loop=True)
            forced = None
            settled = st.settle_last(b.obs)
            _v18n = self.v18.observe(b.obs, step)  # v18: WorldStateDiff of the previous action -> evidence-gated directive
            if settled is not None:
