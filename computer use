#!/usr/bin/env python3
"""Mock `cli-anything-mockdoc` (HARNESS.md-style): --json, export pdf/docx, render png, repl with undo/redo."""
import json, struct, sys, zipfile, zlib

def emit(o): print(json.dumps(o, ensure_ascii=False), flush=True)

def write_pdf(path, text):
    body = f"BT /F1 24 Tf 72 720 Td ({text}) Tj ET".encode()
    objs = [b"<< /Type /Catalog /Pages 2 0 R >>", b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
            b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>",
            b"<< /Length %d >>\nstream\n" % len(body) + body + b"\nendstream",
            b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"]
    out, offs = b"%PDF-1.4\n", []
    for i, o in enumerate(objs, 1):
        offs.append(len(out)); out += b"%d 0 obj\n" % i + o + b"\nendobj\n"
    xr = len(out); out += b"xref\n0 %d\n0000000000 65535 f \n" % (len(objs) + 1)
    for o in offs: out += b"%010d 00000 n \n" % o
    out += b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (len(objs) + 1, xr)
    open(path, "wb").write(out)

def write_docx(path, text):
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml", '<?xml version="1.0"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="xml" ContentType="application/xml"/></Types>')
        z.writestr("word/document.xml", f"<w:document><w:body><w:p><w:r><w:t>{text}</w:t></w:r></w:p></w:body></w:document>")

def write_png(path, w=64, h=64):
    raw = b"".join(b"\x00" + bytes([(x * 4) & 255, (y * 4) & 255, 180] * 1) * 1 for y in range(h) for x in [0]) if False else b""
    rows = b""
    for y in range(h):
        rows += b"\x00" + b"".join(bytes([(x * 4) & 255, (y * 4) & 255, 180]) for x in range(w))
    def ch(t, d): return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    open(path, "wb").write(b"\x89PNG\r\n\x1a\n" + ch(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) + ch(b"IDAT", zlib.compress(rows)) + ch(b"IEND", b""))

def handle(a, state):
    def opt(n, d=None): return a[a.index(n) + 1] if n in a else d
    if a[:1] == ["undo"]:
        state["text"] = state["hist"].pop() if state["hist"] else state["text"]; return {"ok": True, "op": "undo", "text": state["text"]}
    if a[:1] == ["redo"]: return {"ok": True, "op": "redo", "text": state["text"]}
    if a[:2] == ["set", "text"]:
        state["hist"].append(state["text"]); state["text"] = " ".join(a[2:]); return {"ok": True, "text": state["text"]}
    if a[:2] == ["export", "pdf"]: write_pdf(opt("--out"), state["text"]); return {"ok": True, "out": opt("--out")}
    if a[:2] == ["export", "docx"]: write_docx(opt("--out"), state["text"]); return {"ok": True, "out": opt("--out")}
    if a[:2] == ["render", "png"]: write_png(opt("--out")); return {"ok": True, "out": opt("--out")}
    if a[:2] == ["export", "broken"]:
        open(opt("--out"), "wb").write(b"NOT A PDF" * 20); return {"ok": True, "out": opt("--out")}   # exit 0 but garbage
    return {"ok": False, "error": f"unknown {a}"}

def main():
    a = [x for x in sys.argv[1:] if x != "--json"]
    state = {"text": "DSCU", "hist": []}
    if a[:1] == ["repl"]:
        for line in sys.stdin:
            line = line.strip()
            if line == "exit": emit({"ok": True}); return 0
            emit(handle(line.split(), state))
        return 0
    emit(handle(a, state)); return 0

if __name__ == "__main__":
    sys.exit(main())
