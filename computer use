        t0 = time.perf_counter()
        if not await self._ensure_window():
            self._step("window", False, "找不到/无法前置微信主窗口", t0)
            return ms.WeChatResult("fallback", reason="找不到/无法前置微信主窗口", trace=self.trace)
        g = self.geo
        assert g is not None
        self._step("window", True, f"hwnd={self.hwnd} rect=({g.x},{g.y},{g.w},{g.h}) dpi={g.dpi:.2f}", t0)
        epoch = int(time.time())
        await self._calibrate()
        # ---- 1) header-first: the target chat may already be open → no search, no blind clicking
        t1 = time.perf_counter()
        single, grp, ev, titles = await self._header_state(recipient)
        if single:
            s.contact_frozen, s.contact_evidence = True, f"聊天头部已精确等于「{recipient}」（无需搜索）：{ev[:80]}"
            s.single_chat, s.single_chat_evidence, s.chat_hwnd = True, ev, self.hwnd
            self._step("contact_frozen+single_chat", True, s.contact_evidence, t1)
        else:
