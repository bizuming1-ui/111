        mcs, ocs, scs = _as_cands("dml", dml), _as_cands("ocr", ocr), _as_cands("som", som)
        clusters: list = []  # each: {"members": [Cand], "anchor": Cand}
        for c in dcs:
            clusters.append({"members": [c], "anchor": c})
