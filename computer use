IS_WIN = sys.platform == "win32"

# errors that mean "the CDP link/target is gone" -> heal (reconnect / relaunch / re-attach) instead of degrading to UIA
HEAL_RX = re.compile(r"CDP closed|Target crashed|Target closed|Session with given id|No target with given id|connection lost|cannot connect to .*cdp|no reply to|peer error INTERNAL: CDP|websocket", re.I)
SAFE_REPLAY = {"navigate", "key", "scroll", "scroll_into_view", "tabs", "switch_tab", "wait_selector", "wait_settled", "probe"}


class IpcError(RuntimeError):
    pass


class _Proto(asyncio.Protocol):
    def __init__(self, owner: "NdjsonClient") -> None:
        self.owner = owner
        self.buf = b""

    def data_received(self, data: bytes) -> None:
        self.buf += data
        while True:
            i = self.buf.find(b"\n")
            if i < 0:
                break
            line, self.buf = self.buf[:i], self.buf[i + 1:]
            if line.strip():
                self.owner._on_line(line)

    def connection_lost(self, exc: Optional[Exception]) -> None:
        self.owner._on_lost(exc)


class NdjsonClient:
    def __init__(self, address: str, name: str, token: str = "") -> None:
        self.address, self.name, self.token = address, name, token
        self.transport: Optional[asyncio.BaseTransport] = None
        self.pending: dict[str, asyncio.Future[dict[str, Any]]] = {}
        self.lost = True

    def _on_line(self, line: bytes) -> None:
        try:
            m = json.loads(line)
        except Exception:
            return
        f = self.pending.pop(str(m.get("id")), None)
        if f and not f.done():
            f.set_result(m)

    def _on_lost(self, exc: Optional[Exception]) -> None:
        self.lost = True
        for f in self.pending.values():
            if not f.done():
                f.set_exception(IpcError(f"{self.name}: connection lost ({exc})"))
        self.pending.clear()

    async def connect(self, timeout: float = 20.0) -> None:
        loop = asyncio.get_running_loop()
        deadline = time.time() + timeout
        last: Optional[BaseException] = None
        while time.time() < deadline:
            try:
                if IS_WIN and self.address.startswith("\\\\.\\pipe\\"):
                    self.transport, _ = await loop.create_pipe_connection(lambda: _Proto(self), self.address)  # type: ignore[attr-defined]
                else:
                    self.transport, _ = await loop.create_unix_connection(lambda: _Proto(self), self.address)  # type: ignore[attr-defined]
                self.lost = False
                return
            except (FileNotFoundError, ConnectionRefusedError, OSError) as e:
                last = e
                await asyncio.sleep(0.15)
        raise IpcError(f"{self.name}: cannot connect to {self.address}: {last}")

    async def call(self, obj: dict[str, Any], timeout: float = 30.0) -> dict[str, Any]:
        if self.lost or self.transport is None:
            await self.connect(5)
        obj = dict(obj)
        obj.setdefault("id", new_id())
        fut: asyncio.Future[dict[str, Any]] = asyncio.get_running_loop().create_future()
        self.pending[obj["id"]] = fut
        self.transport.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))  # type: ignore[union-attr]
        try:
            return await asyncio.wait_for(fut, timeout)
        except asyncio.TimeoutError:
            self.pending.pop(obj["id"], None)
            raise IpcError(f"{self.name}: no reply to {obj.get('type')}/{obj.get('action')} within {timeout}s")

    async def hello(self, **extra: Any) -> dict[str, Any]:
        r = await self.call({"type": "hello", "token": self.token, **extra}, 15)
        if not r.get("ok"):
            raise IpcError(f"{self.name}: hello rejected: {r}")
        return r

    def close(self) -> None:
        if self.transport:
            self.transport.close()
        self.lost = True


# ------------------------------------------------------------------------------ job object for children
_JOB: Any = None


def _win_job() -> Any:
    global _JOB
    if _JOB is not None or not IS_WIN:
        return _JOB
    import ctypes
    from ctypes import wintypes as w

    class BASIC(ctypes.Structure):
        _fields_ = [("PerProcessUserTimeLimit", ctypes.c_longlong), ("PerJobUserTimeLimit", ctypes.c_longlong), ("LimitFlags", w.DWORD),
                    ("MinimumWorkingSetSize", ctypes.c_size_t), ("MaximumWorkingSetSize", ctypes.c_size_t), ("ActiveProcessLimit", w.DWORD),
                    ("Affinity", ctypes.c_size_t), ("PriorityClass", w.DWORD), ("SchedulingClass", w.DWORD)]

    class IOC(ctypes.Structure):
        _fields_ = [(n, ctypes.c_ulonglong) for n in ("a", "b", "c", "d", "e", "f")]

    class EXT(ctypes.Structure):
        _fields_ = [("Basic", BASIC), ("Io", IOC), ("ProcessMemoryLimit", ctypes.c_size_t), ("JobMemoryLimit", ctypes.c_size_t),
                    ("PeakProcessMemoryUsed", ctypes.c_size_t), ("PeakJobMemoryUsed", ctypes.c_size_t)]

    k32 = ctypes.windll.kernel32
    h = k32.CreateJobObjectW(None, None)
    info = EXT()
    info.Basic.LimitFlags = 0x2000  # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
    k32.SetInformationJobObject(h, 9, ctypes.byref(info), ctypes.sizeof(info))
    _JOB = h
    return h


def spawn(cmd: list[str], env: dict[str, str], cwd: Path, log: Path) -> subprocess.Popen[bytes]:
    log.parent.mkdir(parents=True, exist_ok=True)
    lf = open(log, "ab")
    flags = 0
    if IS_WIN:
        flags = 0x08000000 | 0x00000200  # CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP
    p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=lf, stderr=lf, cwd=str(cwd), env=env, creationflags=flags)
    if IS_WIN:
        try:
            import ctypes
            job = _win_job()
            ctypes.windll.kernel32.AssignProcessToJobObject(job, ctypes.c_void_p(int(p._handle)))  # type: ignore[attr-defined]
        except Exception:
            pass
    return p


# ------------------------------------------------------------------------------------- the hub
class DriverHub:
    """Single access point for the brain. `driver_kind` is 'rust' or 'py-native' (explicit, never hidden)."""

    def __init__(self, cfg: Config) -> None:
        self.cfg = cfg
        self.token = cfg.token or secrets.token_hex(16)
        self.driver_kind = "none"
        self.driver_hello: dict[str, Any] = {}
        self.cdp_hello: dict[str, Any] = {}
        self._drv: Optional[NdjsonClient] = None
        self._native: Any = None
        self._cdp: Optional[NdjsonClient] = None
        self.procs: dict[str, subprocess.Popen[bytes]] = {}
        self.cdp_error: Optional[str] = None
        self.cdp_heals = 0  # successful self-heals (reconnect / relaunch) in this session
        self.cdp_heal_fail = 0
        self.cdp_degraded = 0  # times a browser task had to fall back although heal failed (should stay 0)
        self.cdp_heal_log: list[dict[str, Any]] = []
        self._heal_lock: Optional[asyncio.Lock] = None

    # -- driver
    async def start_driver(self) -> dict[str, Any]:
        cfg = self.cfg
        if not cfg.force_native and cfg.driver_exe.exists() and IS_WIN:
            env = dict(os.environ, DSCU_TOKEN=self.token)
            c = NdjsonClient(cfg.driver_pipe, "dscu-driver", self.token)
            try:
                try:
                    await c.connect(0.6)  # already running?
                except IpcError:
                    self.procs["driver"] = spawn([str(cfg.driver_exe), "--pipe", cfg.driver_pipe], env, cfg.root, cfg.data_dir / "driver.log")
                    await c.connect(8)
                self.driver_hello = await c.hello(own_pid=os.getpid())
