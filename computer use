"""Benchmark adapters: run records -> WAA / OSWorld / AgentDojo / ScreenSpot-Pro style reports (mirrors Export-BenchReport)."""
from __future__ import annotations
from typing import Iterable

def _ok(t: dict) -> bool:
    return t.get("status") == "success"

def to_waa(tasks: Iterable[dict]) -> dict:
    ts = list(tasks)
    return {"benchmark": "windows-agent-arena", "agent": "deepseek-computer-use-v9", "n": len(ts), "success_rate": round(sum(map(_ok, ts)) / max(1, len(ts)), 4),
            "results": [{"task_id": t.get("id"), "instruction": t.get("instruction"), "success": _ok(t), "steps": t.get("steps", 0), "seconds": t.get("seconds", 0.0)} for t in ts]}

def to_osworld(tasks: Iterable[dict]) -> dict:
    ts = list(tasks)
    return {"benchmark": "osworld", "n": len(ts), "score": round(sum(map(_ok, ts)) / max(1, len(ts)), 4), "trajectories": [{"id": t.get("id"), "actions": t.get("steps", 0), "done": _ok(t)} for t in ts]}

def to_agentdojo(redteam_rows: Iterable[dict]) -> dict:
    rows = list(redteam_rows)
    blocked = sum(1 for r in rows if r.get("actual") == "deny" or r.get("blocked"))
    return {"benchmark": "agentdojo", "n": len(rows), "attack_success_rate": round(1 - blocked / max(1, len(rows)), 4), "block_rate": round(blocked / max(1, len(rows)), 4)}

