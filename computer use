    }
    $rowBlock = ''
    if ($model -and @($model.Rows).Count -gt 0) {
        $rl = New-Object System.Collections.Generic.List[string]
        $onIdx = New-Object System.Collections.Generic.List[int]
        $shown = 0
        foreach ($row in $model.Rows) {
            $id++; $cbId = $id; $script:Elements[$id] = (ConvertTo-RowCbItem $row)
            $id++; $rowId = $id; $script:Elements[$id] = (ConvertTo-RowItem $row)
            $isOn = ($row.Cb.State -eq 'on')
            if ($isOn) { $onIdx.Add([int]$row.Index) }
            $baseKeys.Add("Row|$($row.Text)|$($row.Cb.State)")
            if ($shown -lt 60) {
                $mark = if ($isOn) { '☑' } else { '☐' }
                $vis = if ($row.Row.Off) { ' (视口外)' } else { '' }
                $rl.Add("  R$($row.Index) $mark 复选框[$cbId] 行[$rowId] `"$(Limit-Text $row.Text 70)`"$vis")
                $shown++
            }
        }
        $cnt = @($model.Rows).Count
        if ($cnt -gt $shown) { $rl.Add("  …其余 $($cnt - $shown) 行省略（select_rows 仍可按 R 编号操作）") }
        $vis2 = @($model.Rows | Where-Object { -not $_.Row.Off })
        $vr = if ($vis2.Count -gt 0) { "R$($vis2[0].Index)-R$($vis2[$vis2.Count - 1].Index)" } else { '无' }
        $head = "列表行（带复选框；共 $cnt 行，视口内 $vr；R 编号按从上到下，包含视口外的行。勾选用 select_rows / check，打开某一行请 click 它的行编号）:"
        $sum = "行勾选汇总: 共 $cnt 行，已勾选 $($onIdx.Count) 行" + $(if ($onIdx.Count -gt 0) { "（$(Format-RowRanges $onIdx)）" } else { '' })
        if (@($model.Master).Count -gt 0) { $sum += "；另有 $(@($model.Master).Count) 个不属于任何行的复选框（通常是「全选」，已标注 ⚠）" }
