        return ok("## Console messages\n<no console messages found>")
    if name == "click_at":
        return ok("clicked at")
    if name == "evaluate_script":
        f = a.get("function", "")
        if "devicePixelRatio" in f and "outerHeight" in f:
            return js_reply({"dpr": FAKE_DPR, "innerWidth": 1200, "innerHeight": 700, "outerWidth": 1216, "outerHeight": 800, "screenX": 100, "screenY": 50,
                             "vv": {"width": 1200, "height": 700, "scale": 1}, "hasFocus": True, "vis": "visible"})
        if "const MODE" in f and "const AMT" in f:
            strat = re.search(r'const STRAT = "(\w+)"', f).group(1)
            mode = re.search(r'const MODE = "(\w+)"', f).group(1)
            amt = int(re.search(r"const AMT = (-?\d+)", f).group(1))
            before = STATE["scroll_top"]
            tgt = before + amt if mode == "by" else STATE["scroll_max"] if mode == "to_bottom" else 0 if mode == "to_top" else before
            tgt = max(0, min(STATE["scroll_max"], tgt))
            if strat not in FAKE_SCROLL_BROKEN:
                STATE["scroll_top"] = tgt
            return js_reply({"requested": tgt - before, "before": before, "strategy": strat})
        def _desc() -> dict:
            top = STATE["scroll_top"]
            return {"tag": "DIV", "cls": "Tm aeJ", "role": "", "scrollTop": top, "scrollHeight": STATE["scroll_max"] + 600, "clientHeight": 600, "maxTop": STATE["scroll_max"],
                    "isDoc": False, "sig": "s%d:12" % (top // 40), "rows": 50}
        if "const HINTS" in f:
            d = _desc()
            d.update(candidates=2, docScrollable=True)
            return js_reply(d)
        if "data-dscu-scroller" in f and "return describe(el)" in f:
            return js_reply(_desc())
        if "getBoundingClientRect" in f and "map" in f:
            return js_reply([[10, 20 + 30 * i, 120, 24] for i in range(len(a.get("args") or []))])
        if "location.href" in f and "title" in f and "needles" not in f:
            return js_reply({"url": p["url"], "title": title_of(p)})
        if "needles" in f:
            nd = re.search(r"const nd = (\[.*?\]);", f, re.S)
            names = json.loads(nd.group(1)) if nd else []
            return js_reply({"url": p["url"], "title": title_of(p), "readyState": "complete", "body_len": 99, "inputs": list(STATE["values"].values()),
                             "needles": {n: ("alice" in n or n in p["url"]) for n in names}, "has_video_player": False})
        if "readyState" in f:
            return js_reply("complete")
        if "querySelectorAll('canvas')" in f:
            return js_reply(1 if "canvas" in p["url"] else 0)
        if "scrollBy" in f:
            return js_reply({"before": 0, "after": 300, "target": "window"})
        if "el.value !== undefined" in f:
            v = next(iter(STATE["values"].values()), "")
            return js_reply(v)
        if "document.title" in f:
            return js_reply(title_of(p))
        if "document.querySelector(" in f:
            return js_reply(False)
        return js_reply(True)
    return err("unknown tool " + name)


def _spawn_child() -> None:
    pf = os.environ.get("FAKE_BROWSER_PIDFILE", "")
    if not pf:
        return
    import atexit
    import subprocess

    ch = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(3600)"])
    STATE["child"] = ch
    with open(pf, "w", encoding="utf-8") as f:
        f.write(str(ch.pid))
    atexit.register(lambda: ch.poll() is None and ch.kill())


def send(o: dict) -> None:
    sys.stdout.write(json.dumps(o) + "\n")
    sys.stdout.flush()


def main() -> None:
    _spawn_child()
    if ARGV_FILE:
        with open(ARGV_FILE, "w", encoding="utf-8") as f:
            json.dump({"argv": sys.argv[1:]}, f)
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        m = json.loads(line)
        meth, rid = m.get("method"), m.get("id")
        if meth == "initialize":
