_PS_LIST = (
    "$ErrorActionPreference='Stop';"
    "$sh=New-Object -ComObject Shell.Application;$ns=$sh.NameSpace(10);"
    "$col=@{};0..14|%{$h=$ns.GetDetailsOf($null,$_);if($h){$col[$h]=$_}};"
    "$oc=1;foreach($k in $col.Keys){if($k -match 'Original|原|位置'){$oc=$col[$k]}};"
    "$dc=2;foreach($k in $col.Keys){if($k -match 'Deleted|删除'){$dc=$col[$k]}};"
    "$o=@();foreach($i in $ns.Items()){$o+=[pscustomobject]@{n=[string]$i.Name;p=[string]$i.Path;s=[int64]$i.Size;"
    "l=[string]$ns.GetDetailsOf($i,$oc);d=[string]$ns.GetDetailsOf($i,$dc);f=[bool]$i.IsFolder}};"
    "$j=ConvertTo-Json -InputObject @($o) -Compress;"
    "[Console]::Out.WriteLine([Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($j)))"
)
_PS_WINDOWS = (
    "$ErrorActionPreference='SilentlyContinue';$sh=New-Object -ComObject Shell.Application;$o=@();"
    "foreach($w in $sh.Windows()){$p='';try{$p=[string]$w.Document.Folder.Self.Path}catch{};"
    "$o+=[pscustomobject]@{h=[int64]$w.HWND;n=[string]$w.LocationName;u=[string]$w.LocationURL;p=$p}};"
    "$j=ConvertTo-Json -InputObject @($o) -Compress;[Console]::Out.WriteLine([Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($j)))"
)


def _ps_json(script: str, timeout: float = 25.0) -> Optional[list[dict[str, Any]]]:
    exe = shutil.which("pwsh") or shutil.which("pwsh.exe") or shutil.which("powershell.exe")
    if not exe:
        return None
    try:
        p = subprocess.run([exe, "-NoProfile", "-NonInteractive", "-Command", script], capture_output=True, timeout=timeout, creationflags=0x08000000)
        out = [ln for ln in p.stdout.decode("ascii", "ignore").strip().splitlines() if ln.strip()]
        if not out:
            return None
        j = json.loads(base64.b64decode(out[-1]).decode("utf-8"))
        return j if isinstance(j, list) else [j]
    except Exception:  # noqa: BLE001
        return None


def _ext_of_path(p: str) -> str:
    return Path(p).suffix if p else ""


def _full_name(name: str, bin_path: str) -> str:
    """`item.Name` hides known extensions ('相机'); the backing path keeps it ('$R1AB.txt') -> '相机.txt'."""
    ext = _ext_of_path(bin_path)
    if ext and not norm(name).endswith(norm(ext)):
        return f"{name}{ext}"
    return name


def _build_item(name: str, path: str, size: Any, loc: str, deleted: str, is_dir: bool) -> BinItem:
    full = _full_name(name, path)
    loc = (loc or "").strip().strip("\u200e\u200f")
    orig = str(Path(loc) / full) if loc else ""
    try:
        sz = int(size or 0)
    except (TypeError, ValueError):
        sz = 0
    return BinItem(name=full, original=orig, bin_path=path or "", size=sz, deleted=(deleted or "").strip().strip("\u200e\u200f"), is_dir=bool(is_dir))


class ComBackend(ShellBackend):
    """Production backend: in-process COM through comtypes; PowerShell(Base64-UTF8) fallback; ctypes SHQueryRecycleBinW."""

    def __init__(self) -> None:
        self.channel = ""

    # ---- COM -------------------------------------------------------------------------------
    def _shell(self) -> Any:
        import comtypes.client  # type: ignore[import-not-found]

        try:
            import comtypes  # type: ignore[import-not-found]

            comtypes.CoInitialize()
        except Exception:  # noqa: BLE001
            pass
        return comtypes.client.CreateObject("Shell.Application")

    def list_items(self) -> list[BinItem]:
        if not IS_WIN:
            return []
        try:
            sh = self._shell()
            ns = sh.NameSpace(10)
            oc, dc = 1, 2
            for i in range(0, 15):
                h = str(ns.GetDetailsOf(None, i) or "")
                if re.search(r"Original|原|位置", h):
                    oc = i
                if re.search(r"Deleted|删除", h):
                    dc = i
            out: list[BinItem] = []
            items = ns.Items()
            for k in range(int(items.Count)):
                it = items.Item(k)
                out.append(_build_item(str(it.Name), str(it.Path), it.Size, str(ns.GetDetailsOf(it, oc) or ""), str(ns.GetDetailsOf(it, dc) or ""), bool(it.IsFolder)))
            self.channel = "comtypes.Shell.Application.NameSpace(10)"
            return out
        except Exception:  # noqa: BLE001
            rows = _ps_json(_PS_LIST)
            if rows is None:
                return []
            self.channel = "powershell.Shell.Application.NameSpace(10)[base64-utf8]"
            return [_build_item(r.get("n", ""), r.get("p", ""), r.get("s", 0), r.get("l", ""), r.get("d", ""), r.get("f", False)) for r in rows if isinstance(r, dict)]

    def windows(self) -> list[ShellWin]:
        if not IS_WIN:
            return []
        wins: list[ShellWin] = []
        try:
            sh = self._shell()
            col = sh.Windows()
            for k in range(int(col.Count)):
                w = col.Item(k)
                if w is None:
                    continue
                path = ""
                try:
                    path = str(w.Document.Folder.Self.Path)
                except Exception:  # noqa: BLE001
                    pass
                try:
                    wins.append(ShellWin(hwnd=int(w.HWND), name=str(w.LocationName), url=str(w.LocationURL), path=path))
                except Exception:  # noqa: BLE001
                    continue
        except Exception:  # noqa: BLE001
            rows = _ps_json(_PS_WINDOWS) or []
            wins = [ShellWin(hwnd=int(r.get("h", 0)), name=r.get("n", ""), url=r.get("u", ""), path=r.get("p", "")) for r in rows if isinstance(r, dict)]
        for w in wins:
            _enrich_win32(w)
        return wins

    def count_api(self) -> Optional[int]:
        if not IS_WIN:
            return None
        import ctypes
        from ctypes import wintypes

        class SHQUERYRBINFO(ctypes.Structure):
            _fields_ = [("cbSize", wintypes.DWORD), ("i64Size", ctypes.c_longlong), ("i64NumItems", ctypes.c_longlong)]

        info = SHQUERYRBINFO()
        info.cbSize = ctypes.sizeof(info)
        if ctypes.windll.shell32.SHQueryRecycleBinW(None, ctypes.byref(info)) != 0:  # type: ignore[attr-defined]
            return None
        return int(info.i64NumItems)

    # ---- mutations ---------------------------------------------------------------------------
    @staticmethod
    def _sibling_i(bin_path: str) -> str:
        p = Path(bin_path)
        return str(p.with_name("$I" + p.name[2:])) if p.name.upper().startswith("$R") else ""

    def delete_store(self, item: BinItem) -> tuple[bool, str]:
        r = Path(item.bin_path)
        if not item.bin_path or "$recycle.bin" not in item.bin_path.lower() or not r.name.upper().startswith("$R"):
            return False, f"拒绝：不是回收站后备存储路径 {item.bin_path!r}"
        if item.is_dir:
            return False, "拒绝：recycle_bin_remove_item 只处理单个文件，不处理文件夹"
        errs: list[str] = []
        for p in (str(r), self._sibling_i(item.bin_path)):
            if not p:
                continue
            try:
                if os.path.lexists(p):
                    os.remove(p)
            except OSError as e:
                errs.append(f"{Path(p).name}: {e.__class__.__name__}")
                ok, msg = self._shfile_delete(p)
                if not ok:
                    errs.append(msg)
        if os.path.lexists(str(r)):
            return False, "后备文件仍在：" + "；".join(errs)
        return True, "已永久删除回收站后备存储（$R + $I）" + (f"（部分经 SHFileOperationW 兜底：{'；'.join(errs)}）" if errs else "")

    @staticmethod
    def _shfile_delete(path: str) -> tuple[bool, str]:
        if not IS_WIN:
            return False, "非 Windows"
        import ctypes
        from ctypes import wintypes

        class SHFILEOPSTRUCTW(ctypes.Structure):
            _fields_ = [("hwnd", wintypes.HWND), ("wFunc", wintypes.UINT), ("pFrom", wintypes.LPCWSTR), ("pTo", wintypes.LPCWSTR), ("fFlags", wintypes.WORD),
                        ("fAnyOperationsAborted", wintypes.BOOL), ("hNameMappings", ctypes.c_void_p), ("lpszProgressTitle", wintypes.LPCWSTR)]

        buf = ctypes.create_unicode_buffer(path + "\0")
        op = SHFILEOPSTRUCTW()
        op.wFunc = 3
        op.pFrom = ctypes.cast(buf, wintypes.LPCWSTR)
        op.fFlags = 0x4 | 0x10 | 0x400  # SILENT | NOCONFIRMATION | NOERRORUI  (no ALLOWUNDO => permanent)
        rc = ctypes.windll.shell32.SHFileOperationW(ctypes.byref(op))  # type: ignore[attr-defined]
        return rc == 0 and not op.fAnyOperationsAborted, f"SHFileOperationW rc={rc}"

    def restore(self, item: BinItem) -> tuple[bool, str]:
        if not IS_WIN:
            return False, "非 Windows"
        try:
            sh = self._shell()
            ns = sh.NameSpace(10)
            items = ns.Items()
            for k in range(int(items.Count)):
                it = items.Item(k)
                if str(it.Path) == item.bin_path:
                    try:
                        it.InvokeVerb("undelete")
                        return True, "InvokeVerb('undelete')"
                    except Exception:  # noqa: BLE001
                        for v in it.Verbs():
                            if re.search(r"还原|恢复|Restore|undelete", str(v.Name).replace("&", ""), re.I):
                                v.DoIt()
                                return True, f"Verb「{str(v.Name).replace('&', '')}」"
        except Exception:  # noqa: BLE001
            pass
        if item.original and item.bin_path and Path(item.bin_path).exists() and not Path(item.original).exists() and Path(item.original).parent.exists():
            try:
                shutil.move(item.bin_path, item.original)
                i = self._sibling_i(item.bin_path)
                if i and os.path.lexists(i):
                    os.remove(i)
                return True, "手动还原：$R → 原路径并清理 $I"
            except OSError as e:
                return False, f"手动还原失败：{e}"
        return False, "没有可用的还原途径"


def _enrich_win32(w: ShellWin) -> None:
    if not IS_WIN or not w.hwnd:
        return
    try:
        import ctypes
        from ctypes import wintypes

        u32, k32 = ctypes.windll.user32, ctypes.windll.kernel32  # type: ignore[attr-defined]
        buf = ctypes.create_unicode_buffer(256)
        u32.GetClassNameW(w.hwnd, buf, 256)
        w.cls = buf.value
        w.visible = bool(u32.IsWindowVisible(w.hwnd)) and not bool(u32.IsIconic(w.hwnd))
        pid = wintypes.DWORD()
        u32.GetWindowThreadProcessId(w.hwnd, ctypes.byref(pid))
        h = k32.OpenProcess(0x1000, False, pid.value)  # PROCESS_QUERY_LIMITED_INFORMATION
        if h:
            sz = wintypes.DWORD(520)
            pb = ctypes.create_unicode_buffer(520)
            if k32.QueryFullProcessImageNameW(h, 0, pb, ctypes.byref(sz)):
                w.process = Path(pb.value).name.lower()
            k32.CloseHandle(h)
    except Exception:  # noqa: BLE001
        pass


# ================================================================================ find / select
STRICT = 0.99  # destructive actions auto-run ONLY on an exact file name / exact stem match; fuzzier hits become a clarification


def find_items(query: str, items: list[BinItem], min_score: float = STRICT) -> FindResult:
    q = clean_reference(query)
    if q in GENERIC:
        return FindResult("none", [], q)
    scored = sorted(((_score(q, it.name), it) for it in items if not it.is_dir), key=lambda t: -t[0])
    good = [(s, it) for s, it in scored if s >= min_score]
    if not good:
        near = [(s, it) for s, it in scored if s >= 0.86]
        return FindResult("suggest", [it for _, it in near[:5]], q, [s for s, _ in near[:5]]) if near else FindResult("none", [], q)
    top = good[0][0]
    tied = [(s, it) for s, it in good if abs(s - top) < 0.02]
    if len(tied) == 1:
        return FindResult("unique", [tied[0][1]], q, [tied[0][0]])
    return FindResult("ambiguous", [it for _, it in tied], q, [s for s, _ in tied])


# ================================================================================ independent oracle
def _row(name: str, ok: bool, detail: str, kind: str = "recycle", evaluated: bool = True, source: str = "") -> dict[str, Any]:
    return {"name": name, "ok": ok, "detail": detail, "kind": kind, "evaluated": evaluated, "source": source}


def verify_item_gone(item: BinItem, backend: ShellBackend, count_before: Optional[int] = None, timeout: float = 6.0) -> list[dict[str, Any]]:
    """The Recycle Bin must (1) no longer list the item, (2) no longer hold its `$R` store, (3) hold exactly one entry fewer (SHQueryRecycleBinW)."""
    end = time.time() + timeout
    while True:
        cur = backend.list_items()
        still = [c for c in cur if (c.bin_path and c.bin_path == item.bin_path) or (not c.bin_path and c.name == item.name and c.original == item.original)]
        if not still or time.time() >= end:
            break
        time.sleep(0.4)
    rows = [_row("bin_item_gone", not still, f"NameSpace(10) 现有 {len(cur)} 项；{'已无' if not still else '仍有'}「{item.name}」", source="Shell.Application.NameSpace(10)")]
    r_exists = bool(item.bin_path) and os.path.lexists(item.bin_path)
    rows.append(_row("bin_store_removed", not r_exists, f"后备文件 {Path(item.bin_path).name if item.bin_path else '?'} {'已不存在' if not r_exists else '仍在磁盘'}", source="filesystem",
                     evaluated=bool(item.bin_path)))
    if count_before is not None:
        n = backend.count_api()
        if n is None:
            rows.append(_row("bin_count_minus_one", True, "SHQueryRecycleBinW 不可用 → 未评估", evaluated=False, source="SHQueryRecycleBinW"))
        else:
            rows.append(_row("bin_count_minus_one", n == count_before - 1, f"SHQueryRecycleBinW {count_before}→{n}", source="SHQueryRecycleBinW"))
    return rows


def remove_item(item: BinItem, backend: ShellBackend) -> tuple[bool, str, list[dict[str, Any]]]:
    before = backend.count_api()
    ok, msg = backend.delete_store(item)
    rows = verify_item_gone(item, backend, before)
    good = ok and all(r["ok"] for r in rows if r["evaluated"])
    return good, msg, rows


def restore_item(item: BinItem, backend: ShellBackend) -> tuple[bool, str, list[dict[str, Any]]]:
    ok, msg = backend.restore(item)
    time.sleep(0.3) if IS_WIN else None
    rows = verify_item_gone(item, backend, None)
    if item.original:
        ex = Path(item.original).exists()
        rows.append(_row("restored_to_original", ex, f"{item.original} {'已存在' if ex else '不存在'}", kind="file", source="filesystem"))
    return ok and all(r["ok"] for r in rows if r["evaluated"]), msg, rows


# ================================================================================ Shell-window oracle
def _matches_view(w: ShellWin, view: str, desktop_path: str = "", extra_paths: Iterable[str] = ()) -> bool:
    blob = f"{w.path} {w.url}".lower()
    if view == "recyclebin":
        return RECYCLE_CLSID in blob or "recycle" in blob or norm(w.name) in VIEW_TITLES["recyclebin"]
    if view in ("desktop", "downloads", "documents"):
        names = VIEW_TITLES[view]
        paths = [norm(p).replace("/", "\\") for p in ([desktop_path] if view == "desktop" and desktop_path else []) + list(extra_paths) if p]
        wp = norm(w.path).replace("/", "\\")
        return (bool(wp) and wp in paths) or norm(w.name) in names
    return False


def window_evidence(view: str, backend: ShellBackend, paths: Iterable[str] = ()) -> list[ShellWin]:
    """All VISIBLE CabinetWClass Shell windows that really show `view` (never 'any explorer window')."""
    out = []
    for w in backend.windows():
        if not _matches_view(w, view, extra_paths=paths):
            continue
        if w.cls and w.cls != "CabinetWClass":
            continue
        if w.process and w.process != "explorer.exe":
            continue
        out.append(w)
    return out


def wait_shell_window(view: str, backend: ShellBackend, paths: Iterable[str] = (), timeout: float = 8.0, need_visible: bool = True) -> Optional[ShellWin]:
    end = time.time() + timeout
    while True:
        wins = window_evidence(view, backend, paths)
        if need_visible:
            wins = [w for w in wins if w.visible or not IS_WIN]
        if wins:
            return wins[0]
        if time.time() >= end:
            return None
        time.sleep(0.35)


# ================================================================================ fuzzy local file resolver
def user_roots() -> dict[str, Path]:
    from ..layer0 import known_folder

    return {"桌面": known_folder("桌面"), "文档": known_folder("文档"), "下载": known_folder("下载")}


@dataclass
class FileResolution:
    status: str  # unique | ambiguous | none
    path: Optional[Path] = None
    candidates: list[Path] = field(default_factory=list)
    query: str = ""
    folder_name: str = ""
    score: float = 0.0


def resolve_user_file(query: str, folder_hint: str = "", roots: Optional[dict[str, Path]] = None) -> FileResolution:
    """`相机` -> Desktop\\相机.txt.  Scope: folder named in the task, else Desktop > Documents > Downloads.  Files only, no temp/lock files, unique-or-clarify."""
    q = clean_reference(query)
    if q in GENERIC:
        return FileResolution("none", query=q)
    roots = roots or user_roots()
    order = [folder_hint] if folder_hint in roots else list(roots)
    sugg: list[Path] = []
    sugg_folder = ""
    for fname in order:
        folder = roots[fname]
        try:
            files = [f for f in folder.iterdir() if f.is_file() and not f.name.startswith(("~$", "."))]
        except OSError:
            continue
        scored = sorted(((_score(q, f.name), f) for f in files), key=lambda t: (-t[0], -_mtime(t[1])))
        good = [(s, f) for s, f in scored if s >= STRICT and f.suffix.lower() not in (".lnk",)]
        if not good:
            near = [f for s, f in scored if s >= 0.86 and f.suffix.lower() not in (".lnk",)]
            if near and not sugg:
                sugg = near[:5]
                sugg_folder = fname
            continue
        top = good[0][0]
        tied = [f for s, f in good if abs(s - top) < 0.02]
        # a shortcut (.lnk) never outranks a document; two different docs with the same score => ambiguous
        if len(tied) == 1:
            return FileResolution("unique", tied[0], tied, q, fname, top)
        return FileResolution("ambiguous", None, tied, q, fname, top)
    if sugg:
        return FileResolution("suggest", None, sugg, q, sugg_folder, 0.9)
    return FileResolution("none", query=q)


def _mtime(p: Path) -> float:
    try:
        return p.stat().st_mtime
    except OSError:
        return 0.0


# ================================================================================ Layer-0 intent parsing
_NOT_FILE_CTX = re.compile(r"邮件|邮箱|e-?mail|gmail|网页|网站|标签页|浏览器|微信|消息|聊天|选中的|所选|文字|文本框|段落|行$|图层|画布|评论|对话", re.I)
_DEL = r"(?:永久删除|彻底删除|删除|删掉|移除|清除|delete|remove)"
_RESTORE = r"(?:还原|恢复|restore|undelete)"
_IN_BIN = r"回收站(?:里面|里边|里|中|内)?"


def parse_v17_task(task: str) -> Optional[dict[str, Any]]:
    """Deterministic Layer-0 intents (return None => fall through to the existing router / LLM).

    open_view   : 打开回收站 / 打开桌面 …            (no other verb)
    bin_remove  : (在)回收站里(面)删除X文件 / 删除回收站里(面)的X   -> permanent delete of ONE bin item
    bin_restore : 还原回收站里的X / 把X从回收站还原
    file_delete : 删除X / 把桌面上的X文件删除[，并打开回收站]       -> move ONE resolved file to the Recycle Bin (+ optional open)
    """
    t = unicodedata.normalize("NFKC", task).strip()
    if not t or _NOT_FILE_CTX.search(t):
        return None
    if re.search(r"清空|empty", t, re.I) and re.search(r"回收站|recycle", t, re.I):
        return None  # existing Layer 0 (parse_recycle_task) owns 'empty the bin'
    # ---- open a Shell view only
    m = re.fullmatch(r"(?:请|帮我|麻烦)?(?:你)?(?:先)?(?:再)?(?:打开|显示|进入|open)(?:一下)?(?:我的)?(回收站|recycle bin|桌面|下载|文档|desktop|downloads|documents)(?:窗口|文件夹)?[。.!！]?", t, re.I)
    if m:
        from .. import safe_shell

        v = safe_shell.normalize_view(m.group(1))
        return {"kind": "open_view", "view": v or "recyclebin"} if v else None
    # ---- restore from bin
    if re.search(_IN_BIN, t) and re.search(_RESTORE, t):
        name = _extract_name(t, _RESTORE)
        return {"kind": "bin_restore", "name": name} if name else None
    # ---- delete inside the bin (explicit locative: 回收站里(面) … 删除 …  /  删除回收站里(面)的 …)
    if re.search(rf"{_IN_BIN}.{{0,12}}{_DEL}|{_DEL}.{{0,6}}{_IN_BIN}(?:的|里的)?", t) and not re.search(r"桌面上的|文档里的|下载里的", t):
        name = _extract_name(t, _DEL)
        return {"kind": "bin_remove", "name": name} if name else None
    # ---- delete a real file (to the bin)
    if re.search(_DEL, t) and not re.search(_IN_BIN, t.replace("打开回收站", "").replace("并打开回收站", "")):
        body = re.sub(r"[，,、]?\s*(?:并|然后|再|接着)?(?:把|将)?\s*(?:打开|显示|进入)(?:一下)?回收站.*$", "", t)
        name = _extract_name(body, _DEL)
        if not name:
            return None
        hint = next((f for f in ("桌面", "文档", "下载") if f in body), "")
        return {"kind": "file_delete", "name": name, "folder": hint, "open_bin": bool(re.search(r"打开.{0,4}回收站|显示.{0,4}回收站", t))}
    return None


def _extract_name(t: str, verb_rx: str) -> str:
    s = t
    s = re.sub(rf"{_IN_BIN}", " ", s)
    s = re.sub(verb_rx, " ", s)
    s = re.sub(r"(?:把|将|从|在|对|帮我|请|你先|你再|直接|一下|立即|马上|彻底|永久|桌面上的|桌面上|桌面里的|桌面)", " ", s)
    s = re.sub(r"^\s*(?:你先|你再|先|再)\s*", "", s)
    s = re.sub(r"[，,。；;！!？?、]", " ", s)
    cand = [p for p in re.split(r"\s+", s) if p]
    ref = clean_reference("".join(cand))
    return "" if ref in GENERIC else ref
'@

Add-DscuFile 'agent_brain/layer0_v17.py' '608f1f9211d1fd358467fce570d0a0738d34e8079cd873e85094fdbe75ee2978' @'
"""
v17 Layer 0 router: deterministic, LLM-free closures for the tasks that failed in the 8c4dfc4 log.

  打开回收站 / 打开桌面          -> open_known_folder + Shell-window oracle (Shell.Application.Windows + CabinetWClass + visible + foreground)
  [v18.1] 删除 / 还原 / 序数(前面两个·最后三条·第3个) / 跨位置检索 / 遮挡换路 → agent_brain/core_loop.py (GoalEngine + WorldModel + ActionTransaction + RecoveryPlanner)；本模块只保留 open_view。

Every flow ends in `completed_verified (coverage=full)` ONLY when every evaluated oracle row passed; otherwise `unverified`/`failed` with the failing rows.
Returns None when the sentence is not one of these intents (the existing router / LLM takes over) or when the target cannot be resolved at all.
"""
from __future__ import annotations

import asyncio
import sys
from typing import Any, Optional

from .skills import recycle_bin as rb


def _fmt(rows: list[dict[str, Any]]) -> str:
    return " ; ".join(f"{'✓' if r['ok'] else '✗'}{r['name']}({str(r['detail'])[:90]}{'' if r['evaluated'] else ' · 未评估'})" for r in rows)


def _coverage(rows: list[dict[str, Any]]) -> str:
    ev = [r for r in rows if r["evaluated"]]
    if not ev:
        return "none"
    if not all(r["ok"] for r in ev):
        return "none"
    return "full" if len(ev) == len(rows) else "partial"


def _fg_root() -> int:
    if sys.platform != "win32":
        return 0
    import ctypes

    u = ctypes.windll.user32  # type: ignore[attr-defined]
    return int(u.GetAncestor(u.GetForegroundWindow(), 2))  # GA_ROOT


async def open_view_with_oracle(orch: Any, st: Any, view: str, be: rb.ShellBackend, say: Any) -> tuple[bool, list[dict[str, Any]]]:
    paths: list[str] = []
    if view in ("desktop", "downloads", "documents"):
        from .layer0 import known_folder

        paths = [str(known_folder({"desktop": "桌面", "downloads": "下载", "documents": "文档"}[view]))]
    say(f"  动作: action=open_known_folder name={view}")
    r = await orch.execute({"action": "open_known_folder", "name": view}, await orch.observe(st, forced="dxgi_vision"), st)
    say(f"  结果: [{r.code.value}] {r.message[:240]}")
    w = await asyncio.to_thread(rb.wait_shell_window, view, be, paths, 8.0, True)
    rows: list[dict[str, Any]] = []
    if w is None:
        rows.append(rb._row("shell_window_open", False, f"Shell.Application.Windows() 中没有显示 {view} 的可见 CabinetWClass 窗口", "window", source="Shell.Application.Windows"))
        return False, rows
    rows.append(rb._row("shell_window_open", True, f"「{w.name}」hwnd={w.hwnd} path={(w.path or w.url)[:60]}", "window", source="Shell.Application.Windows"))
    rows.append(rb._row("shell_window_class", (w.cls in ("", "CabinetWClass")), f"class={w.cls or '?'} process={w.process or '?'}", "window", evaluated=bool(w.cls), source="Win32.GetClassNameW"))
    rows.append(rb._row("shell_window_visible", bool(w.visible) or sys.platform != "win32", f"IsWindowVisible={w.visible}", "window", source="Win32.IsWindowVisible"))
    try:
        b = await orch.observe(st, forced="dxgi_vision")
        await orch._focus(b, hwnd=w.hwnd)
        await asyncio.sleep(0.25)
    except Exception:  # noqa: BLE001
        pass
    fg = _fg_root()
    rows.append(rb._row("shell_window_foreground", fg == w.hwnd, f"前台 hwnd={fg} {'==' if fg == w.hwnd else '≠'} 目标 hwnd={w.hwnd}", "window", evaluated=bool(fg), source="Win32.GetForegroundWindow"))
    return all(x["ok"] for x in rows if x["evaluated"]), rows


async def run(orch: Any, st: Any) -> Optional[tuple[str, str]]:
    intent = rb.parse_v17_task(st.task)
    if not intent or sys.platform != "win32":
        return None
    say = orch.say
    be = rb.ComBackend()
    kind = intent["kind"]
    n = 1
    say(f"── 第 {n} 步 ──")
    say(f"  [Layer 0 v17: {kind}] 确定性 Shell/COM 原语（免 LLM / 免 GUI 点击 / 无 OBJECT_IDENTITY 死锁）；意图来自任务原文：{intent}")

    def finish(rows: list[dict[str, Any]], what: str, steps: int) -> tuple[str, str]:
        cov = _coverage(rows)
        say(f"  🔎 独立 Oracle：{_fmt(rows)}")
        if cov == "full":
            orch.counters["verifier_pass"] += 1
            summary = f"{what}（coverage=full，{len(rows)} 项独立证据全部通过；Layer 0 共 {steps} 步，0 次 LLM 调用）"
            say(f"✔ 完成（completed_verified · coverage=full · Shell/COM Oracle）: {summary}")
            return "completed_verified", summary
        bad = [r for r in rows if not r["ok"]]
        say(f"⚠ 未能完全验证（coverage={cov}）：{'; '.join(r['name'] + ':' + str(r['detail'])[:60] for r in bad) or '部分证据未评估'}")
        orch.counters["verifier_rejects"] += 1
        return ("unverified" if not bad else "failed"), f"{what}（coverage={cov}）：{_fmt(bad) if bad else '部分证据未评估'}"

    # ------------------------------------------------------------------ open a Shell view
    if kind == "open_view":
        ok, rows = await open_view_with_oracle(orch, st, intent["view"], be, say)
        return finish(rows, f"已打开并独立核验 Shell 窗口（{intent['view']}）", 1)

    # v18.1: file_delete / bin_remove / bin_restore (and every ordinal / cross-location / recovery concern) moved to core_loop.CoreLoop:
    # GoalSpec (agent_brain/goal_engine.py) · WorldModel (world_model.py) · ActionTransaction (action_tx.py) · RecoveryPlanner (recovery_planner.py).
    return None

'@

Add-DscuFile 'scripts/bootstrap_rust.ps1' '35de86d1b3e1446a52aee6e14e70bb659ffc4e0351351404843d6baced1c3beb' @'
#Requires -Version 7.0
<#
.SYNOPSIS
  v17.0 ZERO-MSVC activation of the Rust native driver  dscu-driver.exe   (-> runtime banner `驱动=rust-native`).
  Toolchain ladder - first rung that produces a working exe wins; py-native (dxcam + uiautomation) is NEVER removed and stays the fallback:
    1) MSVC      : link.exe + Windows SDK present                                  -> cargo build --release                         (toolchain=msvc)
    2) GNU(llvm) : NOTHING installed, no admin, no Visual Studio.  rustup (msvc *installer*, toolchain none) -> stable-x86_64-pc-windows-gnullvm
                   + portable llvm-mingw (mstorsjo, UCRT, SHA-256 pinned) unzipped into <Root>\toolchains\llvm-mingw
                   linker = x86_64-w64-mingw32-clang  (host tools + target are both gnullvm, so build scripts need no link.exe either)  (toolchain=gnullvm+llvm-mingw)
    3) GNU(gcc)  : a MinGW-w64 gcc already on the machine (MSYS2 / WinLibs / PATH)     -> stable-x86_64-pc-windows-gnu                   (toolchain=gnu+mingw-gcc)
  Why not "x86_64-pc-windows-gnu + llvm-mingw"?  llvm-mingw ships no libgcc/libgcc_eh, so rustc's -gnu link line fails (`unable to find library -lgcc_eh`);
  the -gnullvm ABI is the GNU-family target designed for exactly that toolchain.  (Verified by a real cross-link of this crate before release.)
  Evidence:  bin\driver-build.json (toolchain, rustc, exe sha256/size, DXGI self-test) · bin\build-info.json (tier=rust) · banner prints 驱动=rust-native v17.0.0 …
.EXAMPLE
  pwsh scripts/bootstrap_rust.ps1                       # auto
  pwsh scripts/bootstrap_rust.ps1 -Target gnullvm -Force
  $env:DSCU_GH_PROXY='https://ghfast.top/'; pwsh scripts/bootstrap_rust.ps1   # GitHub mirror prefix for mainland China
#>
param(
    [string]$Root = (Split-Path -Parent $PSScriptRoot),
    [ValidateSet('auto', 'msvc', 'gnullvm', 'gnu', 'none')][string]$Target = 'auto',
    [switch]$InstallTools, [switch]$UiAccess, [switch]$Force
)
$ErrorActionPreference = 'Continue'
$ProgressPreference = 'SilentlyContinue'
$LlvmVer = '20261117'
$LlvmSha = '4d002e330a0f703625aa5ccbc37e96f8f824413e163bfc7336774aabd2c3a412'
$LlvmUrl = "https://github.com/mstorsjo/llvm-mingw/releases/download/$LlvmVer/llvm-mingw-$LlvmVer-ucrt-x86_64.zip"
function Step($m) { Write-Host "▶ $m" -ForegroundColor Cyan }
function Warn($m) { Write-Host "  ⚠ $m" -ForegroundColor Yellow }
function Ok($m) { Write-Host "  ✓ $m" -ForegroundColor Green }
function Refresh-Path {
    $env:Path = ($env:Path + ';' + [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User') + ';' + (Join-Path $HOME '.cargo\bin'))
}

function Test-Msvc {
    $vw = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe'
    $vc = $false
    if (Test-Path $vw) { $vc = [bool](& $vw -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath 2>$null) }
    $sdk = Test-Path (Join-Path ${env:ProgramFiles(x86)} 'Windows Kits\10\Lib')
    return ($vc -and $sdk)
}

function Download([string]$Url, [string]$Out, [string]$Sha = '') {
    $urls = @()
    if ($env:DSCU_GH_PROXY) { $urls += ($env:DSCU_GH_PROXY.TrimEnd('/') + '/' + $Url) }
    $urls += $Url
    foreach ($u in $urls) {
        try {
            Write-Host "    ⬇ $u" -ForegroundColor DarkGray
            Invoke-WebRequest -Uri $u -OutFile $Out -UseBasicParsing -TimeoutSec 900
            if ($Sha) {
                $h = (Get-FileHash $Out -Algorithm SHA256).Hash.ToLowerInvariant()
                if ($h -ne $Sha) { Warn "SHA-256 不符（$h）→ 丢弃并尝试下一来源"; Remove-Item $Out -Force -ErrorAction SilentlyContinue; continue }
            }
            return $true
        } catch { Warn "下载失败：$($_.Exception.Message)" }
    }
    return $false
}

function Ensure-Rustup {
    if (Get-Command rustup -ErrorAction SilentlyContinue) { return $true }
    Step '安装 rustup（仅安装器；默认工具链 none，不需要 Visual Studio）'
    $tmp = Join-Path $env:TEMP 'rustup-init.exe'
    if (-not (Download 'https://win.rustup.rs/x86_64' $tmp)) { return $false }
    & $tmp -y --default-toolchain none --profile minimal 2>&1 | ForEach-Object { "    $_" } | Out-Host
    Refresh-Path
    return [bool](Get-Command rustup -ErrorAction SilentlyContinue)
}

function Ensure-LlvmMingw {
    $dir = Join-Path $Root 'toolchains\llvm-mingw'
    $clang = Join-Path $dir 'bin\x86_64-w64-mingw32-clang.exe'
    if (Test-Path $clang) { return (Join-Path $dir 'bin') }
    Step "下载便携 llvm-mingw $LlvmVer（UCRT x86_64，约 190MB，SHA-256 固定；无需管理员/无需安装）"
    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dir) | Out-Null
    $zip = Join-Path $env:TEMP "llvm-mingw-$LlvmVer.zip"
    if (-not (Download $LlvmUrl $zip $LlvmSha)) { return $null }
    $tmp = Join-Path $env:TEMP "llvm-mingw-$LlvmVer-x"
    Remove-Item $tmp -Recurse -Force -ErrorAction SilentlyContinue
    Expand-Archive -Path $zip -DestinationPath $tmp -Force
    $inner = Get-ChildItem $tmp -Directory | Select-Object -First 1
    if (-not $inner) { return $null }
    Remove-Item $dir -Recurse -Force -ErrorAction SilentlyContinue
    Move-Item $inner.FullName $dir -Force
    Remove-Item $zip, $tmp -Recurse -Force -ErrorAction SilentlyContinue
    if (Test-Path $clang) { return (Join-Path $dir 'bin') }
    return $null
}

function Find-MingwGcc {
    foreach ($n in @('x86_64-w64-mingw32-gcc', 'gcc')) {
        $c = Get-Command $n -ErrorAction SilentlyContinue
        if ($c) { try { if ((& $c.Source -dumpmachine 2>$null) -match 'mingw') { return $c.Source } } catch { } }
    }
    foreach ($p in @('C:\msys64\ucrt64\bin\gcc.exe', 'C:\msys64\mingw64\bin\gcc.exe', 'C:\mingw64\bin\gcc.exe')) { if (Test-Path $p) { return $p } }
    return $null
}

function Invoke-Cargo([string]$Toolchain, [hashtable]$EnvSet) {
    $crate = Join-Path $Root 'crates\dscu-driver'
    Push-Location $crate
    $saved = @{}
    try {
        foreach ($k in $EnvSet.Keys) { $saved[$k] = [Environment]::GetEnvironmentVariable($k); [Environment]::SetEnvironmentVariable($k, $EnvSet[$k]) }
        $a = @(); if ($Toolchain) { $a += "+$Toolchain" }; $a += @('build', '--release')
        Write-Host "  cargo $($a -join ' ')   (DSCU_TOOLCHAIN=$($EnvSet['DSCU_TOOLCHAIN']))" -ForegroundColor DarkGray
        & cargo @a 2>&1 | ForEach-Object { "    $_" } | Out-Host
        $exe = Join-Path $crate 'target\release\dscu-driver.exe'
        if ($LASTEXITCODE -eq 0 -and (Test-Path $exe)) { return $exe }
        return $null
    } finally {
        foreach ($k in $saved.Keys) { [Environment]::SetEnvironmentVariable($k, $saved[$k]) }
        Pop-Location
    }
}

function Write-Evidence($result, $exePath) {
    $bin = Join-Path $Root 'bin'
    if ($result.driver -and (Test-Path $exePath)) {
        $result.sha256 = (Get-FileHash $exePath -Algorithm SHA256).Hash.ToLowerInvariant()
        $result.size_bytes = (Get-Item $exePath).Length
    }
    $result.ts = (Get-Date).ToString('s')
    ($result | ConvertTo-Json) | Set-Content (Join-Path $bin 'driver-build.json') -Encoding utf8
    $bi = Join-Path $bin 'build-info.json'
    try {
        $info = if (Test-Path $bi) { Get-Content $bi -Raw | ConvertFrom-Json -AsHashtable } else { @{} }
        $info['rust_driver'] = [bool]$result.driver
        $info['tier'] = $(if ($result.driver) { 'rust' } else { 'py-native' })
        $info['driver_toolchain'] = $result.toolchain
        if ($result.driver) { $info['driver_sha256'] = $result.sha256 }
        ($info | ConvertTo-Json) | Set-Content $bi -Encoding utf8
    } catch { Warn "build-info.json 更新失败：$($_.Exception.Message)" }
}

# ============================================================================== main
$result = [ordered]@{ version = '17.0.0'; target = $Target; toolchain = 'none'; driver = $false; reason = ''; rustc = ''; selftest = ''; sha256 = ''; size_bytes = 0; msvc = $false; ts = '' }
Set-Location $Root
$bin = Join-Path $Root 'bin'; New-Item -ItemType Directory -Force -Path $bin | Out-Null
$dst = Join-Path $bin 'dscu-driver.exe'
if ($Target -eq 'none') { Ok 'Target=none → 保持 py-native'; return }
if ((Test-Path $dst) -and -not $Force) { Ok "dscu-driver.exe 已存在（-Force 可重建）：$dst"; return }
Refresh-Path
$msvc = Test-Msvc
$result.msvc = $msvc
Write-Host ("  工具链探测：MSVC(link.exe+SDK)={0}；目标策略={1}" -f $msvc, $Target)
if ($Target -eq 'auto') { $Target = if ($msvc) { 'msvc' } else { 'gnullvm' } }

$built = $null
if ($Target -eq 'msvc' -and $msvc) {
    if (-not (Get-Command cargo -ErrorAction SilentlyContinue)) { [void](Ensure-Rustup) }
    if (Get-Command rustup -ErrorAction SilentlyContinue) { & rustup toolchain install stable-x86_64-pc-windows-msvc --profile minimal 2>&1 | ForEach-Object { "    $_" } | Out-Host }
    Step 'cargo build --release（MSVC）'
    $built = Invoke-Cargo 'stable-x86_64-pc-windows-msvc' @{ DSCU_TOOLCHAIN = 'msvc' }
    if ($built) { $result.toolchain = 'msvc' } else { Warn 'MSVC 构建失败 → 改走 GNU(llvm)，无需 Visual Studio'; $Target = 'gnullvm' }
}
if (-not $built -and $Target -in @('gnullvm', 'msvc')) {
    if (-not (Ensure-Rustup)) { $result.reason = 'rustup_unavailable'; Warn '无法安装 rustup（网络？）。可手动安装 https://rustup.rs 后重试。' }
    else {
        $llvm = Ensure-LlvmMingw
        if (-not $llvm) { $result.reason = 'llvm_mingw_unavailable'; Warn '无法获取 llvm-mingw（GitHub 不可达？设置 $env:DSCU_GH_PROXY 镜像前缀后重试）。' }
        else {
            Ok "llvm-mingw 就绪：$llvm"
            $tc = 'stable-x86_64-pc-windows-gnullvm'
            Step "rustup toolchain install $tc（GNU 家族 ABI；host=target，build script 也不需要 link.exe）"
            & rustup toolchain install $tc --profile minimal 2>&1 | ForEach-Object { "    $_" } | Out-Host
            $env:Path = "$llvm;$env:Path"
            $built = Invoke-Cargo $tc @{ CARGO_TARGET_X86_64_PC_WINDOWS_GNULLVM_LINKER = 'x86_64-w64-mingw32-clang'; DSCU_TOOLCHAIN = 'gnullvm+llvm-mingw' }
            if ($built) { $result.toolchain = 'gnullvm+llvm-mingw'; $result.rustc = ((& rustc "+$tc" --version 2>$null) | Out-String).Trim() }
            else { $result.reason = 'cargo_failed_gnullvm' }
        }
    }
}
if (-not $built) {
    $gcc = Find-MingwGcc
    if ($gcc -and (Get-Command rustup -ErrorAction SilentlyContinue)) {
        Step "GNU + 系统 MinGW-w64 gcc：$gcc"
        & rustup toolchain install stable-x86_64-pc-windows-gnu --profile minimal 2>&1 | ForEach-Object { "    $_" } | Out-Host
        $env:Path = (Split-Path -Parent $gcc) + ';' + $env:Path
        $built = Invoke-Cargo 'stable-x86_64-pc-windows-gnu' @{ CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER = $gcc; DSCU_TOOLCHAIN = 'gnu+mingw-gcc' }
        if ($built) { $result.toolchain = 'gnu+mingw-gcc' }
    }
}

if ($built) {
    Copy-Item $built $dst -Force
    $result.driver = $true; $result.reason = ''
    Ok "dscu-driver.exe ($($result.toolchain)) → $dst"
    try {
        $st = (& $dst --selftest-dxgi 30 2>&1 | Out-String).Trim()
        $result.selftest = $st
        Write-Host "  Rust DXGI 自检（目标 < 4ms/帧）: $st"
    } catch { Warn "自检异常：$($_.Exception.Message)"; $result.selftest = "error: $($_.Exception.Message)" }
    Write-Host ("  SHA-256 {0} · {1:N0} bytes" -f (Get-FileHash $dst -Algorithm SHA256).Hash.ToLowerInvariant(), (Get-Item $dst).Length)
} else {
    if (-not $result.reason) { $result.reason = 'no_toolchain_succeeded' }
    Warn "Rust 驱动未能构建（$($result.reason)）→ 保持 py-native（功能等价）。重试：DSCU_MODE=bootstrap-rust"
}
