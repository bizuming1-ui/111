"""Deterministic artifact verification (HARNESS.md): never trust `exit 0` — check magic numbers, structure, size, pixels."""
from __future__ import annotations
import json
import struct
import zipfile
import zlib
from dataclasses import dataclass
from pathlib import Path


@dataclass
class ArtifactResult:
    ok: bool
    kind: str
    size: int
    detail: str

    def as_dict(self):
        return {"ok": self.ok, "kind": self.kind, "size": self.size, "detail": self.detail}


def _png_non_black_ratio(data: bytes) -> float:
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        return 0.0
    pos, idat, w, h, depth, ctype, inter = 8, b"", 0, 0, 8, 2, 0
    while pos + 8 <= len(data):
        ln, typ = struct.unpack(">I4s", data[pos:pos + 8])
        chunk = data[pos + 8:pos + 8 + ln]
        if typ == b"IHDR":
            w, h, depth, ctype, _, _, inter = struct.unpack(">IIBBBBB", chunk)
        elif typ == b"IDAT":
            idat += chunk
        pos += 12 + ln
    if depth != 8 or inter or ctype not in (0, 2, 6) or not w or not h:
        return 1.0 if len(idat) > 64 else 0.0       # exotic encodings: fall back to entropy proxy
    bpp = {0: 1, 2: 3, 6: 4}[ctype]
    raw = zlib.decompress(idat)
    stride = w * bpp
    prev = bytearray(stride)
    nz = tot = 0
    p = 0
    for _ in range(h):
        f = raw[p]; line = bytearray(raw[p + 1:p + 1 + stride]); p += 1 + stride
        for i in range(stride):
            a = line[i - bpp] if i >= bpp else 0
            b = prev[i]
            c = prev[i - bpp] if i >= bpp else 0
            if f == 1: line[i] = (line[i] + a) & 255
            elif f == 2: line[i] = (line[i] + b) & 255
            elif f == 3: line[i] = (line[i] + ((a + b) >> 1)) & 255
            elif f == 4:
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                pr = a if pa <= pb and pa <= pc else (b if pb <= pc else c)
                line[i] = (line[i] + pr) & 255
        prev = line
        for x in range(0, stride, bpp):
            tot += 1
            if max(line[x:x + min(bpp, 3)]) > 16:
                nz += 1
    return nz / max(tot, 1)


def verify_artifact(path: str | Path, kind: str | None = None, min_bytes: int = 64) -> ArtifactResult:
    p = Path(path)
    if not p.is_file():
        return ArtifactResult(False, kind or "?", 0, "file missing")
    size = p.stat().st_size
    with p.open("rb") as fh:
        head = fh.read(16)
    if kind is None:
        kind = {".pdf": "pdf", ".docx": "ooxml", ".xlsx": "ooxml", ".pptx": "ooxml", ".odt": "zip", ".zip": "zip",
                ".png": "png", ".mp4": "mp4", ".wav": "wav", ".json": "json"}.get(p.suffix.lower(), "any")
    if size < min_bytes:
        return ArtifactResult(False, kind, size, f"size {size} < {min_bytes}")
    if kind == "pdf":
        tail = p.read_bytes()[-2048:]
        ok = head.startswith(b"%PDF-") and b"%%EOF" in tail
        return ArtifactResult(ok, kind, size, "magic %PDF- + %%EOF" if ok else "bad PDF magic/EOF")
    if kind in ("zip", "ooxml"):
        try:
            with zipfile.ZipFile(p) as z:
                bad = z.testzip()
                names = set(z.namelist())
            if bad:
                return ArtifactResult(False, kind, size, f"corrupt member {bad}")
            if kind == "ooxml" and "[Content_Types].xml" not in names:
                return ArtifactResult(False, kind, size, "missing [Content_Types].xml")
            return ArtifactResult(True, kind, size, f"ZIP ok ({len(names)} members)")
        except zipfile.BadZipFile as e:
            return ArtifactResult(False, kind, size, f"BadZipFile {e}")
    if kind == "png":
        if not head.startswith(b"\x89PNG\r\n\x1a\n"):
            return ArtifactResult(False, kind, size, "bad PNG magic")
        r = _png_non_black_ratio(p.read_bytes())
        return ArtifactResult(r > 0.01, kind, size, f"non-black pixels {r:.1%}")
    if kind == "mp4":
        ok = head[4:8] == b"ftyp"
        return ArtifactResult(ok, kind, size, "ftyp box" if ok else "no ftyp")
    if kind == "wav":
        ok = head[:4] == b"RIFF" and head[8:12] == b"WAVE"
        return ArtifactResult(ok, kind, size, "RIFF/WAVE" if ok else "bad RIFF")
    if kind == "json":
        try:
            json.loads(p.read_text("utf-8")); return ArtifactResult(True, kind, size, "valid JSON")
        except Exception as e:  # noqa: BLE001
            return ArtifactResult(False, kind, size, f"invalid JSON {e}")
    return ArtifactResult(True, kind, size, "size only")
