int main() {
  const int W = 1920, H = 1080, S = W * 4;
  std::vector<uint8_t> a((size_t)S * H), b;
  srand(7); for (auto& v : a) v = (uint8_t)(rand() & 0xFF);
  b = a;
  auto same = framediff(a.data(), b.data(), W, H, S, 0);
