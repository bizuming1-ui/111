"""DSCU v15 benchmark orchestrator (3 tiers, reproducible archive, v14-vs-v15 comparison).

  python evals/runner.py run all                      # tier1 + tier2 + tier3 (needs DEEPSEEK_API_KEY for the LLM parts)
  python evals/runner.py run tier1 | tier2 | waa      # one tier
  python evals/runner.py run waa --rollouts 3         # Behavior Best-of-N (pass@1 / bBoN judge pick / oracle pass@N)
  python evals/runner.py run waa --tasks <dir-with-official-WAA-json>
  python evals/runner.py selfcheck                    # oracle hygiene, no LLM: initial state FAILS, reference solution PASSES
  python evals/runner.py compare eval_runs/<v14>/summary.json eval_runs/<v15>/summary.json
  python evals/runner.py smoke --trials 3             # legacy v14 suites (evals/suites/*.json)
Every run -> eval_runs/<timestamp>/ { summary.json, report.md, env.json, tier*/..., per-rollout task/initial_state/meta/say.log/trace/recovery/verifier/result }.
"""
from __future__ import annotations

import argparse
import asyncio
import json
import os
import platform
import sys
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "evals"))
sys.path.insert(0, os.environ.get("DSCU_BRAIN_ROOT") or str(ROOT))

from waa_runner import pct, wilson  # noqa: E402


def collect(rows: list[dict[str, Any]], bbon: bool) -> dict[str, Any]:
    rolls = [r for t in rows for r in t["rollouts"]]
    n_tasks = len(rows)
    if not rows:
        return {}
    sel_ok = sum(1 for t in rows if (t["selected_success"] if bbon else t["pass_at_1"]))
    elapsed = [r["elapsed_s"] for r in rolls]
    mis = sum(1 for r in rolls if r["misoperation"])
    with_rec = [r for r in rolls if r["facts"].get("recovery_events", 0) > 0]
    rec_ok = sum(1 for r in with_rec if r["success"])
    lo, hi = wilson(sel_ok, n_tasks)
    return {"tasks": n_tasks, "rollouts": len(rolls), "success_rate": round(sel_ok / n_tasks, 3), "wilson95": [lo, hi],
            "pass_at_1": round(sum(t["pass_at_1"] for t in rows) / n_tasks, 3), "bBoN": round(sum(t["selected_success"] for t in rows) / n_tasks, 3),
            "oracle_pass_at_n": round(sum(t["oracle_pass_at_n"] for t in rows) / n_tasks, 3), "judge_agreement": round(sum(t["judge_correct"] for t in rows) / n_tasks, 3),
            "misoperation_rate": round(mis / max(1, len(rolls)), 3), "recovery_rate": round(rec_ok / len(with_rec), 3) if with_rec else None, "rollouts_with_recovery": len(with_rec),
            "mean_s": round(sum(elapsed) / max(1, len(elapsed)), 2), "p50_s": round(pct(elapsed, .5), 2), "p95_s": round(pct(elapsed, .95), 2), "p99_s": round(pct(elapsed, .99), 2),
            "mean_steps": round(sum(r["steps"] for r in rolls) / max(1, len(rolls)), 2), "cdp_heals": sum(r["facts"].get("cdp_heals", 0) for r in rolls),
            "stable_object_hits": sum(sum((r["facts"].get("stable_object_hits") or {}).values()) for r in rolls)}


def headline(s: dict[str, Any]) -> dict[str, Any]:
    llm_rows = []
    for k in ("tier2", "tier3"):
        llm_rows += (s.get(k) or {}).get("tasks_raw", [])
    h = collect(llm_rows, bbon=s.get("rollouts", 1) > 1) if llm_rows else {}
    sc = (s.get("tier2") or {}).get("scenarios", [])
    done = [x for x in sc if x["status"] in ("pass", "fail")]
    h["scenario_pass"] = f"{sum(x['status'] == 'pass' for x in done)}/{len(done)}" if done else "n/a"
    t1 = s.get("tier1") or {}
    h["tier1"] = {k: (t1.get(k) or {}) for k in ("click_error_px", "keyboard_ms", "capture_ms", "fg_gate_ms", "som_localization")}
    return h


def write_report(run_dir: Path, s: dict[str, Any]) -> None:
    h = s["headline"]
    L = [f"# DSCU v{s['version']} 评测报告  ({s['ts']})", "", f"- 机器：{s['env']['platform']} · Python {s['env']['python']} · 驱动 {s['env'].get('driver', 'n/a')} · 模型 {s['env'].get('model', 'n/a')}",
         f"- 归档：`{run_dir}`（含每个 rollout 的原始任务/初始状态/动作序列/每步截图+UIA·CDP 快照/恢复轨迹/独立验证器结果）", ""]
    if h.get("tasks"):
        rec = "n/a" if h.get("recovery_rate") is None else f"{h['recovery_rate']:.0%}（{h['rollouts_with_recovery']} 个含恢复事件的 rollout）"
        L += ["## 汇总（LLM 任务，独立 Oracle 判定）", "", "| 指标 | 数值 |", "|---|---|",
              f"| 总成功率 | **{h['success_rate']:.0%}**  (Wilson95% {h['wilson95']}) · tasks={h['tasks']} rollouts={h['rollouts']} |",
              f"| pass@1 / bBoN / oracle pass@N | {h['pass_at_1']:.0%} / {h['bBoN']:.0%} / {h['oracle_pass_at_n']:.0%}（裁判选优一致率 {h['judge_agreement']:.0%}） |",
              f"| 误操作率（护栏被违反的 rollout 占比） | {h['misoperation_rate']:.1%} |", f"| 恢复率 | {rec} |",
              f"| 平均耗时 / P50 / P95 / P99 | {h['mean_s']}s / {h['p50_s']}s / {h['p95_s']}s / {h['p99_s']}s |", f"| 平均步数 | {h['mean_steps']} |",
              f"| CDP 自愈次数 / StableObject 命中 | {h['cdp_heals']} / {h['stable_object_hits']} |", ""]
    L += [f"## Tier-2 无 LLM 场景：{h.get('scenario_pass')}", ""]
    for x in (s.get("tier2") or {}).get("scenarios", []):
        L.append(f"- **{x['name']}** — {x['status'].upper()} — {x['detail'][:220]}")
    t1 = h.get("tier1", {})
    L += ["", "## Tier-1 单动作微基准", "", "```json", json.dumps(t1, ensure_ascii=False, indent=1, default=str)[:3500], "```"]
    (run_dir / "report.md").write_text("\n".join(L), encoding="utf-8")


async def run_all(a: argparse.Namespace) -> int:
    run_dir = Path(a.run_dir) if a.run_dir else ROOT / "eval_runs" / time.strftime("%Y%m%d-%H%M%S")
    run_dir.mkdir(parents=True, exist_ok=True)
    want = set(a.tiers) if a.tiers and "all" not in a.tiers else {"tier1", "tier2", "waa"}
    s: dict[str, Any] = {"version": a.label or "15.0.0", "ts": time.strftime("%F %T"), "rollouts": a.rollouts, "env": {"platform": platform.platform(), "python": sys.version.split()[0]}}
    if "tier1" in want:
        import tier1_micro

        print("▶ Tier 1 单动作微基准")
        s["tier1"] = await tier1_micro.run(a.n)
        (run_dir / "tier1_micro.json").write_text(json.dumps(s["tier1"], ensure_ascii=False, indent=1, default=str), encoding="utf-8")
        s["env"]["driver"] = (s["tier1"].get("driver") or {}).get("kind")
    if "tier2" in want:
        import tier2_composite

        print("▶ Tier 2 复合任务 / 故障注入场景")
        ns = argparse.Namespace(run_dir=str(run_dir), scenarios_only=a.scenarios_only, allow_destructive=a.allow_destructive, rollouts=a.rollouts)
        t2 = await tier2_composite.amain(ns)
        t2["tasks_raw"] = t2.get("tasks", [])
        s["tier2"] = t2
        s["tier2"]["summary"] = collect(t2["tasks_raw"], a.rollouts > 1)
    if "waa" in want:
        import waa_runner as W

        print("▶ Tier 3 WindowsAgentArena 风格任务（独立 Oracle + 可选 bBoN）")
        tasks = W.load_tasks(a.tasks or ROOT / "evals" / "tasks" / "waa_native")
        tasks = [t for t in tasks if a.allow_destructive or "destructive" not in t.get("requires", [])]
        h = W.Harness(run_dir, "tier3_waa", a.allow_exec, a.allow_destructive, cdp_port=int(os.environ.get("DSCU_CDP_PORT", "9222")))
        await h.start()
        try:
            rows = await h.run_tasks(tasks, a.rollouts)
            s["env"]["model"] = h.cfg.model
        finally:
            await h.stop()
        s["tier3"] = {"tasks_raw": rows, "summary": collect(rows, a.rollouts > 1), "meta": h.meta()}
    s["headline"] = headline(s)
    for k in ("tier2", "tier3"):
        if k in s:
            s[k].pop("tasks", None)
    (run_dir / "summary.json").write_text(json.dumps(s, ensure_ascii=False, indent=1, default=str), encoding="utf-8")
    (run_dir / "env.json").write_text(json.dumps(s["env"], ensure_ascii=False, indent=1), encoding="utf-8")
    write_report(run_dir, s)
    print(f"\n=== 评测完成 → {run_dir / 'report.md'}")
    print(json.dumps({k: v for k, v in s["headline"].items() if k != "tier1"}, ensure_ascii=False))
    return 0


def compare(a_path: str, b_path: str) -> int:
    A, B = (json.loads(Path(p).read_text(encoding="utf-8")) for p in (a_path, b_path))
    ha, hb = A["headline"], B["headline"]
    rows = [("总成功率", "success_rate", True, "%"), ("pass@1", "pass_at_1", True, "%"), ("误操作率", "misoperation_rate", False, "%"), ("恢复率", "recovery_rate", True, "%"),
            ("平均耗时 s", "mean_s", False, ""), ("P95 s", "p95_s", False, ""), ("P99 s", "p99_s", False, ""), ("平均步数", "mean_steps", False, ""), ("CDP 自愈次数", "cdp_heals", True, "")]
    print(f"{'指标':<14}{A['version']:>12}{B['version']:>12}   Δ   判定\n" + "-" * 62)
    wins = 0
    for name, k, higher, unit in rows:
        x, y = ha.get(k), hb.get(k)
        if x is None or y is None:
            print(f"{name:<14}{'n/a':>12}{'n/a':>12}")
            continue
        d = y - x
        better = (d > 0) if higher else (d < 0)
        wins += int(better and d != 0)
        f = (lambda v: f"{v:.1%}") if unit == "%" else (lambda v: f"{v:g}")
        print(f"{name:<14}{f(x):>12}{f(y):>12}  {('+' if d > 0 else '')}{f(d) if unit != '%' else f'{d * 100:+.1f}pp'}   {'✅ 进步' if better and d != 0 else '— 持平' if d == 0 else '⚠ 退步'}")
    ta, tb = ha.get("tier1", {}), hb.get("tier1", {})
    for k, path in (("capture_ms", ("frame", "p50")), ("capture_ms", ("frame", "p99")), ("keyboard_ms", ("p50",)), ("click_error_px", ("p50",)), ("fg_gate_ms", ("p50",))):
        def g(t: dict, p: tuple) -> Any:
            v: Any = t.get(k, {})
            for q in p:
                v = v.get(q) if isinstance(v, dict) else None
            return v
        x, y = g(ta, path), g(tb, path)
        if isinstance(x, (int, float)) and isinstance(y, (int, float)):
            print(f"Tier1 {k}.{'.'.join(path):<16}{x:>10}{y:>12}  {y - x:+.2f}   {'✅' if y <= x else '⚠'}")
    if ha.get("tasks") and hb.get("tasks"):
        la, lb = ha["wilson95"], hb["wilson95"]
        sig = lb[0] > la[1] or la[0] > lb[1]
        print(f"\n成功率 Wilson95% 区间：{A['version']} {la}  vs  {B['version']} {lb}  → {'区间不重叠：差异统计显著' if sig else '区间重叠：样本不足以证明差异，请加大 --rollouts / 任务数'}")
    print(f"\n{wins} 项指标进步。")
    return 0


async def legacy(name: str, trials: int) -> None:
    import waa_runner as W
    from agent_brain.layer0 import known_folder

    suite = json.loads((ROOT / "evals" / "suites" / f"{name}.json").read_text(encoding="utf-8"))
    tasks = []
    for t in suite["tasks"]:
        ev = []
        for e in t["evaluator"]:
            if e["type"] in ("file_exists", "file_contains"):
                ev.append({"type": e["type"], "path": e["path"], **({"text": e["text"]} if "text" in e else {})})
            elif e["type"] == "status":
                ev.append({"type": "status_in", "values": [e.get("equals", "done")]})
            elif e["type"] == "status_in":
                ev.append({"type": "status_in", "values": e.get("values", [])})
        tasks.append({"id": t["id"], "instruction": t["instruction"], "max_steps": t.get("max_steps", 30), "oracle": ev, "cleanup": t.get("cleanup", [])})
    run_dir = ROOT / "eval_runs" / (time.strftime("%Y%m%d-%H%M%S") + f"-legacy-{name}")
    h = W.Harness(run_dir, f"legacy_{name}")
    await h.start()
    try:
        rows = await h.run_tasks(tasks, 1, trials)
    finally:
        await h.stop()
    print(json.dumps(collect(rows, False), ensure_ascii=False))


def main() -> None:
    av = sys.argv[1:]
    if av and av[0] not in ("run", "compare", "selfcheck", "-h", "--help"):
        ap = argparse.ArgumentParser()
        ap.add_argument("suite", nargs="?", default="smoke")
        ap.add_argument("--trials", type=int, default=3)
        a = ap.parse_args(av)
        asyncio.run(legacy(a.suite, a.trials))
        return
    ap = argparse.ArgumentParser(prog="runner.py")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("tiers", nargs="*", default=["all"], help="tier1 | tier2 | waa | all")
    r.add_argument("--rollouts", type=int, default=1)
    r.add_argument("--n", type=int, default=40, help="tier1 samples")
    r.add_argument("--tasks", default="")
    r.add_argument("--run-dir", default="")
    r.add_argument("--label", default="", help="version label stored in summary.json (e.g. v14 / v15)")
    r.add_argument("--scenarios-only", action="store_true")
    r.add_argument("--allow-exec", action="store_true")
    r.add_argument("--allow-destructive", action="store_true")
    c = sub.add_parser("compare")
    c.add_argument("a")
    c.add_argument("b")
    sub.add_parser("selfcheck")
    a = ap.parse_args(av)
    if a.cmd == "compare":
        sys.exit(compare(a.a, a.b))
    if a.cmd == "selfcheck":
        import waa_runner as W

        sys.argv = ["waa_runner.py", "--selfcheck"]
        W.main()
        return
    sys.exit(asyncio.run(run_all(a)))


if __name__ == "__main__":
    main()
