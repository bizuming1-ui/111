//! Win32 shared-memory frame ring with Seqlock tear-free reads (layout: include/dscu_shm.h).
//! Eliminates the NDJSON+Base64 serialization tax: frames never cross the control pipe, only {seq, ahash, dirty}.
use std::sync::atomic::{fence, AtomicU64, Ordering};

pub const MAGIC: &[u8; 8] = b"DSV12RNG";
pub const HDR: usize = 64;
pub const SHDR: usize = 64;

#[derive(Clone, Copy, Debug, Default, PartialEq)]
pub struct Meta { pub frame_no: u64, pub w: u32, pub h: u32, pub stride: u32, pub fmt: u32, pub ahash: u64, pub dirty: [i32; 4] }

enum Backing {
    Heap(#[allow(dead_code)] Vec<u64>),
    #[cfg(windows)]
    Win { handle: windows::Win32::Foundation::HANDLE },
}

pub struct Ring { base: *mut u8, slots: usize, slot_bytes: usize, _own: Backing }
unsafe impl Send for Ring {}
unsafe impl Sync for Ring {}

impl Ring {
    pub fn total(slots: usize, slot_bytes: usize) -> usize { HDR + slots * (SHDR + slot_bytes) }

    unsafe fn init(base: *mut u8, slots: usize, slot_bytes: usize) {
        std::ptr::copy_nonoverlapping(MAGIC.as_ptr(), base, 8);
        (base.add(8) as *mut u32).write_unaligned(1);
        (base.add(12) as *mut u32).write_unaligned(slots as u32);
        (base.add(16) as *mut u64).write_unaligned(slot_bytes as u64);
    }

    /// Process-local ring (tests, benches, non-Windows).
    pub fn new_heap(slots: usize, slot_bytes: usize) -> Ring {
        assert!(slots >= 2);
        let mut v = vec![0u64; (Self::total(slots, slot_bytes) + 7) / 8];
        let base = v.as_mut_ptr() as *mut u8;
        unsafe { Self::init(base, slots, slot_bytes) };
        Ring { base, slots, slot_bytes, _own: Backing::Heap(v) }
    }

    /// Named Win32 file mapping `Local\dscu-v12-ring` (CreateFileMappingW + MapViewOfFile).
    #[cfg(windows)]
    pub fn create_named(name: &str, slots: usize, slot_bytes: usize) -> Result<Ring, String> {
        use windows::core::PCWSTR;
        use windows::Win32::Foundation::INVALID_HANDLE_VALUE;
        use windows::Win32::System::Memory::{CreateFileMappingW, MapViewOfFile, FILE_MAP_ALL_ACCESS, PAGE_READWRITE};
        let total = Self::total(slots, slot_bytes);
        let wname: Vec<u16> = name.encode_utf16().chain(std::iter::once(0)).collect();
        unsafe {
            let h = CreateFileMappingW(INVALID_HANDLE_VALUE, None, PAGE_READWRITE, (total as u64 >> 32) as u32, total as u32, PCWSTR(wname.as_ptr())).map_err(|e| e.to_string())?;
            let view = MapViewOfFile(h, FILE_MAP_ALL_ACCESS, 0, 0, total);
            if view.Value.is_null() { return Err("MapViewOfFile failed".into()); }
            let base = view.Value as *mut u8;
            Self::init(base, slots, slot_bytes);
            Ok(Ring { base, slots, slot_bytes, _own: Backing::Win { handle: h } })
        }
    }

    fn slot_ptr(&self, i: usize) -> *mut u8 { unsafe { self.base.add(HDR + i * (SHDR + self.slot_bytes)) } }
    fn seq(&self, i: usize) -> &AtomicU64 { unsafe { &*(self.slot_ptr(i) as *const AtomicU64) } }
    fn write_seq(&self) -> &AtomicU64 { unsafe { &*(self.base.add(24) as *const AtomicU64) } }
    pub fn latest(&self) -> u64 { self.write_seq().load(Ordering::Acquire) }

    /// Single-writer publish. Returns the new frame number.
    pub fn write(&self, m: &Meta, data: &[u8]) -> Result<u64, &'static str> {
        if data.len() > self.slot_bytes { return Err("frame larger than slot"); }
        let n = self.write_seq().load(Ordering::Relaxed) + 1;
        let i = (n as usize) % self.slots;
        let s = self.seq(i);
        let v = s.load(Ordering::Relaxed);
        s.store(v.wrapping_add(1), Ordering::Relaxed);        // odd: writer inside
        fence(Ordering::Release);
        unsafe {
            let p = self.slot_ptr(i);
            (p.add(8) as *mut u64).write_unaligned(n);
            (p.add(16) as *mut u32).write_unaligned(m.w);
            (p.add(20) as *mut u32).write_unaligned(m.h);
            (p.add(24) as *mut u32).write_unaligned(m.stride);
            (p.add(28) as *mut u32).write_unaligned(m.fmt);
            (p.add(32) as *mut u64).write_unaligned(m.ahash);
            for k in 0..4 { (p.add(40 + 4 * k) as *mut i32).write_unaligned(m.dirty[k]); }
            std::ptr::copy_nonoverlapping(data.as_ptr(), p.add(SHDR), data.len());
        }
        s.store(v.wrapping_add(2), Ordering::Release);         // even: stable
        self.write_seq().store(n, Ordering::Release);
        Ok(n)
    }

    /// Tear-free read of the newest slot (None if nothing published or the writer kept lapping us).
    pub fn read_latest(&self) -> Option<(Meta, Vec<u8>)> {
        let n = self.latest();
        if n == 0 { return None; }
        let i = (n as usize) % self.slots;
        for _ in 0..64 {
            let s1 = self.seq(i).load(Ordering::Acquire);
            if s1 & 1 == 1 { std::hint::spin_loop(); continue; }
            let p = self.slot_ptr(i);
            let (m, len);
            unsafe {
                let mut d = [0i32; 4];
                for k in 0..4 { d[k] = (p.add(40 + 4 * k) as *const i32).read_unaligned(); }
                m = Meta { frame_no: (p.add(8) as *const u64).read_unaligned(), w: (p.add(16) as *const u32).read_unaligned(), h: (p.add(20) as *const u32).read_unaligned(),
                           stride: (p.add(24) as *const u32).read_unaligned(), fmt: (p.add(28) as *const u32).read_unaligned(), ahash: (p.add(32) as *const u64).read_unaligned(), dirty: d };
                len = ((m.stride as usize).saturating_mul(m.h as usize)).min(self.slot_bytes);
            }
            let mut buf = vec![0u8; len];
            unsafe { std::ptr::copy_nonoverlapping(p.add(SHDR), buf.as_mut_ptr(), len) };
            fence(Ordering::Acquire);
            if self.seq(i).load(Ordering::Relaxed) == s1 { return Some((m, buf)); }
        }
        None
    }
}

impl Drop for Ring {
    fn drop(&mut self) {
        #[cfg(windows)]
        if let Backing::Win { handle } = &self._own {
            unsafe {
                let _ = windows::Win32::System::Memory::UnmapViewOfFile(windows::Win32::System::Memory::MEMORY_MAPPED_VIEW_ADDRESS { Value: self.base as *mut _ });
                let _ = windows::Win32::Foundation::CloseHandle(*handle);
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::sync::Arc;

    #[test]
    fn roundtrip() {
        let r = Ring::new_heap(3, 64);
        assert!(r.read_latest().is_none());
        let m = Meta { w: 4, h: 4, stride: 16, fmt: 0, ahash: 0xABCD, dirty: [1, 2, 3, 4], ..Default::default() };
        let n = r.write(&m, &[7u8; 64]).unwrap();
        let (got, buf) = r.read_latest().unwrap();
        assert_eq!((got.frame_no, got.w, got.ahash, got.dirty), (n, 4, 0xABCD, [1, 2, 3, 4]));
        assert!(buf.iter().all(|b| *b == 7));
        assert!(r.write(&m, &[0u8; 65]).is_err());
    }

    #[test]
    fn no_torn_reads_under_contention() {
        let r = Arc::new(Ring::new_heap(3, 4096));
        let w = r.clone();
        let t = std::thread::spawn(move || {
            for i in 1..=40_000u64 {
                let m = Meta { w: 64, h: 64, stride: 64, ..Default::default() };
                w.write(&m, &vec![(i % 251) as u8; 4096]).unwrap();
            }
        });
        let mut checked = 0u64;
        while !t.is_finished() || checked == 0 {
            if let Some((m, buf)) = r.read_latest() {
                let first = buf[0];
                assert!(buf.iter().all(|b| *b == first), "torn frame {} detected", m.frame_no);
                assert_eq!(first, (m.frame_no % 251) as u8, "meta/data mismatch");
                checked += 1;
            }
        }
        t.join().unwrap();
        assert!(checked > 0);
    }
}
