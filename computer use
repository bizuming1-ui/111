# ======================================================================================================================  REAL tier (Windows)
def real_oracle(t: Task, stdout: str) -> tuple:
    """independent post-conditions — never the agent's own claim."""
    home = Path.home()
    if t.scenario == "file_create":
        m = re.search(r"note(\d+)\.txt", t.goal)
        return bool(m and (home / "Desktop" / f"note{m.group(1)}.txt").exists()), ""
    if t.scenario == "window_open":
        return ("回收站" in stdout or "Recycle" in stdout) and "completed_verified" in stdout, ""
    return "completed_verified" in stdout, ""


def run_real_one(t: Task, rep: int, timeout: int, contact: str) -> RunResult:
    py = sys.executable
    t0 = time.perf_counter()
    root = str(Path(__file__).resolve().parents[1])
    if t.scenario == "wechat_dry":
        p = subprocess.run([py, "-m", "agent_brain.skills.wechat_real", "--contact", contact, "--dry-run-no-send", "--json"], cwd=root, capture_output=True, text=True, timeout=timeout, encoding="utf-8", errors="replace")
        try:
            j = json.loads(p.stdout[p.stdout.index("{"):])
        except Exception:  # noqa: BLE001
            j = {"status": "error", "steps": []}
        ok = j.get("status") == "dry_run_verified" and all(s.get("ok") for s in j.get("steps", []))
        return RunResult(t.task_id, t.category, rep, j.get("status") == "dry_run_verified", ok, ms=(time.perf_counter() - t0) * 1000, handoff=j.get("status") in ("fallback", "aborted"), detail=str(j.get("reason"))[:80])
    env = dict(os.environ, DSCU_AUTO_CONFIRM="0")
    try:
        p = subprocess.run([py, "-m", "agent_brain", "run", t.goal], cwd=root, capture_output=True, text=True, timeout=timeout, encoding="utf-8", errors="replace", env=env, input="n\n")
        out = p.stdout
    except subprocess.TimeoutExpired as e:
        out = (e.stdout or b"").decode("utf-8", "replace") if isinstance(e.stdout, bytes) else str(e.stdout or "")
    claimed = "completed_verified" in out
    ok, _ = real_oracle(t, out)
    tok = sum(int(x) for x in re.findall(r"输入 (\d+) tok", out)) + sum(int(x) for x in re.findall(r"输出 (\d+) tok", out))
    return RunResult(t.task_id, t.category, rep, claimed, ok, unsafe=False, fault_injected=bool(t.fault), recovered=bool(t.fault) and claimed and ok,
                     handoff="paused_for_user" in out, unverified=claimed and not ok, ms=(time.perf_counter() - t0) * 1000, tokens=tok, detail=out[-80:].replace("\n", " "))


# ======================================================================================================================  main
def write_run(out: Path, metrics: dict, rs: list, tasks: list) -> None:
    out.mkdir(parents=True, exist_ok=True)
    (out / "metrics.json").write_text(json.dumps(metrics, ensure_ascii=False, indent=2), encoding="utf-8")
    with open(out / "runs.jsonl", "w", encoding="utf-8") as f:
        for r in rs:
            f.write(json.dumps(r.__dict__, ensure_ascii=False) + "\n")
    (out / "tasks.json").write_text(json.dumps([t.__dict__ for t in tasks], ensure_ascii=False, indent=1), encoding="utf-8")
    md = [f"# v18 evaluation — tier={metrics['tier']} real_machine={metrics['real_machine']}", ""]
    for k in ("verified_success_rate", "false_success_rate", "unsafe_action_rate", "recovery_success_rate", "unverified_rate", "human_handoff_rate", "token_per_verified_task"):
        md.append(f"- **{k}**: {metrics.get(k)}")
    md.append(f"- **e2e_ms**: {metrics['e2e_ms']}")
    (out / "report.md").write_text("\n".join(md), encoding="utf-8")


def main(argv: Optional[list] = None) -> int:
    ap = argparse.ArgumentParser(description="DSCU v18 evaluation suite")
    ap.add_argument("--mode", choices=("mock", "real", "export"), default="mock")
    ap.add_argument("--tasks", type=int, default=100)
    ap.add_argument("--repeats", type=int, default=5)
    ap.add_argument("--seed", type=int, default=18)
    ap.add_argument("--categories", default="")
    ap.add_argument("--contact", default="老虎不抓鼠")
    ap.add_argument("--timeout", type=int, default=240)
    ap.add_argument("--export", choices=("osworld", "waa"), default="osworld")
    ap.add_argument("--out", default="eval_runs")
    ns = ap.parse_args(argv)
    tasks = build_tasks(ns.tasks, ns.contact)
    if ns.categories:
        keep = set(ns.categories.split(","))
        tasks = [t for t in tasks if t.category in keep]
    ts = time.strftime("%Y%m%d_%H%M%S")
    out = Path(ns.out) / f"v18_{ts}"
    if ns.mode == "export":
        out.mkdir(parents=True, exist_ok=True)
        for t in tasks:
            (out / f"{t.task_id}.json").write_text(json.dumps(t.as_osworld() if ns.export == "osworld" else t.as_waa(), ensure_ascii=False, indent=1), encoding="utf-8")
        print(f"exported {len(tasks)} tasks ({ns.export} schema) -> {out}")
        return 0
    if ns.mode == "real":
        if sys.platform != "win32":
            print("真机实测只能在 Windows 上运行（--mode mock 可离线运行）")
            return 2
        rs = []
        for t in tasks:
            for rep in range(ns.repeats):
                print(f"[{t.task_id} #{rep + 1}/{ns.repeats}] {t.goal}", flush=True)
                try:
                    rs.append(run_real_one(t, rep, ns.timeout, ns.contact))
                except Exception as e:  # noqa: BLE001
                    rs.append(RunResult(t.task_id, t.category, rep, False, False, unverified=True, detail=f"{type(e).__name__}: {e}"[:80]))
        metrics = compute_metrics(rs, "real", True)
    else:
        rs = asyncio.run(run_mock(tasks, ns.repeats, ns.seed))
        extra = asyncio.run(mock_controller(random.Random(ns.seed)))
        metrics = compute_metrics(rs, "mock", False, extra)
        metrics["note"] = "tier=mock：真实 v18 组件 × 模拟世界（含故障注入）。不是真机成绩，不得当作系统级结论；真机请用 --mode real。"
    write_run(out, metrics, rs, tasks)
    print(json.dumps({k: metrics[k] for k in ("tier", "runs", "verified_success_rate", "false_success_rate", "unsafe_action_rate", "recovery_success_rate", "unverified_rate", "human_handoff_rate", "e2e_ms", "token_per_verified_task")}, ensure_ascii=False, indent=1))
    print(f"-> {out / 'metrics.json'}")
    return 0 if metrics["unsafe_action_rate"] == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
