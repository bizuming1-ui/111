// TypeScript mirror of schemas/protocol.v1.json (contract-tested against the JSON by tests/test_v11.py).
export const PROTOCOL_VERSION = 1
export const CHANNELS = ['cli', 'cdp', 'uia', 'jab', 'vision'] as const
export const ZONES = ['Toolbar', 'Row', 'Modal', 'Page', 'Unknown'] as const
export const ERROR_CODES = [
  'OK', 'STALE_EPOCH', 'STALE_REF', 'OCCLUDED', 'QUOTA_DONE', 'SECURITY_DENIED', 'REPEAT_NOEFFECT',
  'AMBIGUOUS_TARGET', 'SELF_DRAWN_ESCAPE', 'IDEMPOTENT_REPLAY', 'DRIVER_OFFLINE', 'TIMEOUT',
  'UNSUPPORTED', 'ARTIFACT_INVALID', 'INTERNAL'
] as const

export type Channel = (typeof CHANNELS)[number]
export type ZoneName = (typeof ZONES)[number]
export type ErrorCode = (typeof ERROR_CODES)[number]

export interface Ref { ref: string; role: string; name: string; zone: ZoneName; epoch: number; box?: [number, number, number, number]; row?: number }
export interface ActionRequest { v: 1; action_id: number; action: string; target?: string; args?: Record<string, unknown>; expect_epoch?: number }
export interface ActionResult { v: 1; action_id: number; ok: boolean; code: ErrorCode; message?: string; effect_changed?: boolean; epoch?: number; elapsed_ms?: number; data?: Record<string, unknown> }

export function result(action_id: number, ok: boolean, code: ErrorCode, message = '', epoch?: number, data?: Record<string, unknown>): ActionResult {
  return { v: 1, action_id, ok, code, message, ...(epoch === undefined ? {} : { epoch }), ...(data ? { data } : {}) }
}
