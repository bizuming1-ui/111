"""Compatibility bridge for hosts where dscu-driver.exe is not built yet: a ctypes implementation of the SAME wire
contract (observe/action/info). It is honest about being a fallback: capture_backend is "GDI" with
fallback_reason="DRIVER_ABSENT_PYTHON_CTYPES" and UIA trees are empty (channel degrades to dxgi_vision).
Never used when the Rust driver answers."""
from __future__ import annotations

import ctypes
import os
import subprocess
import sys
import time
from typing import Any

from .ipc_client import IpcError


class NativeFallbackDriver:
    connected = True
    address = "python-ctypes-fallback"

    def __init__(self) -> None:
        if sys.platform != "win32":
            raise RuntimeError("fallback driver needs Windows")
        self.u = ctypes.windll.user32  # type: ignore[attr-defined]
        self.g = ctypes.windll.gdi32  # type: ignore[attr-defined]
        self.u.SetProcessDPIAware()
        self.latencies: dict[str, list[float]] = {}
        self._epoch = 0
        self._seen: dict[str, dict[str, Any]] = {}

    def _title(self, h: int) -> str:
        b = ctypes.create_unicode_buffer(512)
        self.u.GetWindowTextW(h, b, 512)
        return b.value

    def _proc(self, h: int) -> tuple[int, str]:
        pid = ctypes.c_ulong()
        self.u.GetWindowThreadProcessId(h, ctypes.byref(pid))
        k = ctypes.windll.kernel32  # type: ignore[attr-defined]
        ph = k.OpenProcess(0x1000, False, pid.value)
        name = ""
        if ph:
            buf = ctypes.create_unicode_buffer(520)
            n = ctypes.c_ulong(520)
            if k.QueryFullProcessImageNameW(ph, 0, buf, ctypes.byref(n)):
                name = buf.value.rsplit("\\", 1)[-1]
            k.CloseHandle(ph)
        return pid.value, name

    def _gdi_ms(self) -> float:
        t = time.perf_counter()
        w, h = 640, 360
        dc = self.u.GetDC(0)
        mdc = self.g.CreateCompatibleDC(dc)
        bmp = self.g.CreateCompatibleBitmap(dc, w, h)
        old = self.g.SelectObject(mdc, bmp)
        self.g.BitBlt(mdc, 0, 0, w, h, dc, 0, 0, 0x00CC0020)
        self.g.SelectObject(mdc, old)
        self.g.DeleteObject(bmp)
        self.g.DeleteDC(mdc)
        self.u.ReleaseDC(0, dc)
        return (time.perf_counter() - t) * 1000

    async def call(self, kind: str, req: dict[str, Any] | None = None, timeout: float = 30.0) -> dict[str, Any]:
        req = req or {}
        if kind == "ping":
            return {"pong": True}
        if kind == "info":
            return {"name": "python-ctypes-fallback", "capture_backend": "GDI", "fallback_reason": "DRIVER_ABSENT_PYTHON_CTYPES", "uiaccess": False}
        if kind == "observe":
            fg = self.u.GetForegroundWindow()
            pid, proc = self._proc(fg)
            self._epoch += 1
            ms = self._gdi_ms()
            return {"v": 1, "source": "dscu-driver", "channel": "dxgi_vision", "snapshot_epoch": self._epoch, "ts_ms": int(time.time() * 1000), "hwnd": int(fg or 0), "title": self._title(fg), "process": proc, "pid": pid,
                    "elements": [], "element_count": 0, "dxgi_stats": {"capture_backend": "GDI", "fallback_reason": "DRIVER_ABSENT_PYTHON_CTYPES", "frame_ms": ms, "dirty_rects_count": 0}, "screen_ahash": None}
        if kind == "action":
            return await self._act(req)
        raise IpcError("UNSUPPORTED", f"fallback driver has no '{kind}'")

    async def observe(self, req: dict[str, Any] | None = None, timeout: float = 30.0):  # same typed helper as IpcClient
        from .protocol import parse_observation

        return parse_observation(await self.call("observe", req))

    async def act(self, a, timeout: float = 45.0):
        from .protocol import parse_action_result

        return parse_action_result(await self.call("action", a.model_dump(exclude_none=True)))

    async def _act(self, a: dict[str, Any]) -> dict[str, Any]:
        op, args, aid = a.get("op"), a.get("args", {}), a.get("action_id", "")
        if aid in self._seen:
            return {**self._seen[aid], "replayed": True}
        try:
            if op == "launch":
                tgt = str(args.get("target", ""))
                if os.path.basename(tgt).lower() in {"cmd", "cmd.exe", "powershell", "powershell.exe", "pwsh", "pwsh.exe", "wscript", "mshta", "rundll32"}:
                    return {"action_id": aid, "ok": False, "error_code": "SECURITY_DENIED", "detail": "launch blocked by policy"}
                os.startfile(tgt) if os.path.exists(tgt) or tgt.startswith("http") else subprocess.Popen(tgt, shell=False)  # type: ignore[attr-defined]
                r = {"action_id": aid, "ok": True, "strategy": "launch"}
            elif op == "type":
                self._type(str(args.get("text", "")))
                r = {"action_id": aid, "ok": True, "strategy": "keyboard"}
            elif op == "key":
                self._keys(str(args.get("keys", "")))
                r = {"action_id": aid, "ok": True, "strategy": "keyboard"}
            else:
                r = {"action_id": aid, "ok": False, "error_code": "UNSUPPORTED", "detail": f"fallback driver cannot '{op}' (build dscu-driver.exe for UIA/click)"}
        except Exception as e:  # noqa: BLE001
            r = {"action_id": aid, "ok": False, "error_code": "INTERNAL", "detail": str(e)}
        if r["ok"]:
            self._seen[aid] = r
        return r

    def _send(self, vk: int, scan: int, flags: int) -> None:
        class KI(ctypes.Structure):
            _fields_ = [("wVk", ctypes.c_ushort), ("wScan", ctypes.c_ushort), ("dwFlags", ctypes.c_ulong), ("time", ctypes.c_ulong), ("dwExtraInfo", ctypes.c_size_t)]

        class IN(ctypes.Structure):
            class U(ctypes.Union):
                _fields_ = [("ki", KI), ("pad", ctypes.c_byte * 32)]

            _anonymous_ = ("u",)
            _fields_ = [("type", ctypes.c_ulong), ("u", U)]

        i = IN()
        i.type = 1
        i.ki = KI(vk, scan, flags, 0, 0)
        self.u.SendInput(1, ctypes.byref(i), ctypes.sizeof(i))

    def _type(self, text: str) -> None:
        for ch in text:
            if ch == "\n":
                self._keys("enter")
                continue
            raw = ch.encode("utf-16-le")
            for i in range(0, len(raw), 2):
                u = int.from_bytes(raw[i : i + 2], "little")
                self._send(0, u, 0x0004)
                self._send(0, u, 0x0004 | 0x0002)
            time.sleep(0.004)

    def _keys(self, spec: str) -> None:
        names = {"ctrl": 0x11, "alt": 0x12, "shift": 0x10, "win": 0x5B, "enter": 0x0D, "tab": 0x09, "esc": 0x1B, "space": 0x20, "backspace": 0x08, "delete": 0x2E, "left": 0x25, "up": 0x26, "right": 0x27, "down": 0x28, "home": 0x24, "end": 0x23}
        for chord in spec.split():
            vks = []
            for p in chord.lower().split("+"):
                vks.append(names.get(p) or (ord(p.upper()) if len(p) == 1 else 0))
            for v in vks:
                self._send(v, 0, 0)
            for v in reversed(vks):
                self._send(v, 0, 2)
            time.sleep(0.03)

    def stats(self) -> dict[str, Any]:
        return {}

    async def close(self) -> None:
        return None
