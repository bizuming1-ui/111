"""v16.2 high-risk action gate (single choke point).

High-risk verbs: delete / trash / send / submit / pay / overwrite.  Before such an action reaches the desktop the gate verifies
  1. target_object_id   - every object the action can touch is inside the frozen AuthorizedTargetSet (checked rows == targets, never a superset)
  2. expected_state     - the targets carry an expected post-state (`gone` for delete/trash) so the verifier can prove the effect afterwards
  3. fresh_observation_id - the registry was refreshed from THIS step's observation (older epoch => STALE_EPOCH, fail-closed)
and, whenever a target set is active, every *coordinate* click (even `vision_grounded=True`) must reverse-resolve to an authorised stable_id.
Failures return Code.OBJECT_IDENTITY_MISMATCH (or STALE_EPOCH) and the action never executes.
"""
from __future__ import annotations

import re
from dataclasses import dataclass
from typing import Any, Optional

from .protocol import Code, Element, Observation
from .stable_object import AuthorizedTargetSet, checked_row_ids, resolve_point
from .state_machine import StableObjectRegistry

HIGH_RISK_VERBS = ("delete", "trash", "send", "submit", "pay", "overwrite")
_VERB_RX = {
    "delete": re.compile(r"delete|remove|discard|删除|刪除|移除|清空|垃圾", re.I),
    "trash": re.compile(r"trash|recycle|move to bin|垃圾桶|回收站", re.I),
    "send": re.compile(r"\bsend\b|发送|發送|发出", re.I),
    "submit": re.compile(r"submit|提交|确认订单|确认提交", re.I),
    "pay": re.compile(r"\bpay\b|payment|purchase|支付|付款|购买|下单", re.I),
    "overwrite": re.compile(r"overwrite|replace all|覆盖|替换全部", re.I),
}
CLICKS = ("click", "double_click", "right_click")
# keys that trigger a destructive command in list UIs (Gmail '#', shift+3, Delete, shift+delete)
DESTRUCTIVE_KEYS = {"delete", "shift+delete", "shift+3", "#", "shift+#", "ctrl+delete"}
MAX_IDENTITY_STRIKES = 3
IDENTITY = "OBJECT_IDENTITY_MISMATCH"


@dataclass
class GateDecision:
    code: Code
    message: str
    reason: str  # machine-readable: COORD_UNRESOLVED | COORD_NON_TARGET | CHECKED_NOT_AUTHORIZED | TARGETS_NOT_FROZEN | NO_EXPECTED_STATE | STALE_OBSERVATION | TARGET_ID_FORBIDDEN


def classify_risk(a: dict[str, Any], el: Optional[Element] = None) -> Optional[str]:
    name = str(a.get("action", ""))
    probe = " ".join(x for x in (name, str(a.get("name", "")), (el.name if el is not None else "") or "") if x)
    if name in ("recycle_file", "empty_recycle_bin"):
        return "trash" if name == "recycle_file" else "delete"
    if name == "toolbar_action" or (name in CLICKS and el is not None and el.zone == "Toolbar"):
        for v in HIGH_RISK_VERBS:
            if _VERB_RX[v].search(probe):
                return v
    if name in CLICKS and el is not None and el.zone in ("Toolbar", "Modal"):
        for v in HIGH_RISK_VERBS:
            if _VERB_RX[v].search(el.name or ""):
                return v
    # v17: context-menu / ribbon items in zone "Other" ("删除" menu item of the right-click menu) are CommitTriggers too (desktop UIA only - never CDP page buttons)
    if name in CLICKS and el is not None and el.zone != "Row" and not getattr(el, "is_cdp", False) and (el.role or "").lower() in ("menuitem", "button", "splitbutton"):
        for v in ("delete", "trash"):
            if _VERB_RX[v].search(el.name or ""):
                return v
    if name == "key":
        ks = {k.strip() for k in str(a.get("keys", "")).lower().split()}
        if ks & DESTRUCTIVE_KEYS:
            return "delete"
    return None


_TASK_STOP = re.compile(r"永久删除|彻底删除|删除|刪除|移除|永久|彻底|直接|回收站|里面|里边|文件夹|文件|文档|并且|然后|帮我|请你|请|你先|你再|delete|remove|permanently|the|file|files|please|[在把将从的里中内并再先你]", re.I)


def task_tokens(task: str) -> list[str]:
    """Object names the user actually wrote (`删除回收站里面的相机文件` -> ['相机']).  Used to bind a UI selection to the task (Target identity)."""
    import unicodedata

    s = _TASK_STOP.sub(" ", unicodedata.normalize("NFKC", task or ""))
    return [t for t in re.split(r"[\s，,。；;、:：]+", s) if len(t) >= 2]


def _label_matches(token: str, label: str) -> bool:
    import difflib

    a, b = token.lower().strip(), (label or "").lower().strip()
    if not a or not b:
        return False
    if a in b or b in a:
        return True
    stem = b.rsplit(".", 1)[0]
    return difflib.SequenceMatcher(None, a, stem).ratio() >= 0.8


class IdentityGate:
    """Stateful per-task gate; the orchestrator calls note_observation() every step and check() before every action."""

    def __init__(self, registry: StableObjectRegistry) -> None:
        self.reg = registry
        self.epoch = 0
        self.step = 0
        self.strikes = 0
        self.denied: list[GateDecision] = []
        self.stats = {"checked": 0, "blocked": 0, "coord_blocked": 0, "stale": 0, "passed_high_risk": 0}
        self.external_targets: Optional[AuthorizedTargetSet] = None  # e.g. frozen Gmail message ids (API lane)

    def rebind(self, registry: StableObjectRegistry) -> None:
        self.reg = registry
        self.strikes = 0
        self.denied.clear()

    def note_observation(self, obs: Observation, step: int) -> None:
        self.epoch = int(getattr(obs, "snapshot_epoch", 0) or 0)
        self.step = step

    # ------------------------------------------------------------------ helpers
    def targets(self) -> AuthorizedTargetSet:
        return AuthorizedTargetSet.from_registry(self.reg, self.epoch)

    def _deny(self, code: Code, reason: str, msg: str) -> GateDecision:
        d = GateDecision(code, msg, reason)
        self.denied.append(d)
        self.stats["blocked"] += 1
        if code == Code.OBJECT_IDENTITY_MISMATCH:
            self.strikes += 1
        if code == Code.STALE_EPOCH:
            self.stats["stale"] += 1
        return d

    # ---- v17: Two-phase Target / Trigger gate -------------------------------------------------------------------
    #   TargetObject  = the business object (list row / file) -> identity is proven by the SELECTION (UIA SelectionItemPattern `selected`, or a checked checkbox)
    #   CommitTrigger = toolbar / ribbon / context-menu command or a destructive key (Delete) -> it is NOT an object; it is released as soon as the frozen
    #                   target set has >= 1 authorised object in the Selected state and nothing outside the set is selected.
    def freeze_from_selection(self, obs: Observation, task: str, risk: str) -> tuple[bool, str]:
        sel = checked_row_ids(self.reg, obs.elements)
        if not sel:
            return False, "当前没有处于 Selected 的目标行；先用 uia_select / select_rows 选中任务指名的对象（系统会据此冻结目标集），再点击工具栏/菜单触发器。"
        labels = {s_: self.reg.objects[s_].label for s_ in sel if s_ in self.reg.objects}
        toks = task_tokens(task)
        if toks:
            bad = [lb for lb in labels.values() if not any(_label_matches(t, lb) for t in toks)]
            if bad:
                return False, f"已选中的行 {bad[:3]} 与任务指名的对象 {toks[:3]} 不符；请先改为只选中任务指名的对象。"
        elif len(sel) != 1:
            return False, f"任务没有指名具体对象，而当前选中了 {len(sel)} 行；请只选中 1 个对象或在任务中写明名称。"
        for s_ in sel:
            o = self.reg.objects[s_]
            o.is_target = True
            o.expected_state = o.expected_state or "gone"
        self.reg.targets_locked = True
        self.stats["auto_frozen"] = self.stats.get("auto_frozen", 0) + 1
        return True, f"已按选中状态冻结 {len(sel)} 个目标：{'；'.join(v[:24] for v in labels.values())}"

    @property
    def exhausted(self) -> bool:
        return self.strikes >= MAX_IDENTITY_STRIKES

    # ------------------------------------------------------------------ main entry
    def check(self, a: dict[str, Any], obs: Observation, task: str, els: dict[int, Element], step: int, destructive_task: bool) -> Optional[GateDecision]:
        name = str(a.get("action", ""))
        sel = els.get(a.get("id")) if a.get("id") is not None else None
        risk = classify_risk(a, sel)
        coord = name in CLICKS and a.get("id") is None and "x" in a and "y" in a
        active = self.reg.targets_locked
        if not (risk or (coord and (active or destructive_task))):
            return None
        self.stats["checked"] += 1
        has_rows = any(e.zone == "Row" and e.row for e in obs.elements)
        # ---- fresh_observation_id: model-supplied token (optional) must match; registry must have been refreshed this step
