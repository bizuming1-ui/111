pub fn class_name(h: HWND) -> String {
    let mut b = [0u16; 256];
    let n = unsafe { GetClassNameW(h, &mut b) };
    String::from_utf16_lossy(&b[..n.max(0) as usize])
}

pub fn title(h: HWND) -> String {
    let n = unsafe { GetWindowTextLengthW(h) };
    if n <= 0 {
        return String::new();
    }
    let mut b = vec![0u16; (n as usize + 2).min(2048)];
    let m = unsafe { GetWindowTextW(h, &mut b) };
    String::from_utf16_lossy(&b[..m.max(0) as usize])
}

pub fn pid_of(h: HWND) -> u32 {
    let mut pid = 0u32;
    unsafe { GetWindowThreadProcessId(h, Some(&mut pid)) };
    pid
}

pub fn process_name(pid: u32) -> String {
    unsafe {
        if let Ok(h) = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) {
            let mut buf = [0u16; 520];
            let mut len = buf.len() as u32;
            let r = QueryFullProcessImageNameW(h, PROCESS_NAME_WIN32, PWSTR(buf.as_mut_ptr()), &mut len);
            let _ = CloseHandle(h);
            if r.is_ok() {
                let full = String::from_utf16_lossy(&buf[..len as usize]);
                return full.rsplit('\\').next().unwrap_or("").to_string();
            }
        }
    }
    String::new()
}

/// Is the process with `pid` running elevated (admin token)? `None` if it cannot be queried.
pub fn is_elevated(pid: u32) -> Option<bool> {
    unsafe {
        let h = if pid == 0 { GetCurrentProcess() } else { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid).ok()? };
        let mut tok = HANDLE::default();
        let ok = OpenProcessToken(h, TOKEN_QUERY, &mut tok).is_ok();
        if pid != 0 {
            let _ = CloseHandle(h);
        }
        if !ok {
            return None;
        }
        let mut el = TOKEN_ELEVATION::default();
        let mut ret = 0u32;
        let r = GetTokenInformation(tok, TokenElevation, Some(&mut el as *mut _ as *mut c_void), std::mem::size_of::<TOKEN_ELEVATION>() as u32, &mut ret);
        let _ = CloseHandle(tok);
        if r.is_ok() {
            Some(el.TokenIsElevated != 0)
        } else {
            None
        }
    }
}

/// True when this process carries a UIAccess token (can drive elevated windows without UIPI blocking).
pub fn has_uiaccess() -> bool {
    use windows::Win32::Security::TokenUIAccess;
    unsafe {
        let mut tok = HANDLE::default();
        if OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut tok).is_err() {
            return false;
        }
        let mut v = 0u32;
        let mut ret = 0u32;
        let r = GetTokenInformation(tok, TokenUIAccess, Some(&mut v as *mut _ as *mut c_void), 4, &mut ret);
        let _ = CloseHandle(tok);
        r.is_ok() && v != 0
    }
}

pub fn is_cloaked(h: HWND) -> bool {
    unsafe {
        let mut c = 0u32;
        DwmGetWindowAttribute(h, DWMWA_CLOAKED, &mut c as *mut _ as *mut c_void, 4).is_ok() && c != 0
    }
}

pub fn is_console_window(h: HWND) -> bool {
    let c = class_name(h);
    if c == "ConsoleWindowClass" || c == "CASCADIA_HOSTING_WINDOW_CLASS" {
        return true;
    }
    let p = process_name(pid_of(h)).to_lowercase();
    p == "windowsterminal.exe" || p == "conhost.exe" || p == "pwsh.exe" || p == "powershell.exe"
}

pub fn rect_json(r: &RECT) -> Value {
    json!({"x": r.left, "y": r.top, "w": r.right - r.left, "h": r.bottom - r.top})
}

pub fn window_json(h: HWND, z: usize) -> Value {
    let pid = pid_of(h);
    let mut r = RECT::default();
    unsafe {
        let _ = GetWindowRect(h, &mut r);
    }
    json!({"hwnd": hwnd_i(h), "title": title(h), "class": class_name(h), "pid": pid, "process": process_name(pid), "rect": rect_json(&r), "z": z, "minimized": unsafe { IsIconic(h).as_bool() }})
}

pub fn list_windows(limit: usize) -> Vec<HWND> {
    unsafe extern "system" fn cb(h: HWND, lp: LPARAM) -> BOOL {
        let v = &mut *(lp.0 as *mut Vec<HWND>);
        if IsWindowVisible(h).as_bool() && GetWindowTextLengthW(h) > 0 && !is_cloaked(h) {
            let ex = GetWindowLongW(h, GWL_EXSTYLE) as u32;
            if ex & WS_EX_TOOLWINDOW.0 == 0 {
                v.push(h);
            }
        }
        BOOL(1)
    }
    let mut v: Vec<HWND> = Vec::new();
    unsafe {
        let _ = EnumWindows(Some(cb), LPARAM(&mut v as *mut _ as isize));
    }
    v.truncate(limit);
    v
}

/// Secure desktop (UAC prompt / lock screen) detection: the input desktop cannot be opened.
pub fn secure_desktop_active() -> bool {
    use windows::Win32::System::StationsAndDesktops::{CloseDesktop, OpenInputDesktop, DESKTOP_CONTROL_FLAGS, DESKTOP_SWITCHDESKTOP};
    unsafe {
        match OpenInputDesktop(DESKTOP_CONTROL_FLAGS(0), false, DESKTOP_SWITCHDESKTOP) {
            Ok(d) => {
                let _ = CloseDesktop(d);
                false
            }
            Err(_) => true,
        }
    }
}

pub fn working_set_mb() -> u64 {
    // Resident size of this process (bytes -> MB) via GetProcessMemoryInfo is in Psapi; use PROCESS_MEMORY via
    // K32GetProcessMemoryInfo to avoid an extra feature: fall back to 0 when unavailable.
    use windows::Win32::System::Threading::GetCurrentProcess;
    #[repr(C)]
    #[derive(Default)]
    struct Pmc {
        cb: u32,
        page_fault_count: u32,
        peak_working_set: usize,
        working_set: usize,
        rest: [usize; 6],
    }
    #[link(name = "kernel32")]
    extern "system" {
        fn K32GetProcessMemoryInfo(h: HANDLE, p: *mut Pmc, cb: u32) -> i32;
    }
    unsafe {
        let mut p = Pmc { cb: std::mem::size_of::<Pmc>() as u32, ..Default::default() };
        if K32GetProcessMemoryInfo(GetCurrentProcess(), &mut p, p.cb) != 0 {
            (p.working_set / 1048576) as u64
        } else {
            0
        }
    }
}
