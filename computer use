"""Build-time STRONG-TYPE contract between PowerShell call-sites and embedded C# interop classes.
Root cause it prevents (运行日志1 task #2): `[DsNative61]::ShowWindow(...)` was called from PowerShell, but ShowWindow was a
*private* P/Invoke inside DsNative61 -> runtime "[DsNative61] 不包含名为 'ShowWindow' 的方法" x5 -> fuse tripped.
`scan()` extracts the PUBLIC static surface of every `public static class DsXxx` found in C# here-strings and verifies every
`[DsXxx]::Member` reference in the PowerShell text.  Wired into build_v12.py (build fails) and `v12 contract` (runtime)."""
from __future__ import annotations

import re

_CLASS = re.compile(r"public\s+(?:static\s+|sealed\s+)*class\s+(Ds\w+)\s*\{")
_MEMBER = re.compile(r"public\s+(?:static\s+)(?:extern\s+|readonly\s+|volatile\s+)*[\w<>\[\],\.\s]+?\s+(\w+)\s*(?:\(|=|;|\{)")
_REF = re.compile(r"\[(Ds\w+(?:\.\w+)?)\]::(\w+)")


def _body(src: str, start: int) -> str:
    depth, i = 0, src.index("{", start)
    j = i
    while j < len(src):
        c = src[j]
        depth += (c == "{") - (c == "}")
        if depth == 0:
            return src[i + 1:j]
        j += 1
    return src[i + 1:]


def public_surface(text: str) -> dict[str, set[str]]:
    out: dict[str, set[str]] = {}
    for m in _CLASS.finditer(text):
        body = _body(text, m.start())
        names = {x.group(1) for x in _MEMBER.finditer(body)}
        out.setdefault(m.group(1), set()).update(names)
    return out


def scan(text: str, extra_surface: dict[str, set[str]] | None = None) -> list[str]:
    surface = public_surface(text)
    for k, v in (extra_surface or {}).items():
        surface.setdefault(k, set()).update(v)
    bad = []
    for ln, line in enumerate(text.split("\n"), 1):
        if line.lstrip().startswith("#") and "::" not in line:
            continue
        for m in _REF.finditer(line):
            t, member = m.group(1), m.group(2)
            if t in surface and member not in surface[t] and member not in {"new", "GetType", "Equals"}:
                bad.append(f"line {ln}: [{t}]::{member} is not a public static member")
    return bad
