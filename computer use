// Trusted-input actions over CDP (Layer 1: no pixels, no OS mouse). Every action is epoch-checked, occlusion-checked and
// followed by Wait-CdpSettled so the next observation is never taken mid-render.
import { BrowserManager, Tab } from "./browser.js";
import { waitSettled } from "./cdp.js";
import { observePage } from "./fusion.js";
import { PErr, sleep } from "./protocol.js";

const BAD_SCHEMES = ["file:", "chrome:", "chrome-extension:", "devtools:", "javascript:", "data:", "view-source:", "edge:", "vbscript:", "blob:"];

export function checkUrl(raw: string, allowPrivate: boolean): URL {
  let u: URL;
  try { u = new URL(raw); } catch { throw new PErr("INVALID_REQUEST", `bad url: ${raw.slice(0, 80)}`); }
