function Get-V92ModalSig($Items) {
    # 模态框签名：至少 2 个「对话框式选择按钮」（是/否/保存/不保存/确定/取消…）+ 提问文字；普通切换按钮（点赞/收藏）不参与，保留 REPEAT_EFFECT 对切换类动作的保护
    $btn = [System.Collections.Generic.SortedSet[string]]::new(); $qs = [System.Collections.Generic.SortedSet[string]]::new()
    foreach ($it in @($Items)) {
        if ($null -eq $it -or $it.Off) { continue }
        $nm = "$($it.Name)".Trim()
        if (-not $nm) { continue }
        if ($it.Type -in 'Button', 'Hyperlink', 'Link') { if ($nm -match $script:V92DialogBtn) { [void]$btn.Add($nm.ToLower()) } }
        elseif ($it.Type -eq 'Text' -and $nm -match '[?？]|是否|确认|确定要|Do you want|Are you sure|不存在|already exists|已存在') { [void]$qs.Add((Limit-Text $nm 40)) }
    }
    if ($btn.Count -lt 2) { return '' }
    return ((@($btn) -join ',') + '|' + (@($qs) -join ','))
}
function Update-V92State($Fg, $Items, $Model) {
