"""Micro-Reflection: two consecutive expectation mismatches -> one-shot hint to roll back (Esc / Ctrl+Z) instead of stacking errors."""
from __future__ import annotations


class MismatchTracker:
    def __init__(self) -> None:
        self.streak = 0; self.note = ""; self.count = 0

    def update(self, outcomes: list[str], rename_focus: bool = False) -> None:
        mm = rename_focus or any(o == "nochange" for o in outcomes)
        if mm: self.streak += 1
        elif any(o == "changed" for o in outcomes): self.streak = 0
        if self.streak >= 2:
            self.note = ("[Micro-Reflection] 2 consecutive steps did not match expectations. Stop stacking actions: "
                         "(1) if a rename box / popup / IME was triggered by mistake press key escape; "
                         "(2) if an unwanted edit already happened press key ctrl+z; (3) re-observe, then use a different locator.")
            self.count += 1; self.streak = 0

    def take(self) -> str:
        n, self.note = self.note, ""
        return n
