    s = sorted(v)
    k = min(len(s) - 1, max(0, int(round(q * (len(s) - 1)))))
    return round(s[k], 3)


def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


# ===================================================================================== model acquisition
def model_urls() -> list[str]:
    urls: list[str] = []
    if os.environ.get("DSCU_DML_MODEL_URL"):
        urls.append(os.environ["DSCU_DML_MODEL_URL"])
    eps = ([os.environ["DSCU_HF_ENDPOINT"].rstrip("/")] if os.environ.get("DSCU_HF_ENDPOINT") else []) + list(HF_ENDPOINTS)
    for e in eps:
        u = f"{e}/{MODEL_REPO_PATH}"
        if u not in urls:
            urls.append(u)
    return urls


def default_model_path(root: Optional[Path] = None) -> Path:
    return (root or _root()) / "models" / MODEL_FILE


def ensure_model(root: Optional[Path] = None, log: Any = print, timeout: float = 90.0) -> tuple[Optional[Path], str]:
    """Download (if needed) + SHA-256 verify the pinned OmniParser ONNX.  -> (path | None, message).  Never returns an unverified file."""
    p = default_model_path(root)
    p.parent.mkdir(parents=True, exist_ok=True)
    if p.exists():
        got = sha256_file(p)
        if got == MODEL_SHA256:
            return p, f"model_sha256 OK ({got[:16]}…)"
        log(f"  ⚠ 本地模型 SHA-256 不符（{got[:16]}… ≠ {MODEL_SHA256[:16]}…）→ 删除并重新下载")
        p.unlink(missing_ok=True)
    errs: list[str] = []
    for url in model_urls():
        tmp = p.with_suffix(".part")
        try:
            log(f"  ⬇ 下载 OmniParser icon_detect ONNX（12.3 MB）← {url.split('/resolve/')[0]}")
            req = urllib.request.Request(url, headers={"User-Agent": "dscu/17"})
            h = hashlib.sha256()
            n = 0
            with urllib.request.urlopen(req, timeout=timeout) as r, open(tmp, "wb") as f:
                while True:
                    b = r.read(1 << 20)
                    if not b:
                        break
                    f.write(b)
                    h.update(b)
                    n += len(b)
            if h.hexdigest() != MODEL_SHA256:
                errs.append(f"{url}: SHA-256 不符 {h.hexdigest()[:16]}…（{n} 字节）")
                tmp.unlink(missing_ok=True)
                continue
            os.replace(tmp, p)
            return p, f"下载并校验通过 sha256={MODEL_SHA256} ({n} bytes)"
        except Exception as e:  # noqa: BLE001
            errs.append(f"{url}: {type(e).__name__}: {str(e)[:80]}")
            tmp.unlink(missing_ok=True)
    return None, "模型下载失败：" + " | ".join(errs[-3:]) + "（可手动下载后设置 DSCU_DML_MODEL=<路径>，或设置 DSCU_HF_ENDPOINT 镜像）"


