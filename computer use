//! agent-desktop style accessibility snapshots: stable `@sN:eM` refs, `--skeleton`, `--root @sN:eM`, headless-first (no focus theft).
use serde::{Deserialize, Serialize};

#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
pub struct RawNode { pub role: String, pub name: String, pub l: i32, pub t: i32, pub w: i32, pub h: i32, pub interactive: bool }

#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
pub struct Node { pub r#ref: String, pub role: String, pub name: String, pub rect: [i32; 4], pub parent: Option<String>, pub depth: u32, pub interactive: bool }

#[derive(Clone, Debug, Serialize, Deserialize)]
pub struct Snapshot { pub id: String, pub nodes: Vec<Node> }

fn contains(p: &RawNode, c: &RawNode) -> bool {
    c.l >= p.l - 1 && c.t >= p.t - 1 && c.l + c.w <= p.l + p.w + 1 && c.t + c.h <= p.t + p.h + 1 && (p.w * p.h) > (c.w * c.h)
}

/// Document-order nodes -> tree with refs.  Parent = nearest earlier node whose rect strictly contains this one.
pub fn build(snap_id: u32, raw: &[RawNode]) -> Snapshot {
    let mut nodes: Vec<Node> = Vec::with_capacity(raw.len());
    let mut stack: Vec<usize> = Vec::new();
    for (i, n) in raw.iter().enumerate() {
        while let Some(&top) = stack.last() { if contains(&raw[top], n) { break; } stack.pop(); }
        let (parent, depth) = match stack.last() { Some(&p) => (Some(nodes[p].r#ref.clone()), nodes[p].depth + 1), None => (None, 0) };
        nodes.push(Node { r#ref: format!("@s{}:e{}", snap_id, i + 1), role: n.role.clone(), name: n.name.clone(), rect: [n.l, n.t, n.w, n.h], parent, depth, interactive: n.interactive });
        stack.push(i);
    }
    Snapshot { id: format!("s{}", snap_id), nodes }
}

/// `--skeleton`: only structure + interactive controls, depth-capped, names truncated (token-cheap first look).
pub fn skeleton(s: &Snapshot, max_depth: u32, max_name: usize) -> Snapshot {
    let nodes = s.nodes.iter().filter(|n| n.depth <= max_depth && (n.interactive || n.depth <= 1)).map(|n| {
        let mut n = n.clone(); if n.name.chars().count() > max_name { n.name = n.name.chars().take(max_name).collect::<String>() + "…"; } n
    }).collect();
    Snapshot { id: s.id.clone(), nodes }
}

/// `--root @sN:eM`: the subtree under one ref (depth re-based to 0).
pub fn subtree(s: &Snapshot, root: &str) -> Option<Snapshot> {
    let base = s.nodes.iter().find(|n| n.r#ref == root)?;
    let mut keep = vec![base.r#ref.clone()]; let mut out = vec![base.clone()];
    for n in s.nodes.iter().skip_while(|n| n.r#ref != root).skip(1) {
        if let Some(p) = &n.parent { if keep.contains(p) { keep.push(n.r#ref.clone()); out.push(n.clone()); } }
    }
    let d0 = base.depth;
    for n in out.iter_mut() { n.depth -= d0; }
    out[0].parent = None;
    Some(Snapshot { id: s.id.clone(), nodes: out })
}

