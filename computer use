    base = dict(cli_hit=False, cdp_up=False, fg_is_browser=False, uia_controls=50, stalled=False, blocked_streak=0, free_mem_mb=8000)
    base.update(kw)
    return route("task", **base)


def test_router_layers_follow_measurements():
    assert R(cli_hit=True).layer == 0
    assert R(uia_controls=None).name == "probe"
    assert R(fg_is_browser=True, cdp_up=True).layer == 1
    assert R(fg_is_browser=True, cdp_up=False).layer == 2  # browser but no CDP: UIA, never a fake CDP
    assert R(uia_controls=3).layer == 4
