#=#=# FILE: dscu-driver/crates/dscu-win32/src/dxgi.rs
//! DXGI Desktop Duplication engine (works for DirectX games / video / hardware-accelerated windows where GDI is black).
//!
//! Pipeline: AcquireNextFrame -> GPU CopyResource into a persistent *shadow* texture (so "no change" frames cost nothing)
//! -> GPU CopySubresourceRegion of ONLY the requested rectangle into a STAGING texture -> single CPU copy into a named
//! file mapping that the PowerShell client maps directly (no pipe/Base64 copy) -> 48x32 gray signature from the same bytes.
//! DirtyRects / MoveRects of the acquired frame are returned verbatim.
//! Adapter preference: AMD (VendorId 0x1002, Radeon 780M) with a connected output; never CUDA, only D3D11/DXGI.
use crate::shm::ShmRing;
use dscu_core::ahash::gray_sig_from_bgra;
use dscu_core::platform::{CapturedFrame, PErr, Rect};
use std::time::Instant;
use windows::core::Interface;
use windows::Win32::Foundation::*;
use windows::Win32::Graphics::Direct3D::*;
use windows::Win32::Graphics::Direct3D11::*;
use windows::Win32::Graphics::Dxgi::Common::*;
use windows::Win32::Graphics::Dxgi::*;

pub struct Dxgi {
    _device: ID3D11Device,
    ctx: ID3D11DeviceContext,
    dup: IDXGIOutputDuplication,
    shadow: ID3D11Texture2D,
    staging: Option<(ID3D11Texture2D, u32, u32)>,
    pub width: u32,
    pub height: u32,
    origin: (i32, i32),
    has_frame: bool,
    pub adapter_name: String,
    pub vendor_id: u32,
    ring: ShmRing,
}
unsafe impl Send for Dxgi {}

fn tex_desc(w: u32, h: u32, usage: D3D11_USAGE, cpu: u32) -> D3D11_TEXTURE2D_DESC {
    D3D11_TEXTURE2D_DESC {
        Width: w,
        Height: h,
        MipLevels: 1,
        ArraySize: 1,
        Format: DXGI_FORMAT_B8G8R8A8_UNORM,
        SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
        Usage: usage,
        BindFlags: 0,
        CPUAccessFlags: cpu,
        MiscFlags: 0,
    }
}

impl Dxgi {
    pub fn new() -> Result<Dxgi, String> {
        unsafe {
            let factory: IDXGIFactory1 = CreateDXGIFactory1().map_err(|e| format!("CreateDXGIFactory1: {e}"))?;
            let mut best: Option<(IDXGIAdapter1, DXGI_ADAPTER_DESC1)> = None;
            let mut i = 0;
            while let Ok(a) = factory.EnumAdapters1(i) {
                i += 1;
                let desc = a.GetDesc1().map_err(|e| e.to_string())?;
                if a.EnumOutputs(0).is_err() {
                    continue; // no display attached to this adapter
                }
                let amd = desc.VendorId == 0x1002;
                if best.is_none() || (amd && best.as_ref().map(|b| b.1.VendorId != 0x1002).unwrap_or(true)) {
                    best = Some((a, desc));
                }
            }
            let (adapter, desc) = best.ok_or("no DXGI adapter with an output")?;
            let name = String::from_utf16_lossy(&desc.Description).trim_end_matches('\0').to_string();
            let base: IDXGIAdapter = adapter.cast().map_err(|e| e.to_string())?;
            let mut device: Option<ID3D11Device> = None;
            let mut ctx: Option<ID3D11DeviceContext> = None;
            D3D11CreateDevice(&base, D3D_DRIVER_TYPE_UNKNOWN, HMODULE::default(), D3D11_CREATE_DEVICE_BGRA_SUPPORT, None, D3D11_SDK_VERSION, Some(&mut device), None, Some(&mut ctx))
                .map_err(|e| format!("D3D11CreateDevice: {e}"))?;
            let (device, ctx) = (device.ok_or("no device")?, ctx.ok_or("no context")?);
            let output = adapter.EnumOutputs(0).map_err(|e| e.to_string())?;
            let odesc = output.GetDesc().map_err(|e| e.to_string())?;
            let out1: IDXGIOutput1 = output.cast().map_err(|e| e.to_string())?;
            let dup = out1.DuplicateOutput(&device).map_err(|e| format!("DuplicateOutput: {e}"))?;
            let r = odesc.DesktopCoordinates;
            let (w, h) = ((r.right - r.left) as u32, (r.bottom - r.top) as u32);
            let mut shadow: Option<ID3D11Texture2D> = None;
            device.CreateTexture2D(&tex_desc(w, h, D3D11_USAGE_DEFAULT, 0), None, Some(&mut shadow)).map_err(|e| format!("shadow texture: {e}"))?;
            Ok(Dxgi { _device: device, ctx, dup, shadow: shadow.ok_or("no shadow")?, staging: None, width: w, height: h, origin: (r.left, r.top), has_frame: false, adapter_name: name, vendor_id: desc.VendorId, ring: ShmRing::new() })
        }
    }

    pub fn screen(&self) -> Rect {
        Rect { x: self.origin.0, y: self.origin.1, w: self.width as i32, h: self.height as i32 }
    }

    /// Returns (fresh, dirty, moves, acquire_us). `fresh=false` means "no desktop change within the timeout; shadow frame reused".
    fn acquire(&mut self, timeout_ms: u32) -> Result<(bool, Vec<[i32; 4]>, Vec<[i32; 6]>, u64), PErr> {
        let t = Instant::now();
        let mut budget = if self.has_frame { timeout_ms } else { 250 };
        loop {
            let mut info = DXGI_OUTDUPL_FRAME_INFO::default();
            let mut res: Option<IDXGIResource> = None;
            let r = unsafe { self.dup.AcquireNextFrame(budget, &mut info, &mut res) };
            match r {
                Ok(()) => {
                    let mut dirty = vec![];
                    let mut moves = vec![];
                    let mut copied = false;
                    if let Some(res) = res {
                        if info.LastPresentTime != 0 {
                            if let Ok(tex) = res.cast::<ID3D11Texture2D>() {
                                unsafe { self.ctx.CopyResource(&self.shadow, &tex) };
                                copied = true;
                            }
                            if info.TotalMetadataBufferSize > 0 {
                                unsafe {
                                    let mut need = 0u32;
                                    let mut mv = vec![DXGI_OUTDUPL_MOVE_RECT::default(); (info.TotalMetadataBufferSize as usize / std::mem::size_of::<DXGI_OUTDUPL_MOVE_RECT>()).max(1)];
                                    if self.dup.GetFrameMoveRects((mv.len() * std::mem::size_of::<DXGI_OUTDUPL_MOVE_RECT>()) as u32, mv.as_mut_ptr(), &mut need).is_ok() {
                                        let n = need as usize / std::mem::size_of::<DXGI_OUTDUPL_MOVE_RECT>();
                                        for m in mv.iter().take(n) {
                                            moves.push([m.SourcePoint.x, m.SourcePoint.y, m.DestinationRect.left, m.DestinationRect.top, m.DestinationRect.right, m.DestinationRect.bottom]);
                                        }
                                    }
                                    let mut dr = vec![RECT::default(); (info.TotalMetadataBufferSize as usize / std::mem::size_of::<RECT>()).max(1)];
                                    if self.dup.GetFrameDirtyRects((dr.len() * std::mem::size_of::<RECT>()) as u32, dr.as_mut_ptr(), &mut need).is_ok() {
                                        let n = need as usize / std::mem::size_of::<RECT>();
                                        for d in dr.iter().take(n) {
                                            dirty.push([d.left, d.top, d.right, d.bottom]);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    unsafe {
                        let _ = self.dup.ReleaseFrame();
                    }
                    if copied {
                        self.has_frame = true;
                        return Ok((true, dirty, moves, t.elapsed().as_micros() as u64));
                    }
                    if self.has_frame {
                        return Ok((false, vec![], vec![], t.elapsed().as_micros() as u64)); // mouse-only update
                    }
                    budget = 100; // first frame not presented yet
                }
                Err(e) if e.code() == DXGI_ERROR_WAIT_TIMEOUT => {
                    if self.has_frame {
                        return Ok((false, vec![], vec![], t.elapsed().as_micros() as u64));
                    }
                    if t.elapsed().as_millis() > 600 {
                        return Err(PErr::Timeout("no desktop frame yet".into()));
                    }
                }
                Err(e) if e.code() == DXGI_ERROR_ACCESS_LOST => {
                    return Err(PErr::Other("DXGI_ERROR_ACCESS_LOST (desktop switch / mode change): duplication must be recreated".into()));
                }
                Err(e) => return Err(PErr::Other(format!("AcquireNextFrame: {e}"))),
            }
        }
    }

    pub fn capture(&mut self, r: Rect, timeout_ms: u32, publish: bool) -> Result<CapturedFrame, PErr> {
        let (rx, ry) = (r.x - self.origin.0, r.y - self.origin.1);
        if r.w < 1 || r.h < 1 || rx < 0 || ry < 0 || rx + r.w > self.width as i32 || ry + r.h > self.height as i32 {
            return Err(PErr::OutOfBounds(format!("region {},{},{},{} is outside the primary output {}x{}", r.x, r.y, r.w, r.h, self.width, self.height)));
        }
        let (fresh, dirty, moves, acquire_us) = self.acquire(timeout_ms)?;
        let t = Instant::now();
        let (w, h) = (r.w as u32, r.h as u32);
        let need_new = self.staging.as_ref().map(|s| s.1 != w || s.2 != h).unwrap_or(true);
        if need_new {
            let mut tex: Option<ID3D11Texture2D> = None;
            unsafe {
                self._device.CreateTexture2D(&tex_desc(w, h, D3D11_USAGE_STAGING, D3D11_CPU_ACCESS_READ.0 as u32), None, Some(&mut tex)).map_err(|e| PErr::Other(format!("staging texture: {e}")))?;
            }
            self.staging = Some((tex.ok_or_else(|| PErr::Other("no staging".into()))?, w, h));
        }
        let st = &self.staging.as_ref().unwrap().0;
        let bx = D3D11_BOX { left: rx as u32, top: ry as u32, front: 0, right: (rx + r.w) as u32, bottom: (ry + r.h) as u32, back: 1 };
        let mut sig = vec![];
        let mut section = None;
        let stride = w * 4;
        unsafe {
            self.ctx.CopySubresourceRegion(st, 0, 0, 0, 0, &self.shadow, 0, Some(&bx));
            let mut m = D3D11_MAPPED_SUBRESOURCE::default();
            self.ctx.Map(st, 0, D3D11_MAP_READ, 0, Some(&mut m)).map_err(|e| PErr::Other(format!("Map: {e}")))?;
            let src = std::slice::from_raw_parts(m.pData as *const u8, m.RowPitch as usize * h as usize);
            sig = gray_sig_from_bgra(src, m.RowPitch as usize, w as usize, h as usize);
            if publish {
                match self.ring.slot(stride as usize * h as usize) {
                    Ok(slot) => {
                        let dst = slot.as_mut_slice();
                        for y in 0..h as usize {
                            let s = y * m.RowPitch as usize;
                            dst[y * stride as usize..(y + 1) * stride as usize].copy_from_slice(&src[s..s + stride as usize]);
                        }
                        section = Some(slot.name.clone());
                    }
                    Err(e) => {
                        self.ctx.Unmap(st, 0);
                        return Err(PErr::Other(e));
                    }
                }
            }
            self.ctx.Unmap(st, 0);
        }
        Ok(CapturedFrame { width: w, height: h, stride, section, sig, dirty_rects: dirty, move_rects: moves, acquire_us, readback_us: t.elapsed().as_micros() as u64, fresh, backend: "dxgi".into() })
    }
}
