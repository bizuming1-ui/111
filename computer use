//! Real DXGI Desktop Duplication (IDXGIOutputDuplication::AcquireNextFrame) with dirty-rect telemetry.
//! GDI BitBlt is used ONLY when duplication is impossible (secure desktop / session 0 / RDP / driver loss),
//! and the reason is always reported in `fallback_reason` - no silent fallback.
use serde_json::{json, Value};
use std::time::{Duration, Instant};
use windows::core::Interface;
use windows::Win32::Foundation::*;
use windows::Win32::Graphics::Direct3D::*;
use windows::Win32::Graphics::Direct3D11::*;
use windows::Win32::Graphics::Dxgi::Common::*;
use windows::Win32::Graphics::Dxgi::*;
use windows::Win32::Graphics::Gdi::*;

pub struct Dxgi {
    ctx: ID3D11DeviceContext,
    dup: IDXGIOutputDuplication,
    staging: ID3D11Texture2D,
    pub w: u32,
    pub h: u32,
    pub origin: (i32, i32),
    have_frame: bool,
}

pub struct Stats {
    pub backend: &'static str,
    pub dirty: u32,
    pub moved: u32,
    pub frame_ms: f64,
    pub reason: Option<String>,
    pub timed_out_reused: bool,
    pub hash: u64,
    pub w: u32,
    pub h: u32,
}

impl Stats {
    pub fn to_json(&self) -> Value {
        let mut v = json!({
            "capture_backend": self.backend, "dirty_rects_count": self.dirty, "moved_rects_count": self.moved,
            "frame_ms": (self.frame_ms * 1000.0).round() / 1000.0, "width": self.w, "height": self.h,
            "frame_hash": format!("{:016x}", self.hash), "timed_out_reused_frame": self.timed_out_reused
        });
        if let Some(r) = &self.reason {
            v["fallback_reason"] = json!(r);
        }
        v
    }
}

impl Dxgi {
    pub fn new() -> Result<Dxgi, String> {
        unsafe {
            let mut dev: Option<ID3D11Device> = None;
            let mut ctx: Option<ID3D11DeviceContext> = None;
            D3D11CreateDevice(
                None,
                D3D_DRIVER_TYPE_HARDWARE,
                HMODULE::default(),
                D3D11_CREATE_DEVICE_BGRA_SUPPORT,
                None,
                D3D11_SDK_VERSION,
                Some(&mut dev),
                None,
                Some(&mut ctx),
            )
            .map_err(|e| format!("D3D11CreateDevice: {e}"))?;
            let dev = dev.ok_or("no D3D11 device")?;
            let ctx = ctx.ok_or("no D3D11 context")?;
            let dxgi_dev: IDXGIDevice = dev.cast().map_err(|e| format!("cast IDXGIDevice: {e}"))?;
            let adapter = dxgi_dev.GetAdapter().map_err(|e| format!("GetAdapter: {e}"))?;
            let output = adapter.EnumOutputs(0).map_err(|e| format!("EnumOutputs(0): {e}"))?;
            let od = output.GetDesc().map_err(|e| format!("Output.GetDesc: {e}"))?;
            let out1: IDXGIOutput1 = output.cast().map_err(|e| format!("cast IDXGIOutput1: {e}"))?;
            let dup = out1.DuplicateOutput(&dev).map_err(|e| format!("DuplicateOutput: {e}"))?;
            let dd = dup.GetDesc();
            let (w, h) = (dd.ModeDesc.Width, dd.ModeDesc.Height);
            let desc = D3D11_TEXTURE2D_DESC {
                Width: w,
                Height: h,
                MipLevels: 1,
                ArraySize: 1,
                Format: DXGI_FORMAT_B8G8R8A8_UNORM,
                SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
                Usage: D3D11_USAGE_STAGING,
                BindFlags: 0,
                CPUAccessFlags: D3D11_CPU_ACCESS_READ.0 as u32,
                MiscFlags: 0,
            };
            let mut staging: Option<ID3D11Texture2D> = None;
            dev.CreateTexture2D(&desc, None, Some(&mut staging)).map_err(|e| format!("CreateTexture2D: {e}"))?;
            Ok(Dxgi {
                ctx,
                dup,
                staging: staging.ok_or("no staging texture")?,
                w,
                h,
                origin: (od.DesktopCoordinates.left, od.DesktopCoordinates.top),
                have_frame: false,
            })
        }
    }

    /// Acquire (or reuse) the newest frame. `Err("ACCESS_LOST")` => caller must recreate; other Err => fall back.
    pub fn grab(&mut self, first_wait_ms: u32) -> Result<(u32, u32, bool), String> {
        unsafe {
            let timeout = if self.have_frame { 0 } else { first_wait_ms };
            let mut info = DXGI_OUTDUPL_FRAME_INFO::default();
            let mut res: Option<IDXGIResource> = None;
            match self.dup.AcquireNextFrame(timeout, &mut info, &mut res) {
                Ok(()) => {
                    let mut dirty = 0u32;
                    let mut moved = 0u32;
                    if info.TotalMetadataBufferSize > 0 {
                        let mut buf = vec![RECT::default(); 256];
                        let mut need = 0u32;
                        if self
                            .dup
                            .GetFrameDirtyRects((buf.len() * std::mem::size_of::<RECT>()) as u32, buf.as_mut_ptr(), &mut need)
                            .is_ok()
                        {
                            dirty = need / std::mem::size_of::<RECT>() as u32;
                        }
                        let mut mbuf = vec![DXGI_OUTDUPL_MOVE_RECT::default(); 64];
                        let mut mneed = 0u32;
                        if self
                            .dup
                            .GetFrameMoveRects(
                                (mbuf.len() * std::mem::size_of::<DXGI_OUTDUPL_MOVE_RECT>()) as u32,
                                mbuf.as_mut_ptr(),
                                &mut mneed,
                            )
                            .is_ok()
                        {
                            moved = mneed / std::mem::size_of::<DXGI_OUTDUPL_MOVE_RECT>() as u32;
                        }
                    }
                    if info.LastPresentTime != 0 || !self.have_frame {
                        if let Some(r) = res {
                            if let Ok(tex) = r.cast::<ID3D11Texture2D>() {
                                self.ctx.CopyResource(&self.staging, &tex);
                                self.have_frame = true;
                            }
                        }
                    }
                    let _ = self.dup.ReleaseFrame();
                    Ok((dirty, moved, false))
                }
                Err(e) if e.code() == DXGI_ERROR_WAIT_TIMEOUT => {
                    if self.have_frame {
                        Ok((0, 0, true))
                    } else {
                        Err("first frame timed out (static desktop produced no frame)".into())
                    }
                }
                Err(e) if e.code() == DXGI_ERROR_ACCESS_LOST => Err("ACCESS_LOST".into()),
                Err(e) => Err(format!("AcquireNextFrame: {e}")),
            }
        }
    }

    /// Map the staging texture and hand BGRA rows to `f(data, stride, w, h)`.
    pub fn with_pixels<R>(&self, f: impl FnOnce(&[u8], usize, u32, u32) -> R) -> Result<R, String> {
        unsafe {
            let mut m = D3D11_MAPPED_SUBRESOURCE::default();
            self.ctx
                .Map(&self.staging, 0, D3D11_MAP_READ, 0, Some(&mut m))
                .map_err(|e| format!("Map: {e}"))?;
            let len = m.RowPitch as usize * self.h as usize;
            let data = std::slice::from_raw_parts(m.pData as *const u8, len);
            let r = f(data, m.RowPitch as usize, self.w, self.h);
            self.ctx.Unmap(&self.staging, 0);
            Ok(r)
        }
    }
}

/// 8x8 average hash by sparse sampling (touches ~4k pixels, not 16 MB) - keeps frame_ms < 5.
pub fn ahash(data: &[u8], stride: usize, w: u32, h: u32) -> u64 {
    let mut cells = [0u32; 64];
    let (w, h) = (w as usize, h as usize);
    for cy in 0..8usize {
        for cx in 0..8usize {
            let mut s = 0u32;
            let mut n = 0u32;
            for sy in 0..4usize {
                for sx in 0..4usize {
                    let x = (cx * w / 8 + (sx * 2 + 1) * w / 64).min(w - 1);
                    let y = (cy * h / 8 + (sy * 2 + 1) * h / 32).min(h - 1);
                    let o = y * stride + x * 4;
                    if o + 2 < data.len() {
                        s += (data[o] as u32 * 29 + data[o + 1] as u32 * 150 + data[o + 2] as u32 * 77) >> 8;
                        n += 1;
                    }
                }
            }
            cells[cy * 8 + cx] = if n > 0 { s / n } else { 0 };
        }
    }
    let avg: u32 = cells.iter().sum::<u32>() / 64;
    let mut hash = 0u64;
    for (i, c) in cells.iter().enumerate() {
        if *c >= avg {
            hash |= 1u64 << i;
        }
    }
    hash
}

/// Full-desktop GDI capture (fallback only).
pub fn gdi_capture() -> Result<(Vec<u8>, u32, u32, (i32, i32)), String> {
    unsafe {
        let (vx, vy, vw, vh) = crate::input::virtual_screen();
        let hdc = GetDC(None);
        if hdc.is_invalid() {
            return Err("GetDC(NULL) failed (secure desktop / locked session)".into());
        }
        let mem = CreateCompatibleDC(hdc);
        let bmp = CreateCompatibleBitmap(hdc, vw, vh);
        let old = SelectObject(mem, bmp);
        let ok = BitBlt(mem, 0, 0, vw, vh, hdc, vx, vy, SRCCOPY | CAPTUREBLT);
        let mut bmi = BITMAPINFO::default();
        bmi.bmiHeader.biSize = std::mem::size_of::<BITMAPINFOHEADER>() as u32;
        bmi.bmiHeader.biWidth = vw;
        bmi.bmiHeader.biHeight = -vh;
        bmi.bmiHeader.biPlanes = 1;
        bmi.bmiHeader.biBitCount = 32;
        bmi.bmiHeader.biCompression = BI_RGB.0;
        let mut buf = vec![0u8; (vw * vh * 4) as usize];
        let lines = GetDIBits(mem, bmp, 0, vh as u32, Some(buf.as_mut_ptr() as *mut _), &mut bmi, DIB_RGB_COLORS);
        SelectObject(mem, old);
        let _ = DeleteObject(bmp);
        let _ = DeleteDC(mem);
        ReleaseDC(None, hdc);
        if ok.is_err() || lines == 0 {
            return Err("BitBlt/GetDIBits failed".into());
        }
        Ok((buf, vw as u32, vh as u32, (vx, vy)))
    }
}

/// Capture facade: DXGI first, explicit fallback to GDI, periodic DXGI re-probe.
pub struct Capture {
    dxgi: Option<Dxgi>,
    reason: Option<String>,
    last_probe: Instant,
    gdi: Option<(Vec<u8>, u32, u32, (i32, i32))>,
    pub dxgi_frames: u64,
    pub gdi_frames: u64,
}

impl Capture {
    pub fn new() -> Capture {
        let mut c = Capture { dxgi: None, reason: None, last_probe: Instant::now() - Duration::from_secs(60), gdi: None, dxgi_frames: 0, gdi_frames: 0 };
        c.probe();
        c
    }

    fn probe(&mut self) {
        self.last_probe = Instant::now();
        match Dxgi::new() {
            Ok(d) => {
                self.dxgi = Some(d);
                self.reason = None;
            }
            Err(e) => {
                self.dxgi = None;
                self.reason = Some(e);
            }
        }
    }

    pub fn backend_reason(&self) -> Option<String> {
        self.reason.clone()
    }

    /// Capture one frame. Returns stats (always real telemetry).
    pub fn grab(&mut self) -> Stats {
        let t0 = Instant::now();
        if self.dxgi.is_none() && self.last_probe.elapsed() > Duration::from_secs(3) {
            self.probe();
        }
        if let Some(d) = self.dxgi.as_mut() {
            let mut r = d.grab(400);
            if matches!(&r, Err(e) if e == "ACCESS_LOST") {
                self.probe();
                r = match self.dxgi.as_mut() {
                    Some(d2) => d2.grab(400),
                    None => Err(self.reason.clone().unwrap_or_default()),
                };
            }
            match r {
                Ok((dirty, moved, reused)) => {
                    let d = self.dxgi.as_ref().unwrap();
                    let hash = d.with_pixels(|p, s, w, h| ahash(p, s, w, h)).unwrap_or(0);
                    self.dxgi_frames += 1;
                    return Stats { backend: "DXGI", dirty, moved, frame_ms: t0.elapsed().as_secs_f64() * 1000.0, reason: None, timed_out_reused: reused, hash, w: d.w, h: d.h };
                }
                Err(e) => {
                    self.reason = Some(e);
                    if self.reason.as_deref() == Some("ACCESS_LOST") {
                        self.dxgi = None;
                    }
                }
            }
        }
        let reason = self.reason.clone().unwrap_or_else(|| "DXGI unavailable".into());
        match gdi_capture() {
            Ok(g) => {
                let hash = ahash(&g.0, g.1 as usize * 4, g.1, g.2);
                let (w, h) = (g.1, g.2);
                self.gdi = Some(g);
                self.gdi_frames += 1;
                Stats { backend: "GDI", dirty: 0, moved: 0, frame_ms: t0.elapsed().as_secs_f64() * 1000.0, reason: Some(reason), timed_out_reused: false, hash, w, h }
            }
            Err(e) => Stats { backend: "NONE", dirty: 0, moved: 0, frame_ms: t0.elapsed().as_secs_f64() * 1000.0, reason: Some(format!("{reason}; GDI: {e}")), timed_out_reused: false, hash: 0, w: 0, h: 0 },
        }
    }

    /// Write the last captured frame (optionally cropped to `region` in virtual-desktop coords and downscaled) to PNG.
    pub fn save_png(&self, path: &str, region: Option<[i32; 4]>, scale: f64) -> Result<Value, String> {
        let write = |data: &[u8], stride: usize, w: u32, h: u32, origin: (i32, i32)| -> Result<Value, String> {
            let (rx, ry, rw, rh) = match region {
                Some([x, y, rw, rh]) => (
                    (x - origin.0).clamp(0, w as i32 - 1),
                    (y - origin.1).clamp(0, h as i32 - 1),
                    rw.max(1),
                    rh.max(1),
                ),
                None => (0, 0, w as i32, h as i32),
            };
            let rw = rw.min(w as i32 - rx).max(1);
            let rh = rh.min(h as i32 - ry).max(1);
            let sc = if scale > 0.05 && scale <= 1.0 { scale } else { 1.0 };
            let (ow, oh) = (((rw as f64 * sc) as u32).max(1), ((rh as f64 * sc) as u32).max(1));
            let mut rgb = vec![0u8; (ow * oh * 3) as usize];
            for oy in 0..oh {
                let sy = (ry as f64 + (oy as f64 + 0.5) / sc) as usize;
                for ox in 0..ow {
                    let sx = (rx as f64 + (ox as f64 + 0.5) / sc) as usize;
                    let o = sy.min(h as usize - 1) * stride + sx.min(w as usize - 1) * 4;
                    let d = ((oy * ow + ox) * 3) as usize;
                    rgb[d] = data[o + 2];
                    rgb[d + 1] = data[o + 1];
                    rgb[d + 2] = data[o];
                }
            }
            let f = std::fs::File::create(path).map_err(|e| format!("create {path}: {e}"))?;
            let mut enc = png::Encoder::new(std::io::BufWriter::new(f), ow, oh);
            enc.set_color(png::ColorType::Rgb);
            enc.set_depth(png::BitDepth::Eight);
            enc.set_compression(png::Compression::Fast);
            let mut wr = enc.write_header().map_err(|e| e.to_string())?;
            wr.write_image_data(&rgb).map_err(|e| e.to_string())?;
            drop(wr);
            Ok(json!({"path": path, "w": ow, "h": oh, "scale": sc, "src_rect": [rx + origin.0, ry + origin.1, rw, rh]}))
        };
        if let Some(d) = &self.dxgi {
            if self.reason.is_none() {
                return d.with_pixels(|p, s, w, h| write(p, s, w, h, d.origin))?;
            }
        }
        match &self.gdi {
            Some((buf, w, h, origin)) => write(buf, *w as usize * 4, *w, *h, *origin),
            None => Err("no frame captured yet".into()),
        }
    }
}

pub fn percentile(sorted: &[f64], p: f64) -> f64 {
    if sorted.is_empty() {
        return 0.0;
    }
    let i = ((sorted.len() as f64 - 1.0) * p).round() as usize;
    sorted[i.min(sorted.len() - 1)]
}

/// N back-to-back captures with real percentile telemetry (used by verify_step1_live.py and --selftest-dxgi).
pub fn bench(cap: &mut Capture, frames: u32) -> Value {
    let mut ms = Vec::with_capacity(frames as usize);
    let mut fresh_ms: Vec<f64> = Vec::new();
    let mut first_reason: Option<String> = None;
    let (mut dx, mut gd) = (0u32, 0u32);
    let mut backend = "NONE";
    for _ in 0..frames.max(1) {
        let s = cap.grab();
        ms.push(s.frame_ms);
        if !s.timed_out_reused && s.backend != "NONE" {
            fresh_ms.push(s.frame_ms);
        }
        backend = s.backend;
        match s.backend {
            "DXGI" => dx += 1,
            "GDI" => gd += 1,
            _ => {}
        }
        if first_reason.is_none() {
            first_reason = s.reason.clone();
        }
        std::thread::sleep(Duration::from_millis(16));
    }
    ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
    fresh_ms.sort_by(|a, b| a.partial_cmp(b).unwrap());
    json!({
        "fresh_frames": fresh_ms.len(), "p50_fresh_ms": percentile(&fresh_ms, 0.5), "p95_fresh_ms": percentile(&fresh_ms, 0.95),
        "type": "capture_bench_result", "backend": backend, "frames": ms.len(), "dxgi_frames": dx, "gdi_frames": gd,
        "p50_ms": percentile(&ms, 0.5), "p95_ms": percentile(&ms, 0.95), "p99_ms": percentile(&ms, 0.99),
        "min_ms": ms.first().copied().unwrap_or(0.0), "max_ms": ms.last().copied().unwrap_or(0.0),
        "fallback_reason": first_reason
    })
}
