class TestDmlPipeline(unittest.TestCase):
    def test_letterbox_decode_roundtrip(self) -> None:
        import numpy as np

        from sidecar import dml_detector as D

        arr = np.zeros((1080, 1920, 3), dtype=np.uint8)
        x, r, px, py = D.letterbox(arr)
        self.assertEqual(x.shape, (1, 3, 640, 640))
        self.assertAlmostEqual(r, 1 / 3, places=3)
        self.assertEqual(px, 0)
        self.assertEqual(py, 140)
        # synthetic YOLO output: one box centred at source (960,540) of size 300x120
        out = np.zeros((1, 5, 8400), dtype=np.float32)
        out[0, :, 0] = [960 * r + px, 540 * r + py, 300 * r, 120 * r, 0.9]
        out[0, :, 1] = [960 * r + px + 1, 540 * r + py + 1, 300 * r, 120 * r, 0.8]  # duplicate -> NMS
        res = D.decode_yolo(out, r, px, py, 1920, 1080)
        self.assertEqual(len(res), 1)
        bx, by, bw, bh = res[0]["box"]
        self.assertLessEqual(abs(bx - 810), 3)
        self.assertLessEqual(abs(by - 480), 3)
        self.assertLessEqual(abs(bw - 300), 3)
        self.assertLessEqual(abs(bh - 120), 3)

    def test_label_and_format(self) -> None:
        from sidecar import dml_detector as D

