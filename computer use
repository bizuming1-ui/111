            Hwnd = CreateWindowEx(0x080800A8u, "STATIC", "DeepSeekVirtualCursor", 0x80000000u, 0, 0, size, size, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero);
