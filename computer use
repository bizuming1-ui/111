def find(text, role, name_rx):
    for m in re.finditer(r'\[(\d+)\] (\w+) "([^"]*)"', text):
        if m.group(2).lower() == role and re.search(name_rx, m.group(3), re.I):
            return int(m.group(1))
    return None


