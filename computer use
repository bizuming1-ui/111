$script:DscuFiles['workers/ps_safe_worker.ps1'] = @'
#Requires -Version 7.0
<#
.SYNOPSIS
  Compatibility bridge: the mature AST-allow-list + ConstrainedLanguage execution from the old single-file script,
  extracted into a SHORT-LIVED worker. Python wakes it for one restricted system script and it exits - it never runs the
  main loop (resident memory ~0 between calls). Output: ONE JSON line.
#>
param(
    [Parameter(Mandatory)][string]$CommandB64,
    [string]$Workspace = (Join-Path ([IO.Path]::GetTempPath()) 'dscu-ps'),
    [int]$TimeoutSec = 30
)
$ErrorActionPreference = 'Stop'
$cmd = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($CommandB64))
New-Item -ItemType Directory -Force -Path $Workspace | Out-Null
$Workspace = (Resolve-Path $Workspace).Path

# default-deny allow-list (read-only inspection + workspace-confined file ops + a few typed system primitives)
$AllowCmd = @('Get-Date','Get-ChildItem','Get-Content','Get-Item','Test-Path','Select-String','Measure-Object','Sort-Object','Select-Object','Where-Object',
  'ForEach-Object','Format-Table','Format-List','ConvertTo-Json','ConvertFrom-Json','Out-String','Write-Output','Get-Process','Get-Clipboard','Resolve-Path',
  'Join-Path','Split-Path','Set-Content','Add-Content','New-Item','Copy-Item','Move-Item','Out-File','Clear-RecycleBin','Get-Volume','Get-ComputerInfo')
$PathCmd  = @('Set-Content','Add-Content','New-Item','Copy-Item','Move-Item','Out-File','Remove-Item','Get-Content','Get-ChildItem','Get-Item')
$DenyStatic = @('[System.Diagnostics.Process]','[Reflection.','[System.Reflection.','[Activator]','[System.Net.','[Net.')

function Test-Ast([string]$Text) {
    $tokens = $null; $errs = $null
    $ast = [System.Management.Automation.Language.Parser]::ParseInput($Text, [ref]$tokens, [ref]$errs)
    $v = [System.Collections.Generic.List[string]]::new()
    if ($errs.Count) { $v.Add("parse_error: $($errs[0].Message)") }
    foreach ($n in $ast.FindAll({ $true }, $true)) {
        switch ($n.GetType().Name) {
            'InvokeMemberExpressionAst' { $v.Add("method_call_denied: $($n.Extent.Text.Substring(0,[Math]::Min(40,$n.Extent.Text.Length)))") }
            'DynamicKeywordStatementAst' { $v.Add('dynamic_keyword') }
            'UsingStatementAst' { $v.Add('using_denied') }
            'ScriptBlockExpressionAst' { if ($n.Parent -isnot [System.Management.Automation.Language.CommandAst] -and $n.Parent -isnot [System.Management.Automation.Language.PipelineAst]) { $v.Add('free_scriptblock') } }
            'CommandAst' {
                $name = $n.GetCommandName()
                if (-not $name) { $v.Add('dynamic_command'); continue }
                if ($name -in @('Invoke-Expression','iex','Add-Type','Start-Process','Invoke-WebRequest','Invoke-RestMethod','Invoke-Command','New-Object','Set-ExecutionPolicy','Import-Module','Register-ScheduledTask')) { $v.Add("denied_command: $name"); continue }
                if ($name -notin $AllowCmd -and $name -ne 'Remove-Item') { $v.Add("unknown_command: $name (default deny)"); continue }
                if ($name -in $PathCmd) {
                    foreach ($el in $n.CommandElements) {
                        if ($el -is [System.Management.Automation.Language.StringConstantExpressionAst] -and $el.Value -match '^[A-Za-z]:\\|^\\\\|^\.\.?[\\/]') {
                            try { $full = [IO.Path]::GetFullPath($el.Value) } catch { $v.Add("bad_path: $($el.Value)"); continue }
                            if (-not $full.StartsWith($Workspace, [StringComparison]::OrdinalIgnoreCase)) { $v.Add("path_outside_workspace: $($el.Value)") }
                        }
                    }
                }
                if ($name -eq 'Remove-Item') { $v.Add('remove_item_requires_human') }
            }
        }
    }
    foreach ($d in $DenyStatic) { if ($Text.IndexOf($d, [StringComparison]::OrdinalIgnoreCase) -ge 0) { $v.Add("denied_type: $d") } }
    return $v
}

try {
    $viol = Test-Ast $cmd
    if ($viol.Count) { [pscustomobject]@{ ok = $false; error = 'AST audit failed'; violations = $viol } | ConvertTo-Json -Compress; exit 0 }
    # second line of defence: ConstrainedLanguage inside an isolated runspace with a hard timeout
    $rs = [runspacefactory]::CreateRunspace()
    $rs.Open()
    $rs.SessionStateProxy.LanguageMode = 'ConstrainedLanguage'
    $ps = [powershell]::Create()
    $ps.Runspace = $rs
    [void]$ps.AddScript("Set-Location -LiteralPath '$Workspace'; $cmd")
    $async = $ps.BeginInvoke()
    if (-not $async.AsyncWaitHandle.WaitOne($TimeoutSec * 1000)) { $ps.Stop(); throw "timeout after ${TimeoutSec}s" }
    $out = $ps.EndInvoke($async) | Out-String
    if ($ps.Streams.Error.Count) { $out += ($ps.Streams.Error | Out-String) }
    [pscustomobject]@{ ok = ($ps.Streams.Error.Count -eq 0); output = $out.Trim(); clm = $true } | ConvertTo-Json -Compress
} catch {
    [pscustomobject]@{ ok = $false; error = $_.Exception.Message } | ConvertTo-Json -Compress
}
