_UNIT = r"\s*(?:条|封|个|份|emails?|messages?|mails?)?"
_U = r"(?:条|封|个|份|emails?|messages?|mails?)"
HEAD_RX = re.compile(r"(?:最前面?|前面|前边|前|最新的?|最近的?)\s*" + _NUM + r"\s*" + _U + r"|(?:first|top|latest|newest)\s*" + _NUM.replace("(", "(?P<en>", 1) + r"(?:\s*" + _U + r")?", re.I)
TAIL_RX = re.compile(r"(?:最后面?|后面|后边|最末|末尾|末|最旧的?|最早的?|最老的?|倒数)\s*" + _NUM + r"?\s*" + _U + r"|(?:last|oldest|bottom)\s*" + _NUM.replace("(", "(?P<en>", 1) + r"?(?:\s*" + _U + r")?\s*(?=emails?|messages?|mails?|and\b|$|[,.，。])", re.I)
ALL_RX = re.compile(r"所有|全部|整个|\ball\b|everything", re.I)
PAGE_RX = re.compile(r"本页|当前页|这一页|当前页面|本页面|this page|current page")
EMAIL_RX = re.compile(r"[\w.+\-]+@[\w\-]+(?:\.[\w\-]+)+")
SENDER_RX = re.compile(r"(?:来自|发件人(?:是|为|叫)?|寄件者|from)\s*[:：]?\s*[“\"'「]?([\w.+\-@\u4e00-\u9fff]+?)[”\"'」]?\s*(?:的|发来的|发送的|$|[,，。\s])", re.I)
DATE_RX = re.compile(r"(\d{4})\s*[-/年.]\s*(\d{1,2})\s*[-/月.]\s*(\d{1,2})\s*日?")
RECENT_RX = re.compile(r"(?:最近|过去|近|last|past)\s*" + _NUM + r"\s*(天|日|周|星期|个月|月|days?|weeks?|months?)", re.I)
MAIL_WORDS = re.compile(r"gmail|谷歌邮箱|google\s*邮箱|邮箱|邮件|收件箱|inbox|e-?mails?", re.I)
DELETE_WORDS = re.compile(r"删除|刪除|清理|移到垃圾|移入垃圾|放入垃圾|丢进垃圾|trash|delete|remove", re.I)
LIST_WORDS = re.compile(r"读取|查看|看看|列出|有没有|read|list|show|check", re.I)
WRITE_WORDS = re.compile(r"发送|写邮件|回复|转发|附件|send|reply|compose|forward|永久删除|彻底删除|permanently", re.I)


def _quote(v: str) -> str:
    return f'"{v}"' if re.search(r"\s", v) else v


def _date_filters(t: str) -> list[str]:
    out: list[str] = []
    ds = []
    for m in DATE_RX.finditer(t):
        try:
            ds.append((m.start(), date(int(m.group(1)), int(m.group(2)), int(m.group(3)))))
        except ValueError:
            continue
    if len(ds) >= 2:
        a, b = sorted(d for _, d in ds[:2])
        out += [f"after:{a:%Y/%m/%d}", f"before:{b + timedelta(days=1):%Y/%m/%d}"]  # Gmail `before` is exclusive -> inclusive end date
    elif len(ds) == 1:
        pos, d = ds[0]
        tail = t[pos: pos + 20]
        head = t[max(0, pos - 6): pos]
        if re.search(r"之后|以后|起|开始|after|since", tail + head, re.I):
            out.append(f"after:{d:%Y/%m/%d}")
        elif re.search(r"之前|以前|前的|截止|before|until", tail + head, re.I):
            out.append(f"before:{d:%Y/%m/%d}")
        else:
            out += [f"after:{d:%Y/%m/%d}", f"before:{d + timedelta(days=1):%Y/%m/%d}"]
    m = RECENT_RX.search(t)
    if m and not ds:
        n, unit = cn2int(m.group(1)), m.group(2).lower()
        days = n * (7 if unit.startswith(("周", "星", "week")) else 30 if unit.startswith(("个月", "月", "month")) else 1)
        out.append(f"newer_than:{max(1, days)}d")
    elif re.search(r"今天|今日|today", t, re.I) and not ds:
        out.append("newer_than:1d")
    return out


def parse_gmail_task(task: str) -> Optional[dict[str, Any]]:
    """Natural language -> {intent, query, count, selection[], order, filters[], scope, needs_count}.  None => not a Gmail API-eligible task (browser lane).
    selection = [{'from':'head','n':5},{'from':'tail','n':1}] means 'first 5 of the (newest-first) list + last 1 of it'; deduplicated at resolve time."""
    t = str(task or "")
    if not MAIL_WORDS.search(t) or WRITE_WORDS.search(t):
        return None
    sel: list[dict[str, Any]] = []
    for m in HEAD_RX.finditer(t):
        sel.append({"from": "head", "n": cn2int(m.group(1) or m.group("en"))})
    taken = [(m.start(), m.end()) for m in HEAD_RX.finditer(t)]
    for m in TAIL_RX.finditer(t):
        if any(a <= m.start() < b for a, b in taken):
            continue
        num = m.group(1) or m.group("en")
        sel.append({"from": "tail", "n": cn2int(num) if num else 1})
    sel = [s for s in sel if s["n"] > 0]
    if not sel and ALL_RX.search(t):
        sel = [{"from": "all", "n": 0}]
    base = "in:inbox"
    flt: list[str] = []
    if re.search(r"未读|unread", t, re.I):
        flt.append("is:unread")
    if re.search(r"广告|推广|促销|promotion", t, re.I):
        base = "category:promotions"
    elif re.search(r"垃圾邮件|spam", t, re.I):
        base = "in:spam"
    em = EMAIL_RX.search(t)
    if em:
        flt.append(f"from:{em.group(0)}")
    else:
        sm = SENDER_RX.search(t)
        if sm and sm.group(1) not in ("我", "你", "他", "她", "它") and not re.fullmatch(_NUM, sm.group(1)):
            flt.append(f"from:{_quote(sm.group(1))}")
    flt += _date_filters(t)
    query = " ".join([base] + flt)
    scope = "page" if PAGE_RX.search(t) else "query"
    total = sum(s["n"] for s in sel)
    if DELETE_WORDS.search(t):
        return {"intent": "trash", "query": query, "count": total, "selection": sel, "order": "newest_first", "filters": flt, "scope": scope, "needs_count": not sel}
    if LIST_WORDS.search(t) and not re.search(r"进入|打开|登录", t):
        if not sel:
            sel = [{"from": "head", "n": 5}]
        return {"intent": "list", "query": query, "count": sum(s["n"] for s in sel), "selection": sel, "order": "newest_first", "filters": flt, "scope": scope, "needs_count": False}
    return None


def resolve_selection(ids_newest_first: list[str], selection: list[dict[str, Any]], page_size: int = 50, scope: str = "query", max_all: int = 100) -> list[str]:
    """Pure function: `first_n + last_n` on an id list ordered like the Gmail UI (newest first).  Deduplicated, order-preserving (head ids first, then tail ids)."""
    pool = ids_newest_first[:page_size] if scope == "page" else ids_newest_first
    out: list[str] = []
    for seg in selection:
        n = int(seg.get("n", 0) or 0)
        kind = seg.get("from")
        if kind == "head":
            chunk = pool[:n]
        elif kind == "tail":
            chunk = pool[-n:] if n > 0 else []
        elif kind == "all":
            if len(pool) > max_all:
                raise GmailSelectionError(f"匹配 {len(pool)} 封，超过一次性删除上限 {max_all}；请缩小范围（指定数量/日期/发件人）")
            chunk = pool
        else:
            chunk = []
        for i in chunk:
            if i not in out:
                out.append(i)
    return out


@dataclass(frozen=True)
class FrozenTargets:
    query: str
    order: str
    segments: tuple
    message_ids: tuple
    rows: tuple  # tuple of dict(message_id, thread_id, sender, subject, date, labels)
    total_matching: int
    truncated: bool
    fingerprint: str
    frozen_at: float

    @property
    def ids(self) -> list[str]:
        return list(self.message_ids)


def fingerprint_ids(query: str, ids: list[str]) -> str:
    return hashlib.sha256((query + "\n" + "\n".join(ids)).encode()).hexdigest()


# ======================================================================================================================= REST client
def _urllib_transport(method: str, url: str, headers: dict[str, str], body: Optional[bytes]) -> tuple[int, dict[str, Any], dict[str, str]]:
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            raw = r.read().decode("utf-8", "replace")
            return r.status, (json.loads(raw) if raw.strip() else {}), {k.lower(): v for k, v in r.headers.items()}
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        try:
            js = json.loads(raw)
        except Exception:  # noqa: BLE001
            js = {"error": raw[:300]}
        return e.code, js, {k.lower(): v for k, v in (e.headers or {}).items()}
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        return 599, {"error": f"network: {e}"}, {}


class GmailSkill:
    def __init__(self, store: Optional[TokenStore] = None, transport: Optional[Transport] = None, sleep: Callable[[float], None] = time.sleep, clock: Callable[[], float] = time.time,
                 max_retries: int = 6, base_delay: float = 0.5, max_delay: float = 32.0, seed: Optional[int] = None, workers: int = 6, max_pages: int = 100) -> None:
        self.store = store or TokenStore()
        self.transport = transport or _urllib_transport
        self.sleep, self.clock = sleep, clock
        self.max_retries, self.base_delay, self.max_delay = max_retries, base_delay, max_delay
        self.rng = random.Random(seed)
        self.workers, self.max_pages = workers, max_pages
        self.tok: dict[str, Any] = {}
        self._lock = threading.RLock()
        self.stats: dict[str, Any] = {"calls": 0, "refreshes": 0, "retries_429": 0, "retries_5xx": 0, "backoff_sleeps": [], "list_pages": 0}
        self.overprivileged = False

    # ---------------------------------------------------------------- auth
    def available(self) -> bool:
        try:
            if not self.store.exists():
                return False
            t = self.tok or self.store.load()
            self.tok = t
            return bool(t.get("access_token") or (t.get("refresh_token") and t.get("client_id") and t.get("client_secret")))
        except (GmailSkillError, ValueError, OSError):
            return False

    def _refresh(self) -> None:
        with self._lock:
            t = self.tok or self.store.load()
            if not (t.get("refresh_token") and t.get("client_id") and t.get("client_secret")):
                raise GmailAuthError("access_token 已过期且缺少 refresh_token/client_id/client_secret，无法刷新；请运行 gmail-auth")
            body = urllib.parse.urlencode({"grant_type": "refresh_token", "refresh_token": t["refresh_token"], "client_id": t["client_id"], "client_secret": t["client_secret"]}).encode()
            st, js, _ = self._norm(self.transport("POST", TOKEN_URL, {"Content-Type": "application/x-www-form-urlencoded"}, body))
            if st != 200 or "access_token" not in js:
                raise GmailAuthError(f"token refresh 失败 {st}: {str(js.get('error_description') or js.get('error') or js)[:160]}（若为 invalid_grant 请重新运行 gmail-auth）")
            t["access_token"] = js["access_token"]
            t["expires_at"] = self.clock() + int(js.get("expires_in", 3500))
            if js.get("refresh_token"):
                t["refresh_token"] = js["refresh_token"]
            if js.get("scope"):
                t["scope"] = js["scope"]
            self.tok = t
            self.stats["refreshes"] += 1
            self.overprivileged = any(s in str(t.get("scope", "")).split() for s in OVERBROAD_SCOPES)
            self.store.save(t)

    @staticmethod
    def _norm(r: tuple) -> tuple[int, dict[str, Any], dict[str, str]]:
        return (r[0], r[1], r[2] if len(r) > 2 else {})

    def _ensure_token(self) -> None:
        with self._lock:
            if not self.tok:
                self.tok = self.store.load()
            if not self.tok.get("access_token") or (self.tok.get("expires_at") and float(self.tok["expires_at"]) - 60 < self.clock()):
                self._refresh()

    def _delay(self, attempt: int, headers: dict[str, str]) -> float:
        ra = headers.get("retry-after")
        if ra and str(ra).replace(".", "", 1).isdigit():
            return min(self.max_delay, float(ra))
        return min(self.max_delay, self.base_delay * (2 ** attempt)) * (0.75 + 0.25 * self.rng.random())

    def _call(self, method: str, path: str, params: Optional[dict[str, Any]] = None, body: Optional[dict[str, Any]] = None) -> dict[str, Any]:
        url = API + path + (("?" + urllib.parse.urlencode(params, doseq=True)) if params else "")
        refreshed = False
        for attempt in range(self.max_retries + 1):
            self._ensure_token()
            hdr = {"Authorization": f"Bearer {self.tok['access_token']}", "Accept": "application/json", "Content-Type": "application/json"}
            st, js, rh = self._norm(self.transport(method, url, hdr, json.dumps(body).encode() if body is not None else None))
            self.stats["calls"] += 1
            if st == 401 and not refreshed:
                refreshed = True
                self._refresh()
                continue
            err = js.get("error") if isinstance(js, dict) else None
            reason = json.dumps(err)[:300].lower() if err is not None else ""
            rate = st == 429 or (st == 403 and ("ratelimit" in reason or "quota" in reason))
            if rate or st >= 500:
                if attempt >= self.max_retries:
                    raise GmailRateLimitError(f"Gmail API {st} 重试 {self.max_retries} 次仍失败")
                d = self._delay(attempt, rh)
                self.stats["retries_429" if rate else "retries_5xx"] += 1
                self.stats["backoff_sleeps"].append(round(d, 3))
                self.sleep(d)
                continue
            if st >= 400:
                raise GmailSkillError(f"Gmail API {st}: {str(err or js)[:200]}")
            return js
        raise GmailSkillError("unreachable")

    # ---------------------------------------------------------------- reads
    def list_ids(self, query: str, order: str = "newest_first", max_pages: Optional[int] = None) -> tuple[list[str], bool]:
        """All matching message ids in Gmail-UI order (newest first), paginated (500/page).  Returns (ids, truncated)."""
        ids: list[str] = []
        tok: Optional[str] = None
        pages = 0
        limit = max_pages or self.max_pages
        while True:
            p: dict[str, Any] = {"q": query, "maxResults": 500}
            if tok:
                p["pageToken"] = tok
            js = self._call("GET", "/messages", p)
            pages += 1
            self.stats["list_pages"] += 1
            ids += [m["id"] for m in js.get("messages", []) or []]
            tok = js.get("nextPageToken")
            if not tok:
                return (ids[::-1] if order == "oldest_first" else ids), False
            if pages >= limit:
                return (ids[::-1] if order == "oldest_first" else ids), True

    def get_metadata(self, ids: list[str]) -> list[dict[str, Any]]:
        def one(i: str) -> dict[str, Any]:
            d = self._call("GET", f"/messages/{i}", {"format": "metadata", "metadataHeaders": ["Subject", "From", "Date"]})
            h = {x["name"].lower(): x["value"] for x in (d.get("payload", {}).get("headers", []) or [])}
            return {"message_id": d.get("id", i), "thread_id": d.get("threadId", ""), "sender": h.get("from", ""), "subject": h.get("subject", ""), "date": h.get("date", ""),
                    "labels": list(d.get("labelIds") or []), "snippet": d.get("snippet", "")}

        if len(ids) <= 1 or self.workers <= 1:
            return [one(i) for i in ids]
        with ThreadPoolExecutor(max_workers=self.workers) as ex:
            return list(ex.map(one, ids))  # order-preserving

    def list_messages(self, query: str = "in:inbox", order: str = "newest_first", limit: Optional[int] = None) -> list[dict[str, Any]]:
        """Full metadata (message_id, thread_id, sender, subject, date, labels) for the first `limit` messages of the query in `order`."""
        ids, _ = self.list_ids(query, order)
        return self.get_metadata(ids[:limit] if limit else ids)

    # ---------------------------------------------------------------- phase 1: freeze
    def freeze_targets(self, spec: dict[str, Any]) -> FrozenTargets:
        if spec.get("needs_count") or not spec.get("selection"):
            raise GmailSelectionError("任务没有给出明确的删除数量/范围（如“前5条”“最后1条”）；为避免误删不使用默认值，请补充说明")
        ids, truncated = self.list_ids(spec["query"], spec.get("order", "newest_first"))
        if truncated and any(s.get("from") in ("tail", "all") for s in spec["selection"]) and spec.get("scope") != "page":
            raise GmailSelectionError(f"匹配邮件超过 {self.max_pages * 500} 封，无法保证“最后 N 封”的准确性；请缩小范围或使用日期/发件人过滤")
        pick = resolve_selection(ids, spec["selection"], scope=spec.get("scope", "query"))
        want = sum(int(s.get("n", 0)) for s in spec["selection"] if s.get("from") != "all")
        if not pick:
            raise GmailSelectionError(f"查询 {spec['query']!r} 没有匹配的邮件")
        rows = self.get_metadata(pick)
        got = [r["message_id"] for r in rows]
        if got != pick:
            raise GmailSelectionError("元信息与冻结 id 不一致（邮件在冻结期间发生变化）")
        notes = ""
        if want and len(pick) < want:
            notes = f"（所选片段重叠/邮件不足：请求 {want} 封，实际唯一 {len(pick)} 封）"
        return FrozenTargets(spec["query"], spec.get("order", "newest_first"), tuple(json.dumps(s, sort_keys=True) for s in spec["selection"]), tuple(pick), tuple(rows),
                             len(ids), truncated, fingerprint_ids(spec["query"], pick), self.clock())

    @staticmethod
    def render_summary(fz: FrozenTargets, notes: str = "") -> list[str]:
        out = [f"  📋 冻结的目标邮件（共 {len(fz.message_ids)} 封 / 查询 {fz.query!r} 命中 {fz.total_matching} 封 · 指纹 {fz.fingerprint[:12]}）{notes}"]
        for k, r in enumerate(fz.rows, 1):
            out.append(f"    {k:>2}. [{r['message_id'][:10]}] {r['sender'][:34]:<34} ｜ {r['subject'][:44]:<44} ｜ {r['date'][:25]}")
        return out

    # ---------------------------------------------------------------- phase 2: act + independent verification
    def trash_messages(self, message_ids: list[str]) -> dict[str, bool]:
        """Move to Trash (reversible 30 days).  NEVER permanent delete.  Per-id results; failures are reported, verification is separate and independent."""
        res: dict[str, bool] = {}
        for i in message_ids:
            try:
                self._call("POST", f"/messages/{i}/trash")
                res[i] = True
            except GmailSkillError:
                res[i] = False
        return res

    def verify_labels(self, message_ids: list[str], required_label: str = "TRASH") -> dict[str, Optional[bool]]:
        """Independent per-id oracle: re-read each message's labelIds from the server.  True/False/None(unreadable)."""
        out: dict[str, Optional[bool]] = {}

        def one(i: str) -> tuple[str, Optional[bool]]:
            try:
                return i, required_label in (self._call("GET", f"/messages/{i}", {"format": "minimal"}).get("labelIds") or [])
            except GmailSkillError:
                return i, None

        with ThreadPoolExecutor(max_workers=max(1, self.workers)) as ex:
            for i, v in ex.map(one, message_ids):
                out[i] = v
        return out

    def verify_all(self, message_ids: list[str], required_label: str = "TRASH") -> tuple[str, dict[str, Optional[bool]]]:
        lab = self.verify_labels(message_ids, required_label)
        ok = sum(1 for v in lab.values() if v is True)
        cov = "full" if ok == len(message_ids) and message_ids else "partial" if ok else "none"
        return cov, lab


# ======================================================================================================================= interactive OAuth (loopback + PKCE)
def authorize_interactive(client_json: Optional[str] = None, store: Optional[TokenStore] = None, open_browser: bool = True, timeout: int = 300) -> dict[str, Any]:
    import http.server
    import secrets
    import socketserver
    import webbrowser

    store = store or TokenStore()
    cj = client_json or os.environ.get("DSCU_GMAIL_CLIENT_JSON")
    if cj and Path(cj).exists():
        raw = json.loads(Path(cj).read_text(encoding="utf-8"))
        c = raw.get("installed") or raw.get("web") or raw
        cid, csec = c["client_id"], c["client_secret"]
    else:
        import getpass

        print("需要 Google Cloud 「桌面应用」OAuth 客户端（启用 Gmail API）。可设置 DSCU_GMAIL_CLIENT_JSON=client_secret.json，或在此输入：")
        cid = input("  client_id: ").strip()
        csec = getpass.getpass("  client_secret（不回显）: ").strip()
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(48)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    got: dict[str, str] = {}

    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self) -> None:  # noqa: N802
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            got.update({k: v[0] for k, v in q.items()})
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write("<h3>DSCU Gmail 授权完成，可以关闭此页面并回到 PowerShell。</h3>".encode("utf-8"))

        def log_message(self, *a: Any) -> None:
            pass

    with socketserver.TCPServer(("127.0.0.1", 0), H) as srv:
        port = srv.server_address[1]
        redirect = f"http://127.0.0.1:{port}"
        url = AUTH_URL + "?" + urllib.parse.urlencode({"client_id": cid, "redirect_uri": redirect, "response_type": "code", "scope": SCOPE, "access_type": "offline", "prompt": "consent",
                                                       "code_challenge": challenge, "code_challenge_method": "S256", "state": state})
        print("请在浏览器打开以下地址完成授权（仅申请 gmail.modify：读取 + 移入垃圾箱，不含永久删除）：\n  " + url)
        if open_browser:
            try:
                webbrowser.open(url)
            except Exception:  # noqa: BLE001
                pass
        srv.timeout = 2
        t0 = time.time()
        while "code" not in got and "error" not in got and time.time() - t0 < timeout:
            srv.handle_request()
    if got.get("state") != state or "code" not in got:
        raise GmailAuthError(f"授权失败/超时：{got.get('error', 'no code')}")
    body = urllib.parse.urlencode({"grant_type": "authorization_code", "code": got["code"], "client_id": cid, "client_secret": csec, "redirect_uri": redirect, "code_verifier": verifier}).encode()
    st, js, _ = GmailSkill._norm(_urllib_transport("POST", TOKEN_URL, {"Content-Type": "application/x-www-form-urlencoded"}, body))
    if st != 200 or "refresh_token" not in js:
        raise GmailAuthError(f"换取 token 失败 {st}: {str(js)[:200]}")
