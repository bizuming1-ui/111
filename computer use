    static double Clamp(double v, double lo, double hi) { return v < lo ? lo : (v > hi ? hi : v); }
    static int Pack(double a, double r, double g, double b) {
        int A = (int)(Clamp(a, 0, 1) * 255 + 0.5);
        int R = (int)(Clamp(r, 0, 1) * 255 + 0.5);
        int G = (int)(Clamp(g, 0, 1) * 255 + 0.5);
        int B = (int)(Clamp(b, 0, 1) * 255 + 0.5);
        return (A << 24) | (R << 16) | (G << 8) | B;
    }
    static double SignedDist(double[] px, double[] py, double x, double y) {
        int n = px.Length; double best = double.MaxValue; bool inside = false;
        for (int i = 0, j = n - 1; i < n; j = i++) {
            double ax = px[j], ay = py[j], bx = px[i], by = py[i];
            if (((ay > y) != (by > y)) && (x < (bx - ax) * (y - ay) / (by - ay) + ax)) inside = !inside;
            double vx = bx - ax, vy = by - ay, wx = x - ax, wy = y - ay;
            double len2 = vx * vx + vy * vy;
            double t = len2 > 0 ? (wx * vx + wy * vy) / len2 : 0;
            t = Clamp(t, 0, 1);
            double ex = x - (ax + t * vx), ey = y - (ay + t * vy);
            double dd = Math.Sqrt(ex * ex + ey * ey);
            if (dd < best) best = dd;
        }
        return inside ? -best : best;
    }
    // 箭头精灵：有符号距离场做解析抗锯齿；蓝色主体 + 白色描边 + 柔和阴影（和真实指针一眼可分辨）
    void BuildSprite() {
        sprite = new int[size * size];
        double k = scale * 1.15;
        double[] ax = { 0, 0, 4.2, 7.3, 10.2, 7.4, 12.8 };
        double[] ay = { 0, 18.0, 14.0, 20.8, 19.5, 12.6, 12.6 };
        for (int i = 0; i < ax.Length; i++) { ax[i] *= k; ay[i] *= k; }
        double bw = 1.5 * scale, blur = 3.2 * scale, sx = 1.2 * scale, sy = 2.2 * scale;
        double cr = 47.0 / 255.0, cg = 123.0 / 255.0, cb = 1.0;
        for (int iy = 0; iy < size; iy++) {
            for (int ix = 0; ix < size; ix++) {
                double x = ix + 0.5 - half, y = iy + 0.5 - half;
                if (x < -8 * scale || y < -8 * scale || x > 28 * scale || y > 34 * scale) continue;
                double dd = SignedDist(ax, ay, x, y);
                double outer = Clamp(0.5 - (dd - bw), 0, 1);
                double inner = Clamp(0.5 - dd, 0, 1);
                double f = outer > 0.0001 ? Math.Min(1.0, inner / outer) : 0;
                double ds = SignedDist(ax, ay, x - sx, y - sy);
                double c = Clamp(1.0 - (ds - bw) / blur, 0, 1);
                double sh = 0.40 * c * c;
                double r = cr * f + (1 - f), g = cg * f + (1 - f), b = cb * f + (1 - f);
                double outA = outer + sh * (1 - outer);
                sprite[iy * size + ix] = Pack(outA, r * outer, g * outer, b * outer);
            }
        }
    }
    void DrawRing(int[] f, double radius, double ringW, double alpha, double glow, double cr, double cg, double cb) {
        int lim = (int)Math.Ceiling(radius + ringW + 2);
        for (int dy = -lim; dy < lim; dy++) {
            for (int dx = -lim; dx < lim; dx++) {
                int px = half + dx, py = half + dy;
                if (px < 0 || py < 0 || px >= size || py >= size) continue;
                double rx = dx + 0.5, ry = dy + 0.5;
                double r = Math.Sqrt(rx * rx + ry * ry);
                double a = alpha * Clamp(1.0 - Math.Abs(r - radius) / ringW, 0, 1);
                if (r < radius) a += glow * (1.0 - r / radius);
                if (a <= 0.002) continue;
                if (a > 1) a = 1;
                int idx = py * size + px; int d = f[idx];
                double da = ((d >> 24) & 255) / 255.0, dr = ((d >> 16) & 255) / 255.0, dg = ((d >> 8) & 255) / 255.0, db = (d & 255) / 255.0;
                double ia = 1 - a;
                f[idx] = Pack(a + da * ia, cr * a + dr * ia, cg * a + dg * ia, cb * a + db * ia);
            }
        }
    }
    void Run() {
