async def s_v16_occlusion_recovery(brain: Any, trials: int = 8) -> dict[str, Any]:
    import ctypes
    import subprocess

    from tier1_micro import Gui
    from agent_brain.protocol import new_action_id

    if not IS_WIN:
        return result("v16_occlusion_recovery", "skipped", "requires Windows")
    hub = brain.hub
    if hub.driver_kind != "py-native":
        return result("v16_occlusion_recovery", "inconclusive", f"driver={hub.driver_kind}: the v16 occlusion breaker lives in py-native (rebuild Rust with the v16 sources to test it)")
    t_start = time.time()
    target = Gui("click", "900x600+80+80", topmost=False, seconds=240)
    ok_n, rows = 0, []
    try:
        await asyncio.sleep(0.8)
        o = await hub.drv_observe(channel="dxgi_vision", max_elements=1)
        tw = next((w for w in o.windows if "DSCU-GROUND-TRUTH-click" in (w.title or "")), None)
        if tw is None:
            return result("v16_occlusion_recovery", "skipped", "ground-truth target window not found")
        cx, cy = tw.rect[0] + tw.rect[2] // 2, tw.rect[1] + tw.rect[3] // 2
        for i in range(trials):
            occ_gui = None
            note = None
            if i % 2 == 0:  # Notepad moved over the target and raised
                note = subprocess.Popen(["notepad.exe"])
                nw = await brain._wait_window(lambda w: any(k in (w.process or "").lower() for k in ("notepad",)) or "记事本" in (w.title or "") or "Notepad" in (w.title or ""), 6.0)
                if nw:
                    ctypes.windll.user32.MoveWindow(ctypes.c_void_p(nw.hwnd), max(0, cx - 300), max(0, cy - 220), 600, 440, True)
                    ctypes.windll.user32.SetForegroundWindow(ctypes.c_void_p(nw.hwnd))
            else:  # always-on-top foreign window
                occ_gui = Gui("occluder", f"700x500+{max(0, cx - 350)}+{max(0, cy - 250)}", topmost=True, seconds=60)
            await asyncio.sleep(0.7)
            before = len([e for e in target.events() if "x" in e])
            res = await hub.drv_action({"action": "click", "x": cx, "y": cy, "expect_hwnd": tw.hwnd, "action_id": new_action_id()})
            await asyncio.sleep(0.15)
            after = len([e for e in target.events() if "x" in e])
            good = bool(res.ok) and after > before
            ok_n += int(good)
            rows.append({"trial": i + 1, "occluder": "notepad" if note else "topmost-gui", "ok": good, "code": res.code.value, "trace": (res.effect or {}).get("occlusion_clear")})
            if occ_gui:
                occ_gui.close()
            try:
                import psutil

                for p in psutil.process_iter(["name", "create_time"]):
                    if (p.info["name"] or "").lower() == "notepad.exe" and p.info["create_time"] >= t_start - 1:
                        p.kill()
            except Exception:  # noqa: BLE001
                pass
            await asyncio.sleep(0.4)
        stats = dict(getattr(hub._native, "occlusion_stats", {})) if getattr(hub, "_native", None) else {}
        return result("v16_occlusion_recovery", "pass" if ok_n == trials else "fail", f"recovered {ok_n}/{trials} (v15 baseline 0/8) stats={stats} rows={rows[:3]}…",
                      recovered=ok_n, trials=trials, rate=round(ok_n / trials, 3))
    finally:
        target.close()


async def s_v161_clean_launch(brain: Any) -> dict[str, Any]:
    """Clean Chrome launch: navigator.webdriver must be exactly `false` and the browser process must NOT carry --enable-automation (otherwise accounts.google.com answers signin/rejected)."""
    hub = brain.hub
    up = await hub.ensure_cdp()
    eng = getattr(hub, "_mcp", None)
    if not up or eng is None:
        return result("v161_clean_launch_webdriver", "skipped", f"chrome-devtools-mcp unavailable ({hub.cdp_error})")
    if not eng.pages:
        await eng.refresh_pages()
    wd = await eng.eval_js("() => navigator.webdriver")
    pid, cmdline = int(eng.attached_browser_pid or 0), ""
    try:
        import psutil

        cmdline = " ".join(psutil.Process(pid).cmdline()) if pid else ""
    except Exception:  # noqa: BLE001
        pass
    no_flag = "--enable-automation" not in cmdline
    good = wd is False and no_flag
    return result("v161_clean_launch_webdriver", "pass" if good else "fail",
                  f"mode={eng.mode} (requested {eng.requested_mode}) webdriver={wd!r} attached={eng.attached_browser_exe}#{pid} scope={eng.scope_mode} enable_automation_in_cmdline={not no_flag} clean_error={eng.clean_error or '-'}",
                  webdriver=wd, attached_pid=pid)


