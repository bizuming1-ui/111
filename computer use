    def fingerprint(self) -> str:
        return hashlib.sha256("\n".join(sorted(self.ids)).encode()).hexdigest()[:16]

    def __contains__(self, sid: str) -> bool:
        return sid in self.ids

    def __len__(self) -> int:
        return len(self.ids)

    @staticmethod
    def from_registry(reg: StableObjectRegistry, epoch: int = 0) -> "AuthorizedTargetSet":
        objs = [o for o in reg.objects.values() if o.is_target]
        exp = next((o.expected_state for o in objs if o.expected_state), "gone")
        return AuthorizedTargetSet(frozenset(o.stable_id for o in objs), "web_row", exp, epoch, "registry", {o.stable_id: o.label for o in objs})


def _rect_contains(r: list[int], x: int, y: int) -> bool:
    return r[0] <= x <= r[0] + r[2] and r[1] <= y <= r[1] + r[3]


def _area(r: list[int]) -> int:
    return max(1, r[2]) * max(1, r[3])


def row_band(group: list[Element]) -> list[int]:
    """Union rectangle of every element that belongs to one list row."""
    x0 = min(e.rect[0] for e in group)
    y0 = min(e.rect[1] for e in group)
    x1 = max(e.rect[0] + e.rect[2] for e in group)
    y1 = max(e.rect[1] + e.rect[3] for e in group)
    return [x0, y0, x1 - x0, y1 - y0]


def resolve_point(reg: StableObjectRegistry, elements: Iterable[Element], x: int, y: int) -> PointResolution:
    """Reverse lookup: which business object (stable_id) does the physical point (x, y) land on?

    Order: (1) smallest Row-zone element containing the point -> that row;  (2) the vertical/horizontal band of a row group;
           (3) smallest non-row control containing the point (Toolbar/Modal/Other) -> `control`;  (4) nothing -> `none` (cannot be confirmed -> caller must deny).
    """
    els = [e for e in elements if e.rect and len(e.rect) == 4 and not e.occluded]
    if getattr(reg, "visual_anchors", None) is None:
        reg.visual_anchors = VisualAnchorRegistry()  # type: ignore[attr-defined]
    reg.visual_anchors.register_from_observation([e for e in els if e.zone != "Row"], reg.step)  # type: ignore[attr-defined]
    reg.observe_rows(els, reg.step)  # refresh row -> stable_id map from the SAME elements we hit-test against
    by_row = reg.last_rows
    hits_row = [e for e in els if e.zone == "Row" and e.row and _rect_contains(e.rect, x, y)]
    if hits_row:
        e = min(hits_row, key=lambda z: _area(z.rect))
        sid = by_row.get(int(e.row), "")
        o = reg.objects.get(sid)
        return PointResolution("row", sid, int(e.row), e, o.label if o else "", "point inside a Row element")
    for row, grp in reg.row_groups(els).items():
        if _rect_contains(row_band(grp), x, y):
            sid = by_row.get(row, "")
            o = reg.objects.get(sid)
            return PointResolution("row", sid, row, None, o.label if o else "", "point inside a row band")
    ctl = [e for e in els if e.zone != "Row" and _rect_contains(e.rect, x, y)]
    if ctl:
        e = min(ctl, key=lambda z: _area(z.rect))
        return PointResolution("control", "", None, e, e.name or e.role, f"point inside control {e.role}")
    tol = 3  # v16.3: DPI-rounding tolerance (<= 3 px) before giving up
    near = [e for e in els if e.zone == "Row" and e.row and _rect_contains([e.rect[0] - tol, e.rect[1] - tol, e.rect[2] + 2 * tol, e.rect[3] + 2 * tol], x, y)]
    if near:
        e = min(near, key=lambda z: _area(z.rect))
        sid = by_row.get(int(e.row), "")
        o = reg.objects.get(sid)
        return PointResolution("row", sid, int(e.row), e, o.label if o else "", f"point within {tol}px of a Row element (DPI rounding tolerance)")
    near_c = [e for e in els if e.zone != "Row" and _rect_contains([e.rect[0] - tol, e.rect[1] - tol, e.rect[2] + 2 * tol, e.rect[3] + 2 * tol], x, y)]
    if near_c:
        e = min(near_c, key=lambda z: _area(z.rect))
        return PointResolution("control", "", None, e, e.name or e.role, f"point within {tol}px of control {e.role} (DPI rounding tolerance)")
    va = getattr(reg, "visual_anchors", None)
    if va is not None:
        a = va.resolve(x, y, getattr(reg, "step", 0))
        if a is not None:
            return PointResolution("control", "", None, None, a.text, f"point inside SoM visual anchor #{a.som_id} text={a.text!r} ({a.zone})")
    return PointResolution("none", reason="point does not land on any observed element")


@dataclass
class VisualAnchor:
    """A SoM-numbered box + the text anchor read from the accessibility name of the SAME observation (never from the model's imagination)."""

    som_id: int
    text: str
    rect: list[int]
    zone: str
    epoch: int
    role: str = ""

    @property
    def stable_id(self) -> str:
        return "va:" + hashlib.sha1(f"{self.role}|{self.text.strip().lower()}|{self.zone}".encode()).hexdigest()[:12]


class VisualAnchorRegistry:
    """v16.3: safe identification for popups / dialogs that must be clicked by coordinates.  Registering needs a non-empty text anchor (>=2 chars) -
    anonymous pixels can never be registered (fail closed).  Hit-testing uses `tol` px so 125%/150% DPI rounding cannot cause false COORD_UNRESOLVED."""

    def __init__(self, ttl_epochs: int = 2, tol: int = 3) -> None:
        self.anchors: list[VisualAnchor] = []
        self.ttl, self.tol = ttl_epochs, tol

    def register_from_observation(self, elements: Iterable[Element], epoch: int) -> int:
        self.anchors = [a for a in self.anchors if epoch - a.epoch <= self.ttl]
        n = 0
        for i, e in enumerate(elements, 1):
            txt = (e.name or "").strip()
            if len(txt) < 2 or not e.rect or len(e.rect) != 4 or e.rect[2] <= 0 or e.rect[3] <= 0:
                continue
            self.anchors.append(VisualAnchor(i, txt[:80], list(e.rect), e.zone, epoch, e.role))
            n += 1
        return n

    def resolve(self, x: int, y: int, epoch: int) -> Optional[VisualAnchor]:
        t = self.tol
        hits = [a for a in self.anchors if epoch - a.epoch <= self.ttl and a.rect[0] - t <= x <= a.rect[0] + a.rect[2] + t and a.rect[1] - t <= y <= a.rect[1] + a.rect[3] + t]
        return min(hits, key=lambda a: _area(a.rect)) if hits else None


def checked_row_ids(reg: StableObjectRegistry, elements: Iterable[Element]) -> set[str]:
    """stable_ids of every row whose checkbox is currently checked (fresh observation)."""
    els = list(elements)
    reg.observe_rows(els, reg.step)
    out: set[str] = set()
    for row, grp in reg.row_groups(els).items():
        if any((e.role.lower() == "checkbox" and "checked" in e.states) or ("selected" in e.states and e.role.lower() in ("listitem", "dataitem", "treeitem")) for e in grp):  # v17: + UIA selected
            sid = reg.last_rows.get(row)
            if sid:
                out.add(sid)
    return out


def lock_selection(reg: StableObjectRegistry, elements: Iterable[Element], segments: list[dict[str, Any]], expected: str = "gone", step: int = 0) -> list[StableObject]:
    """Freeze a COMPOSITE target set from the DOM rows currently observed: [{'from':'head','n':5},{'from':'tail','n':1}] -> first 5 + last 1 (deduplicated).
    GUI-lane equivalent of the Gmail API `first_n + last_n` resolver; the caller must still show the frozen labels to the human (HITL)."""
    if reg.targets_locked:
        return [o for o in reg.objects.values() if o.is_target]
    rows = reg.observe_rows(elements, step)
    if not rows:
        return []
    pick: list[StableObject] = []
    for seg in segments:
        n = int(seg.get("n", 0) or 0)
        chunk = rows[:n] if seg.get("from") == "head" else rows[-n:] if n > 0 else []
        for o in chunk:
            if o not in pick:
                pick.append(o)
    for o in pick:
        o.is_target = True
        o.expected_state = expected
    reg.targets_locked = bool(pick)
    return pick


@dataclass
class FreezeResult:
    ok: bool
    reason: str = ""
    targets: list = field(default_factory=list)
    epoch: int = 0
    rows_seen: int = 0
    truncated: bool = False
    stale: bool = False


def freeze_same_epoch(reg: StableObjectRegistry, elements: Iterable[Element], segments: list[dict[str, Any]], expected: str = "gone", step: int = 0, *, epoch: int = 0,
                      channel: str = "cdp", url: str = "", url_must_contain: str = "", cap: int = 250) -> FreezeResult:
    """v17.1: list extraction + target freeze happen on ONE snapshot (`epoch`).  Refuses (never freezes an empty / stale / truncated set):
       - empty element list or no rows rendered yet               -> not ok (retry on the next observation)
       - URL does not belong to the expected site (page not yet refreshed to the real DOM) -> stale
       - a `tail` segment on a snapshot that hit the element cap   -> truncated (the real last rows are NOT in this snapshot): caller must take an extended snapshot
       - head+tail would overlap (fewer rows than head+tail)       -> ambiguous
    Row identity is state-stripped (norm_row_text) so ticking the checkbox afterwards cannot change the stable_id."""
    els = list(elements)
    if reg.targets_locked:
        t = [o for o in reg.objects.values() if o.is_target]
        return FreezeResult(True, "already frozen", t, getattr(reg, "freeze_epoch", epoch), len(reg.last_rows))
    if url_must_contain and url_must_contain not in (url or ""):
        return FreezeResult(False, f"页面 URL 尚未到达 {url_must_contain}（当前 {url[:50] or '空'}），DOM 还没有刷新 → 不冻结旧集", stale=True)
    if not els:
        return FreezeResult(False, "快照没有任何控件（页面仍在加载）→ 不冻结空集", epoch=epoch)
    rows = reg.observe_rows(els, step)
    if not rows:
        return FreezeResult(False, "快照里还没有列表行（DOM 未渲染完）→ 不冻结空集", epoch=epoch)
    truncated = len(els) >= int(cap * 0.96)
    segs = [(str(s.get("from")), int(s.get("n", 0) or 0)) for s in segments]
    need_tail = any(f == "tail" and n > 0 for f, n in segs)
    total = sum(n for _, n in segs)
    if need_tail and truncated:
        return FreezeResult(False, f"快照触达 {cap} 控件上限，只含前 {len(rows)} 行，真正的最后几行不在本快照内 → 需要扩展快照后在同一 epoch 内冻结", epoch=epoch, rows_seen=len(rows), truncated=True)
    if need_tail and len(rows) < total:
        return FreezeResult(False, f"列表只有 {len(rows)} 行，少于 前+后 共 {total} 行，头尾会重叠，含义不明确 → 请用户澄清", epoch=epoch, rows_seen=len(rows))
    pick: list[StableObject] = []
    for f, n in segs:
        chunk = rows[:n] if f == "head" else (rows[-n:] if n > 0 else [])
        for o in chunk:
            if o not in pick:
                pick.append(o)
    for o in pick:
        o.is_target = True
        o.expected_state = expected
    reg.targets_locked = bool(pick)
    reg.freeze_epoch = epoch  # type: ignore[attr-defined]
    return FreezeResult(bool(pick), "ok" if pick else "没有可冻结的目标", pick, epoch, len(rows), truncated)

