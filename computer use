            user32.GetWindowRect(h, ctypes.byref(r))
            best.append(((r.right - r.left) * (r.bottom - r.top), int(h), (r.left, r.top, r.right - r.left, r.bottom - r.top)))
        return 1

    try:
        user32.EnumWindows(EnumProc(top_cb), 0)
    except Exception:  # noqa: BLE001
        return None
    if not best:
        return None
    best.sort(key=lambda t: -t[0])
    _, hwnd, wrect = best[0]
    found: list[int] = []

    def child_cb(h: Any, _lp: Any) -> int:
        if cls_of(h) == "Chrome_RenderWidgetHostHWND" and user32.IsWindowVisible(h):
            found.append(int(h))
            return 0
        return 1

    try:
        user32.EnumChildWindows(hwnd, EnumProc(child_cb), 0)
    except Exception:  # noqa: BLE001
        return None
    if not found:
        return None
    pt = wintypes.POINT(0, 0)
    if not user32.ClientToScreen(found[0], ctypes.byref(pt)):
        return None
    return (int(pt.x), int(pt.y)), wrect


