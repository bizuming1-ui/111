        many = [{"box": [i, 0, 5, 5], "text": f"t{i}"} for i in range(12)]
        self.assertFalse(D.ambiguity(many)[0])
        self.assertTrue(D.ambiguity([{"box": [i, 0, 5, 5], "text": ""} for i in range(12)])[0])

