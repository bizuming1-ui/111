class TokenStore:
    """Encrypted-at-rest OAuth token file.  Never writes plaintext.  Legacy plaintext JSON is migrated (encrypted copy first, then overwrite+delete)."""

    def __init__(self, path: Optional[Path] = None, protector: Any = None) -> None:
        self.path = Path(path) if path else default_token_path()
        self.protector = protector if protector is not None else DpapiProtector()
        self.legacy_path = self.path.with_name("gmail_token.json")
        self.migrated = False

    def exists(self) -> bool:
        return self.path.exists() or self.legacy_path.exists()

    def save(self, tok: dict[str, Any]) -> None:
        blob = self.protector.protect(json.dumps(tok, ensure_ascii=False).encode("utf-8"))
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_bytes(DPAPI_MAGIC + blob)
        os.replace(tmp, self.path)

    def load(self) -> dict[str, Any]:
        if self.path.exists():
            raw = self.path.read_bytes()
            if not raw.startswith(DPAPI_MAGIC):
                raise GmailAuthError(f"{self.path} 不是 DPAPI 加密格式（拒绝读取疑似明文文件）；请运行 gmail-auth 重新授权")
            return json.loads(self.protector.unprotect(raw[len(DPAPI_MAGIC):]).decode("utf-8"))
        if self.legacy_path.exists():
            return self.migrate_legacy()
        return {}

    def migrate_legacy(self) -> dict[str, Any]:
        tok = json.loads(self.legacy_path.read_text(encoding="utf-8"))
        self.save(tok)
        self.secure_delete(self.legacy_path)
        self.migrated = True
        return tok

    @staticmethod
    def secure_delete(p: Path) -> None:
        try:
            n = p.stat().st_size
            with open(p, "r+b") as f:
                f.write(b"\x00" * n)
                f.flush()
                os.fsync(f.fileno())
        except OSError:
            pass
        try:
            p.unlink()
        except OSError:
            pass

    def wipe(self) -> None:
        for p in (self.path, self.legacy_path):
            if p.exists():
                self.secure_delete(p)

    def plaintext_on_disk(self) -> bool:
        """Audit helper: True if any file in the token directory contains a recognisable secret in clear text."""
        for p in (self.path, self.legacy_path, self.path.with_suffix(".tmp")):
            if p.exists():
                b = p.read_bytes()
                if b"refresh_token" in b or b"access_token" in b or b"client_secret" in b:
                    return True
        return False


