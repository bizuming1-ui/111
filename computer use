import fnmatch
import hashlib
import os
import re
import tempfile
from dataclasses import dataclass
from pathlib import Path

from .security import INTENT_FOLDERS, SecurityPolicy

_APP = re.compile(r"(记事本|notepad|文本文档|文本文件|\.txt|txt)", re.I)
_CONTENT = re.compile(r"(?:输入|写入|写上|写下|内容(?:是|为)?)[:：]?\s*(?P<c>.+?)\s*[，,。；;]?\s*"
                      r"(?=(?:并|然后|再)?(?:命名|名为|取名|文件名|叫做?|另存|保存|存(?:在|到|于|放)|放(?:在|到)|$))", re.S)
_NAME = re.compile(r"(?:命名为|名为|取名为?|文件名(?:为|是)?|叫做?)\s*(?P<n>.+?)\s*"
                   r"(?=[，,。；;]|(?:并|然后|再)?(?:保存|存(?:在|到|于|放)|放(?:在|到))|$)", re.S)
_FOLDER = re.compile(r"(?:保存|存|放)(?:在|到|于)?\s*(?:我的)?\s*(?P<f>桌面|文档|下载|图片|音乐|视频|desktop|documents|downloads)", re.I)
_FOLDER_KEY = {w.lower(): k for k, ws in INTENT_FOLDERS.items() for w in ws}
_BAD = re.compile(r'[<>:"/\\|?*\x00-\x1f]')


@dataclass
class SaveTextIntent:
    content: str
    name: str
    folder_key: str
    open_in_notepad: bool = True


def _strip_quotes(s: str) -> str:
    return s.strip().strip("\"'“”‘’「」『』《》").strip()


def parse_save_text_intent(task: str) -> SaveTextIntent | None:
    if not _APP.search(task):
        return None
    fm, nm, cm = _FOLDER.search(task), _NAME.search(task), _CONTENT.search(task)
    if not (fm and nm):
        return None
    key = _FOLDER_KEY.get(fm.group("f").lower())
    if not key:
        return None
    content = _strip_quotes(cm.group("c")) if cm else ""
    return SaveTextIntent(content, _strip_quotes(nm.group("n")), key)


def sanitize_filename(name: str, default_ext: str = ".txt") -> str:
    n = _BAD.sub("_", name).strip().rstrip(". ")
    if not n:
        n = "untitled"
    if not Path(n).suffix:
        n += default_ext
    return n


def save_text(policy: SecurityPolicy, folder: str, name: str, content: str, *, on_exists: str = "rename") -> dict:
    """Atomic UTF-8 (no BOM) write + byte-exact read-back.  on_exists: rename | overwrite | fail."""
    fname = sanitize_filename(name)
    target = policy.check(str(Path(folder) / fname), "write")
    target.parent.mkdir(parents=True, exist_ok=True)
    renamed = False
    if target.exists():
        if on_exists == "fail":
            raise FileExistsError(str(target))
        if on_exists == "rename":
            stem, ext, i = target.stem, target.suffix, 2
            while target.exists():
                target = policy.check(str(target.with_name(f"{stem} ({i}){ext}")), "write"); i += 1
            renamed = True
    data = content.encode("utf-8")
    fd, tmp = tempfile.mkstemp(dir=target.parent, prefix=".dscu-", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data); f.flush(); os.fsync(f.fileno())
        os.replace(tmp, target)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    back = target.read_bytes()
    ok = back == data
    return {"ok": ok, "path": str(target), "bytes": len(back), "chars": len(content),
            "sha256": hashlib.sha256(back).hexdigest()[:16], "renamed": renamed}


def verify_text_file(path: str, expect_text: str | None = None) -> dict:
    p = Path(path)
    if not p.is_file():
        return {"ok": False, "exists": False, "path": path}
    raw = p.read_bytes()
    enc = "utf-8-sig" if raw.startswith(b"\xef\xbb\xbf") else "utf-16" if raw[:2] in (b"\xff\xfe", b"\xfe\xff") else "utf-8"
    try:
        text = raw.decode(enc)
    except UnicodeDecodeError:
        text = raw.decode("gbk", "replace"); enc = "gbk?"
    return {"ok": expect_text is None or expect_text in text, "exists": True, "path": path, "bytes": len(raw),
            "encoding": enc, "contains": None if expect_text is None else expect_text in text}


def locate_file(policy: SecurityPolicy, name: str, *, max_depth: int = 2, limit: int = 20) -> list[dict]:
    """Where did the GUI really save it?  Searches workspace + granted roots (never anything else)."""
    stem, ext = Path(name).stem, Path(name).suffix
    pats = {name, f"{stem}.*", f"{stem} (*){ext}"}
    roots = [policy.workspace, *policy.grant_roots()]
    out: list[dict] = []
    for root in roots:
        base_depth = Path(root).as_posix().count("/")
        for dp, dn, fn in os.walk(root):
            if Path(dp).as_posix().count("/") - base_depth >= max_depth:
                dn[:] = []
            for f in fn:
                if any(fnmatch.fnmatch(f.lower(), p.lower()) for p in pats):
                    fp = Path(dp) / f
                    try:
                        st = fp.stat(); out.append({"path": str(fp), "bytes": st.st_size, "mtime": int(st.st_mtime)})
                    except OSError:
                        continue
                    if len(out) >= limit:
                        return sorted(out, key=lambda r: -r["mtime"])
    return sorted(out, key=lambda r: -r["mtime"])
