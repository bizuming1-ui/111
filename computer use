    inbox_ids = {GS.row_business_identity(r) for r in gui.rows}
    trash_ids = {GS.row_business_identity(r) for r in gui.trash}
    all_ids = [GS.row_business_identity(r) for r in (gui.rows + gui.trash)]
    want = set(all_ids[:f] + (all_ids[len(all_ids) - b:] if b else []))  # rows are removed from `rows`, so rebuild the original order
    orig = [GS.row_business_identity({"thread_id": f"#thread-f:18{7000000000000000 + i * 7919}"}) for i in range(35)]
