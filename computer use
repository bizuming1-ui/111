    public string[] Batch(string[] methods, string[] paramsJson, int timeoutMs) {
        int n = methods.Length; var tasks = new Task<string>[n]; var res = new string[n];
        for (int i = 0; i < n; i++) { try { tasks[i] = Post(methods[i], paramsJson[i]); } catch { tasks[i] = null; } }
        long end = Environment.TickCount64 + timeoutMs;
        for (int i = 0; i < n; i++) {
            if (tasks[i] == null) continue;
            long left = Math.Max(1, end - Environment.TickCount64);
            try { if (tasks[i].Wait((int)Math.Min(left, int.MaxValue))) { string m = tasks[i].Result; if (ErrorOf(m) == null) res[i] = m; } } catch { }
        }
        return res;
    }
