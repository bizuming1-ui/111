ARTIFACT_KEYS = re.compile(r"output|path|file|artifact|export|result_path|saved", re.I)
APP_HINTS = {"gimp": "gimp", "blender": "blender", "inkscape": "inkscape", "audacity": "audacity", "libreoffice": "libreoffice", "drawio": "drawio", "draw.io": "drawio",
             "obs": "obs-studio", "kdenlive": "kdenlive", "shotcut": "shotcut", "mermaid": "mermaid", "zotero": "zotero", "joplin": "joplin", "calibre": "calibre",
             "comfyui": "comfyui", "ollama": "ollama", "godot": "godot", "musescore": "musescore", "qgis": "qgis", "browser": "browser"}
_cache: dict[str, "ToolInfo"] = {}


@dataclass
class ToolInfo:
    name: str  # e.g. gimp
    exe: str  # absolute path
    cmd: str  # cli-anything-gimp


@dataclass
class CliResult:
    ok: bool
    tool: str
    returncode: int = 0
    data: Any = None
    artifacts: list[dict[str, Any]] = field(default_factory=list)
    problems: list[str] = field(default_factory=list)
    tail: str = ""

    def render(self) -> str:
        a = "；".join(f"{'✓' if x['ok'] else '✗'}{Path(x['path']).name}({x['detail']})" for x in self.artifacts) or "无产物字段"
        p = ("；问题：" + " | ".join(self.problems)) if self.problems else ""
        return f"[{'OK' if self.ok else 'FAIL'}] {self.tool} rc={self.returncode} 产物：{a}{p}\n{self.tail[:900]}"


def discover(refresh: bool = False) -> dict[str, ToolInfo]:
    if _cache and not refresh:
        return dict(_cache)
    _cache.clear()
    exts = (".exe", ".cmd", ".bat", "") if sys.platform == "win32" else ("",)
    for d in (os.environ.get("PATH", "")).split(os.pathsep):
        if not d:
            continue
        try:
            for f in os.scandir(d):
                n = f.name
                low = n.lower()
                stem = low
                for e in exts:
                    if e and low.endswith(e):
                        stem = low[: -len(e)]
                        break
                if stem.startswith(PREFIX) and stem[len(PREFIX):] and stem not in {t.cmd for t in _cache.values()}:
                    _cache[stem[len(PREFIX):]] = ToolInfo(stem[len(PREFIX):], f.path, stem)
        except OSError:
            continue
    hub = shutil.which("cli-hub")
    if hub:
        _cache["hub"] = ToolInfo("hub", hub, "cli-hub")
    return dict(_cache)


def match_for_task(task: str, tools: Optional[dict[str, ToolInfo]] = None) -> Optional[ToolInfo]:
    tools = tools if tools is not None else discover()
    low = task.lower()
    for kw, tool in APP_HINTS.items():
        if kw in low and tool in tools:
            return tools[tool]
    return None


def _resolve(tool: str) -> Optional[ToolInfo]:
    t = discover()
    key = tool.lower().removeprefix(PREFIX)
    if key in t:
        return t[key]
    if SAFE_NAME.match(tool) and shutil.which(tool):
        return ToolInfo(key, shutil.which(tool) or tool, tool)
    return None


def help_text(tool: str, timeout: int = 20) -> str:
    ti = _resolve(tool)
    if not ti:
        return ""
    try:
        p = subprocess.run([ti.exe, "--help"], capture_output=True, timeout=timeout, text=True, encoding="utf-8", errors="replace")
        return (p.stdout or p.stderr or "").strip()
    except Exception as e:  # noqa: BLE001
        return f"[help failed] {e}"


def _extract_json(text: str) -> Any:
    text = text.strip()
    if not text:
        raise ValueError("empty stdout")
    try:
        return json.loads(text)
    except ValueError:
        pass
    for m in re.finditer(r"[\[{]", text):  # first decodable JSON value anywhere in the output
        try:
            obj, _ = json.JSONDecoder().raw_decode(text[m.start():])
            return obj
        except ValueError:
            continue
    raise ValueError("no JSON value in stdout")


def _walk_paths(obj: Any, key: str = "") -> list[str]:
    out: list[str] = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            out += _walk_paths(v, str(k))
    elif isinstance(obj, list):
        for v in obj:
            out += _walk_paths(v, key)
    elif isinstance(obj, str) and (ARTIFACT_KEYS.search(key) or re.match(r"^[A-Za-z]:\\|^/", obj)) and re.search(r"\.[A-Za-z0-9]{1,6}$", obj) and len(obj) < 400:
        out.append(obj)
    return out


def run_json(tool: str, args: str = "", timeout: int = 120) -> CliResult:
    ti = _resolve(tool)
    if not ti or not SAFE_NAME.match(ti.cmd):
        return CliResult(False, tool, -1, problems=[f"未发现 CLI-Anything 工具 {tool!r}（pip install cli-anything-{tool.removeprefix(PREFIX)} 或 cli-hub install {tool}）"])
    try:
        argv = shlex.split(args, posix=(sys.platform != "win32"))
    except ValueError as e:
        return CliResult(False, ti.cmd, -1, problems=[f"参数解析失败: {e}"])
    if "--json" not in argv:
        argv.append("--json")
    try:
        p = subprocess.run([ti.exe, *argv], capture_output=True, timeout=timeout, text=True, encoding="utf-8", errors="replace", stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return CliResult(False, ti.cmd, -2, problems=[f"超时 {timeout}s"])
    except OSError as e:
        return CliResult(False, ti.cmd, -1, problems=[f"启动失败: {e}"])
    res = CliResult(p.returncode == 0, ti.cmd, p.returncode, tail=(p.stdout or p.stderr or "")[-1200:])
    try:
        res.data = _extract_json(p.stdout or "")
    except ValueError as e:
        res.ok = False
        res.problems.append(f"--json 输出无法解析: {e}")
        return res
    if isinstance(res.data, dict):
        if res.data.get("success") is False or res.data.get("ok") is False or res.data.get("error"):
            res.ok = False
            res.problems.append(f"工具自报失败: {str(res.data.get('error') or res.data.get('message') or '')[:160]}")
    from .verifier import IndependentVerifier

    for path in dict.fromkeys(_walk_paths(res.data)):
        pp = Path(path)
        if not pp.is_absolute():
            continue
        if not pp.exists():
            if ARTIFACT_KEYS.search("output"):  # only paths in artifact-ish fields count as claimed outputs
                res.artifacts.append({"path": path, "ok": False, "detail": "文件不存在"})
            continue
        checks = IndependentVerifier.check_file(pp)
        bad = [c for c in checks if not c.ok]
        res.artifacts.append({"path": path, "ok": not bad, "detail": ("; ".join(c.name for c in bad) or f"{pp.stat().st_size} 字节")})
    if any(not a["ok"] for a in res.artifacts):
        res.ok = False
        res.problems.append("JSON 声称的产物未通过磁盘校验")
    return res
