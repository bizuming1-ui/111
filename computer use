//! `app.resolve` — trusted READ-ONLY application discovery primitive (zero [SECURITY_AST_VIOLATION] surface).
//! Sources: registry App Paths / Uninstall, Start-Menu .lnk (IShellLinkW), MSIX/UWP AUMID, running-process image paths.
//! Ranking is bit-compatible with agent_brain/app_resolver.py and PowerShell `Get-V12AppMatchScore` (golden-fixture checked).
use serde::{Deserialize, Serialize};
use serde_json::{json, Value};

#[derive(Clone, Debug, Default, Serialize, Deserialize, PartialEq)]
pub struct Entry { pub name: String, pub source: String, #[serde(default)] pub exe: String, #[serde(default)] pub aumid: String, #[serde(default)] pub desc: String }

fn norm(s: &str) -> String {
    let l = s.to_lowercase();
    let l = l.strip_suffix(".exe").unwrap_or(&l);
    l.chars().filter(|c| !c.is_whitespace() && !matches!(c, '_' | '-' | '.')).collect()
}

fn priority(src: &str) -> f64 { match src { "process" => 5.0, "aumid" => 4.0, "startmenu" | "apppaths" => 3.0, "uninstall" => 2.0, _ => 0.0 } }

pub fn match_score(query: &str, e: &Entry) -> f64 {
    let q = norm(query);
    if q.is_empty() { return 0.0; }
    let base = e.exe.replace('\\', "/").rsplit('/').next().unwrap_or("").to_string();
    let tok = if e.aumid.is_empty() { String::new() } else { e.aumid.split('!').next().unwrap_or("").split('_').next().unwrap_or("").rsplit('.').next().unwrap_or("").to_string() };
    let fields = [norm(&e.name), norm(if e.exe.is_empty() { "" } else { &base }), norm(&e.desc), norm(&tok)];
    let mut best = 0.0f64;
    for (i, f) in fields.iter().enumerate() {
        if f.is_empty() { continue; }
        let flen = f.chars().count();
        if *f == q { best = best.max(if i == 0 { 100.0 } else { 95.0 }); }
        else if f.starts_with(&q) || (q.starts_with(f.as_str()) && flen >= 3) { best = best.max(70.0); }
        else if f.contains(&q) || (flen >= 3 && q.contains(f.as_str())) { best = best.max(50.0); }
    }
    if best == 0.0 { return 0.0; }
    best + priority(&e.source) * 0.5 + if !e.exe.is_empty() && !e.aumid.is_empty() { 2.0 } else { 0.0 }
}

pub fn rank(query: &str, entries: &[Entry], top: usize) -> Vec<(Entry, f64)> {
    let mut sc: Vec<(Entry, f64)> = entries.iter().map(|e| (e.clone(), match_score(query, e))).filter(|x| x.1 > 0.0).collect();
    sc.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));
    let mut seen = std::collections::HashSet::new();
    sc.into_iter().filter(|(e, _)| seen.insert(if e.exe.is_empty() { e.aumid.to_lowercase() } else { e.exe.to_lowercase() })).take(top).collect()
}

pub fn hits_json(hits: &[(Entry, f64)]) -> Value {
    json!(hits.iter().map(|(e, s)| json!({"name": e.name, "source": e.source, "exe": e.exe, "aumid": e.aumid, "score": (s * 100.0).round() / 100.0})).collect::<Vec<_>>())
}

/// Pipe command: {"cmd":"app.resolve","query":"微信","top":5}
pub fn handle(v: &Value) -> Value {
    let q = v["query"].as_str().unwrap_or("");
    if q.is_empty() { return json!({"ok": false, "error": "query required", "code": "UNSUPPORTED"}); }
    let top = v["top"].as_u64().unwrap_or(5) as usize;
    let idx = index();
    let hits = rank(q, &idx, top);
    if hits.is_empty() { return json!({"ok": false, "code": "APP_NOT_FOUND", "indexed": idx.len()}); }
    json!({"ok": true, "indexed": idx.len(), "hits": hits_json(&hits)})
}

