        return single, grp, ev, header_titles(lines, self.geo)

    async def _search_contact(self, recipient: str) -> tuple:
        """evidence-gated search: each strategy gets ONE shot; if the result list shows no NEW text after the keystrokes, the strategy is closed immediately."""
        assert self.geo is not None and self.cal is not None
        g = self.geo
        strategies = [("click_search_box", None), ("ctrl_f", None)]
        why_all = []
        for name, _ in strategies:
            lines0, _p0 = await self._lines(g.list_rect)
            d0 = self._digest(lines0)
            if name == "click_search_box":
                await self._click(*self.cal.search_xy)
                await self.io.sleep(0.25)
            else:
                await self.io.key("ctrl+f")
                await self.io.sleep(0.35)
            await self.io.key("ctrl+a")
            await self.io.clipboard_set(recipient)
            await self.io.key("ctrl+v")
            cand, sec, why, p = None, "", "", {}
            for i in range(5):
                await self.io.sleep(self.poll + (0.15 if i == 0 else 0.0))
                lines, p = await self._lines(g.list_rect)
                cand, sec, why = ms.pick_contact(lines, recipient, g)
                if cand is not None or why.startswith(("AMBIGUOUS", "「")):
                    break
                if i == 1 and self._digest(lines) == d0:  # 2 polls (~1.3 s) and the list never changed: the keystrokes produced NO new evidence
                    self.no_evidence_stops += 1
                    why = f"{name}: 搜索列表在输入后没有出现任何新文字（WorldStateDiff=∅）→ 关闭该路径"
                    break
            why_all.append(f"{name}: {why}")
            if cand is not None:
                return cand, sec, why, p, name
            if why.startswith(("AMBIGUOUS", "「")):
                break  # semantic refusal, not a perception miss: another strategy cannot fix it
            await self.io.key("escape")
            await self.io.sleep(0.2)
        return None, "", " ｜ ".join(why_all), {}, ""

    async def _write_draft(self, body: str) -> tuple:
        assert self.cal is not None
        t0 = time.perf_counter()
        ix, iy = self.cal.input_xy
        await self._click(ix, iy)
        await self.io.sleep(0.15)
        await self.io.key("ctrl+a")
        await self.io.key("delete")
        await self.io.sleep(0.1)
        await self.io.clipboard_set(body)
        await self.io.key("ctrl+v")
        await self.io.sleep(0.35)
        readback, source = await self._readback(body)
        ok = bool(readback) and ms.cj(readback) == ms.cj(body)
        if not ok:  # alternate method once: per-key typing
            self._log(f"⚠ 草稿读回「{readback[:30]}」≠ 正文 → 改用逐字输入一次")
            await self.io.key("ctrl+a")
            await self.io.key("delete")
            await self.io.type_text(body)
            await self.io.sleep(0.35)
            readback, source = await self._readback(body)
            ok = bool(readback) and ms.cj(readback) == ms.cj(body)
