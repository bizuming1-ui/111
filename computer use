#=#=# FILE: scripts/etw-leak-audit.ps1
#Requires -Version 7.0
<#
.SYNOPSIS  ETW / WPR leak audit: drives the dscu-driver with high-frequency capture + UIA traversal for N minutes (default 30) while WPR records an ETL
           (GeneralProfile + Handle), samples the driver's handle / GDI / USER / private-bytes every 10 s and proves a flat slope (zero leak).
.EXAMPLE   pwsh scripts/etw-leak-audit.ps1 -Minutes 30          # full audit (needs an elevated shell for WPR; sampling works unelevated)
           pwsh scripts/etw-leak-audit.ps1 -Seconds 60 -NoWpr   # quick smoke
#>
[CmdletBinding()]
param([int]$Minutes = 30, [int]$Seconds = 0, [string]$ProcessName = 'dscu-driver', [string]$Pipe = 'dscu-driver-v1', [string]$OutDir = (Join-Path $env:TEMP 'dscu-leak-audit'), [switch]$NoWpr, [double]$HandleSlopePerMin = 0.5, [double]$PrivateMBSlopePerMin = 1.0)

function Get-Slope([double[]]$t, [double[]]$y) {   # least squares slope (units per minute), t in minutes
    $n = $t.Count; if ($n -lt 3) { return 0.0 }
    $mt = ($t | Measure-Object -Average).Average; $my = ($y | Measure-Object -Average).Average
    $num = 0.0; $den = 0.0; for ($i = 0; $i -lt $n; $i++) { $num += ($t[$i] - $mt) * ($y[$i] - $my); $den += [Math]::Pow($t[$i] - $mt, 2) }
    if ($den -eq 0) { return 0.0 }; return $num / $den
}
function Get-LeakVerdict($Samples, [double]$HandleSlopeMax = 0.5, [double]$PrivMBSlopeMax = 1.0) {
    # discard the first 20% as warm-up (JIT, caches, ring allocation), judge the steady state
    $skip = [int][Math]::Floor($Samples.Count * 0.2); $s = @($Samples | Select-Object -Skip $skip)
    $t = [double[]]@($s | ForEach-Object { $_.Min })
    $hs = Get-Slope $t ([double[]]@($s | ForEach-Object { $_.Handles })); $gs = Get-Slope $t ([double[]]@($s | ForEach-Object { $_.Gdi }))
    $us = Get-Slope $t ([double[]]@($s | ForEach-Object { $_.User })); $ps = Get-Slope $t ([double[]]@($s | ForEach-Object { $_.PrivateMB }))
    $dh = if ($s.Count) { $s[-1].Handles - $s[0].Handles } else { 0 }
    $ok = ($hs -le $HandleSlopeMax) -and ($gs -le 0.1) -and ($us -le 0.1) -and ($ps -le $PrivMBSlopeMax) -and ($dh -le 16)
    [pscustomobject]@{ Pass = $ok; HandleSlopePerMin = [Math]::Round($hs, 4); GdiSlopePerMin = [Math]::Round($gs, 4); UserSlopePerMin = [Math]::Round($us, 4); PrivateMBSlopePerMin = [Math]::Round($ps, 4); HandleDelta = $dh; SamplesJudged = $s.Count }
}
if ($MyInvocation.InvocationName -eq '.') { return }   # dot-sourced by tests: expose Get-LeakVerdict only

Add-Type -Namespace Dscu -Name Gui -MemberDefinition '[System.Runtime.InteropServices.DllImport("user32.dll")] public static extern uint GetGuiResources(System.IntPtr h, uint flags);'
[void][System.IO.Directory]::CreateDirectory($OutDir)
$total = if ($Seconds -gt 0) { $Seconds } else { $Minutes * 60 }
$etl = Join-Path $OutDir ("dscu-{0:yyyyMMdd-HHmmss}.etl" -f (Get-Date)); $wpr = $false
if (-not $NoWpr) { try { & wpr.exe -start GeneralProfile -start Handle -filemode 2>&1 | Out-Null; $wpr = ($LASTEXITCODE -eq 0); if (-not $wpr) { Write-Warning 'WPR did not start (needs an elevated shell): sampling continues without ETL.' } } catch { Write-Warning "WPR unavailable: $($_.Exception.Message)" } }
function Send-Rpc($pipe, [string]$method, $params, $tok) {
    $req = @{ jsonrpc = '2.0'; v = 1; id = [int](Get-Random); method = $method; params = $params }; if ($tok) { $req.auth = $tok }
    $pipe.WriteLine(($req | ConvertTo-Json -Compress -Depth 6)); $pipe.Flush(); return $pipe.ReadLine()
}
$tokFile = Join-Path $env:LOCALAPPDATA 'DeepSeekComputerUse\driver.token'; $tok = if (Test-Path $tokFile) { (Get-Content -Raw $tokFile).Trim() } else { $null }
$client = [System.IO.Pipes.NamedPipeClientStream]::new('.', $Pipe, [System.IO.Pipes.PipeDirection]::InOut)
try { $client.Connect(3000) } catch { throw "dscu-driver is not running on \\.\pipe\$Pipe (start it with: driver start)." }
$sw = [System.IO.StreamWriter]::new($client); $sr = [System.IO.StreamReader]::new($client); $sw.AutoFlush = $false
$samples = [System.Collections.Generic.List[object]]::new(); $t0 = Get-Date; $next = $t0; $calls = 0; $errs = 0
Write-Host "Leak audit: $total s, process=$ProcessName, ETL=$(if ($wpr) { $etl } else { 'off' })" -ForegroundColor Cyan
while (((Get-Date) - $t0).TotalSeconds -lt $total) {
    foreach ($m in @(@('capture.frame', @{ x = 0; y = 0; w = 1280; h = 720 }), @('capture.signature', @{ x = 0; y = 0; w = 1280; h = 720 }), @('uia.snapshot', @{ skeleton = $true }), @('window.foreground', @{}))) {
        try { $r = Send-Rpc $sw $m[0] $m[1] $tok; $calls++; if ($r -match '"error"' -and $r -notmatch 'NOT_FOUND|OUT_OF_BOUNDS|MEMORY_FLOOR') { $errs++ } } catch { $errs++ }
    }
    if ((Get-Date) -ge $next) {
        $p = Get-Process -Name $ProcessName -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($p) { $samples.Add([pscustomobject]@{ Min = ((Get-Date) - $t0).TotalMinutes; Handles = $p.HandleCount; Gdi = [Dscu.Gui]::GetGuiResources($p.Handle, 0); User = [Dscu.Gui]::GetGuiResources($p.Handle, 1); PrivateMB = [Math]::Round($p.PrivateMemorySize64 / 1MB, 2) }) }
        $next = $next.AddSeconds(10)
    }
    Start-Sleep -Milliseconds 60
}
$client.Dispose()
if ($wpr) { & wpr.exe -stop $etl 2>&1 | Out-Null; Write-Host "ETL: $etl  (open in WPA: Handles / GDI / VirtualAlloc graphs should be flat)" -ForegroundColor DarkGray }
$v = Get-LeakVerdict $samples.ToArray() $HandleSlopePerMin $PrivateMBSlopePerMin
$report = [ordered]@{ schema = 'dscu.leak-audit/1'; seconds = $total; rpc_calls = $calls; rpc_errors = $errs; etl = $(if ($wpr) { $etl } else { $null }); first = $samples | Select-Object -First 1; last = $samples | Select-Object -Last 1; verdict = $v }
($report | ConvertTo-Json -Depth 6) | Set-Content -LiteralPath (Join-Path $OutDir 'leak-audit.json') -Encoding utf8
Write-Host ("LEAK AUDIT {0}: handle slope {1}/min, GDI {2}/min, USER {3}/min, private {4} MB/min, delta handles {5} ({6} samples, {7} RPCs)" -f $(if ($v.Pass) { 'PASS' } else { 'FAIL' }), $v.HandleSlopePerMin, $v.GdiSlopePerMin, $v.UserSlopePerMin, $v.PrivateMBSlopePerMin, $v.HandleDelta, $v.SamplesJudged, $calls) -ForegroundColor $(if ($v.Pass) { 'Green' } else { 'Red' })
exit $(if ($v.Pass) { 0 } else { 1 })
#=#=# FILE: scripts/verify-phase7.ps1
#Requires -Version 7.0
<#
.SYNOPSIS  DeepSeek Computer Use v9.0 Phase 7 — one-command verification of the polyglot monorepo (each toolchain is optional: missing => SKIP, never a false PASS).
  Runs: golden regeneration check (python) | cargo test + criterion + cargo-fuzz smoke (rust) | cmake + ctest (c++) | node tests + tsc (ts) | pytest (python).
  Exit code 0 = no FAIL.
#>
[CmdletBinding()]
param([string]$Root = (Split-Path -Parent $PSScriptRoot), [switch]$Bench, [switch]$Fuzz, [int]$FuzzRuns = 1000000)
$ErrorActionPreference = 'Continue'
$rows = [System.Collections.Generic.List[object]]::new()
function Rec([string]$Name, [string]$Status, [string]$Detail = '') { $rows.Add([pscustomobject]@{ Name = $Name; Status = $Status; Detail = $Detail }); $c = @{ PASS = 'Green'; FAIL = 'Red'; SKIP = 'DarkYellow' }[$Status]; Write-Host ("  [{0}] {1}  {2}" -f $Status, $Name, $Detail) -ForegroundColor $c }
function Has([string]$n) { [bool](Get-Command $n -ErrorAction SilentlyContinue) }
function Run([string]$Name, [string]$Dir, [scriptblock]$Cmd) {
    Push-Location $Dir
    try { $out = & $Cmd 2>&1 | Out-String; if ($LASTEXITCODE -eq 0) { Rec $Name 'PASS' (($out -split "`n" | Where-Object { $_ -match 'test result|passed|pass |failures=|ok\b' } | Select-Object -Last 1).Trim()) } else { Rec $Name 'FAIL' (($out -split "`n" | Select-Object -Last 6) -join ' | ') } }
    catch { Rec $Name 'FAIL' $_.Exception.Message } finally { Pop-Location }
}
Write-Host "v9.0 Phase 7 verification  root=$Root" -ForegroundColor Cyan
$py = if (Has 'python') { 'python' } elseif (Has 'python3') { 'python3' } else { $null }
if ($py) {
    $before = (Get-FileHash -LiteralPath (Join-Path $Root 'golden\contracts.v9.golden.json') -Algorithm SHA256).Hash
    Push-Location $Root; & $py tools/gen_golden.py | Out-Null; Pop-Location
    $after = (Get-FileHash -LiteralPath (Join-Path $Root 'golden\contracts.v9.golden.json') -Algorithm SHA256).Hash
    Rec 'golden fixture is reproducible from the independent Python reference' $(if ($before -eq $after) { 'PASS' } else { 'FAIL' }) "sha256=$($after.Substring(0, 16))"
    Run 'pytest orchestrator (state machine / locks / OTLP / UMA hysteresis)' (Join-Path $Root 'orchestrator') { & $py -m pytest -q }
} else { Rec 'python' 'SKIP' 'python 3.12+ not found' }
if (Has 'cargo') {
    Run 'cargo test dscu-v9 (golden + ring + 1M-iteration fuzz smoke)' (Join-Path $Root 'dscu-v9') { cargo test --release -q }
    if ($Bench) { Run 'cargo bench (criterion: ahash / diff / ring 1080p)' (Join-Path $Root 'dscu-v9') { cargo bench --bench fingerprint -- --warm-up-time 1 --measurement-time 3 } }
    if ($Fuzz) { if (Has 'cargo-fuzz') { foreach ($t in 'ipc_decode', 'ffi_surface', 'ring_attach') { Run "cargo fuzz $t ($FuzzRuns runs)" (Join-Path $Root 'dscu-v9') ([scriptblock]::Create("cargo +nightly fuzz run $t -- -runs=$FuzzRuns")) } } else { Rec 'cargo-fuzz' 'SKIP' 'cargo install cargo-fuzz; rustup toolchain install nightly' } }
} else { Rec 'rust' 'SKIP' 'cargo not found (winget install Rustlang.Rustup)' }
if ((Has 'cmake') -and ((Has 'cl') -or (Has 'g++') -or (Has 'clang++'))) {
    $b = Join-Path $Root 'vision-engine\build'
    Run 'cmake + ctest vision-engine (AVX2 == scalar == original-PowerShell vectors)' (Join-Path $Root 'vision-engine') { cmake -S . -B build -DCMAKE_BUILD_TYPE=Release; cmake --build build --config Release; ctest --test-dir build -C Release --output-on-failure }
} else { Rec 'c++ vision-engine' 'SKIP' 'cmake + a C++20 compiler not found' }
if (Has 'node') {
    $cb = Join-Path $Root 'packages\cdp-daemon'
    if (Has 'npm') { Push-Location $cb; if (-not (Test-Path node_modules)) { npm install --silent 2>&1 | Out-Null }; Pop-Location; Run 'tsc --noEmit cdp-bridge' $cb { npx tsc --noEmit }; Run 'node:test cdp-bridge (AX compaction / taint / daemon / control plane)' $cb { npm test --silent } }
    else { Rec 'cdp-bridge' 'SKIP' 'npm not found' }
} else { Rec 'typescript cdp-bridge' 'SKIP' 'node 22+ not found' }
$f = @($rows | Where-Object Status -eq 'FAIL').Count; $p = @($rows | Where-Object Status -eq 'PASS').Count; $s = @($rows | Where-Object Status -eq 'SKIP').Count
Write-Host ("Phase 7: PASS={0} FAIL={1} SKIP={2}" -f $p, $f, $s) -ForegroundColor $(if ($f) { 'Red' } else { 'Green' })
