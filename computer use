// Streaming extraction of Accessibility.getFullAXTree + DOMSnapshot.captureSnapshot in bounded chunks, epoch-stamped:
// if the page mutates mid-stream (epoch moved) the whole pass restarts (max 2 retries) so consumers never see a mixed snapshot.
import { EpochLock } from "./epoch-lock.ts";
export interface Cdp { send(method: string, params?: Record<string, unknown>): Promise<any>; }
export type AxChunk = { epoch: number; index: number; last: boolean; nodes: unknown[] };

export async function* streamSnapshot(cdp: Cdp, lock: EpochLock, chunk = 200): AsyncGenerator<AxChunk> {
  for (let attempt = 0; attempt < 3; attempt++) {
    const start = lock.epoch;
    const [ax, dom] = await Promise.all([
      cdp.send("Accessibility.getFullAXTree"),
      cdp.send("DOMSnapshot.captureSnapshot", { computedStyles: [], includeDOMRects: true }),
    ]);
    if (lock.epoch !== start) continue;                                   // page changed under us -> restart
    const nodes: unknown[] = [...(ax?.nodes ?? []), ...(dom?.documents?.[0]?.nodes?.backendNodeId ?? []).map((id: number) => ({ dom: id }))];
    for (let i = 0, n = 0; i < Math.max(nodes.length, 1); i += chunk, n++) {
      if (lock.epoch !== start) break;
      yield { epoch: start, index: n, last: i + chunk >= nodes.length, nodes: nodes.slice(i, i + chunk) };
    }
    if (lock.epoch === start) return;
  }
  throw new Error("STALE_EPOCH: page kept mutating during snapshot");
}
