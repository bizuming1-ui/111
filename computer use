class Env:
    def __init__(self, bin_names: list[str] | None = None, desktop_files: list[str] | None = None, confirm: bool = True, bin_original_on_desktop: bool = False) -> None:
        self.tmp = Path(tempfile.mkdtemp(prefix="dscu181_"))
        self.roots = {k: self.tmp / k for k in ("desktop", "documents", "downloads")}
        for r in self.roots.values():
            r.mkdir()
        for f in desktop_files or []:
            (self.roots["desktop"] / f).write_text("x" * 6, encoding="utf-8")
        self.backend = FakeBin(bin_names, self.roots["desktop"] if bin_original_on_desktop else None)
        self.fx = FakeFx(self.backend)
        self.world = WorldModel(CompositeProvider(FileSystemProvider(self.roots), RecycleBinProvider(self.backend)), AuthorizedScope(self.roots))
        self.lines: list[str] = []
        self.orch = SimpleNamespace(say=self.lines.append, counters=defaultdict(int))
        self.confirm_calls: list[str] = []

        async def _confirm(q: str) -> bool:
            self.confirm_calls.append(q)
            return confirm

        self.core = CoreLoop(self.orch, self.world, self.fx, confirm=_confirm, say=self.lines.append)

    def run(self, task: str) -> tuple[str, str] | None:
        return asyncio.run(self.core.run(SimpleNamespace(task=task)))

    def bin_names(self) -> list[str]:
        return [i.name for i in self.backend.items]

    def close(self) -> None:
        shutil.rmtree(self.tmp, ignore_errors=True)


