# ===================================================================================================================== Suite 5: stability
class SimBin:
    """Recycle-bin stand-in used when not on Windows / without --real: real files are really moved, the oracle is the filesystem."""

    def __init__(self, base: Path) -> None:
        self.dir = base / "$RECYCLE.SIM"
        self.dir.mkdir(parents=True, exist_ok=True)

    def recycle_file(self, path, extra_roots=()):
        p = Path(str(path))
        if not p.exists():
            return False, f"文件不存在: {p}"
        shutil.move(str(p), str(self.dir / f"{p.name}.{time.time_ns()}"))
        return (not p.exists()), f"已移入模拟回收站：{p}"

    def empty(self):
        for f in self.dir.iterdir():
            f.unlink()
        return True, "模拟回收站已清空"

    def status(self):
        names = [f.name for f in self.dir.iterdir()]
        return {"ok": True, "count": len(names), "consistent": True, "sources": {"sim.fs": len(names), "sim.list": len(names)}, "names": names}

    def wait(self, expected, timeout=6.0):
        return self.status()


def suite_stability(args) -> Rec:
    r = Rec("stability")
    n = args.stability_n
    real = args.real and sys.platform == "win32"
    empty_real = real and args.allow_empty_recycle_bin
    base = Path(Config().workspace) / "phase0_1_stability" if real else Path(tempfile.mkdtemp(prefix="dscu_stab_"))
    base.mkdir(parents=True, exist_ok=True)
    sim = SimBin(base)
    mode = {"file_create": "real-filesystem", "file_delete": "windows-real-recycle-bin(SHFileOperationW)" if real else "simulated-recycle-bin(real files)",
            "empty_recycle_bin": "windows-real(SHEmptyRecycleBinW, user bin!)" if empty_real else "simulated-recycle-bin"}
    rng = random.Random(args.seed)
    stats = {k: {"n": 0, "verified": 0, "claimed": 0, "false_success": 0, "faults": 0, "faults_caught": 0} for k in ("file_create", "file_delete", "empty_recycle_bin")}
    mis_n = mis_bad = 0
    ms: dict[str, list[float]] = {k: [] for k in stats}
    V = verifier_for()

    def indep_sha(p: Path) -> str:
        return hashlib.sha256(p.read_bytes()).hexdigest()

    patches = []
    if not real:
        patches += [mock.patch.object(safe_shell, "recycle_file", sim.recycle_file), mock.patch.object(safe_shell, "recycle_bin_status", sim.status), mock.patch.object(safe_shell, "wait_recycle_count", sim.wait)]
    if not empty_real:
        patches.append(mock.patch.object(safe_shell, "empty_recycle_bin", sim.empty))
    for p in patches:
        p.start()
    try:
        wal = WriteAheadLog(base / "stability_wal.jsonl")
        for i in range(n + max(3, n // 3)):
            fault = i >= n  # the extra iterations inject SILENT failures to measure false-success
            # ---------------------------------------------------- 1) file create (Layer0 write_verified + independent sha256)
            t0 = time.perf_counter()
            content = f"phase0_1 create #{i} {rng.random()}"
            ft = layer0.FileTask("工作区", base, f"p01_create_{i}.txt", content, "notepad")
            if fault:
                with mock.patch.object(Path, "write_bytes", lambda self, data: len(data)):  # claims success, writes nothing
                    _ok, _msg, p = layer0.write_verified(ft)
                ok_w = True
            else:
                ok_w, _msg, p = layer0.write_verified(ft)
            v = V.verify_written_file(p, content.encode("utf-8"))
            claimed = ok_w and v.ok and v.status == "completed_verified"
            truth = p.exists() and indep_sha(p) == hashlib.sha256(content.encode("utf-8")).hexdigest()
            s = stats["file_create"]
            if fault:
                s["faults"] += 1
                s["faults_caught"] += int(not claimed)
            else:
                s["n"] += 1
                s["verified"] += int(claimed and truth)
                s["claimed"] += int(claimed)
                ms["file_create"].append((time.perf_counter() - t0) * 1000)
            s["false_success"] += int(claimed and not truth)
            # ---------------------------------------------------- 2) file delete (WAL + recycle + independent oracle + bystander integrity)
            t0 = time.perf_counter()
            tgt = base / f"p01_del_{i}.txt"
            tgt.write_text(f"delete me {i}", encoding="utf-8")
            decoys = []
            for k in range(2):
                dc = base / f"p01_decoy_{i}_{k}.txt"
                dc.write_text(f"decoy {i}-{k}", encoding="utf-8")
                decoys.append((dc, indep_sha(dc)))
            tx = WalTransaction(wal, f"delete {tgt.name}")
            txid = tx.create("file_recycle", {"type": "file_absent", "paths": [str(tgt)]})
            tx.freeze(txid, [str(tgt)])
            tx.confirm(txid)
            tx.start(txid)
            ok_d, _msg = (True, "silent no-op") if fault else safe_shell.recycle_file(tgt, (base,))
            tx.verifying(txid)
            vd = IndependentVerifier.finalize([V.assert_file_not_exists(("path", tgt))], [FileDeleteGoal(("path", str(tgt)))])
            claimed = ok_d and vd.status == "completed_verified" and may_commit(vd)
            truth = not tgt.exists()
            tx.finish(txid, bool(claimed), vd.status)
            s = stats["file_delete"]
            if fault:
                s["faults"] += 1
                s["faults_caught"] += int(not claimed)
            else:
                s["n"] += 1
                s["verified"] += int(claimed and truth)
                s["claimed"] += int(claimed)
                ms["file_delete"].append((time.perf_counter() - t0) * 1000)
                mis_n += len(decoys) + 1
                mis_bad += sum(1 for dc, h in decoys if not dc.exists() or indep_sha(dc) != h)
            s["false_success"] += int(claimed and not truth)
            for dc, _ in decoys:
                dc.unlink(missing_ok=True)
            # ---------------------------------------------------- 3) empty recycle bin
            t0 = time.perf_counter()
            if not empty_real:
                for k in range(3):
                    f = base / f"p01_bin_{i}_{k}.txt"
                    f.write_text("x", encoding="utf-8")
                    sim.recycle_file(f)
            ok_e = True if fault else safe_shell.empty_recycle_bin()[0]
            st_ = safe_shell.wait_recycle_count(0, 8.0 if empty_real else 1.0)
            vd = IndependentVerifier.finalize([IndependentVerifier.assert_recycle_bin_empty()], [RecycleBinEmptyGoal()])
            claimed = ok_e and vd.status == "completed_verified"
            truth = bool(st_.get("ok") and st_.get("count") == 0)
            s = stats["empty_recycle_bin"]
            if fault:
                s["faults"] += 1
                s["faults_caught"] += int(not claimed)
            else:
                s["n"] += 1
                s["verified"] += int(claimed and truth)
                s["claimed"] += int(claimed)
                ms["empty_recycle_bin"].append((time.perf_counter() - t0) * 1000)
            s["false_success"] += int(claimed and not truth)
            if fault and not empty_real:
                sim.empty()
    finally:
        for p in patches:
            try:
                p.stop()
            except RuntimeError:
                pass
        if not real:
            shutil.rmtree(base, ignore_errors=True)
    tot_n = sum(s["n"] for s in stats.values())
    tot_v = sum(s["verified"] for s in stats.values())
    tot_fs = sum(s["false_success"] for s in stats.values())
    tot_faults = sum(s["faults"] for s in stats.values())
    tot_caught = sum(s["faults_caught"] for s in stats.values())
    for k, s in stats.items():
        lat = sorted(ms[k]) or [0.0]
        r(f"{k} ×{s['n']}", s["verified"] == s["n"] and s["false_success"] == 0 and s["faults_caught"] == s["faults"],
