def _dpi_of(hwnd: int) -> float:
    try:
        import ctypes

        return max(1.0, ctypes.windll.user32.GetDpiForWindow(int(hwnd)) / 96.0)  # type: ignore[attr-defined]
    except Exception:  # noqa: BLE001
        return 1.0


class _Clip:
    """Unicode text clipboard through user32 (retries: the clipboard is a global lock another process may hold for a few ms)."""

    @staticmethod
    def _api() -> Any:
        import ctypes
        from ctypes import wintypes

        u, k = ctypes.windll.user32, ctypes.windll.kernel32  # type: ignore[attr-defined]
        u.OpenClipboard.argtypes = [wintypes.HWND]
        u.OpenClipboard.restype = wintypes.BOOL
        u.GetClipboardData.argtypes = [wintypes.UINT]
        u.GetClipboardData.restype = wintypes.HANDLE
        u.SetClipboardData.argtypes = [wintypes.UINT, wintypes.HANDLE]
        u.SetClipboardData.restype = wintypes.HANDLE
        k.GlobalAlloc.argtypes = [wintypes.UINT, ctypes.c_size_t]
        k.GlobalAlloc.restype = wintypes.HGLOBAL
        k.GlobalLock.argtypes = [wintypes.HGLOBAL]
        k.GlobalLock.restype = wintypes.LPVOID
        k.GlobalUnlock.argtypes = [wintypes.HGLOBAL]
        return ctypes, u, k

    @classmethod
    def get(cls) -> Optional[str]:
        ctypes, u, k = cls._api()
        for _ in range(20):
            if u.OpenClipboard(None):
                try:
                    h = u.GetClipboardData(13)  # CF_UNICODETEXT
                    if not h:
                        return None
                    p = k.GlobalLock(h)
                    try:
                        return ctypes.wstring_at(p)
                    finally:
                        k.GlobalUnlock(h)
                finally:
                    u.CloseClipboard()
            import time

            time.sleep(0.02)
        return None

    @classmethod
    def set(cls, text: str) -> bool:
        ctypes, u, k = cls._api()
        data = (text + "\0").encode("utf-16-le")
        for _ in range(20):
            if u.OpenClipboard(None):
                try:
                    u.EmptyClipboard()
                    h = k.GlobalAlloc(0x0042, len(data))  # GMEM_MOVEABLE | GMEM_ZEROINIT
                    p = k.GlobalLock(h)
                    ctypes.memmove(p, data, len(data))
                    k.GlobalUnlock(h)
                    u.SetClipboardData(13, h)
                    return True
                finally:
                    u.CloseClipboard()
            import time

            time.sleep(0.02)
        return False


class WeChatWinIO:
    def __init__(self, brain: Any) -> None:
        self.b = brain
        self.hwnd = 0
        self.last_error = ""

    def _chk(self, r: Any, what: str) -> Any:
        if not getattr(r, "ok", True):
            self.last_error = f"{what} -> {getattr(r, 'code', '?')}: {str(getattr(r, 'message', ''))[:90]}"
        return r

    # -- window --------------------------------------------------------------------------------------------------------------
    async def find_window(self) -> Optional[dict[str, Any]]:
        o = await self.b.hub.drv_observe(channel="dxgi_vision", max_elements=1)
        best = None
        for w in o.windows or []:
            if (w.process or "").lower() not in ms.WECHAT_PROCS or w.cloaked or not w.rect or len(w.rect) != 4:
                continue
            if w.rect[2] < 500 or w.rect[3] < 400:
                continue  # tray / login / pop-up windows
            area = w.rect[2] * w.rect[3]
            if best is None or area > best[0]:
                best = (area, w)
        if best is None:
            return None
        w = best[1]
        return {"hwnd": int(w.hwnd), "title": w.title, "rect": [int(v) for v in w.rect], "minimized": bool(w.minimized), "dpi": _dpi_of(int(w.hwnd))}

    async def focus(self, hwnd: int) -> bool:
        self.hwnd = int(hwnd)
        r = await self.b._drv("restore_window", None, hwnd=int(hwnd))
        if not r.ok:
            r = await self.b._drv("focus_window", None, hwnd=int(hwnd))
        return bool(r.ok)

    async def launch(self) -> bool:
        cands = [os.path.expandvars(p) for p in (r"%ProgramFiles%\Tencent\Weixin\Weixin.exe", r"%ProgramFiles(x86)%\Tencent\WeChat\WeChat.exe", r"%ProgramFiles%\Tencent\WeChat\WeChat.exe",
                                                   r"%LOCALAPPDATA%\Tencent\Weixin\Weixin.exe")]
        for p in cands:
            if os.path.exists(p):
                try:
                    subprocess.Popen([p], close_fds=True)  # noqa: S603
                    return True
                except Exception:  # noqa: BLE001
                    continue
        try:
            subprocess.Popen(["cmd", "/c", "start", "", "weixin://"], close_fds=True)  # noqa: S603,S607
            return True
        except Exception:  # noqa: BLE001
            return False

    # -- input ---------------------------------------------------------------------------------------------------------------
    async def key(self, keys: str) -> None:
        self._chk(await self.b._drv("key", None, keys=keys, expect_hwnd=self.hwnd), f"key {keys}")

    async def click(self, x: int, y: int) -> None:
        self._chk(await self.b._drv("click", None, x=int(x), y=int(y), expect_hwnd=self.hwnd), f"click({int(x)},{int(y)})")

    async def type_text(self, text: str) -> None:
        self._chk(await self.b._drv("type", None, text=text, expect_hwnd=self.hwnd), "type")

    async def clipboard_get(self) -> Optional[str]:
        return await asyncio.to_thread(_Clip.get) if sys.platform == "win32" else None

    async def clipboard_set(self, text: str) -> None:
        if sys.platform == "win32":
            await asyncio.to_thread(_Clip.set, text)

    async def sleep(self, s: float) -> None:
        await asyncio.sleep(s)

    async def confirm(self, lines: list, question: str) -> bool:
        policy = os.environ.get("DSCU_MSG_HITL", "always").lower()
        if policy == "auto":
            for ln in lines:
                self.b.say(ln)
            self.b.say(f"  ✓ HITL 自动策略（DSCU_MSG_HITL=auto）：{question}")
            return True
        return await self.b._hitl(lines, question)

    # -- perception: DirectML boxes + local OCR (v17.1 fixed: OCR runs on its own loop thread) ---------------------------------
    async def perceive(self, rect: list) -> dict[str, Any]:
        return await asyncio.to_thread(self._perceive_sync, [int(v) for v in rect])

    @staticmethod
    def _perceive_sync(rect: list) -> dict[str, Any]:
        from PIL import ImageGrab

        try:  # physical pixels: the Rust-driver tier leaves this Python process DPI-unaware otherwise
            import ctypes

            ctypes.windll.user32.SetProcessDPIAware()  # type: ignore[attr-defined]
        except Exception:  # noqa: BLE001
            pass
        x, y, w, h = rect
        img = ImageGrab.grab(bbox=(x, y, x + max(1, w), y + max(1, h)), all_screens=True).convert("RGB")
        from sidecar import dml_detector as dml

        raw = dml.ocr_words(img)
        lines = [([x + r[0], y + r[1], r[2], r[3]], t, src) for r, t, src in raw]
        det = None
        cands: list = []
        try:
            det = dml.get()
            if det.enabled():
                cands = [{**c, "box": [x + c["box"][0], y + c["box"][1], c["box"][2], c["box"][3]]} for c in det.detect(img)]
        except Exception:  # noqa: BLE001
            cands = []
        items = dml.label_boxes(cands, lines) if cands else [{"box": r, "text": t, "text_src": s, "cls": -1} for r, t, s in lines]
        return {"lines": lines, "items": items, "dml": bool(cands), "dml_n": len(cands), "ocr": dml.ocr_stats()}

