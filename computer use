"""v16.1 optional Layer-0 Gmail API fast lane (reserved interface).

If the user configured a Google OAuth2 token (env DSCU_GMAIL_TOKEN = path to a JSON file, default %LOCALAPPDATA%\\DeepSeekComputerUse\\gmail_token.json with
{"access_token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "...", "expires_at": 0}) the brain can read / list / trash mail through the
Gmail REST API in ~1 s without any browser.  Without a token `available()` is False and the brain automatically uses the clean-browser-url / autoconnect browser lane.
Only the standard library is used (urllib); `transport` can be injected for tests.  Deletion = move to Trash (reversible for 30 days); never permanent delete.
"""
from __future__ import annotations

import json
import os
import re
import time
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Callable, Optional

API = "https://gmail.googleapis.com/gmail/v1/users/me"
TOKEN_URL = "https://oauth2.googleapis.com/token"
Transport = Callable[[str, str, dict[str, str], Optional[bytes]], tuple[int, dict[str, Any]]]


class GmailApiError(RuntimeError):
    pass


def default_token_path() -> Path:
    if os.environ.get("DSCU_GMAIL_TOKEN"):
        return Path(os.environ["DSCU_GMAIL_TOKEN"])
    base = os.environ.get("LOCALAPPDATA") or str(Path.home() / ".local" / "share")
    return Path(base) / "DeepSeekComputerUse" / "gmail_token.json"


def _urllib_transport(method: str, url: str, headers: dict[str, str], body: Optional[bytes]) -> tuple[int, dict[str, Any]]:
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:  # system proxy honoured (Google APIs are often only reachable through it)
            raw = r.read().decode("utf-8", "replace")
            return r.status, (json.loads(raw) if raw.strip() else {})
    except urllib.error.HTTPError as e:  # type: ignore[attr-defined]
        raw = e.read().decode("utf-8", "replace")
        try:
            return e.code, json.loads(raw)
        except Exception:  # noqa: BLE001
            return e.code, {"error": raw[:300]}


class GmailApiLayer0:
    def __init__(self, token_path: Optional[Path] = None, transport: Optional[Transport] = None) -> None:
        self.path = Path(token_path) if token_path else default_token_path()
        self.transport: Transport = transport or _urllib_transport
        self.tok: dict[str, Any] = {}
        self.stats = {"calls": 0, "refreshes": 0}

    def _load(self) -> dict[str, Any]:
        try:
            self.tok = json.loads(self.path.read_text(encoding="utf-8"))
        except Exception:  # noqa: BLE001
            self.tok = {}
        return self.tok

    def available(self) -> bool:
        t = self._load()
        return bool(t.get("access_token") or (t.get("refresh_token") and t.get("client_id") and t.get("client_secret")))

    def _refresh(self) -> None:
        t = self.tok
        if not (t.get("refresh_token") and t.get("client_id") and t.get("client_secret")):
            raise GmailApiError("access_token 已过期且没有 refresh_token/client_id/client_secret，无法刷新")
        body = urllib.parse.urlencode({"grant_type": "refresh_token", "refresh_token": t["refresh_token"], "client_id": t["client_id"], "client_secret": t["client_secret"]}).encode()
        st, js = self.transport("POST", TOKEN_URL, {"Content-Type": "application/x-www-form-urlencoded"}, body)
        if st != 200 or "access_token" not in js:
            raise GmailApiError(f"token refresh failed: {st} {str(js)[:160]}")
        t["access_token"], t["expires_at"] = js["access_token"], time.time() + int(js.get("expires_in", 3600)) - 60
        self.stats["refreshes"] += 1
        try:
            self.path.write_text(json.dumps(t, ensure_ascii=False, indent=1), encoding="utf-8")
        except OSError:
            pass

    def _call(self, method: str, path: str, params: Optional[dict[str, Any]] = None, body: Optional[dict[str, Any]] = None) -> dict[str, Any]:
        if not self.tok:
            self._load()
        if not self.tok.get("access_token") or (self.tok.get("expires_at") and float(self.tok["expires_at"]) < time.time()):
            self._refresh()
        url = API + path + (("?" + urllib.parse.urlencode(params, doseq=True)) if params else "")
        for attempt in (1, 2):
            hdr = {"Authorization": f"Bearer {self.tok['access_token']}", "Accept": "application/json", "Content-Type": "application/json"}
            st, js = self.transport(method, url, hdr, json.dumps(body).encode() if body is not None else None)
            self.stats["calls"] += 1
            if st == 401 and attempt == 1:
                self._refresh()
                continue
            if st >= 400:
                raise GmailApiError(f"Gmail API {st}: {str(js.get('error', js))[:200]}")
            return js
        raise GmailApiError("unreachable")

    # ------------------------------------------------------------------ operations
    def list_messages(self, query: str = "in:inbox", max_results: int = 10) -> list[dict[str, Any]]:
        js = self._call("GET", "/messages", {"q": query, "maxResults": max(1, min(int(max_results), 50))})
        out = []
        for m in js.get("messages", []) or []:
            d = self._call("GET", f"/messages/{m['id']}", {"format": "metadata", "metadataHeaders": ["Subject", "From", "Date"]})
            h = {x["name"].lower(): x["value"] for x in (d.get("payload", {}).get("headers", []) or [])}
            out.append({"id": m["id"], "threadId": d.get("threadId"), "subject": h.get("subject", ""), "from": h.get("from", ""), "date": h.get("date", ""), "snippet": d.get("snippet", ""),
                        "unread": "UNREAD" in (d.get("labelIds") or [])})
        return out

    def trash_messages(self, ids: list[str]) -> list[str]:
        done = []
        for i in ids:
            self._call("POST", f"/messages/{i}/trash")
            done.append(i)
        return done

    def verify_trashed(self, ids: list[str]) -> bool:
        return all("TRASH" in (self._call("GET", f"/messages/{i}", {"format": "minimal"}).get("labelIds") or []) for i in ids)


_CN = {"一": 1, "二": 2, "两": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9, "十": 10}


def parse_gmail_task(task: str) -> Optional[dict[str, Any]]:
    """Map a natural-language mail task to an API intent, or None (=> browser lane).  Only unambiguous read/list/trash requests qualify."""
    t = str(task or "")
    if not re.search(r"gmail|谷歌邮箱|google\s*邮箱|邮箱|邮件", t, re.I):
        return None
    if re.search(r"发送|写邮件|回复|转发|附件|send|reply|compose|forward", t, re.I):
        return None
    n = 0
    m = re.search(r"(\d+)\s*(?:封|条|个)", t)
    if m:
        n = int(m.group(1))
    else:
        m2 = re.search(r"([一二两三四五六七八九十])\s*(?:封|条|个)", t)
        n = _CN.get(m2.group(1), 0) if m2 else 0
    q = "in:inbox"
    if re.search(r"未读|unread", t, re.I):
        q = "is:unread in:inbox"
    elif re.search(r"广告|推广|促销|promotion", t, re.I):
        q = "category:promotions"
    elif re.search(r"垃圾邮件|spam", t, re.I):
        q = "in:spam"
    if re.search(r"删除|清理|移到垃圾|trash|delete", t, re.I):
        return {"intent": "trash", "query": q, "count": n or 5}
    if re.search(r"读取|查看|看看|列出|最新|有没有|read|list|show|check", t, re.I) and not re.search(r"进入|打开|登录", t):
        return {"intent": "list", "query": q, "count": n or 5}
    return None
