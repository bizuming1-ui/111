//! Physical-pixel coordinate normalisation (Per-Monitor DPI v2): multi-monitor, negative origins, high-DPI.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct VirtualDesktop {
    pub x: i32,
    pub y: i32,
    pub w: i32,
    pub h: i32,
}

/// Map an absolute physical pixel to SendInput's 0..=65535 range for `MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK`.
pub fn to_sendinput_abs(vd: VirtualDesktop, px: i32, py: i32) -> (i32, i32) {
    let f = |p: i32, o: i32, n: i32| -> i32 {
        let n = n.max(1) as f64;
        let v = ((p - o) as f64 + 0.5) * 65536.0 / n;
        v.floor().clamp(0.0, 65535.0) as i32
    };
    (f(px, vd.x, vd.w), f(py, vd.y, vd.h))
}

/// Inverse of [`to_sendinput_abs`] (centre of the covered pixel); used by golden tests.
pub fn from_sendinput_abs(vd: VirtualDesktop, ax: i32, ay: i32) -> (i32, i32) {
    let f = |a: i32, o: i32, n: i32| -> i32 { o + ((a as f64 + 0.5) * n as f64 / 65536.0).floor() as i32 };
    (f(ax, vd.x, vd.w), f(ay, vd.y, vd.h))
}

/// Scale a logical (DPI-virtualised) rect to physical pixels: `dpi` is the monitor DPI (96 = 100%).
pub fn logical_to_physical(v: i32, dpi: u32) -> i32 {
    ((v as i64 * dpi as i64 + 48) / 96) as i32
}
