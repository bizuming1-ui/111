}

function Find-SdkTool([string]$Name) {
    $roots = @($SdkBin, "${env:ProgramFiles(x86)}\Windows Kits\10\bin", "$env:ProgramFiles\Windows Kits\10\bin") | Where-Object { $_ -and (Test-Path -LiteralPath $_) }
    foreach ($r in $roots) {
