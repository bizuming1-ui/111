        rdir.mkdir(parents=True, exist_ok=True)
        sandbox = rdir / "sandbox"
        sandbox.mkdir(exist_ok=True)
        ctx = V.Ctx.default(sandbox, self.cdp_port)
        env = Env(ctx, self.allow_exec, self.allow_destructive)
        r = Rollout(task["id"], k, dir=str(rdir))
        (rdir / "task.json").write_text(json.dumps(task, ensure_ascii=False, indent=1), encoding="utf-8")
        r.setup_ok = env.run_steps(task.get("setup", []))
        initial = {"ctx": dict(ctx), "setup_log": env.log, "files": _listing(ctx)}
        (rdir / "initial_state.json").write_text(json.dumps(initial, ensure_ascii=False, indent=1), encoding="utf-8")
        (rdir / "meta.json").write_text(json.dumps(self.meta(), ensure_ascii=False, indent=1), encoding="utf-8")
        if not r.setup_ok:
            r.status = "setup_failed"
            r.oracle = {"ok": False, "positive_ok": False, "guards_ok": True, "results": [{"type": "setup", "ok": False, "detail": "; ".join(env.log)[-200:]}]}
            env.close()
            self._write(rdir, r)
            return r
        lines: list[str] = []
        b.say = lambda m: lines.append(str(m))  # type: ignore[method-assign]
        b.trace_dir = rdir / "trace"
        c0, h0 = dict(b.counters), getattr(b.hub, "cdp_heals", 0)
        rec = getattr(b, "recovery", None)
        fault = task.get("fault")
        timer: Optional[threading.Timer] = None
        killed = {"n": 0}
        if fault and fault.get("type") == "kill_browser":
            def _kill() -> None:
                killed["n"] = kill_browser(self.cdp_port)

            timer = threading.Timer(float(fault.get("after_s", 8)), _kill)
            timer.start()
        t0 = time.time()
        try:
            instr = V.fmt(task["instruction"], ctx)
            r.status = await asyncio.wait_for(b.run_task(instr, max_steps=int(task.get("max_steps", 30))), timeout=float(task.get("timeout_s", 420)))
        except asyncio.TimeoutError:
            r.status = "timeout"
        except Exception as e:  # noqa: BLE001
            r.status = "error"
            lines.append(f"EXC {e!r}")
        r.elapsed = time.time() - t0
        if timer:
            timer.cancel()
        steps = [int(x) for x in re.findall(r"── 第 (\d+) 步 ──", "\n".join(lines))]
        r.steps = max(steps) if steps else 0
        r.errors = sum(1 for ln in lines if "执行出错" in ln)
        d = {k: b.counters[k] - c0.get(k, 0) for k in b.counters}
        rs = dict(rec.stats) if rec else {}
        heals = getattr(b.hub, "cdp_heals", 0) - h0
        r.facts = {"verifier_pass": d.get("verifier_pass", 0), "verifier_rejects": d.get("verifier_rejects", 0), "security_denials": rs.get("security_denials", 0),
                   "recovered": rs.get("occluded_recovered", 0) + heals, "recovery_events": (len(rec.events) if rec else 0) + heals + d.get("playbook_activate_check", 0) + d.get("playbook_hotkey_probe", 0),
                   "cdp_heals": heals, "fault_killed_procs": killed["n"], "stable_object_hits": dict(getattr(b.registry, "hits", {})), "recovery_stats": rs}
        (rdir / "say.log").write_text("\n".join(lines), encoding="utf-8")
        (rdir / "recovery.json").write_text(json.dumps({"events": rec.trace() if rec else [], "stats": rs, "cdp_heal_log": getattr(b.hub, "cdp_heal_log", [])[-5:]}, ensure_ascii=False, indent=1), encoding="utf-8")
        ctx["_status"] = r.status
        ctx["_counters"] = {"cdp_heals": r.facts["cdp_heals"], "recovery_events": r.facts["recovery_events"], **{k: v for k, v in d.items()}}
        r.oracle = V.verify(task["oracle"], ctx)  # independent post-state oracle
        for p in task.get("cleanup", []):
            try:
                Path(V.fmt(p, ctx)).unlink(missing_ok=True)
            except Exception:  # noqa: BLE001
                pass
        env.close()
        self._write(rdir, r)
        return r

    @staticmethod
    def _write(rdir: Path, r: Rollout) -> None:
        (rdir / "verifier.json").write_text(json.dumps(r.oracle, ensure_ascii=False, indent=1), encoding="utf-8")
        (rdir / "result.json").write_text(json.dumps({"task": r.task_id, "rollout": r.k, "status": r.status, "success": r.success, "misoperation": r.misoperation, "elapsed_s": round(r.elapsed, 2),
                                                      "steps": r.steps, "errors": r.errors, "facts": r.facts, "fact_score": fact_score(r)}, ensure_ascii=False, indent=1), encoding="utf-8")

    async def run_tasks(self, tasks: list[dict[str, Any]], rollouts: int = 1, trials: int = 1) -> list[dict[str, Any]]:
        rows: list[dict[str, Any]] = []
        n = max(1, rollouts) if rollouts > 1 else max(1, trials)
        for task in tasks:
            rs: list[Rollout] = []
            for k in range(1, n + 1):
                r = await self.rollout(task, k)
                rs.append(r)
                print(f"  [{self.tier}] {task['id']:<34} rollout {k}/{n}  status={r.status:<16} oracle={'PASS' if r.success else 'FAIL'}  {r.elapsed:5.1f}s  steps={r.steps}", flush=True)
            pick = max(rs, key=lambda x: (fact_score(x), -x.k)) if rollouts > 1 else rs[0]
            rows.append({"id": task["id"], "rollouts": [_dump(x) for x in rs], "pass_at_1": rs[0].success, "selected": pick.k, "selected_success": pick.success,
                         "oracle_pass_at_n": any(x.success for x in rs), "judge_correct": (pick.success == any(x.success for x in rs))})
        return rows


def _dump(r: Rollout) -> dict[str, Any]:
    return {"k": r.k, "status": r.status, "success": r.success, "misoperation": r.misoperation, "elapsed_s": round(r.elapsed, 2), "steps": r.steps, "errors": r.errors,
            "facts": r.facts, "fact_score": fact_score(r), "dir": r.dir, "oracle": r.oracle.get("results", [])}


def _listing(ctx: V.Ctx) -> dict[str, Any]:
    out = {}
    for k in ("Desktop", "Sandbox"):
        try:
            out[k] = sorted(p.name for p in Path(ctx[k]).iterdir())[:80]
        except OSError:
            out[k] = []
    return out


# ------------------------------------------------------------------------------------------------ selfcheck (oracle hygiene, no LLM)
def selfcheck(tasks: list[dict[str, Any]], allow_exec: bool, allow_destructive: bool, run_dir: Path) -> dict[str, Any]:
    """Every task's oracle must (1) FAIL on the untouched initial state and (2) PASS after its `reference_solution`.  Proves the oracle is neither
    trivially true nor impossible.  Tasks needing a live LLM/GUI-only state are reported `skipped`, never silently passed."""
    rows = []
    for t in tasks:
        ref = t.get("reference_solution")
        if not ref:
            rows.append({"id": t["id"], "result": "skipped", "why": "no reference_solution"})
            continue
        win_only = {"recycle", "empty_recycle_bin", "recycle_bin_empty", "recycle_bin_contains", "registry_value", "window_title_contains"}
        if sys.platform != "win32" and (win_only & ({s.get("type") for s in t.get("setup", []) + ref} | {o.get("type") for o in t["oracle"]})):
            rows.append({"id": t["id"], "result": "skipped", "why": "needs Windows (Recycle Bin / registry / windows)"})
            continue
        sb = run_dir / "selfcheck" / re.sub(r"[^\w.-]", "_", t["id"])
        sb.mkdir(parents=True, exist_ok=True)
        ctx = V.Ctx.default(sb)
        env = Env(ctx, allow_exec, allow_destructive)
        ok_setup = env.run_steps(t.get("setup", []))
        if not ok_setup:
            rows.append({"id": t["id"], "result": "skipped", "why": "setup: " + "; ".join(env.log)[-120:]})
            env.close()
            continue
        ctx["_status"], ctx["_counters"] = "done", {}
        pre = V.verify([o for o in t["oracle"] if o.get("type") not in ("status_in", "counter_at_least")], ctx)
        env.run_steps(ref)
        post = V.verify([o for o in t["oracle"] if o.get("type") not in ("status_in", "counter_at_least")], ctx)
        env.close()
        for cp in t.get("cleanup", []):
            Path(V.fmt(cp, ctx)).unlink(missing_ok=True)
        good = (not pre["positive_ok"]) and post["positive_ok"] and post["guards_ok"]
        rows.append({"id": t["id"], "result": "ok" if good else "BAD", "pre_fails": not pre["positive_ok"], "post_passes": post["positive_ok"], "guards_ok": post["guards_ok"],
                     "pre": pre["results"], "post": post["results"]})
        print(f"  selfcheck {t['id']:<34} {'OK ' if good else 'BAD'} (initial-state fails={not pre['positive_ok']}, reference passes={post['positive_ok']})")
    return {"tasks": rows, "ok": all(r["result"] in ("ok", "skipped") for r in rows), "checked": sum(r["result"] != "skipped" for r in rows)}


async def amain(a: argparse.Namespace) -> int:
    run_dir = Path(a.run_dir) if a.run_dir else ROOT / "eval_runs" / time.strftime("%Y%m%d-%H%M%S")
    run_dir.mkdir(parents=True, exist_ok=True)
    tasks = load_tasks(a.tasks)
    if a.only:
        tasks = [t for t in tasks if re.search(a.only, t["id"])]
    skipped = [t["id"] for t in tasks if "destructive" in t.get("requires", []) and not a.allow_destructive]
    if skipped:
        print(f"  ⏭ 跳过需要 --allow-destructive 的任务（会清空真实回收站）：{skipped}")
        tasks = [t for t in tasks if t["id"] not in skipped]
    print(f"▶ Tier-3 WAA 任务 {len(tasks)} 个 ← {a.tasks}   归档目录 {run_dir}")
    if a.selfcheck:
        res = selfcheck(tasks, a.allow_exec, a.allow_destructive, run_dir)
        (run_dir / "selfcheck.json").write_text(json.dumps(res, ensure_ascii=False, indent=1), encoding="utf-8")
        print(f"=== selfcheck {'PASS' if res['ok'] else 'FAIL'}（已校验 {res['checked']} 个 oracle）")
        return 0 if res["ok"] else 2
    h = Harness(run_dir, "tier3_waa", a.allow_exec, a.allow_destructive, cdp_port=int(os.environ.get("DSCU_CDP_PORT", "9222")))
    await h.start()
    try:
        rows = await h.run_tasks(tasks, a.rollouts, a.trials)
    finally:
        await h.stop()
    (run_dir / "tier3_waa.json").write_text(json.dumps({"tier": "tier3_waa", "rollouts": a.rollouts, "tasks": rows, "meta": h.meta()}, ensure_ascii=False, indent=1), encoding="utf-8")
    return 0


def main() -> None:
    ap = argparse.ArgumentParser(description="DSCU v15 Tier-3 WAA/OSWorld-style runner")
    ap.add_argument("--tasks", default=str(ROOT / "evals" / "tasks" / "waa_native"), help="task JSON file or directory (native or official WindowsAgentArena examples)")
    ap.add_argument("--rollouts", type=int, default=1, help="Behavior Best-of-N: N independent rollouts per task + structured-fact judge")
    ap.add_argument("--trials", type=int, default=1)
    ap.add_argument("--only", default="")
    ap.add_argument("--run-dir", default="")
    ap.add_argument("--selfcheck", action="store_true", help="oracle hygiene check without LLM: initial state FAILS, reference solution PASSES")
    ap.add_argument("--allow-exec", action="store_true")
    ap.add_argument("--allow-destructive", action="store_true", help="permit tasks that empty the REAL Recycle Bin")
    sys.exit(asyncio.run(amain(ap.parse_args())))


if __name__ == "__main__":
    main()
