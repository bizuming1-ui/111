function Get-ActProp($o, [string]$Name) {
    if ($null -eq $o) { return $null }
    if ($o -is [System.Collections.IDictionary]) { if ($o.Contains($Name)) { return $o[$Name] } else { return $null } }
    $p = $o.PSObject.Properties[$Name]
    if ($p) { return $p.Value }
    return $null
}

# ---------------- 1. 全链路 Span：Capture / UIA / CDP / Vision / Network / Input 的 P50 / P99 ----------------
function Get-Percentile([double[]]$Values, [double]$P) {
    $n = @($Values).Count
    if ($n -eq 0) { return 0.0 }
    $s = [double[]]@($Values | Sort-Object)
    $idx = [int][Math]::Ceiling($P / 100.0 * $n) - 1
    if ($idx -lt 0) { $idx = 0 }
    if ($idx -ge $n) { $idx = $n - 1 }
    return [Math]::Round([double]$s[$idx], 2)
}
function Add-Span([string]$Plane, [double]$Ms, [string]$Name = '') {
    if (-not $script:SpanOn) { return }
    try {
        $endNs = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds() * 1000000L
        $script:Spans.Add([pscustomobject]@{ Plane = $Plane; Name = $Name; Ms = [Math]::Round($Ms, 3); EndNs = $endNs; Task = [int]$script:TaskNo; Seq = [long]$script:ActionSeq })
        if ($script:Spans.Count -gt 20000) { $script:Spans.RemoveRange(0, 5000) }
    }
    catch { }
}
function Get-SpanStats([int]$Task = -1) {
    $src = @($script:Spans | Where-Object { $Task -lt 0 -or $_.Task -eq $Task })
    $out = [System.Collections.Generic.List[object]]::new()
    foreach ($g in @($src | Group-Object Plane)) {
        $v = [double[]]@($g.Group | ForEach-Object { [double]$_.Ms })
        $out.Add([pscustomobject]@{ Plane = "$($g.Name)"; N = $v.Count; P50 = (Get-Percentile $v 50); P99 = (Get-Percentile $v 99); Max = [Math]::Round([double](($v | Measure-Object -Maximum).Maximum), 2) })
    }
    return $out.ToArray()
}
function Format-SpanSummary([int]$Task = -1) {
    $st = @(Get-SpanStats $Task)
    if ($st.Count -eq 0) { return '' }
    return ('延迟 P50/P99(ms)：' + ((@($st | Sort-Object Plane) | ForEach-Object { "$($_.Plane) $($_.P50)/$($_.P99)(n=$($_.N))" }) -join ' · '))
}
function ConvertTo-OtlpDocument {
    $i = 0
    $spans = [System.Collections.Generic.List[object]]::new()
    foreach ($s in @($script:Spans)) {
        $i++
        $dur = [long]([double]$s.Ms * 1000000.0)
        $spans.Add([ordered]@{
                traceId = $script:TraceId; spanId = ('{0:x16}' -f [long]$i); name = "dscu.$($s.Plane)"; kind = 1
                startTimeUnixNano = "$([long]$s.EndNs - $dur)"; endTimeUnixNano = "$([long]$s.EndNs)"
                attributes = @(
                    @{ key = 'dscu.plane'; value = @{ stringValue = "$($s.Plane)" } }
                    @{ key = 'dscu.name'; value = @{ stringValue = "$($s.Name)" } }
                    @{ key = 'dscu.task'; value = @{ intValue = "$($s.Task)" } }
                    @{ key = 'dscu.action_id'; value = @{ intValue = "$($s.Seq)" } }
                )
            })
    }
    return [ordered]@{
        resourceSpans = @([ordered]@{
                resource = @{ attributes = @(@{ key = 'service.name'; value = @{ stringValue = 'deepseek-computer-use' } }, @{ key = 'service.version'; value = @{ stringValue = '7.1' } }) }
                scopeSpans = @([ordered]@{ scope = @{ name = 'dscu.fusion'; version = '7.1' }; spans = $spans.ToArray() })
            })
    }
}
function Export-OtelSpans([string]$Path = '') {
    if ($script:Spans.Count -eq 0) { return $null }
    try {
        if ([string]::IsNullOrWhiteSpace($Path)) { if ($script:RunDir) { $Path = Join-Path $script:RunDir 'spans.otlp.json' } else { return $null } }
        [System.IO.File]::WriteAllText($Path, ((ConvertTo-OtlpDocument) | ConvertTo-Json -Depth 12 -Compress), [System.Text.UTF8Encoding]::new($false))
        return $Path
    }
    catch { return $null }
}

# ---------------- 2. 幂等动作 + 乐观锁（防 IPC 重试导致重复提交；仅外部编排器携带 action_id 时生效） ----------------
function Get-ActionFingerprint($a, [string]$kind) {
    $parts = [System.Collections.Generic.List[string]]::new()
    foreach ($k in 'id', 'ids', 'x', 'y', 'x2', 'y2', 'text', 'keys', 'key', 'target', 'args', 'path', 'command', 'title', 'amount', 'dx', 'dy') {
        $v = Get-ActProp $a $k
        if ($null -ne $v) { $parts.Add("$k=$(@($v) -join ',')") }
    }
    $h = [System.Security.Cryptography.SHA256]::HashData([System.Text.Encoding]::UTF8.GetBytes("$kind|" + ($parts -join '|')))
    return [Convert]::ToHexString($h).Substring(0, 16).ToLower()
}
function Get-RegionAHash([byte[]]$Sig) {
    # 48x32 灰度 → 8x8 块均值 → 64 位 aHash（16 位十六进制）；与 Rust / C++ 侧的 vision-engine 指纹同一定义
    if ($null -eq $Sig -or $Sig.Length -ne 1536) { return $null }
    $blk = New-Object 'double[]' 64
    for ($by = 0; $by -lt 8; $by++) {
        for ($bx = 0; $bx -lt 8; $bx++) {
            $sum = 0.0
            for ($y = 0; $y -lt 4; $y++) { for ($x = 0; $x -lt 6; $x++) { $sum += [double]$Sig[($by * 4 + $y) * 48 + ($bx * 6 + $x)] } }
            $blk[$by * 8 + $bx] = $sum / 24.0
        }
    }
    $mean = ($blk | Measure-Object -Average).Average
    [uint64]$bits = 0
    for ($i = 0; $i -lt 64; $i++) { if ($blk[$i] -gt $mean) { $bits = $bits -bor ([uint64]1 -shl $i) } }
    return $bits.ToString('x16')
}
function Measure-HashDistance([string]$A, [string]$B) {
    if ([string]::IsNullOrEmpty($A) -or [string]::IsNullOrEmpty($B)) { return 64 }
    try { return [int][System.Numerics.BitOperations]::PopCount([Convert]::ToUInt64($A, 16) -bxor [Convert]::ToUInt64($B, 16)) } catch { return 64 }
}
function Test-ActionIdempotency($a, [string]$kind, [switch]$Commit, [switch]$SkipLocks) {
    $idv = Get-ActProp $a 'action_id'
    if ($null -eq $idv -or "$idv" -notmatch '^\d+$') { return [pscustomobject]@{ Ok = $true; Code = 'NO_ID'; Detail = '' } }
    $id = [long]"$idv"
    $fp = Get-ActionFingerprint $a $kind
    if ($id -le $script:ExtLastActionId) {
        $prev = $null
        if ($script:IdemCache.TryGetValue("$id", [ref]$prev) -and $prev -eq $fp) { return [pscustomobject]@{ Ok = $false; Code = 'IDEMPOTENT_REPLAY'; Detail = "action_id=$id 已执行过（IPC 重试），拒绝重复提交" } }
        return [pscustomobject]@{ Ok = $false; Code = 'STALE_ACTION_ID'; Detail = "action_id=$id <= 已提交的最大 id=$($script:ExtLastActionId)（必须单调递增）" }
    }
    if (-not $SkipLocks -and ('DsNative61' -as [type])) {
        $eh = Get-ActProp $a 'expect_hwnd'
        if ($null -ne $eh -and "$eh" -match '^\d+$') {
            $cur = [int64][DsNative61]::Root([DsNative61]::GetForegroundWindow())
            if ($cur -ne [int64]"$eh") { return [pscustomobject]@{ Ok = $false; Code = 'STALE_HWND'; Detail = "目标窗口句柄已变化（期望 $eh，当前 $cur），乐观锁拒绝执行" } }
        }
        $ef = Get-ActProp $a 'expect_fp'
        if ($null -ne $ef -and "$ef" -match '^[0-9a-fA-F]{16}$') {
            $now = Get-LiveRegionAHash   # v8.0 Phase 6：驱动在线时 capture.ahash
            $d = Measure-HashDistance "$ef" $now
            if ($d -gt 10) { return [pscustomobject]@{ Ok = $false; Code = 'STALE_REGION'; Detail = "区域像素指纹漂移 Hamming=$d（>10），界面已变化，乐观锁拒绝执行" } }
        }
    }
    if ($Commit) {
        $script:ExtLastActionId = $id
        $script:IdemCache["$id"] = $fp
        if ($script:IdemCache.Count -gt 512) { $first = $script:IdemCache.Keys | Select-Object -First 1; [void]$script:IdemCache.Remove($first) }
    }
    return [pscustomobject]@{ Ok = $true; Code = 'COMMITTED'; Detail = "action_id=$id" }
}
function Register-ActionStart($a, [string]$kind) {
    $script:ActionSeq = [long]$script:ActionSeq + 1
    if (-not $script:Orchestrated) { return }
    $r = Test-ActionIdempotency $a $kind -Commit
    if (-not $r.Ok) { throw (New-SecError "IPC_$($r.Code)" $r.Detail) }
}

# ---------------- 3. IPC 信封契约 v1（Named Pipe NDJSON；帧数据走共享内存，不走 Base64） ----------------
function New-IpcEnvelope([string]$Method, $Params = @{}, [long]$ActionId = 0) {
    $script:IpcSeq = [long]$script:IpcSeq + 1
    $e = [ordered]@{ v = $script:IpcVersion; id = $script:IpcSeq; method = $Method; params = $Params; ts = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds() }
    if ($ActionId -gt 0) { $e['action_id'] = $ActionId }
    return $e
}
function Test-IpcEnvelope($o) {
    if ($null -eq $o) { return [pscustomobject]@{ Ok = $false; Reason = 'null' } }
    $v = Get-ActProp $o 'v'; $id = Get-ActProp $o 'id'; $m = Get-ActProp $o 'method'; $aid = Get-ActProp $o 'action_id'
    if ("$v" -ne "$($script:IpcVersion)") { return [pscustomobject]@{ Ok = $false; Reason = "unsupported version '$v'" } }
    if ("$id" -notmatch '^\d+$') { return [pscustomobject]@{ Ok = $false; Reason = 'id must be uint' } }
    if ("$m" -notmatch '^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$') { return [pscustomobject]@{ Ok = $false; Reason = "bad method '$m'" } }
    if ($null -ne $aid -and "$aid" -notmatch '^\d+$') { return [pscustomobject]@{ Ok = $false; Reason = 'action_id must be uint' } }
    return [pscustomobject]@{ Ok = $true; Reason = '' }
}

# ---------------- 4. Golden-Trace：录制「动作 → 安全裁决」轨迹，并在新实现上重放，要求 100% 等价 ----------------
function Get-GoldenActionView($a, [string]$kind) {
    $v = [ordered]@{ action = $kind }
    foreach ($k in 'path', 'command', 'target', 'args', 'id', 'x', 'y', 'keys', 'title') {
        $p = Get-ActProp $a $k
        if ($null -ne $p -and "$p" -ne '') { $v[$k] = (Limit-Text (Protect-SkillText "$p") 400) }
    }
    $t = Get-ActProp $a 'text'
    if ($null -ne $t) { $v['textLen'] = "$t".Length }
    return $v
}
function Write-GoldenLine($obj) {
    if (-not $script:GoldenFile) { return }
    try { [System.IO.File]::AppendAllText($script:GoldenFile, (($obj | ConvertTo-Json -Compress -Depth 6) + "`n"), [System.Text.UTF8Encoding]::new($false)) } catch { }
}
function Write-GoldenEntry($a, [string]$kind, [string]$deny) {
    if (-not $script:GoldenFile) { return }
    try {
        $script:GoldenSeq++
        $code = ''
        if ($deny -and $deny -match '(SECURITY_[A-Z_]+|IPC_[A-Z_]+)') { $code = $Matches[1] }
        Write-GoldenLine ([ordered]@{
                type = 'golden_action'; seq = $script:GoldenSeq; aid = [long]$script:ActionSeq; view = (Get-GoldenActionView $a $kind)
                replayable = ($kind -in 'write_file', 'run_powershell', 'launch', 'run_process')
                tainted = [bool]$script:Taint.Tainted; injection = [bool]$script:Taint.TaskInjection; ws = "$($script:WorkspaceRoot)"
                verdict = $(if ($deny) { 'deny' } else { 'allow' }); code = $code; hitl = @($script:HitlTrail.ToArray())
            })
        $script:HitlTrail.Clear()
    }
    catch { }
}
function Get-GoldenCorpusRows {
    $rows = [System.Collections.Generic.List[object]]::new()
    $idx = @{}
    foreach ($r in @(Invoke-SecurityCorpus)) {
        $c = "$($r.Cat)"; if (-not $idx.ContainsKey($c)) { $idx[$c] = 0 }; $idx[$c]++
        $rows.Add([pscustomobject]@{ Key = ('{0}#{1:D3}|{2}' -f $c, $idx[$c], $r.Id); Actual = "$($r.Actual)" })
    }
    return $rows.ToArray()
}
function Get-GoldenDigest($Rows) {
    $txt = (@($Rows) | ForEach-Object { "$($_.Key)=$($_.Actual)" }) -join "`n"
    return [Convert]::ToHexString([System.Security.Cryptography.SHA256]::HashData([System.Text.Encoding]::UTF8.GetBytes($txt))).ToLower()
}
function Write-GoldenHeader {
    if (-not $script:GoldenFile) { return }
    $rows = @(Get-GoldenCorpusRows)
    Write-GoldenLine ([ordered]@{ type = 'golden_meta'; schema = 'dscu.golden/1'; version = '7.1'; ps = "$($PSVersionTable.PSVersion)"; workspace = "$($script:WorkspaceRoot)"; corpusN = $rows.Count; digest = (Get-GoldenDigest $rows); ts = (Get-Date).ToString('o') })
    foreach ($r in $rows) { Write-GoldenLine ([ordered]@{ type = 'golden_corpus'; key = $r.Key; actual = $r.Actual }) }
}
function Invoke-GoldenReplayAction($e) {
    $sv = @{ R = $script:HitlResponder; T = $script:Taint.Tainted; I = $script:Taint.TaskInjection; S = $script:SafeOn }
    $q = [System.Collections.Generic.Queue[bool]]::new()
    foreach ($h in @($e.hitl)) { $q.Enqueue([bool]$h) }
    $verdict = 'allow'; $code = ''
    try {
        $o = [ordered]@{}
        foreach ($p in $e.view.PSObject.Properties) { $o[$p.Name] = $p.Value }
        $kind = "$($o['action'])"
        $a = [pscustomobject]$o
        $script:SafeOn = $true
        $script:Taint.Tainted = [bool]$e.tainted; $script:Taint.TaskInjection = [bool]$e.injection
        $script:HitlResponder = { param($k, $d, $dom) if ($q.Count -gt 0) { return $q.Dequeue() } return $false }.GetNewClosure()
        Assert-ActionPolicy $a $kind
    }
    catch {
        $verdict = 'deny'
        if ("$($_.Exception.Message)" -match '(SECURITY_[A-Z_]+|IPC_[A-Z_]+)') { $code = $Matches[1] }
    }
    finally {
        $script:HitlResponder = $sv.R; $script:Taint.Tainted = $sv.T; $script:Taint.TaskInjection = $sv.I; $script:SafeOn = $sv.S
    }
    return [pscustomobject]@{ Verdict = $verdict; Code = $code }
}
function Invoke-GoldenVerify([string]$Path) {
    if (-not (Test-Path -LiteralPath $Path)) { throw "Golden 轨迹文件不存在：$Path" }
    $rows = @([System.IO.File]::ReadAllLines($Path, [System.Text.Encoding]::UTF8) | Where-Object { $_.Trim() } | ForEach-Object { try { $_ | ConvertFrom-Json } catch { $null } } | Where-Object { $_ })
    $meta = $rows | Where-Object { $_.type -eq 'golden_meta' } | Select-Object -First 1
    $svWs = $script:WorkspaceRoot; $svSafe = $script:SafeOn
    $total = 0; $match = 0; $bad = [System.Collections.Generic.List[string]]::new()
    try {
        if ($meta -and $meta.workspace) { $script:WorkspaceRoot = "$($meta.workspace)" }
        elseif (-not $script:WorkspaceRoot) { $script:WorkspaceRoot = Join-Path ([System.IO.Path]::GetTempPath()) 'DeepSeekComputerUse\workspace\golden' }
        $script:SafeOn = $true
        $cur = @{}
        foreach ($r in @(Get-GoldenCorpusRows)) { $cur[$r.Key] = $r.Actual }
        foreach ($r in @($rows | Where-Object { $_.type -eq 'golden_corpus' })) {
            $total++
            if ($cur.ContainsKey("$($r.key)") -and $cur["$($r.key)"] -eq "$($r.actual)") { $match++ } else { $bad.Add("corpus:$($r.key) 期望=$($r.actual) 实际=$($cur["$($r.key)"])") }
        }
        foreach ($e in @($rows | Where-Object { $_.type -eq 'golden_action' -and $_.replayable })) {
            $total++
            if ($e.ws) { $script:WorkspaceRoot = "$($e.ws)" }
            $res = Invoke-GoldenReplayAction $e
            if ($res.Verdict -eq "$($e.verdict)" -and ($res.Verdict -eq 'allow' -or "$($res.Code)" -eq "$($e.code)")) { $match++ } else { $bad.Add("action#$($e.seq) $($e.view.action) 期望=$($e.verdict)/$($e.code) 实际=$($res.Verdict)/$($res.Code)") }
        }
    }
    finally { $script:WorkspaceRoot = $svWs; $script:SafeOn = $svSafe }
    return [pscustomobject]@{ File = $Path; Total = $total; Match = $match; Equivalence = $(if ($total -eq 0) { 0.0 } else { [Math]::Round($match / $total, 6) }); Mismatches = $bad.ToArray(); Digest = $(if ($meta) { "$($meta.digest)" } else { '' }) }
}

# ---------------- 5. 评测适配器：WAA / OSWorld / AgentDojo / ScreenSpot-Pro（-ExportWaaReport，-BenchFormat 选择） ----------------
function Read-RunTasks([int]$MaxRuns = 20) {
    $roots = [System.Collections.Generic.List[string]]::new()
    if (-not [string]::IsNullOrWhiteSpace($LogDir)) { $roots.Add($LogDir) }
    if ($env:LOCALAPPDATA) { $roots.Add((Join-Path $env:LOCALAPPDATA 'DeepSeekComputerUse\logs')) }
    $roots.Add((Join-Path ([System.IO.Path]::GetTempPath()) 'DeepSeekComputerUse\logs'))
    $files = @()
    foreach ($r in $roots) { if (Test-Path -LiteralPath $r) { $files += @(Get-ChildItem -LiteralPath $r -Filter run.jsonl -Recurse -File -ErrorAction SilentlyContinue) } }
    $files = @($files | Sort-Object LastWriteTime -Descending | Select-Object -First $MaxRuns)
    $tasks = [System.Collections.Generic.List[object]]::new()
    foreach ($f in $files) {
        $cur = @{}
        foreach ($ln in [System.IO.File]::ReadLines($f.FullName)) {
            if ([string]::IsNullOrWhiteSpace($ln)) { continue }
            try { $o = $ln | ConvertFrom-Json } catch { continue }
            $tn = [int]$o.taskNo
            switch ("$($o.type)") {
                'task_start' { $cur[$tn] = [ordered]@{ run = $f.Directory.Name; taskNo = $tn; instruction = "$($o.task)"; steps = 0; status = 'unknown'; summary = ''; start = "$($o.time)"; end = "$($o.time)"; fast = $false }; break }
                'action' { if ($cur.ContainsKey($tn)) { $cur[$tn].steps++; $cur[$tn].end = "$($o.time)" }; break }
                'fastpath' { if ($cur.ContainsKey($tn)) { $cur[$tn].fast = $true }; break }
                'done' { if ($cur.ContainsKey($tn)) { $cur[$tn].status = 'success'; $cur[$tn].summary = "$($o.summary)"; $cur[$tn].end = "$($o.time)" }; break }
                'fail' { if ($cur.ContainsKey($tn)) { $cur[$tn].status = 'failure'; $cur[$tn].summary = "$($o.reason)"; $cur[$tn].end = "$($o.time)" }; break }
                'abort' { if ($cur.ContainsKey($tn)) { $cur[$tn].status = 'aborted'; $cur[$tn].end = "$($o.time)" }; break }
                default { }
            }
        }
        foreach ($k in ($cur.Keys | Sort-Object)) { $tasks.Add([pscustomobject]$cur[$k]) }
    }
    return $tasks.ToArray()
}
function New-BenchReport([string]$Format, $Tasks) {
    $n = @($Tasks).Count
    $ok = @($Tasks | Where-Object { $_.status -eq 'success' }).Count
    $avgSteps = if ($n -gt 0) { [Math]::Round((@($Tasks) | Measure-Object -Property steps -Average).Average, 2) } else { 0 }
    $agent = [ordered]@{ name = 'deepseek-computer-use'; version = '7.1'; model = "$Model"; vision_model = "$VisionModel"; perception = 'CDP>UIA>SoM+VLM>WinRT-OCR' }
    $lat = @(Get-SpanStats | ForEach-Object { [ordered]@{ plane = $_.Plane; n = $_.N; p50_ms = $_.P50; p99_ms = $_.P99 } })
    switch ($Format) {
        'waa' {
            return [ordered]@{
                benchmark = 'WindowsAgentArena'; adapter = 'dscu-waa/1'; agent = $agent; generated = (Get-Date).ToString('o')
                summary = [ordered]@{ tasks = $n; success = $ok; success_rate = $(if ($n) { [Math]::Round($ok / $n, 4) } else { 0 }); avg_steps = $avgSteps }
                results = @($Tasks | ForEach-Object { [ordered]@{ task_id = "$($_.run)-t$($_.taskNo)"; instruction = $_.instruction; result = $(if ($_.status -eq 'success') { 1 } else { 0 }); status = $_.status; steps = $_.steps; fast_path = $_.fast; summary = $_.summary } })
                latency = $lat
            }
        }
        'osworld' {
            return [ordered]@{
                benchmark = 'OSWorld'; adapter = 'dscu-osworld/1'; agent = $agent; generated = (Get-Date).ToString('o'); observation_type = 'a11y_tree+screenshot'; action_space = 'computer_13-compatible(pyautogui-style)'
                results = @($Tasks | ForEach-Object { [ordered]@{ example_id = "$($_.run)-t$($_.taskNo)"; domain = 'os'; instruction = $_.instruction; score = $(if ($_.status -eq 'success') { 1.0 } else { 0.0 }); num_steps = $_.steps } })
                average_score = $(if ($n) { [Math]::Round($ok / $n, 4) } else { 0 })
            }
        }
        'agentdojo' {
            $st = Get-CorpusStats (Invoke-SecurityCorpus)
            return [ordered]@{
                benchmark = 'AgentDojo'; adapter = 'dscu-agentdojo/1'; agent = $agent; generated = (Get-Date).ToString('o')
                utility = $(if ($n) { [Math]::Round($ok / $n, 4) } else { $null })
                security = [ordered]@{ injection_detect_rate = $st.InjectionDetectRate; injection_clean_rate = $st.InjectionCleanRate; targeted_asr_upper_bound = [Math]::Round(1.0 - [double]$st.InjectionDetectRate, 4); path_escape_block_rate = $st.PathEscapeBlockRate; ast_danger_block_rate = $st.AstDangerBlockRate }
                defenses = @('normalize(NFKC/zero-width/homoglyph/base64)', 'taint_tracking', 'capability_policy', 'HITL')
                note = '与 AgentDojo 官方 workspace/banking/travel/slack 套件对接需把本代理注册为其 BasePipelineElement；此处输出同口径的 utility / security 字段。'
            }
        }
        'screenspot' {
            return [ordered]@{
                benchmark = 'ScreenSpot-Pro'; adapter = 'dscu-screenspot/1'; agent = $agent; generated = (Get-Date).ToString('o')
                protocol = [ordered]@{ input = 'screenshot(PNG)+instruction'; output = [ordered]@{ point = @('x', 'y'); coordinate_space = 'physical_pixels(PerMonitorV2)' }; metric = 'point-in-bbox accuracy' }
                grounding_channels = @('CDP', 'UIA', 'SoM+VLM', 'WinRT-OCR')
                latency = $lat
                note = '逐样本评测需外部 ScreenSpot-Pro 数据集；此处输出评测协议头与本机各感知通道 P50/P99 延迟。'
            }
        }
        default { throw "未知基准格式 '$Format'（waa / osworld / agentdojo / screenspot / all）" }
    }
}
function Export-BenchReport([string]$Format = 'waa', [string]$OutDir = '') {
    $tasks = @(Read-RunTasks)
    if ([string]::IsNullOrWhiteSpace($OutDir)) {
        $OutDir = if ($env:LOCALAPPDATA) { Join-Path $env:LOCALAPPDATA 'DeepSeekComputerUse\reports' } else { Join-Path ([System.IO.Path]::GetTempPath()) 'DeepSeekComputerUse\reports' }
    }
    if (-not (Test-Path -LiteralPath $OutDir)) { [void][System.IO.Directory]::CreateDirectory($OutDir) }
    $fmts = if ($Format -eq 'all') { @('waa', 'osworld', 'agentdojo', 'screenspot') } else { @($Format) }
    $paths = [System.Collections.Generic.List[string]]::new()
    foreach ($f in $fmts) {
        $rep = New-BenchReport $f $tasks
        $p = Join-Path $OutDir ("bench-{0}-{1}.json" -f $f, (Get-Date -Format 'yyyyMMdd-HHmmss'))
        [System.IO.File]::WriteAllText($p, ($rep | ConvertTo-Json -Depth 10), [System.Text.UTF8Encoding]::new($false))
        $paths.Add($p)
    }
    return [pscustomobject]@{ Tasks = $tasks.Count; Paths = $paths.ToArray() }
}

# ---------------- 6. v7.1 纯逻辑自检（不碰鼠标键盘；-SelfTest 调用） ----------------
function Invoke-V71SelfTest($rec) {
    # ① 百分位算法（最近秩法）
    $v = [double[]](1..100)
    $p50 = Get-Percentile $v 50; $p99 = Get-Percentile $v 99; $p1 = Get-Percentile ([double[]]@(7.5)) 99
    & $rec 'v7.1 Span 百分位：P50=50 / P99=99 / 单样本' (($p50 -eq 50) -and ($p99 -eq 99) -and ($p1 -eq 7.5)) "P50=$p50 P99=$p99 single=$p1"

    # ② Span 聚合 + OTLP/JSON 结构
    $svSp = $script:Spans; $svOn = $script:SpanOn; $svTask = $script:TaskNo
    try {
        $script:Spans = [System.Collections.Generic.List[object]]::new(); $script:SpanOn = $true; $script:TaskNo = 77
        foreach ($ms in 1..10) { Add-Span 'capture' ([double]$ms) 'dxgi' }
        Add-Span 'input' 12.5 'click'; Add-Span 'network' 840 'deepseek'
        $st = @(Get-SpanStats 77); $cap = $st | Where-Object { $_.Plane -eq 'capture' } | Select-Object -First 1
        $doc = ConvertTo-OtlpDocument; $sp0 = $doc.resourceSpans[0].scopeSpans[0].spans
        $js = $doc | ConvertTo-Json -Depth 12 -Compress
        $okDoc = ($sp0.Count -eq 12) -and ("$($sp0[0].traceId)".Length -eq 32) -and ("$($sp0[0].spanId)".Length -eq 16) -and ($js -match 'service\.name') -and ([long]$sp0[0].endTimeUnixNano -gt [long]$sp0[0].startTimeUnixNano)
        & $rec 'v7.1 OpenTelemetry：Capture/Input/Network Span 聚合与 OTLP-JSON 结构' (($st.Count -eq 3) -and ($cap.N -eq 10) -and ($cap.P50 -eq 5) -and ($cap.P99 -eq 10) -and $okDoc) "planes=$($st.Count) capP50=$($cap.P50) capP99=$($cap.P99) otlpSpans=$($sp0.Count)"
    }
    finally { $script:Spans = $svSp; $script:SpanOn = $svOn; $script:TaskNo = $svTask }

    # ③ 幂等 + 乐观锁（action_id 单调；重复提交 / 过期 id 被拒；无 id 的普通动作不受影响）
    $svId = $script:ExtLastActionId; $svCache = $script:IdemCache; $svSeq = $script:ActionSeq; $svOrch = $script:Orchestrated
    try {
        $script:ExtLastActionId = 0L; $script:IdemCache = [System.Collections.Generic.Dictionary[string, string]]::new()
        $a1 = [pscustomobject]@{ action = 'click'; id = 5; action_id = 1 }
        $r1 = Test-ActionIdempotency $a1 'click' -Commit -SkipLocks
        $r2 = Test-ActionIdempotency $a1 'click' -Commit -SkipLocks
        $r3 = Test-ActionIdempotency ([pscustomobject]@{ action = 'click'; id = 9; action_id = 1 }) 'click' -Commit -SkipLocks
        $r4 = Test-ActionIdempotency ([pscustomobject]@{ action = 'click'; id = 5; action_id = 2 }) 'click' -Commit -SkipLocks
        $r5 = Test-ActionIdempotency ([pscustomobject]@{ action = 'click'; id = 5 }) 'click' -Commit -SkipLocks
        $script:Orchestrated = $false; $script:ActionSeq = 10L
        Register-ActionStart ([pscustomobject]@{ action = 'click'; action_id = 1 }) 'click'
        $noThrow = ($script:ActionSeq -eq 11L)
        & $rec 'v7.1 幂等状态机：单调 action_id / 重复提交拒绝 / 过期 id 拒绝 / 无 id 动作零影响' ($r1.Ok -and ($r2.Code -eq 'IDEMPOTENT_REPLAY') -and ($r3.Code -eq 'STALE_ACTION_ID') -and $r4.Ok -and ($r5.Code -eq 'NO_ID') -and $noThrow) "r1=$($r1.Code) r2=$($r2.Code) r3=$($r3.Code) r4=$($r4.Code) r5=$($r5.Code)"
    }
    finally { $script:ExtLastActionId = $svId; $script:IdemCache = $svCache; $script:ActionSeq = $svSeq; $script:Orchestrated = $svOrch }

    # ④ 区域指纹 aHash：同图 0 位差、反色大差、轻微噪声 ≤10 位
    $sigA = New-Object 'byte[]' 1536; for ($i = 0; $i -lt 1536; $i++) { $sigA[$i] = [byte](($i % 48) * 5) }
    $sigB = [byte[]]@($sigA | ForEach-Object { [byte](255 - $_) })
    $sigC = [byte[]]$sigA.Clone(); for ($i = 0; $i -lt 1536; $i += 97) { $sigC[$i] = [byte](($sigC[$i] + 6) % 256) }
    $hA = Get-RegionAHash $sigA; $hB = Get-RegionAHash $sigB; $hC = Get-RegionAHash $sigC
    $dAA = Measure-HashDistance $hA $hA; $dAB = Measure-HashDistance $hA $hB; $dAC = Measure-HashDistance $hA $hC
    & $rec 'v7.1 乐观锁区域指纹 aHash（64 位，Hamming 判漂移）' (($hA.Length -eq 16) -and ($dAA -eq 0) -and ($dAB -ge 48) -and ($dAC -le 10)) "同图=$dAA 反色=$dAB 噪声=$dAC"

    # ⑤ IPC 信封契约 v1
    $env1 = New-IpcEnvelope 'capture.frame' @{ w = 48; h = 32 } 7
    $okE = (Test-IpcEnvelope $env1).Ok
    $badV = (Test-IpcEnvelope ([ordered]@{ v = 2; id = 1; method = 'capture.frame' })).Ok
    $badM = (Test-IpcEnvelope ([ordered]@{ v = 1; id = 1; method = 'Capture Frame!' })).Ok
    $badA = (Test-IpcEnvelope ([ordered]@{ v = 1; id = 1; method = 'uia.tree'; action_id = 'x' })).Ok
    & $rec 'v7.1 IPC 信封契约 v1（版本 / id / method 命名 / action_id 校验）' ($okE -and -not $badV -and -not $badM -and -not $badA) "valid=$okE badVersion=$badV badMethod=$badM badActionId=$badA"

    # ⑥ Golden-Trace：同一策略引擎两次独立执行 → 摘要逐字节一致，重放 100% 等价
    $tmp = Join-Path ([System.IO.Path]::GetTempPath()) ("dscu-golden-{0}.jsonl" -f $PID)
    $svGF = $script:GoldenFile; $svGS = $script:GoldenSeq; $svWs = $script:WorkspaceRoot; $svSafe = $script:SafeOn
    try {
        $rows1 = @(Get-GoldenCorpusRows); $rows2 = @(Get-GoldenCorpusRows)
        $d1 = Get-GoldenDigest $rows1; $d2 = Get-GoldenDigest $rows2
        $script:GoldenFile = $tmp; $script:GoldenSeq = 0; $script:SafeOn = $true
        if (-not $script:WorkspaceRoot) { $script:WorkspaceRoot = 'C:\DeepSeekWs\task01' }
        if (Test-Path -LiteralPath $tmp) { Remove-Item -LiteralPath $tmp -Force }
        Write-GoldenHeader
        $svHr = $script:HitlResponder; $script:HitlResponder = { $false }   # 自检期间任何高危确认一律拒绝，绝不弹窗
        try {
            foreach ($case in @(
                    @{ k = 'write_file'; a = [pscustomobject]@{ action = 'write_file'; path = '..\..\Windows\win.ini'; content = 'x' } },
                    @{ k = 'run_powershell'; a = [pscustomobject]@{ action = 'run_powershell'; command = 'Invoke-Expression "calc"' } },
                    @{ k = 'write_file'; a = [pscustomobject]@{ action = 'write_file'; path = 'golden-ok.txt'; content = 'x' } })) {
                $deny = ''
                try { Assert-ActionPolicy $case.a $case.k } catch { $deny = "$($_.Exception.Message)" }
                Write-GoldenEntry $case.a $case.k $deny   # 用真实引擎的裁决录制，再重放：验证「录制 = 重放」逐条等价
            }
        }
        finally { $script:HitlResponder = $svHr }
        $script:GoldenFile = $null
        $vr = Invoke-GoldenVerify $tmp
        $corpusOk = ($vr.Total -eq (@($rows1).Count + 3)) -and ($vr.Mismatches.Count -eq 0)
        & $rec 'v7.1 Golden-Trace 差分：策略引擎确定性 + 录制轨迹重放等价' (($d1 -eq $d2) -and $corpusOk -and ($vr.Equivalence -eq 1)) "digest=$($d1.Substring(0, 12)) total=$($vr.Total) match=$($vr.Match) equiv=$($vr.Equivalence)"
    }
    finally {
        $script:GoldenFile = $svGF; $script:GoldenSeq = $svGS; $script:WorkspaceRoot = $svWs; $script:SafeOn = $svSafe
        try { if (Test-Path -LiteralPath $tmp) { Remove-Item -LiteralPath $tmp -Force } } catch { }
    }

    # ⑦ 基准适配器：四种格式的必备字段
    $fake = @([pscustomobject]@{ run = 'r1'; taskNo = 1; instruction = '打开记事本'; steps = 2; status = 'success'; summary = 'ok'; fast = $true }, [pscustomobject]@{ run = 'r1'; taskNo = 2; instruction = 'x'; steps = 9; status = 'failure'; summary = 'no'; fast = $false })
    $bw = New-BenchReport 'waa' $fake; $bo = New-BenchReport 'osworld' $fake; $bs = New-BenchReport 'screenspot' $fake
    & $rec 'v7.1 评测适配器：WAA / OSWorld / ScreenSpot-Pro 报告字段' (($bw.summary.tasks -eq 2) -and ($bw.summary.success_rate -eq 0.5) -and ($bo.average_score -eq 0.5) -and ($bs.protocol.output.coordinate_space -match 'physical')) "waaRate=$($bw.summary.success_rate) osworld=$($bo.average_score)"

    # ⑧ 内存熔断统一：MinFreeGB 与 MemoryFloorMB 同源
    $okFloor = ([int]$script:MemoryFloorMB -eq [int]([double]$MinFreeGB * 1024))
    & $rec 'v7.1 内存熔断统一：MinFreeGB 与 MemoryFloorMB 同源（默认 4GB / 4096MB）' $okFloor "MinFreeGB=$MinFreeGB MemoryFloorMB=$($script:MemoryFloorMB)"
}
