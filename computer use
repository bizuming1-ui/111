        "gmail_per_id_trash_verified_rate": round(getattr(m, "verify_rate", 0.0), 6),
        "verified_success_rate": round(getattr(s, "verified_success_rate", 0.0), 6),
        "false_success_rate": round(getattr(s, "false_success_rate", 1.0), 6),
        "misoperation_rate": round(getattr(s, "misoperation_rate", 1.0), 6),
    }
    gates = {
