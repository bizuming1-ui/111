// First-class browser actions for the CDP daemon (v9.1): navigate / waitSelector / waitSettled / inflight tracking.
// Zero dependencies. These are the TypeScript twin of PowerShell `Invoke-CdpNavigate` / `Invoke-CdpWaitSelector` / `Wait-CdpSettled`
// so a long-lived daemon can serve them without re-attaching a WebSocket per call.
import type { CdpSession } from './daemon.ts';

export class ActionError extends Error { constructor(readonly code: string, msg: string) { super(`[${code}] ${msg}`); } }

/** Mirrors ConvertTo-NavUrl: only http(s) and about:blank; bare domains get https://. Rejects javascript:/data:/file:/ftp:... */
export function normalizeUrl(raw: string): string {
  let u = String(raw ?? '').trim().replace(/^["']|["']$/g, '');
  if (!u) throw new ActionError('BAD_URL', 'url is required');
  const bad = /^(javascript|data|file|vbscript|blob|ftp|chrome-extension|view-source|ws|wss):/i.exec(u);
  if (bad) throw new ActionError('SECURITY_EXEC_VIOLATION', `scheme ${bad[1]}: is not allowed (http/https/about:blank only)`);
  if (u === 'about:blank') return u;
  if (!/^https?:\/\//i.test(u)) {
    if (u.startsWith('//')) u = 'https:' + u;
    else if (/^(localhost|(?:[a-z0-9-]+\.)+[a-z]{2,}|\d{1,3}(?:\.\d{1,3}){3})(?::\d+)?([/?#].*)?$/i.test(u)) u = 'https://' + u;
    else throw new ActionError('BAD_URL', `not a valid url: ${u.slice(0, 80)}`);
  }
  let parsed: URL; try { parsed = new URL(u); } catch { throw new ActionError('BAD_URL', `cannot parse: ${u.slice(0, 80)}`); }
  if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') throw new ActionError('SECURITY_EXEC_VIOLATION', `scheme ${parsed.protocol} is not allowed`);
  return parsed.href;
}

/** In-flight request counter (Network.*): the "network idle" half of Wait-CdpSettled. */
export class InflightTracker {
  private ids = new Set<string>(); lastActivity = Date.now();
  constructor(s: CdpSession) {
    const add = (p: any) => { if (p?.requestId) { this.ids.add(p.requestId); this.lastActivity = Date.now(); } };
    const del = (p: any) => { if (p?.requestId) { this.ids.delete(p.requestId); this.lastActivity = Date.now(); } };
    s.on('Network.requestWillBeSent', add); s.on('Network.loadingFinished', del); s.on('Network.loadingFailed', del);
  }
  get count(): number { return this.ids.size; }
}
export function trackInflight(s: CdpSession): InflightTracker { return new InflightTracker(s); }

export interface SettleOpts { quietMs?: number; timeoutMs?: number; pollMs?: number }
/** Deterministic wait: readyState==='complete' AND in-flight==0 held for quietMs (default 250), within timeoutMs (default 5000). */
export async function waitSettled(s: CdpSession, inflight: InflightTracker | undefined, o: SettleOpts = {}): Promise<boolean> {
  const quiet = o.quietMs ?? 250, timeout = o.timeoutMs ?? 5000, poll = o.pollMs ?? 80;
  const t0 = Date.now(); let calmSince = 0;
  while (Date.now() - t0 < timeout) {
    let rs = ''; try { rs = (await s.send<any>('Runtime.evaluate', { expression: 'document.readyState', returnByValue: true })).result?.value ?? ''; } catch { /* navigation in progress */ }
    const calm = rs === 'complete' && (inflight?.count ?? 0) === 0;
    if (calm) { calmSince ||= Date.now(); if (Date.now() - calmSince >= quiet) return true; } else calmSince = 0;
    await new Promise((r) => setTimeout(r, poll));
  }
  return false;
}

export interface NavResult { requested: string; url: string; title: string; readyState: string; settled: boolean; redirectedHost: boolean; ms: number }
export async function navigate(s: CdpSession, rawUrl: string, inflight?: InflightTracker, o: SettleOpts = {}): Promise<NavResult> {
  const requested = normalizeUrl(rawUrl); const t0 = Date.now();
  const r = await s.send<{ errorText?: string }>('Page.navigate', { url: requested });
  if (r?.errorText) throw new ActionError('NAV_FAILED', `${r.errorText} (${requested.slice(0, 100)})`);
  const settled = await waitSettled(s, inflight, { timeoutMs: 6000, ...o });
  let info: { u?: string; t?: string; s?: string } = {};
  try { info = (await s.send<any>('Runtime.evaluate', { expression: '({u:location.href,t:document.title,s:document.readyState})', returnByValue: true })).result?.value ?? {}; } catch { /* page still swapping */ }
  const url = info.u ?? requested; let redirectedHost = false;
  try { redirectedHost = new URL(url).host !== new URL(requested).host; } catch { /* about:blank */ }
  return { requested, url, title: info.t ?? '', readyState: info.s ?? '?', settled, redirectedHost, ms: Date.now() - t0 };
}

/** Same JS as the PowerShell side: pierces open Shadow DOM and same-origin iframes. */
export const WAIT_SELECTOR_JS = `(()=>{const SEL=__SEL__,TXT=__TXT__,VIS=__VIS__;
function* roots(r,d){yield r;if(d>6)return;let all;try{all=r.querySelectorAll('*')}catch(_){return}
for(const e of all){if(e.shadowRoot)yield* roots(e.shadowRoot,d+1);if(e.tagName==='IFRAME'||e.tagName==='FRAME'){try{if(e.contentDocument)yield* roots(e.contentDocument,d+1)}catch(_){}}}}
let n=0;
for(const r of roots(document,0)){let list=[];try{list=SEL?r.querySelectorAll(SEL):r.querySelectorAll('*')}catch(_){return {ok:false,err:'bad selector'}}
for(const el of list){const t=(el.innerText||el.textContent||'');if(TXT&&t.indexOf(TXT)<0)continue;
if(!SEL&&TXT&&el.children&&el.children.length>0&&Array.from(el.children).some(c=>(c.innerText||c.textContent||'').indexOf(TXT)>=0))continue;
const b=el.getBoundingClientRect();const cs=getComputedStyle(el);
const vis=b.width>0&&b.height>0&&cs.visibility!=='hidden'&&cs.display!=='none';
n++;if(VIS&&!vis)continue;
return {ok:true,tag:el.tagName,text:t.replace(/\\s+/g,' ').slice(0,80),x:Math.round(b.x+b.width/2),y:Math.round(b.y+b.height/2),count:n}}}
return {ok:false,count:n}})()`;

export interface WaitSelectorOpts { selector?: string; text?: string; timeoutMs?: number; visible?: boolean; pollMs?: number }
export interface WaitSelectorResult { ok: boolean; tag?: string; text?: string; x?: number; y?: number; matches: number; ms: number }
export async function waitSelector(s: CdpSession, o: WaitSelectorOpts): Promise<WaitSelectorResult> {
  const sel = o.selector ?? '', txt = o.text ?? '';
  if (!sel && !txt) throw new ActionError('BAD_ARGS', 'selector or text is required');
  if (sel.length > 400) throw new ActionError('BAD_ARGS', 'selector too long');
  const timeout = Math.min(Math.max(o.timeoutMs ?? 8000, 300), 30000), poll = o.pollMs ?? 150;
  const js = WAIT_SELECTOR_JS.replace('__SEL__', JSON.stringify(sel)).replace('__TXT__', JSON.stringify(txt)).replace('__VIS__', (o.visible ?? true) ? 'true' : 'false');
  const t0 = Date.now(); let last = 0;
  for (;;) {
    try {
      const v = (await s.send<any>('Runtime.evaluate', { expression: js, returnByValue: true })).result?.value;
      if (v?.err) throw new ActionError('BAD_SELECTOR', sel.slice(0, 80));
      if (v?.ok) return { ok: true, tag: String(v.tag).toLowerCase(), text: v.text, x: v.x, y: v.y, matches: v.count, ms: Date.now() - t0 };
      last = v?.count ?? 0;
    } catch (e) { if (e instanceof ActionError) throw e; }
    if (Date.now() - t0 >= timeout) return { ok: false, matches: last, ms: Date.now() - t0 };
    await new Promise((r) => setTimeout(r, poll));
  }
}
