# ====================================================================================================================== numerals
_CN = {"零": 0, "〇": 0, "一": 1, "二": 2, "两": 2, "俩": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9}
_NUM = r"(?:\d+|[零〇一二两俩三四五六七八九十百]+)"
_CL = r"(?:个文件|个项目|个|条|项|封|份|张|只|件|篇|行)?"


def cn_to_int(s: str) -> Optional[int]:
    """'3'→3 · '两'→2 · '十'→10 · '十二'→12 · '二十三'→23 · '一百零五'→105.  None when not a number."""
    s = unicodedata.normalize("NFKC", str(s or "")).strip()
    if not s:
        return None
    if s.isdigit():
        return int(s)
    total, cur, seen = 0, 0, False
    for ch in s:
        if ch in _CN:
            cur, seen = _CN[ch], True
        elif ch == "十":
            total += (cur or 1) * 10
            cur, seen = 0, True
        elif ch == "百":
            total += (cur or 1) * 100
            cur, seen = 0, True
        else:
            return None
    return (total + cur) if seen else None


# ====================================================================================================================== selectors
@dataclass(frozen=True)
class OrdinalPart:
    """One positional reference.  kind ∈ head | tail | index | range."""
    kind: str
    n: int = 0                       # head/tail count
    index: Optional[int] = None      # 0-based (first = 0); with from_end=True it counts from the end (last = 0)
    end_index: Optional[int] = None  # inclusive, for range
    from_end: bool = False
    order: str = "listing"           # listing | newest | oldest

    def describe(self) -> str:
        o = "" if self.order == "listing" else f",order={self.order}"
        if self.kind == "head":
            return f"head={self.n}{o}"
        if self.kind == "tail":
            return f"tail={self.n}{o}"
        if self.kind == "index":
            return f"index={'-' if self.from_end else ''}{self.index}{o}"
        return f"range={self.index}..{self.end_index}{o}"

    def pick(self, seq: Sequence[Any]) -> list[int]:
        n = len(seq)
        if self.kind == "head":
            return list(range(min(self.n, n)))
        if self.kind == "tail":
            return list(range(max(0, n - self.n), n))
        if self.kind == "index":
            i = (n - 1 - int(self.index or 0)) if self.from_end else int(self.index or 0)
            return [i] if 0 <= i < n else []
        a, b = int(self.index or 0), int(self.end_index if self.end_index is not None else self.index or 0)
        return [i for i in range(a, b + 1) if 0 <= i < n]

    def requested(self) -> int:
        if self.kind in ("head", "tail"):
            return self.n
        if self.kind == "range":
            return int((self.end_index or 0) - (self.index or 0) + 1)
        return 1


