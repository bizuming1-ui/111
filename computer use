    if (-not $Detached) { $a = @('--parent-pid', "$PID") + $a }   # 会话内启动：随本进程退出（KILL_ON_JOB_CLOSE 之外的第二道保险）
    if ($NoDxgi) { $a += '--no-dxgi' }
