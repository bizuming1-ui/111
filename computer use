#=#=# FILE: dscu-v9/src/ahash.rs
//! 48x32 gray fingerprint helpers. `ahash_from_sig` is bit-exact with the v7.1 PowerShell `Get-RegionAHash`
//! (and with dscu-core::ahash); the extra helpers mirror `Get-PixelDiff` / `Measure-HashDistance`.
pub const SIG_W: usize = 48;
pub const SIG_H: usize = 32;
pub const SIG_LEN: usize = SIG_W * SIG_H;

pub fn ahash_from_sig(sig: &[u8]) -> Option<u64> {
    if sig.len() != SIG_LEN {
        return None;
    }
    let mut sums = [0u32; 64];
    for by in 0..8 {
        for bx in 0..8 {
            let mut s = 0u32;
            for y in 0..4 {
                let row = (by * 4 + y) * SIG_W + bx * 6;
                s += sig[row..row + 6].iter().map(|v| *v as u32).sum::<u32>();
            }
            sums[by * 8 + bx] = s;
        }
    }
    let total: u64 = sums.iter().map(|s| *s as u64).sum();
    let mut bits = 0u64;
    for (i, s) in sums.iter().enumerate() {
        if (*s as u64) * 64 > total {
            bits |= 1u64 << i;
        }
    }
    Some(bits)
}

pub fn hamming64(a: u64, b: u64) -> u32 {
    (a ^ b).count_ones()
}

/// Same as `Measure-HashDistance`: 64 when either side is not a valid <=16 digit hex string.
pub fn hamming_hex(a: &str, b: &str) -> u32 {
    let (a, b) = (a.trim(), b.trim());
    if a.is_empty() || b.is_empty() || a.len() > 16 || b.len() > 16 {
        return 64;
    }
    match (u64::from_str_radix(a, 16), u64::from_str_radix(b, 16)) {
        (Ok(x), Ok(y)) => hamming64(x, y),
        _ => 64,
    }
}

/// `Get-PixelDiff`: percentage (1 decimal, banker's rounding like [Math]::Round) of samples whose |a-b| >= thr.
pub fn pixel_diff_pct(a: &[u8], b: &[u8], thr: u8) -> Option<f64> {
    if a.is_empty() || a.len() != b.len() {
        return None;
    }
    let n = a.iter().zip(b).filter(|(x, y)| x.abs_diff(**y) >= thr).count();
    Some((1000.0 * n as f64 / a.len() as f64).round_ties_even() / 10.0)
}

/// 8x8 block dirty mask over two signatures: bit (by*8+bx) set when >= `min_px` of the block's 24 samples differ by >= thr.
pub fn block_mask(a: &[u8], b: &[u8], thr: u8, min_px: u32) -> Option<u64> {
    if a.len() != SIG_LEN || b.len() != SIG_LEN {
        return None;
    }
    let mut mask = 0u64;
    for by in 0..8 {
        for bx in 0..8 {
            let mut c = 0u32;
            for y in 0..4 {
                let row = (by * 4 + y) * SIG_W + bx * 6;
                for x in 0..6 {
                    if a[row + x].abs_diff(b[row + x]) >= thr {
                        c += 1;
                    }
                }
            }
            if c >= min_px {
                mask |= 1u64 << (by * 8 + bx);
            }
        }
    }
    Some(mask)
}

/// Greedy merge of a block mask into rectangles `(bx, by, bw, bh)` in block units (row runs, then vertical merge).
pub fn mask_to_rects(mask: u64) -> Vec<(u8, u8, u8, u8)> {
    let mut rects: Vec<(u8, u8, u8, u8)> = Vec::new();
    for by in 0..8u8 {
        let mut bx = 0u8;
        while bx < 8 {
            if mask >> (by * 8 + bx) & 1 == 1 {
                let start = bx;
                while bx < 8 && mask >> (by * 8 + bx) & 1 == 1 {
                    bx += 1;
                }
                let w = bx - start;
                if let Some(r) = rects.iter_mut().find(|r| r.0 == start && r.2 == w && r.1 + r.3 == by) {
                    r.3 += 1;
                } else {
