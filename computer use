class ActionGate:
    """Hard action-space masking: rules refuse before anything touches the desktop."""

    @staticmethod
    def check(a: dict[str, Any], obs: Observation, st: TaskState, els: dict[int, Element]) -> Optional[tuple[Code, str]]:
        name = a.get("action", "")
        if st.mask_active(name):
            return Code.SECURITY_DENIED, f"[MASKED] 动作 {name} 因反复无效已被系统屏蔽 {st.masks[name]} 步，请换一种方法（见系统指令）。"
        if name == "key":
            keys = str(a.get("keys", "")).lower().split()
            for k in keys:
                if k in BLOCKED_KEYS:
                    return Code.SECURITY_DENIED, f"[BLOCKED_KEY] 按键 {k} 被禁止。"
                if k in CLOSE_KEYS:
                    fg = obs.fg_window()
                    if fg is None or fg.own_console or (fg.cls or "") in SHELL_CLASSES:
                        return Code.SECURITY_DENIED, "[CLOSE_GUARD] 前台是桌面/任务栏/本控制台，alt+f4 会弹出关机对话框或杀死本程序。请用 focus_window / 点击目标窗口。"
                    if fg.process.lower() not in {x.lower() for x in st.launched} and fg.process.lower().replace(".exe", "") not in {x.lower() for x in st.launched} and (not st.target_hint or st.target_hint not in fg.process.lower()):
                        return Code.SECURITY_DENIED, f"[CLOSE_GUARD] 前台 {fg.process} 不是本任务启动/指定的程序，禁止 alt+f4。请点击窗口自带的关闭/确定按钮。"
        if name in ("click", "double_click", "right_click") and a.get("id") is not None:
            e = els.get(a["id"])
            if e is None:
                return Code.NOT_FOUND, f"[STALE_REF] 控件编号 {a['id']} 不在本轮观察中。"
            if st.quantity and e.zone == "Toolbar" and DESTRUCTIVE.search(e.name or ""):
                checked = sum(1 for x in obs.elements if x.zone == "Row" and "checked" in x.states)
                if checked != st.quantity:
                    return Code.SECURITY_DENIED, f"[INTERLOCK] 任务数量 N={st.quantity}，但当前已勾选 {checked} 行；删除类按钮被拒绝。先 select_rows。"
            if e.role.lower() in TOGGLE_ROLES:
                for prev in reversed(st.ledger[-4:]):
                    if prev.sig == action_sig(a, els) and prev.effect == "confirmed" and a.get("repeat") is not True:
                        return Code.SECURITY_DENIED, "[REPEAT_EFFECT] 该开关/复选框刚被你成功切换过，再点一次会撤销。用 check/uncheck 或确认状态后再操作。"
        if name in ("click", "double_click", "right_click") and a.get("id") is None and "x" in a:
            if obs.elements and not a.get("force") and not a.get("vision_grounded"):
                x, y = int(a["x"]), int(a["y"])
                if not any(e.rect[0] <= x <= e.rect[0] + e.rect[2] and e.rect[1] <= y <= e.rect[1] + e.rect[3] for e in obs.elements):
                    return Code.SECURITY_DENIED, "[UNGROUNDED] 坐标不在任何已观察控件内；请用控件编号，或先 vision_inspect / ocr，或加 force:true。"
        if name == "run_powershell":
            cmd = str(a.get("command", ""))
            if re.search(r"add-type|new-object|invoke-expression|\biex\b|downloadstring|-enc\b|start-bitstransfer|reg\s+add|format-volume|stop-computer|restart-computer", cmd, re.I):
                return Code.SECURITY_DENIED, "[SECURITY_AST_PREFILTER] 命令含被禁止的构造。窗口切换请直接使用 focus_window（原生驱动已做 5 级验证式切换），不要再用 PowerShell P/Invoke。"
        return None


