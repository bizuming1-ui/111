class AttributeSelector:
    ext: str = ""
    sender: str = ""
    date_from: Optional[date] = None
    date_to: Optional[date] = None  # inclusive

    def empty(self) -> bool:
        return not (self.ext or self.sender or self.date_from or self.date_to)

    def describe(self) -> str:
        bits = []
        if self.ext:
            bits.append(f"ext=.{self.ext}")
        if self.sender:
            bits.append(f"sender={self.sender}")
        if self.date_from:
            bits.append(f"from={self.date_from}")
        if self.date_to:
            bits.append(f"to={self.date_to}")
        return ",".join(bits)

    def matches(self, ref: WorldObjectRef) -> bool:
        if self.ext and not ref.name.lower().endswith("." + self.ext.lower()):
            return False
        if self.sender and self.sender.lower() not in str(ref.extra.get("sender", "")).lower():
            return False
        if self.date_from or self.date_to:
            if not ref.time_ts:
                return False
            d = datetime.fromtimestamp(ref.time_ts).date()
            if (self.date_from and d < self.date_from) or (self.date_to and d > self.date_to):
                return False
        return True


@dataclass(frozen=True)
class CompositeSelector:
    by_name: Optional[NameSelector] = None
    by_ordinal: tuple[OrdinalPart, ...] = ()
    by_attribute: Optional[AttributeSelector] = None
    select_all: bool = False

    def describe(self) -> str:
        parts = []
        if self.by_name:
            parts.append(f"by_name({self.by_name.text!r}{',exact' if self.by_name.exact else ''})")
        if self.by_ordinal:
            parts.append("by_ordinal(" + "+".join(o.describe() for o in self.by_ordinal) + ")")
        if self.by_attribute and not self.by_attribute.empty():
            parts.append(f"by_attribute({self.by_attribute.describe()})")
        if self.select_all:
            parts.append("select_all")
        return " ∧ ".join(parts) or "（无选择器）"


# ====================================================================================================================== ordinal parser
def _num_ok(n: str, cl: str) -> Optional[int]:
    """Chinese numerals need a classifier (前面两个 ✓ / 前面三 ✗ — never eats a real name); Arabic digits don't."""
    v = cn_to_int(n)
    if v is None or v <= 0:
        return None
    if not n.isdigit() and not cl:
        return None
    return v


def _sub_all(rx: "re.Pattern[str]", text: str, handler: Any) -> str:
    out, last = [], 0
    for m in rx.finditer(text):
        if not handler(m):
            continue
        out.append(text[last:m.start()])
        out.append(" ")
        last = m.end()
    out.append(text[last:])
    return "".join(out)


def parse_ordinals(text: str) -> tuple[list[OrdinalPart], str, bool]:
    """Extract positional references → (parts, text with those spans removed, select_all)."""
    t = unicodedata.normalize("NFKC", text)
    parts: list[OrdinalPart] = []

    def add(p: OrdinalPart) -> bool:
        parts.append(p)
        return True

    def h_last_idx(m: "re.Match[str]") -> bool:
        v = _num_ok(m.group(1), m.group(2) or "个")
        return add(OrdinalPart("index", index=v - 1, from_end=True)) if v else False

    t = _sub_all(re.compile(rf"倒数第\s*({_NUM})\s*({_CL})"), t, h_last_idx)

    def h_range(m: "re.Match[str]") -> bool:
        a, b = _num_ok(m.group(1), "个"), _num_ok(m.group(2), m.group(3) or "个")
        if not a or not b:
            return False
        lo, hi = sorted((a, b))
        return add(OrdinalPart("range", index=lo - 1, end_index=hi - 1))

    t = _sub_all(re.compile(rf"第\s*({_NUM})\s*(?:到|至|~|-|—|–)\s*第?\s*({_NUM})\s*({_CL})"), t, h_range)

    def h_idx(m: "re.Match[str]") -> bool:
        first = _num_ok(m.group(1), m.group(2) or "个")
        if not first:
            return False
        add(OrdinalPart("index", index=first - 1))
        for x in re.findall(_NUM, m.group(3) or ""):
            v = _num_ok(x, "个")
            if v:
                add(OrdinalPart("index", index=v - 1))
        return True

    t = _sub_all(re.compile(rf"第\s*({_NUM})\s*({_CL})((?:\s*(?:、|,|，|和|及|与|跟|还有)\s*第?\s*{_NUM}\s*{_CL})*)"), t, h_idx)
    for words, order in (("最新|最近|最晚", "newest"), ("最早|最旧|最老", "oldest")):
        def h_t(m: "re.Match[str]", order: str = order) -> bool:
            v = _num_ok(m.group(1), m.group(2))
            return add(OrdinalPart("head", n=v, order=order)) if v else False

        t = _sub_all(re.compile(rf"(?:{words})(?:的)?\s*({_NUM})\s*({_CL})"), t, h_t)

    def h_tail(m: "re.Match[str]") -> bool:
        v = _num_ok(m.group(1), m.group(2))
        return add(OrdinalPart("tail", n=v)) if v else False

    t = _sub_all(re.compile(rf"(?:最后面|最后|最末尾|最末|末尾|结尾|最底下|最下面|底部|后面|后)(?:的)?\s*({_NUM})\s*({_CL})"), t, h_tail)

    def h_head(m: "re.Match[str]") -> bool:
        v = _num_ok(m.group(1), m.group(2))
        return add(OrdinalPart("head", n=v)) if v else False

    t = _sub_all(re.compile(rf"(?:最前面|最前|前面|开头|最上面|最上|上面|顶部|头|前)(?:的)?\s*({_NUM})\s*({_CL})"), t, h_head)
    # bare "最新的文件 / 最早的一个" (no count) → head=1 in that time order
    for words, order in (("最新|最近|最晚", "newest"), ("最早|最旧|最老", "oldest")):
        def h_b(m: "re.Match[str]", order: str = order) -> bool:
            return add(OrdinalPart("head", n=1, order=order))

        t = _sub_all(re.compile(rf"(?:{words})(?:的)?(?=文件|一个|一份|一条|$|\s)"), t, h_b)
    sel_all = bool(re.search(r"全部|所有|整个列表|每一个|每个", t))
    if sel_all:
        t = re.sub(r"全部|所有|整个列表|每一个|每个", " ", t)
    return parts, t, sel_all


# ====================================================================================================================== attributes
_EXTS = r"txt|pdf|docx?|xlsx?|pptx?|png|jpe?g|gif|bmp|webp|zip|rar|7z|msix|msi|exe|mp[34]|mkv|avi|mov|csv|json|xml|md|log|py|js|ts|ini|bak|tmp|iso|apk"
_DATE_WORDS = (("今天", 0), ("今日", 0), ("昨天", 1), ("昨日", 1), ("前天", 2))


def parse_attributes(text: str, today: Optional[date] = None) -> tuple[AttributeSelector, str]:
    t = unicodedata.normalize("NFKC", text)
    today = today or date.today()
    ext = sender = ""
    d_from: Optional[date] = None
    d_to: Optional[date] = None
    # extension: a bare ".txt" token, or "txt文件/txt格式".  (A real name such as 相机.txt / readme.txt is left in the name selector.)
    m = re.search(rf"(?:(?:^|\s)\.({_EXTS})\b|(?<![A-Za-z0-9.])({_EXTS})\s*(?:格式|类型)?(?:的)?\s*(?:文件|文档))", t, re.I)
    if m:
        ext = (m.group(1) or m.group(2)).lower()
        t = t[:m.start()] + " " + t[m.end():]
    m = re.search(r"(?:来自|发件人(?:是|为)?)\s*([^\s的，,。]+?)\s*(?:发来的|的)", t)
    if m:
        sender = m.group(1)
        t = t[:m.start()] + " " + t[m.end():]
    hit = False
    for w, back in _DATE_WORDS:
        if w in t:
            d_from = d_to = today - timedelta(days=back)
            t = t.replace(w, " ")
            hit = True
            break
    if not hit:
        m = re.search(rf"最近\s*({_NUM})\s*(天|日|周|小时)", t)
        if m:
            k = cn_to_int(m.group(1)) or 1
            days = 1 if m.group(2) == "小时" else k * (7 if m.group(2) == "周" else 1)
            d_from, d_to = today - timedelta(days=days), today
            t = t[:m.start()] + " " + t[m.end():]
    return AttributeSelector(ext=ext, sender=sender, date_from=d_from, date_to=d_to), t


# ====================================================================================================================== GoalSpec
_DEL = r"(?:永久删除|彻底删除|彻底清除|永久清除|删除掉|删除|删掉|移除|清除|干掉|delete|remove|erase)"
_RESTORE = r"(?:还原|恢复|restore|undelete)"
_RECYCLE_VERB = r"(?:移到|移入|放进|放入|扔进|扔到|丢进|丢到|拖到)回收站"
_IN_BIN = r"回收站(?:里面|里边|里|中|内)?"
_OPEN_BIN_TAIL = re.compile(r"[，,、]?\s*(?:并|然后|再|接着)?(?:把|将)?\s*(?:打开|显示|进入)(?:一下)?回收站.*$")
_NOT_FILE_CTX = re.compile(r"邮件|邮箱|e-?mail|gmail|网页|网站|标签页|浏览器|微信|消息|聊天|选中的|所选|文字|文本框|段落|图层|画布|评论|对话", re.I)
_FOLDERS = {"桌面": "desktop", "文档": "documents", "下载": "downloads"}
_LOCATIVE = re.compile(r"(?:桌面|文档|下载)(?:文件夹)?(?:上的|里面的|里的|中的|内的|上|里面|里边|里|中|内)")
_LEAD = re.compile(r"^(?:把|将|从|在|对|帮我|请|你先|你再|直接|一下|立即|马上|彻底|永久|的|(?:先|再|并|然后)(?=把|将|从|在|对))+")
_CONNECTORS = {"和", "及", "与", "跟", "还有", "以及", "并", "并且", "先", "再", "然后", "还", "也"}
_TAIL = re.compile(r"(?:一下|吧|掉|的)+$")

BROAD_THRESHOLD = 5  # irreversible selections larger than this (or select_all) need an explicit human confirmation under DSCU_IRREVERSIBLE_CONFIRM=auto


@dataclass(frozen=True)
class GoalSpec:
    raw_task: str
    verb: str                         # delete | restore
    container: str                    # auto | recyclebin | desktop | documents | downloads
    selector: CompositeSelector
    permanent: bool = False           # the object must not survive in the Recycle Bin either
    authorized_irreversible: bool = False
    open_bin_after: bool = False
    folder_hint: str = ""

    @property
    def goal_id(self) -> str:
        return hashlib.sha256(f"{self.raw_task}|{self.verb}|{self.container}".encode()).hexdigest()[:12]

    @property
    def scope(self) -> tuple[str, ...]:
        return ALL_LOCATIONS if self.container == "auto" else (self.container,)

    @property
    def irreversible(self) -> bool:
        return self.verb == "delete" and (self.permanent or self.container == "recyclebin")

    @property
    def kind(self) -> str:
        """Name of the v17 Layer-0 intent this goal supersedes (back-compat for logs/tests)."""
        if self.verb == "restore":
            return "bin_restore"
        return "bin_remove" if self.container == "recyclebin" else "file_delete"

    def describe(self) -> str:
        risk = ("不可逆·已由任务原文明确授权" if self.authorized_irreversible else "不可逆·未授权") if self.irreversible else "可恢复"
        return f"verb={self.verb} · container={self.container} · selector={self.selector.describe()} · {risk}" + (" · permanent" if self.permanent else "") + (" · +打开回收站" if self.open_bin_after else "")

    def completion_criteria(self) -> list[str]:
        if self.verb == "restore":
            return ["选中对象不再出现在回收站", "对象存在于其原位置"]
        if self.container == "recyclebin" or self.permanent:
            return ["选中对象不再出现在回收站", "后备存储($R/$I)已消失", "回收站计数恰好减少所选个数", "回收站内其它对象身份集合不变"]
        return ["所选对象不再存在于授权作用域(桌面/文档/下载)", "对象已进入回收站（身份与原路径吻合）或本来就已处于已删除状态"]


def _name_residue(rest: str, verb: str) -> str:
    s = re.sub(_IN_BIN, " ", rest)
    s = re.sub(_RECYCLE_VERB, " ", s)
    s = re.sub(_DEL if verb == "delete" else _RESTORE, " ", s)
    s = _LOCATIVE.sub(" ", s)
    s = re.sub(r"[，,。；;！!？?、]+", " ", s)
    toks = []
    for tok in s.split():
        tok = _LEAD.sub("", tok)
        tok = _TAIL.sub("", tok)
        for fw in _FOLDERS:  # bare '桌面相机' → 相机 (never '文档.txt' → '.txt')
            if tok.startswith(fw) and len(tok) > len(fw) and not tok[len(fw):].startswith("."):
                tok = tok[len(fw):]
                break
        if tok and tok not in _CONNECTORS:
            toks.append(tok)
    return _rb.clean_reference("".join(toks)) if toks else ""


def compile_goal(task: str, today: Optional[date] = None) -> Optional[GoalSpec]:
    """Natural language → GoalSpec.  None = not a file / Recycle-Bin goal (other routers or the LLM loop own it; pure 'open view' and 'empty bin' stay with their Layer 0)."""
    t = unicodedata.normalize("NFKC", str(task or "")).strip()
    if not t or _NOT_FILE_CTX.search(t):
        return None
    if re.search(r"清空|empty", t, re.I) and re.search(r"回收站|recycle", t, re.I):
        return None
    body = _OPEN_BIN_TAIL.sub("", t)
    open_after = body != t and bool(re.search(_DEL, body))
    is_restore = bool(re.search(_RESTORE, body))
    is_delete = bool(re.search(_DEL, body)) or bool(re.search(_RECYCLE_VERB, body))
    if is_restore == is_delete:   # neither verb, or conflicting verbs → refuse to guess
        return None
    verb = "restore" if is_restore else "delete"
    folder = next((k for k in _FOLDERS if k in body), "")
    in_bin = bool(re.search(_IN_BIN, body)) and not re.search(r"(?:桌面|文档|下载)(?:文件夹)?(?:上|里|中|内)", body) and not re.search(_RECYCLE_VERB, body)
    container = "recyclebin" if (verb == "restore" or in_bin) else (_FOLDERS[folder] if folder else "auto")

    attrs, rest = parse_attributes(body, today)          # dates / ext first (so “最近3天” is never an ordinal)
    ords, rest, sel_all = parse_ordinals(rest)
    name_txt = _name_residue(rest, verb)                  # AFTER spans are removed — task #2 root cause
    name = None if (not name_txt or name_txt in _rb.GENERIC) else NameSelector(name_txt, bool(re.search(r"\.[a-z0-9]{1,6}$", name_txt)))
    if name is None and not ords and not sel_all and attrs.empty():
        return None
    permanent_words = bool(re.search(r"永久|彻底", t))
    permanent = verb == "delete" and (permanent_words or container == "recyclebin")
    authorized = verb == "delete" and ((container == "recyclebin") or permanent_words)
    return GoalSpec(raw_task=t, verb=verb, container=container, selector=CompositeSelector(name, tuple(ords), None if attrs.empty() else attrs, sel_all),
                    permanent=permanent, authorized_irreversible=authorized, open_bin_after=open_after, folder_hint=folder)


# ====================================================================================================================== selection resolution
@dataclass
class Selection:
    status: str                       # ok | empty | ambiguous | suggest | short
    refs: tuple[WorldObjectRef, ...] = ()
    reason: str = ""
    requested: int = 0
    candidates_total: int = 0

    @property
    def ok(self) -> bool:
        return self.status == "ok" and bool(self.refs)


def _ordered(objs: list[WorldObjectRef], order: str) -> list[WorldObjectRef]:
    if order == "newest":
        return sorted(objs, key=lambda r: -(r.time_ts or 0.0))
    if order == "oldest":
        return sorted(objs, key=lambda r: (r.time_ts or 0.0))
    return objs


def resolve_selection(goal: GoalSpec, candidates: Sequence[WorldObjectRef]) -> Selection:
    """CompositeSelector over the ORDERED list of ONE container: attribute filter → name filter → ordinal pick → frozen refs.
    A name that is not an exact file name / stem is never auto-selected (suggest → needs_clarification)."""
    sel = goal.selector
    objs = [c for c in candidates if not c.is_dir]
    total = len(objs)
    if sel.by_attribute:
        objs = [c for c in objs if sel.by_attribute.matches(c)]
    if sel.by_name:
        scored = sorted(((sel.by_name.score(c.name), i, c) for i, c in enumerate(objs)), key=lambda x: (-x[0], x[1]))
        good = [x for x in scored if x[0] >= _rb.STRICT]
        if not good:
            near = [x[2] for x in scored if x[0] >= 0.86][:5]
            if near:
                return Selection("suggest", tuple(near), f"没有精确名为「{sel.by_name.text}」的对象", candidates_total=total)
            return Selection("empty", (), f"容器中没有名为「{sel.by_name.text}」的对象", candidates_total=total)
        top = good[0][0]
        objs = [x[2] for x in sorted((x for x in good if abs(x[0] - top) < 0.02), key=lambda x: x[1])]
        if not sel.by_ordinal and not sel.select_all and len(objs) > 1:
            return Selection("ambiguous", tuple(objs), f"有 {len(objs)} 个同样匹配「{sel.by_name.text}」的对象", candidates_total=total)
    if sel.by_ordinal:
        chosen: dict[str, tuple[int, WorldObjectRef]] = {}
        requested = 0
        for part in sel.by_ordinal:
            seq = _ordered(objs, part.order)
            requested += part.requested()
            for i in part.pick(seq):
                chosen.setdefault(seq[i].identity, (objs.index(seq[i]), seq[i]))
        pick = [r for _, r in sorted(chosen.values(), key=lambda x: x[0])]
        if not pick:
            return Selection("empty", (), f"序数 {'+'.join(p.describe() for p in sel.by_ordinal)} 在 {len(objs)} 个对象中没有命中", requested=requested, candidates_total=total)
        if len(pick) < requested:
            return Selection("short", tuple(pick), f"要求 {requested} 个，容器里只有 {len(objs)} 个可选对象", requested=requested, candidates_total=total)
        return Selection("ok", tuple(pick), "", requested=requested, candidates_total=total)
    if sel.select_all:
        return Selection("ok", tuple(objs), "", requested=len(objs), candidates_total=total) if objs else Selection("empty", (), "容器为空", candidates_total=total)
    if not objs:
        return Selection("empty", (), "没有匹配对象", candidates_total=total)
    return Selection("ok", (objs[0],), "", requested=1, candidates_total=total)


# ====================================================================================================================== remaining work
@dataclass
class RemainingWork:
    done: tuple[WorldObjectRef, ...] = ()       # committed by an Action Transaction (independent evidence recorded)
    vanished: tuple[WorldObjectRef, ...] = ()   # gone from the container without our commit → goal-wise satisfied (user / earlier run did it)
    remaining: tuple[WorldObjectRef, ...] = ()
    total: int = 0

    @property
    def complete(self) -> bool:
        return not self.remaining

    def summary(self) -> str:
        return (f"总计 {self.total} · 已完成 {len(self.done)} · 已被外部消除 {len(self.vanished)} · 剩余 {len(self.remaining)}"
                + ("：" + "，".join(r.name for r in self.remaining[:6]) if self.remaining else ""))


def recompute_remaining_work(goal: GoalSpec, frozen: Iterable[WorldObjectRef], current: Sequence[WorldObjectRef], committed: Iterable[str] = ()) -> RemainingWork:
    """Call after EVERY action with the WorldModel's FRESH listing of the container.  Identity-based (never name/position-based):
    a frozen object is finished when it is no longer listed in its container; committed identities are never re-executed (exact resume after partial success)."""
    cur_ids = {c.identity for c in current}
    com = set(committed)
    done: list[WorldObjectRef] = []
    vanished: list[WorldObjectRef] = []
    remaining: list[WorldObjectRef] = []
    frozen = list(frozen)
    for r in frozen:
        if r.identity in com:
            done.append(r)
        elif r.identity not in cur_ids:
            vanished.append(r)
        else:
            remaining.append(r)
    return RemainingWork(tuple(done), tuple(vanished), tuple(remaining), len(frozen))
