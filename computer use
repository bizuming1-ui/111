class TestRecovery(unittest.TestCase):
    def test_no_new_evidence_closes_path_immediately_on_failure(self):
        s = WorldSnapshot(1, {"a": ("x", ())}, "c")
        fb = EvidenceGatedFallback()
        d = compute_world_diff(s, s)
        self.assertTrue(d.empty)
        dec = fb.after_action("click:p1,2", False, d)
        self.assertEqual(dec.kind, "switch_strategy")
        self.assertIsNotNone(fb.pre_check("click:p1,2"))   # refused with no model round trip
        self.assertGreater(fb.stats["tokens_saved_est"], 0)

    def test_new_evidence_continues(self):
        a, b = WorldSnapshot(1, {"a": ("x", ())}, "c"), WorldSnapshot(2, {"a": ("x", ()), "dlg": ("弹窗", ())}, "c")
        d = compute_world_diff(a, b)
        self.assertEqual(d.added, ["dlg"])
        self.assertIn("a", d.still_valid)
        self.assertEqual(EvidenceGatedFallback().after_action("click:p1", True, d).kind, "continue")

    def test_ok_but_unchanged_gets_one_more_look(self):
        s = WorldSnapshot(1, {"a": ("x", ())}, "c")
        fb = EvidenceGatedFallback(max_no_evidence=2)
        self.assertEqual(fb.after_action("click:p", True, compute_world_diff(s, s)).kind, "continue")
        self.assertNotEqual(fb.after_action("click:p", True, compute_world_diff(s, s)).kind, "continue")

    def test_irreversible_never_replayed_and_ladder_ends_in_handoff(self):
        fb = EvidenceGatedFallback()
        fb.ledger.record("send:a:b", "bubble")
        self.assertIn("绝不重放", fb.pre_check("key:enter", "send:a:b").reason)
        s = WorldSnapshot(1, {}, "c")
        kinds = [fb.after_action(f"p{i}", False, compute_world_diff(s, s)).kind for i in range(5)]
        self.assertIn("handoff", kinds)

    def test_mutation_detected(self):
        a, b = WorldSnapshot(1, {"r": ("m", ())}, "c"), WorldSnapshot(2, {"r": ("m", (("checked", True),))}, "c")
        self.assertEqual(len(compute_world_diff(a, b).mutated), 1)
        self.assertTrue(IrreversibleLedger().assert_not_replay("k")[0])

    def test_runtime_gate_on_live_style_elements(self):
        from agent_brain.protocol import Element, Observation

        def obs(epoch, names):
            els = [Element(ref_id=f"@{epoch}:e{i}", role="button", name=n, rect=[0, 0, 5, 5], stable_key=f"k{n}") for i, n in enumerate(names)]
            return Observation(id="o", ok=True, channel="uia", snapshot_epoch=epoch, hwnd=1, elements=els)
        rt = V18Runtime(None)
        a = {"action": "click", "x": 1100, "y": 1345}
        rt.observe(obs(1, ["a", "b"]), 1)
        self.assertIsNone(rt.pre(a, 1))
        rt.after(a, False)
        note = rt.observe(obs(2, ["a", "b"]), 2)   # same world → no new evidence
        self.assertIn("证据门控", note)
        self.assertIn("NO_NEW_EVIDENCE", rt.pre(a, 2) or "")
        self.assertEqual(action_signature({"action": "click", "x": 1100, "y": 1345}), action_signature({"action": "click", "x": 1101, "y": 1346}))


