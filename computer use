                "attributes": [{"key": k, "value": {"stringValue": str(v)}} for k, v in s["attrs"].items()]} for s in self.spans]
        return {"resourceSpans": [{"resource": {"attributes": [{"key": "service.name", "value": {"stringValue": self.service}}]},
