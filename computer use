// AXTree + DOM(pierce) fusion -> protocol Elements with Toolbar / Row / Modal / Content zones, occlusion flags, stable keys.
import { Tab } from "./browser.js";
import { waitSettled } from "./cdp.js";
import { Element, Rect, Zone, fnv, norm } from "./protocol.js";

const INTERACTIVE = new Set([
  "button", "link", "textbox", "searchbox", "checkbox", "radio", "combobox", "menuitem", "menuitemcheckbox", "menuitemradio", "tab",
  "option", "switch", "slider", "spinbutton", "treeitem", "listbox", "menu", "gridcell", "cell", "row", "columnheader", "heading", "img",
]);
const KEEP_NAMED = new Set(["row", "cell", "gridcell", "heading", "img", "columnheader"]);

interface DomInfo { parent: number; name: string; role: string; modal: boolean; tag: string; attrs: Record<string, string> }

function buildDom(root: any): Map<number, DomInfo> {
  const m = new Map<number, DomInfo>();
  const walk = (n: any, parent: number) => {
    const attrs: Record<string, string> = {};
    const a: string[] = n.attributes ?? [];
    for (let i = 0; i + 1 < a.length; i += 2) attrs[a[i]] = a[i + 1];
    const tag = String(n.nodeName ?? "").toLowerCase();
    if (n.backendNodeId !== undefined) {
      m.set(n.backendNodeId, { parent, name: tag, role: attrs["role"] ?? "", modal: attrs["aria-modal"] === "true" || tag === "dialog", tag, attrs });
    }
    const me = n.backendNodeId ?? parent;
    for (const c of n.children ?? []) walk(c, me);
    for (const c of n.shadowRoots ?? []) walk(c, me);
    if (n.contentDocument) walk(n.contentDocument, me);
    if (n.templateContent) walk(n.templateContent, me);
  };
  walk(root, -1);
  return m;
}

function zoneOf(dom: Map<number, DomInfo>, id: number, role: string): { zone: Zone; rowAnc: number } {
  let zone: Zone | null = null;
  let rowAnc = -1;
  let cur = dom.get(id)?.parent ?? -1;
  for (let i = 0; i < 40 && cur !== -1; i++) {
    const d = dom.get(cur);
    if (!d) break;
    if (!zone && (d.modal || d.role === "dialog" || d.role === "alertdialog")) return { zone: "Modal", rowAnc };
    if (rowAnc === -1 && (d.tag === "tr" || d.role === "row" || d.role === "listitem" || d.tag === "li")) rowAnc = cur;
    if (!zone && (d.role === "toolbar" || d.role === "menubar" || d.tag === "header" || d.role === "banner" || d.tag === "nav" || d.role === "navigation" || d.attrs["gh"] === "mtb" || d.attrs["gh"] === "tm")) zone = "Toolbar";
    cur = d.parent;
  }
  if (role === "row" || role === "listitem") rowAnc = id;
  if (zone) return { zone, rowAnc };
  return { zone: rowAnc !== -1 ? "Row" : "Content", rowAnc };
}

function boundsOfQuad(q: number[]): Rect {
  const xs = [q[0], q[2], q[4], q[6]], ys = [q[1], q[3], q[5], q[7]];
  const x = Math.min(...xs), y = Math.min(...ys);
  return { x: Math.round(x), y: Math.round(y), w: Math.round(Math.max(...xs) - x), h: Math.round(Math.max(...ys) - y) };
}

async function pool<T, R>(items: T[], n: number, fn: (t: T) => Promise<R>): Promise<R[]> {
  const out: R[] = new Array(items.length);
  let i = 0;
  const workers = Array.from({ length: Math.min(n, items.length) }, async () => {
    while (i < items.length) { const k = i++; out[k] = await fn(items[k]); }
  });
  await Promise.all(workers);
  return out;
}

export interface ObserveOpts { settle?: boolean; maxNodes?: number; includeOffscreen?: boolean; skeleton?: boolean; minimumOcclusion?: boolean }

export async function observePage(tab: Tab, o: ObserveOpts) {
  const t0 = Date.now();
  let settled_ms = 0;
  if (o.settle !== false) settled_ms = (await waitSettled(tab.s, tab.net, { timeoutMs: 3000 })).ms;
  const [ax, doc, page] = await Promise.all([
    tab.s.send("Accessibility.getFullAXTree"),
    tab.s.send("DOM.getDocument", { depth: -1, pierce: true }),
