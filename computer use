def _ahash(img: Any) -> str:
    g = img.convert("L").resize((8, 8))
    px = list(g.getdata())
    avg = sum(px) / 64
    return f"{sum(1 << i for i, v in enumerate(px) if v >= avg):016x}"


def _ahash_np(arr: Any) -> str:
    """64-bit aHash from a strided subsample (no full-frame copy): ~0.3 ms on 2560x1600 BGRA."""
    import numpy as np

    h, w = arr.shape[0], arr.shape[1]
    sy, sx = max(1, h // 128), max(1, w // 128)
    sub = arr[::sy, ::sx, :3]
    hh, ww = (sub.shape[0] // 8) * 8, (sub.shape[1] // 8) * 8
    if hh < 8 or ww < 8:
        return "0" * 16
    g = sub[:hh, :ww].mean(axis=2, dtype=np.float32).reshape(8, hh // 8, 8, ww // 8).mean(axis=(1, 3)).ravel()
    avg = float(g.mean())
    return f"{sum(1 << i for i, v in enumerate(g.tolist()) if v >= avg):016x}"


class DxgiStream:
    """Resident DXGI Desktop-Duplication stream (dxcam background thread).  `grab()` never rebuilds the D3D device / SwapChain:
    mode 'peek'   = zero-copy read of dxcam's latest buffered frame (non-blocking, ~0.05 ms)
    mode 'latest' = dxcam.get_latest_frame() (blocks <= 1 frame period)
    mode 'oneshot'= legacy cam.grab() (used only if the stream cannot start)
    max_buffer_len=1 keeps RAM at one frame (dxcam's default of 64 would allocate ~1 GB at 2560x1600)."""

    def __init__(self, fps: int = 120, idle_s: float = 45.0) -> None:
        self._pool: Any = None
        self.cam: Any = None
        self.err: Optional[str] = None
        self.fps, self.idle_s = fps, idle_s
        self.started = False
        self.mode = "none"
        self.last_use = 0.0
        self.last_arr: Any = None
        self.frames_seen = -1
        self.restarts = 0

    def _create(self) -> None:
        import dxcam

        try:
            self.cam = dxcam.create(output_color="BGRA", max_buffer_len=1)
        except TypeError:
            self.cam = dxcam.create(output_color="BGRA")

    def ensure(self) -> bool:
        if self.err and self.cam is None:
            return False
        try:
            if self.cam is None:
                self._create()
            if not self.started:
                try:
                    self.cam.start(target_fps=self.fps, video_mode=True)
                    self.started = True
                    self.mode = "peek" if self._peekable() else "latest"
                    self.restarts += 1
                    deadline = time.time() + 1.0  # first frame
                    while time.time() < deadline and self._peek() is None:
                        time.sleep(0.004)
                except Exception as e:  # noqa: BLE001
                    self.started, self.mode = False, "oneshot"
                    self.err_stream = f"stream start failed: {e}"
            return True
        except Exception as e:  # noqa: BLE001
            self.err = f"dxcam unavailable: {e}"
            self.cam = None
            return False

    def _peekable(self) -> bool:
        c = self.cam
        return all(hasattr(c, n) for n in ("_DXCamera__frame_buffer", "_DXCamera__head", "_DXCamera__lock"))

    def _peek(self) -> Any:
        c = self.cam
        try:
            buf = getattr(c, "_DXCamera__frame_buffer", None)
            if buf is None:
                return None
            head, n = getattr(c, "_DXCamera__head", 0), len(buf)
            fc = getattr(c, "_DXCamera__frame_count", None)
            if fc is not None and fc == 0:
                return None
            arr = buf[(head - 1) % n]
            if arr is None or not getattr(arr, "size", 0):
                return None
            if not arr[::97, ::97].any():  # buffer slot still all-zero => no frame yet
                return None
            return arr
        except Exception:  # noqa: BLE001
            return None

    def grab(self) -> tuple[Any, bool, str]:
        """-> (BGRA ndarray (borrowed, do not mutate), reused_frame, mode)"""
        self.last_use = time.time()
        if not self.ensure():
            return None, False, "none"
        if self.started and self.mode == "peek":
            arr = self._peek()
            if arr is not None:
                self.last_arr = arr
                return arr, False, "peek"
            self.mode = "latest"  # attribute layout differs: degrade (still resident stream, no SwapChain rebuild)
        if self.started and self.mode == "latest":
            try:
                if self._pool is None:
                    from concurrent.futures import ThreadPoolExecutor

                    self._pool = ThreadPoolExecutor(1, thread_name_prefix="dxgi-latest")
                fut = self._pool.submit(self.cam.get_latest_frame)
                try:
                    arr = fut.result(timeout=0.08)  # never hang on a static desktop: reuse the previous frame instead
                except Exception:  # noqa: BLE001  (timeout)
                    return self.last_arr, True, "latest"
                if arr is not None:
                    self.last_arr = arr
                    return arr, False, "latest"
            except Exception as e:  # noqa: BLE001
                self.err_stream = f"get_latest_frame failed: {e}"
                self.mode = "oneshot"
                try:
                    self.cam.stop()
                except Exception:  # noqa: BLE001
                    pass
                self.started = False
        arr = self.cam.grab()
        if arr is None:
            return self.last_arr, True, "oneshot"
        self.last_arr = arr
        return arr, False, "oneshot"

    def snapshot(self, arr: Any) -> Any:
        """Tear-free copy for screenshots (held under dxcam's own lock when available)."""
        lock = getattr(self.cam, "_DXCamera__lock", None)
        if lock is not None:
            with lock:
                return arr.copy()
        return arr.copy()

    def idle_check(self) -> None:
        if self.started and self.last_use and time.time() - self.last_use > self.idle_s:
            try:
                self.cam.stop()
            except Exception:  # noqa: BLE001
                pass
            self.started = False

    def close(self) -> None:
        try:
            if self.cam is not None and self.started:
                self.cam.stop()
        except Exception:  # noqa: BLE001
            pass
        self.started = False


# v17.1 (log task #8 `点击第一个` clicked the tabs of the agent's OWN Windows Terminal): the terminal HOST (WindowsTerminal.exe / OpenConsole / conhost) is not always an
# ancestor of this process (single-instance WT, `wt -w 0`), so PID-ancestry alone cannot recognise it.  Class/process of a terminal host => own console (opt-out DSCU_TERMINAL_IS_OWN=0).
TERM_HOST_CLASSES = {"CASCADIA_HOSTING_WINDOW_CLASS", "ConsoleWindowClass", "PseudoConsoleWindow", "VirtualConsoleClass"}
TERM_HOST_PROCS = {"windowsterminal.exe", "openconsole.exe", "conhost.exe", "wt.exe", "windowsterminalpreview.exe"}


def is_terminal_host(cls: str, proc: str) -> bool:
    if os.environ.get("DSCU_TERMINAL_IS_OWN") == "0":
        return False
    return (cls or "") in TERM_HOST_CLASSES or (proc or "").lower() in TERM_HOST_PROCS


class NativeDriver:
    def _is_own(self, pid: int, cls: str) -> bool:
        """own console = ancestor process OR terminal host window (v17.1)."""
        return pid in self.own or is_terminal_host(cls, self._proc(pid))

    def __init__(self, own_pid: int) -> None:
        self.own: set[int] = {own_pid}
        try:
            import psutil

            self.own |= {p.pid for p in psutil.Process(own_pid).parents()}
        except Exception:
            pass
        self.epoch = 0
        self.refs: dict[str, tuple[Any, str, list[int], int]] = {}
        self.replay: dict[str, dict[str, Any]] = {}
        self.stream = DxgiStream()
        self.cam_err: Optional[str] = None
        self.last_img: Any = None  # PIL (only built on demand)
        self.last_arr: Any = None  # BGRA ndarray reference (zero-copy)
        self.last_stats: dict[str, Any] = {}
        self.work_hwnd = 0
        self.last_own_tick = 0.0
        self._pc: dict[int, str] = {}
        self.guard = InputGuard(deadzone_px=int(os.environ.get("DSCU_DEADZONE_PX", "15")), quiet_s=float(os.environ.get("DSCU_USER_QUIET_S", "1.5")))
        self.yield_wait_s = float(os.environ.get("DSCU_YIELD_WAIT_S", "4.0"))
        self._pinned: set[int] = set()
        self.occlusion_stats: dict[str, int] = {"attempts": 0, "recovered": 0, "minimized": 0, "pinned": 0, "failed": 0}
        OWN_INPUT_HOOKS[:] = [lambda: self.guard.mark_own()]
        if IS_WIN:
            self._unlock_foreground_lock()

    # ------------------------------------------------------------------ windows
    def _proc(self, pid: int) -> str:
        if pid in self._pc:
            return self._pc[pid]
        h = k32.OpenProcess(0x1000, False, pid)
        name = ""
        if h:
            buf = ctypes.create_unicode_buffer(520)
            n = wt.DWORD(520)
            if k32.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(n)):
                name = buf.value.rsplit("\\", 1)[-1]
            k32.CloseHandle(h)
        self._pc[pid] = name
        return name

    def windows(self) -> list[dict[str, Any]]:
        out: list[dict[str, Any]] = []
        z = [0]

        def cb(h: int, _: int) -> bool:
            idx = z[0]
            z[0] += 1
            if not u32.IsWindowVisible(h):
                return True
            t = ctypes.create_unicode_buffer(512)
            u32.GetWindowTextW(h, t, 512)
            c = ctypes.create_unicode_buffer(256)
            u32.GetClassNameW(h, c, 256)
            r = wt.RECT()
            u32.GetWindowRect(h, ctypes.byref(r))
            rect = [r.left, r.top, r.right - r.left, r.bottom - r.top]
            ex = u32.GetWindowLongW(h, -20) & 0xFFFFFFFF
            if not t.value and (rect[2] < 80 or rect[3] < 40) and c.value != "Shell_TrayWnd":
                return True
            if (ex & 0x80) and not t.value:
                return True
            pid = wt.DWORD()
            u32.GetWindowThreadProcessId(h, ctypes.byref(pid))
            cl = ctypes.c_int(0)
            try:
                ctypes.windll.dwmapi.DwmGetWindowAttribute(ctypes.c_void_p(h), 14, ctypes.byref(cl), 4)
            except Exception:
                pass
            out.append({"hwnd": h, "title": t.value, "class": c.value, "process": self._proc(pid.value), "pid": pid.value, "rect": rect, "z": idx,
                        "minimized": bool(u32.IsIconic(h)), "topmost": bool(ex & 0x8), "cloaked": cl.value != 0, "own_console": self._is_own(pid.value, c.value)})
            return True

        u32.EnumWindows(WNDENUMPROC(cb), None)
        for w in out:
            w["occluded_by"] = []
        return out

    def _find_by_process(self, query: str, wins: list[dict[str, Any]]) -> list[dict[str, Any]]:
        """app_resolve / focus_window process-name fallback: 'Microsoft Edge' -> msedge.exe, '微信' -> WeChat.exe/Weixin.exe ... -> main visible window(s), best first."""
        names = {n.lower() for n in process_names_for(query)}
        if not names:
            return []
        pids: set[int] = set()
        try:
            import psutil

            for p in psutil.process_iter(["name"]):
                if str(p.info.get("name") or "").lower() in names:
                    pids.add(int(p.pid))
        except Exception:  # noqa: BLE001
            pass
        return rank_main_window(wins, pids, names)

    @staticmethod
    def _occluders(t: dict[str, Any], allw: list[dict[str, Any]]) -> list[int]:
        tx, ty, tw, th = t["rect"]
        area = max(1, tw) * max(1, th)
        res = []
        for w in allw:
            if w["z"] >= t["z"] or w["hwnd"] == t["hwnd"] or w["minimized"] or w["cloaked"] or w["class"] in SHELL:
                continue
            ix = min(tx + tw, w["rect"][0] + w["rect"][2]) - max(tx, w["rect"][0])
            iy = min(ty + th, w["rect"][1] + w["rect"][3]) - max(ty, w["rect"][1])
            if ix > 0 and iy > 0 and ix * iy * 100 // area >= 12:
                res.append(w["hwnd"])
        return res

    @staticmethod
    def _fg() -> int:
        return int(u32.GetForegroundWindow() or 0)

    def _confirm(self, h: int, ms: int) -> bool:
        end = time.time() + ms / 1000
        while time.time() < end:
            if self._fg() == h:
                return True
            time.sleep(0.02)
        return self._fg() == h

    # ------------------------------------------------------------------ v16 focus steal + occlusion breaker
    def _unlock_foreground_lock(self) -> None:
        """SPI_SETFOREGROUNDLOCKTIMEOUT=0 for this session (not persisted) -> SetForegroundWindow is no longer silently downgraded to a taskbar flash."""
        try:
            u32.SystemParametersInfoW.argtypes = [wt.UINT, wt.UINT, ctypes.c_void_p, wt.UINT]
            u32.SystemParametersInfoW(0x2001, 0, ctypes.c_void_p(0), 0x2)
        except Exception:  # noqa: BLE001
            pass

    def _focus_sequence(self, h: int) -> bool:
        """Standard Win32 focus-steal order: GetWindowThreadProcessId -> AttachThreadInput(fg thread) -> ShowWindow(RESTORE if iconic, else SHOW; a maximized window is NOT un-maximized)
        -> BringWindowToTop -> SetWindowPos(HWND_TOPMOST) then immediately HWND_NOTOPMOST -> SetForegroundWindow -> detach."""
        fg = self._fg()
        ft = u32.GetWindowThreadProcessId(fg, None) if fg else 0
        tt = u32.GetWindowThreadProcessId(h, None)
        mt = k32.GetCurrentThreadId()
        att: list[int] = []
        for t in {int(ft), int(tt)}:
            if t and t != mt and u32.AttachThreadInput(mt, t, True):
                att.append(t)
        try:
            u32.ShowWindow(h, 9 if u32.IsIconic(h) else 5)
            u32.BringWindowToTop(h)
            u32.SetWindowPos(h, ctypes.c_void_p(-1), 0, 0, 0, 0, 0x43)  # HWND_TOPMOST  | NOMOVE | NOSIZE | SHOWWINDOW
            u32.SetWindowPos(h, ctypes.c_void_p(-2), 0, 0, 0, 0, 0x43)  # HWND_NOTOPMOST
            u32.SetForegroundWindow(h)
        finally:
            for t in att:
                u32.AttachThreadInput(mt, t, False)
        return self._confirm(h, 150)

    def pin_topmost(self, h: int) -> None:
        u32.SetWindowPos(h, ctypes.c_void_p(-1), 0, 0, 0, 0, 0x43)
        self._pinned.add(h)
        self.occlusion_stats["pinned"] += 1

    def _unpin_all(self) -> None:
        for h in list(self._pinned):
            try:
                u32.SetWindowPos(h, ctypes.c_void_p(-2), 0, 0, 0, 0, 0x43)
            except Exception:  # noqa: BLE001
                pass
        self._pinned.clear()

    def _visible_at(self, eh: int, x: int, y: int) -> tuple[bool, int]:
        """True when the pixel (x, y) really belongs to the expected window.  Same-process popups/menus/tooltips and click-through overlays do NOT count as occluders."""
        w = u32.WindowFromPoint(wt.POINT(int(x), int(y)))
        if not w:
            return True, 0
        root = int(u32.GetAncestor(w, 2) or 0)  # GA_ROOT
        owner = int(u32.GetAncestor(w, 3) or 0)  # GA_ROOTOWNER
        if eh in (root, owner, int(w)):
            return True, root
        pt, pb = wt.DWORD(), wt.DWORD()
        u32.GetWindowThreadProcessId(eh, ctypes.byref(pt))
        u32.GetWindowThreadProcessId(root, ctypes.byref(pb))
        if pt.value and pt.value == pb.value:
            return True, root
        if (u32.GetWindowLongW(root, -20) & 0xFFFFFFFF) & 0x20:  # WS_EX_TRANSPARENT
            return True, root
        return False, root

    def clear_occluders(self, h: int, point: Optional[tuple[int, int]] = None) -> list[str]:
        """Minimize foreign covering windows (SW_MINIMIZE); the agent's own console is never minimized - the target is pinned topmost for the action instead."""
        self.occlusion_stats["attempts"] += 1
        wins = self.windows()
        t = next((w for w in wins if w["hwnd"] == h), None)
        out: list[str] = []
        if t is None:
            return out
        cand = list(self._occluders(t, wins))
        if point:
            _, top = self._visible_at(h, point[0], point[1])
            if top and top != h and top not in cand:
                cand.insert(0, top)
        byh = {w["hwnd"]: w for w in wins}
        for b in cand[:6]:
            w = byh.get(b)
            kind = classify_blocker(w, t, SHELL)
            if kind == "minimizable" and w is not None:
                u32.ShowWindow(b, 6)
                self.occlusion_stats["minimized"] += 1
                out.append(f"minimize:{w['process']}:{w['title'][:18]}")
                time.sleep(0.12)
            elif kind == "own_console":
                self.pin_topmost(h)
                out.append("pin_topmost(own console above target)")
            else:
                out.append(f"skip:{kind}")
        return out

    def ensure_visible_at(self, eh: int, x: int, y: int) -> list[str]:
        """3 escalating rounds, each followed by a coordinate re-check:  (1) focus-steal sequence  (2) minimize the covering window(s)  (3) pin the target HWND_TOPMOST for this action."""
        self.occlusion_stats["attempts"] += 0
        trace: list[str] = []
        for rnd in range(3):
            ok, _ = self._visible_at(eh, x, y)
            if ok:
                if trace:
                    self.occlusion_stats["recovered"] += 1
                return trace
            if rnd == 0:
                _, how, _n = self.force_foreground(eh)
                trace.append(f"focus:{how}")
            elif rnd == 1:
                trace += self.clear_occluders(eh, (x, y))
            else:
                self.pin_topmost(eh)
                trace.append("pin_topmost")
            time.sleep(0.06)
        ok, _ = self._visible_at(eh, x, y)
        if ok:
            self.occlusion_stats["recovered"] += 1
        else:
            self.occlusion_stats["failed"] += 1
        return trace

    def force_foreground(self, h: int) -> tuple[bool, str, int]:
        if not u32.IsWindow(h):
            return False, "no_such_window", 0
        if u32.IsIconic(h):
            u32.ShowWindow(h, 9)
            time.sleep(0.06)
        if self._fg() == h:
            return True, "already", 0
        if self._focus_sequence(h):
            return True, "attach_topmost_flip", 1
        ok2, how, n = self._force_foreground_v15(h)  # alt-tap / SwitchToThisWindow / minimize-restore chain (v15)
        if ok2:
            return True, how, n + 1
        trace = self.clear_occluders(h)
        self._focus_sequence(h)
        if self._confirm(h, 250):
            return True, "clear_occluders:" + ",".join(trace)[:60], 7
        return False, "all_methods_failed", 7

    def _force_foreground_v15(self, h: int) -> tuple[bool, str, int]:
        if not u32.IsWindow(h):
            return False, "no_such_window", 0
        if u32.IsIconic(h):
            u32.ShowWindow(h, 9)
            time.sleep(0.06)
        if self._fg() == h:
            return True, "already", 0
        u32.SetForegroundWindow(h)
        if self._confirm(h, 80):
            return True, "SetForegroundWindow", 1
        u32.keybd_event(0x12, 0, 0, 0)
        u32.keybd_event(0x12, 0, 2, 0)
        u32.SetForegroundWindow(h)
        if self._confirm(h, 80):
            return True, "alt_tap", 2
        fg = self._fg()
        ft = u32.GetWindowThreadProcessId(fg, None) if fg else 0
        mt = k32.GetCurrentThreadId()
        tt = u32.GetWindowThreadProcessId(h, None)
        u32.AttachThreadInput(mt, ft, True)
        u32.AttachThreadInput(mt, tt, True)
        u32.BringWindowToTop(h)
        u32.SetForegroundWindow(h)
        u32.AttachThreadInput(mt, tt, False)
        u32.AttachThreadInput(mt, ft, False)
        if self._confirm(h, 100):
            return True, "attach_thread_input", 3
        u32.SwitchToThisWindow(h, True)
        if self._confirm(h, 120):
            return True, "SwitchToThisWindow", 4
        u32.ShowWindow(h, 6)
        time.sleep(0.08)
        u32.ShowWindow(h, 9)
        u32.SetWindowPos(h, ctypes.c_void_p(-1), 0, 0, 0, 0, 0x43)
        u32.SetWindowPos(h, ctypes.c_void_p(-2), 0, 0, 0, 0, 0x43)
        u32.SetForegroundWindow(h)
        if self._confirm(h, 200):
            return True, "minimize_restore_topmost", 5
        return False, "all_methods_failed", 5

    # ------------------------------------------------------------------ capture
    def _grab(self) -> dict[str, Any]:
        """Per-step capture stats.  DXGI path = resident stream peek + strided aHash (no PIL, no channel-swap copy)."""
        t0 = time.perf_counter()
        reason: Optional[str] = None
        self.stream.idle_check()
        arr, reused, mode = self.stream.grab() if self.cam_err is None else (None, False, "none")
        if arr is not None:
            self.last_arr, self.last_img = arr, None
            fh = _ahash_np(arr)
            st: dict[str, Any] = {"capture_backend": "DXGI", "dirty_rects_count": -1, "frame_ms": round((time.perf_counter() - t0) * 1000, 3), "width": int(arr.shape[1]),
                                  "height": int(arr.shape[0]), "frame_hash": fh, "timed_out_reused_frame": reused, "stream_mode": mode}
            self.last_stats = st
            return st
        reason = self.stream.err or getattr(self.stream, "err_stream", None) or "DXGI unavailable"
        try:
            from PIL import ImageGrab

            img = ImageGrab.grab(all_screens=True)
        except Exception as e:  # noqa: BLE001
            return {"capture_backend": "NONE", "dirty_rects_count": -1, "frame_ms": (time.perf_counter() - t0) * 1000, "fallback_reason": f"{reason}; PIL: {e}"}
        self.last_img, self.last_arr = img, None
        st = {"capture_backend": "GDI", "dirty_rects_count": -1, "frame_ms": round((time.perf_counter() - t0) * 1000, 3), "width": img.width, "height": img.height,
              "frame_hash": _ahash(img), "timed_out_reused_frame": False, "fallback_reason": reason, "stream_mode": "gdi"}
        self.last_stats = st
        return st

    def _shot_image(self, region: Optional[list[int]]) -> Any:
        """Crop in numpy FIRST (cheap), then convert BGRA->RGB PIL only for the cropped area."""
        from PIL import Image

        if self.last_arr is not None:
            arr = self.last_arr
            H, W = arr.shape[0], arr.shape[1]
            if region:
                x, y, w, h = region
                x0, y0, x1, y1 = max(0, x), max(0, y), min(W, x + w), min(H, y + h)
                if x1 > x0 and y1 > y0:
                    arr = arr[y0:y1, x0:x1]
            arr = self.stream.snapshot(arr) if self.stream.started else arr
            return Image.fromarray(arr[:, :, 2::-1])  # BGR(A) -> RGB without touching alpha
        img = self.last_img
        if img is not None and region:
            x, y, w, h = region
            img = img.crop((max(0, x), max(0, y), max(1, x + w), max(1, y + h)))
        return img

    # ------------------------------------------------------------------ fast foreground probe (<2 ms, Win32 only)
    def fg_probe(self) -> dict[str, Any]:
        t0 = time.perf_counter()
        h = self._fg()
        out: dict[str, Any] = {"hwnd": h, "pid": 0, "process": "", "class": "", "title": "", "own_console": False, "system_popup": False, "occluded": False, "cloaked": False, "minimized": False}
        if not h:
            out["ms"] = round((time.perf_counter() - t0) * 1000, 3)
            return out
        pid = wt.DWORD()
        u32.GetWindowThreadProcessId(h, ctypes.byref(pid))
        c = ctypes.create_unicode_buffer(128)
        u32.GetClassNameW(h, c, 128)
        t = ctypes.create_unicode_buffer(256)
        u32.GetWindowTextW(h, t, 256)
        out.update(pid=pid.value, process=self._proc(pid.value), **{"class": c.value}, title=t.value, own_console=self._is_own(pid.value, c.value), minimized=bool(u32.IsIconic(h)))
        cl = ctypes.c_int(0)
        try:
            ctypes.windll.dwmapi.DwmGetWindowAttribute(ctypes.c_void_p(h), 14, ctypes.byref(cl), 4)
        except Exception:  # noqa: BLE001
            pass
        out["cloaked"] = cl.value != 0
        # an enabled owned popup (modal dialog / permission prompt / file picker) means the page is NOT interactive
        try:
            pop = u32.GetWindow(h, 6)  # GW_ENABLEDPOPUP
            out["system_popup"] = bool(pop and int(pop) != h)
        except Exception:  # noqa: BLE001
            pass
        r = wt.RECT()
        if u32.GetWindowRect(h, ctypes.byref(r)):
            w, hh = r.right - r.left, r.bottom - r.top
            hits = 0
            for fx, fy in ((0.5, 0.5), (0.25, 0.4), (0.75, 0.4), (0.5, 0.75)):
                top = u32.WindowFromPoint(wt.POINT(int(r.left + w * fx), int(r.top + hh * fy)))
                if top:
                    root = u32.GetAncestor(top, 2)  # GA_ROOT
                    if root and int(root) != h:
                        hits += 1
            out["occluded"] = hits >= 2
        out["ms"] = round((time.perf_counter() - t0) * 1000, 3)
        return out

    def guard_focus(self, hwnd: int) -> dict[str, Any]:
        """Host-console focus theft guard: if the foreground is our own console (or nothing), re-activate the work window (verified)."""
        h = self._fg()
        if not hwnd or not u32.IsWindow(hwnd):
            return {"ok": False, "reason": "no work window"}
        if h == hwnd:
            return {"ok": True, "method": "already"}
        pid = wt.DWORD()
        u32.GetWindowThreadProcessId(h, ctypes.byref(pid)) if h else None
        if h and pid.value not in self.own:
            return {"ok": True, "method": "foreground is another app (left untouched)"}
        ok, how, lvl = self.force_foreground(hwnd)
        return {"ok": ok, "method": how, "level": lvl}

    # ------------------------------------------------------------------ UIA
    def _uia(self, hwnd: int, skeleton: bool, max_el: int) -> list[dict[str, Any]]:
        import uiautomation as auto

        self.epoch += 1
        self.refs.clear()
        out: list[dict[str, Any]] = []
        deadline = time.time() + (0.8 if skeleton else 1.5)
        root = auto.ControlFromHandle(hwnd)
        if root is None:
            return out

        row_ctr = [0]

        def walk(c: Any, depth: int, tb: bool, row: bool, modal: bool, rown: int = 0) -> None:
            if depth > 14 or len(out) >= max_el or time.time() > deadline:
                return
            for ch in c.GetChildren():
                if len(out) >= max_el or time.time() > deadline:
                    return
                role = ch.ControlTypeName[:-7].lower()
                tb2, row2, modal2 = tb or role in ("toolbar", "menubar", "titlebar", "tab"), row or role in ("listitem", "dataitem", "treeitem"), modal or (role == "window" and depth > 0)
                rn2 = rown
                if not row and role in ("listitem", "dataitem"):  # v15: a real list item starts a new numbered row (children inherit it)
                    row_ctr[0] += 1
                    rn2 = row_ctr[0]
                try:
                    r = ch.BoundingRectangle
                    rect = [r.left, r.top, r.right - r.left, r.bottom - r.top]
                    name = ch.Name or ""
                    off = ch.IsOffscreen
                except Exception:
                    continue
                if not off and rect[2] > 0 and rect[3] > 0 and (role in ROLE_INTERACTIVE or (not skeleton and name and role in ("text", "statusbar"))):
                    n = len(out) + 1
                    rid = f"@{self.epoch}:e{n}"
                    zone = "Modal" if modal2 else "Row" if row2 else "Toolbar" if tb2 else "Other"
                    val = ""
                    if role in ("edit", "combobox", "document"):
                        try:
                            val = ch.GetValuePattern().Value or ""
                        except Exception:
                            pass
                    key = f"{abs(hash((role, ch.AutomationId, ch.ClassName, name, zone))) & 0xFFFFFFFFFFFF:x}"
                    st_ = [] if ch.IsEnabled else ["disabled"]
                    if role in ("listitem", "dataitem", "treeitem", "tabitem", "radiobutton"):  # v17: REAL selection state (v16.4 reported none -> `实际 []`)
                        try:
                            _sp = ch.GetSelectionItemPattern()
                            if _sp is not None and _sp.IsSelected:
                                st_.append("selected")
                        except Exception:
                            pass
                    if role in ("checkbox", "radiobutton"):
                        try:
                            _tp = ch.GetTogglePattern()
                            if _tp is not None and int(_tp.ToggleState) == 1:
                                st_.append("checked")
                        except Exception:
                            pass
                    out.append({"ref_id": rid, "role": role, "name": name[:160], "value": val[:200], "rect": rect, "zone": zone, "stable_key": key,
                                "states": st_, "patterns": [], "depth": depth, "automation_id": getattr(ch, "AutomationId", "") or "",
                                "runtime_id": self._rid(ch), "row": (rn2 or None)})
                    self.refs[rid] = (ch, name, rect, hwnd)
                if role not in ("scrollbar", "separator", "thumb", "image"):
                    walk(ch, depth + 1, tb2, row2, modal2, rn2)

        walk(root, 0, False, False, False)
        return out

    @staticmethod
    def _rid(ch: Any) -> str:
        try:
            r = ch.GetRuntimeId() if hasattr(ch, "GetRuntimeId") else None
            return ".".join(str(int(x)) for x in r) if r else ""
        except Exception:  # noqa: BLE001
            return ""

    def _resolve(self, ref: str, expect_epoch: Optional[int]) -> tuple[Any, tuple[Any, str, list[int], int]] | tuple[str, str]:
        m = re.match(r"@(\d+):", ref or "")
        if not m or int(m.group(1)) != self.epoch or (expect_epoch is not None and expect_epoch != self.epoch):
            return "STALE_EPOCH", f"ref {ref} is from an older epoch (current {self.epoch})"
        t = self.refs.get(ref)
        if not t:
            return "NOT_FOUND", f"ref {ref} unknown"
        try:
            if (t[0].Name or "") != t[1]:
                return "STALE_EPOCH", "element changed since snapshot"
        except Exception as e:  # noqa: BLE001
            return "STALE_EPOCH", f"element vanished: {e}"
        return t[0], t

    # ------------------------------------------------------------------ input
    def _move(self, x: int, y: int, humanize: bool = True, tw: float = 24.0) -> Optional[str]:
        sx, sy = ctypes.c_long(), ctypes.c_long()
        pt = wt.POINT()
        u32.GetCursorPos(ctypes.byref(pt))
        sx, sy = pt.x, pt.y
        vx, vy, vw, vh = (u32.GetSystemMetrics(i) for i in (76, 77, 78, 79))

        def abs_move(ix: int, iy: int) -> None:
            _send(_mouse(0x8001 | 0x4000, int((ix - vx) * 65535 / max(1, vw - 1)), int((iy - vy) * 65535 / max(1, vh - 1))))
            self.last_own_tick = time.time()
            self.guard.mark_own((ix, iy))

        d = math.hypot(x - sx, y - sy)
        if not humanize or d < 3:
            abs_move(x, y)
            return None
        ms = min(850, max(90, 70 + 105 * math.log2(d / max(8, tw) + 1)))
        steps = max(6, int(ms / 8))
        nx, ny = -(y - sy) / d, (x - sx) / d
        bend = min(60, d * 0.08) * (1 if (sx + sy) % 2 == 0 else -1)
        c1 = (sx + (x - sx) * 0.3 + nx * bend, sy + (y - sy) * 0.3 + ny * bend)
        c2 = (sx + (x - sx) * 0.7 + nx * bend * 0.5, sy + (y - sy) * 0.7 + ny * bend * 0.5)
        lx = ly = None
        strikes = 0
        for i in range(1, steps + 1):
            t = i / steps
            e = t * t * (3 - 2 * t)
            u = 1 - e
            px = u ** 3 * sx + 3 * u * u * e * c1[0] + 3 * u * e * e * c2[0] + e ** 3 * x
            py = u ** 3 * sy + 3 * u * u * e * c1[1] + 3 * u * e * e * c2[1] + e ** 3 * y
            abs_move(round(px), round(py))
            lx, ly = round(px), round(py)
            time.sleep(0.008)
            u32.GetCursorPos(ctypes.byref(pt))
            if math.hypot(pt.x - lx, pt.y - ly) > self.guard.deadzone_px:
                strikes += 1
                if strikes >= 2:
                    self.guard.register_external(why=f"cursor drift {pt.x - lx},{pt.y - ly}px")
                    return "USER_ACTIVE"
            else:
                strikes = 0
        abs_move(x, y)
        return None

    def _click(self, button: str, count: int) -> None:
        d, u = {"right": (0x8, 0x10), "middle": (0x20, 0x40)}.get(button, (0x2, 0x4))
        for i in range(count):
            _send(_mouse(d))
            time.sleep(0.038)
            _send(_mouse(u))
            if i + 1 < count:
                time.sleep(0.06)

    def _type(self, text: str) -> None:
        for ch in text:
            raw = ch.encode("utf-16-le")
            for i in range(0, len(raw), 2):
                cu = int.from_bytes(raw[i:i + 2], "little")
                _send(_key(0, cu, 0x4), _key(0, cu, 0x4 | 0x2))
            time.sleep(0.004)

    def _press(self, keys: str) -> list[str]:
        sent = []
        for chord in keys.split():
            toks = ["shift", "3"] if chord == "#" else [t for t in chord.lower().split("+") if t]
            vks = []
            for t in toks:
                if t in VK:
                    vks.append(VK[t])
                elif re.fullmatch(r"f(\d{1,2})", t) and 1 <= int(t[1:]) <= 24:
                    vks.append(0x70 + int(t[1:]) - 1)
                elif len(t) == 1:
                    vks.append(ord(t.upper()) if t.isalnum() else (u32.VkKeyScanW(ord(t)) & 0xFF))
                else:
                    raise ValueError(f"unknown key {t}")
            seq = []
            for v in vks:
                seq.append(_key(v, u32.MapVirtualKeyW(v, 0), 0x1 if v in EXT else 0))
            for v in reversed(vks):
                seq.append(_key(v, u32.MapVirtualKeyW(v, 0), 0x2 | (0x1 if v in EXT else 0)))
            _send(*seq)
            self.last_own_tick = time.time()
            sent.append(chord.lower())
            time.sleep(0.035)
        return sent

    def user_active(self) -> bool:
        """v16: InputGuard decides (own-input spans + >=15px dead-zone + 1.5 s quiet window); GetLastInputInfo alone can no longer misattribute our own SendInput to a human."""
        class LII(ctypes.Structure):
            _fields_ = [("cbSize", wt.UINT), ("dwTime", wt.DWORD)]

        li = LII(ctypes.sizeof(LII), 0)
        u32.GetLastInputInfo(ctypes.byref(li))
        pt = wt.POINT()
        u32.GetCursorPos(ctypes.byref(pt))
        pressed = any(u32.GetAsyncKeyState(vk) & 0x8000 for vk in (0x01, 0x02, 0x04, 0x05, 0x06, 0x08, 0x09, 0x0D, 0x1B, 0x20, *range(0x30, 0x5B), *range(0x60, 0x70)))
        return self.guard.observe(int(li.dwTime), int(k32.GetTickCount()), (int(pt.x), int(pt.y)), pressed)

    # ------------------------------------------------------------------ protocol
    async def hello(self) -> dict[str, Any]:
        rss = 0.0
        try:
            import psutil

            rss = psutil.Process().memory_info().rss / 1048576
        except Exception:
            pass
        return {"type": "hello_ack", "ok": True, "peer": "py-native", "version": "16.0.0", "caps": ["input_guard", "focus_steal_v16", "uia_ref", "sendinput", "verified_foreground", "occlusion", "dxcam_stream", "fg_probe", "guard_focus", "runtime_id"], "rss_mb": rss}

    async def handle(self, req: dict[str, Any]) -> dict[str, Any]:
        t = req.get("type")
        if t == "hello":
            r = await self.hello()
            r["id"] = req.get("id")
            return r
        if not IS_WIN:
            return {"type": "error", "id": req.get("id"), "ok": False, "code": "UNSUPPORTED", "message": "native driver is Windows-only"}
        return await asyncio.to_thread(self._handle_sync, req)

    def _handle_sync(self, req: dict[str, Any]) -> dict[str, Any]:
        t = req.get("type")
        if t == "observe":
            return self._observe(req)
        if t == "action":
            return self._action(req)
        if t == "fg_probe":
            r = self.fg_probe()
            r.update(type="fg_probe_result", id=req.get("id"), ok=True)
            return r
        if t == "guard_focus":
            r = self.guard_focus(int(req.get("hwnd") or 0))
            r.update(type="guard_focus_result", id=req.get("id"))
            return r
        if t == "capture_bench":
            ms, fresh = [], []
            backend, reason = "NONE", None
            for _ in range(int(req.get("frames", 100))):
                s = self._grab()
                ms.append(s["frame_ms"])
                if not s.get("timed_out_reused_frame"):
                    fresh.append(s["frame_ms"])
                backend, reason = s["capture_backend"], reason or s.get("fallback_reason")
                time.sleep(0.016 if req.get("pace", True) else 0)
            ms.sort()
            fresh.sort()
            pc = lambda a, p: a[min(len(a) - 1, round((len(a) - 1) * p))] if a else 0.0  # noqa: E731
            return {"type": "capture_bench_result", "id": req.get("id"), "backend": backend, "frames": len(ms), "p50_ms": pc(ms, .5), "p95_ms": pc(ms, .95), "p99_ms": pc(ms, .99),
                    "fresh_frames": len(fresh), "p50_fresh_ms": pc(fresh, .5), "fallback_reason": reason}
        if t == "shutdown":
            return {"type": "bye", "id": req.get("id"), "ok": True}
        return {"type": "error", "id": req.get("id"), "ok": False, "code": "UNSUPPORTED", "message": f"unknown type {t}"}

    def _observe(self, req: dict[str, Any]) -> dict[str, Any]:
        t0 = time.perf_counter()
        wins = self.windows()
        fg = self._fg()
        tgt = None
        if req.get("hwnd"):
            tgt = next((w for w in wins if w["hwnd"] == req["hwnd"]), None)
        if tgt is None:
            tgt = next((w for w in wins if w["hwnd"] == fg and not w["own_console"] and w["class"] not in SHELL), None) or next(
                (w for w in wins if not w["own_console"] and not w["minimized"] and not w["cloaked"] and w["class"] not in SHELL and w["title"]), None)
        for w in wins:
            if (tgt and w["hwnd"] == tgt["hwnd"]) or w["hwnd"] == fg:
                w["occluded_by"] = self._occluders(w, wins)
        stats = self._grab()
        env: dict[str, Any] = {"type": "observation", "id": req.get("id"), "ok": True, "channel": "uia", "snapshot_epoch": self.epoch, "hwnd": tgt["hwnd"] if tgt else 0,
                               "title": tgt["title"] if tgt else "", "process": tgt["process"] if tgt else "", "fg_hwnd": fg, "windows": wins[:40], "elements": [],
                               "dxgi_stats": stats, "screen": {"w": stats.get("width"), "h": stats.get("height")}}
        uia_ms = 0.0
        if req.get("channel") == "jab":
            env["ok"], env["error"] = False, {"code": "UNSUPPORTED", "message": "JAB not available in py-native driver"}
        elif req.get("channel") != "dxgi_vision" and tgt:
            u0 = time.perf_counter()
            try:
                env["elements"] = self._uia(tgt["hwnd"], bool(req.get("skeleton")), int(req.get("max_elements", 160)))
                env["snapshot_epoch"] = self.epoch
            except Exception as e:  # noqa: BLE001
                env["error"] = {"code": "INTERNAL", "message": f"uiautomation: {e}"}
            uia_ms = (time.perf_counter() - u0) * 1000
        else:
            env["channel"] = "dxgi_vision"
        if req.get("channel", "auto") == "auto" and len(env["elements"]) < 6:
            env["uia_blind"] = True
        if req.get("screenshot_path") and (self.last_arr is not None or self.last_img is not None):
            t1 = time.perf_counter()
            reg = req.get("region") or (tgt["rect"] if tgt else None)
            img = self._shot_image(reg)
            sc = float(req.get("screenshot_scale", 1.0))
            if 0.05 < sc < 1.0:
                img = img.resize((max(1, int(img.width * sc)), max(1, int(img.height * sc))))
            img.convert("RGB").save(req["screenshot_path"], "PNG", compress_level=1)
            env["screenshot"] = {"path": req["screenshot_path"], "w": img.width, "h": img.height, "scale": sc, "src_rect": reg, "encode_ms": round((time.perf_counter() - t1) * 1000, 1)}
        env["telemetry"] = {"uia_ms": uia_ms, "total_ms": (time.perf_counter() - t0) * 1000}
        return env

    def _res(self, req: dict[str, Any], ok: bool, code: str, msg: str, eff: dict[str, Any], t0: float) -> dict[str, Any]:
        fa = self._fg()
        t = ctypes.create_unicode_buffer(256)
        u32.GetWindowTextW(fa, t, 256)
        eff["fg_hwnd_after"], eff["fg_title_after"] = fa, t.value
        return {"type": "action_result", "id": req.get("id"), "action_id": req.get("action_id"), "ok": ok, "code": code, "message": msg, "effect": eff,
                "idempotent_replay": False, "latency_ms": round((time.perf_counter() - t0) * 1000, 1)}

    def _action(self, req: dict[str, Any]) -> dict[str, Any]:
        aid = req.get("action_id") or ""
        if aid in self.replay:
            r = dict(self.replay[aid])
            r["id"], r["idempotent_replay"] = req.get("id"), True
            return r
        t_start = self.guard.clock()
        try:
            r = self._action_inner(req)
        finally:
            self._unpin_all()
            if req.get("action") not in ("click", "double_click", "right_click", "hover", "type", "key", "scroll", "drag"):
                self.guard.mark_own(start=t_start, end=self.guard.clock())  # UIA invoke/set_value etc. may bump GetLastInputInfo too
        if aid and r["code"] not in ("USER_ACTIVE", "STALE_EPOCH"):
            self.replay[aid] = r
            if len(self.replay) > 512:
                self.replay.pop(next(iter(self.replay)))
        return r

    def _action_inner(self, req: dict[str, Any]) -> dict[str, Any]:
        t0 = time.perf_counter()
        a = req.get("action", "")
        ee = req.get("expect_epoch")
        eh = req.get("expect_hwnd") or None
        wins = self.windows()
        fg = self._fg()
        eff: dict[str, Any] = {"fg_hwnd_before": fg}
        fgw = next((w for w in wins if w["hwnd"] == fg), None)
        physical = a in ("click", "double_click", "right_click", "hover", "type", "key", "scroll", "drag")
        R = lambda ok, code, msg: self._res(req, ok, code, msg, eff, t0)  # noqa: E731
        keys = str(req.get("keys", "")).lower()
        if a in ("key", "close_window"):
            closing = a == "close_window" or "alt+f4" in keys.split()
            if closing:
                v = fgw
                if a == "close_window":
                    v = next((w for w in wins if w["hwnd"] == req.get("hwnd")), fgw)
                if v is None or v["class"] in SHELL:
                    return R(False, "SECURITY_DENIED", "refusing to close shell/unknown window (opens the Windows shutdown dialog)")
                if v["own_console"]:
                    return R(False, "SECURITY_DENIED", "refusing to close the agent's own console")
            if any(k in ("win+r", "win+x", "win+l", "ctrl+alt+del", "ctrl+alt+delete") for k in keys.split()):
                return R(False, "SECURITY_DENIED", f"key chord {keys} is blocked")
        if physical:
            if eh and fg != eh:
                ok, how, n = self.force_foreground(eh)
                eff["refocus"] = {"ok": ok, "method": how, "attempts": n}
                if not ok:
                    t = next((w for w in wins if w["hwnd"] == eh), None)
                    eff["occluded_by"] = self._occluders(t, wins) if t else []
                    return R(False, "OCCLUDED", f"expected hwnd {eh} is not foreground and could not be raised (fg={fg})")
            if self.user_active() and not self.guard.wait_quiet(self.user_active, self.yield_wait_s):
                eff["guard"] = self.guard.snapshot()
                return R(False, "USER_ACTIVE", f"a human is using mouse/keyboard ({self.guard.last_reason}); yielded control after {self.yield_wait_s:.0f}s (auto-resume after {self.guard.quiet_s}s of silence)")
        try:
            if a in ("focus_window", "restore_window"):
                if req.get("hwnd"):
                    found = [w for w in wins if w["hwnd"] == req["hwnd"]]
                else:
                    q = _norm_name(str(req.get("title", "")))
                    found = [w for w in wins if q and not w["own_console"] and not w["cloaked"] and (q in _norm_name(w["title"]) or q.replace(".exe", "") == w["process"].lower().replace(".exe", "") or q in w["process"].lower())]
                if not found and not req.get("hwnd"):  # v16.1: browser titles become page titles -> resolve by owning process (GetWindowThreadProcessId + psutil)
                    found = self._find_by_process(str(req.get("title", "")), wins)
                    if found:
                        eff["resolved_by"] = f"process:{found[0]['process']}#{found[0]['pid']}"
                if not found:
                    vis = "; ".join(f"{w['process']}「{w['title'][:18]}」" for w in wins if w["title"] and not w["own_console"] and w["class"] not in SHELL)[:300]
                    return R(False, "NOT_FOUND", f"no window matches {req.get('title')!r}（已按标题 + 进程名双重查找）；当前可见窗口：{vis}")
                if len(found) > 1 and not req.get("hwnd") and found[0]["process"] != found[1]["process"]:
                    return R(False, "AMBIGUOUS_TARGET", "; ".join(f"{w['hwnd']}:{w['title']}[{w['process']}]" for w in found[:5]))
                tw = found[0]
