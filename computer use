# ---------- ② DeepSeek：thinking 关闭 / 视觉 max_tokens=4096 / EmptyContent 快速局部重试 / detail 策略 ----------
function New-ChatPayload([string]$systemText, [string]$userContent, $userParts, [string]$modelName, [int]$maxTok, [bool]$jsonMode = $true) {
    $uc = $userContent
    if ($null -ne $userParts) { $uc = @($userParts) }
    $messages = @(
        [ordered]@{ role = 'system'; content = $systemText }
        [ordered]@{ role = 'user'; content = $uc }
    )
    $payload = [ordered]@{ model = $modelName; messages = $messages; temperature = 0; max_tokens = $maxTok }
    if ($jsonMode -and $modelName -notlike '*reasoner*') { $payload['response_format'] = @{ type = 'json_object' } }
    # v10：官方 API 默认开启 thinking，思考 token 计入 max_tokens → finish_reason=length + 空内容（日志 task #5）；动作决策不需要长思考
    if ($script:V10.ThinkOff -and $modelName -notlike '*reasoner*') { $payload['thinking'] = [ordered]@{ type = 'disabled' } }
    Assert-ChatPayloadSafe $payload
    return $payload
}
function Get-V10VisionDetail($esc) {
    if ($esc.Region) { return 'original' }
    if ($esc.Reason -in 'UIA_BLIND', 'CDP_CANVAS', 'EXPLICIT') { return "$($esc.Detail)" }   # 盲区 / 模型显式请求：需要精细定位，沿用请求值
    if ([int]$script:V10.VisionSeq -ge 1) { return 'original' }                              # 同一轮受阻里 low 已经用过一次仍没解决 → 局部精细
    return 'low'
}
function Compress-V10VisionText([string]$text, [int]$limit = 6000) {
    if ([string]::IsNullOrEmpty($text) -or $text.Length -le $limit) { return $text }
    $head = $text.Substring(0, [Math]::Min(1200, $text.Length))
    $tail = $text.Substring($text.Length - ($limit - 1250))
    return "$head`n…（SoM 上下文已精简，保留任务 / 计划头部与最新观察尾部）…`n$tail"
}
function Invoke-DeepSeekVisionStep([string]$userContent, $obs, $esc, [int]$step = 0) {
    if ($step - [int]$script:V10.VisionLastStep -gt 2) { $script:V10.VisionSeq = 0 }
    $detail = Get-V10VisionDetail $esc
    $esc2 = [pscustomobject]@{ Use = $true; Reason = $esc.Reason; Why = $esc.Why; Detail = $detail; Region = $esc.Region }
    $shot = New-SomAnnotatedScreenshot -Hwnd $obs.Foreground.Handle -Detail $detail -Region $esc2.Region
    if ($SaveScreenshots -and $script:RunDir) {
        try { [System.IO.File]::WriteAllBytes((Join-Path $script:RunDir ("task{0:D2}-step{1:D2}-som.jpg" -f $script:TaskNo, $step)), $shot.Data) } catch { }
    }
    $text = Compress-V10VisionText (ConvertTo-VisionText $userContent $shot)
    $regionNote = if ($esc.Region) { "（已按你请求的 region 裁剪放大）" } else { '' }
    $head = @"


【视觉轮次 · 感知通道=Vision($VisionModel) · 触发原因=$($esc.Why) · detail=$($shot.Detail)】
附图是前台窗口的截图${regionNote}：图像 $($shot.Width)x$($shot.Height) 像素，左上角为原点；已叠加两种提示：
 ① SoM 编号框：带 [n] 角标的彩色框 = 上面观察列表里的控件 [n]。能对应上的目标，优先用 {"id":n}（最稳，走 UIA）。
 ② 坐标标尺与网格：图像顶部 / 左侧的数字与虚线网格 = 图像像素坐标。
坐标规则：本轮文本里所有 @(x,y) 已改写为【图像坐标】；你输出的 x,y / from_x,from_y / to_x,to_y / region 也一律使用图像坐标，系统自动换算为物理屏幕坐标。点目标的中心，不要点边缘。
画布 / 游戏 / 自绘界面里没有 SoM 框的目标：直接输出图像坐标 (x,y)。文本里其他位置出现的坐标（inspect 矩形、历史记录）仍是物理像素，不要直接当 x,y 用。
看不清时输出 {"action":"vision_inspect","detail":"original","region":{"x":0,"y":0,"w":400,"h":300},"reason":"想放大看哪里"}（region 为图像坐标）。detail=low 仅用于确认整体状态，需要点准坐标请用 original。
批量删除 / 归档若页面是浏览器：优先输出 {"action":"toolbar_action","label":"删除"}。仍然只输出一个 JSON 对象，不要长篇推理。
"@
    $parts = @(
        [ordered]@{ type = 'text'; text = ($text + $head) }
        [ordered]@{ type = 'image_url'; image_url = [ordered]@{ url = ('data:image/jpeg;base64,' + $shot.Base64); detail = $shot.Detail } }
    )
    $raw = $null
    try { $raw = Invoke-DeepSeek '' '' $script:V10VisionMaxTokens $parts $VisionModel $true }
    catch {
        if ($_.Exception.Message -like '触发保护*') { throw }
        if ($_.Exception.Message -match 'response_format|json_object') { $raw = Invoke-DeepSeek '' '' $script:V10VisionMaxTokens $parts $VisionModel $false }
        else { throw }
    }
    if ($shot.Detail -eq 'low') { $script:V10.VisionLow++ } else { $script:V10.VisionOrig++ }
    $script:V10.VisionSeq = [int]$script:V10.VisionSeq + 1; $script:V10.VisionLastStep = $step
    $script:LastVision = $shot
    return [pscustomobject]@{ Raw = $raw; Ctx = $shot }
}
function Invoke-DeepSeek([string]$userContent, [string]$systemText = '', [int]$maxTok = 0, $userParts = $null, [string]$useModel = '', [bool]$jsonMode = $true) {
    # v10：v9.2 的重试骨架 + ① 视觉请求下限 4096 ② EmptyContent「快速局部重试」（零退避、翻倍预算、关 JSON 模式）③ reasoning_content 兜底
    #       ④ 400 提示 thinking 参数不被支持 → 自动摘掉该参数重发（不计入重试次数）
    if ([string]::IsNullOrEmpty($systemText)) { $systemText = $SystemPrompt }
    if ($maxTok -le 0) { $maxTok = Get-StepMaxTokens }
    if ($null -ne $userParts -and $maxTok -lt $script:V10VisionMaxTokens) { $maxTok = $script:V10VisionMaxTokens }
    if ([string]::IsNullOrEmpty($useModel)) { $useModel = $Model }
    $build = { param($mt, $jm, $mdl) $pl = New-ChatPayload $systemText $userContent $userParts $mdl $mt $jm; , ([System.Text.Encoding]::UTF8.GetBytes(($pl | ConvertTo-Json -Depth 10 -Compress))) }
    $bytes = & $build $maxTok $jsonMode $useModel
    $uri = "$($BaseUrl.TrimEnd('/'))/chat/completions"
    $lastErr = ''
    $swApi = [System.Diagnostics.Stopwatch]::StartNew()
    $emptyN = 0; $thinkRetried = $false
    foreach ($attempt in 1..8) {
        $httpStatus = $null; $retryAfter = 0.0
        try {
            $r = Invoke-DsHttpPost $uri $bytes 120
            if ($r.Status -ge 200 -and $r.Status -lt 300) {
                $obj = $r.Body | ConvertFrom-Json
                $content = ''
                try { $content = [string]$obj.choices[0].message.content } catch { $content = '' }
                $script:LastFinish = ''; try { $script:LastFinish = [string]$obj.choices[0].finish_reason } catch { }
                if ([string]::IsNullOrWhiteSpace($content)) {
                    $rc = ''; try { $rc = [string]$obj.choices[0].message.reasoning_content } catch { }
                    if ($rc) { $fj = Get-FirstJsonObject $rc; if ($fj) { $content = $fj } }
                }
                if ([string]::IsNullOrWhiteSpace($content)) { throw "EmptyContent: API 返回了空内容（finish_reason=$($script:LastFinish)）" }
                $script:LastApiMs = [int]$swApi.ElapsedMilliseconds
                Add-Span 'network' ([double]$swApi.Elapsed.TotalMilliseconds) 'deepseek'
                Set-LastUsage $obj $script:LastApiMs
                return $content
            }
            $httpStatus = $r.Status; $retryAfter = $r.RetryAfter
            throw ("HTTP $($r.Status) | " + (Limit-Text $r.Body 300))
        }
        catch {
            if ($_.Exception.Message -like '触发保护*') { throw }
            $detail = Get-InnerMessage $_.Exception
            $lastErr = $detail
            Write-Host "  API 调用失败（第 $attempt 次）: $detail" -ForegroundColor DarkYellow
            if ($httpStatus -eq 400 -and $script:V10.ThinkOff -and -not $thinkRetried -and "$detail" -match '(?i)thinking|reasoning_effort|unknown|unrecognized|additional properties|extra') {
                $thinkRetried = $true; $script:V10.ThinkOff = $false; $script:V10.ThinkFallback++
                Write-Host '  ↻ 网关不接受 thinking 参数，已摘除并重发（本会话不再发送）' -ForegroundColor DarkYellow
                $bytes = & $build $maxTok $jsonMode $useModel
                continue
            }
            if ("$detail" -match 'EmptyContent|空内容') {
                $emptyN++; $script:V92.EmptyRetries++
                if ($emptyN -eq 1) {
                    # 快速局部重试：不退避；预算翻倍；关 JSON 模式（json_object 是空内容的已知诱因）；强制 thinking 关
                    $script:V10.EmptyFast++
                    $maxTok = [Math]::Min(8192, $maxTok * 2); $script:V10.ThinkOff = $true
                    $bytes = & $build $maxTok $false $useModel
                    Write-Host "  ↻ EmptyContent 快速重试：max_tokens→$maxTok，关闭 JSON 模式，无退避" -ForegroundColor DarkYellow
                    continue
                }
                if ($emptyN -ge 3) { [void](Save-V92Checkpoint 'API 连续 3 次空响应'); break }
                $bk = Get-V92BackupTarget $useModel
                [void](Save-V92Checkpoint 'API 空响应，切换备用端点')
                $script:V92.Failovers++
                $uri = "$($bk.Base)/chat/completions"
                $bytes = & $build $maxTok $false $bk.Model
                Write-Host "  ↻ 第 3 次改用备用端点 $($bk.Base)（模型 $($bk.Model)，关闭 JSON 模式），已保存任务 Checkpoint" -ForegroundColor DarkYellow
                Wait-Safe ([int]([Math]::Min(8000.0, (Get-RetryDelayMs $emptyN 0)) * [double]$script:V92RetryScale))
                continue
            }
            if (-not (Test-ApiRetryable $httpStatus $detail)) { Write-Host "  （状态码 $httpStatus 属于请求本身的问题，重试不会有不同结果，已停止重试）" -ForegroundColor DarkYellow; break }
            if ($attempt -ge 5) { break }
            Wait-Safe ([int]((Get-RetryDelayMs $attempt $retryAfter) * [double]$script:V92RetryScale))
        }
    }
    throw "DeepSeek API 调用失败: $lastErr"
}

