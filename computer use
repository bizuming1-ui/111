        if hits >= 2:
            errs += 1
            if errs >= 6:
                break
        else:
            hits += 1
    return {"steps": steps, "outcome": "circuit_break", "note": "emulation of v10 ledger+fuse rules, not a measurement"}


if __name__ == "__main__":
