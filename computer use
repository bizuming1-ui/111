        env["telemetry"] = {"uia_ms": uia_ms, "total_ms": (time.perf_counter() - t0) * 1000}
        return env

    def _res(self, req: dict[str, Any], ok: bool, code: str, msg: str, eff: dict[str, Any], t0: float) -> dict[str, Any]:
        fa = self._fg()
        t = ctypes.create_unicode_buffer(256)
        u32.GetWindowTextW(fa, t, 256)
        eff["fg_hwnd_after"], eff["fg_title_after"] = fa, t.value
        return {"type": "action_result", "id": req.get("id"), "action_id": req.get("action_id"), "ok": ok, "code": code, "message": msg, "effect": eff,
                "idempotent_replay": False, "latency_ms": round((time.perf_counter() - t0) * 1000, 1)}

    def _action(self, req: dict[str, Any]) -> dict[str, Any]:
        aid = req.get("action_id") or ""
        if aid in self.replay:
            r = dict(self.replay[aid])
            r["id"], r["idempotent_replay"] = req.get("id"), True
            return r
        r = self._action_inner(req)
        if aid and r["code"] not in ("USER_ACTIVE", "STALE_EPOCH"):
            self.replay[aid] = r
            if len(self.replay) > 512:
                self.replay.pop(next(iter(self.replay)))
        return r

    def _action_inner(self, req: dict[str, Any]) -> dict[str, Any]:
