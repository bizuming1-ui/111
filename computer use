def clause_events(task: str) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []
    for c in CLAUSE_SPLIT.split(task or ""):
        c = c.strip()
        if not c:
            continue
        d, k = DELETE_RX.search(c), CREATE_RX.search(c)
        if d and k:
            pol = "DELETE_OR_CLEAR" if d.start() > k.start() else "CREATE_OR_SAVE"
        elif d:
            pol = "DELETE_OR_CLEAR"
        elif k:
            pol = "CREATE_OR_SAVE"
        else:
            continue
        out.append((pol, c))
    return out


def task_polarity(task: str) -> str:
    ev = clause_events(task)
    has_d = any(p == "DELETE_OR_CLEAR" for p, _ in ev)
    has_c = any(p == "CREATE_OR_SAVE" for p, _ in ev)
    return "MIXED" if has_d and has_c else "DELETE_OR_CLEAR" if has_d else "CREATE_OR_SAVE" if has_c else "NONE"


