BLOCKED_KEYS = {"win+r", "win+x", "win+l", "ctrl+alt+del", "ctrl+alt+delete"}
TOGGLE_ROLES = {"checkbox", "switch", "radiobutton", "radio", "menuitemcheckbox"}


def h64(s: str) -> str:
    return hashlib.blake2b(s.encode("utf-8", "ignore"), digest_size=8).hexdigest()


def hamming_hex(a: Optional[str], b: Optional[str]) -> int:
    if not a or not b:
        return 64
    return bin(int(a, 16) ^ int(b, 16)).count("1")


def obs_fingerprint(o: Observation) -> dict[str, Any]:
    """Semantic fingerprint = (window identity, URL, interactive element keys+values, coarse pixel hash)."""
    keys = "|".join(f"{e.stable_key}:{e.value or ''}:{','.join(e.states)}" for e in o.elements[:120])
    return {
        "win": h64(f"{o.hwnd}|{o.process}|{o.title}|{o.url or ''}|{o.fg_hwnd}"),
        "els": h64(keys),
        "pix": o.dxgi_stats.frame_hash if o.dxgi_stats else None,
        "n": len(o.elements),
    }


def fp_same(a: dict[str, Any], b: dict[str, Any]) -> bool:
    if a["win"] != b["win"] or a["els"] != b["els"]:
        return False
    return hamming_hex(a.get("pix"), b.get("pix")) <= 3


def action_sig(a: dict[str, Any], els: dict[int, Element] | None = None) -> str:
    name = a.get("action", "?")
    if name in ("focus_window", "restore_window"):
        tgt = (a.get("title") or a.get("hwnd") or "").__str__().lower()
        return f"{name}:{tgt}"
    if a.get("id") is not None and els and a["id"] in els:
        return f"{name}:key={els[a['id']].stable_key}:{(a.get('text') or '')[:20]}"
    if "x" in a and "y" in a:
        return f"{name}:xy={int(a['x']) // 24},{int(a['y']) // 24}"
    if name in ("key",):
        return f"key:{str(a.get('keys', '')).lower()}"
    if name in ("launch", "app_resolve"):
        return f"{name}:{str(a.get('target') or a.get('name') or '').lower()}"
    if name == "cdp_navigate":
        return f"nav:{a.get('url')}"
    return f"{name}:{h64(repr(sorted((k, str(v)) for k, v in a.items() if k not in ('thought', 'expect', 'step'))))}"


@dataclass
