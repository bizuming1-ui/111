    if (-not $IsWindows) { return $false }
    try { Add-Type -TypeDefinition $script:V12NativeCs -Language CSharp -ErrorAction Stop | Out-Null; try { [void][DsNative12]::TrySetPerMonitorDpiV2() } catch { }; return $true }
