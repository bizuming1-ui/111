#region ===================== 引导器：校验 → 释放 → 构建 → 启动 =====================
function Expand-Dscu {
    $bad = @(); $written = 0
    foreach ($f in $script:Manifest) {
        $t = ($f.Text -replace "`r`n", "`n")
        $hash = [Convert]::ToHexString([System.Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($t))).ToLowerInvariant()
        if ($hash -ne $f.Sha) { $bad += $f.Rel; continue }
        $p = Join-Path $script:Root $f.Rel
        $want = $t + "`n"
        if ((Test-Path $p) -and ([IO.File]::ReadAllText($p) -ceq $want)) { continue }
        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $p) | Out-Null
        [IO.File]::WriteAllText($p, $want, [Text.UTF8Encoding]::new($false))
        $written++
    }
    if ($bad.Count -gt 0) {
        Write-Host "✖ 以下 $($bad.Count) 个文件 SHA-256 校验失败（粘贴被终端截断/改写）：" -ForegroundColor Red
        $bad | ForEach-Object { Write-Host "   $_" -ForegroundColor Red }
        Write-Host '  建议：用 Windows Terminal 粘贴；或在网页上点「下载 .ps1」后执行  pwsh -File .\computer-use-v18.ps1' -ForegroundColor Yellow
        throw 'integrity check failed'
    }
    Write-Host ("  ✓ Monorepo 已就绪：{0} 个文件校验通过（本次写入 {1} 个）→ {2}" -f $script:Manifest.Count, $written, $script:Root) -ForegroundColor Green
    return $written
}

function Ensure-DscuMcp {
    # v16.2: official ChromeDevTools/chrome-devtools-mcp PINNED to an exact version (reproducible; never @latest)
    if ($env:DSCU_BROWSER_ENGINE -eq 'legacy') { return }
    $pin = if ($env:DSCU_MCP_VERSION) { $env:DSCU_MCP_VERSION.Trim().TrimStart('v') } else { '1.14.0' }
    if ($pin -notmatch '^\d+\.\d+\.\d+') { $pin = '1.14.0' }
    $script:McpPin = $pin
    if (Get-Command chrome-devtools-mcp -ErrorAction SilentlyContinue) {
        $cur = ''
        try { $cur = ((& chrome-devtools-mcp --version 2>&1) | Out-String).Trim() } catch { }
        if ($cur -match ('^' + [regex]::Escape($pin) + '\b')) { Write-Host "  ✓ chrome-devtools-mcp $cur == 锁定版本 $pin" -ForegroundColor Green; return }
        Write-Host "  ⚠ 全局 chrome-devtools-mcp 版本 '$cur' ≠ 锁定版本 $pin → 安装锁定版本" -ForegroundColor Yellow
    }
    $npm = Get-Command npm -ErrorAction SilentlyContinue
    if (-not $npm) { Write-Host '  ⚠ 未找到 npm：浏览器引擎将回退到 v15 cdp-daemon（安装 Node 后重启即可启用 chrome-devtools-mcp）' -ForegroundColor Yellow; return }
    Write-Host "▶ 安装官方 chrome-devtools-mcp@$pin（npm i -g，锁定版本）..." -ForegroundColor Cyan
    try { & npm install -g "chrome-devtools-mcp@$pin" 2>&1 | ForEach-Object { "    $_" } } catch { Write-Host "  ⚠ npm 安装失败：$($_.Exception.Message)（将回退到 cdp-daemon）" -ForegroundColor Yellow }
    $env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User')
    if (Get-Command chrome-devtools-mcp -ErrorAction SilentlyContinue) { Write-Host '  ✓ chrome-devtools-mcp 已就绪' -ForegroundColor Green }
    else { Write-Host '  ⚠ 仍未在 PATH 找到 chrome-devtools-mcp：将使用 npx 兜底，失败则回退 cdp-daemon' -ForegroundColor Yellow }
}

