@dataclass
class CdpEpochGuard:
    """Binds every CDP backendNodeId and @s<epoch>:e<id> to a monotonically increasing snapshot_epoch.
    Any DOM row deletion, virtual scroll mutation, or navigation bumps the epoch and immediately invalidates old IDs."""
    current_epoch: int = 1
    valid_nodes_by_epoch: dict[int, set[int]] = field(default_factory=dict)
    stale_intercepts: int = 0

    def register_snapshot(self, backend_node_ids: list[int], bump: bool = False) -> int:
        if bump or self.current_epoch not in self.valid_nodes_by_epoch:
            if self.valid_nodes_by_epoch:
                self.current_epoch += 1
        self.valid_nodes_by_epoch[self.current_epoch] = set(backend_node_ids)
        return self.current_epoch

    def invalidate_on_mutation(self, new_backend_node_ids: list[int]) -> int:
        self.current_epoch += 1
        self.valid_nodes_by_epoch[self.current_epoch] = set(new_backend_node_ids)
        return self.current_epoch

    def verify_action(self, expect_epoch: int, backend_node_id: int | None = None) -> tuple[bool, str]:
        if expect_epoch != self.current_epoch:
            self.stale_intercepts += 1
            return (
                False,
                f"STALE_EPOCH: action targeted epoch {expect_epoch}, but current DOM snapshot_epoch is {self.current_epoch} (DOM mutated/re-indexed; auto-refreshing tree instead of calling DOM.resolveNode)",
            )
        if backend_node_id is not None:
            valid = self.valid_nodes_by_epoch.get(self.current_epoch, set())
            if valid and backend_node_id not in valid:
                self.stale_intercepts += 1
                return (
                    False,
                    f"STALE_EPOCH: backendNodeId={backend_node_id} no longer exists in epoch {self.current_epoch}",
                )
        return True, "OK"


