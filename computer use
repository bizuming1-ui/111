"""snapshot_epoch — the anti-race primitive shared by Python / TS / Rust.

Every structural change of the target UI (row deleted, list re-ordered, dialog opened, navigation) bumps the epoch.
A ref (CDP backendNodeId, UIA @snapshot:ref) is bound to the epoch it was minted in; using it later yields STALE_EPOCH
*before* anything touches the browser — this is what turns `CDP DOM.resolveNode: No node with given id found`
(v10 log, task #3, 8 occurrences) into a cheap, deterministic "re-observe" instead of a 52-step spin.
"""
from __future__ import annotations

from dataclasses import dataclass, field


@dataclass
class EpochClock:
    epoch: int = 0
    history: list[tuple[int, str]] = field(default_factory=list)

    def bump(self, reason: str) -> int:
        self.epoch += 1
        self.history.append((self.epoch, reason))
        del self.history[:-64]
        return self.epoch


class EpochGuard:
    def __init__(self, clock: EpochClock | None = None):
        self.clock = clock or EpochClock()
        self._bound: dict[str, int] = {}

    @property
    def epoch(self) -> int:
        return self.clock.epoch

    def bind(self, refs: list[str]) -> int:
        for r in refs:
            self._bound[r] = self.clock.epoch
        return self.clock.epoch

    def invalidate(self, reason: str) -> int:
        """Structural change: bump epoch; every ref minted earlier becomes stale (lazily, by comparison)."""
        return self.clock.bump(reason)

    def check(self, ref: str | None = None, expect_epoch: int | None = None) -> str | None:
        """None = fine, else the protocol error code to answer with."""
        if expect_epoch is not None and expect_epoch != self.clock.epoch:
            return "STALE_EPOCH"
        if ref is not None:
            e = self._bound.get(ref)
            if e is None:
                return "STALE_REF"
            if e != self.clock.epoch:
                return "STALE_EPOCH"
        return None
