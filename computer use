CHILD = r'''
import sys, os, json
sys.path.insert(0, sys.argv[1])
from agent_brain.transaction import WalTransaction, WriteAheadLog
wal_path, mode, paths = sys.argv[2], sys.argv[3], json.loads(sys.argv[4])
tx = WalTransaction(WriteAheadLog(wal_path), "删除文件")
txid = tx.create("file_recycle", {"type": "file_absent", "paths": paths})
tx.freeze(txid, paths); tx.confirm(txid); tx.start(txid)          # started is fsync'ed BEFORE any side effect
if mode == "after_effect":
    for p in paths: os.remove(p)
elif mode == "partial":
    os.remove(paths[0])
elif mode == "gui_unknown":
    tx2 = WalTransaction(WriteAheadLog(wal_path), "点击发送")
    t2 = tx2.create("gui_action", {"type": "none"}); tx2.freeze(t2, ["send-button"]); tx2.confirm(t2); tx2.start(t2)
os._exit(137)  # SIGKILL-equivalent: no flush, no `committed`
'''


def suite_wal(args) -> Rec:
    r = Rec("wal_crash_recovery")
    good = total = 0
    replays: dict[str, int] = {}
    side_effects = 0

    def scenario(mode: str, n_files: int, trial: int):
        nonlocal good, total, side_effects
        d = Path(tempfile.mkdtemp(prefix=f"dscu_wal_{mode}_"))
        paths = []
        for i in range(n_files):
            p = d / f"f{i}.txt"
            p.write_text(f"payload {i}", encoding="utf-8")
            paths.append(str(p))
        wal_path = d / "wal.jsonl"
        rc = subprocess.run([sys.executable, "-c", CHILD, str(ROOT), str(wal_path), mode, json.dumps(paths)], capture_output=True, text=True).returncode
        killed = rc != 0
        if trial == 0 and mode == "after_effect":  # torn tail: a crash in the middle of a WAL write must not break recovery
            with open(wal_path, "ab") as f:
                f.write(b'{"v":2,"txid":"torn","phase":"star')
        wal = WriteAheadLog(wal_path)
        decisions = recover(wal)  # <- what Brain.start() runs
        total += 1
        expected = {"before_effect": "resume_allowed", "after_effect": "mark_committed", "partial": "resume_allowed", "gui_unknown": "paused_for_user"}[mode]
        gui = [x for x in decisions if x.kind == "gui_action"]
        main = [x for x in decisions if x.kind == "file_recycle"]
        decision_ok = killed and ((mode == "gui_unknown" and gui and gui[0].action == "paused_for_user") or (mode != "gui_unknown" and main and main[0].action == expected))
        exec_count = 0
        for x in main:
            if x.action == "resume_allowed":
                for p in x.probe.remaining:
                    os.remove(p)
                    replays[p] = replays.get(p, 0) + 1
                    exec_count += 1
        after = [Path(p).exists() for p in paths]
        final_ok = (not any(after)) if mode in ("before_effect", "partial", "after_effect") else True
        dup = sum(1 for p in paths if replays.get(p, 0) > 1)
        if mode == "after_effect":
            dup += exec_count
        if mode == "partial":
            dup += 0 if exec_count == n_files - 1 else 1
        side_effects += dup
        ok = bool(decision_ok and final_ok and dup == 0)
        again = recover(WriteAheadLog(wal_path))  # a second restart must be a no-op (idempotent recovery)
        ok = ok and not [x for x in again if x.kind in ("file_recycle",)]
        good += int(ok)
        if trial == 0 or not ok:
            r(f"{mode}[{n_files} files] trial{trial}", ok, f"decision={[x.action for x in decisions]} dup={dup} wal.torn={wal.torn_lines}", mode=mode)
        return ok

    for mode in ("before_effect", "after_effect", "partial", "gui_unknown"):
        for trial in range(max(1, args.trials)):
            scenario(mode, 1 if mode in ("before_effect", "gui_unknown") else 4, trial)
    wal = WriteAheadLog(Path(tempfile.mkdtemp()) / "w.jsonl")
    tx = WalTransaction(wal, "x")
    tid = tx.create("file_recycle")
    try:
        tx.start(tid)
        illegal = False
    except Exception:  # noqa: BLE001
        illegal = True
    r("非法状态迁移 created→started 被拒绝（必须 frozen_targets→confirmed）", illegal, "")

    class Crash(BaseException):
        pass

    def crash_hook(mid, k):
        if k == 4:
            raise Crash()

    for variant in ("partial_trash", "all_trashed_before_commit", "api_unavailable"):
        total += 1
        srv = FakeGmailServer(50, seed=7)
        td = Path(tempfile.mkdtemp(prefix="dscu_gwal_"))
        _cfg = Config()
        _cfg.root = td
        store = gs.TokenStore(td / "gmail_token.dpapi", XorProtector())
        store.save({"access_token": "at-0", "refresh_token": "rt", "client_id": "cid", "client_secret": "cs", "expires_at": time.time() + 3000})
        skill = gs.GmailSkill(store, srv.transport, sleep=lambda s: None, seed=1)
        ids = srv.order[:5] + srv.order[-1:]
        wal = WriteAheadLog(_cfg.data_dir / "wal.jsonl")  # the very file Brain.start() will scan after the "restart"
        tx = WalTransaction(wal, "删除前5+后1")
        txid = tx.create("gmail_trash", {"type": "gmail_labels"})
        tx.freeze(txid, ids, {"type": "gmail_labels"})
        tx.confirm(txid)
        tx.start(txid)
        if variant == "partial_trash":
            srv.on_trash = crash_hook
        try:
            skill.trash_messages(ids)  # all_trashed_before_commit: completes fully, then the process dies before writing `committed`
        except Crash:
            pass
        srv.on_trash = None
        calls_before = len(srv.log)
        brain, out = new_brain(root=td)  # "restart": brand-new Brain on the same root; Brain.start() performs recovery
        brain.gmail = gs.GmailSkill(store, srv.transport, sleep=lambda s: None, seed=2) if variant != "api_unavailable" else None
        with mock.patch.object(brain, "_gmail_skill", lambda: brain.gmail):
            run(brain.start())
        dec = [x for x in brain.wal_decisions if x.kind == "gmail_trash"]
        want = {"partial_trash": "resume_allowed", "all_trashed_before_commit": "mark_committed", "api_unavailable": "paused_for_user"}[variant]
        ok = bool(dec) and dec[0].action == want
        if variant == "partial_trash" and ok:
            ok = sorted(dec[0].probe.remaining) == sorted(ids[3:])
            brain.auto_confirm = True
            res = run(brain.resume_transaction(dec[0].txid))
            ok = ok and res[0] == "completed_verified" and srv.trashed_ids() == set(ids) and all(srv.trash_count[i] == 1 for i in ids)
        if variant == "all_trashed_before_commit":
            ok = ok and all(srv.trash_count[i] == 1 for i in ids) and not [c for c in srv.log[calls_before:] if c[0] == "POST"]
        if variant == "api_unavailable":
            ok = ok and len(srv.log) == calls_before and not brain.pending_resume
        good += int(ok)
        side_effects += 0 if all(v <= 1 for v in srv.trash_count.values()) else 1
        r(f"gmail crash: {variant}", ok, f"decision={[x.action for x in dec]} trash_counts={sorted(set(srv.trash_count.values()))}", mode=variant)
    r.correctness = good / total if total else 0.0  # type: ignore[attr-defined]
    r.duplicates = side_effects  # type: ignore[attr-defined]
    r.scenarios = total  # type: ignore[attr-defined]
    return r


