  const t1 = Date.now();
  const pg = page.result.value;
  const dom = buildDom(doc.root);
  const nodes: any[] = ax.nodes ?? [];
  const cands: { id: number; role: string; name: string; value?: string; props: Record<string, any>; order: number }[] = [];
  nodes.forEach((n, order) => {
    if (n.ignored || n.backendDOMNodeId === undefined) return;
    const role = String(n.role?.value ?? "");
    const name = norm(n.name?.value, 100);
    if (!INTERACTIVE.has(role)) return;
    if (KEEP_NAMED.has(role) && !name) return;
