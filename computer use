from __future__ import annotations

import os
import re
import shutil
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Optional

KNOWN_FOLDERS = {
    "桌面": ("B4BFCC3A-DB2C-424C-B029-7FE99A87C641", "Desktop"),
    "desktop": ("B4BFCC3A-DB2C-424C-B029-7FE99A87C641", "Desktop"),
    "文档": ("FDD39AD0-238F-46AF-ADB4-6C85480369C7", "Documents"),
    "documents": ("FDD39AD0-238F-46AF-ADB4-6C85480369C7", "Documents"),
    "下载": ("374DE290-123F-4565-9164-39C4925E467B", "Downloads"),
    "downloads": ("374DE290-123F-4565-9164-39C4925E467B", "Downloads"),
}


def known_folder(name: str) -> Path:
    guid, fallback = KNOWN_FOLDERS[name.lower()]
    if sys.platform == "win32":
        try:
            import ctypes
            from ctypes import wintypes

            class GUID(ctypes.Structure):
                _fields_ = [("a", wintypes.DWORD), ("b", wintypes.WORD), ("c", wintypes.WORD), ("d", ctypes.c_ubyte * 8)]

            g = GUID()
            ctypes.windll.ole32.CLSIDFromString(ctypes.c_wchar_p("{" + guid + "}"), ctypes.byref(g))
            out = ctypes.c_wchar_p()
            if ctypes.windll.shell32.SHGetKnownFolderPath(ctypes.byref(g), 0, None, ctypes.byref(out)) == 0 and out.value:
                p = Path(out.value)
                ctypes.windll.ole32.CoTaskMemFree(out)
                return p
        except Exception:
            pass
    return Path.home() / fallback


@dataclass
class FileTask:
    folder_name: str
    folder: Path
    filename: str
    content: str
    app: str


_RX = re.compile(
    r"(?:输入|写入|写上|键入)(?:内容)?[:：]?\s*(?P<content>.+?)\s*[，,。;；、]\s*(?:并|然后)?\s*(?:把它|将其)?\s*(?:命名为|保存为|文件名为|取名为|名为|叫做|叫)\s*(?P<name>[^\s，,。;；]+)",
    re.S,
)
_FOLDER = re.compile(r"(?:保存|存|放)(?:在|到|于)?\s*(桌面|文档|下载|desktop|documents|downloads)", re.I)


def parse_file_task(task: str) -> Optional[FileTask]:
    """Only matches *pure* "open notepad, type X, name it Y, save on desktop" intents; everything else -> LLM path."""
    if not re.search(r"记事本|notepad|文本文件|txt", task, re.I):
        return None
    m, f = _RX.search(task), _FOLDER.search(task)
    if not (m and f):
        return None
    name = m.group("name").strip().strip("“”\"'")
    if re.search(r"[\\/:*?\"<>|]", name) or not name:
        return None
    if "." not in name:
        name += ".txt"
    folder_name = f.group(1)
    return FileTask(folder_name, known_folder(folder_name), name, m.group("content").strip().strip("“”\"'"), "notepad")


def write_verified(ft: FileTask) -> tuple[bool, str, Path]:
    p = ft.folder / ft.filename
    data = ft.content.encode("utf-8")
    try:
        ft.folder.mkdir(parents=True, exist_ok=True)
        p.write_bytes(data)
        back = p.read_bytes()
    except OSError as e:
        return False, f"写盘失败: {e}", p
    if back != data:
        return False, "回读字节不一致", p
    return True, f"已写入 {p}（{len(data)} 字节 / {len(ft.content)} 字符 UTF-8，无 BOM）", p


ALIASES = {
    "微信": ["weixin", "wechat", "微信"], "记事本": ["notepad"], "计算器": ["calc", "calculator", "计算器"], "画图": ["mspaint", "画图"],
    "资源管理器": ["explorer"], "chrome": ["chrome", "google chrome"], "谷歌浏览器": ["chrome"], "浏览器": ["msedge", "chrome"],
    "edge": ["msedge", "microsoft edge"], "word": ["winword", "word"], "excel": ["excel"], "ppt": ["powerpnt", "powerpoint"],
    "qq": ["qq"], "钉钉": ["dingtalk", "钉钉"], "vscode": ["code", "visual studio code"], "任务管理器": ["taskmgr"],
}


def resolve_app(name: str) -> Optional[dict[str, object]]:
    """Trusted read-only app discovery: PATH -> Start Menu shortcuts (score by name match)."""
    key = name.strip().lower()
    cands = ALIASES.get(key) or ALIASES.get(name.strip()) or [key]
    for c in cands:
        w = shutil.which(c)
        if w:
            return {"kind": "path", "target": w, "score": 100.0, "via": "PATH"}
    roots = [os.environ.get("ProgramData", ""), os.environ.get("APPDATA", "")]
    best: Optional[tuple[float, str]] = None
    for r in roots:
        base = Path(r) / "Microsoft" / "Windows" / "Start Menu" / "Programs"
        if not base.exists():
            continue
        for lnk in base.rglob("*.lnk"):
            stem = lnk.stem.lower()
            for c in cands:
                if c in stem or stem in c:
                    score = 100 - abs(len(stem) - len(c)) + (10 if stem == c else 0)
                    if best is None or score > best[0]:
                        best = (score, str(lnk))
    if best:
        return {"kind": "startmenu", "target": best[1], "score": best[0], "via": "startmenu"}
    return None


