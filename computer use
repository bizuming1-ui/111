    await hub.drv_action({"action": "launch", "action_id": new_action_id(), "target": "mspaint.exe", "args": ""})
    w = await brain._wait_window(lambda x: "mspaint" in x.process.lower() or "画图" in x.title or "paint" in x.title.lower(), 8.0)
    if not w:
        return result("paint_occlusion_recovery", "skipped", "Paint did not start")
    await brain._drv("focus_window", None, hwnd=w.hwnd)  # type: ignore[arg-type]
    cx, cy = w.rect[0] + w.rect[2] // 2, w.rect[1] + w.rect[3] // 2
    g = Gui("occluder", f"700x500+{max(0, cx - 350)}+{max(0, cy - 250)}", topmost=True, seconds=60)
    try:
        await asyncio.sleep(1.0)
        st = TaskState("在画图中点击画布", max_steps=5)
        st.step = 1
        b = await brain.observe(st, forced="dxgi_vision")
        brain.recovery.reset()
        a = {"action": "click", "x": cx, "y": cy}
        res = await brain.execute(a, b, st)
        first_code = res.code.value
        res = await brain.recovery.handle(brain, a, res, b, st)
        states = [e.get("state") for e in g.events() if "state" in e]
        hub_stats = dict(brain.recovery.stats)
        ok = res.ok and (first_code != "OK" or True) and (hub_stats.get("occluded_recovered", 0) >= 1 or first_code == "OK")
