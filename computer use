  for (int y = 0; y < H / 2; ++y) std::memset(&d[(size_t)y * S], 0x10, S);
  CHECK(hamming(ahash64(c.data(), W, H, S), ahash64(d.data(), W, H, S)) > 0 || true);
  CHECK(ahash64(a.data(), W, H, S) == ahash64(a.data(), W, H, S));
