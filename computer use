async def browser_status(brain: Brain) -> None:
    """v16.1 `v16 browser`: everything needed to see WHY Google accepts / rejects the browser and WHICH browser the FG-Gate trusts."""
    from . import browser_mcp as bm, gmail_api

    h = brain.hub
    if not h.cdp_up:
        brain.say("  ⏳ 正在启动 / 附着浏览器引擎（clean-browser-url 会原生拉起干净 Chrome）…")
        await h.ensure_cdp()
    hello = h.cdp_hello or {}
    eng = getattr(h, "_mcp", None)
    brain.say(f"  引擎: {hello.get('browser', 'n/a')} · 请求模式={hello.get('requested_mode') or os.environ.get('DSCU_MCP_MODE') or bm.DEFAULT_MODE} · 实际模式={hello.get('profile_mode')} · 调试端口={hello.get('debug_port')} · profile={hello.get('profile_dir')}")
    if hello.get("clean_error"):
        brain.say(f"  ⚠ Clean Chrome 启动失败，已降级：{hello['clean_error']}")
    pids = hello.get("browser_pids") or []
    brain.say(f"  附着浏览器: {hello.get('attached_browser_exe') or '-'}#{hello.get('attached_browser_pid') or 0} · PID 作用域={hello.get('scope_mode')} · 进程树 {len(pids)} 个进程")
    wd = hello.get("webdriver")
    brain.say("  navigator.webdriver = " + (f"{wd}  ✓ 干净（Google 不会因自动化标志拒绝登录）" if wd is False else f"{wd}  ✗ 会触发 signin/rejected → 请设置 DSCU_MCP_MODE=clean-browser-url 或 autoconnect 后重启" if wd is True else "未知（尚无页面）"))
    try:
        p = await h.drv_fg_probe()
        pid, proc = int(p.get("pid") or 0), str(p.get("process") or "")
        att = brain.perception.is_attached(pid, proc)
        brain.say(f"  前台窗口: {proc}#{pid}「{str(p.get('title', ''))[:30]}」→ FG-Gate " + ("属于附着浏览器 → 跳过 UIA、走 MCP" if att else "不属于附着浏览器 → UIA/Vision 接管（不会误路由给 Chrome MCP）"))
    except Exception as e:  # noqa: BLE001
        brain.say(f"  前台探针不可用：{e}")
    if eng is not None:
        brain.say(f"  Supervisor: 重启 {eng.restarts} · 软自愈 {eng.stats['soft_heals']} · 瞬态重试 {eng.stats['transient_retries']} · 工具调用 {eng.stats['tool_calls']} · 上次重启原因={eng.last_restart_reason or '-'}")
    api = gmail_api.GmailApiLayer0()
    brain.say(f"  Gmail API Layer-0: {'已配置令牌 → 读/删邮件秒级直通' if api.available() else '未配置（走浏览器通道）'} · 令牌路径 {api.path}")
    brain.say("  autoconnect 一次性设置：Chrome ≥144(建议146+) 打开 chrome://inspect/#remote-debugging → 开启 → 授权框点 Allow → set DSCU_MCP_MODE=autoconnect")


