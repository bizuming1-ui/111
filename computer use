//! Named-pipe NDJSON server (`\\.\pipe\dscu-driver-v1`) + request dispatch (observe / action / bench / info).
use crate::dxgi::{self, Capturer, Rect};
use crate::input::{self, JobGuard};
use crate::protocol::*;
use crate::sys;
use crate::uia_ref::{self, Uia};
use serde_json::{json, Value};
use std::collections::HashMap;
use std::sync::atomic::{AtomicBool, AtomicI64, Ordering};
use std::sync::{Arc, Mutex};
use std::time::Instant;
use windows::core::PCWSTR;
use windows::Win32::Foundation::*;
use windows::Win32::Storage::FileSystem::*;
use windows::Win32::System::Pipes::*;
use windows::Win32::UI::WindowsAndMessaging::*;

pub struct State {
    pub cap: Mutex<Capturer>,
    pub uia: Uia,
    pub idem: Mutex<HashMap<String, Value>>,
    pub job: Option<JobGuard>,
    pub last_target: AtomicI64,
    pub shutdown: AtomicBool,
    pub started: Instant,
    pub pipe: String,
}

struct SendH(isize);
unsafe impl Send for SendH {}

pub fn serve(name: &str, st: Arc<State>) -> Result<(), String> {
    let path = format!(r"\\.\pipe\{}", name);
    let wpath = sys::wide(&path);
    let mut first = true;
    loop {
        if st.shutdown.load(Ordering::SeqCst) {
            return Ok(());
        }
        let mut open = PIPE_ACCESS_DUPLEX;
        if first {
            open |= FILE_FLAG_FIRST_PIPE_INSTANCE; // refuse to share the name with an impostor
        }
        let h = unsafe {
            CreateNamedPipeW(PCWSTR(wpath.as_ptr()), open, PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS, PIPE_UNLIMITED_INSTANCES, 1 << 20, 1 << 20, 0, None)
        };
        if h.is_invalid() {
            return Err(format!("CreateNamedPipeW failed for {path}: {:?}", unsafe { GetLastError() }));
        }
        first = false;
        let connected = unsafe { ConnectNamedPipe(h, None) };
        if let Err(e) = connected {
            if e.code() != ERROR_PIPE_CONNECTED.to_hresult() {
                unsafe {
                    let _ = CloseHandle(h);
                }
                continue;
            }
        }
        let sh = SendH(h.0 as isize);
        let st2 = st.clone();
        std::thread::spawn(move || {
            let sh = sh;
            let h = HANDLE(sh.0 as *mut std::ffi::c_void);
            conn_loop(h, st2);
            unsafe {
                let _ = FlushFileBuffers(h);
                let _ = DisconnectNamedPipe(h);
                let _ = CloseHandle(h);
            }
        });
    }
}

fn write_all(h: HANDLE, data: &[u8]) -> bool {
    let mut off = 0;
    while off < data.len() {
        let mut n = 0u32;
        if unsafe { WriteFile(h, Some(&data[off..]), Some(&mut n), None) }.is_err() || n == 0 {
            return false;
        }
        off += n as usize;
    }
    true
}

fn conn_loop(h: HANDLE, st: Arc<State>) {
    let mut acc: Vec<u8> = Vec::with_capacity(8192);
    let mut buf = vec![0u8; 65536];
    loop {
        let mut n = 0u32;
        if unsafe { ReadFile(h, Some(&mut buf), Some(&mut n), None) }.is_err() || n == 0 {
            return;
        }
        acc.extend_from_slice(&buf[..n as usize]);
        if acc.len() > 8 << 20 {
            return;
        }
        while let Some(pos) = acc.iter().position(|b| *b == b'\n') {
            let line: Vec<u8> = acc.drain(..=pos).collect();
            let line = &line[..line.len() - 1];
            if line.iter().all(|b| b.is_ascii_whitespace()) {
                continue;
            }
            let (resp, quit) = match serde_json::from_slice::<Value>(line) {
                Ok(req) => handle(&st, &req),
                Err(e) => (err_frame(&Value::Null, &perr("INVALID_REQUEST", &format!("json: {e}"))), false),
            };
            let mut out = serde_json::to_vec(&resp).unwrap_or_default();
            out.push(b'\n');
            if !write_all(h, &out) {
                return;
            }
            if quit {
                std::process::exit(0);
            }
        }
    }
}

fn handle(st: &Arc<State>, req: &Value) -> (Value, bool) {
    let id = req.get("id").cloned().unwrap_or(Value::Null);
    if req.get("v").and_then(|v| v.as_i64()) != Some(1) {
        return (err_frame(&id, &perr("INVALID_REQUEST", "unsupported protocol version (need v=1)")), false);
    }
    let kind = req.get("kind").and_then(|v| v.as_str()).unwrap_or("");
    let body = req.get("req").cloned().unwrap_or(json!({}));
    let r: Result<Value, PErr> = match kind {
        "ping" => Ok(json!({"pong": true, "ts_ms": sys::now_ms()})),
        "info" => Ok(info(st)),
        "observe" => observe(st, &body),
        "action" => Ok(action(st, &body)),
        "bench" => bench(st, &body),
        "shutdown" => {
            st.shutdown.store(true, Ordering::SeqCst);
            return (ok_frame(&id, json!({"bye": true})), true);
        }
        _ => Err(perr("INVALID_REQUEST", &format!("unknown kind '{kind}'"))),
    };
    match r {
        Ok(v) => (ok_frame(&id, v), false),
        Err(e) => (err_frame(&id, &e), false),
    }
}

fn info(st: &Arc<State>) -> Value {
    let (free, total) = sys::mem_status();
    let c = st.cap.lock().unwrap();
    json!({
        "name": "dscu-driver", "version": env!("CARGO_PKG_VERSION"), "protocol": 1, "pid": std::process::id(), "pipe": st.pipe,
        "uiaccess": sys::has_uiaccess(), "elevated": sys::is_elevated(0), "mem_free_mb": free, "mem_total_mb": total,
        "working_set_mb": sys::working_set_mb(), "uptime_ms": st.started.elapsed().as_millis() as u64,
        "capture_backend": c.backend_name(), "fallback_reason": c.fallback_reason, "adapter": c.adapter,
        "frames_total": c.frames_total, "dxgi_frames": c.dxgi_frames, "gdi_frames": c.gdi_frames, "access_lost": c.access_lost,
        "job_locked": st.job.is_some(), "kinds": ["ping","info","observe","action","bench","shutdown"],
    })
}

fn stats_json(s: &dxgi::FrameStats, c: &Capturer) -> Value {
    json!({
        "capture_backend": s.backend, "fallback_reason": s.fallback_reason, "adapter": s.adapter, "frame_ms": s.frame_ms,
        "acquire_us": s.acquire_us, "readback_us": s.readback_us, "dirty_rects_count": s.dirty.len(), "move_rects_count": s.moves,
        "dirty_rects": s.dirty.iter().take(16).map(|d| json!([d[0], d[1], d[2], d[3]])).collect::<Vec<_>>(),
        "fresh": s.fresh, "width": s.width, "height": s.height, "frames_total": c.frames_total, "dxgi_frames": c.dxgi_frames,
        "gdi_frames": c.gdi_frames, "access_lost_count": c.access_lost,
    })
}

fn pick_target(st: &Arc<State>, t: &Value) -> Option<HWND> {
    if let Some(h) = t.get("hwnd").and_then(|v| v.as_i64()) {
        let hw = sys::hwnd_of(h);
        if unsafe { IsWindow(hw).as_bool() } {
            return Some(hw);
        }
    }
    let tt = t.get("title").and_then(|v| v.as_str()).map(|s| s.to_lowercase());
    let pp = t.get("process").and_then(|v| v.as_str()).map(|s| s.to_lowercase());
    if tt.is_some() || pp.is_some() {
        for h in sys::list_windows(200) {
            if let Some(q) = &tt {
                if !sys::title(h).to_lowercase().contains(q) {
                    continue;
                }
            }
            if let Some(q) = &pp {
                if !sys::process_name(sys::pid_of(h)).to_lowercase().contains(q) {
                    continue;
                }
            }
            return Some(h);
        }
        return None;
    }
    let fg = unsafe { GetForegroundWindow() };
    if !fg.is_invalid() && !sys::is_console_window(fg) {
        let root = unsafe { GetAncestor(fg, GA_ROOT) };
        st.last_target.store(sys::hwnd_i(root), Ordering::SeqCst);
        return Some(root);
    }
    // Foreground is the console hosting the agent: fall back to the last real target, else first non-console window.
    let last = st.last_target.load(Ordering::SeqCst);
    if last != 0 && unsafe { IsWindow(sys::hwnd_of(last)).as_bool() } {
        return Some(sys::hwnd_of(last));
    }
    sys::list_windows(100).into_iter().find(|h| !sys::is_console_window(*h))
}

fn observe(st: &Arc<State>, q: &Value) -> Result<Value, PErr> {
    let t0 = Instant::now();
    let want = q.get("want").cloned().unwrap_or(json!({}));
    let w = |k: &str, d: bool| want.get(k).and_then(|v| v.as_bool()).unwrap_or(d);
    let target = q.get("target").cloned().unwrap_or(json!({}));
    let hwnd = pick_target(st, &target);
    let fg = unsafe { GetForegroundWindow() };
    let mut env = json!({
        "v": 1, "source": "dscu-driver", "observe_id": q.get("observe_id").cloned().unwrap_or(Value::Null), "ts_ms": sys::now_ms(),
        "foreground_is_console": !fg.is_invalid() && sys::is_console_window(fg), "taint": false,
    });
    let (free, total) = sys::mem_status();
    env["mem_free_mb"] = json!(free);
    env["mem_total_mb"] = json!(total);
    env["secure_desktop"] = json!(sys::secure_desktop_active());
    let mut channel = "dxgi_vision";
    let mut ahash_hex: Option<String> = None;
    // ── window facts
    let mut win_rect: Option<Rect> = None;
    if let Some(h) = hwnd {
        let wj = sys::window_json(h, 0);
        let pid = sys::pid_of(h);
        env["hwnd"] = json!(sys::hwnd_i(h));
        env["title"] = wj["title"].clone();
        env["class"] = wj["class"].clone();
        env["pid"] = json!(pid);
        env["process"] = wj["process"].clone();
        env["is_elevated"] = json!(sys::is_elevated(pid));
        env["window_rect"] = wj["rect"].clone();
        let r = &wj["rect"];
        win_rect = Some(Rect { x: r["x"].as_i64().unwrap_or(0) as i32, y: r["y"].as_i64().unwrap_or(0) as i32, w: r["w"].as_i64().unwrap_or(0) as i32, h: r["h"].as_i64().unwrap_or(0) as i32 });
        if wj["class"].as_str().map(|c| c.starts_with("SunAwt")).unwrap_or(false) {
            channel = "jab";
            env["jab_note"] = json!("Java window detected; UIA tree is usually empty. Enable Java Access Bridge (jabswitch -enable); tree walking arrives in Step 2");
        }
    } else {
        env["hwnd"] = json!(0);
        env["title"] = json!("");
    }
    if w("windows", true) {
        let list: Vec<Value> = sys::list_windows(30).into_iter().enumerate().map(|(i, h)| sys::window_json(h, i)).collect();
        env["windows"] = json!(list);
    }
    // ── UIA snapshot
    let mut elements = json!([]);
    let mut epoch = uia_ref::EPOCH.load(Ordering::SeqCst);
    let mut uia_ms = 0.0;
    if w("uia", true) && hwnd.is_some() && channel != "jab" {
        let hv = sys::hwnd_i(hwnd.unwrap());
        let skeleton = w("skeleton", false);
        let depth = want.get("depth").and_then(|v| v.as_u64()).map(|d| d as usize);
        let root = want.get("root_ref").and_then(|v| v.as_str()).map(|s| s.to_string());
        let max_nodes = want.get("max_nodes").and_then(|v| v.as_u64()).unwrap_or(400) as usize;
        let off = w("include_offscreen", false);
        let t1 = Instant::now();
        match st.uia.call(15000, move |c| c.snapshot(hv, skeleton, depth, root, max_nodes, off)) {
            Ok(snap) => {
                epoch = snap["snapshot_epoch"].as_u64().unwrap_or(epoch);
                elements = snap["elements"].clone();
                env["truncated_nodes"] = snap["truncated_nodes"].clone();
            }
            Err(e) => {
                env["uia_error"] = e.to_json();
            }
        }
        uia_ms = t1.elapsed().as_secs_f64() * 1000.0;
    }
    let n_el = elements.as_array().map(|a| a.len()).unwrap_or(0);
    let min_controls = want.get("min_controls").and_then(|v| v.as_u64()).unwrap_or(6) as usize;
    if channel != "jab" {
        channel = if n_el >= min_controls { "uia" } else { "dxgi_vision" };
    }
    // ── capture (stats are always real; pixels only when asked)
    let want_shot = w("screenshot", false);
    let scope_screen = want.get("screenshot_scope").and_then(|v| v.as_str()) == Some("screen");
    let mut c = st.cap.lock().unwrap();
    let scr = c.screen();
    let region = if want_shot && !scope_screen {
        win_rect.and_then(|r| {
            let x0 = r.x.max(scr.x);
            let y0 = r.y.max(scr.y);
            let x1 = (r.x + r.w).min(scr.x + scr.w);
            let y1 = (r.y + r.h).min(scr.y + scr.h);
            if x1 - x0 >= 16 && y1 - y0 >= 16 { Some(Rect { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }) } else { None }
        })
    } else {
        None
    };
    let (fs, px) = c.capture(region, want_shot || w("ahash", true), 0).map_err(|e| perr("INTERNAL", &format!("capture: {e}")))?;
    let reg = region.unwrap_or(scr);
    if let Some(p) = &px {
        ahash_hex = Some(dxgi::ahash(p));
        if want_shot {
            let max_edge = want.get("screenshot_max_edge").and_then(|v| v.as_u64()).unwrap_or(1280) as u32;
            let (jpg, ow, oh) = dxgi::to_jpeg(p, max_edge, 72).map_err(|e| perr("INTERNAL", &e))?;
            use base64::Engine as _;
            env["screenshot"] = json!({"mime": "image/jpeg", "width": ow, "height": oh, "source_rect": {"x": reg.x, "y": reg.y, "w": reg.w, "h": reg.h}, "scale": ow as f64 / reg.w as f64, "bytes": jpg.len(), "b64": base64::engine::general_purpose::STANDARD.encode(&jpg)});
        }
    }
    env["dxgi_stats"] = stats_json(&fs, &c);
    drop(c);
    env["channel"] = json!(channel);
    env["snapshot_epoch"] = json!(epoch);
    env["elements"] = elements;
    env["element_count"] = json!(n_el);
    env["screen_ahash"] = json!(ahash_hex);
    env["uia_ms"] = json!(uia_ms);
    env["collected_ms"] = json!(t0.elapsed().as_secs_f64() * 1000.0);
    Ok(env)
}

fn bench(st: &Arc<State>, q: &Value) -> Result<Value, PErr> {
    let frames = q.get("frames").and_then(|v| v.as_u64()).unwrap_or(100).clamp(1, 5000) as usize;
    let readback = q.get("readback").and_then(|v| v.as_bool()).unwrap_or(true);
    let pace_ms = q.get("pace_ms").and_then(|v| v.as_u64()).unwrap_or(0);
    let mut c = st.cap.lock().unwrap();
    let scr = c.screen();
    let (rw, rh) = (q.get("w").and_then(|v| v.as_i64()).unwrap_or(640) as i32, q.get("h").and_then(|v| v.as_i64()).unwrap_or(360) as i32);
    let region = Rect { x: scr.x, y: scr.y, w: rw.min(scr.w), h: rh.min(scr.h) };
    let mut all: Vec<f64> = vec![];
    let mut fresh_v: Vec<f64> = vec![];
    let mut dirty_total = 0usize;
    let mut backend = "DXGI";
    let mut reason: Option<String> = None;
    let mut gdi_frames = 0;
    for _ in 0..frames {
        let (s, _px) = c.capture(Some(region), readback, 0).map_err(|e| perr("INTERNAL", &e))?;
        if s.backend != "DXGI" {
            backend = "GDI";
            reason = s.fallback_reason.clone();
            gdi_frames += 1;
        }
        dirty_total += s.dirty.len();
        all.push(s.frame_ms);
        if s.fresh {
            fresh_v.push(s.frame_ms);
        }
        if pace_ms > 0 {
            std::thread::sleep(std::time::Duration::from_millis(pace_ms));
        }
    }
    let fresh_n = fresh_v.len();
    let mut a2 = all.clone();
    let mut f2 = fresh_v.clone();
    Ok(json!({
        "capture_backend": backend, "fallback_reason": reason, "adapter": c.adapter, "frames": frames, "readback": readback,
        "region": {"w": region.w, "h": region.h}, "gdi_frames": gdi_frames,
        "p50_ms": dxgi::percentile(&mut a2, 0.5), "p95_ms": dxgi::percentile(&mut a2, 0.95), "p99_ms": dxgi::percentile(&mut a2, 0.99),
        "fresh_frames": fresh_n, "fresh_p50_ms": dxgi::percentile(&mut f2, 0.5), "dirty_rects_total": dirty_total,
        "access_lost": c.access_lost,
    }))
}

// ──────────────────────────────────────────────────────────── actions ─────────────────────────────────────────────────
const DENY_LAUNCH: &[&str] = &["cmd", "cmd.exe", "powershell", "powershell.exe", "pwsh", "pwsh.exe", "wscript", "cscript", "mshta", "regsvr32", "rundll32", "reg", "reg.exe", "schtasks", "sc", "net", "net1", "bitsadmin", "certutil", "msiexec", "wmic"];

fn action(st: &Arc<State>, a: &Value) -> Value {
    let t0 = Instant::now();
    let action_id = a.get("action_id").and_then(|v| v.as_str()).unwrap_or("").to_string();
    if action_id.is_empty() {
        return json!({"action_id": "", "ok": false, "error_code": "INVALID_REQUEST", "detail": "action_id (idempotency key) is required"});
    }
    if let Some(prev) = st.idem.lock().unwrap().get(&action_id) {
        let mut r = prev.clone();
        r["replayed"] = json!(true);
        return r;
    }
    let res = run_action(st, a);
    let mut out = match res {
        Ok(mut v) => {
            v["ok"] = json!(true);
            v
        }
        Err(e) => {
            let mut v = json!({"ok": false, "error_code": e.code, "detail": e.message, "retryable": e.retryable()});
            if let Some(d) = e.data {
                v["data"] = d;
            }
            v
        }
    };
    out["action_id"] = json!(action_id);
    out["replayed"] = json!(false);
    out["elapsed_ms"] = json!(t0.elapsed().as_secs_f64() * 1000.0);
    out["new_epoch"] = json!(uia_ref::EPOCH.load(Ordering::SeqCst));
    if out["ok"] == json!(true) {
        let mut m = st.idem.lock().unwrap();
        if m.len() > 2000 {
            m.clear();
        }
        m.insert(action_id, out.clone()); // a failed lock never consumes the action_id
    }
    out
}

fn run_action(st: &Arc<State>, a: &Value) -> Result<Value, PErr> {
    let op = a.get("op").and_then(|v| v.as_str()).unwrap_or("").to_string();
    let target = a.get("target").cloned().unwrap_or(json!({}));
    let args = a.get("args").cloned().unwrap_or(json!({}));
    let expect_epoch = a.get("expect_epoch").and_then(|v| v.as_u64());
    let expect_hwnd = a.get("expect_hwnd").and_then(|v| v.as_i64());
    if sys::secure_desktop_active() && op != "launch" {
        return Err(perr("SECURITY_DENIED", "secure desktop (UAC / lock screen) is active; input is refused"));
    }
    let is_uia_target = target.get("ref_id").is_some() || target.get("stable_key").is_some();
    // optimistic lock on the foreground window for non-UIA input
    if !is_uia_target {
        if let Some(eh) = expect_hwnd {
            let fg = unsafe { GetAncestor(GetForegroundWindow(), GA_ROOT) };
            if sys::hwnd_i(fg) != eh && !matches!(op.as_str(), "launch" | "focus_window") {
                return Err(perr("STALE_HWND", &format!("foreground window 0x{:x} != expect_hwnd 0x{:x}", sys::hwnd_i(fg), eh)));
            }
        }
    }
    match op.as_str() {
        "click" | "invoke" | "toggle" | "select" | "expand" | "collapse" | "focus" | "scroll" | "set_value" | "type" if is_uia_target => {
            let (o, t, ar) = (op.clone(), target.clone(), args.clone());
            st.uia.call(20000, move |c| c.act(&o, &t, &ar, expect_epoch, expect_hwnd))
        }
        "click" | "double_click" | "right_click" | "hover" => {
            let p = target.get("point").ok_or_else(|| perr("INVALID_REQUEST", "click needs target.point or ref_id"))?;
            let (x, y) = (p["x"].as_i64().unwrap_or(0) as i32, p["y"].as_i64().unwrap_or(0) as i32);
            let at = unsafe { WindowFromPoint(POINT { x, y }) };
            let root = unsafe { GetAncestor(at, GA_ROOT) };
            if let Some(eh) = expect_hwnd {
                if sys::hwnd_i(root) != eh {
                    return Err(perr("OCCLUDED", &format!("point ({x},{y}) belongs to window 0x{:x}, expected 0x{:x}", sys::hwnd_i(root), eh)));
                }
            }
            let pid = sys::pid_of(root);
            if sys::is_elevated(pid) == Some(true) && sys::is_elevated(0) != Some(true) && !sys::has_uiaccess() {
                return Err(perr("UIPI_DENIED", "target window is elevated; run scripts/setup-uiaccess.ps1"));
            }
            let speed = args.get("speed").and_then(|v| v.as_f64()).unwrap_or(1.0);
            let w = args.get("target_w").and_then(|v| v.as_f64()).unwrap_or(40.0);
            let ms = if op == "hover" {
                input::move_to(x, y, w, speed).map_err(|e| perr("UIPI_DENIED", &e))?
            } else {
                let (btn, cnt) = match op.as_str() {
                    "double_click" => ("left", 2),
                    "right_click" => ("right", 1),
                    _ => (args.get("button").and_then(|v| v.as_str()).unwrap_or("left"), 1),
                };
                input::click(x, y, btn, cnt, w, speed).map_err(|e| perr("UIPI_DENIED", &e))?
            };
            Ok(json!({"strategy": "physical", "point": {"x": x, "y": y}, "move_ms": ms, "hwnd": sys::hwnd_i(root)}))
        }
        "type" => {
            let text = args.get("text").and_then(|v| v.as_str()).unwrap_or("");
            let delay = args.get("per_char_ms").and_then(|v| v.as_u64()).unwrap_or(4);
            let n = input::type_text(text, delay).map_err(|e| perr("UIPI_DENIED", &e))?;
            if args.get("enter").and_then(|v| v.as_bool()).unwrap_or(false) {
                input::press_keys("enter").map_err(|e| perr("UIPI_DENIED", &e))?;
            }
            Ok(json!({"strategy": "keyboard", "text_len": n}))
        }
        "key" => {
            let keys = args.get("keys").and_then(|v| v.as_str()).unwrap_or("");
            let n = input::press_keys(keys).map_err(|e| if e.starts_with("UNKNOWN_KEY") { perr("INVALID_REQUEST", &e) } else { perr("UIPI_DENIED", &e) })?;
            Ok(json!({"strategy": "keyboard", "chords": n}))
        }
        "scroll" => {
            let amount = args.get("amount").and_then(|v| v.as_i64()).unwrap_or(3);
            let down = args.get("direction").and_then(|v| v.as_str()).unwrap_or("down") != "up";
            if let Some(p) = target.get("point") {
                let _ = input::move_to(p["x"].as_i64().unwrap_or(0) as i32, p["y"].as_i64().unwrap_or(0) as i32, 40.0, 2.0);
            }
            input::scroll(if down { -amount } else { amount } as i32).map_err(|e| perr("UIPI_DENIED", &e))?;
            Ok(json!({"strategy": "physical"}))
        }
        "focus_window" => {
            let h = pick_target(st, &json!({"hwnd": args.get("hwnd"), "title": args.get("title"), "process": args.get("process")})).ok_or_else(|| perr("NOT_FOUND", "no matching window"))?;
            input::focus_window(h).map_err(|e| perr("OCCLUDED", &e))?;
            st.last_target.store(sys::hwnd_i(h), Ordering::SeqCst);
            Ok(json!({"strategy": "focus", "hwnd": sys::hwnd_i(h), "title": sys::title(h)}))
        }
        "launch" => launch(st, &args),
        _ => Err(perr("UNSUPPORTED", &format!("op '{op}'"))),
    }
}

fn launch(st: &Arc<State>, args: &Value) -> Result<Value, PErr> {
    use windows::Win32::UI::Shell::ShellExecuteW;
    let target = args.get("target").and_then(|v| v.as_str()).unwrap_or("").trim().to_string();
    if target.is_empty() {
        return Err(perr("INVALID_REQUEST", "launch needs args.target"));
    }
    let base = target.rsplit(['\\', '/']).next().unwrap_or("").to_lowercase();
    let is_url = target.starts_with("http://") || target.starts_with("https://");
    if !is_url && DENY_LAUNCH.contains(&base.as_str()) {
        return Err(perr("SECURITY_DENIED", &format!("launching '{base}' is blocked by the driver policy (use workers/ps_safe_worker.ps1 for audited scripts)")));
    }
    let params = args.get("args").and_then(|v| v.as_str()).unwrap_or("");
    let lock = args.get("lock").and_then(|v| v.as_bool()).unwrap_or(false);
    if lock {
        use std::os::windows::io::AsRawHandle;
        let mut cmd = std::process::Command::new(&target);
        if !params.is_empty() {
            cmd.args(params.split_whitespace());
        }
        let child = cmd.spawn().map_err(|e| perr("NOT_FOUND", &format!("spawn: {e}")))?;
        if let Some(j) = &st.job {
            j.assign(HANDLE(child.as_raw_handle() as *mut std::ffi::c_void)).map_err(|e| perr("INTERNAL", &e))?;
        }
        return Ok(json!({"strategy": "launch", "pid": child.id(), "job_locked": st.job.is_some()}));
    }
    let wt = sys::wide(&target);
    let wp = sys::wide(params);
    let op = sys::wide("open");
    let r = unsafe { ShellExecuteW(None, PCWSTR(op.as_ptr()), PCWSTR(wt.as_ptr()), if params.is_empty() { PCWSTR::null() } else { PCWSTR(wp.as_ptr()) }, PCWSTR::null(), SW_SHOWNORMAL) };
    if (r.0 as isize) <= 32 {
        return Err(perr("NOT_FOUND", &format!("ShellExecute failed ({}) for '{}'", r.0 as isize, target)));
    }
    Ok(json!({"strategy": "launch", "target": target}))
}
