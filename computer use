        "coordinate_bypass_block_rate == 1.0": metrics["coordinate_bypass_block_rate"] == 1.0,
        "crash_resume_correctness == 1.0": metrics["crash_resume_correctness"] == 1.0,
        "duplicate_irreversible_side_effects == 0": metrics["duplicate_irreversible_side_effects"] == 0,
        "gmail_target_freeze_accuracy == 1.0": metrics["gmail_target_freeze_accuracy"] == 1.0,
        "gmail_per_id_trash_verified_rate == 1.0": metrics["gmail_per_id_trash_verified_rate"] == 1.0,
        "stability.verified_success_rate == 1.0": metrics["verified_success_rate"] == 1.0,
        "stability.false_success_rate == 0": metrics["false_success_rate"] == 0,
        "stability.misoperation_rate == 0": metrics["misoperation_rate"] == 0,
        "all individual cases pass": all(x.passed == len(x.cases) for x in suites.values()),
    }
    body = {
        "suite": "verify_phase0_1", "version": "16.2.0", "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "duration_s": round(time.time() - t0, 2),
        "environment": {"platform": platform.platform(), "python": sys.version.split()[0], "real_mode": bool(args.real and sys.platform == "win32"), "allow_empty_recycle_bin": bool(args.allow_empty_recycle_bin), "seed": args.seed},
        "parameters": {"stability_n": args.stability_n, "sizes": args.sizes, "trials": args.trials},
        "oracle_independence": {"filesystem": "pathlib.exists + sha256 recomputed by the harness", "gmail": "FakeGmailServer ground-truth labels (separate object from GmailSkill)",
                                "recycle_bin": "SHQueryRecycleBinW + Shell.Application NameSpace(10) (--real) / simulated bin backed by real files", "crash": "real subprocess terminated with os._exit(137) after the WAL `started` record"},
        "metrics": metrics, "acceptance_gates": gates, "pass": all(gates.values()),
        "suites": {k: {**v.summary(), "cases": v.cases} for k, v in suites.items()},
    }
    body["report_sha256"] = hashlib.sha256(json.dumps({k: v for k, v in body.items() if k != "report_sha256"}, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
    return body


def main(argv=None) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default="")
    ap.add_argument("--stability-n", type=int, default=30)
    ap.add_argument("--sizes", default="10,50,500")
