            return None
        return self._register_denial(a, hit, self.deny[hit], step, pre=True)

    def _register_denial(self, a: dict[str, Any], key: str, reason: str, step: int, pre: bool = False) -> ActionResult:
        self.deny.setdefault(key, reason)
        self.denial_count[key] += 1
        n = self.denial_count[key]
        alt = self.alternative_for(a, reason)
        self.stats["security_denials"] += 1
        if n >= 2:
            msg = (f"[SECURITY_DENIED][REPEAT×{n}] {key} 已被安全策略拒绝过，再次提交被系统拦截；状态机切换为安全终止（SAFE_TERMINATE）。"
                   f"可行替代方案：{alt}")
            self.terminate = {"kind": "security", "key": key, "reason": reason[:200], "alternative": alt}
            self.stats["safe_terminate"] += 1
            self._ev(step, "terminate", str(a.get("action")), f"{key} ×{n}", False)
            return ActionResult(ok=False, code=Code.SECURITY_DENIED, message=msg)
        note = f"[禁止列表+] {key} 被安全策略拒绝（{reason[:120]}）。替代方案：{alt}  —— 同一拒绝再触发一次将安全终止任务。"
        self.pending_note = (self.pending_note + "\n" if self.pending_note else "") + note
        self.stats["security_alt_injected"] += 1
        self._ev(step, "security", str(a.get("action")), f"{key} → inject alternative", True)
        return ActionResult(ok=False, code=Code.SECURITY_DENIED, message=f"{reason[:240]}｜[RECOVERY] 已加入禁止列表；替代方案：{alt}")

    def deny_summary(self) -> str:
        if not self.deny:
            return ""
        return "[本任务禁止列表] " + "；".join(sorted(self.deny)[:8]) + "（提交这些将被直接拦截；连续 2 次相同拒绝=安全终止）"

    def take_note(self) -> str:
        n, self.pending_note = self.pending_note, ""
        return n

    # ------------------------------------------------------------------------------------------ in-place recovery
    async def handle(self, brain: Any, a: dict[str, Any], res: ActionResult, b: Any, st: Any) -> ActionResult:
        step = int(getattr(st, "step", 0))
        for rnd in range(2):
            if res.ok:
                return res
            kind = self.classify(res)
            if kind == "security":
                return self._register_denial(a, self.deny_key(a, res.message), res.message, step)
            if kind == "occluded":
                detail = await self._fix_occlusion(brain, res, b, st)
                self.stats["occluded_fix"] += 1
                await _sleep(0.15)
                res2 = await brain.execute(a, b, st)
                self._ev(step, "occluded", str(a.get("action")), f"round {rnd + 1}: {detail} → {res2.code.value}", res2.ok)
                if res2.ok:
                    res2.message = f"{res2.message}（[RECOVERY] 遮挡已自动处理：{detail}；原地重试成功，未消耗额外决策步）"
                    self.stats["occluded_recovered"] += 1
                res = res2
                continue
            if kind == "cdp":
                ok = False
                try:
                    ok = await brain.hub.cdp_heal(res.message)
                except Exception as e:  # noqa: BLE001
                    res.message += f"（cdp_heal 异常：{e}）"
                self.stats["cdp_heal"] += 1
                self._ev(step, "cdp", str(a.get("action")), f"heal={ok}", ok)
                if not ok:
                    return res
                res2 = await brain.execute(a, b, st)
                if res2.ok:
                    res2.message += "（[RECOVERY] CDP 已自愈并原地重试）"
                res = res2
                continue
            return res
        if not res.ok and self.classify(res) == "occluded":
            res.message += "（[RECOVERY] 已自动处理遮挡 2 轮仍被覆盖：请 vision_inspect 确认遮挡物，或换用键盘/控件方式）"
        return res

    async def _fix_occlusion(self, brain: Any, res: ActionResult, b: Any, st: Any) -> str:
        m = re.search(r"covered by hwnd (\d+)", res.message or "")
        blocker = int(m.group(1)) if m else 0
        if not blocker:
            ob = (res.effect or {}).get("occluded_by")
            if isinstance(ob, list) and ob:
                blocker = int(ob[0] or 0)
        try:
            o = await brain.hub.drv_observe(channel="dxgi_vision", max_elements=1)
            windows = {w.hwnd: w for w in o.windows}
        except Exception:  # noqa: BLE001
            windows = {w.hwnd: w for w in getattr(getattr(b, "drv", None), "windows", [])}
        w = windows.get(blocker)
        target = brain._target_hwnd(b)
        if blocker and w is None:
            return f"遮挡物 hwnd={blocker} 已消失（瞬时弹层）→ 原地重试"
        if w is not None and ((w.cls or "") in POPUP_CLASSES or (not w.title and (w.cls or "").startswith("#"))):
            r = await brain._drv("key", b, keys="esc", expect_hwnd=target)
            return f"关闭弹出菜单/浮层 {w.cls} (Esc→{r.code.value})"
        if w is not None and (w.own_console or (w.cls or "") in SHELL_CLASSES):
            r = await brain._focus(b, hwnd=target)
            return f"遮挡物是{'本控制台' if w.own_console else '桌面/任务栏'}：置顶目标窗口 hwnd={target} (→{r.code.value})"
        if target:
            r = await brain._focus(b, hwnd=target)
            if r.ok:
                return f"置顶目标窗口 hwnd={target}（验证式 focus_window 成功）"
        if w is not None:
            r2 = await brain._drv("minimize_window", b, hwnd=w.hwnd)
            return f"最小化遮挡窗口 {w.process}:{w.title[:20]} (→{r2.code.value})"
        return "无明确遮挡物证据 → 仅等待后重试"


async def _sleep(s: float) -> None:
    import asyncio

    await asyncio.sleep(s)
