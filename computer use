}

pub fn post_close(target: isize) -> bool {
    unsafe { PostMessageW(hwnd_of(target), WM_CLOSE, WPARAM(0), LPARAM(0)).is_ok() }
}

/// Find a window by hwnd / title substring / process name (case-insensitive). Skips own windows.
pub fn find(all: &[Win], hwnd: Option<isize>, title: Option<&str>) -> Vec<Win> {
    if let Some(h) = hwnd {
        if h != 0 {
            return all.iter().filter(|w| w.hwnd == h).cloned().collect();
        }
    }
    let t = title.unwrap_or("").to_lowercase();
    if t.is_empty() {
        return vec![];
    }
    all.iter()
        .filter(|w| !w.own && !w.cloaked)
        .filter(|w| {
            w.title.to_lowercase().contains(&t)
                || w.process.to_lowercase().trim_end_matches(".exe") == t.trim_end_matches(".exe")
                || w.process.to_lowercase().contains(&t)
        })
        .cloned()
        .collect()
}
