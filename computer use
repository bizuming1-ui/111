#Requires -Version 7.0
<#
.SYNOPSIS  One-command build / self-signed uiAccess deploy / regression for DSCU v11 (Windows 11, PowerShell 7).
.EXAMPLE   pwsh -File scripts/up.ps1                # build + test + verify
           pwsh -File scripts/up.ps1 -Sign          # + self-signed cert, trust, uiAccess manifest, install to %ProgramFiles%\DSCU (admin)
           pwsh -File scripts/up.ps1 -SkipTests -AutoInstall
#>
param([switch]$SkipTests, [switch]$Sign, [switch]$AutoInstall, [switch]$NoStart, [string]$InstallDir = '')
$ErrorActionPreference = 'Stop'
$Root = Split-Path -Parent $PSScriptRoot
Set-Location $Root
function Step($m) { Write-Host "`n== $m" -ForegroundColor Cyan }
function Have($c) { [bool](Get-Command $c -ErrorAction SilentlyContinue) }
$report = [ordered]@{ started = (Get-Date).ToString('o'); steps = @() }
function Rec($n, $ok, $d = '') { $script:report.steps += [ordered]@{ step = $n; ok = [bool]$ok; detail = $d }; Write-Host ("  [{0}] {1} {2}" -f $(if ($ok) { 'OK' } else { 'FAIL' }), $n, $d) -ForegroundColor $(if ($ok) { 'Green' } else { 'Red' }) }

Step '0. Toolchains'
if (-not (Have cargo) -and $AutoInstall -and (Have winget)) { winget install --id Rustlang.Rustup -e --silent; $env:PATH += ";$env:USERPROFILE\.cargo\bin" }
if (-not (Have node) -and $AutoInstall -and (Have winget)) { winget install --id OpenJS.NodeJS.LTS -e --silent }
if (-not (Have python) -and -not (Have python3) -and $AutoInstall -and (Have winget)) { winget install --id Python.Python.3.12 -e --silent }
$py = if (Have python3) { 'python3' } elseif (Have python) { 'python' } else { $null }
Rec 'cargo' (Have cargo) ''; Rec 'node >= 22.6' ((Have node) -and ([version](node -v).TrimStart('v')) -ge [version]'22.6.0') ''; Rec 'python' ($null -ne $py) ''

Step '1. Rust dscu-driver (DXGI + DsV9Ring + @snapshot:ref)'
$exe = $null
if (Have cargo) {
    if (-not $SkipTests) { cargo test --release; Rec 'cargo test' ($LASTEXITCODE -eq 0) }
    cargo build --release; Rec 'cargo build --release' ($LASTEXITCODE -eq 0)
    $exe = Join-Path $Root 'target/release/dscu-driver.exe'; if (-not (Test-Path $exe)) { $exe = Join-Path $Root 'target/release/dscu-driver' }
    if (Test-Path $exe) { $b = (& $exe bench 300 | ConvertFrom-Json); Rec "DXGI capture P50 < 5ms ($($b.backend))" $b.pass "p50=$($b.p50_ms)ms p99=$($b.p99_ms)ms full-frame-copy=$($b.full_frame_copy_p50_ms)ms" }
}

Step '2. Self-signed uiAccess deployment (admin)'
if ($Sign -and $exe -and $IsWindows) {
    $isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    if (-not $isAdmin) { Rec 'admin rights required for -Sign (uiAccess needs a trusted cert + %ProgramFiles%)' $false 'relaunch pwsh as Administrator' }
    else {
        $dest = if ($InstallDir) { $InstallDir } else { Join-Path $env:ProgramFiles 'DSCU' }
        [void](New-Item -ItemType Directory -Force $dest)
        Copy-Item $exe (Join-Path $dest 'dscu-driver.exe') -Force
        $manifest = Join-Path $dest 'dscu-driver.manifest'
        @"
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3"><security><requestedPrivileges>
    <requestedExecutionLevel level="asInvoker" uiAccess="true"/>
  </requestedPrivileges></security></trustInfo>
</assembly>
"@ | Set-Content -Path $manifest -Encoding UTF8
        $cert = Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert | Where-Object Subject -eq 'CN=DSCU Self-Signed' | Select-Object -First 1
        if (-not $cert) { $cert = New-SelfSignedCertificate -Type CodeSigningCert -Subject 'CN=DSCU Self-Signed' -CertStoreLocation Cert:\CurrentUser\My -NotAfter (Get-Date).AddYears(3) }
        $cer = Join-Path $dest 'dscu-selfsigned.cer'; [void](Export-Certificate -Cert $cert -FilePath $cer)
        foreach ($st in 'Root', 'TrustedPublisher') { [void](Import-Certificate -FilePath $cer -CertStoreLocation "Cert:\LocalMachine\$st") }   # uiAccess requires a trusted chain
        $mt = Get-ChildItem "${env:ProgramFiles(x86)}\Windows Kits\10\bin" -Recurse -Filter mt.exe -ErrorAction SilentlyContinue | Where-Object FullName -match 'x64' | Select-Object -First 1
        if ($mt) { & $mt.FullName -nologo -manifest $manifest "-outputresource:$(Join-Path $dest 'dscu-driver.exe');#1"; Rec 'manifest embedded (uiAccess=true)' ($LASTEXITCODE -eq 0) }
        else { Rec 'mt.exe not found: side-by-side dscu-driver.manifest used' $true 'install Windows SDK for an embedded manifest' }
        $sig = Set-AuthenticodeSignature -FilePath (Join-Path $dest 'dscu-driver.exe') -Certificate $cert -TimestampServer 'http://timestamp.digicert.com'
        Rec 'Authenticode signature' ($sig.Status -in 'Valid', 'UnknownError' -or $sig.SignerCertificate) "$($sig.Status)"
        $exe = Join-Path $dest 'dscu-driver.exe'
    }
}
else { Rec 'signing skipped (use -Sign on Windows as Administrator)' $true }

Step '3. TypeScript cdp-daemon (Zone: Toolbar/Row, Wait-CdpSettled)'
if (Have node) {
    Push-Location packages/cdp-daemon
    if (-not (Test-Path node_modules)) { npm install --no-audit --no-fund 2>&1 | Out-Null }
    if (-not $SkipTests) { npm test 2>&1 | Out-Host; Rec 'node --test (zone/settled/daemon)' ($LASTEXITCODE -eq 0) }
    Pop-Location
}

Step '4. Python agent_brain + DirectML sidecar'
if ($py) {
    if ($AutoInstall) { & $py -m pip install --quiet onnxruntime-directml 2>&1 | Out-Null }
    if (-not $SkipTests) {
        & $py tests/test_v11.py; Rec 'tests/test_v11.py (protocol contract · security grants · state machine · router · checkpoint)' ($LASTEXITCODE -eq 0)
        & $py evals/run.py; Rec 'evals/run.py (3 log regressions ≤5/≤12/≤10 steps · red team · perf gates)' ($LASTEXITCODE -eq 0)
        & $py tests/verify_v10.py; Rec 'tests/verify_v10.py (v10 gates, kept as regression)' ($LASTEXITCODE -eq 0)
    }
}

Step '4b. Resident planes the brain talks to'
if (-not $NoStart -and (Have node) -and -not $env:DSCU_NO_CDP_DAEMON) {
    $env:DSCU_MOCK = if ($env:DSCU_CDP_PORT) { '' } else { '1' }   # no debug-port browser yet -> mock page; the PowerShell client relaunches an isolated Chrome when needed
    if (-not (Get-NetTCPConnection -LocalPort 9333 -State Listen -ErrorAction SilentlyContinue)) { Start-Process node -ArgumentList '--experimental-strip-types','--no-warnings',(Join-Path $Root 'packages/cdp-daemon/src/daemon.ts') -WindowStyle Hidden; Start-Sleep -Milliseconds 500 }
