//! Headless-First execution policy: prefer UIA patterns (no physical mouse, no focus theft);
//! fall back to physical input (DsNative61 humanised input on the client) only for browsers, self-drawn UI or `headed`.
use crate::tree::WindowInfo;
use crate::uia_ref::RefEntry;

#[derive(Debug, PartialEq, Eq, Clone)]
pub enum Strategy {
    Pattern(&'static str),
    Physical(&'static str),
}

const BROWSER_PROCS: [&str; 7] = ["chrome", "msedge", "firefox", "brave", "opera", "vivaldi", "360chrome"];
const BROWSER_CLASSES: [&str; 3] = ["mozillawindowclass", "chrome_renderwidgethosthwnd", "chrome_widgetwin_0"];

pub fn is_browser(w: &WindowInfo) -> bool {
    let p = w.process.to_lowercase();
    let p = p.trim_end_matches(".exe");
    let c = w.class.to_lowercase();
    BROWSER_PROCS.contains(&p) || BROWSER_CLASSES.contains(&c.as_str())
}

fn has(e: &RefEntry, p: &str) -> bool {
    e.patterns.iter().any(|x| x == p)
}

pub fn decide(w: &WindowInfo, e: &RefEntry, op: &str, headed: bool) -> Strategy {
    if headed {
        return Strategy::Physical("headed_requested");
    }
    if is_browser(w) {
        return Strategy::Physical("browser_needs_real_pointer_events");
    }
    if e.source == "jab" {
        return match op {
            "click" | "select" | "toggle" => Strategy::Pattern("jab_action"),
            "set_value" => Strategy::Pattern("jab_set_text"),
            "focus" => Strategy::Pattern("jab_focus"),
            _ => Strategy::Physical("jab_op_unsupported"),
        };
    }
    let self_drawn = e.patterns.is_empty() && matches!(e.role.as_str(), "custom" | "pane" | "image" | "group" | "document");
    if self_drawn && op != "focus" {
        return Strategy::Physical("self_drawn_control");
    }
    match op {
        "click" => {
            if has(e, "invoke") {
                Strategy::Pattern("invoke")
            } else if has(e, "toggle") {
                Strategy::Pattern("toggle")
            } else if has(e, "selection_item") {
                Strategy::Pattern("select")
            } else if has(e, "expand_collapse") {
                Strategy::Pattern("expand")
            } else {
                Strategy::Physical("no_actionable_pattern")
            }
        }
        "set_value" => if has(e, "value") { Strategy::Pattern("value") } else { Strategy::Physical("no_value_pattern") },
        "toggle" => if has(e, "toggle") { Strategy::Pattern("toggle") } else { Strategy::Physical("no_toggle_pattern") },
        "select" => if has(e, "selection_item") { Strategy::Pattern("select") } else { Strategy::Physical("no_selection_pattern") },
        "expand" | "collapse" => if has(e, "expand_collapse") { Strategy::Pattern("expand_collapse") } else { Strategy::Physical("no_expand_pattern") },
        "scroll" => if has(e, "scroll") { Strategy::Pattern("scroll") } else { Strategy::Physical("no_scroll_pattern") },
        "focus" => Strategy::Pattern("focus"),
        _ => Strategy::Physical("unknown_op"),
    }
}

