function Get-V12Norm([string]$s) { $s = "$s".ToLower(); if ($s.EndsWith('.exe')) { $s = $s.Substring(0, $s.Length - 4) }; return ($s -replace '[\s_\-\.]+', '') }
function Get-V12AppMatchScore([string]$Query, $E) {
    $q = Get-V12Norm $Query; if (-not $q) { return 0.0 }
    $base = ''; if ("$($E.Exe)") { $base = ("$($E.Exe)" -replace '\\', '/').Split('/')[-1] }
    $tok = ''; if ("$($E.Aumid)") { $tok = "$($E.Aumid)".Split('!')[0].Split('_')[0].Split('.')[-1] }
    $fields = @((Get-V12Norm "$($E.Name)"), (Get-V12Norm $base), (Get-V12Norm "$($E.Desc)"), (Get-V12Norm $tok)); $best = 0.0
    for ($i = 0; $i -lt 4; $i++) {
        $f = $fields[$i]; if (-not $f) { continue }
        if ($f -eq $q) { $best = [Math]::Max($best, $(if ($i -eq 0) { 100.0 } else { 95.0 })) }
        elseif ($f.StartsWith($q) -or ($q.StartsWith($f) -and $f.Length -ge 3)) { $best = [Math]::Max($best, 70.0) }
        elseif ($f.Contains($q) -or ($f.Length -ge 3 -and $q.Contains($f))) { $best = [Math]::Max($best, 50.0) }
    }
    if ($best -eq 0.0) { return 0.0 }
    $pri = @{ process = 5; aumid = 4; startmenu = 3; apppaths = 3; uninstall = 2 }[("$($E.Source)")]
    return $best + [double]$pri * 0.5 + $(if ("$($E.Exe)" -and "$($E.Aumid)") { 2.0 } else { 0.0 })
}
function Get-V12AppIndex([switch]$Force) {
