"""Deterministic in-memory Gmail REST server (transport for GmailSkill): pagination, q filters, labels, 401 expiry, 429/500 injection, per-id trash counters, request audit log."""
from __future__ import annotations

import json
import re
import urllib.parse
from datetime import datetime, timedelta, timezone
from typing import Any, Callable, Optional


class FakeGmailServer:
    def __init__(self, n: int, seed: int = 0, senders: Optional[list[str]] = None, page: int = 500) -> None:
        self.page = page
        senders = senders or ["Google <no-reply@accounts.google.com>", "Railway <team@railway.app>", "Medium Daily Digest <noreply@medium.com>", "GitHub <noreply@github.com>", "TikTok <no-reply@tiktok.com>"]
        base = datetime(2025, 11, 28, 12, 0, tzinfo=timezone.utc)
        self.msgs: dict[str, dict[str, Any]] = {}
        self.order: list[str] = []  # newest first
        for i in range(n):
            mid = f"m{seed:02d}{i:05d}"
            d = base - timedelta(hours=7 * i)
            self.msgs[mid] = {"id": mid, "threadId": f"t{mid}", "labelIds": ["INBOX"] + (["UNREAD"] if i % 3 == 0 else []), "dt": d,
                              "from": senders[(i + seed) % len(senders)], "subject": f"Subject #{i} / {mid}", "snippet": f"snippet {i}"}
            self.order.append(mid)
        self.valid_token = "at-0"
        self.token_serial = 0
        self.calls = 0
        self.log: list[tuple[str, str, int]] = []  # (method, path, status)
        self.trash_count: dict[str, int] = {}
        self.fail_calls: dict[int, tuple[int, dict[str, str]]] = {}  # call index -> (status, headers)
        self.expire_token_at_call: Optional[int] = None
        self.refuse_trash: set[str] = set()
        self.on_trash: Optional[Callable[[str, int], None]] = None  # hook(id, ordinal) -> may raise to simulate a crash mid-way
        self.refresh_calls = 0
        self.trash_ordinal = 0

    # ------------------------------------------------------------------ helpers
    def _filter(self, q: str) -> list[str]:
        ids = [i for i in self.order if "TRASH" not in self.msgs[i]["labelIds"] and "SPAM" not in self.msgs[i]["labelIds"]]
        m = re.search(r"from:(\"[^\"]+\"|\S+)", q)
        if m:
            needle = m.group(1).strip('"').lower()
            ids = [i for i in ids if needle in self.msgs[i]["from"].lower()]
        for key, cmp in (("after", lambda d, v: d >= v), ("before", lambda d, v: d < v)):
            m = re.search(key + r":(\d{4})/(\d{2})/(\d{2})", q)
            if m:
                v = datetime(int(m.group(1)), int(m.group(2)), int(m.group(3)), tzinfo=timezone.utc)
                ids = [i for i in ids if cmp(self.msgs[i]["dt"], v)]
        if "is:unread" in q:
            ids = [i for i in ids if "UNREAD" in self.msgs[i]["labelIds"]]
        return ids

    def transport(self, method: str, url: str, headers: dict[str, str], body: Optional[bytes]) -> tuple[int, dict[str, Any], dict[str, str]]:
        u = urllib.parse.urlparse(url)
        if u.netloc == "oauth2.googleapis.com":
            self.refresh_calls += 1
            self.token_serial += 1
            self.valid_token = f"at-{self.token_serial}"
            return 200, {"access_token": self.valid_token, "expires_in": 3599, "scope": "https://www.googleapis.com/auth/gmail.modify"}, {}
        path = u.path.replace("/gmail/v1/users/me", "")
        self.calls += 1
        n = self.calls
        if self.expire_token_at_call is not None and n == self.expire_token_at_call:
            self.valid_token = "expired-server-side"
        if n in self.fail_calls:
            st, hd = self.fail_calls[n]
            self.log.append((method, path, st))
            return st, {"error": {"code": st, "message": "Rate Limit Exceeded" if st == 429 else "backend error"}}, hd
        if headers.get("Authorization") != f"Bearer {self.valid_token}":
            self.log.append((method, path, 401))
            return 401, {"error": {"code": 401, "message": "Invalid Credentials"}}, {}
        q = urllib.parse.parse_qs(u.query)
        st, js = 200, {}
        if method == "GET" and path == "/profile":
            js = {"emailAddress": "tester@example.com"}
        elif method == "GET" and path == "/messages":
            ids = self._filter(q.get("q", [""])[0])
            start = int(q.get("pageToken", ["0"])[0])
            size = min(int(q.get("maxResults", ["100"])[0]), self.page)
            chunk = ids[start:start + size]
            js = {"messages": [{"id": i, "threadId": self.msgs[i]["threadId"]} for i in chunk], "resultSizeEstimate": len(ids)}
            if start + size < len(ids):
                js["nextPageToken"] = str(start + size)
        elif method == "GET" and re.fullmatch(r"/messages/[^/]+", path):
            m = self.msgs.get(path.rsplit("/", 1)[1])
            if m is None:
                st, js = 404, {"error": {"code": 404, "message": "Requested entity was not found."}}
            elif q.get("format", ["full"])[0] == "minimal":
                js = {"id": m["id"], "threadId": m["threadId"], "labelIds": list(m["labelIds"])}
            else:
                js = {"id": m["id"], "threadId": m["threadId"], "labelIds": list(m["labelIds"]), "snippet": m["snippet"],
                      "payload": {"headers": [{"name": "From", "value": m["from"]}, {"name": "Subject", "value": m["subject"]}, {"name": "Date", "value": m["dt"].strftime("%a, %d %b %Y %H:%M:%S +0000")}]}}
        elif method == "POST" and re.fullmatch(r"/messages/[^/]+/trash", path):
            mid = path.split("/")[2]
            m = self.msgs.get(mid)
            if m is None or mid in self.refuse_trash:
                st, js = 400, {"error": {"code": 400, "message": "Precondition check failed."}}
            else:
                self.trash_ordinal += 1
                if self.on_trash:
                    self.on_trash(mid, self.trash_ordinal)  # may raise -> simulated crash BEFORE this id is trashed
                self.trash_count[mid] = self.trash_count.get(mid, 0) + 1
                m["labelIds"] = [x for x in m["labelIds"] if x not in ("INBOX", "UNREAD")] + (["TRASH"] if "TRASH" not in m["labelIds"] else [])
                js = {"id": mid, "labelIds": m["labelIds"]}
        else:
            st, js = 405, {"error": {"code": 405, "message": f"unsupported {method} {path}"}}
        self.log.append((method, path, st))
        return st, js, {}

    # ------------------------------------------------------------------ oracle (ground truth, independent from the skill)
    def trashed_ids(self) -> set[str]:
        return {i for i, m in self.msgs.items() if "TRASH" in m["labelIds"]}

    def forbidden_calls(self) -> list[tuple[str, str, int]]:
        return [c for c in self.log if c[0] == "DELETE" or c[1].endswith("/delete") or c[1].endswith("/batchDelete") or "/delete" in c[1]]

    def expected_head_tail(self, head: int, tail: int, query: str = "in:inbox") -> list[str]:
        ids = self._filter(query)
        out = ids[:head] + [i for i in ids[-tail:] if i not in ids[:head]] if tail else ids[:head]
        return out
