      "type": "object",
      "required": ["ref_id", "role", "name", "rect", "zone", "stable_key"],
      "properties": {
        "ref_id": { "type": "string", "pattern": "^@[0-9]+:[A-Za-z0-9_]+$", "description": "@snapshot_epoch:ref  (fail-closed: a ref from an older epoch is rejected with STALE_EPOCH)" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "value": { "type": "string" },
        "rect": { "$ref": "#/$defs/Rect" },
        "zone": { "$ref": "#/$defs/Zone" },
        "stable_key": { "type": "string", "description": "hash(role|automation_id|class|name|ancestor-path); stable across epochs" },
        "states": { "type": "array", "items": { "type": "string" } },
        "patterns": { "type": "array", "items": { "type": "string" } },
        "occluded": { "type": "boolean" }
      }
    },
    "WindowInfo": {
      "type": "object",
      "required": ["hwnd", "title", "process", "rect", "z"],
