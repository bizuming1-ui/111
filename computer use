fn pct(v: &mut Vec<u64>, p: f64) -> u64 { v.sort_unstable(); v[((v.len() as f64 - 1.0) * p).round() as usize] }

fn bench(st: &mut State, n: usize) -> Value {
    let _ = st.capture();                                  // prime (first frame is a full copy)
    let mut us: Vec<u64> = Vec::with_capacity(n);
    for _ in 0..n { let t = Instant::now(); let _ = st.capture(); us.push(t.elapsed().as_micros() as u64); }
    let (p50, p99) = (pct(&mut us.clone(), 0.5), pct(&mut us, 0.99));
    // worst case: every pixel changed -> full-frame copy into the ring (what a busy video/game screen costs)
    let (w, h) = st.src.dims(); let full = vec![7u8; (w * h * 4) as usize]; let m = ring::FrameMeta { w, h, stride: w * 4 };
    let mut fu: Vec<u64> = (0..(n / 4).max(20)).map(|_| { let t = Instant::now(); let _ = st.ring.write_frame(m, &full); t.elapsed().as_micros() as u64 }).collect();
    let full_p50 = pct(&mut fu, 0.5);
    json!({"ok": true, "backend": st.src.name(), "frames": n, "p50_ms": p50 as f64 / 1000.0, "p99_ms": p99 as f64 / 1000.0,
           "full_frame_copy_p50_ms": full_p50 as f64 / 1000.0, "target_ms": 5.0, "pass": (p50 as f64 / 1000.0) < 5.0})
}

fn serve_stream<S: std::io::Read + Write>(st: &mut State, s: S) {
    let mut rd = BufReader::new(s);
    let mut line = String::new();
    loop {
        line.clear();
        match rd.read_line(&mut line) { Ok(0) | Err(_) => break, Ok(_) => {} }
        let out = match serde_json::from_str::<Value>(line.trim()) { Ok(v) => st.handle(&v), Err(e) => json!({"ok": false, "error": e.to_string()}) };
        let w = rd.get_mut();
        if writeln!(w, "{}", out).is_err() || w.flush().is_err() { break; }
    }
}

