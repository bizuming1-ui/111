async function centerOf(tab: Tab, backendNodeId: number) {
  await tab.s.send("DOM.scrollIntoViewIfNeeded", { backendNodeId }).catch(() => undefined);
  let q: number[];
  try { q = (await tab.s.send("DOM.getBoxModel", { backendNodeId })).model.border; }
