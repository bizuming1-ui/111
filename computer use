class FakeUser32:
    """Scripted desktop: target hwnd 10 (pid 100) is covered by `blocker` (hwnd 20).  SetForegroundWindow is 'locked' (never works) - exactly the v15 failure."""

    def __init__(self, blocker_pid: int = 200) -> None:
        self.minimized: set[int] = set()
        self.topmost: set[int] = set()
        self.calls: list[tuple] = []
        self.pids = {10: 100, 20: blocker_pid, 30: 100}

    def _wrap(self, name: str):
        def f(*a):
            self.calls.append((name, *[x for x in a if isinstance(x, (int, bool))]))
            return 1
        return f

    def __getattr__(self, name: str):
        return self._wrap(name)

    def IsWindow(self, h): return 1
    def IsIconic(self, h): return 0
    def GetWindowLongW(self, h, i): return 0

    def GetWindowThreadProcessId(self, h, ref):
        if ref is not None and hasattr(ref, "_obj"):
            ref._obj.value = self.pids.get(int(h or 0), 1)
        return 70 + int(h or 0)

    def ShowWindow(self, h, cmd):
        self.calls.append(("ShowWindow", int(h), cmd))
        if cmd == 6:
            self.minimized.add(int(h))
        return 1

    def SetWindowPos(self, h, after, *rest):
        v = int(getattr(after, "value", after) or 0)
        v = v - (1 << 64) if v >= (1 << 63) else v  # c_void_p(-1) reads back unsigned
        self.calls.append(("SetWindowPos", int(h), v))
        if v == -1:
            self.topmost.add(int(h))
        return 1

    def WindowFromPoint(self, pt):
        if 10 in self.topmost or 20 in self.minimized:
            return 10
        return 20

    def GetAncestor(self, w, flag): return int(w)


