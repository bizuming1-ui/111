//! Window model: z-order enumeration, occlusion math, own-console shielding, verified foreground switching.
//! Lessons from the v12 run log: `focus_window` "succeeded" 20+ times while the foreground never changed.
//! Here every switch is *verified* (GetForegroundWindow == target) and escalates through 5 methods.
use serde_json::{json, Value};
use std::collections::{HashMap, HashSet};
use std::thread::sleep;
use std::time::Duration;
use windows::core::PWSTR;
use windows::Win32::Foundation::*;
use windows::Win32::Graphics::Dwm::{DwmGetWindowAttribute, DWMWA_CLOAKED};
use windows::Win32::System::Diagnostics::ToolHelp::*;
use windows::Win32::System::Threading::*;
use windows::Win32::UI::Input::KeyboardAndMouse::*;
use windows::Win32::UI::WindowsAndMessaging::*;

#[derive(Clone, Debug)]
pub struct Win {
    pub hwnd: isize,
    pub title: String,
    pub class: String,
    pub process: String,
    pub pid: u32,
    pub rect: [i32; 4], // x, y, w, h
    pub minimized: bool,
    pub topmost: bool,
    pub cloaked: bool,
    pub z: i32,
    pub own: bool,
}

impl Win {
    pub fn to_json(&self, occluded_by: &[isize]) -> Value {
        json!({
            "hwnd": self.hwnd, "title": self.title, "process": self.process, "pid": self.pid,
            "class": self.class, "rect": self.rect, "z": self.z, "minimized": self.minimized,
            "topmost": self.topmost, "cloaked": self.cloaked, "occluded_by": occluded_by,
            "own_console": self.own
        })
    }
}

pub fn hwnd_of(v: isize) -> HWND {
    HWND(v as *mut core::ffi::c_void)
}

pub fn raw(h: HWND) -> isize {
    h.0 as isize
}

fn wstr(buf: &[u16], n: i32) -> String {
    String::from_utf16_lossy(&buf[..(n.max(0) as usize).min(buf.len())])
}

pub fn title_of(h: HWND) -> String {
    let mut b = [0u16; 512];
    let n = unsafe { GetWindowTextW(h, &mut b) };
    wstr(&b, n)
}

pub fn class_of(h: HWND) -> String {
    let mut b = [0u16; 256];
    let n = unsafe { GetClassNameW(h, &mut b) };
    wstr(&b, n)
}

pub fn pid_of(h: HWND) -> u32 {
    let mut pid = 0u32;
    unsafe { GetWindowThreadProcessId(h, Some(&mut pid)) };
    pid
}

pub fn process_name(pid: u32) -> String {
    unsafe {
        let Ok(hp) = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) else {
            return String::new();
        };
        let mut buf = [0u16; 520];
        let mut len = buf.len() as u32;
        let ok = QueryFullProcessImageNameW(hp, PROCESS_NAME_WIN32, PWSTR(buf.as_mut_ptr()), &mut len);
        let _ = CloseHandle(hp);
        if ok.is_err() {
            return String::new();
        }
        let full = String::from_utf16_lossy(&buf[..len as usize]);
        full.rsplit('\\').next().unwrap_or("").to_string()
    }
}

/// pid -> parent pid for the whole process table (one snapshot).
pub fn parent_map() -> HashMap<u32, u32> {
    let mut m = HashMap::new();
    unsafe {
        let Ok(snap) = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0) else {
            return m;
        };
        let mut e = PROCESSENTRY32W { dwSize: std::mem::size_of::<PROCESSENTRY32W>() as u32, ..Default::default() };
        if Process32FirstW(snap, &mut e).is_ok() {
            loop {
                m.insert(e.th32ProcessID, e.th32ParentProcessID);
                if Process32NextW(snap, &mut e).is_err() {
                    break;
                }
            }
        }
        let _ = CloseHandle(snap);
    }
    m
}

/// The agent's own pid + all ancestors (pwsh, WindowsTerminal, conhost...) => windows we must never "act on".
pub fn own_pid_chain(pid: u32) -> HashSet<u32> {
    let pm = parent_map();
    let mut s = HashSet::new();
    let mut cur = pid;
    for _ in 0..8 {
        if cur == 0 || !s.insert(cur) {
            break;
        }
        match pm.get(&cur) {
            Some(p) => cur = *p,
            None => break,
        }
    }
    s
}

unsafe extern "system" fn enum_cb(h: HWND, lp: LPARAM) -> BOOL {
    let v = &mut *(lp.0 as *mut Vec<HWND>);
    v.push(h);
    BOOL(1)
}

pub fn is_cloaked(h: HWND) -> bool {
    let mut c: u32 = 0;
    unsafe {
        let _ = DwmGetWindowAttribute(h, DWMWA_CLOAKED, &mut c as *mut u32 as *mut _, 4);
    }
    c != 0
}

pub fn rect_of(h: HWND) -> [i32; 4] {
    let mut r = RECT::default();
    unsafe {
        let _ = GetWindowRect(h, &mut r);
    }
    [r.left, r.top, r.right - r.left, r.bottom - r.top]
}

/// Top-level windows in z-order (index 0 = topmost). Only user-visible windows are returned.
pub fn enum_windows(own_pids: &HashSet<u32>) -> Vec<Win> {
    let mut hs: Vec<HWND> = Vec::new();
    unsafe {
        let _ = EnumWindows(Some(enum_cb), LPARAM(&mut hs as *mut Vec<HWND> as isize));
    }
    let mut out = Vec::new();
    let mut cache: HashMap<u32, String> = HashMap::new();
    for (z, h) in hs.into_iter().enumerate() {
        unsafe {
            if !IsWindowVisible(h).as_bool() {
                continue;
            }
            let ex = GetWindowLongW(h, GWL_EXSTYLE) as u32;
            let minimized = IsIconic(h).as_bool();
            let rect = rect_of(h);
            let title = title_of(h);
            let class = class_of(h);
            if ex & WS_EX_TOOLWINDOW.0 != 0 && title.is_empty() {
                continue;
            }
            if title.is_empty() && (rect[2] < 80 || rect[3] < 40) && class != "Shell_TrayWnd" {
                continue;
            }
            let cloaked = is_cloaked(h);
            let pid = pid_of(h);
            let process = cache.entry(pid).or_insert_with(|| process_name(pid)).clone();
            out.push(Win {
                hwnd: raw(h), title, class, process, pid, rect, minimized,
                topmost: ex & WS_EX_TOPMOST.0 != 0, cloaked, z: z as i32, own: own_pids.contains(&pid),
            });
        }
    }
    out
}

fn is_shell_class(c: &str) -> bool {
    matches!(c, "Progman" | "WorkerW" | "Shell_TrayWnd" | "Shell_SecondaryTrayWnd")
}

pub fn is_shell(w: &Win) -> bool {
    is_shell_class(&w.class)
}

/// Windows above `target` in z-order that cover >= 12% of its area (own console included on purpose:
/// the console is allowed to hide a target - the brain must know).
pub fn occluders(target: &Win, all: &[Win]) -> Vec<isize> {
    let [tx, ty, tw, th] = target.rect;
    let area = (tw.max(1) as i64) * (th.max(1) as i64);
    let mut v = Vec::new();
    for w in all {
        if w.z >= target.z || w.hwnd == target.hwnd || w.minimized || w.cloaked || is_shell(w) {
            continue;
        }
        let ix = (tx + tw).min(w.rect[0] + w.rect[2]) - tx.max(w.rect[0]);
        let iy = (ty + th).min(w.rect[1] + w.rect[3]) - ty.max(w.rect[1]);
        if ix > 0 && iy > 0 && (ix as i64) * (iy as i64) * 100 / area >= 12 {
            v.push(w.hwnd);
        }
    }
    v
}

pub fn foreground() -> isize {
    raw(unsafe { GetForegroundWindow() })
}

fn tap_alt() {
    unsafe {
        keybd_event(VK_MENU.0 as u8, 0, KEYBD_EVENT_FLAGS(0), 0);
        keybd_event(VK_MENU.0 as u8, 0, KEYEVENTF_KEYUP, 0);
    }
}

fn confirm(h: isize, wait_ms: u64) -> bool {
    let mut waited = 0;
    while waited <= wait_ms {
        if foreground() == h {
            return true;
        }
        sleep(Duration::from_millis(20));
        waited += 20;
    }
    foreground() == h
}

/// Verified foreground switch. Returns (ok, method, attempts). Never reports success unless
/// GetForegroundWindow() == target afterwards (the v12 "已切换到窗口" lie).
pub fn force_foreground(target: isize) -> (bool, &'static str, u32) {
    let h = hwnd_of(target);
    unsafe {
        if !IsWindow(h).as_bool() {
            return (false, "no_such_window", 0);
        }
        if IsIconic(h).as_bool() {
            let _ = ShowWindow(h, SW_RESTORE);
            sleep(Duration::from_millis(60));
        }
        if foreground() == target {
            return (true, "already", 0);
        }
        // 1) plain
        let _ = SetForegroundWindow(h);
        if confirm(target, 80) {
            return (true, "SetForegroundWindow", 1);
        }
        // 2) ALT tap unlocks the foreground lock for this input thread
        tap_alt();
        let _ = SetForegroundWindow(h);
        if confirm(target, 80) {
            return (true, "alt_tap", 2);
        }
        // 3) AttachThreadInput to the current foreground thread
        let fg = GetForegroundWindow();
        let fg_tid = GetWindowThreadProcessId(fg, None);
        let my_tid = GetCurrentThreadId();
        let tgt_tid = GetWindowThreadProcessId(h, None);
        let _ = AttachThreadInput(my_tid, fg_tid, true);
        let _ = AttachThreadInput(my_tid, tgt_tid, true);
        let _ = BringWindowToTop(h);
        let _ = SetForegroundWindow(h);
        let _ = AttachThreadInput(my_tid, tgt_tid, false);
        let _ = AttachThreadInput(my_tid, fg_tid, false);
        if confirm(target, 100) {
            return (true, "attach_thread_input", 3);
        }
        // 4) SwitchToThisWindow (undocumented but robust)
        SwitchToThisWindow(h, true);
        if confirm(target, 120) {
            return (true, "SwitchToThisWindow", 4);
        }
        // 5) topmost toggle + minimize/restore cycle
        let _ = ShowWindow(h, SW_MINIMIZE);
        sleep(Duration::from_millis(80));
        let _ = ShowWindow(h, SW_RESTORE);
        let _ = SetWindowPos(h, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_SHOWWINDOW);
        let _ = SetWindowPos(h, HWND_NOTOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_SHOWWINDOW);
        let _ = SetForegroundWindow(h);
        if confirm(target, 200) {
            return (true, "minimize_restore_topmost", 5);
        }
    }
    (false, "all_methods_failed", 5)
}

pub fn show(target: isize, cmd: SHOW_WINDOW_CMD) -> bool {
    unsafe { ShowWindow(hwnd_of(target), cmd).as_bool() || IsWindow(hwnd_of(target)).as_bool() }
}

pub fn post_close(target: isize) -> bool {
    unsafe { PostMessageW(hwnd_of(target), WM_CLOSE, WPARAM(0), LPARAM(0)).is_ok() }
