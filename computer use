function Get-P6Files {
    $map = [ordered]@{}
    $cur = $null
    $sb = [System.Text.StringBuilder]::new()
    foreach ($line in ($script:P6Payload -split "\r?\n")) {
        if ($line -match '^#=#=# FILE: (\S.*)$') {
            if ($cur) { $map[$cur] = $sb.ToString().TrimEnd("`r", "`n") + "`n" }
            $cur = $Matches[1].Trim()
            [void]$sb.Clear()
        }
        elseif ($cur) { [void]$sb.Append($line).Append("`n") }
    }
    if ($cur) { $map[$cur] = $sb.ToString().TrimEnd("`r", "`n") + "`n" }
    return $map
}

function Export-DscuDriverSource([string]$Dir) {
    if ([string]::IsNullOrWhiteSpace($Dir)) { $Dir = Join-Path $script:P6Base 'src' }
    $Dir = [System.IO.Path]::GetFullPath($Dir)
    [void][System.IO.Directory]::CreateDirectory($Dir)
    $n = 0
    foreach ($kv in (Get-P6Files).GetEnumerator()) {
        $rel = [string]$kv.Key
        if ($rel -match '(^|[\\/])\.\.([\\/]|$)' -or [System.IO.Path]::IsPathRooted($rel) -or $rel -match ':') { throw "payload path violation: $rel" }
        $dst = [System.IO.Path]::GetFullPath((Join-Path $Dir $rel))
        if (-not $dst.StartsWith($Dir + [System.IO.Path]::DirectorySeparatorChar, [System.StringComparison]::OrdinalIgnoreCase)) { throw "payload path escapes target: $rel" }
        [void][System.IO.Directory]::CreateDirectory([System.IO.Path]::GetDirectoryName($dst))
        [System.IO.File]::WriteAllText($dst, [string]$kv.Value, [System.Text.UTF8Encoding]::new($false))
        $n++
    }
    return [pscustomobject]@{ Dir = $Dir; Files = $n }
}

