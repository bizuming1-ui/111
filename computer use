//! `window.probe` / `window.focus` — window semantic fingerprint + editability preflight.
//! Windows: ONE batched IUIAutomationCacheRequest (TreeScope_Subtree) counts Edit/Document controls -> never focus a read-only popup.
use serde::Deserialize;
use serde_json::{json, Value};

#[derive(Clone, Debug, Default, Deserialize)]
pub struct Fp { pub title: String, #[serde(default)] pub process: String, #[serde(default = "yes")] pub visible: bool, #[serde(default)] pub owned: bool,
                #[serde(default)] pub tool_window: bool, #[serde(default)] pub iconic: bool, #[serde(default)] pub area: i64, #[serde(default)] pub edit: i64 }
fn yes() -> bool { true }

const RO: [&str; 15] = ["聊天记录", "记录", "历史", "history", " log", "详情", "详细", "预览", "preview", "viewer", "查看", "只读", "readonly", "收藏", "通知"];
pub fn is_readonly_title(t: &str) -> bool { let l = t.to_lowercase(); RO.iter().any(|k| l.contains(k)) }

pub fn focus_score(fp: &Fp, keyword: &str, need_input: bool) -> f64 {
    if !fp.visible { return -100.0; }
    let (kw, t) = (keyword.to_lowercase(), fp.title.to_lowercase());
    let mut s = 0.0;
    if !kw.is_empty() && t == kw { s += 40.0 } else if !kw.is_empty() && t.contains(&kw) { s += 25.0 } else if !kw.is_empty() && fp.process.to_lowercase().contains(&kw) { s += 15.0 }
    if !fp.owned && !fp.tool_window { s += 20.0 }
    if fp.edit > 0 { s += if need_input { 35.0 } else { 10.0 } } else if need_input { s -= 15.0; if is_readonly_title(&fp.title) { s -= 30.0 } }
    if fp.owned && need_input { s -= 10.0 }
    s += (fp.area as f64 / 200_000.0).min(10.0);
    if fp.iconic { s -= 5.0 }
    (s * 100.0).round() / 100.0
}

pub fn pick<'a>(c: &'a [Fp], keyword: &str, need_input: bool) -> Option<&'a Fp> {
    let mut r: Vec<&Fp> = c.iter().collect();
    r.sort_by(|a, b| focus_score(b, keyword, need_input).partial_cmp(&focus_score(a, keyword, need_input)).unwrap());
    let top = *r.first()?;
    if need_input && top.edit == 0 && is_readonly_title(&top.title) {
        if let Some(s) = r.iter().copied().filter(|x| !std::ptr::eq(*x, top) && x.visible && x.process.eq_ignore_ascii_case(&top.process) && !x.tool_window && !x.owned && !is_readonly_title(&x.title)).max_by_key(|x| (x.edit, x.area)) { return Some(s); }
    }
    Some(top)
}

#[cfg(windows)]
pub fn probe_hwnd(hwnd: isize) -> Result<(i64, i64), String> {
    use windows::Win32::Foundation::HWND;
    use windows::Win32::System::Com::{CoCreateInstance, CoInitializeEx, CLSCTX_INPROC_SERVER, COINIT_MULTITHREADED};
    use windows::Win32::UI::Accessibility::*;
    unsafe {
        let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
        let ua: IUIAutomation = CoCreateInstance(&CUIAutomation, None, CLSCTX_INPROC_SERVER).map_err(|e| e.to_string())?;
        let cr = ua.CreateCacheRequest().map_err(|e| e.to_string())?;
        cr.AddProperty(UIA_ControlTypePropertyId).map_err(|e| e.to_string())?;
        cr.SetTreeScope(TreeScope_Subtree).map_err(|e| e.to_string())?;
        let root = ua.ElementFromHandleBuildCache(HWND(hwnd as *mut _), &cr).map_err(|e| e.to_string())?;
        let all = root.FindAllBuildCache(TreeScope_Subtree, &ua.CreateTrueCondition().map_err(|e| e.to_string())?, &cr).map_err(|e| e.to_string())?;
        let (n, mut edit) = (all.Length().map_err(|e| e.to_string())? as i64, 0i64);
        for i in 0..n { if let Ok(el) = all.GetElement(i as i32) { if let Ok(t) = el.CachedControlType() { if t == UIA_EditControlTypeId || t == UIA_DocumentControlTypeId { edit += 1; } } } }
        Ok((n, edit))
    }
}
#[cfg(not(windows))]
pub fn probe_hwnd(_h: isize) -> Result<(i64, i64), String> { Err("window.probe is Windows-only".into()) }

pub fn handle(v: &Value) -> Value {
    if let Some(c) = v.get("candidates") {   // pure scoring mode (tests / PowerShell supplied fingerprints)
        let cands: Vec<Fp> = serde_json::from_value(c.clone()).unwrap_or_default();
        return match pick(&cands, v["keyword"].as_str().unwrap_or(""), v["need_input"].as_bool().unwrap_or(true)) { Some(p) => json!({"ok": true, "title": p.title}), None => json!({"ok": false}) };
    }
    match probe_hwnd(v["hwnd"].as_i64().unwrap_or(0) as isize) { Ok((nodes, edit)) => json!({"ok": true, "nodes": nodes, "edit": edit}), Err(e) => json!({"ok": false, "error": e}) }
}
pub fn focus(v: &Value) -> Value { handle(v) }

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn golden_focus_cases() {
        let fx: Value = serde_json::from_str(include_str!("../../../evals/fixtures/log_golden.json")).unwrap();
        for c in fx["cases"].as_array().unwrap().iter().filter(|c| c["kind"] == "focus") {
            let cands: Vec<Fp> = serde_json::from_value(c["candidates"].clone()).unwrap();
            assert_eq!(pick(&cands, c["keyword"].as_str().unwrap(), c["need_input"].as_bool().unwrap()).unwrap().title, c["expect"]["title"].as_str().unwrap(), "{}", c["id"]);
        }
    }
}
