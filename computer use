    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=18765); ap.add_argument("--detect-model", default=os.environ.get("DSCU_DETECT_MODEL"))
    ap.add_argument("--mem-cap-mb", type=int, default=3072); ap.add_argument("--mem-floor-mb", type=int, default=4096)
