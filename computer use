function Set-V92CdpRowCheck($row, [bool]$on) {
    # 通过 CDP 可信输入事件（Input.dispatchMouseEvent）幂等设定第 N 行复选框：scrollIntoView → 命中核验 → 点击 → 读回；失败再用 DOM click 兜底。视口外的行（如 R48-R50）同样可达。
    $want = if ($on) { 'on' } else { 'off' }
    $idx = [int]$row.CdpIdx
    $p = Invoke-V92CdpRows 'point' $idx
    if ($null -eq $p -or -not $p.ok) { throw "第 $($row.Index) 行复选框无法经 CDP 定位（页面已重绘？请重新观察）" }
    $cur = if ($p.c -eq $true) { 'on' } else { 'off' }
    if ($cur -eq $want) { return [pscustomobject]@{ Ok = $true; Changed = $false; State = $cur; Via = '已是目标状态，未操作' } }
    $x = [double]$p.x; $y = [double]$p.y
    [void](Invoke-CdpMethod 'Input.dispatchMouseEvent' @{ type = 'mouseMoved'; x = $x; y = $y } 2000)
    [void](Invoke-CdpMethod 'Input.dispatchMouseEvent' @{ type = 'mousePressed'; x = $x; y = $y; button = 'left'; clickCount = 1 } 2000)
    [void](Invoke-CdpMethod 'Input.dispatchMouseEvent' @{ type = 'mouseReleased'; x = $x; y = $y; button = 'left'; clickCount = 1 } 2000)
    Start-Sleep -Milliseconds 150
    $q = Invoke-V92CdpRows 'read' $idx
    $st = if ($null -ne $q -and $q.c -eq $true) { 'on' } else { 'off' }
    if ($st -ne $want) {
        Start-Sleep -Milliseconds 250
        $q = Invoke-V92CdpRows 'read' $idx; $st = if ($null -ne $q -and $q.c -eq $true) { 'on' } else { 'off' }   # 迟到的异步生效：再读一次，绝不盲目再点
        if ($st -ne $want) { $q = Invoke-V92CdpRows 'toggle' $idx; $st = if ($null -ne $q -and $q.c -eq $true) { 'on' } else { 'off' } }
    }
    return [pscustomobject]@{ Ok = ($st -eq $want); Changed = $true; State = $st; Via = 'CDP 可信鼠标事件（行模型）' }
}
function Set-V92RowCheck($row, [bool]$on) {
    if ($row.Cdp) { return (Set-V92CdpRowCheck $row $on) }
    return (Set-CheckState (ConvertTo-RowCbItem $row) $on "R$($row.Index)")
}

