$script:DscuFiles['crates/dscu-driver/src/dxgi.rs'] = @'
//! REAL DXGI Desktop Duplication (IDXGIOutputDuplication::AcquireNextFrame) with honest telemetry.
//!
//! * `capture_backend` is "DXGI" only when the frame really came from the duplication API.
//! * Any GDI use is explicit and carries `fallback_reason` (SECURE_DESKTOP_ACTIVE / DUPLICATE_OUTPUT_FAILED:<hr> /
//!   REGION_OUTSIDE_OUTPUT0 / ACCESS_LOST_RECREATING ...). Nothing is ever silently substituted.
//! * Pipeline: AcquireNextFrame(timeout) -> CopyResource into a persistent GPU "shadow" texture (so "nothing changed"
//!   costs ~0 and the latest frame is always available) -> optional CopySubresourceRegion of ONLY the requested rectangle
//!   into a STAGING texture -> single Map -> BGRA bytes. DirtyRects / MoveRects of the acquired frame are returned verbatim.
use std::time::Instant;
use windows::core::Interface;
use windows::Win32::Foundation::*;
use windows::Win32::Graphics::Direct3D::*;
use windows::Win32::Graphics::Direct3D11::*;
use windows::Win32::Graphics::Dxgi::Common::*;
use windows::Win32::Graphics::Dxgi::*;
use windows::Win32::Graphics::Gdi::*;

#[derive(Clone, Copy, Debug)]
pub struct Rect {
    pub x: i32,
    pub y: i32,
    pub w: i32,
    pub h: i32,
}

pub struct Pixels {
    pub w: u32,
    pub h: u32,
    pub bgra: Vec<u8>,
}

#[derive(Clone, Debug)]
pub struct FrameStats {
    pub backend: &'static str,
    pub fallback_reason: Option<String>,
    pub adapter: String,
    pub frame_ms: f64,
    pub acquire_us: u64,
    pub readback_us: u64,
    pub dirty: Vec<[i32; 4]>,
    pub moves: usize,
    pub fresh: bool,
    pub width: u32,
    pub height: u32,
}

struct Engine {
    device: ID3D11Device,
    ctx: ID3D11DeviceContext,
    dup: IDXGIOutputDuplication,
    shadow: ID3D11Texture2D,
    staging: Option<(ID3D11Texture2D, u32, u32)>,
    width: u32,
    height: u32,
    origin: (i32, i32),
    has_frame: bool,
    adapter: String,
}

fn tex_desc(w: u32, h: u32, usage: D3D11_USAGE, cpu: u32) -> D3D11_TEXTURE2D_DESC {
    D3D11_TEXTURE2D_DESC {
        Width: w,
        Height: h,
        MipLevels: 1,
        ArraySize: 1,
        Format: DXGI_FORMAT_B8G8R8A8_UNORM,
        SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
        Usage: usage,
        BindFlags: 0,
        CPUAccessFlags: cpu,
        MiscFlags: 0,
    }
}

impl Engine {
    fn new() -> Result<Engine, String> {
        unsafe {
            let factory: IDXGIFactory1 = CreateDXGIFactory1().map_err(|e| format!("CreateDXGIFactory1:{e}"))?;
            let mut best: Option<(IDXGIAdapter1, DXGI_ADAPTER_DESC1)> = None;
            let mut i = 0;
            while let Ok(a) = factory.EnumAdapters1(i) {
                i += 1;
                let desc = a.GetDesc1().map_err(|e| e.to_string())?;
                if a.EnumOutputs(0).is_err() {
                    continue; // adapter without an attached display
                }
                // Prefer the adapter that owns the primary output; among ties prefer discrete/AMD/NVIDIA over Basic Render.
                let software = desc.VendorId == 0x1414;
                if best.is_none() || (!software && best.as_ref().map(|b| b.1.VendorId == 0x1414).unwrap_or(false)) {
                    best = Some((a, desc));
                }
            }
            let (adapter, desc) = best.ok_or("NO_ADAPTER_WITH_OUTPUT")?;
            let name = String::from_utf16_lossy(&desc.Description).trim_end_matches('\0').to_string();
            let base: IDXGIAdapter = adapter.cast().map_err(|e| e.to_string())?;
            let mut device: Option<ID3D11Device> = None;
            let mut ctx: Option<ID3D11DeviceContext> = None;
            D3D11CreateDevice(&base, D3D_DRIVER_TYPE_UNKNOWN, HMODULE::default(), D3D11_CREATE_DEVICE_BGRA_SUPPORT, None, D3D11_SDK_VERSION, Some(&mut device), None, Some(&mut ctx))
                .map_err(|e| format!("D3D11CreateDevice:{e}"))?;
            let (device, ctx) = (device.ok_or("NO_DEVICE")?, ctx.ok_or("NO_CONTEXT")?);
            let output = adapter.EnumOutputs(0).map_err(|e| e.to_string())?;
            let odesc = output.GetDesc().map_err(|e| e.to_string())?;
            let out1: IDXGIOutput1 = output.cast().map_err(|e| e.to_string())?;
            let dup = out1.DuplicateOutput(&device).map_err(|e| format!("DUPLICATE_OUTPUT_FAILED:{:#010x}", e.code().0 as u32))?;
            let r = odesc.DesktopCoordinates;
            let (w, h) = ((r.right - r.left) as u32, (r.bottom - r.top) as u32);
            let mut shadow: Option<ID3D11Texture2D> = None;
            device.CreateTexture2D(&tex_desc(w, h, D3D11_USAGE_DEFAULT, 0), None, Some(&mut shadow)).map_err(|e| format!("SHADOW_TEXTURE:{e}"))?;
            Ok(Engine { device, ctx, dup, shadow: shadow.ok_or("NO_SHADOW")?, staging: None, width: w, height: h, origin: (r.left, r.top), has_frame: false, adapter: name })
        }
    }

    /// Returns (fresh, dirty, moves, acquire_us). `fresh=false` => no desktop change since the last call; shadow reused.
    fn acquire(&mut self, timeout_ms: u32) -> Result<(bool, Vec<[i32; 4]>, usize, u64), String> {
        let t = Instant::now();
        let mut budget = if self.has_frame { timeout_ms } else { 400 };
        loop {
            let mut info = DXGI_OUTDUPL_FRAME_INFO::default();
            let mut res: Option<IDXGIResource> = None;
            let r = unsafe { self.dup.AcquireNextFrame(budget, &mut info, &mut res) };
            match r {
                Ok(()) => {
                    let mut dirty: Vec<[i32; 4]> = vec![];
                    let mut moves = 0usize;
                    let mut copied = false;
                    if let Some(res) = res {
                        if info.LastPresentTime != 0 {
                            if let Ok(tex) = res.cast::<ID3D11Texture2D>() {
                                unsafe { self.ctx.CopyResource(&self.shadow, &tex) };
                                copied = true;
                            }
                            if info.TotalMetadataBufferSize > 0 {
                                unsafe {
                                    let mut need = 0u32;
                                    let n_mv = (info.TotalMetadataBufferSize as usize / std::mem::size_of::<DXGI_OUTDUPL_MOVE_RECT>()).max(1);
                                    let mut mv = vec![DXGI_OUTDUPL_MOVE_RECT::default(); n_mv];
                                    if self.dup.GetFrameMoveRects((mv.len() * std::mem::size_of::<DXGI_OUTDUPL_MOVE_RECT>()) as u32, mv.as_mut_ptr(), &mut need).is_ok() {
                                        moves = need as usize / std::mem::size_of::<DXGI_OUTDUPL_MOVE_RECT>();
                                    }
                                    let n_dr = (info.TotalMetadataBufferSize as usize / std::mem::size_of::<RECT>()).max(1);
                                    let mut dr = vec![RECT::default(); n_dr];
                                    if self.dup.GetFrameDirtyRects((dr.len() * std::mem::size_of::<RECT>()) as u32, dr.as_mut_ptr(), &mut need).is_ok() {
                                        let n = need as usize / std::mem::size_of::<RECT>();
                                        for d in dr.iter().take(n) {
                                            dirty.push([d.left, d.top, d.right, d.bottom]);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    unsafe {
                        let _ = self.dup.ReleaseFrame();
                    }
                    if copied {
                        self.has_frame = true;
                        return Ok((true, dirty, moves, t.elapsed().as_micros() as u64));
                    }
                    if self.has_frame {
                        return Ok((false, vec![], 0, t.elapsed().as_micros() as u64)); // mouse-pointer-only update
                    }
                    budget = 100;
                }
                Err(e) if e.code() == DXGI_ERROR_WAIT_TIMEOUT => {
                    if self.has_frame {
                        return Ok((false, vec![], 0, t.elapsed().as_micros() as u64));
                    }
                    if t.elapsed().as_millis() > 800 {
                        return Err("NO_FIRST_FRAME_WITHIN_800MS".into());
                    }
                }
                Err(e) if e.code() == DXGI_ERROR_ACCESS_LOST => return Err("ACCESS_LOST".into()),
                Err(e) => return Err(format!("ACQUIRE_FAILED:{:#010x}", e.code().0 as u32)),
            }
        }
    }

    fn readback(&mut self, r: Rect) -> Result<Pixels, String> {
        let (rx, ry) = (r.x - self.origin.0, r.y - self.origin.1);
        let (w, h) = (r.w as u32, r.h as u32);
        let need_new = self.staging.as_ref().map(|s| s.1 != w || s.2 != h).unwrap_or(true);
        unsafe {
            if need_new {
                let mut tex: Option<ID3D11Texture2D> = None;
                self.device
                    .CreateTexture2D(&tex_desc(w, h, D3D11_USAGE_STAGING, D3D11_CPU_ACCESS_READ.0 as u32), None, Some(&mut tex))
                    .map_err(|e| format!("STAGING_TEXTURE:{e}"))?;
                self.staging = Some((tex.ok_or("NO_STAGING")?, w, h));
            }
            let st = &self.staging.as_ref().unwrap().0;
            let bx = D3D11_BOX { left: rx as u32, top: ry as u32, front: 0, right: (rx + r.w) as u32, bottom: (ry + r.h) as u32, back: 1 };
            self.ctx.CopySubresourceRegion(st, 0, 0, 0, 0, &self.shadow, 0, Some(&bx));
            let mut m = D3D11_MAPPED_SUBRESOURCE::default();
            self.ctx.Map(st, 0, D3D11_MAP_READ, 0, Some(&mut m)).map_err(|e| format!("MAP_FAILED:{e}"))?;
            let pitch = m.RowPitch as usize;
            let src = std::slice::from_raw_parts(m.pData as *const u8, pitch * h as usize);
            let mut out = vec![0u8; (w * h * 4) as usize];
            for row in 0..h as usize {
                let s = &src[row * pitch..row * pitch + (w as usize) * 4];
                out[row * (w as usize) * 4..(row + 1) * (w as usize) * 4].copy_from_slice(s);
            }
            self.ctx.Unmap(st, 0);
            Ok(Pixels { w, h, bgra: out })
        }
    }
}

pub struct Capturer {
    engine: Option<Engine>,
    pub fallback_reason: Option<String>,
    last_try: Instant,
    pub frames_total: u64,
    pub dxgi_frames: u64,
    pub gdi_frames: u64,
    pub access_lost: u64,
    pub adapter: String,
}

impl Capturer {
    pub fn new() -> Capturer {
        let mut c = Capturer { engine: None, fallback_reason: None, last_try: Instant::now(), frames_total: 0, dxgi_frames: 0, gdi_frames: 0, access_lost: 0, adapter: String::new() };
        c.try_init();
        c
    }

    fn try_init(&mut self) {
        self.last_try = Instant::now();
        if crate::sys::secure_desktop_active() {
            self.engine = None;
            self.fallback_reason = Some("SECURE_DESKTOP_ACTIVE".into());
            return;
        }
        match Engine::new() {
            Ok(e) => {
                self.adapter = e.adapter.clone();
                self.engine = Some(e);
                self.fallback_reason = None;
            }
            Err(e) => {
                self.engine = None;
                self.fallback_reason = Some(e);
            }
        }
    }

    pub fn screen(&self) -> Rect {
        match &self.engine {
            Some(e) => Rect { x: e.origin.0, y: e.origin.1, w: e.width as i32, h: e.height as i32 },
            None => unsafe {
                use windows::Win32::UI::WindowsAndMessaging::*;
                Rect { x: GetSystemMetrics(SM_XVIRTUALSCREEN), y: GetSystemMetrics(SM_YVIRTUALSCREEN), w: GetSystemMetrics(SM_CXVIRTUALSCREEN), h: GetSystemMetrics(SM_CYVIRTUALSCREEN) }
            },
        }
    }

    pub fn backend_name(&self) -> &'static str {
        if self.engine.is_some() {
            "DXGI"
        } else {
            "GDI"
        }
    }

    /// Capture. `region=None` + `want_pixels=false` measures pure duplication (acquire + GPU copy).
    pub fn capture(&mut self, region: Option<Rect>, want_pixels: bool, timeout_ms: u32) -> Result<(FrameStats, Option<Pixels>), String> {
        let t0 = Instant::now();
        self.frames_total += 1;
        if self.engine.is_none() && self.last_try.elapsed().as_secs() >= 3 {
            self.try_init(); // transient reasons (lock screen, mode switch) heal automatically
        }
        let mut reason = self.fallback_reason.clone();
        if let Some(eng) = self.engine.as_mut() {
            let scr = Rect { x: eng.origin.0, y: eng.origin.1, w: eng.width as i32, h: eng.height as i32 };
            let r = region.unwrap_or(scr);
            let inside = r.w >= 1 && r.h >= 1 && r.x >= scr.x && r.y >= scr.y && r.x + r.w <= scr.x + scr.w && r.y + r.h <= scr.y + scr.h;
            if inside {
                match eng.acquire(timeout_ms) {
                    Ok((fresh, dirty, moves, acquire_us)) => {
                        let t1 = Instant::now();
                        let px = if want_pixels { Some(eng.readback(r)?) } else { None };
                        let readback_us = t1.elapsed().as_micros() as u64;
                        self.dxgi_frames += 1;
                        let st = FrameStats { backend: "DXGI", fallback_reason: None, adapter: eng.adapter.clone(), frame_ms: t0.elapsed().as_secs_f64() * 1000.0, acquire_us, readback_us, dirty, moves, fresh, width: eng.width, height: eng.height };
                        return Ok((st, px));
                    }
                    Err(e) => {
                        if e == "ACCESS_LOST" {
                            self.access_lost += 1;
                            reason = Some("ACCESS_LOST_RECREATING".into());
                        } else {
                            reason = Some(e);
                        }
                        self.engine = None;
                        self.fallback_reason = reason.clone();
                        self.last_try = Instant::now() - std::time::Duration::from_secs(10); // retry DXGI on next call
                    }
                }
            } else {
                reason = Some("REGION_OUTSIDE_OUTPUT0".into());
            }
        }
        // Explicit GDI fallback (reason is always reported)
        let scr = self.screen();
        let r = region.unwrap_or(scr);
        let px = gdi_capture(r)?;
        self.gdi_frames += 1;
        let st = FrameStats { backend: "GDI", fallback_reason: reason.or(Some("UNKNOWN".into())), adapter: self.adapter.clone(), frame_ms: t0.elapsed().as_secs_f64() * 1000.0, acquire_us: 0, readback_us: t0.elapsed().as_micros() as u64, dirty: vec![], moves: 0, fresh: true, width: scr.w as u32, height: scr.h as u32 };
        Ok((st, if want_pixels { Some(px) } else { None }))
    }
}

pub fn gdi_capture(r: Rect) -> Result<Pixels, String> {
    unsafe {
        let hdc = GetDC(None);
        if hdc.is_invalid() {
            return Err("GDI_GETDC_FAILED".into());
        }
        let mem = CreateCompatibleDC(hdc);
        let bmp = CreateCompatibleBitmap(hdc, r.w, r.h);
        let old = SelectObject(mem, bmp);
        let ok = BitBlt(mem, 0, 0, r.w, r.h, hdc, r.x, r.y, SRCCOPY | CAPTUREBLT).is_ok();
        let mut bi = BITMAPINFO::default();
        bi.bmiHeader = BITMAPINFOHEADER { biSize: std::mem::size_of::<BITMAPINFOHEADER>() as u32, biWidth: r.w, biHeight: -r.h, biPlanes: 1, biBitCount: 32, biCompression: 0, ..Default::default() };
        let mut buf = vec![0u8; (r.w * r.h * 4) as usize];
        let lines = GetDIBits(mem, bmp, 0, r.h as u32, Some(buf.as_mut_ptr() as *mut _), &mut bi, DIB_RGB_COLORS);
        SelectObject(mem, old);
        let _ = DeleteObject(bmp);
        let _ = DeleteDC(mem);
        ReleaseDC(None, hdc);
        if !ok || lines == 0 {
            return Err("GDI_BITBLT_FAILED".into());
        }
        Ok(Pixels { w: r.w as u32, h: r.h as u32, bgra: buf })
    }
}

/// 64-bit perceptual hash: 48x32 gray sample -> 8x8 block means -> bit i = block i > mean (16 hex digits).
pub fn ahash(p: &Pixels) -> String {
    let (w, h) = (p.w as usize, p.h as usize);
    if w == 0 || h == 0 {
        return "0000000000000000".into();
    }
    let mut gray = [0u32; 48 * 32];
    for gy in 0..32 {
        for gx in 0..48 {
            let sx = ((gx * 2 + 1) * w / 96).min(w - 1);
            let sy = ((gy * 2 + 1) * h / 64).min(h - 1);
            let i = (sy * w + sx) * 4;
            let (b, g, r) = (p.bgra[i] as u32, p.bgra[i + 1] as u32, p.bgra[i + 2] as u32);
            gray[gy * 48 + gx] = (299 * r + 587 * g + 114 * b) / 1000;
        }
    }
    let mut means = [0u32; 64];
    for by in 0..8 {
        for bx in 0..8 {
            let mut s = 0;
            for y in 0..4 {
                for x in 0..6 {
                    s += gray[(by * 4 + y) * 48 + bx * 6 + x];
                }
            }
            means[by * 8 + bx] = s / 24;
        }
    }
    let avg: u32 = means.iter().sum::<u32>() / 64;
    let mut bits = 0u64;
    for (i, m) in means.iter().enumerate() {
        if *m > avg {
            bits |= 1u64 << i;
        }
    }
    format!("{:016x}", bits)
}

/// Downscale (box-nearest) + JPEG encode for the vision channel. Returns (jpeg_bytes, out_w, out_h).
pub fn to_jpeg(p: &Pixels, max_edge: u32, quality: u8) -> Result<(Vec<u8>, u32, u32), String> {
    let scale = (max_edge as f64 / p.w.max(p.h) as f64).min(1.0);
    let (ow, oh) = (((p.w as f64 * scale) as u32).max(1), ((p.h as f64 * scale) as u32).max(1));
    let mut rgb = Vec::with_capacity((ow * oh * 3) as usize);
    for y in 0..oh {
        let sy = (y as u64 * p.h as u64 / oh as u64) as usize;
        for x in 0..ow {
            let sx = (x as u64 * p.w as u64 / ow as u64) as usize;
            let i = (sy * p.w as usize + sx) * 4;
            rgb.push(p.bgra[i + 2]);
            rgb.push(p.bgra[i + 1]);
            rgb.push(p.bgra[i]);
        }
    }
    let mut out = Vec::new();
    let enc = jpeg_encoder::Encoder::new(&mut out, quality);
    enc.encode(&rgb, ow as u16, oh as u16, jpeg_encoder::ColorType::Rgb).map_err(|e| format!("JPEG:{e}"))?;
    Ok((out, ow, oh))
}

pub fn percentile(v: &mut Vec<f64>, p: f64) -> f64 {
    if v.is_empty() {
        return 0.0;
    }
    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
    let i = ((v.len() as f64 - 1.0) * p).round() as usize;
    v[i]
}
