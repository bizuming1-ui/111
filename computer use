        -KeyExportPolicy NonExportable -CertStoreLocation Cert:\LocalMachine\My -NotAfter (Get-Date).AddYears(5)
    Write-Host "已生成自签名代码签名证书 $($cert.Thumbprint)" -ForegroundColor Green
