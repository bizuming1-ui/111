"""Five-layer router. A PURE function of MEASURED inputs (no defaults that pretend a channel is up).
L0 native/CLI -> L1 CDP -> L2 UIA/JAB -> L3 DXGI vision (local) -> L4 flash SoM vision.
`uia_controls=None` is legal only before the first observation of a step (-> 'probe')."""
from __future__ import annotations

from dataclasses import dataclass

BROWSER_PROCS = {"chrome.exe", "msedge.exe", "brave.exe", "chromium.exe", "vivaldi.exe", "opera.exe"}


@dataclass(frozen=True)
class Route:
    layer: int
    name: str
    reason: str
    model: str  # "chat" (text) | "vision" (screenshot to the vision model)

    def as_dict(self) -> dict:
        return {"layer": self.layer, "name": self.name, "reason": self.reason, "model": self.model}


def route(
    task: str,
    *,
    cli_hit: bool,
    cdp_up: bool,
    fg_is_browser: bool,
    uia_controls: int | None,
    stalled: bool,
    blocked_streak: int,
    free_mem_mb: int | None,
    min_controls: int = 6,
) -> Route:
    low_mem = free_mem_mb is not None and free_mem_mb < 1536
    if cli_hit:
        return Route(0, "native", "deterministic native primitive matched the task intent", "chat")
    if uia_controls is None:
        return Route(2, "probe", "no measurement yet: observe first", "chat")
    escalate = stalled or blocked_streak >= 2
    if fg_is_browser and cdp_up and uia_controls > 0 and not escalate:
        return Route(1, "cdp", "foreground is a debuggable browser: AX+DOM fusion, trusted CDP input", "chat")
    if uia_controls >= min_controls and not escalate:
        return Route(2, "uia", f"{uia_controls} UIA controls >= {min_controls}", "chat")
    if low_mem:
        return Route(2, "uia-lowmem", f"free RAM {free_mem_mb} MB < 1536: screenshots disabled, staying on the text channel", "chat")
