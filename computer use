    // 6. LockBits 指针级 48x32 灰度指纹与 DirtyRects 增量估算（替代 PowerShell 1,536 次 GetPixel，耗时 < 2ms）
    public static byte[] FastPixelSig48x32(int l, int t, int w, int h) {
        if (w < 16 || h < 16) return null;
