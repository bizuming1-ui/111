            $o1 = @(Get-UiElements $tt.Parent | Where-Object { $_.Type -eq 'CheckBox' } | Select-Object -First 1)
            $tt.SetCheck(0); Start-Sleep -Milliseconds 120
            $o0 = @(Get-UiElements $tt.Parent | Where-Object { $_.Type -eq 'CheckBox' } | Select-Object -First 1)
            & $rec '观察：复选框状态由缓存一次读回（on / off）' ($o1.Count -gt 0 -and $o0.Count -gt 0 -and $o1[0].State -eq 'on' -and $o0[0].State -eq 'off') "勾选后=[$($o1[0].State)] 取消后=[$($o0[0].State)]"
            # A. UIA
            $script:Mode = 'Uia'
            $tt.SetCheck(0)
            $r0 = [DsNative4]::CursorPos()
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click'; id = $cid }) } catch { $msg = "异常: $($_.Exception.Message)" }
            $r1 = [DsNative4]::CursorPos()
            & $rec '第1层 UIA 点击（勾选复选框）并读回状态' ($tt.GetCheck() -eq 1 -and $r0[0] -eq $r1[0] -and $r0[1] -eq $r1[1] -and $msg -match '读回 on') $msg
            # A2. click_many
            $tt.SetCheck(0)
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click_many'; ids = @($cid) }) } catch { $msg = "异常: $($_.Exception.Message)" }
            & $rec 'click_many 批量点击' ($tt.GetCheck() -eq 1 -and $msg -match '已依次点击 1') $msg
            # A3. 坐标吸附
            $tt.SetCheck(0)
            $cx0 = $script:Elements[$cid].cx; $cy0 = $script:Elements[$cid].cy
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click'; x = $cx0; y = $cy0 }) } catch { $msg = "异常: $($_.Exception.Message)" }
            & $rec '坐标点击自动吸附到控件并走 UIA（Uia 模式下也成功）' ($tt.GetCheck() -eq 1 -and $msg -match 'UIA') $msg
            # A4. v4.2 幂等勾选：已勾选时 check 不动作；uncheck 读回 off
            $tt.SetCheck(1); Start-Sleep -Milliseconds 120
            $ck1 = $null; $ck2 = $null; $ckErr = ''
            try { $ck1 = Set-CheckState $script:Elements[$cid] $true '[自检复选框]'; $ck2 = Set-CheckState $script:Elements[$cid] $false '[自检复选框]' } catch { $ckErr = $_.Exception.Message }
            & $rec 'v4.2 幂等勾选（已勾选时 check 不操作；uncheck 后读回 off）' ($null -ne $ck1 -and -not $ck1.Changed -and $null -ne $ck2 -and $ck2.Ok -and $tt.GetCheck() -eq 0) ("check=[$(if ($ck1) { $ck1.Via })] uncheck=[$(if ($ck2) { "$($ck2.Via)/$($ck2.State)" })] $ckErr")
            # B. 写值
            $want = '你好 DeepSeek 123'
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'type'; id = $eid; text = $want; clear = $true }) } catch { $msg = "异常: $($_.Exception.Message)" }
            & $rec '第1层 UIA 写值并读回' ($tt.GetText() -eq $want) "读回=[$($tt.GetText())]"
            # C. 消息
            $script:Mode = 'Message'
            $tt.SetCheck(0)
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click'; id = $cid }) } catch { $msg = "异常: $($_.Exception.Message)" }
            $r2 = [DsNative4]::CursorPos()
            & $rec '第2层 窗口消息点击' ($tt.GetCheck() -eq 1 -and $r0[0] -eq $r2[0] -and $r0[1] -eq $r2[1]) $msg
            # D. 物理
            $script:Mode = 'Physical'
            $tt.SetCheck(0)
            Start-Sleep -Milliseconds ($IdleMs + 100)
            try { $msg = Invoke-Action ([pscustomobject]@{ action = 'click'; id = $cid }) } catch { $msg = "异常: $($_.Exception.Message)" }
            Start-Sleep -Milliseconds 100
            $r3 = [DsNative4]::CursorPos()
            & $rec '第3层 物理点击并归位真实鼠标' ($tt.GetCheck() -eq 1 -and $r0[0] -eq $r3[0] -and $r0[1] -eq $r3[1]) "$msg ；归位后 ($($r3[0]),$($r3[1]))"
        }
        # E. Schema
        $okId = if ($cid -gt 0) { $cid } else { 1 }
        $okEd = if ($eid -gt 0) { $eid } else { 1 }
        $s1 = Test-ActionSchema ([pscustomobject]@{ action = 'click' }) 1
        $s2 = Test-ActionSchema ([pscustomobject]@{ action = 'key'; keys = 'ctrl+foo' }) 1
        $s3 = Test-ActionSchema ([pscustomobject]@{ action = 'wait'; seconds = 1 }) 1
        $s4 = Test-ActionSchema ([pscustomobject]@{ action = 'done'; summary = 'x' }) 2
        $s5 = Test-ActionSchema ([pscustomobject]@{ action = 'rm_rf' }) 1
        $s6 = Test-ActionSchema ([pscustomobject]@{ action = 'click_many'; ids = @() }) 1
        $s7 = Test-ActionSchema ([pscustomobject]@{ action = 'click_many'; ids = @($okId) }) 1
        $s8 = Test-ActionSchema ([pscustomobject]@{ action = 'type'; text = 'x'; id = $okEd }) 2
        & $rec 'Schema：拒绝非法动作（含 done 排在批量后面）' ($s1 -and $s2 -and $s4 -and $s5 -and $s6 -and (-not $s3)) ("缺目标=[$s1] 非法键=[$s2] 批量中done=[$s4] 未知动作=[$s5]")
        & $rec 'Schema：批量中后续动作可以使用 id（v4 会误拒）、click_many 合法' ((-not $s7) -and (-not $s8)) "click_many=[$s7] 批量type id=[$s8]"
        # F. 过期控件
        $tt.Stop()
        Start-Sleep -Milliseconds 400
        $threw = $false; $why = ''
        if ($cid -gt 0) {
            try { [void](Resolve-Target ([pscustomobject]@{ id = $cid })) } catch { $threw = $true; $why = $_.Exception.Message }
        }
        & $rec '过期控件被拒绝（不会点到错误位置）' $threw $why
    }
    finally {
        $script:Mode = $savedMode
        try { $tt.Stop() } catch { }
    }
    return $rows
}
#endregion
#region ---------- 主流程 ----------
if ($ObserveOnly) {
    Write-Host '3 秒后读取前台窗口，请切换到你想观察的窗口...' -ForegroundColor Cyan
    Start-Sleep -Seconds 3
    $swatch = [System.Diagnostics.Stopwatch]::StartNew()
    (Get-Observation).Text
    Write-Host "（观察耗时 $([int]$swatch.ElapsedMilliseconds) ms）" -ForegroundColor DarkGray
    return
}
if ($SelfTest) {
    Initialize-Runtime
    try {
        $rows = Invoke-SelfTest
        $pass = @($rows | Where-Object { $_.Ok }).Count
        $total = @($rows).Count
        Write-Host ''
        $c = if ($pass -eq $total) { 'Green' } else { 'Yellow' }
        Write-Host "自检结果: $pass / $total 通过" -ForegroundColor $c
        if ($pass -ne $total) { Write-Host '失败项请截图 / 复制上面的输出，按「Detail」定位（常见原因：目标程序权限更高→加 -RunAsAdmin；你在自检时动了鼠标）。' -ForegroundColor Yellow }
    }
    finally { Stop-Runtime }
    return
}
if ([string]::IsNullOrWhiteSpace($ApiKey)) {
    $ApiKey = Read-Host '请输入 DeepSeek API Key（输入时不显示）' -MaskInput
}
if ([string]::IsNullOrWhiteSpace($ApiKey)) { throw '缺少 API Key：请设置环境变量 DEEPSEEK_API_KEY 或使用 -ApiKey 参数。' }
$ApiKey = $ApiKey.Trim()
$RunId = Get-Date -Format 'yyyyMMdd-HHmmss'
$script:RunDir = $null
$script:LogFile = $null
$script:TaskNo = 0
$candidates = @()
if (-not [string]::IsNullOrWhiteSpace($LogDir)) { $candidates += $LogDir }
else {
    if ($env:LOCALAPPDATA) { $candidates += (Join-Path $env:LOCALAPPDATA 'DeepSeekComputerUse\logs') }
    $candidates += (Join-Path ([System.IO.Path]::GetTempPath()) 'DeepSeekComputerUse\logs')
}
foreach ($root in $candidates) {
    try {
        $dir = Join-Path $root $RunId
        New-Item -ItemType Directory -Force -Path $dir | Out-Null
        $script:RunDir = $dir
        $script:LogFile = Join-Path $dir 'run.jsonl'
        break
    }
    catch { Write-Host "  无法使用日志目录 $root : $($_.Exception.Message)" -ForegroundColor DarkYellow }
}
if (-not $script:RunDir) { Write-Host '  警告：没有可写的日志目录，本次运行不写日志。' -ForegroundColor Yellow }
$script:Session = New-Object System.Collections.Generic.List[string]
$script:Stats = @{ done = 0; fail = 0; other = 0 }
function Show-Help {
    Write-Host ''
    Write-Host '可用命令（在「请输入任务」提示符下输入）:' -ForegroundColor Cyan
    Write-Host '  <任意文字>         作为新任务交给 DeepSeek 执行'
    Write-Host '  help               显示本帮助'
    Write-Host '  history            查看本会话已执行过的任务'
    Write-Host '  log                打印日志目录路径'
    Write-Host '  mode <名称>        切换输入模式：auto / uia / message / physical（当前: 见横幅）'
    Write-Host '  cls                清屏'
    Write-Host '  exit / quit / 退出  结束程序'
    Write-Host '执行任务期间的紧急停止（只终止当前任务，回到本提示符）:' -ForegroundColor Yellow
    Write-Host '  鼠标甩到屏幕左上角，或同时按 Ctrl+Alt+Q；Ctrl+C 则直接退出整个程序'
    Write-Host ''
}
function Show-Banner {
    Write-Host ''
    Write-Host '=== DeepSeek Computer Use v4.2（虚拟鼠标 + 分层精确执行 + 列表行模型 + 幂等勾选 + 数量联锁）===' -ForegroundColor Cyan
    Write-Host "模型    : $Model    每任务最大步数: $MaxSteps    批量动作上限: $MaxBatch"
    Write-Host "模式    : $(if ($DryRun) { '仅预演(DryRun)' } elseif ($script:Auto) { '全自动（无需确认）' } else { '逐步确认' })    Shell: $(if ($NoShell) { '禁止' } else { '允许' })    管理员: $(if ($script:IsAdmin) { '是' } else { '否（加 -RunAsAdmin 可操作高权限窗口）' })    会话记忆: $(if ($MemoryLimit -gt 0) { "最近 $MemoryLimit 个任务" } else { '关闭' })"
    Write-Host "输入    : $($script:Mode)（Auto=UIA→消息→物理借用归位）    虚拟鼠标: $(if ($script:Cur) { '已启用' } else { '未启用' })    让位阈值: ${IdleMs}ms"
    Write-Host "日志    : $(if ($script:RunDir) { $script:RunDir } else { '（未启用）' })"
    Write-Host '紧急停止: 鼠标甩到左上角 / Ctrl+Alt+Q（终止当前任务）；Ctrl+C（退出程序）' -ForegroundColor Yellow
    Write-Host '输入 help 查看命令，输入 exit 退出；首次使用建议先运行  -SelfTest  验证本机环境。' -ForegroundColor DarkGray
}
Initialize-Runtime
Show-Banner
Write-Log @{ type = 'session_start'; model = $Model; admin = $script:IsAdmin; mode = $script:Mode; overlay = [bool]$script:Cur; version = '4.2' }
$pending = $Task
try {
    while ($true) {
        if (-not [string]::IsNullOrWhiteSpace($pending)) {
            $current = $pending.Trim()
            $pending = $null
            Write-Host ''
            Write-Host "任务    : $current" -ForegroundColor White
        }
        else {
            Restore-Console
            Write-Host ''
            $line = Read-Host '请输入任务（help 帮助 / exit 退出）'
            if ($null -eq $line) { break }
            $current = $line.Trim()
            if ($current -eq '') { continue }
            switch -Regex ($current.ToLower()) {
                '^(exit|quit|q|退出|结束)$' { $current = $null }
                '^(help|\?|帮助)$' { Show-Help; $current = '' }
                '^(cls|clear|清屏)$' { Clear-Host; $current = '' }
                '^log$' { Write-Host "日志目录: $(if ($script:RunDir) { $script:RunDir } else { '（未启用）' })" -ForegroundColor DarkGray; $current = '' }
                '^mode\s+(auto|uia|message|physical)$' {
                    $script:Mode = (Get-Culture).TextInfo.ToTitleCase($Matches[1])
                    Write-Host "输入模式已切换为: $($script:Mode)" -ForegroundColor DarkGray
                    $current = ''
                }
                '^(history|历史)$' {
                    if ($script:Session.Count -eq 0) { Write-Host '（本会话还没有执行过任务）' -ForegroundColor DarkGray }
                    else { $script:Session | ForEach-Object { Write-Host "  $_" -ForegroundColor DarkGray } }
                    $current = ''
                }
            }
            if ($null -eq $current) { break }
            if ($current -eq '') { continue }
        }
        $script:TaskNo++
        Write-Host ''
        Write-Host "╭─ 任务 #$($script:TaskNo) ─────────────────────────" -ForegroundColor Cyan
        Reset-AbortState
        $res = Invoke-AgentTask $current
        switch ($res.Outcome) {
            'done' { $script:Stats.done++ }
            'fail' { $script:Stats.fail++ }
            default { $script:Stats.other++ }
        }
        $script:Session.Add("任务$($script:TaskNo): $(Limit-Text $current 100) → [$($res.Outcome)] $(Limit-Text $res.Summary 160)")
        while ($script:Session.Count -gt 50) { $script:Session.RemoveAt(0) }
        Write-Host "╰─ 任务 #$($script:TaskNo) 结束（$($res.Outcome)）──────────" -ForegroundColor Cyan
        if ($Once) { break }
    }
}
finally {
    Stop-Runtime
    $elapsed = [int]((Get-Date) - $script:Started).TotalSeconds
    Write-Host ''
    Write-Host "会话结束：共 $($script:TaskNo) 个任务（完成 $($script:Stats.done) / 失败 $($script:Stats.fail) / 其他 $($script:Stats.other)），总耗时 ${elapsed} 秒" -ForegroundColor DarkGray
    if ($script:RunDir) { Write-Host "日志目录: $($script:RunDir)" -ForegroundColor DarkGray }
    Write-Log @{ type = 'session_end'; tasks = $script:TaskNo }
}
#endregion
