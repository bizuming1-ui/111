Add-DscuFile 'agent_brain/input_guard.py' 'db616be4e4f2202a36e95b3316fc2d272da3ccbb4466f47361c5bcf9c08f2cb0' @'
"""v16 InputGuard - precise own-input attribution + mouse-jitter dead-zone + 1.5 s quiet auto-resume.

Why v15 deadlocked ([USER_ACTIVE] x10+ in task #8):
  * `user_active()` compared GetLastInputInfo() with a single `last_own_tick` that was refreshed ONLY by the cursor-move helper.
    Our own click / key / type / scroll SendInput calls (and UIA actions) were therefore attributed to "a human".
  * the in-flight mouse check used an 8 px tolerance - DPI rounding of the 0..65535 absolute mapping already exceeds that
    on scaled / multi-monitor desktops (task #7 coordinates reach x=2391).
  * once tripped there was no quiet-period logic: every subsequent action re-tripped immediately.

v16 model (pure logic, no ctypes -> unit-testable everywhere; the driver injects the Win32 probes):
  * every SendInput / UIA action registers an *own span* (start, end); an input event whose OS timestamp falls inside a span (+grace) is ours
  * a foreign event only counts when   (a) a key / mouse button is physically down, or  (b) the cursor moved > deadzone_px (default 15) from baseline
    -> sub-15px tremor/jitter is filtered (stats['jitter_filtered'])
  * a real foreign event arms `active_until = now + quiet_s` (1.5 s).  Past that instant the guard releases automatically.
  * `wait_quiet()` lets the driver wait up to `max_wait_s` for the human to stop instead of failing the step.
"""
from __future__ import annotations

import math
import time
from collections import Counter, deque
from typing import Any, Callable, Deque, Optional, Tuple

DEFAULT_DEADZONE_PX = 15
DEFAULT_OWN_GRACE_MS = 350
DEFAULT_QUIET_S = 1.5
DEFAULT_MAX_WAIT_S = 4.0


class InputGuard:
    def __init__(self, deadzone_px: int = DEFAULT_DEADZONE_PX, own_grace_ms: int = DEFAULT_OWN_GRACE_MS, quiet_s: float = DEFAULT_QUIET_S,
                 clock: Callable[[], float] = time.monotonic) -> None:
        self.deadzone_px = max(15, int(deadzone_px))  # spec: dead-zone >= 15 px
        self.own_grace_s = own_grace_ms / 1000.0
        self.quiet_s = float(quiet_s)
        self.clock = clock
        self.spans: Deque[Tuple[float, float]] = deque(maxlen=256)
        self.baseline: Optional[Tuple[int, int]] = None
        self.last_seen_tick: Optional[int] = None
        self.active_until = 0.0
        self.stats: Counter[str] = Counter()

    # ------------------------------------------------------------------ own-input bookkeeping
    def mark_own(self, xy: Optional[Tuple[int, int]] = None, *, start: Optional[float] = None, end: Optional[float] = None) -> None:
        """Register that WE generated input (call after every SendInput burst and after every UIA mutating action)."""
        now = self.clock()
        s = start if start is not None else now - 0.03
        e = end if end is not None else now
        self.spans.append((s, e))
        if xy is not None:
            self.baseline = (int(xy[0]), int(xy[1]))
        self.stats["own_marks"] += 1

    def set_baseline(self, xy: Tuple[int, int]) -> None:
        self.baseline = (int(xy[0]), int(xy[1]))

    def _is_own(self, event_t: float) -> bool:
        tol = 0.06
        for s, e in reversed(self.spans):
            if s - tol <= event_t <= e + self.own_grace_s:
                return True
        return False

    # ------------------------------------------------------------------ foreign-input detection
    def observe(self, last_input_tick: int, tick_now: int, cursor_xy: Tuple[int, int], pressed_any: bool = False, now: Optional[float] = None) -> bool:
        """Feed one probe sample (GetLastInputInfo.dwTime, GetTickCount, GetCursorPos, any key/button down). Returns True while a human is active."""
        now = self.clock() if now is None else now
        if self.baseline is None:
            self.baseline = (int(cursor_xy[0]), int(cursor_xy[1]))
        if last_input_tick != self.last_seen_tick:
            self.last_seen_tick = last_input_tick
            age_s = ((tick_now - last_input_tick) & 0xFFFFFFFF) / 1000.0
            event_t = now - age_s
            if self._is_own(event_t):
                self.stats["own_attributed"] += 1
                self.baseline = (int(cursor_xy[0]), int(cursor_xy[1]))
            else:
                moved = math.hypot(cursor_xy[0] - self.baseline[0], cursor_xy[1] - self.baseline[1])
                if pressed_any or moved > self.deadzone_px:
                    self.register_external(now, "key/button down" if pressed_any else f"cursor moved {moved:.0f}px")
                else:
                    self.stats["jitter_filtered"] += 1
        return now < self.active_until

    def register_external(self, now: Optional[float] = None, why: str = "") -> None:
        now = self.clock() if now is None else now
        self.active_until = now + self.quiet_s
        self.stats["external_events"] += 1
        self.last_reason = why

    last_reason: str = ""

    def active(self, now: Optional[float] = None) -> bool:
        now = self.clock() if now is None else now
        return now < self.active_until

    def wait_quiet(self, poll: Callable[[], bool], max_wait_s: float = DEFAULT_MAX_WAIT_S, sleep: Callable[[float], None] = time.sleep) -> bool:
        """Block (worker thread) until `poll()` is False. True = human stopped (>= quiet_s of silence), False = still active after max_wait_s."""
        t0 = self.clock()
        while poll():
            if self.clock() - t0 >= max_wait_s:
                self.stats["yield_timeouts"] += 1
                return False
            sleep(0.05)
        if self.clock() - t0 > 0.01:
            self.stats["auto_resumed"] += 1
        return True

    def snapshot(self) -> dict[str, Any]:
        return {"deadzone_px": self.deadzone_px, "quiet_s": self.quiet_s, "own_grace_ms": int(self.own_grace_s * 1000), **dict(self.stats)}


# ---------------------------------------------------------------------------------------------------------------------
# [OCCLUDED] blocker classification (pure -> unit-testable).  Used by py_native_driver.clear_occluders / ensure_visible_at.
SHELL_CLASSES = {"Progman", "WorkerW", "Shell_TrayWnd", "Shell_SecondaryTrayWnd", "NotifyIconOverflowWindow", "TopLevelWindowForOverflowXamlIsland"}


def classify_blocker(blocker: Optional[dict[str, Any]], target: dict[str, Any], extra_shell: Optional[set[str]] = None) -> str:
    """-> gone | same_app | own_console | shell | minimizable.
    same_app    : popup / menu / tooltip of the target's own process -> not an occluder, never touch it
    own_console : the agent's own terminal -> never minimized, the target is pinned HWND_TOPMOST for the duration of the action instead
    shell       : desktop / taskbar -> cannot be minimized
    minimizable : any other foreign window -> ShowWindow(SW_MINIMIZE) then re-verify visibility"""
    if not blocker:
        return "gone"
    if blocker.get("own_console"):
        return "own_console"
    if (blocker.get("class") or blocker.get("cls") or "") in (SHELL_CLASSES | (extra_shell or set())):
        return "shell"
    bp, tp = blocker.get("pid"), target.get("pid")
    if (bp and tp and bp == tp) or (blocker.get("process") and blocker.get("process") == target.get("process")):
        return "same_app"
    return "minimizable"
