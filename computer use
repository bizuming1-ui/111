def page() -> dict:
    return next(p for p in PAGES if p["sel"])


def page_by_id(pid):
    return next((p for p in PAGES if p["id"] == pid), page())


def title_of(p: dict) -> str:
    return STATE["title_override"].get(p["id"]) or (p["title"] or "")


def snapshot_text(p: dict) -> str:
    STATE["sid"] += 1
    s = STATE["sid"]
    u = p["url"]
    if "rows" in u or "index" in u:
        t = title_of(p) or "Inbox"
        return (f'uid={s}_0 RootWebArea "{t}" url="{u}"\n  uid={s}_1 heading "Inbox" level="1"\n  uid={s}_2 textbox "search box" focusable\n'
                f'  uid={s}_3 row "Mail one from alice"\n    uid={s}_4 checkbox "select r1" focusable\n    uid={s}_5 link "Mail one from alice" focusable url="{u}#r1"\n'
                f'  uid={s}_6 row "Mail two from bob"\n    uid={s}_7 checkbox "select r2" focusable\n    uid={s}_8 link "Mail two from bob" focusable url="{u}#r2"\n'
                f'  uid={s}_9 toolbar "actions"\n    uid={s}_10 button "Delete" focusable\n')
    if "canvas" in u:
        return f'uid={s}_0 RootWebArea "Canvas game" url="{u}"\n  uid={s}_1 canvas\n'
    if "blank" in u or "broken" in u:
        return f'uid={s}_0 RootWebArea "" url="{u}"\n'
    return f'uid={s}_0 RootWebArea "{title_of(p) or "Page"}" url="{u}"\n  uid={s}_1 link "Home" focusable url="{u}"\n  uid={s}_2 button "Go" focusable\n'


def uid_ok(uid: str) -> bool:
    return str(uid).startswith(f"{STATE['sid']}_")


def ok(text: str) -> dict:
    return {"content": [{"type": "text", "text": text}]}


def err(text: str) -> dict:
    return {"content": [{"type": "text", "text": text}], "isError": True}


def js_reply(v) -> dict:
    return ok("Script ran on page and returned:\n```json\n" + json.dumps(v) + "\n```")


def call(name: str, a: dict) -> dict:
    ch = STATE.get("child")
    if ch is not None and ch.poll() is not None:
        return err("Protocol error: Target closed (browser has disconnected)")
    if name == "list_pages":
        return ok("## Pages\n" + "\n".join(f"{x['id']}: {x['url']}{' [selected]' if x['sel'] else ''}" for x in PAGES))
    if name == "new_page":
        pass
    elif name == "close_page":
        if not any(x["id"] == a.get("pageId") for x in PAGES):
            return err("Error: No page found")
        PAGES[:] = [x for x in PAGES if x["id"] != a.get("pageId")]
        if PAGES and not any(x["sel"] for x in PAGES):
            pass  # like the real server: closing the selected page leaves NO selected page
        return ok("closed")
    elif name == "select_page":
        if not any(x["id"] == a.get("pageId") for x in PAGES):
            return err("Error: No page found")
    else:
        if a.get("pageId") is not None and not any(x["id"] == a.get("pageId") for x in PAGES):
            return err("Error: No page found")
        if not any(x["sel"] for x in PAGES) and a.get("pageId") is None:
            return err("Error: No page found")
        if not PAGES:
            return err("Error: No page found")
    p = (page_by_id(a.get("pageId")) if a.get("pageId") is not None else (page() if any(x["sel"] for x in PAGES) else None)) if PAGES else None
    if p is None and name not in ("new_page", "select_page"):
        p = PAGES[0] if PAGES else {"id": 0, "url": "about:blank", "title": "", "sel": False}
    if name == "list_pages":
        return ok("## Pages\n" + "\n".join(f"{x['id']}: {x['url']}{' [selected]' if x['sel'] else ''}" for x in PAGES))
    if name == "take_snapshot":
        return ok("## Latest page snapshot\n" + snapshot_text(p))
    if name in ("click", "hover", "fill", "upload_file"):
        if not uid_ok(a.get("uid", "")):
            return err("Could not find element with uid " + str(a.get("uid")) + " - take a new snapshot")
        if name == "fill":
            STATE["values"][a["uid"]] = a.get("value", "")
        if name == "click":
            STATE["clicks"].append(a["uid"])
            if a["uid"].endswith("_10"):
                STATE["title_override"][p["id"]] = "clicked"
            if a["uid"].endswith(("_4", "_7")):
