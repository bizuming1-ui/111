function Confirm-ActionConsole([string]$desc) {
    Write-Host "  即将执行: $desc" -ForegroundColor Yellow
    $ans = Read-Host '  确认? [Enter=执行 / n=跳过 / a=之后全部自动 / q=退出当前任务]'
    switch ("$ans".Trim().ToLower()) {
        '' { return 'y' }
        'y' { return 'y' }
        'n' { return 'n' }
        'a' { return 'a' }
        'q' { return 'q' }
        default { return 'n' }
    }
}
function Confirm-ActionDialog([string]$desc) {
    [System.Windows.Forms.Application]::EnableVisualStyles()
    $form = New-Object System.Windows.Forms.Form
    try {
        $form.Text = 'DeepSeek Computer Use - 操作确认'
        $form.TopMost = $true
        $form.ShowInTaskbar = $true
        $form.FormBorderStyle = 'FixedDialog'
        $form.MaximizeBox = $false
        $form.MinimizeBox = $false
        $form.AutoScaleDimensions = New-Object System.Drawing.SizeF(96, 96)
        $form.AutoScaleMode = 'Dpi'
        $form.ClientSize = New-Object System.Drawing.Size(540, 170)
        $form.Font = New-Object System.Drawing.Font('Microsoft YaHei UI', 9.5)
        $form.StartPosition = 'Manual'
        $wa = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea
        $form.Location = New-Object System.Drawing.Point(([Math]::Max(0, $wa.Right - $form.Width - 20)), ([Math]::Max(0, $wa.Bottom - $form.Height - 20)))
        $lbl = New-Object System.Windows.Forms.Label
        $lbl.Text = "即将执行:`r`n$desc"
        $lbl.Location = New-Object System.Drawing.Point(14, 12)
        $lbl.Size = New-Object System.Drawing.Size(512, 100)
        $form.Controls.Add($lbl)
        $defs = @(
            @{ Text = '执行 (Enter)'; Result = [System.Windows.Forms.DialogResult]::Yes },
            @{ Text = '跳过 (Esc)'; Result = [System.Windows.Forms.DialogResult]::No },
            @{ Text = '之后全自动'; Result = [System.Windows.Forms.DialogResult]::Ignore },
            @{ Text = '退出任务'; Result = [System.Windows.Forms.DialogResult]::Abort }
        )
        $x = 14
        foreach ($d in $defs) {
            $b = New-Object System.Windows.Forms.Button
            $b.Text = $d.Text
            $b.DialogResult = $d.Result
            $b.Location = New-Object System.Drawing.Point($x, 122)
            $b.Size = New-Object System.Drawing.Size(121, 34)
            $form.Controls.Add($b)
            if ($d.Result -eq [System.Windows.Forms.DialogResult]::Yes) { $form.AcceptButton = $b }
            if ($d.Result -eq [System.Windows.Forms.DialogResult]::No) { $form.CancelButton = $b }
            $x += 128
        }
        $res = $form.ShowDialog()
    }
    finally { $form.Dispose() }
    Start-Sleep -Milliseconds 250
    switch ($res) {
        ([System.Windows.Forms.DialogResult]::Yes) { return 'y' }
        ([System.Windows.Forms.DialogResult]::Ignore) { return 'a' }
        ([System.Windows.Forms.DialogResult]::Abort) { return 'q' }
        default { return 'n' }
    }
}
function Confirm-Action([string]$desc) {
    if ($script:Auto) { return 'y' }
    if ($ConsoleConfirm) { $ans = Confirm-ActionConsole $desc }
    else {
        try { $ans = Confirm-ActionDialog $desc }
        catch {
            Write-Host "  弹窗失败，改用控制台确认: $($_.Exception.Message)" -ForegroundColor DarkYellow
            $ans = Confirm-ActionConsole $desc
        }
    }
    if ($ans -eq 'a') { $script:Auto = $true; return 'y' }
    return $ans
}
