    return 0
}
function Get-V12WindowFp($W) {
    $fp = [pscustomobject]@{ Handle = $W.Handle; Title = "$($W.Title)"; Process = "$($W.Process)"; Class = ''; Visible = $true; Owned = $false; Tool = $false; Iconic = $false; Area = 0; Edit = 0 }
