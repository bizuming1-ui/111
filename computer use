function Find-BrowserExe([string]$Hint = '') {
    $h = "$Hint".ToLower()
    $want = if ($h -match 'edge') { @('msedge.exe', 'chrome.exe', 'brave.exe') } elseif ($h -match 'brave') { @('brave.exe', 'chrome.exe', 'msedge.exe') } else { @('chrome.exe', 'msedge.exe', 'brave.exe') }
    $dirs = @{
        'chrome.exe' = @("$env:ProgramFiles\Google\Chrome\Application", "${env:ProgramFiles(x86)}\Google\Chrome\Application", "$env:LOCALAPPDATA\Google\Chrome\Application")
        'msedge.exe' = @("${env:ProgramFiles(x86)}\Microsoft\Edge\Application", "$env:ProgramFiles\Microsoft\Edge\Application")
        'brave.exe'  = @("$env:ProgramFiles\BraveSoftware\Brave-Browser\Application", "$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\Application")
    }
    foreach ($exe in $want) {
        foreach ($hive in 'HKCU', 'HKLM') {
            try {
                $k = Get-Item -LiteralPath "${hive}:\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\$exe" -ErrorAction Stop
                $p = [string]$k.GetValue('')
                if ($p -and (Test-Path -LiteralPath $p)) { return $p }
            }
            catch { }
        }
        foreach ($d in $dirs[$exe]) { $p = Join-Path $d $exe; if ($d -and (Test-Path -LiteralPath $p)) { return $p } }
    }
    return $null
}
function Invoke-CdpTakeover([string]$Reason, [string]$Url = '', [string]$Hint = '') {
    # 强制接管：不允许静默降级为「盲人 UIA」。已有附着实例 → 复用并置顶；否则拉起独立 --user-data-dir + --remote-debugging-port 实例，SetForegroundWindow 置顶，并附着 CDP
    $res = [pscustomobject]@{ Attached = $false; Reused = $false; Port = 0; Profile = ''; Hwnd = [IntPtr]::Zero; Note = ''; Reason = $Reason }
    if (-not (Test-CdpEnabled)) { $res.Note = 'CDP 已关闭（-NoCdp）或输入模式不支持'; return $res }
    if (-not (Initialize-CdpEngine)) { $res.Note = 'CDP 引擎不可用'; return $res }
    $port = [int]$script:CdpState.Port
    if ($port -gt 0 -and $script:Cdp -and $script:Cdp.Connected -and (Test-CdpEndpoint $port 600)) {
        $res.Reused = $true; $res.Attached = $true; $res.Port = $port
        $root = $script:CdpState.Root
        if ($root -and $root -ne [IntPtr]::Zero) { [void][DsNative61]::Activate($root); $script:ObsHwnd = $root; $res.Hwnd = $root }
        return $res
    }
    $exe = Find-BrowserExe $Hint
    if (-not $exe) { $res.Note = '未找到 Chrome / Edge / Brave 可执行文件'; return $res }
    $known = Get-TopHandles
    $la = Start-CdpBrowser $exe $(if ($Url) { $Url } else { 'about:blank' })
    $res.Port = [int]$la.Port; $res.Profile = "$($la.Profile)"
    if (-not (Wait-CdpEndpoint ([int]$la.Port) 12000)) { $res.Note = "调试端口 $($la.Port) 12 秒内未就绪（浏览器可能被策略禁用远程调试）"; return $res }
    $h = [IntPtr]::Zero; $pn = ''
    $end = (Get-Date).AddSeconds(6)
    while ((Get-Date) -lt $end -and $h -eq [IntPtr]::Zero) {
        Test-Abort
        foreach ($line in [DsNative61]::TopWindows([uint32]$PID, 100)) {
            $hs = $line.Split('|', 3)[0]
            if ($known.Contains($hs)) { continue }
            $cand = [IntPtr][int64]$hs; $p2 = ''
            try { $p2 = (Get-Process -Id ([int][DsNative61]::WinPid($cand)) -ErrorAction Stop).ProcessName.ToLower() } catch { }
            if ($script:ChromiumNames -contains $p2) { $h = $cand; $pn = $p2; break }
        }
        if ($h -eq [IntPtr]::Zero) { Start-Sleep -Milliseconds 150 }
    }
    if ($h -ne [IntPtr]::Zero) {
        [void][DsNative61]::Activate($h); $script:ObsHwnd = $h; $res.Hwnd = $h
        $fg = [pscustomobject]@{ Handle = $h; Title = [DsNative61]::WinText($h); Process = $pn }
        for ($i = 0; $i -lt 5 -and -not $res.Attached; $i++) {
            try { if (Connect-CdpTarget $fg -Force) { $res.Attached = $true } } catch { }
            if (-not $res.Attached) { Start-Sleep -Milliseconds 250; $fg.Title = [DsNative61]::WinText($h) }
        }
    }
    else { $res.Note = '调试端口已就绪但没找到新的浏览器窗口' }
    if ($res.Attached) { $script:P71Stats.Takeovers++; $script:CdpRetryAfter = 0 }
    elseif (-not $res.Note) { $res.Note = 'CDP 目标附着失败' }
    return $res
}
function Invoke-CdpGuardian {
    # 每步一次：前台是 Chromium 浏览器、但没有可用的 CDP 调试端口（盲人 UIA）→ 立刻接管；最多 2 次 / 任务
    if ($env:DSCU_NO_CDP_TAKEOVER -or -not (Test-CdpEnabled)) { return '' }
    $fg = $null
    try { $fg = Get-ForegroundInfo } catch { return '' }
    if ($null -eq $fg -or $script:ChromiumNames -notcontains "$($fg.Process)".ToLower()) { return '' }
    if (Test-CdpForeground) { return '' }
    if ((Resolve-CdpPort $fg) -gt 0) { return '' }
    if ([int]$script:CdpTakeoverTries -ge 2) { return '' }
    $script:CdpTakeoverTries++
    $tk = Invoke-CdpTakeover 'blind-uia-guard' '' "$($fg.Process)"
    if ($tk -and $tk.Attached) { return "🌐 CDP 强制接管：前台 $($fg.Process) 未开启 --remote-debugging-port（只能盲人 UIA），已拉起独立 Profile + 调试端口 $($tk.Port) 的实例并置顶聚焦。浏览器导航请直接用 cdp_navigate（Page.navigate），不要再点地址栏 + 键盘敲 URL。" }
    return "⚠ CDP 接管失败（$($tk.Note)）：本步仍回退 UIA；页面若反复无变化会由「语义停滞检测」升级为视觉。"
}

# ---------- cdp_navigate / cdp_wait_selector ----------
function ConvertTo-NavUrl([string]$Raw) {
    $u = "$Raw".Trim().Trim('"').Trim("'")
    if ($u -eq '') { throw 'cdp_navigate 需要 url' }
    if ($u -match '^(?i)(javascript|data|file|vbscript|blob|ftp|chrome-extension|view-source|ws|wss):') { throw (New-SecError 'SECURITY_EXEC_VIOLATION' "cdp_navigate 禁止 $($Matches[1]): 协议（只允许 http / https / about:blank）。") }
    if ($u -eq 'about:blank') { return $u }
    if ($u -notmatch '^(?i)https?://') {
        if ($u -match '^//') { $u = 'https:' + $u }
        elseif ($u -match '^(?i)(localhost|(?:[a-z0-9\-]+\.)+[a-z]{2,}|\d{1,3}(?:\.\d{1,3}){3})(?::\d+)?([/?#].*)?$') { $u = 'https://' + $u }
        else { throw "cdp_navigate 的 url「$(Limit-Text $u 80)」不是合法网址（需要 http(s)://… 或域名）" }
    }
    $uri = $null
    try { $uri = [System.Uri]::new($u) } catch { throw "cdp_navigate 的 url 无法解析: $(Limit-Text $u 80)" }
    if ($uri.Scheme -notin 'http', 'https') { throw (New-SecError 'SECURITY_EXEC_VIOLATION' "cdp_navigate 只允许 http / https（收到 $($uri.Scheme)）。") }
    return $uri.AbsoluteUri
}
function Assert-CdpNavigatePolicy($a) {
    $u = ConvertTo-NavUrl "$($a.url)"
    if ($u -eq 'about:blank') { return }
    $h = ([System.Uri]$u).Host
    if ($script:Taint.TaskInjection -and -not (Test-DomainTrusted $h)) {
        $script:SecStats.TaintBlocked++
        Write-SecEvent 'SECURITY_TAINT_BLOCKED' "cdp_navigate host=$h"
        throw (New-SecError 'SECURITY_TAINT_BLOCKED' "本任务已检测到间接提示词注入：禁止导航到不在任务原文里的域名（$h）。")
    }
    Write-SecEvent 'CDP_NAVIGATE' "host=$h tainted=$($script:Taint.Tainted)"
}
function Invoke-CdpNavigate($a) {
    $url = ConvertTo-NavUrl "$($a.url)"
    if (-not (Test-CdpEnabled)) { throw '[CDP_UNAVAILABLE] CDP 已关闭（-NoCdp）或输入模式不支持；请改用 {"action":"launch","target":"https://…"}。' }
    if (-not (Initialize-CdpEngine)) { throw '[CDP_UNAVAILABLE] CDP 引擎初始化失败；请改用 launch 带网址。' }
    $note = ''
    $c = $script:Cdp
    $port = [int]$script:CdpState.Port
    $alive = ($c -and $c.Connected -and $port -gt 0 -and (Test-CdpEndpoint $port 600))
    if (-not $alive) {
        $tk = Invoke-CdpTakeover 'cdp_navigate' '' ''
        if (-not $tk -or -not $tk.Attached) { throw "[CDP_UNAVAILABLE] 无法接管浏览器（$(if ($tk) { $tk.Note } else { '未知' })）；请改用 launch chrome 后再试。" }
        $note = "；已自动拉起 CDP 隔离浏览器（端口 $($tk.Port)）并置顶聚焦"
    }
    else {
        $root = $script:CdpState.Root
        if ($root -and $root -ne [IntPtr]::Zero -and [DsNative61]::Root([DsNative61]::GetForegroundWindow()) -ne $root) { [void][DsNative61]::Activate($root); $script:ObsHwnd = $root; $note = '；已把 CDP 浏览器窗口置顶' }
    }
    $r = Invoke-CdpMethod 'Page.navigate' @{ url = $url } 15000
    if ($r -and $r.errorText) { throw "[NAV_FAILED] Page.navigate 失败: $($r.errorText)（URL=$(Limit-Text $url 100)）" }
    $settled = $false
    try { $settled = [bool](Wait-CdpSettled -TimeoutMs 6000) } catch { if ("$($_.Exception.Message)" -like '触发保护*') { throw } }
    $info = $null
    try { $e = Invoke-CdpMethod 'Runtime.evaluate' @{ expression = '({u:location.href,t:document.title,s:document.readyState})'; returnByValue = $true } 4000; $info = $e.result.value } catch { }
    $script:P71Stats.CdpNavigate++
    $fin = if ($info) { "$($info.u)" } else { $url }
    $jump = ''
    try { if ($info -and ([System.Uri]$fin).Host -ne ([System.Uri]$url).Host) { $jump = "；⚠ 发生跨域跳转（$(([System.Uri]$url).Host) → $(([System.Uri]$fin).Host)），请确认是不是登录墙 / 验证页" } } catch { }
    return "已通过 CDP Page.navigate 直达 $(Limit-Text $url 100)；当前 URL=$(Limit-Text $fin 120)；标题「$(Limit-Text $(if ($info) { "$($info.t)" } else { '' }) 60)」；readyState=$(if ($info) { $info.s } else { '?' })；$(if ($settled) { '页面已稳定（readyState=complete 且无在途请求）' } else { '页面仍在加载，请下一轮观察确认' })$jump$note"
}
$script:CdpWaitSelectorJs = @'
(()=>{const SEL=__SEL__,TXT=__TXT__,VIS=__VIS__;
function* roots(r,d){yield r;if(d>6)return;let all;try{all=r.querySelectorAll('*')}catch(_){return}
for(const e of all){if(e.shadowRoot)yield* roots(e.shadowRoot,d+1);if(e.tagName==='IFRAME'||e.tagName==='FRAME'){try{if(e.contentDocument)yield* roots(e.contentDocument,d+1)}catch(_){}}}}
let n=0;
for(const r of roots(document,0)){let list=[];try{list=SEL?r.querySelectorAll(SEL):r.querySelectorAll('*')}catch(_){return {ok:false,err:'bad selector'}}
for(const el of list){const t=(el.innerText||el.textContent||'');if(TXT&&t.indexOf(TXT)<0)continue;
if(!SEL&&TXT&&el.children&&el.children.length>0&&Array.from(el.children).some(c=>(c.innerText||c.textContent||'').indexOf(TXT)>=0))continue;
const b=el.getBoundingClientRect();const cs=getComputedStyle(el);
const vis=b.width>0&&b.height>0&&cs.visibility!=='hidden'&&cs.display!=='none';
n++;if(VIS&&!vis)continue;
return {ok:true,tag:el.tagName,text:t.replace(/\s+/g,' ').slice(0,80),x:Math.round(b.x+b.width/2),y:Math.round(b.y+b.height/2),count:n}}}
return {ok:false,count:n}})()
'@
function Invoke-CdpWaitSelector($a) {
    if (-not (Test-CdpEnabled) -or -not (Initialize-CdpEngine)) { throw '[CDP_UNAVAILABLE] CDP 不可用；改用 wait + inspect / ocr。' }
    if (-not ($script:Cdp -and $script:Cdp.Connected)) { throw '[CDP_UNAVAILABLE] 当前没有已附着的 CDP 页面；先用 cdp_navigate（会自动接管浏览器）。' }
    $sel = "$($a.selector)"
    $txt = "$($a.text)"
    $to = 8000
    if (Test-NumValue $a.timeout) { $to = [int][double]"$($a.timeout)"; if ($to -le 60) { $to = $to * 1000 } }   # 兼容模型写秒
    $to = [Math]::Min([Math]::Max($to, 300), 30000)
    $vis = if ($null -ne $a.visible -and "$($a.visible)" -ne '') { [bool](Test-True $a.visible) } else { $true }
    $js = $script:CdpWaitSelectorJs.Replace('__SEL__', ($sel | ConvertTo-Json -Compress)).Replace('__TXT__', ($txt | ConvertTo-Json -Compress)).Replace('__VIS__', $(if ($vis) { 'true' } else { 'false' }))
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $last = $null
    while ($true) {
        Test-Abort
        try {
            $e = Invoke-CdpMethod 'Runtime.evaluate' @{ expression = $js; returnByValue = $true } 3000
            $v = $e.result.value
            if ($v -and $v.err) { throw "选择器语法错误: $(Limit-Text $sel 80)" }
            if ($v -and $v.ok) {
                $script:P71Stats.WaitSelector++
                return "元素已出现：<$($v.tag.ToLower())> 「$(Limit-Text "$($v.text)" 50)」视口中心(CSS px) ($($v.x),$($v.y))；用时 $($sw.ElapsedMilliseconds)ms（selector=$(Limit-Text $sel 60)$(if ($txt) { " text=$(Limit-Text $txt 30)" })；已穿透 Shadow DOM / 同源 iframe）"
            }
            $last = $v
        }
        catch { if ("$($_.Exception.Message)" -like '选择器语法错误*') { throw }; $last = $null }
        if ($sw.ElapsedMilliseconds -ge $to) { break }
        Start-Sleep -Milliseconds 150
    }
    $script:P71Stats.WaitSelector++
    return "❌ 等待超时（$to ms）：selector=$(Limit-Text $sel 60)$(if ($txt) { " text=$(Limit-Text $txt 30)" }) 未出现$(if ($last -and $last.count) { "（有 $($last.count) 个匹配但不可见）" })。页面可能是 404 /「内容不存在」/ 登录墙 / 需要滚动；请 vision_inspect 或换选择器，不要原样重试。"
}

# ---------- file_stat / dir_list：只读、Path Jail 约束、仅返回元数据 ----------
function Expand-StatAlias([string]$Raw) {
    $p = "$Raw".Trim().Trim('"').Trim("'")
    $parts = $p -split '[\\/]', 2
    $seg = ($parts[0] -replace '^[\{\$~%]+', '' -replace '[\}%]+$', '' -replace '^env:', '').Trim().ToLower()
    $map = @{ '桌面' = 'Desktop'; 'desktop' = 'Desktop'; '文档' = 'MyDocuments'; '我的文档' = 'MyDocuments'; 'documents' = 'MyDocuments'; 'mydocuments' = 'MyDocuments'; '图片' = 'MyPictures'; 'pictures' = 'MyPictures'; '视频' = 'MyVideos'; 'videos' = 'MyVideos'; '音乐' = 'MyMusic'; 'music' = 'MyMusic'; '下载' = 'Downloads'; 'downloads' = 'Downloads'; '工作区' = 'WS'; 'workspace' = 'WS'; 'ws' = 'WS' }
    if (-not $map.ContainsKey($seg)) { return $p }
    $base = $null
    switch ($map[$seg]) {
        'WS' { $base = [string]$script:WorkspaceRoot }
        'Downloads' { $up = [Environment]::GetEnvironmentVariable('USERPROFILE'); if ($up) { $base = Join-Path $up 'Downloads' } }
        default { try { $base = [Environment]::GetFolderPath($map[$seg]) } catch { $base = $null } }
    }
    if ([string]::IsNullOrWhiteSpace($base)) { return $p }
    if ($parts.Count -gt 1 -and $parts[1]) { return ($base.TrimEnd('\', '/') + '\' + $parts[1].TrimStart('\', '/')) }   # 纯字符串拼接：Windows 路径语义，与平台无关
    return $base
}
function Get-StatRoots {
    $roots = [System.Collections.Generic.List[string]]::new()
    if ($script:WorkspaceRoot) { $roots.Add([string]$script:WorkspaceRoot) }
    foreach ($sf in 'Desktop', 'MyDocuments', 'MyPictures', 'MyVideos', 'MyMusic') {
        try { $p = [Environment]::GetFolderPath($sf); if ($p -and -not $roots.Contains($p)) { $roots.Add($p) } } catch { }
    }
    $up = [Environment]::GetEnvironmentVariable('USERPROFILE')
    if ($up) { $dl = Join-Path $up 'Downloads'; if (-not $roots.Contains($dl)) { $roots.Add($dl) } }
    return @($roots)
}
function Assert-StatJail([string]$Path, [switch]$Wildcard) {
    # 复用 Test-SafePath（规范化 / 保留名 / ADS / 8.3 / ReparsePoint / FinalPath）逐个检查「只读白名单根」：工作区 + 桌面 / 文档 / 图片 / 视频 / 音乐 / 下载；任何敏感目录（.ssh / AppData / 系统目录）都在这些根之外 → 拒绝
    if (-not $script:SafeOn) { return [System.IO.Path]::GetFullPath([Environment]::ExpandEnvironmentVariables($Path)) }
    foreach ($root in (Get-StatRoots)) {
        $r = Test-SafePath -Path $Path -Operation 'read' -Root $root -AllowWildcard:$Wildcard
        if ($r.Ok) { return $r.Path }
    }
    return (Assert-SafePath -Path $Path -Operation 'read' -AllowWildcard:$Wildcard)   # 统一抛 SECURITY_PATH_VIOLATION（含 SecEvent 计数）
}
function Resolve-StatTarget($a, [string]$kind) {
    $raw = "$($a.path)"
    if ([string]::IsNullOrWhiteSpace($raw)) { throw "$kind 需要 path" }
    $p = Expand-StatAlias $raw
    $tp = $p.TrimEnd('\', '/'); $ix = [Math]::Max($tp.LastIndexOf('\'), $tp.LastIndexOf('/'))   # 手工切分（Windows 语义，与运行平台无关；[IO.Path] 在非 Windows 上不认反斜杠）
    $leaf = if ($ix -ge 0) { $tp.Substring($ix + 1) } else { $tp }
    $dirPart = if ($ix -gt 0) { $tp.Substring(0, $ix) } else { '' }
    if ($p -match '[*?]') {
        if ($dirPart -match '[*?]') { throw "$kind 的通配符只能出现在最后一级文件名里" }
        $dir = Assert-StatJail $(if ($dirPart) { $dirPart } else { '.' })
        return [pscustomobject]@{ Kind = $kind; Dir = $dir; Pattern = $leaf; Path = $null }
    }
    $full = Assert-StatJail $p
    return [pscustomobject]@{ Kind = $kind; Dir = $null; Pattern = $null; Path = $full }
}
function Get-FileEncodingInfo([byte[]]$Bytes, [bool]$Truncated = $false) {
    $n = $Bytes.Length
    $mk = { param($name, $skip, $enc) [pscustomobject]@{ Name = $name; Skip = $skip; Enc = $enc } }
    if ($n -ge 4 -and $Bytes[0] -eq 0xFF -and $Bytes[1] -eq 0xFE -and $Bytes[2] -eq 0 -and $Bytes[3] -eq 0) { return (& $mk 'UTF-32 LE (BOM)' 4 ([System.Text.UTF32Encoding]::new($false, $false))) }
    if ($n -ge 4 -and $Bytes[0] -eq 0 -and $Bytes[1] -eq 0 -and $Bytes[2] -eq 0xFE -and $Bytes[3] -eq 0xFF) { return (& $mk 'UTF-32 BE (BOM)' 4 ([System.Text.UTF32Encoding]::new($true, $false))) }
    if ($n -ge 3 -and $Bytes[0] -eq 0xEF -and $Bytes[1] -eq 0xBB -and $Bytes[2] -eq 0xBF) { return (& $mk 'UTF-8 (带 BOM)' 3 ([System.Text.UTF8Encoding]::new($false))) }
    if ($n -ge 2 -and $Bytes[0] -eq 0xFF -and $Bytes[1] -eq 0xFE) { return (& $mk 'UTF-16 LE (BOM)' 2 ([System.Text.UnicodeEncoding]::new($false, $false))) }
    if ($n -ge 2 -and $Bytes[0] -eq 0xFE -and $Bytes[1] -eq 0xFF) { return (& $mk 'UTF-16 BE (BOM)' 2 ([System.Text.UnicodeEncoding]::new($true, $false))) }
    $ascii = $true
    foreach ($b in $Bytes) { if ($b -ge 0x80) { $ascii = $false; break } }
    if ($ascii) { return (& $mk 'ASCII（与 UTF-8 兼容）' 0 ([System.Text.UTF8Encoding]::new($false))) }
    $chk = if ($Truncated -and $n -gt 4) { $Bytes[0..($n - 4)] } else { $Bytes }
    try { [void][System.Text.UTF8Encoding]::new($false, $true).GetString($chk); return (& $mk 'UTF-8 (无 BOM)' 0 ([System.Text.UTF8Encoding]::new($false))) } catch { }
    foreach ($cp in 54936, 936) { try { $e = [System.Text.Encoding]::GetEncoding($cp); return (& $mk "ANSI/GBK（推测，codepage $cp）" 0 $e) } catch { } }
    return (& $mk '未知（非 UTF-8，按 Latin1 读取）' 0 ([System.Text.Encoding]::Latin1))
}
function Format-StatTime($d) { return ([datetime]$d).ToString('yyyy-MM-dd HH:mm:ss') }
function Invoke-FileStat($a) {
    $t = Resolve-StatTarget $a 'file_stat'
    $script:P71Stats.FileStat++
    $files = @()
    $how = ''
    if ($t.Pattern) { $files = @(Get-ChildItem -LiteralPath $t.Dir -Filter $t.Pattern -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending); $how = "通配 $($t.Pattern)" }
    elseif ([System.IO.File]::Exists($t.Path)) { $files = @(Get-Item -LiteralPath $t.Path -ErrorAction SilentlyContinue); $how = '精确匹配' }
    elseif ([System.IO.Directory]::Exists($t.Path)) { return "file_stat: 「$($t.Path)」是目录，请用 dir_list。" }
    else {
        $dir = [System.IO.Path]::GetDirectoryName($t.Path); $leaf = [System.IO.Path]::GetFileName($t.Path)
        if ($dir -and [System.IO.Directory]::Exists($dir)) {
            $files = @(Get-ChildItem -LiteralPath $dir -Filter ($leaf + '.*') -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
            if ($files.Count -gt 0) { $how = "按「名称.*」匹配（记事本等程序会自动补扩展名）" }
        }
    }
    if ($files.Count -eq 0) {
        $near = ''
        try {
            $dir = if ($t.Dir) { $t.Dir } else { [System.IO.Path]::GetDirectoryName($t.Path) }
            if ($dir -and [System.IO.Directory]::Exists($dir)) {
                $stem = if ($t.Pattern) { ($t.Pattern -replace '[*?]', '') } else { [System.IO.Path]::GetFileNameWithoutExtension($t.Path) }
                if ($stem.Length -ge 3) {
                    $nn = @(Get-ChildItem -LiteralPath $dir -File -ErrorAction SilentlyContinue | Where-Object { $_.Name.ToLower().Contains($stem.Substring(0, [Math]::Min(6, $stem.Length)).ToLower()) } | Select-Object -First 5 | ForEach-Object { $_.Name })
                    if ($nn.Count -gt 0) { $near = "；同目录名称相近的文件: " + ($nn -join ' | ') }
                }
            }
        } catch { }
        return "file_stat: ❌ 不存在 — $(Limit-Text $(if ($t.Pattern) { Join-Path $t.Dir $t.Pattern } else { $t.Path }) 160)$near"
    }
    $f = $files[0]
    $max = 65536
    $bytes = [byte[]]@(); $trunc = $false; $lenRead = 0
    $fs = $null
    try {
        $fs = [System.IO.File]::Open($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete)
        $buf = [byte[]]::new([int][Math]::Min([long]$max, $fs.Length))
        $lenRead = $fs.Read($buf, 0, $buf.Length); $bytes = $buf[0..([Math]::Max(0, $lenRead - 1))]
        if ($lenRead -le 0) { $bytes = [byte[]]@() }
        $trunc = ($fs.Length -gt $max)
    }
    catch { return "file_stat: 存在但无法读取元数据 — $($f.FullName)（$(Limit-Text $_.Exception.Message 80)）" }
    finally { if ($fs) { $fs.Dispose() } }
    $enc = Get-FileEncodingInfo $bytes $trunc
    $sb = [System.Text.StringBuilder]::new()
    [void]$sb.Append("file_stat: ✅ 存在（$how）— 名称=$($f.Name) | 大小=$($f.Length) 字节 | 编码=$($enc.Name) | 修改时间=$(Format-StatTime $f.LastWriteTime) | 路径=$($f.FullName)")
    if ($files.Count -gt 1) { [void]$sb.Append("；另有 $($files.Count - 1) 个匹配: " + (($files | Select-Object -Skip 1 -First 4 | ForEach-Object { $_.Name }) -join ' | ')) }
    $exp = @()
    if ($null -ne $a.expect_text -and "$($a.expect_text)" -ne '') { $exp = @($a.expect_text | ForEach-Object { "$_" }) }
    if ($exp.Count -gt 0) {
        if ($trunc -or $f.Length -gt 2MB) { [void]$sb.Append("；内容校验：文件较大，仅检查了前 64KB") }
        $text = ''
        try { $text = $enc.Enc.GetString($bytes, [int]$enc.Skip, [int]($bytes.Length - $enc.Skip)) } catch { }
        $flat = ($text -replace '\s+', '')
        foreach ($x in $exp) {
            $hit = $text.Contains($x) -or $flat.Contains(($x -replace '\s+', ''))
            [void]$sb.Append("；内容包含「$(Limit-Text $x 40)」= $(if ($hit) { '是 ✓' } else { '否 ✗' })")
        }
        [void]$sb.Append("（只返回布尔值，不回显文件内容）")
    }
    if (-not $trunc) { try { $txt2 = $enc.Enc.GetString($bytes, [int]$enc.Skip, [int]($bytes.Length - $enc.Skip)); [void]$sb.Append("；字符数=$($txt2.TrimEnd("`r", "`n").Length)") } catch { } }
    return $sb.ToString()
}
function Invoke-DirList($a) {
    $t = Resolve-StatTarget $a 'dir_list'
    $script:P71Stats.DirList++
    $dir = if ($t.Dir) { $t.Dir } else { $t.Path }
    $pat = if ($t.Pattern) { $t.Pattern } elseif ("$($a.pattern)" -ne '') { "$($a.pattern)" } else { '*' }
    if ($pat -match '[\\/:]') { throw 'dir_list 的 pattern 不能包含路径分隔符' }
    if (-not [System.IO.Directory]::Exists($dir)) { return "dir_list: ❌ 目录不存在 — $(Limit-Text $dir 160)" }
    $lim = 50
    if (Test-NumValue $a.limit) { $lim = [Math]::Min([Math]::Max([int][double]"$($a.limit)", 1), 200) }
    $items = @(Get-ChildItem -LiteralPath $dir -Filter $pat -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    $lines = @($items | Select-Object -First $lim | ForEach-Object {
            if ($_.PSIsContainer) { "  [目录] $($_.Name)  $(Format-StatTime $_.LastWriteTime)" } else { "  [文件] $($_.Name)  $($_.Length) 字节  $(Format-StatTime $_.LastWriteTime)" }
        })
    return "dir_list: $(Limit-Text $dir 120) 共 $($items.Count) 项（pattern=$pat，按修改时间倒序，显示前 $([Math]::Min($items.Count, $lim)) 项；仅元数据）:`n" + ($lines -join "`n")
}
