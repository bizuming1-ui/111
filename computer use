        transport, _ = await loop.create_pipe_connection(lambda: proto, endpoint)       # type: ignore[attr-defined]
        w = asyncio.StreamWriter(transport, proto, r, loop)
    else:
        raise OSError("named pipes are Windows-only")
    try:
        w.write((json.dumps(msg) + "\n").encode()); await w.drain()
        return json.loads((await asyncio.wait_for(r.readline(), timeout)).decode())
    finally:
        w.close()
