class DriverHub:
    """Single access point for the brain. `driver_kind` is 'rust' or 'py-native' (explicit, never hidden)."""

    def __init__(self, cfg: Config) -> None:
        self.cfg = cfg
        self.token = cfg.token or secrets.token_hex(16)
        self.driver_kind = "none"
        self.driver_hello: dict[str, Any] = {}
        self.cdp_hello: dict[str, Any] = {}
        self._drv: Optional[NdjsonClient] = None
        self._native: Any = None
        self._cdp: Optional[NdjsonClient] = None
        self.procs: dict[str, subprocess.Popen[bytes]] = {}
        self.cdp_error: Optional[str] = None
        self.cdp_heals = 0  # successful self-heals (reconnect / relaunch) in this session
        self.cdp_heal_fail = 0
        self.cdp_degraded = 0  # times a browser task had to fall back although heal failed (should stay 0)
        self.cdp_heal_log: list[dict[str, Any]] = []
        self._heal_lock: Optional[asyncio.Lock] = None

    # -- driver
    async def start_driver(self) -> dict[str, Any]:
        cfg = self.cfg
        if not cfg.force_native and cfg.driver_exe.exists() and IS_WIN:
            env = dict(os.environ, DSCU_TOKEN=self.token)
            c = NdjsonClient(cfg.driver_pipe, "dscu-driver", self.token)
            try:
                try:
                    await c.connect(0.6)  # already running?
                except IpcError:
                    self.procs["driver"] = spawn([str(cfg.driver_exe), "--pipe", cfg.driver_pipe], env, cfg.root, cfg.data_dir / "driver.log")
                    await c.connect(8)
                self.driver_hello = await c.hello(own_pid=os.getpid())
                self._drv, self.driver_kind = c, "rust-native"
                return self.driver_hello
            except Exception as e:  # explicit, logged fallback
                self.driver_hello = {"rust_error": str(e)}
        from .py_native_driver import NativeDriver

        self._native = NativeDriver(own_pid=os.getpid())
        self.driver_hello = {**await self._native.hello(), **{k: v for k, v in self.driver_hello.items() if k == "rust_error"}}
        self.driver_kind = "py-native"
        return self.driver_hello

    async def drv_observe(self, **kw: Any) -> Observation:
        req = {"type": "observe", "id": new_id(), **kw}
        raw = await (self._drv.call(req, 20) if self._drv else self._native.handle(req))
        return parse_observation(raw)

    async def drv_action(self, req: dict[str, Any]) -> ActionResult:
        req = {"type": "action", "id": new_id(), **req}
        raw = await (self._drv.call(req, 60) if self._drv else self._native.handle(req))
        return parse_result(raw)

    async def drv_fg_probe(self) -> dict[str, Any]:
        """<2 ms Win32 foreground probe (py-native).  Raises when the peer does not implement it -> Perception falls back to the classic path."""
        req = {"type": "fg_probe", "id": new_id()}
        raw = await (self._drv.call(req, 3) if self._drv else self._native.handle(req))
        if raw.get("type") == "error" or raw.get("ok") is False:
            raise RuntimeError(f"fg_probe unsupported: {raw.get('message')}")
        return raw

    async def drv_guard_focus(self, hwnd: int) -> dict[str, Any]:
        req = {"type": "guard_focus", "id": new_id(), "hwnd": int(hwnd)}
        if self._drv:
            r = await self._drv.call({"type": "action", "id": new_id(), "action_id": new_id("a"), "action": "focus_window", "hwnd": int(hwnd)}, 20)
            return {"ok": bool(r.get("ok")), "method": "rust.focus_window"}
        return await self._native.handle(req)

    async def drv_bench(self, frames: int = 100) -> dict[str, Any]:
        req = {"type": "capture_bench", "id": new_id(), "frames": frames}
        return await (self._drv.call(req, 120) if self._drv else self._native.handle(req))

    # -- cdp
    async def ensure_cdp(self) -> bool:
        if self._cdp and not self._cdp.lost:
            return True
        eng = (getattr(self.cfg, "browser_engine", "auto") or "auto").lower()
        if eng in ("auto", "mcp") and await self._ensure_mcp():
            return True
        if eng == "mcp":
            return False
        cfg = self.cfg
        node = shutil.which("node")
        if not node or not cfg.daemon_entry.exists():
            self.cdp_error = "node 或 cdp-daemon 缺失"
            return False
        prof = cfg.cdp_profile if cfg.cdp_profile in ("persistent", "ephemeral") else "persistent"
        pdir = cfg.auth_profile_dir if prof == "persistent" else cfg.data_dir / "ephemeral-profile"
        env = dict(os.environ, DSCU_TOKEN=self.token, DSCU_CDP_PORT=str(cfg.cdp_port), DSCU_PROFILE=str(pdir), DSCU_CDP_PROFILE=prof)
        c = NdjsonClient(cfg.cdp_pipe, "cdp-daemon", self.token)
        try:
            try:
                await c.connect(0.6)
            except IpcError:
                self.procs["cdp"] = spawn([node, "--max-old-space-size=96", "--experimental-strip-types", "--disable-warning=ExperimentalWarning", str(cfg.daemon_entry), "--pipe", cfg.cdp_pipe, "--cdp-profile", prof, "--profile-dir", str(pdir)], env, cfg.root, cfg.data_dir / "cdp-daemon.log")
                await c.connect(25)
            self.cdp_hello = await c.hello()
            self._cdp = c
            self.cdp_error = None
            return True
        except Exception as e:
            self.cdp_error = str(e)
            return False

    async def _ensure_mcp(self) -> bool:
        """v16: official ChromeDevTools/chrome-devtools-mcp as the browser engine (same peer contract as the legacy cdp-daemon)."""
        if time.time() < getattr(self, "_mcp_cool_until", 0.0):
            return False
        try:
            from .browser_mcp import McpBrowserEngine

            eng = getattr(self, "_mcp", None)
            if eng is None:
                eng = McpBrowserEngine(self.cfg)
                await eng.start(90)
                self._mcp = eng
            elif eng.lost:
                await eng.restart("ensure_cdp")
            self._cdp = eng  # type: ignore[assignment]
            self.cdp_hello = eng.hello_cache or await eng.hello()
            self.cdp_error = None
            self.cdp_engine = "chrome-devtools-mcp"
            return True
        except Exception as e:  # noqa: BLE001
            self.cdp_error = f"chrome-devtools-mcp 启动失败：{e}"
            self._mcp = None
            self._mcp_cool_until = time.time() + 120.0  # auto mode: fall back to cdp-daemon, retry MCP in 2 min
            return False

    @property
    def cdp_up(self) -> bool:
        return bool(self._cdp and not self._cdp.lost)

    async def cdp_heal(self, reason: str, tries: int = 8, force: bool = False) -> bool:
        """Self-healing CDP: 500 ms back-off.  (1) daemon process gone -> respawn it with the same --cdp-profile;
        (2) daemon alive -> ask it to reconnect / relaunch the browser / re-attach the target (it bumps snapshot_epoch);
        (3) refresh `cdp_hello` (browser pids change after a relaunch -> FG-Gate must see the new pid)."""
        if self._heal_lock is None:
            self._heal_lock = asyncio.Lock()
        async with self._heal_lock:
            t0 = time.perf_counter()
            last = ""
            for attempt in range(1, tries + 1):
                try:
                    if self._cdp is None or self._cdp.lost:
                        self._cdp = None
                        if not await self.ensure_cdp():
                            raise IpcError(self.cdp_error or "ensure_cdp failed")
                    assert self._cdp is not None
                    r = await self._cdp.call({"type": "heal", "reason": reason[:160], "force": force}, 45)
                    if r.get("ok"):
                        try:
                            self.cdp_hello = await self._cdp.hello()
                        except Exception:  # noqa: BLE001
                            pass
                        ms = round((time.perf_counter() - t0) * 1000)
                        if r.get("healed"):
                            self.cdp_heals += 1
                            self.cdp_heal_log.append({"reason": reason[:120], "attempt": attempt, "ms": ms, "respawned": bool(r.get("browser_respawned")), "epoch": r.get("epoch")})
                        self.cdp_error = None
                        return True
                    last = str(r.get("message") or r)
                except Exception as e:  # noqa: BLE001
                    last = str(e)
                    if self._cdp is not None and self._cdp.lost:
                        self._cdp = None
                await asyncio.sleep(0.5)
            self.cdp_heal_fail += 1
            self.cdp_error = f"heal failed after {tries} attempts: {last}"
            return False

    async def cdp_status(self) -> dict[str, Any]:
        if not self.cdp_up:
            return {"up": False, "error": self.cdp_error}
        try:
            r = await self._cdp.call({"type": "status"}, 5)  # type: ignore[union-attr]
            return {"up": True, **{k: v for k, v in r.items() if k not in ("id", "type")}, "hub_heals": self.cdp_heals, "hub_heal_fail": self.cdp_heal_fail}
        except Exception as e:  # noqa: BLE001
            return {"up": False, "error": str(e)}

    async def cdp_observe(self, **kw: Any) -> Observation:
        last: Optional[BaseException] = None
        for attempt in (1, 2):
            try:
                if not self.cdp_up and not await self.cdp_heal("observe: link down"):
                    raise IpcError(self.cdp_error or "CDP unavailable")
                assert self._cdp
                return parse_observation(await self._cdp.call({"type": "observe", "id": new_id(), **kw}, 45))
            except (IpcError, RuntimeError) as e:
                last = e
                if attempt == 2 or not HEAL_RX.search(str(e)):
                    break
                if not await self.cdp_heal(str(e)):
                    break
        self.cdp_degraded += 1
        raise RuntimeError(f"[CDP_UNRECOVERABLE] {last}")

    async def cdp_action(self, req: dict[str, Any]) -> ActionResult:
        for attempt in (1, 2):
            try:
                if not self.cdp_up and not await self.cdp_heal("action: link down"):
                    return ActionResult(ok=False, code=Code.INTERNAL, message=f"[CDP_UNRECOVERABLE] {self.cdp_error}")
                assert self._cdp
                r = parse_result(await self._cdp.call({"type": "action", "id": new_id(), **req}, 70))
            except IpcError as e:
                if attempt == 2 or not HEAL_RX.search(str(e)) or not await self.cdp_heal(str(e)):
                    return ActionResult(ok=False, code=Code.INTERNAL, message=f"IPC: {e}")
                if str(req.get("action")) in SAFE_REPLAY:
                    req = {**req, "action_id": new_id("a")}
                    continue
                return ActionResult(ok=False, code=Code.STALE_EPOCH, message="CDP 连接已自愈重连；旧元素 ref 已失效，请重新观察后再操作")
            if (not r.ok) and r.code in (Code.INTERNAL, Code.TIMEOUT) and HEAL_RX.search(r.message or "") and attempt == 1:
                if await self.cdp_heal(r.message):
                    if str(req.get("action")) in SAFE_REPLAY:
                        req = {**req, "action_id": new_id("a")}
                        continue
                    return ActionResult(ok=False, code=Code.STALE_EPOCH, message="CDP 连接已自愈重连；旧元素 ref 已失效，请重新观察后再操作")
            return r
        return ActionResult(ok=False, code=Code.INTERNAL, message="CDP action failed after heal")

    # -- resources
    def rss_report(self) -> dict[str, float]:
        out: dict[str, float] = {}
        try:
            import psutil

            out["python"] = psutil.Process(os.getpid()).memory_info().rss / 1048576
            for k, p in self.procs.items():
                if p.poll() is None:
                    out[k] = psutil.Process(p.pid).memory_info().rss / 1048576
        except Exception:
            pass
        return out

    async def close(self) -> None:
        for c in (self._cdp, self._drv):
            if c and not c.lost:
                try:
                    await c.call({"type": "shutdown"}, 2)
                except Exception:
                    pass
                c.close()
        for p in self.procs.values():
            if p.poll() is None:
                p.terminate()
