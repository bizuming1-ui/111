        p = psutil.Process(pid)
        return {pid} | {c.pid for c in p.children(recursive=True)}
    except Exception:  # noqa: BLE001
        return {pid}


def chrome_client_origin(pid: int) -> Optional[tuple[tuple[int, int], Rect]]:
    """(viewport origin PHYS, top-level window rect PHYS) of the biggest visible Chrome window of `pid`'s process tree; None when not found."""
    if not IS_WIN or not pid:
        return None
    from ctypes import wintypes

    user32 = ctypes.windll.user32
    pids = _pid_tree(pid)
    best: list[tuple[int, int, Rect]] = []
    EnumProc = ctypes.WINFUNCTYPE(ctypes.c_int, wintypes.HWND, wintypes.LPARAM)

    def cls_of(h: Any) -> str:
        b = ctypes.create_unicode_buffer(128)
        user32.GetClassNameW(h, b, 128)
        return b.value

    def top_cb(h: Any, _lp: Any) -> int:
        if not user32.IsWindowVisible(h) or user32.IsIconic(h):
            return 1
        p = wintypes.DWORD()
        user32.GetWindowThreadProcessId(h, ctypes.byref(p))
        if p.value in pids and cls_of(h) == "Chrome_WidgetWin_1":
