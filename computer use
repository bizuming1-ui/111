    folder = (m.group(3) or "桌面").strip() if ("桌面" in task_text or "desktop" in task_text.lower()) else (m.group(3) or "工作区")
    return {"content": content, "filename": filename, "folder": folder}


class CliRouter:
    def __init__(
        self,
        jail_root: str,
        taint: TaintedContext | None = None,
        extra_dirs: list[str] | None = None,
        allow_network: bool = False,
        timeout_s: float = 60.0,
        intent_engine: IntentPathGrantEngine | None = None,
    ):
        self.root = jail_root
        self.taint = taint or TaintedContext()
        self.extra = [d for d in (extra_dirs or []) + os.environ.get("DSCU_CLI_PATH", "").split(os.pathsep) if d]
        self.allow_network = allow_network
        self.timeout = timeout_s
        self.intent_engine = intent_engine
        self.tools: dict[str, CliTool] = {}

    def discover(self) -> dict[str, CliTool]:
        self.tools.clear()
        dirs = self.extra + os.environ.get("PATH", "").split(os.pathsep)
        for d in dirs:
            try:
                for f in Path(d).iterdir():
                    n = f.stem if f.suffix.lower() in (".exe", ".cmd", ".bat", ".py", ".ps1") else f.name
                    if n.startswith("cli-anything-") and n not in self.tools and f.is_file():
                        app = n[len("cli-anything-"):]
                        self.tools[n] = CliTool(n, str(f), "cli-anything", app, {})
            except OSError:
                continue
        for app, (_, native, _) in HEADLESS.items():
            exe = native and shutil.which(native)
            if exe and native not in self.tools:
                self.tools[native] = CliTool(native, exe, "headless", app)
        return self.tools

    def route(self, task: str) -> CliTool | None:
        if parse_notepad_intent(task) is not None:
            return CliTool("native-safe-file", "builtin://native-safe-file", "native-safe-file", "notepad")
        if not self.tools:
            self.discover()
        for app, (rx, native, pkg) in HEADLESS.items():
            if re.search(rx, task, re.I):
                if pkg in self.tools:
                    return self.tools[pkg]
                if native in self.tools:
                    return self.tools[native]
        return None

    def execute_native_safe_file(self, task: str, user_home: str | Path | None = None) -> CliResult:
        """Executes Layer-0 Intent-Scoped safe file creation + UTF-8 verification in <5ms."""
        t0 = time.perf_counter()
        parsed = parse_notepad_intent(task)
        if not parsed:
            return CliResult(False, "native-safe-file", 1, 0.0, None, [], "Task does not match native-safe-file")
        engine = self.intent_engine or IntentPathGrantEngine.from_user_intent(task, self.root, user_home=user_home)
        rel_target = f"{parsed['folder']}\\{parsed['filename']}"
        safe_target = assert_safe_path(rel_target, self.root, "write", intent_engine=engine, taint=self.taint)
        safe_target.parent.mkdir(parents=True, exist_ok=True)
        safe_target.write_text(parsed["content"], encoding="utf-8")
        art = verify_artifact(safe_target, kind="txt", min_bytes=1, expect_text=parsed["content"])
        dt = time.perf_counter() - t0
        payload = {
            "ok": art.ok,
            "path": str(safe_target),
            "content": parsed["content"],
            "intent_granted_roots": [str(p) for p in engine.granted_roots.values()],
        }
        return CliResult(art.ok, "native-safe-file", 0 if art.ok else 1, dt, payload, [art], "" if art.ok else art.detail)

    def validate_args(self, tool: CliTool, args: list[str]) -> list[str]:
        base = Path(tool.path).stem
        if base in NETWORK_TOOLS or tool.name in NETWORK_TOOLS:
            if self.taint.tainted or not self.allow_network:
                raise SecurityError("SECURITY_DENIED", f"network-capable tool {tool.name} refused (tainted={self.taint.tainted})")
        out: list[str] = []
        for i, a in enumerate(args):
            a = str(a)
            if META.search(a):
                raise SecurityError("SECURITY_DENIED", f"shell metacharacter in argument {a!r}")
            if re.match(r"^(https?|ftp)://", a, re.I) and (self.taint.tainted or not self.allow_network):
                raise SecurityError("SECURITY_DENIED", f"unauthorised network URL {a!r}")
            val = a
            if PATH_ARG.match(a) and "=" in a:
                k, val = a.split("=", 1)
                op = "write" if re.match(r"^--?(out|output|o)", k, re.I) else "read"
                out.append(f"{k}={assert_safe_path(val, self.root, op, intent_engine=self.intent_engine, taint=self.taint)}")
                continue
            if i > 0 and PATH_ARG.match(str(args[i - 1])) and "=" not in str(args[i - 1]):
                op = "write" if re.match(r"^--?(out|output|o)$", str(args[i - 1]), re.I) else "read"
                out.append(str(assert_safe_path(val, self.root, op, intent_engine=self.intent_engine, taint=self.taint)))
                continue
            out.append(a)
        return out

    async def run(self, tool: CliTool, args: list[str], expect: list[dict] | None = None) -> CliResult:
        args = self.validate_args(tool, args)
        expect = expect or []
        checks = []
        for e in expect:
            checks.append((
                assert_safe_path(e["path"], self.root, "write", intent_engine=self.intent_engine, taint=self.taint),
                e.get("kind"),
                int(e.get("min_bytes", 64)),
            ))
        if tool.kind == "cli-anything" and "--json" not in args:
            args = ["--json", *args]
        cmd = [tool.path, *args]
        if tool.path.lower().endswith(".py"):
            cmd = [sys.executable, tool.path, *args]
        t0 = time.perf_counter()
        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
            cwd=self.root,
        )
        try:
            so, se = await asyncio.wait_for(proc.communicate(), self.timeout)
        except asyncio.TimeoutError:
            proc.kill()
            await proc.wait()
            return CliResult(False, tool.name, -9, time.perf_counter() - t0, None, [], "timeout")
        dt = time.perf_counter() - t0
        js = None
        try:
            js = json.loads(so.decode("utf-8", "replace").strip().splitlines()[-1]) if so.strip() else None
        except (ValueError, IndexError):
            js = None
        self.taint.mark("cli-output", so.decode("utf-8", "replace")[:4000])
        arts = [verify_artifact(p, k, mb) for p, k, mb in checks]
        ok = proc.returncode == 0 and all(a.ok for a in arts)
        err = "" if ok else (se.decode("utf-8", "replace")[:300] or "; ".join(a.detail for a in arts if not a.ok))
        return CliResult(ok, tool.name, proc.returncode or 0, dt, js, arts, err)


class ReplSession:
    def __init__(self, tool: CliTool, cwd: str):
        self.tool, self.cwd, self.proc = tool, cwd, None

    async def start(self):
        cmd = [self.tool.path, "--json", "repl"]
        if self.tool.path.lower().endswith(".py"):
            cmd = [sys.executable, self.tool.path, "--json", "repl"]
        self.proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdin=asyncio.subprocess.PIPE,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
            cwd=self.cwd,
        )

    async def send(self, line: str) -> dict:
        assert self.proc and self.proc.stdin and self.proc.stdout
        if META.search(line):
            raise SecurityError("SECURITY_DENIED", f"metacharacter in REPL command {line!r}")
        self.proc.stdin.write((line.strip() + "\n").encode("utf-8"))
        await self.proc.stdin.drain()
        raw = await asyncio.wait_for(self.proc.stdout.readline(), 15.0)
        return json.loads(raw.decode("utf-8", "replace"))

    async def undo(self) -> dict:
        return await self.send("undo")

    async def close(self):
        if self.proc and self.proc.returncode is None:
            try:
                await self.send("exit")
            except Exception:
                self.proc.kill()
            await self.proc.wait()
