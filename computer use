"""v16.1 AUTH_WALL detection + 1-step human hand-off policy (no 15-step dead-end clicking on Google's `signin/rejected` page).

An AUTH_WALL is a page the agent must NOT try to click through: a login / account-chooser / 2FA wall, or Google's browser-integrity rejection
("此浏览器或应用可能不安全").  The orchestrator interrupts the step loop, asks the human to finish the login once (press Enter), re-snapshots and continues.
Pure python, zero dependencies, unit-tested on any OS.
"""
from __future__ import annotations

import re
from dataclasses import dataclass, field
from typing import Iterable, Optional

URL_RULES: list[tuple[str, str, "re.Pattern[str]"]] = [
    ("rejected", "google", re.compile(r"accounts\.google\.com/(?:v\d+/)?signin/rejected", re.I)),
    ("rejected", "google", re.compile(r"signin/rejected", re.I)),
    ("login", "google", re.compile(r"accounts\.google\.com/v3/signin", re.I)),
    ("login", "google", re.compile(r"accounts\.google\.com/(?:signin|servicelogin|accountchooser|interactivelogin|o/oauth2/(?:v2/)?auth)", re.I)),
    ("captcha", "google", re.compile(r"google\.com/sorry/", re.I)),
    ("login", "microsoft", re.compile(r"login\.microsoftonline\.com/|login\.live\.com/(?:login|oauth)", re.I)),
]
TEXT_RULES: list[tuple[str, "re.Pattern[str]"]] = [
    ("rejected", re.compile(r"此浏览器或应用可能不安全|这个浏览器或应用可能不安全|This browser or app may not be secure", re.I)),
]
GOOGLE_ONLY_TEXT: list[tuple[str, "re.Pattern[str]"]] = [
    ("rejected", re.compile(r"无法登录|Couldn.t sign you in|Can.t sign you in", re.I)),
]


@dataclass
class AuthWall:
    kind: str  # rejected | login | captcha
    provider: str
    evidence: str
    url: str = ""

    @property
    def label(self) -> str:
        return {"rejected": "Google 登录被拒绝（浏览器完整性风控 signin/rejected）", "login": "登录/账号选择/2FA 墙", "captcha": "人机验证（unusual traffic）"}.get(self.kind, self.kind)


def detect_auth_wall(url: str = "", title: str = "", texts: Iterable[str] = ()) -> Optional[AuthWall]:
    """URL first (cheap, unambiguous), then page text (a11y snapshot element names / vision text).  `rejected` outranks `login`."""
    url = str(url or "")
    blob = "\n".join([str(title or ""), *[str(t) for t in texts if t]])[:20000]
    best: Optional[AuthWall] = None
    for kind, prov, rx in URL_RULES:
        m = rx.search(url)
        if m:
            cand = AuthWall(kind, prov, f"url~{m.group(0)[:60]}", url)
            if best is None or (cand.kind == "rejected" and best.kind != "rejected"):
                best = cand
    for kind, rx in TEXT_RULES:
        m = rx.search(blob)
        if m:
            return AuthWall(kind, "google", f"text~{m.group(0)[:60]}", url)
    if "accounts.google.com" in url.lower() or (best and best.provider == "google"):
        for kind, rx in GOOGLE_ONLY_TEXT:
            m = rx.search(blob)
            if m:
                return AuthWall(kind, "google", f"text~{m.group(0)[:60]}", url)
    return best


@dataclass
class AuthWallGuard:
    """Per-task policy: at most `max_handoffs` human hand-offs, never repeat for the very same wall without the page having changed."""
    max_handoffs: int = 2
    handoffs: int = 0
    last_sig: str = ""
    history: list[str] = field(default_factory=list)

    def sig(self, w: AuthWall) -> str:
        return f"{w.kind}|{w.provider}|{re.sub(r'[?#].*$', '', w.url)[:120]}"

    def allow(self, w: AuthWall) -> bool:
        return self.handoffs < self.max_handoffs

    def record(self, w: AuthWall) -> None:
        self.handoffs += 1
        self.last_sig = self.sig(w)
        self.history.append(self.last_sig)


def banner(w: AuthWall, *, mode: str = "", webdriver: Optional[object] = None, attempt: int = 1, maxn: int = 2) -> list[str]:
    L = [f"🔐 AUTH_WALL_HANDOFF（第 {attempt}/{maxn} 次）：检测到 {w.label}", f"   证据: {w.evidence}", f"   URL : {w.url[:110]}"]
