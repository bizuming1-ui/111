//! v9.2 multi-batch quantity quota (twin of PowerShell `Get-TaskQuantities` / `Register-V92QuotaDelete` / `Resolve-V92QuotaPending`).
//! Pure std, no regex crate: a tiny scanner that finds number tokens and decides whether each one is a *quantity* (front/back marker or unit)
//! and not an ordinal ("第3个") or a connective ("然后5分钟后").
//! "删除前5条和后面3条邮件" -> batches [5, 3], total 8. The destructive-action interlock accepts any *remaining* sub-batch or prefix sum.

const GATE: [&str; 21] = [
    "删", "刪", "delete", "remove", "勾", "选中", "選取", "选择", "選擇", "select", "archive", "归档", "歸檔", "封存", "垃圾", "trash", "标记", "標記", "mark", "移动", "move",
];
const UNITS: [&str; 12] = ["个", "個", "封", "条", "條", "项", "項", "则", "則", "份", "篇", "页"];
const FRONT: [&str; 6] = ["最前面", "最前", "前面", "前", "头", "first"];
const BACK: [&str; 8] = ["最后面", "最后", "后面", "后", "末尾", "last", "bottom", "尾部"];
const EN_NOUNS: [&str; 8] = ["email", "mail", "message", "item", "conversation", "row", "thread", "file"];

fn zh_digit(c: char) -> Option<u32> {
    Some(match c { '零' => 0, '一' => 1, '二' | '两' => 2, '三' => 3, '四' => 4, '五' => 5, '六' => 6, '七' => 7, '八' => 8, '九' => 9, _ => return None })
}
fn is_zh_num_char(c: char) -> bool { zh_digit(c).is_some() || c == '十' || c == '百' }

/// "十" -> 10, "三十五" -> 35, "一百二十" -> 120.
pub fn parse_zh_number(s: &str) -> Option<u32> {
    let (mut total, mut cur) = (0u32, 0u32);
    if s.is_empty() { return None; }
    for c in s.chars() {
        if let Some(d) = zh_digit(c) { cur = d; }
        else if c == '十' { total += if cur == 0 { 1 } else { cur } * 10; cur = 0; }
        else if c == '百' { total += if cur == 0 { 1 } else { cur } * 100; cur = 0; }
        else { return None; }
    }
    Some(total + cur)
}

fn ends_with_any<'a>(hay: &str, set: &[&'a str]) -> Option<&'a str> {
    let mut best: Option<&str> = None;
    for m in set { if hay.ends_with(m) && best.map_or(true, |b| m.len() > b.len()) { best = Some(m); } }
    best
}

/// Ordered quantity list. Empty when the task is not a select/delete/archive/move style task.
pub fn parse_quantities(text: &str) -> Vec<u32> {
    let lower = text.to_lowercase();
    if !GATE.iter().any(|g| lower.contains(g)) { return Vec::new(); }
    let chars: Vec<char> = lower.chars().collect();
    let mut out = Vec::new();
    let mut i = 0;
    while i < chars.len() {
        let c = chars[i];
        let is_digit = c.is_ascii_digit();
        if !(is_digit || is_zh_num_char(c)) { i += 1; continue; }
        let start = i;
        while i < chars.len() && (if is_digit { chars[i].is_ascii_digit() } else { is_zh_num_char(chars[i]) }) { i += 1; }
        let tok: String = chars[start..i].iter().collect();
        let val = if is_digit { tok.parse::<u32>().ok() } else { parse_zh_number(&tok) };
        let before: String = chars[..start].iter().collect();
        let before_t = before.trim_end();
        // ordinal ("第3个") is never a quantity
        if before_t.ends_with('第') { continue; }
        let after: String = chars[i..].iter().collect();
        let after_t = after.trim_start();
        let mut ok = false;
        if let Some(m) = ends_with_any(before_t, &FRONT) { let _ = m; ok = true; }
        if !ok {
            if let Some(m) = ends_with_any(before_t, &BACK) {
                let pre: String = before_t.chars().rev().skip(m.chars().count()).take(1).collect();
                // "然后5分钟" / "之后" / "以后" / "前后": connectives, not a back-marker
                if !matches!(pre.as_str(), "然" | "之" | "以" | "前") || m.starts_with('最') { ok = true; }
            }
        }
        if !ok && UNITS.iter().any(|u| after_t.starts_with(u)) { ok = true; }
        if !ok && after.starts_with(' ') { let w: String = after_t.chars().take_while(|c| c.is_ascii_alphabetic()).collect(); if EN_NOUNS.iter().any(|n| w.starts_with(n)) { ok = true; } }
        if ok { if let Some(v) = val { if v > 0 && v <= 500 { out.push(v); } } }
    }
    out
}

#[derive(Debug, Clone, PartialEq)]
pub struct Pending { pub count: u32, pub sel: String, pub before: Vec<u32> }

#[derive(Debug, Clone, PartialEq)]
pub struct Quota { pub original: Vec<u32>, pub remaining: Vec<u32>, pub total: u32, pub done: u32, pub pending: Option<Pending> }

#[derive(Debug, PartialEq, Eq)]
pub enum Settle { None, Commit, Rollback }

impl Quota {
    pub fn new(text: &str) -> Option<Quota> {
        let b = parse_quantities(text);
        if b.is_empty() { return None; }
        let total = b.iter().sum();
        Some(Quota { original: b.clone(), remaining: b, total, done: 0, pending: None })
    }
    /// Remaining sub-batches plus prefix sums (so the remaining total is always included).
    pub fn allowed(&self) -> Vec<u32> {
        let mut v: Vec<u32> = Vec::new(); let mut acc = 0;
        for r in &self.remaining { v.push(*r); acc += *r; v.push(acc); }
        v.sort_unstable(); v.dedup(); v
    }
    pub fn check(&self, selected: u32) -> bool { self.allowed().contains(&selected) }
    pub fn register(&mut self, count: u32, sel: &str) {
        if count == 0 { return; }
        let before = self.remaining.clone();
        if let Some(i) = self.remaining.iter().position(|r| *r == count) { self.remaining.remove(i); }
        else {
            let (mut acc, mut k) = (0, None);
            for (j, r) in self.remaining.iter().enumerate() { acc += *r; if acc == count { k = Some(j); break; } }
            if let Some(k) = k { self.remaining.drain(..=k); } else if count >= acc { self.remaining.clear(); }
        }
        self.pending = Some(Pending { count, sel: sel.to_string(), before });
    }
    /// Same selection as at registration => the delete never happened: roll the quota back; changed selection => commit.
    pub fn resolve(&mut self, sel: &str) -> Settle {
        let Some(p) = self.pending.take() else { return Settle::None };
        if !sel.is_empty() && sel == p.sel { self.remaining = p.before; return Settle::Rollback; }
        self.done += p.count; Settle::Commit
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test] fn parses_compound_quantities() {
        assert_eq!(parse_quantities("删除前5条和后面3条邮件"), vec![5, 3]);
        assert_eq!(parse_quantities("删除前五封和最后三封邮件"), vec![5, 3]);
        assert_eq!(parse_quantities("delete the first 5 and last 3 emails"), vec![5, 3]);
        assert_eq!(parse_quantities("打开gmail，删除前面10个邮件"), vec![10]);
        assert_eq!(parse_quantities("删除前十封邮件"), vec![10]);
    }
    #[test] fn ignores_ordinals_connectives_and_non_destructive_tasks() {
        assert_eq!(parse_quantities("然后删除前5封邮件"), vec![5]);
        assert!(parse_quantities("点开第3个视频").is_empty());
        assert!(parse_quantities("打开一个记事本，输入晚上好").is_empty());
        assert!(parse_quantities("删除第3封邮件").is_empty());
    }
    #[test] fn interlock_accepts_any_open_sub_batch_then_exhausts() {
        let mut q = Quota::new("删除前5条和后面3条邮件").unwrap();
        assert_eq!(q.allowed(), vec![3, 5, 8]);
        assert!(q.check(5) && q.check(3) && q.check(8) && !q.check(4));
        q.register(5, "sel:5:a"); assert_eq!(q.resolve("sel:3:b"), Settle::Commit);
        assert_eq!(q.allowed(), vec![3]); assert!(q.check(3) && !q.check(5));
        q.register(3, "sel:3:b"); assert_eq!(q.resolve("sel:0"), Settle::Commit);
        assert!(q.remaining.is_empty() && q.done == 8 && q.allowed().is_empty());
    }
    #[test] fn unverified_delete_rolls_back() {
        let mut q = Quota::new("删除前5条和后面3条邮件").unwrap();
        q.register(5, "sel:5:a"); assert_eq!(q.resolve("sel:5:a"), Settle::Rollback);
        assert_eq!(q.remaining, vec![5, 3]); assert_eq!(q.done, 0);
    }
    #[test] fn zh_numbers() { assert_eq!(parse_zh_number("十"), Some(10)); assert_eq!(parse_zh_number("三十五"), Some(35)); assert_eq!(parse_zh_number("一百二十"), Some(120)); assert_eq!(parse_zh_number("两"), Some(2)); }
}
