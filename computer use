"""Multi-batch quantity quota: "前5条和后面3条" -> [5, 3]; interlock accepts any open sub-batch or prefix sum."""
from __future__ import annotations
import re
from dataclasses import dataclass, field
from typing import Optional

_GATE = re.compile(r"(?i)(删|刪|delete|remove|勾|选中|選取|选择|選擇|select|archive|归档|歸檔|封存|垃圾|trash|标记|標記|mark|移动|移至|移到|move)")
_NUM = r"(\d{1,3}|[零一二两三四五六七八九十百]{1,4})"
_PATS = [
    rf"(?:最?前面?|头|first|top)\s*{_NUM}",
    rf"(?:(?<![然之以前])最?后面?|末尾|最末|结尾|尾部|last|bottom)\s*{_NUM}",
    rf"(?<![第\d零一二两三四五六七八九十百]){_NUM}\s*(?:个|個|封|条|條|项|項|则|則|份|篇)",
    rf"(?<![第\d]){_NUM}\s+(?:emails?|mails?|messages?|items?|conversations?|rows?)",
]
_ZH = {"零": 0, "一": 1, "二": 2, "两": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9}


def zh_number(s: str) -> int:
    if s.isdigit():
        return int(s)
    total = cur = 0
    for ch in s:
        if ch in _ZH: cur = _ZH[ch]
        elif ch == "十": total += (cur or 1) * 10; cur = 0
        elif ch == "百": total += (cur or 1) * 100; cur = 0
        else: return 0
    return total + cur


def parse_quantities(text: str) -> list[int]:
    if not text or not _GATE.search(text):
        return []
    found: dict[int, int] = {}
    for p in _PATS:
        for m in re.finditer(p, text, re.I):
            idx = m.start(1)
            if idx in found: continue
            v = zh_number(m.group(1))
            if 0 < v <= 500: found[idx] = v
    return [found[k] for k in sorted(found)]


@dataclass
class Pending:
    count: int
    sel: str
    before: list[int]


@dataclass
class Quota:
    original: list[int]
    remaining: list[int]
    total: int
    done: int = 0
    pending: Optional[Pending] = None
    log: list[str] = field(default_factory=list)

    @classmethod
    def from_text(cls, text: str) -> Optional["Quota"]:
        b = parse_quantities(text)
        return cls(list(b), list(b), sum(b)) if b else None

    def allowed(self) -> list[int]:
        out, acc = set(), 0
        for r in self.remaining:
            out.add(r); acc += r; out.add(acc)
        return sorted(out)

    def check(self, selected: int) -> bool:
        return selected in self.allowed()

    def register(self, count: int, sel: str) -> None:
        if count <= 0: return
        before = list(self.remaining)
        if count in self.remaining:
            self.remaining.remove(count)
        else:
            acc, k = 0, None
            for j, r in enumerate(self.remaining):
                acc += r
                if acc == count: k = j; break
            if k is not None: del self.remaining[: k + 1]
            elif count >= acc: self.remaining.clear()
        self.pending = Pending(count, sel, before)

    def resolve(self, sel: str) -> str:
        """Same selection as at registration => the delete never happened (rollback); changed selection => committed."""
        p, self.pending = self.pending, None
        if p is None: return "none"
        if sel and sel == p.sel:
            self.remaining = list(p.before); self.log.append(f"rollback {p.count}"); return "rollback"
        self.done += p.count; self.log.append(f"commit {p.count}"); return "commit"
