//! Raw accessibility tree model shared by UIA and Java Access Bridge, plus window selection (fail-closed).
use crate::protocol::{ErrKind, RpcError};
use serde::{Deserialize, Serialize};
use serde_json::json;

#[derive(Clone, Debug, Default, Serialize, Deserialize)]
pub struct RawNode {
    /// Stable runtime identity (UIA RuntimeId / JAB path); used to re-find the element for a ref.
    pub key: String,
    pub role: String,
    pub name: String,
    pub automation_id: String,
    pub class: String,
    /// left, top, right, bottom (physical px)
    pub rect: [i32; 4],
    pub enabled: bool,
    pub offscreen: bool,
    pub focusable: bool,
    pub password: bool,
    pub patterns: Vec<String>,
    pub value: Option<String>,
    /// "uia" | "jab"
    pub source: String,
    pub children: Vec<RawNode>,
}

#[derive(Clone, Debug, Default, Serialize, Deserialize)]
pub struct WindowInfo {
    pub window_id: i64,
    pub title: String,
    pub class: String,
    pub pid: u32,
    pub process: String,
    pub rect: [i32; 4],
    pub is_java: bool,
    pub elevated: bool,
    pub foreground: bool,
}

impl WindowInfo {
    pub fn brief(&self) -> serde_json::Value {
        json!({ "window_id": self.window_id, "title": self.title, "class": self.class, "pid": self.pid,
                "process": self.process, "rect": self.rect, "foreground": self.foreground })
    }
}

#[derive(Default, Debug)]
pub struct Selector {
    pub window_id: Option<i64>,
    pub app: Option<String>,
    pub title: Option<String>,
}

/// Fail-closed window resolution: zero matches -> NOT_FOUND, more than one -> AMBIGUOUS_TARGET (with candidates).
/// No selector at all = the foreground window.
pub fn select_window(sel: &Selector, wins: &[WindowInfo], foreground: i64) -> Result<WindowInfo, RpcError> {
    if let Some(id) = sel.window_id {
        return wins.iter().find(|w| w.window_id == id).cloned().ok_or_else(|| RpcError::new(ErrKind::NotFound, format!("window_id {id} not found")));
    }
    if sel.app.is_none() && sel.title.is_none() {
        return wins.iter().find(|w| w.window_id == foreground).cloned().ok_or_else(|| RpcError::new(ErrKind::NotFound, "no foreground window"));
    }
    let app = sel.app.as_ref().map(|a| a.to_lowercase().trim_end_matches(".exe").to_string());
    let title = sel.title.as_ref().map(|t| t.to_lowercase());
    let m: Vec<&WindowInfo> = wins
        .iter()
        .filter(|w| {
            app.as_ref().map(|a| w.process.to_lowercase().trim_end_matches(".exe") == a).unwrap_or(true)
                && title.as_ref().map(|t| w.title.to_lowercase().contains(t.as_str())).unwrap_or(true)
        })
        .collect();
    match m.len() {
        0 => Err(RpcError::new(ErrKind::NotFound, "no window matches selector")),
        1 => Ok(m[0].clone()),
        n => Err(RpcError::new(ErrKind::AmbiguousTarget, format!("{n} windows match the selector; pass window_id"))
            .with_data(json!({ "candidates": m.iter().map(|w| w.brief()).collect::<Vec<_>>() }))),
    }
}
