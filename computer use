        s.draft_readback, s.draft_source, s.draft_ok = readback, source, ok
        if not ok:
            await self._clear_and_verify()
            return ms.WeChatResult("failed", reason=f"msg_draft_readback ✗ 读回=「{readback[:40]}」来源={source}", trace=self.trace)
