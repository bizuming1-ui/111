# ══════════ ③ 窗口语义指纹 + 可编辑性预检 ══════════
function Get-V12FocusScore($Fp, [string]$Keyword, [bool]$NeedInput) {
    if (-not $Fp.Visible) { return -100.0 }
    $kw = $Keyword.ToLower().Trim(); $t = "$($Fp.Title)".ToLower().Trim(); $s = 0.0
    if ($kw -and $t -eq $kw) { $s += 40 } elseif ($kw -and $t.Contains($kw)) { $s += 25 } elseif ($kw -and "$($Fp.Process)".ToLower().Contains($kw)) { $s += 15 }
    if (-not $Fp.Owned -and -not $Fp.Tool) { $s += 20 }
    if ([int]$Fp.Edit -gt 0) { $s += $(if ($NeedInput) { 35 } else { 10 }) }
    elseif ($NeedInput) { $s -= 15; if ("$($Fp.Title)" -match $script:V12ReadOnlyRx) { $s -= 30 } }
    if ($Fp.Owned -and $NeedInput) { $s -= 10 }
    $s += [Math]::Min(10.0, [double]$Fp.Area / 200000.0)
    if ($Fp.Iconic) { $s -= 5 }
    return [Math]::Round($s, 2)
}
function Select-V12Window($Cands, [string]$Keyword, [bool]$NeedInput) {
    $ranked = @($Cands | Sort-Object -Property @{ Expression = { Get-V12FocusScore $_ $Keyword $NeedInput }; Descending = $true })
    if ($ranked.Count -eq 0) { return $null }
    $top = $ranked[0]
    if ($NeedInput -and [int]$top.Edit -eq 0 -and "$($top.Title)" -match $script:V12ReadOnlyRx) {
        $sib = @($ranked | Where-Object { $_ -ne $top -and $_.Visible -and "$($_.Process)".ToLower() -eq "$($top.Process)".ToLower() -and -not $_.Tool -and -not $_.Owned -and "$($_.Title)" -notmatch $script:V12ReadOnlyRx })
        if ($sib.Count -gt 0) { return ($sib | Sort-Object -Property @{ Expression = { [int]$_.Edit }; Descending = $true }, @{ Expression = { [double]$_.Area }; Descending = $true } | Select-Object -First 1) }
    }
    return $top
}
function Get-V12EditableCount([IntPtr]$Hwnd) {
