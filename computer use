// snapshot_epoch lock — kills `CDP DOM.resolveNode: No node with given id found` (v10 log task #3: 8 hits, 52 wasted steps).
// Every backendNodeId handed to the brain is bound to the epoch it was minted in. A structural change (delete / re-order /
// navigation / dialog) bumps the epoch, so stale ids are rejected locally and cheaply (STALE_EPOCH) — the browser is never asked.
import { result, type ActionResult } from './protocol.ts'

export class EpochLock {
  private epoch = 0
  private bound = new Map<number, number>()
  get current(): number { return this.epoch }

  bump(_reason: string): number { this.epoch += 1; return this.epoch }

  bind(ids: number[]): number { for (const id of ids) this.bound.set(id, this.epoch); return this.epoch }

  /** null = fresh; otherwise the protocol error code */
  check(id: number | null, expect?: number): 'STALE_EPOCH' | 'STALE_REF' | null {
    if (expect !== undefined && expect !== this.epoch) return 'STALE_EPOCH'
    if (id === null) return null
    const e = this.bound.get(id)
    if (e === undefined) return 'STALE_REF'
    return e === this.epoch ? null : 'STALE_EPOCH'
  }

  /** Run `fn` only if the node is fresh. A raw "No node with given id" from CDP is converted into STALE_EPOCH + bump. */
  async guard(action_id: number, id: number, expect: number | undefined, fn: () => Promise<Record<string, unknown> | void>): Promise<ActionResult> {
    const stale = this.check(id, expect)
    if (stale) return result(action_id, false, stale, `${stale}: node ${id} minted before epoch ${this.epoch}; re-observe`, this.epoch)
    try {
      const data = await fn()
      return result(action_id, true, 'OK', 'ok', this.epoch, data ?? undefined)
    } catch (e) {
      if (/No node with given id|Cannot find context|Could not find node/i.test(String((e as Error)?.message ?? e))) {
        this.bump('node_vanished')
        return result(action_id, false, 'STALE_EPOCH', 'node vanished (DOM re-rendered); epoch bumped, re-observe', this.epoch)
      }
      return result(action_id, false, 'INTERNAL', String((e as Error)?.message ?? e), this.epoch)
    }
  }
}

/** Idempotent action ledger: a replayed action_id returns the cached result with code IDEMPOTENT_REPLAY. */
export class ActionLedger {
  private done = new Map<number, ActionResult>()
  seen(id: number): ActionResult | null {
    const r = this.done.get(id)
    return r ? { ...r, code: 'IDEMPOTENT_REPLAY' } : null
  }
  commit(r: ActionResult): void {
    this.done.set(r.action_id, r)
    if (this.done.size > 256) this.done.delete(this.done.keys().next().value as number)
  }
}
