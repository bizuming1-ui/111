class TestUnifiedObject(unittest.TestCase):
    def fuse(self):
        dom = [{"rect": [10, 100, 600, 36], "name": "Alice 周报", "role": "row", "identity": "#thread-f:18001", "ref_id": "r1", "state": {"checked": True}},
               {"rect": [100, 40, 40, 40], "name": "删除", "role": "button", "ref_id": "tb"}]
        uia = [{"rect": [11, 101, 598, 34], "name": "Alice 周报", "role": "listitem", "automation_id": "u1"}]
        dml = [{"rect": [98, 38, 44, 44], "cls": "icon", "score": 0.8}]
        ocr = [{"rect": [12, 102, 70, 20], "text": "Alice"}, {"rect": [400, 600, 100, 20], "text": "Hello?"}]
        return ObjectFusionEngine().fuse(snapshot_epoch=5, application_id="gmail", window_id=9, dom=dom, uia=uia, dml=dml, ocr=ocr)

    def test_cross_modal_merge_and_mandatory_fields(self):
        objs = self.fuse()
        row = next(o for o in objs if o.business_identity == "#thread-f:18001")
        self.assertEqual(set(row.sources) >= {"dom", "uia", "ocr"}, True)
        self.assertEqual(row.uia_identity, "u1")
        self.assertEqual(row.dom_identity, "r1")
        self.assertTrue(row.selected)
        self.assertEqual(row.snapshot_epoch, 5)
        self.assertFalse(row.validate())
        self.assertEqual(len([o for o in objs if o.business_identity]), 1)  # UIA twin merged into the DOM row, not duplicated
        trig = next(o for o in objs if o.accessible_name == "删除")
        self.assertIn("dml", trig.sources)
        self.assertEqual(trig.action_role, "trigger")

    def test_visual_only_has_no_destructive_authority(self):
        objs = self.fuse()
        lone = next(o for o in objs if o.accessible_name == "Hello?")
        self.assertTrue(lone.candidate_only)
        self.assertLessEqual(lone.confidence, 0.85)
        reg = ObjectRegistry()
        reg.ingest(objs, 5)
        self.assertFalse(reg.authorize(lone, destructive=True).ok)
        with self.assertRaises(PermissionError):
            reg.freeze([lone.object_id], 5)

    def test_epoch_binding(self):
        objs = self.fuse()
        reg = ObjectRegistry()
        reg.ingest(objs, 5)
        row = next(o for o in objs if o.business_identity)
        self.assertEqual(reg.require_current(row.object_id, 5).object_id, row.object_id)
        with self.assertRaises(StaleSnapshotEpoch):
            reg.require_current(row.object_id, 4)

    def test_object_id_stable_across_epochs(self):
        a = ObjectFusionEngine().fuse(snapshot_epoch=1, application_id="g", window_id=1, dom=[{"rect": [0, 0, 10, 10], "name": "x", "role": "row", "identity": "T1"}])
        b = ObjectFusionEngine().fuse(snapshot_epoch=2, application_id="g", window_id=1, dom=[{"rect": [0, 50, 10, 10], "name": "x", "role": "row", "identity": "T1"}])
        self.assertEqual(a[0].object_id, b[0].object_id)

    def test_similarity_primitives(self):
        self.assertGreater(iou((0, 0, 10, 10), (5, 0, 10, 10)), 0.3)
        self.assertEqual(text_sim("老虎 不抓鼠", "老虎不抓鼠"), 1.0)


