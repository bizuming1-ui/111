class FakeBrain:
    def __init__(self, wm):  # noqa: ANN001
        self.lines: list = []
        self.say = self.lines.append
        self.verifier = NS(wm=None)
        self.driven: list = []
        self.perception = NS(_force_vision_next_turn=False)
        self.hub = Hub()
        self.hitl_answer = True

    async def _drv(self, name, b, **kw):  # noqa: ANN001, ANN003
        self.driven.append((name, kw))
        return ActionResult(ok=True, code=Code.OK, message=f"{name} at ({kw.get('x')},{kw.get('y')}) physical input")

    def _target_hwnd(self, b):  # noqa: ANN001
        return 0

    def _cdp_route(self, b):  # noqa: ANN001
        return False

    async def _hitl(self, lines, q):  # noqa: ANN001
        self.lines.extend(lines)
        self.lines.append(q)
        return self.hitl_answer


