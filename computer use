    $all = @(Get-UiElements $fg.Handle | Sort-Object cy, cx)
    # v4.2：屏幕上有 ≥2 个复选框时建立「列表行模型」（含视口外的行）
    $model = $null
    if (@($all | Where-Object { $_.Type -eq 'CheckBox' }).Count -ge 2) { try { $model = Get-RowModel $fg.Handle } catch { $model = $null } }
    $rowParts = [System.Collections.Generic.HashSet[string]]::new()
    $masterKeys = [System.Collections.Generic.HashSet[string]]::new()
    $rowRects = New-Object System.Collections.Generic.List[object]
    if ($model) {
        foreach ($row in $model.Rows) {
            [void]$rowParts.Add((Get-GeoKey $row.Cb)); [void]$rowParts.Add((Get-GeoKey $row.Row))
            if (-not $row.Row.Off) { $rowRects.Add($row.Row) }
        }
        foreach ($mc in $model.Master) { [void]$masterKeys.Add((Get-GeoKey $mc)) }
    }
    # v4.2：先按屏幕位置排序、再按预算截断（v4.1 在 UIA 文档顺序里截断：Gmail 左侧栏/工具栏占满 100 个名额，模型只看到 6 行邮件）
    $general = New-Object System.Collections.Generic.List[object]
    $inter = 0; $txt = 0
    foreach ($it in $all) {
        $gk = Get-GeoKey $it
        if ($rowParts.Contains($gk)) { continue }                                              # 行与行复选框在「列表行」区单独列出
        if ($it.Type -eq 'Text' -and $rowRects.Count -gt 0 -and (Test-InAnyRect $it $rowRects)) { continue }   # 行内文字已并入行摘要
        if ($masterKeys.Contains($gk)) { $it.IsMaster = $true }
        if ($it.Type -eq 'Text') { if ($txt -ge 40) { continue }; $txt++ }
        else { if ($inter -ge $MaxElements) { continue }; $inter++ }
        $general.Add($it)
    }
    $script:Elements = @{}
    $lines = New-Object System.Collections.Generic.List[string]
    $baseKeys = New-Object System.Collections.Generic.List[string]
    $id = 0
    $cbTotal = 0
    $cbOnIds = New-Object System.Collections.Generic.List[int]
    foreach ($it in $general) {
        $id++
        $script:Elements[$id] = $it
        $line = "[$id] $($it.Type) `"$($it.Name)`""
        if ($it.Value) { $line += " value=`"$($it.Value)`"" }
        if ($it.State) { $line += " state=$($it.State)" }
        if (-not $it.Enabled) { $line += ' (disabled)' }
        if ($it.Focus) { $line += ' ★焦点' }
        if ($it.IsMaster) { $line += ' ⚠全选复选框' }
        if ($it.Pat.Count -gt 0) { $line += ' {' + ($it.Pat -join ',') + '}' }
        $line += " @($($it.cx),$($it.cy))"
        $lines.Add($line)
        $baseKeys.Add("$($it.Type)|$($it.Name)|$($it.State)")
