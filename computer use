# --------------------------------------------------------------------------------------------------------------------- command / args
MCP_PINNED_VERSION = "1.14.0"  # v16.2: reproducible builds — never `@latest` (override only explicitly via DSCU_MCP_VERSION)


def pinned_version(env: Optional[dict[str, str]] = None) -> str:
    env = env if env is not None else dict(os.environ)
    v = (env.get("DSCU_MCP_VERSION") or MCP_PINNED_VERSION).strip().lstrip("v")
    return v if re.fullmatch(r"\d+\.\d+\.\d+(?:[-+][\w.]+)?", v) else MCP_PINNED_VERSION


def pinned_spec(env: Optional[dict[str, str]] = None) -> str:
    return f"chrome-devtools-mcp@{pinned_version(env)}"


def resolve_command(env: Optional[dict[str, str]] = None) -> list[str]:
    """DSCU_MCP_CMD override > globally installed `chrome-devtools-mcp` (version-checked) > `npx -y chrome-devtools-mcp@<PINNED>` (never @latest)."""
    env = env if env is not None else dict(os.environ)
    if env.get("DSCU_MCP_CMD"):
        return shlex.split(env["DSCU_MCP_CMD"], posix=not IS_WIN)
    g = shutil.which("chrome-devtools-mcp")
    npx = shutil.which("npx")
    if g:
        iv = installed_version(g)
        if iv is None or iv == pinned_version(env) or not npx:
            return _wrap_cmd([g])  # unknown version (cannot probe) or exact match -> use it; mismatch is reported by startup_version_check()
    if npx:
        return _wrap_cmd([npx, "-y", pinned_spec(env)])
    raise McpError(f"chrome-devtools-mcp 未安装：运行 `npm i -g {pinned_spec(env)}`（Node >= 20.19）或安装 Node 后使用 npx")


def installed_version(exe: Optional[str] = None, timeout: float = 25.0) -> Optional[str]:
    """`chrome-devtools-mcp --version` of the globally installed binary (None when it cannot be determined)."""
    import subprocess

    exe = exe or shutil.which("chrome-devtools-mcp")
    if not exe:
        return None
    try:
        r = subprocess.run(_wrap_cmd([exe, "--version"]), capture_output=True, text=True, timeout=timeout, encoding="utf-8", errors="replace", stdin=subprocess.DEVNULL)
        m = re.search(r"(\d+\.\d+\.\d+(?:[-+][\w.]+)?)", (r.stdout or "") + (r.stderr or ""))
        return m.group(1) if m else None
    except Exception:  # noqa: BLE001
        return None


def startup_version_check(env: Optional[dict[str, str]] = None, probe: bool = True) -> dict[str, Any]:
    """Startup log line for reproducibility: which chrome-devtools-mcp will run and whether it equals the pinned version."""
    env = env if env is not None else dict(os.environ)
    want = pinned_version(env)
    if env.get("DSCU_MCP_CMD"):
        return {"pinned": want, "source": "DSCU_MCP_CMD", "resolved": "custom", "match": None, "message": f"chrome-devtools-mcp 由 DSCU_MCP_CMD 自定义（未做版本校验；锁定版本={want}）"}
    g = shutil.which("chrome-devtools-mcp")
    iv = installed_version(g) if (g and probe) else None
    if g and iv:
        ok = iv == want
        return {"pinned": want, "source": "global", "resolved": iv, "match": ok,
                "message": f"chrome-devtools-mcp 版本校验：全局 {iv} {'== 锁定 ' + want + ' ✓' if ok else '≠ 锁定 ' + want + ' ✗（将改用 npx ' + pinned_spec(env) + '；或运行 npm i -g ' + pinned_spec(env) + '）'}"}
    return {"pinned": want, "source": "npx", "resolved": want, "match": True, "message": f"chrome-devtools-mcp 版本校验：将通过 npx 使用锁定版本 {pinned_spec(env)}（不使用 @latest）"}


def _wrap_cmd(cmd: list[str]) -> list[str]:
    if IS_WIN and cmd[0].lower().endswith((".cmd", ".bat")):
        return ["cmd.exe", "/d", "/c", *cmd]
    return cmd


def find_browser_executable() -> str:
    """chrome-devtools-mcp launches Chrome *stable* by default.  Pick what is really installed: Chrome > Chrome Canary > Edge (Chromium)."""
    if not IS_WIN:
        return ""
    pf, pf86, la = os.environ.get("ProgramFiles", r"C:\Program Files"), os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)"), os.environ.get("LOCALAPPDATA", "")
    cands = [rf"{pf}\Google\Chrome\Application\chrome.exe", rf"{pf86}\Google\Chrome\Application\chrome.exe", rf"{la}\Google\Chrome\Application\chrome.exe",
             rf"{la}\Google\Chrome SxS\Application\chrome.exe", rf"{pf86}\Microsoft\Edge\Application\msedge.exe", rf"{pf}\Microsoft\Edge\Application\msedge.exe"]
    return next((c for c in cands if c and Path(c).exists()), "")


def build_args(mode: str = "profile", *, profile_dir: Optional[str] = None, browser_url: str = "", ws_endpoint: str = "", channel: str = "", headless: bool = False,
               vision: bool = True, executable: str = "", extra: Optional[list[str]] = None, stealth: bool = True) -> list[str]:
    a = list(FORCED_FLAGS)
    mode = (mode or "profile").lower().replace("_", "-")
    if mode in _CLEAN_ALIASES:  # v16.1: pure DevTools client attached to the natively launched clean Chrome
        a.append(f"--browserUrl={browser_url or f'http://127.0.0.1:{DEFAULT_PORT}'}")
    elif mode in ("autoconnect", "auto-connect"):
        a.append("--autoConnect")
        if channel:
            a += ["--channel", channel]
    elif mode in ("browser-url", "browserurl"):
        a += ["--browserUrl", browser_url or "http://127.0.0.1:9222"]
    elif mode in ("ws", "ws-endpoint"):
        a += ["--wsEndpoint", ws_endpoint]
    elif mode == "isolated":
        a.append("--isolated")
        if channel:
            a += ["--channel", channel]
    else:  # profile: dedicated persistent automation profile (log in once, reused)
        if profile_dir:
            a += ["--userDataDir", str(profile_dir)]
        if channel:
            a += ["--channel", channel]
    if executable and mode in ("profile", "isolated"):
        a += ["--executablePath", executable]
    if headless and mode in ("profile", "isolated"):
        a.append("--headless")
    if stealth and mode in ("profile", "isolated"):  # Puppeteer launch fallback: strip the flag that makes Google answer signin/rejected
        a += ["--ignore-default-chrome-arg=--enable-automation", "--chrome-arg=--disable-blink-features=AutomationControlled"]
    if vision:
        a.append("--experimentalVision")
    a += list(extra or [])
    return a


def default_roots() -> list[Path]:
    import tempfile

    home = Path.home()
    extra = [Path(x) for x in (os.environ.get("DSCU_MCP_ROOTS") or "").split(os.pathsep) if x]
    ws = os.environ.get("DSCU_ROOT")
    return [home / "Desktop", home / "Documents", home / "Downloads", Path(tempfile.gettempdir()), *([Path(ws) / "workspace"] if ws else []), *extra]


# --------------------------------------------------------------------------------------------------------------------- stdio JSON-RPC client
class McpResult:
    def __init__(self, text: str, images: list[dict[str, str]], is_error: bool, raw: dict[str, Any]) -> None:
        self.text, self.images, self.is_error, self.raw = text, images, is_error, raw


class McpStdioClient:
    def __init__(self, cmd: list[str], env: dict[str, str], log_path: Optional[Path] = None) -> None:
        self.cmd, self.env, self.log_path = cmd, env, log_path
        self.proc: Optional[asyncio.subprocess.Process] = None
        self.pending: dict[int, asyncio.Future[dict[str, Any]]] = {}
        self._id = 0
        self.tools: dict[str, dict[str, Any]] = {}
        self.server_info: dict[str, Any] = {}
        self._tasks: list[asyncio.Task[Any]] = []
        self.dead_reason = ""
        self.roots: list[Path] = default_roots()

    @property
    def alive(self) -> bool:
        return bool(self.proc and self.proc.returncode is None and not self.dead_reason)

    async def start(self, timeout: float = 90.0) -> None:
        kw: dict[str, Any] = {}
        if IS_WIN:
            kw["creationflags"] = 0x08000000 | 0x00000200  # CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP
        self.proc = await asyncio.create_subprocess_exec(*self.cmd, stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
                                                         env=self.env, limit=1 << 26, **kw)
        if IS_WIN:  # children (node + Chrome we launched) must die with Python
            try:
                import ctypes

                from .ipc_client import _win_job

                job = _win_job()
                h = self.proc._transport.get_extra_info("subprocess")._handle  # type: ignore[union-attr]
                ctypes.windll.kernel32.AssignProcessToJobObject(job, ctypes.c_void_p(int(h)))
            except Exception:  # noqa: BLE001
                pass
        self._tasks = [asyncio.create_task(self._read_stdout()), asyncio.create_task(self._read_stderr())]
        r = await self.request("initialize", {"protocolVersion": MCP_PROTOCOL, "capabilities": {"roots": {"listChanged": False}}, "clientInfo": {"name": "dscu-brain", "version": VERSION}}, timeout)
        self.server_info = dict(r.get("serverInfo") or {})
        await self.notify("notifications/initialized", {})
        tl = await self.request("tools/list", {}, 30)
        self.tools = {t["name"]: t for t in tl.get("tools", []) if isinstance(t, dict) and t.get("name")}
        if not self.tools:
            raise McpError("chrome-devtools-mcp 返回了空工具列表")

    async def _read_stdout(self) -> None:
        assert self.proc and self.proc.stdout
        try:
            while True:
                line = await self.proc.stdout.readline()
                if not line:
                    break
                s = line.strip()
                if not s:
                    continue
                try:
                    m = json.loads(s)
                except Exception:  # noqa: BLE001
                    continue  # non-JSON noise on stdout is ignored
                if "id" in m and ("result" in m or "error" in m) and "method" not in m:
                    f = self.pending.pop(int(m["id"]), None) if str(m["id"]).lstrip("-").isdigit() else None
                    if f and not f.done():
                        f.set_result(m)
                elif "method" in m and "id" in m:  # server -> client request (ping, roots/list ...)
                    resp: dict[str, Any] = {"jsonrpc": "2.0", "id": m["id"]}
                    if m["method"] == "ping":
                        resp["result"] = {}
                    elif m["method"] == "roots/list":  # MCP roots: grant ONLY Desktop/Documents/Downloads/workspace/temp for file tools
                        resp["result"] = {"roots": [{"uri": r.resolve().as_uri(), "name": r.name or str(r)} for r in self.roots if r.exists()]}
                    else:
                        resp["error"] = {"code": -32601, "message": "method not supported by dscu client"}
                    await self._write(resp)
        except Exception as e:  # noqa: BLE001
            self.dead_reason = f"stdout reader: {e!r}"
        finally:
            rc = self.proc.returncode if self.proc else None
            self.dead_reason = self.dead_reason or f"MCP stdio closed (exit={rc})"
            self._fail_all()

    async def _read_stderr(self) -> None:
        assert self.proc and self.proc.stderr
        lf = None
        try:
            if self.log_path:
                self.log_path.parent.mkdir(parents=True, exist_ok=True)
                lf = open(self.log_path, "ab")
            while True:
                line = await self.proc.stderr.readline()
                if not line:
                    break
                if lf:
                    lf.write(line)
                    lf.flush()
        except Exception:  # noqa: BLE001
            pass
        finally:
            if lf:
                lf.close()

    def _fail_all(self) -> None:
        for f in list(self.pending.values()):
            if not f.done():
                f.set_exception(McpTransportError(self.dead_reason or "MCP transport closed"))
        self.pending.clear()

    async def _write(self, obj: dict[str, Any]) -> None:
        if not self.alive or not self.proc or not self.proc.stdin:
            raise McpTransportError(self.dead_reason or "MCP server not running")
        try:
            self.proc.stdin.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
            await self.proc.stdin.drain()
        except (ConnectionResetError, BrokenPipeError, OSError) as e:
            self.dead_reason = f"stdin broken: {e!r}"
            raise McpTransportError(self.dead_reason) from e

    async def notify(self, method: str, params: dict[str, Any]) -> None:
        await self._write({"jsonrpc": "2.0", "method": method, "params": params})

    async def request(self, method: str, params: dict[str, Any], timeout: float = 60.0) -> dict[str, Any]:
        self._id += 1
        rid = self._id
        fut: asyncio.Future[dict[str, Any]] = asyncio.get_running_loop().create_future()
        self.pending[rid] = fut
        try:
            await self._write({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
            m = await asyncio.wait_for(fut, timeout)
        except asyncio.TimeoutError:
            self.pending.pop(rid, None)
            raise McpError(f"timeout: {method} no reply within {timeout}s")
        except BaseException:
            self.pending.pop(rid, None)
            raise
        if "error" in m:
            raise McpToolError(f"{method}: {m['error'].get('message', m['error'])}")
        return dict(m.get("result") or {})

    async def call_tool(self, name: str, args: dict[str, Any], timeout: float = 60.0) -> McpResult:
        r = await self.request("tools/call", {"name": name, "arguments": args}, timeout)
        texts, imgs = [], []
        for c in r.get("content", []) or []:
            if c.get("type") == "text":
                texts.append(str(c.get("text", "")))
            elif c.get("type") == "image":
                imgs.append({"data": c.get("data", ""), "mime": c.get("mimeType", "image/png")})
        return McpResult("\n".join(texts), imgs, bool(r.get("isError")), r)

    async def stop(self) -> None:
        p = self.proc
        self.dead_reason = self.dead_reason or "stopped"
        self._fail_all()
        if p and p.returncode is None:
            try:
                if p.stdin:
                    p.stdin.close()
                await asyncio.wait_for(p.wait(), 2.0)
            except Exception:  # noqa: BLE001
                try:
                    p.kill()
                except Exception:  # noqa: BLE001
                    pass
        for t in self._tasks:
            t.cancel()


# --------------------------------------------------------------------------------------------------------------------- snapshot parsing
def _unq(s: str) -> str:
    return s.replace('\\"', '"').replace("\\\\", "\\")


def parse_snapshot(text: str) -> list[dict[str, Any]]:
    """`uid=1_3 button "Delete" focusable url="..."` (2 spaces per depth) -> flat node list with parent chain."""
    nodes: list[dict[str, Any]] = []
    stack: list[tuple[int, int]] = []  # (depth, node index)
    for raw in text.splitlines():
        m = LINE_RX.match(raw)
        if not m:
            continue
        depth = len(m.group("indent")) // 2
        props: dict[str, Any] = {}
        for pm in PROP_RX.finditer(m.group("rest") or ""):
            if pm.group(1):
                props[pm.group(1)] = _unq(pm.group(2))
            elif pm.group(3) and not pm.group(3).startswith("["):
                props[pm.group(3)] = True
        role = (m.group("role") or "StaticText").strip()
        while stack and stack[-1][0] >= depth:
            stack.pop()
        parent = stack[-1][1] if stack else -1
        nodes.append({"uid": m.group("uid"), "role": role, "name": _unq(m.group("name") or ""), "props": props, "depth": depth, "parent": parent})
        stack.append((depth, len(nodes) - 1))
    return nodes


def _fnv(s: str) -> str:
    h = 0xCBF29CE484222325
    for ch in s.encode("utf-8"):
        h = ((h ^ ch) * 0x100000001B3) & 0xFFFFFFFFFFFFFFFF
    return f"{h:016x}"[:12]


def select_elements(nodes: list[dict[str, Any]], max_elements: int = 200) -> list[dict[str, Any]]:
    """Keep actionable / structural nodes; give each a content-based stable_key (role + name + container chain + nth) that survives uid renumbering."""
    keep: list[dict[str, Any]] = []
    seen: dict[str, int] = {}
    row_counter = 0
    for i, n in enumerate(nodes):
        role = n["role"].lower()
        p = n["props"]
        actionable = role in INTERACTIVE_ROLES or p.get("focusable") is True or "url" in p
        if role in ("statictext", "generic", "none", "ignored", "paragraph", "rootwebarea", "document") and not p.get("focusable"):
            actionable = False
        if role == "heading" and not n["name"]:
            actionable = False
        if not actionable:
            continue
        chain: list[str] = []
        j = n["parent"]
        while j >= 0 and len(chain) < 4:
            pn = nodes[j]
            if pn["role"].lower() in CONTAINER_ROLES or pn["name"]:
                chain.append(f"{pn['role']}:{pn['name'][:24]}")
            j = pn["parent"]
        base = f"{role}|{n['name'][:60]}|{'>'.join(reversed(chain))}"
        k = seen.get(base, 0)
        seen[base] = k + 1
        zone = "Other"
        anc = [nodes[x] for x in _ancestors(nodes, i)]
        if role in ROW_ROLES or any(a["role"].lower() in ROW_ROLES for a in anc):
            zone = "Row"
        if any(a["role"].lower() in MODAL_ROLES for a in anc) or role in MODAL_ROLES:
            zone = "Modal"
        elif zone == "Other" and any(a["role"].lower() in TOOLBAR_ROLES for a in anc):
            zone = "Toolbar"
        row: Optional[int] = None
        if role in ROW_ROLES:
            row_counter += 1
            row = row_counter
        elif zone == "Row":
            row = row_counter or None
        states = [s for s in ("focused", "disabled", "checked", "selected", "expanded", "pressed", "required", "invalid", "readonly") if p.get(s) is True or (p.get(s) == "true")]
        val = p.get("value") if isinstance(p.get("value"), str) else None
        keep.append({"idx": i, "uid": n["uid"], "role": n["role"], "name": n["name"], "value": val, "states": states, "zone": zone, "row": row,
                     "stable_key": f"{_fnv(base)}:{k}", "url": p.get("url")})
        if len(keep) >= max_elements:
            break
    return keep


def _ancestors(nodes: list[dict[str, Any]], i: int) -> list[int]:
    out, j = [], nodes[i]["parent"]
    while j >= 0:
        out.append(j)
        j = nodes[j]["parent"]
    return out


# v17.1 (log task #8): "点击第一个" landed on the agent's OWN terminal tab titled `chrome-devtools-mcp`.  Developer / terminal / debugging tabs are never task targets.
DEV_TAB_URL_RX = re.compile(r"^(devtools://|chrome-extension://|chrome://(inspect|extensions|net-internals|version|webrtc-internals)|edge://(inspect|extensions)|view-source:|https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?/(json|devtools)|https?://github\.com/ChromeDevTools/chrome-devtools-mcp)", re.I)
DEV_TAB_TITLE_RX = re.compile(r"^(chrome-devtools-mcp|DevTools\b|Developer Tools|开发者工具|MCP Inspector)|(Windows Terminal|PowerShell|命令提示符|Administrator:)\s*$|^pwsh", re.I)


def is_dev_tab(page: dict[str, Any]) -> bool:
    """True for developer / terminal / debugging tabs (never a user-task target).  DSCU_ALLOW_DEV_TABS=1 disables the filter."""
    if os.environ.get("DSCU_ALLOW_DEV_TABS") == "1":
        return False
    return bool(DEV_TAB_URL_RX.search(str(page.get("url") or ""))) or bool(DEV_TAB_TITLE_RX.search(str(page.get("title") or "")))


def target_pages(pages: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Pages a task may act on; falls back to ALL pages when everything looks like a dev tab (never leaves the engine without a page)."""
    keep = [p for p in pages if not is_dev_tab(p)]
    return keep or list(pages)


def parse_pages(text: str) -> list[dict[str, Any]]:
    out = []
    for line in text.splitlines():
        m = PAGE_RX.match(line)
        if m:
            out.append({"page_id": int(m.group(1)), "url": m.group(2), "selected": "[selected]" in (m.group("rest") or "")})
    return out


def parse_network(text: str) -> list[dict[str, Any]]:
    return [{"reqid": int(a), "method": b, "url": c, "status": d} for a, b, c, d in REQ_RX.findall(text)]


def parse_console(text: str) -> list[dict[str, Any]]:
    out = []
    for line in text.splitlines():
        m = CON_RX.search(line.strip())
        if m:
            out.append({"msgid": int(m.group(1)), "type": m.group(2), "text": m.group(3)[:300]})
    return out


def summarize_diag(net: list[dict[str, Any]], con: list[dict[str, Any]]) -> tuple[str, dict[str, Any]]:
    bad = [r for r in net if (r["status"].isdigit() and int(r["status"]) >= 400) or r["status"].lower().startswith("net::") or "failed" in r["status"].lower()]
    errs = [c for c in con if c["type"] in ("error", "assert") or "exception" in c["text"].lower() or "uncaught" in c["text"].lower()]
    parts = []
    if bad:
        parts.append("网络 4xx/5xx/失败 " + "; ".join(f"{r['status']} {r['method']} {r['url'][:80]}" for r in bad[:6]) + (f" …共{len(bad)}条" if len(bad) > 6 else ""))
    if errs:
        parts.append("JS 错误 " + " | ".join(c["text"][:110] for c in errs[:4]) + (f" …共{len(errs)}条" if len(errs) > 4 else ""))
    if not parts:
        parts.append(f"网络 {len(net)} 条请求无 4xx/5xx，控制台无 JS 异常（页面可能仍在加载 / 登录墙 / 自绘 canvas）")
    return "；".join(parts), {"bad_requests": bad[:12], "console_errors": errs[:8], "requests_total": len(net), "console_total": len(con)}


def to_puppeteer_keys(keys: str) -> list[str]:
    """'ctrl+a' -> ['Control+A'];  'tab tab enter' -> ['Tab','Tab','Enter']."""
    out = []
    for chord in str(keys).split():
        toks = [t for t in chord.split("+") if t] or ["+"]
        mods = [KEYMAP.get(t.lower(), t) for t in toks[:-1]]
        last = toks[-1]
        last = KEYMAP.get(last.lower(), last.upper() if (len(last) == 1 and mods) else last)
        out.append("+".join([*mods, last]))
    return out


# --------------------------------------------------------------------------------------------------------------------- the engine (peer contract)
# --------------------------------------------------------------------------------------------------------------------- v16.1: clean Chrome launcher / PID scope
CLEAN_MODE = "clean-browser-url"
_CLEAN_ALIASES = {"clean", "clean-browser", "cleanurl", "clean-url", "clean-browser-url", "cleanbrowserurl"}
DEFAULT_MODE = CLEAN_MODE
DEFAULT_PORT = 9222
BROWSER_EXES = {"chrome.exe", "msedge.exe", "chrome", "chromium", "google-chrome", "msedge", "brave.exe"}
# Transient navigation noise: the page is simply navigating (e.g. accounts.google.com redirects).  v16.0 treated these as "browser crashed" and respawned the
# whole MCP server (3 restarts in 4 tasks).  v16.1: retry in place, never restart.
TRANSIENT_TEXT_RX = re.compile(r"Execution context was destroyed|Navigating frame was detached|Cannot find context|Frame was detached|detached Frame|"
                               r"Inspected target navigated|Target.*navigat|net::ERR_ABORTED|Most likely the page has been closed.*navigat", re.I)


def normalize_mode(mode: Optional[str]) -> str:
    m = (mode or "").strip().lower().replace("_", "-")
    if not m:
        return DEFAULT_MODE
    if m in _CLEAN_ALIASES:
        return CLEAN_MODE
    if m in ("autoconnect", "auto-connect"):
        return "autoconnect"
    if m in ("browser-url", "browserurl"):
        return "browser-url"
    if m in ("ws", "ws-endpoint"):
        return "ws"
    if m in ("isolated", "profile"):
        return m
    return DEFAULT_MODE


def clean_profile_dir(env: Optional[dict[str, str]] = None) -> str:
