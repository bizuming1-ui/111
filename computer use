def extract_json(text: str) -> dict[str, Any]:
    """Models sometimes emit several JSON objects or fenced blocks: take the first balanced object."""
    t = text.strip()
    t = re.sub(r"^```(?:json)?|```$", "", t, flags=re.M).strip()
    start = t.find("{")
    if start < 0:
        raise ValueError("no JSON object in model output")
    depth, in_str, esc = 0, False, False
    for i in range(start, len(t)):
        c = t[i]
        if in_str:
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return json.loads(t[start:i + 1])
    raise ValueError("unbalanced JSON in model output")


class DeepSeek:
    def __init__(self, api_key: str, base_url: str = "https://api.deepseek.com", chat_model: str = "deepseek-chat", vision_model: str = "deepseek-flash") -> None:
        if not api_key:
            raise ApiKeyError("缺少 DeepSeek API Key")
        self.key, self.base = api_key, base_url.rstrip("/")
        self.chat_model, self.vision_model = chat_model, vision_model
        self.client = httpx.AsyncClient(timeout=httpx.Timeout(75.0, connect=10.0), headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}, http2=False)
        self.calls = 0
        self.vision_failures = 0

    async def aclose(self) -> None:
        await self.client.aclose()

    def payload(self, messages: list[dict[str, Any]], model: str, max_tokens: int, json_mode: bool) -> dict[str, Any]:
        p: dict[str, Any] = {"model": model, "messages": messages, "temperature": 0, "max_tokens": max_tokens}
        if json_mode and "reasoner" not in model:
            p["response_format"] = {"type": "json_object"}
        if "reasoner" not in model:
            p["thinking"] = {"type": "disabled"}  # thinking tokens would eat max_tokens -> empty content (v10 log finding)
        return p

    async def chat(self, messages: list[dict[str, Any]], *, vision: bool = False, max_tokens: Optional[int] = None, json_mode: bool = True) -> Reply:
        model = self.vision_model if vision else self.chat_model
        mt = max_tokens or (4096 if vision else 1400)
        bases = [self.base, self.base + "/v1"] if not self.base.endswith("/v1") else [self.base]
        last: Optional[BaseException] = None
        retries = 0
        for attempt in range(4):
            base = bases[min(attempt // 2, len(bases) - 1)]
            t0 = time.perf_counter()
            try:
                r = await self.client.post(f"{base}/chat/completions", json=self.payload(messages, model, mt if attempt < 2 else min(8192, mt * 2), json_mode and attempt < 2))
                if r.status_code in (401, 403):
                    raise ApiKeyError(f"API Key 无效或无权限 (HTTP {r.status_code}): {r.text[:200]}")
                if r.status_code == 429 or r.status_code >= 500:
                    raise ApiError(f"HTTP {r.status_code}: {r.text[:160]}")
                if r.status_code >= 400:
                    raise ApiError(f"HTTP {r.status_code}: {r.text[:300]}")
                d = r.json()
                msg = (d.get("choices") or [{}])[0].get("message", {})
                text = (msg.get("content") or "").strip()
                if not text:
                    raise ApiError(f"EmptyContent finish={(d.get('choices') or [{}])[0].get('finish_reason')}")
                u = d.get("usage", {})
                self.calls += 1
                return Reply(text, model, (time.perf_counter() - t0) * 1000, int(u.get("prompt_tokens", 0)), int(u.get("completion_tokens", 0)),
                             int(u.get("prompt_cache_hit_tokens", 0)), int(u.get("prompt_cache_miss_tokens", 0)), retries, d)
            except ApiKeyError:
                raise
            except (ApiError, httpx.HTTPError, ValueError) as e:
                last = e
                retries += 1
                await asyncio.sleep(min(0.6 * (2 ** attempt), 4.0))
        if vision:
            self.vision_failures += 1
        raise ApiError(f"DeepSeek 调用失败（{retries} 次重试）: {last}")
