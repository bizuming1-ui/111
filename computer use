// snapshot_epoch optimistic lock (v12): every structural page change bumps the epoch; actions carrying a stale expect_epoch get STALE_EPOCH.
export type Check = { ok: true; epoch: number } | { ok: false; code: "STALE_EPOCH"; epoch: number; message: string };
type Bus = { on(ev: string, cb: (p?: unknown) => void): void };
export class EpochLock {
  epoch = 1;
  bumps = 0;
  stale = 0;
  bump(_reason = ""): number { this.bumps++; return ++this.epoch; }
  check(expect?: number | null): Check {
    if (expect == null || expect === this.epoch) return { ok: true, epoch: this.epoch };
    this.stale++;
    return { ok: false, code: "STALE_EPOCH", epoch: this.epoch, message: `snapshot_epoch ${expect} is stale (current ${this.epoch}); re-observe and use fresh refs` };
  }
  attach(cdp: Bus): void {
    for (const ev of ["Page.frameNavigated", "DOM.documentUpdated", "Page.navigatedWithinDocument", "DOM.childNodeRemoved"]) cdp.on(ev, () => this.bump(ev));
  }
}
