"""v18.0 [P0-1] Unified Object Identity — ONE strongly-typed object model for the 7 formerly disconnected locating systems.

    UIA control  ┐
    CDP DOM node │
    DirectML box ├──►  ObjectFusionEngine  ──►  [UnifiedObjectRef]  ──►  ObjectRegistry (epoch-bound)  ──►  ActionGate
    OCR line     │        IoU + containment            object_id + snapshot_epoch are the ONLY way to address a click /
    SoM index    ┘        + text similarity            check / type / scroll.  Pure-visual candidates never get destructive authority.

Pure Python (no Windows API): fully unit-testable on any OS.  Rect convention everywhere: [x, y, w, h] in `coordinate_space` pixels.
"""
from __future__ import annotations

import difflib
import hashlib
import re
import time
import unicodedata
from dataclasses import dataclass, field
from typing import Any, Iterable, Optional

Rect = tuple  # (x, y, w, h)

ACTION_ROLES = ("target", "trigger", "navigation", "container")
SOURCES = ("dom", "uia", "dml", "ocr", "som")
# prior reliability of each channel (used for noisy-OR confidence fusion).  Structured channels are near-certain; pixels are not.
SOURCE_WEIGHT = {"dom": 0.98, "uia": 0.95, "dml": 0.60, "ocr": 0.55, "som": 0.30}
SOURCE_PRIORITY = {"dom": 0, "uia": 1, "dml": 2, "ocr": 3, "som": 4}
STRUCTURED = ("dom", "uia")

TRIGGER_NAME_RX = re.compile(
    r"删除|刪除|移除|垃圾桶|垃圾箱|移至垃圾|归档|封存|存档|发送|發送|发出|提交|确认|确定|保存|下一步|"
    r"delete|remove|trash|bin\b|archive|send|submit|confirm|save|ok\b|apply|move to", re.I)
CONTAINER_ROLES = {"list", "listbox", "table", "grid", "tree", "toolbar", "menu", "menubar", "group", "pane", "window", "document", "tablist", "region", "main", "navigation"}
TARGET_ROLES = {"row", "listitem", "dataitem", "treeitem", "gridcell", "cell", "checkbox", "image", "text", "edit", "file", "article", "link-row"}
NAV_ROLES = {"tab", "tabitem", "link", "hyperlink", "menuitem-nav"}
TRIGGER_ROLES = {"button", "splitbutton", "menuitem", "toolbarbutton", "pushbutton", "icon"}


# ---------------------------------------------------------------------------------------------------------------- helpers
def norm(s: Any) -> str:
    s = unicodedata.normalize("NFKC", str(s or ""))
    s = re.sub(r"[\u200b\u200c\u200d\ufeff]", "", s)
    return re.sub(r"\s+", "", s).casefold()


def text_sim(a: str, b: str) -> float:
    """Semantic text similarity in [0,1]: exact / containment / difflib ratio on CJK-safe normalised strings."""
    x, y = norm(a), norm(b)
    if not x or not y:
        return 0.0
    if x == y:
        return 1.0
    if x in y or y in x:
        return 0.6 + 0.4 * (min(len(x), len(y)) / max(len(x), len(y)))
    return difflib.SequenceMatcher(None, x, y).ratio()


def rect_area(r: Iterable[float]) -> float:
    x, y, w, h = r
    return max(0.0, w) * max(0.0, h)


def intersection(a: Iterable[float], b: Iterable[float]) -> float:
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    iw = min(ax + aw, bx + bw) - max(ax, bx)
    ih = min(ay + ah, by + bh) - max(ay, by)
    return max(0.0, iw) * max(0.0, ih)


def iou(a: Iterable[float], b: Iterable[float]) -> float:
    inter = intersection(a, b)
    union = rect_area(a) + rect_area(b) - inter
    return inter / union if union > 0 else 0.0


def containment(inner: Iterable[float], outer: Iterable[float]) -> float:
    """fraction of `inner` that lies inside `outer`"""
    ai = rect_area(inner)
    return intersection(inner, outer) / ai if ai > 0 else 0.0


def center(r: Iterable[float]) -> tuple:
    x, y, w, h = r
    return x + w / 2.0, y + h / 2.0


def point_in(r: Iterable[float], px: float, py: float, tol: float = 0.0) -> bool:
    x, y, w, h = r
    return x - tol <= px <= x + w + tol and y - tol <= py <= y + h + tol


def _ident_hash(*parts: Any) -> str:
    return hashlib.sha1("\x1f".join(str(p) for p in parts).encode("utf-8")).hexdigest()[:12]


