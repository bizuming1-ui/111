    "记事本": ("notepad.exe",), "notepad": ("notepad.exe",), "计算器": ("calculatorapp.exe", "calc.exe", "calculator.exe"), "calc": ("calculatorapp.exe", "calc.exe"),
    "calculator": ("calculatorapp.exe", "calc.exe"), "画图": ("mspaint.exe",), "paint": ("mspaint.exe",), "mspaint": ("mspaint.exe",),
    "资源管理器": ("explorer.exe",), "文件资源管理器": ("explorer.exe",), "explorer": ("explorer.exe",), "file explorer": ("explorer.exe",),
    "word": ("winword.exe",), "excel": ("excel.exe",), "powerpoint": ("powerpnt.exe",), "ppt": ("powerpnt.exe",), "outlook": ("outlook.exe", "olk.exe"),
    "qq": ("qq.exe",), "钉钉": ("dingtalk.exe",), "dingtalk": ("dingtalk.exe",), "vscode": ("code.exe",), "visual studio code": ("code.exe",),
    "任务管理器": ("taskmgr.exe",), "终端": ("windowsterminal.exe",), "windows terminal": ("windowsterminal.exe",),
}
BROWSER_FAMILY = {"chrome.exe": "chrome", "msedge.exe": "edge", "firefox.exe": "firefox", "brave.exe": "brave", "opera.exe": "opera", "vivaldi.exe": "vivaldi"}
SHELL_CLASSES = ("Progman", "WorkerW", "Shell_TrayWnd", "Shell_SecondaryTrayWnd")


def normalize(q: str) -> str:
    """lower-case, strip zero-width / nbsp characters and collapse whitespace."""
    return re.sub(r"\s+", " ", str(q or "").translate(_ZW)).strip().lower()


def process_names_for(query: str) -> list[str]:
    """'Microsoft Edge' / 'edge浏览器' / 'msedge' -> ['msedge.exe'];  'foo.exe' -> ['foo.exe'];  unknown 'winword' -> ['winword.exe']."""
    q = normalize(query)
    if not q:
        return []
    if q in PROC_ALIASES:
        return list(PROC_ALIASES[q])
    if q.endswith(".exe"):
        return [q]
    hits: list[str] = []
    for k in sorted(PROC_ALIASES, key=len, reverse=True):  # longest alias first so 'microsoft edge' wins over 'edge'
        if len(k) >= 3 and k in q:
            for n in PROC_ALIASES[k]:
                if n not in hits:
                    hits.append(n)
            break
    if hits:
        return hits
    if re.fullmatch(r"[a-z0-9_.\-]{2,40}", q):
        return [q + ".exe"]
    return []


def rank_main_window(windows: list[dict], pids: set[int], names: set[str]) -> list[dict]:
    """Pick the *main* visible window(s) of a process: owner pid / exe-name match, not the agent console, not a shell window; titled > untitled; larger first;
    z-order (0 = top) breaks ties.  Input items are the driver's window dicts (hwnd,title,class,process,pid,rect,z,minimized,cloaked,own_console)."""
    out = []
    for w in windows:
        if w.get("own_console") or w.get("cloaked") or (w.get("class") or "") in SHELL_CLASSES:
            continue
        if not (int(w.get("pid") or 0) in pids or normalize(w.get("process", "")) in names):
            continue
        r = w.get("rect") or [0, 0, 0, 0]
        area = max(0, int(r[2])) * max(0, int(r[3]))
        out.append((0 if w.get("title") else 1, 0 if not w.get("minimized") else 1, -area, int(w.get("z", 0)), w))
    out.sort(key=lambda t: t[:4])
    return [t[4] for t in out]
