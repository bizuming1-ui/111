def norm_text(s: str) -> str:
    s = unicodedata.normalize("NFKC", s or "")
    s = re.sub(r"[\u200b\u200c\u200d\ufeff]", "", s)
    return re.sub(r"\s+", " ", s).strip()


GROUP_TITLE = re.compile(r"[（(]\s*\d{1,4}\s*[)）]\s*$|群聊|群公告|群成员")
SEND_NAMES = ("发送", "send", "发送(s)", "发送（s）")


def _els(elements: Iterable[Any]) -> list:
    return list(elements or [])


def _geti(e: Any, k: str, d: Any = "") -> Any:
    return getattr(e, k, None) if not isinstance(e, dict) else e.get(k, d)


@dataclass
class MessageSession:
    """Evidence ledger of ONE messaging task; consumed by MessageSendGoal."""
    request: MessageRequest
    chat_hwnd: int = 0
    contact_frozen: bool = False
    contact_evidence: str = ""
    single_chat: bool = False
    single_chat_evidence: str = ""
    draft_readback: str = ""
    draft_ok: bool = False
    draft_source: str = ""
    hitl_confirmed: bool = False
    send_issued: bool = False
    send_step: int = -1
    bubble_verified: bool = False  # v17.1: set by WeChatSkill after the DML+OCR bubble proof
    bubble_evidence: str = ""
    bubble_source: str = ""
    notes: list = field(default_factory=list)

    # -- 1) freeze the contact: chat header (window title / header element) must name the recipient
    def freeze_contact(self, window_title: str, elements: Iterable[Any], win_rect: Optional[tuple] = None) -> bool:
        r = norm_text(self.request.recipient)
        if not r:
            return False
        if r and r in norm_text(window_title) and norm_text(window_title) not in ("微信", "weixin", "wechat"):
            self.contact_frozen, self.contact_evidence = True, f"窗口标题含联系人「{r}」"
            return True
        top_limit = (win_rect[1] + max(120, int(win_rect[3] * 0.18))) if win_rect else 10 ** 9
        for e in _els(elements):
            name = norm_text(str(_geti(e, "name", "") or _geti(e, "value", "")))
            rect = _geti(e, "rect", None) or [0, 0, 0, 0]
            y = rect[1] if rect else 0
            if name and (name == r or name.startswith(r)) and y <= top_limit and str(_geti(e, "role", "")).lower() in ("text", "title", "header", "heading", "button", "static", "statictext", "textblock", "label", "pane", ""):
                self.contact_frozen, self.contact_evidence = True, f"聊天头部控件「{name[:24]}」(y={y}) == 联系人"
                return True
        return False

    # -- 2) single chat: header equals the recipient exactly (no "(N)" member suffix, no group markers)
    def confirm_single_chat(self, window_title: str, elements: Iterable[Any]) -> bool:
        r = norm_text(self.request.recipient)
        titles = [norm_text(window_title)] + [norm_text(str(_geti(e, "name", ""))) for e in _els(elements) if norm_text(str(_geti(e, "name", ""))).startswith(r)][:6]
        heads = [t for t in titles if r and r in t]
        if not heads:
            return False
        if any(GROUP_TITLE.search(t) for t in heads):
            self.single_chat, self.single_chat_evidence = False, f"检测到群聊标记：{heads[0][:30]}"
            return False
        self.single_chat, self.single_chat_evidence = True, f"头部「{heads[0][:24]}」无群成员数后缀 → 单聊"
        return True

    # -- 3) draft read-back (UIA ValuePattern / element value): normalised equality with the body
    def readback_draft(self, elements: Iterable[Any]) -> bool:
        want = norm_text(self.request.body)
        for e in _els(elements):
            role = str(_geti(e, "role", "")).lower()
            val = norm_text(str(_geti(e, "value", "")))
            nm = norm_text(str(_geti(e, "name", "")))
            if role in ("edit", "textbox", "document", "input", "text", "textarea", "") and (val or nm):
                cand = val or nm
                if cand == want:
                    self.draft_readback, self.draft_ok, self.draft_source = cand, True, "uia_value"
                    return True
                if val and role in ("edit", "textbox", "document", "textarea") and want in val and val != want:
                    self.draft_readback, self.draft_ok, self.draft_source = val, False, "uia_value(多余内容)"
        return False

    def bubble_present(self, elements: Iterable[Any]) -> bool:
        want = norm_text(self.request.body)
        for e in _els(elements):
            role = str(_geti(e, "role", "")).lower()
            txt = norm_text(str(_geti(e, "name", "")) + " " + str(_geti(e, "value", "")))
            if want and want in txt and role not in ("edit", "textbox", "textarea", "input"):
                return True
        return False

    def as_dict(self) -> dict:
        return {k: getattr(self, k) for k in ("chat_hwnd", "contact_frozen", "contact_evidence", "single_chat", "single_chat_evidence", "draft_readback", "draft_ok",
                                               "draft_source", "hitl_confirmed", "send_issued")} | {"recipient": self.request.recipient, "body": self.request.body}


def is_send_action(action: dict[str, Any], els: Optional[dict] = None) -> bool:
    """True for the keystroke / click that would actually SEND the message."""
    name = str(action.get("action", ""))
    if name == "key":
        ks = str(action.get("keys", "")).lower().replace(" ", "")
        return ks in ("enter", "return", "ctrl+enter", "alt+s")
    if name == "type" and action.get("enter"):
        return True
    if name in ("click", "invoke") and els and action.get("id") is not None and action["id"] in els:
        nm = norm_text(str(getattr(els[action["id"]], "name", ""))).lower()
        return any(nm == s or nm.startswith(s) for s in SEND_NAMES)
    return False


def provenance_ok(text: str, req: MessageRequest) -> bool:
    """`type` text must be the recipient (search) or the body (draft) — or a substring/superstring of them (IME / partial typing)."""
    t = norm_text(text)
    if not t:
        return True
    for src in (req.recipient, req.body):
        s = norm_text(src)
        if s and (t == s or t in s or (s in t and len(t) <= len(s) + 2)):
            return True
    return False
