        unsafe {
            let link: IShellLinkW = CoCreateInstance(&ShellLink, None, CLSCTX_INPROC_SERVER).ok()?;
            let pf: IPersistFile = windows::core::Interface::cast(&link).ok()?;
            pf.Load(PCWSTR(w(path).as_ptr()), STGM_READ).ok()?;
            let mut buf = [0u16; MAX_PATH as usize]; let mut fd = WIN32_FIND_DATAW::default();
            link.GetPath(&mut buf, &mut fd, 0).ok()?;
            let t = s16(&buf); if t.is_empty() { None } else { Some(t) }
        }
    }
    fn walk_lnk(dir: &std::path::Path, out: &mut Vec<Entry>, budget: &mut usize) {
        let Ok(rd) = std::fs::read_dir(dir) else { return };
        for e in rd.flatten() {
            if *budget == 0 { return; }
            let p = e.path();
            if p.is_dir() { walk_lnk(&p, out, budget); continue; }
            if p.extension().map(|x| x.eq_ignore_ascii_case("lnk")).unwrap_or(false) {
                *budget -= 1;
