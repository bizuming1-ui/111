//! 24GB-UMA guards. Same state machine as `Update-MemoryGuard` / `Test-UmaMemoryHealth` of the client:
//! trip when available RAM < floor (MemoryFloorMB=4096); recover only at floor + 768MB hysteresis.
//! Sidecar idle TTL (SidecarIdleTtlSec=180) is tracked here as a pure function of a caller-supplied clock.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Transition {
    None,
    Tripped,
    Recovered,
}

pub struct MemGuard {
    pub floor_mb: u64,
    pub hysteresis_mb: u64,
    pub tripped: bool,
    pub trips: u32,
    pub min_seen_mb: u64,
}

impl MemGuard {
    pub fn new(floor_mb: u64) -> Self {
        MemGuard { floor_mb: floor_mb.max(1024), hysteresis_mb: 768, tripped: false, trips: 0, min_seen_mb: u64::MAX }
    }
    pub fn update(&mut self, avail_mb: u64) -> Transition {
        self.min_seen_mb = self.min_seen_mb.min(avail_mb);
        if !self.tripped && avail_mb < self.floor_mb {
            self.tripped = true;
            self.trips += 1;
            Transition::Tripped
        } else if self.tripped && avail_mb >= self.floor_mb + self.hysteresis_mb {
            self.tripped = false;
            Transition::Recovered
        } else {
            Transition::None
        }
    }
    /// While tripped the driver caps captured pixels (UMA bandwidth) and refuses to host the local vision sidecar.
    pub fn max_capture_pixels(&self) -> u64 {
        if self.tripped { 1920 * 1080 } else { 33_177_600 }
    }
}

pub struct SidecarTtl {
    pub ttl_ms: u64,
    pub loaded: bool,
    last_touch_ms: u64,
}

impl SidecarTtl {
    pub fn new(ttl_sec: u64) -> Self {
        SidecarTtl { ttl_ms: ttl_sec.max(10) * 1000, loaded: false, last_touch_ms: 0 }
    }
    pub fn touch(&mut self, now_ms: u64) {
        self.loaded = true;
        self.last_touch_ms = now_ms;
    }
    /// Returns true exactly once when the sidecar must be unloaded (idle TTL elapsed, or `force` on memory trip).
    pub fn should_unload(&mut self, now_ms: u64, force: bool) -> bool {
        if self.loaded && (force || now_ms.saturating_sub(self.last_touch_ms) >= self.ttl_ms) {
            self.loaded = false;
            return true;
        }
        false
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn hysteresis() {
        let mut g = MemGuard::new(4096);
        assert_eq!(g.update(8000), Transition::None);
        assert_eq!(g.update(4000), Transition::Tripped);
        assert_eq!(g.update(4500), Transition::None); // < 4096+768
        assert_eq!(g.update(4864), Transition::Recovered);
        assert_eq!(g.trips, 1);
    }
    #[test]
    fn sidecar_ttl() {
        let mut s = SidecarTtl::new(180);
        s.touch(1_000);
        assert!(!s.should_unload(100_000, false));
        assert!(s.should_unload(181_000, false));
        assert!(!s.should_unload(400_000, false));
        s.touch(500_000);
        assert!(s.should_unload(500_001, true));
    }
}
