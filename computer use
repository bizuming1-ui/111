                let arr = if v.is_array() { v.as_array().cloned().unwrap_or_default() } else { vec![v] };
                for a in arr { let id = a["AppID"].as_str().unwrap_or(""); if !id.is_empty() && !id.to_lowercase().ends_with(".exe") && !id.contains(":\\") { out.push(Entry { name: a["Name"].as_str().unwrap_or("").into(), source: "aumid".into(), aumid: id.into(), ..Default::default() }); } }
