class FakeBackend(RB.ShellBackend):
    def __init__(self, items, wins=()):  # noqa: ANN001
        self.items = list(items)
        self.wins = list(wins)
        self.deleted: list[str] = []
        self.restored: list[str] = []

    def list_items(self):
        return list(self.items)

    def windows(self):
        return list(self.wins)

    def count_api(self):
        return len(self.items)

    def delete_store(self, item):  # noqa: ANN001
        self.items = [i for i in self.items if i.bin_path != item.bin_path]
        self.deleted.append(item.bin_path)
        return True, "fake delete"

    def restore(self, item):  # noqa: ANN001
        self.items = [i for i in self.items if i.bin_path != item.bin_path]
        self.restored.append(item.bin_path)
        return True, "fake restore"


