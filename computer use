# ====================================================================================================================== authorization
@dataclass
class AuthDecision:
    kind: str          # allow | confirm | deny
    code: str = "OK"
    reason: str = ""


class AuthorizationPolicy:
    """Reversible → allow.  Irreversible → explicit text authorization ∧ identity ∈ frozen set ∧ (broad selection → human confirmation)."""

    def __init__(self, mode: Optional[str] = None, broad_threshold: int = 5) -> None:
        m = (mode or os.environ.get("DSCU_IRREVERSIBLE_CONFIRM", "auto")).strip().lower()
        self.mode = m if m in ("auto", "always", "never") else "auto"
        self.broad = broad_threshold

    def decide(self, tx: ActionTransaction, *, authorized_text: bool, frozen_ids: set[str], selection_size: int, select_all: bool = False) -> AuthDecision:
        if tx.reversibility is Reversibility.REVERSIBLE:
            return AuthDecision("allow")
        if not authorized_text:
            return AuthDecision("deny", "SECURITY_DENIED", f"{tx.op} 不可逆，但任务原文没有明确授权（需要『回收站里…删除』/『永久』/『彻底』等明确措辞）")
        if tx.target is None or tx.target.identity not in frozen_ids:
            return AuthDecision("deny", "OBJECT_IDENTITY_MISMATCH", "目标对象不在本目标冻结的身份集合内，拒绝执行不可逆操作（绝不通过换目标来凑完成）")
        if self.mode == "always" or (self.mode == "auto" and (select_all or selection_size > self.broad)):
            return AuthDecision("confirm", "NEEDS_CONFIRMATION", f"不可逆操作涉及 {selection_size} 个对象{'（全选）' if select_all else ''}，需要人工确认一次")
        return AuthDecision("allow")


# ====================================================================================================================== ledger
class TxLedger:
    """Append-only journal; `committed(key)` powers idempotency.  File optional (tests use memory only)."""

    def __init__(self, path: Optional[Path] = None) -> None:
        self.path = Path(path) if path else None
        self.mem: list[dict[str, Any]] = []
        self._committed: dict[str, dict[str, Any]] = {}
        if self.path and self.path.exists():
            try:
                for ln in self.path.read_text(encoding="utf-8").splitlines():
                    r = json.loads(ln)
                    if r.get("phase") == "committed":
                        self._committed[r["key"]] = r
            except (OSError, ValueError):
                pass

    def append(self, phase: str, tx: ActionTransaction, **kw: Any) -> None:
        rec = {"t": round(time.time(), 3), "phase": phase, "key": tx.key, "goal": tx.goal_id, "op": tx.op, "target": tx.target.identity if tx.target else tx.note,
               "rev": tx.reversibility.value, **kw}
        self.mem.append(rec)
        if phase == "committed":
            self._committed[tx.key] = rec
        if self.path:
            try:
                self.path.parent.mkdir(parents=True, exist_ok=True)
                with open(self.path, "a", encoding="utf-8") as f:
                    f.write(json.dumps(rec, ensure_ascii=False, default=str) + "\n")
                    f.flush()
                    os.fsync(f.fileno())
            except OSError:
                pass

    def committed(self, key: str) -> Optional[dict[str, Any]]:
        return self._committed.get(key)

    def committed_ids(self, goal_id: str) -> set[str]:
        return {r["target"] for r in self._committed.values() if r.get("goal") == goal_id}


ConfirmFn = Callable[[str], Awaitable[bool]]


def _code_from_message(msg: str) -> str:
    m = re.search(r"\[([A-Z_]{4,32})\]", msg or "")
    return m.group(1) if m else "INTERNAL"


class TxEngine:
    def __init__(self, ledger: Optional[TxLedger] = None, policy: Optional[AuthorizationPolicy] = None, confirm: Optional[ConfirmFn] = None) -> None:
        self.ledger = ledger or TxLedger()
        self.policy = policy or AuthorizationPolicy()
        self.confirm = confirm
        self.confirmed_goals: set[str] = set()
        self.stats = {"committed": 0, "replayed": 0, "precondition_failed": 0, "denied": 0, "declined": 0, "no_effect": 0, "failed": 0}

    def _finish(self, tx: ActionTransaction, st: TxStatus, code: str, msg: str, rows: Rows, t0: float) -> TxResult:
        self.stats[st.value] = self.stats.get(st.value, 0) + 1
        self.ledger.append(st.value if st is not TxStatus.COMMITTED else "committed", tx, code=code, msg=msg[:200])
        return TxResult(st, code, msg, rows, tx.key, (time.perf_counter() - t0) * 1000)

    async def run(self, tx: ActionTransaction, *, authorized_text: bool = False, frozen_ids: Optional[set[str]] = None, selection_size: int = 1, select_all: bool = False) -> TxResult:
        t0 = time.perf_counter()
        # ---------------- idempotency
        prev = self.ledger.committed(tx.key)
        if prev is not None:
            if tx.postcondition is not None:
                try:
                    rows = await asyncio.to_thread(tx.postcondition, None)
                except Exception:  # noqa: BLE001
                    rows = []
                if rows and all(r["ok"] for r in rows if r.get("evaluated", True)):
                    self.stats["replayed"] += 1
                    return TxResult(TxStatus.REPLAYED, "OK", "幂等重放：该事务已提交且独立 Oracle 仍成立，不重复执行", rows, tx.key, 0.0)
            if tx.reversibility is Reversibility.IRREVERSIBLE:
                return self._finish(tx, TxStatus.DENIED, "IRREVERSIBLE_REPLAY", "不可逆事务已提交过，拒绝重放（防止重复删除/发送）", [], t0)
        # ---------------- PREPARE
        for pc in tx.preconditions:
            ok, code, detail = await asyncio.to_thread(pc.check)
            if not ok:
                return self._finish(tx, TxStatus.PRECONDITION_FAILED, code, f"前置条件 {pc.name} 未满足：{detail}", [row(pc.name, False, detail, source="WorldModel")], t0)
        dec = self.policy.decide(tx, authorized_text=authorized_text, frozen_ids=frozen_ids or set(), selection_size=selection_size, select_all=select_all)
        if dec.kind == "deny":
            return self._finish(tx, TxStatus.DENIED, dec.code, dec.reason, [row("authorization", False, dec.reason, source="AuthorizationPolicy")], t0)
        if dec.kind == "confirm" and tx.goal_id not in self.confirmed_goals:
            ok = bool(await self.confirm(dec.reason)) if self.confirm else False
            if not ok:
                return self._finish(tx, TxStatus.DECLINED, "USER_DECLINED", "用户未确认不可逆操作 → 不执行", [row("human_confirmation", False, dec.reason, source="HITL")], t0)
            self.confirmed_goals.add(tx.goal_id)
        ctx = await asyncio.to_thread(tx.before) if tx.before else None
        ids_before = await asyncio.to_thread(tx.delta.snapshot) if tx.delta else None
        self.ledger.append("prepared", tx)
        # ---------------- COMMIT
        try:
            ok, msg = await asyncio.to_thread(tx.execute)
        except Exception as e:  # noqa: BLE001
            ok, msg = False, f"[INTERNAL] {e.__class__.__name__}: {str(e)[:160]}"
        self.ledger.append("executed", tx, ok=ok, msg=str(msg)[:160])
        rows: Rows = []
        if tx.postcondition is not None:
            try:
                rows += await asyncio.to_thread(tx.postcondition, ctx)
            except Exception as e:  # noqa: BLE001
                rows.append(row("postcondition", False, f"oracle 异常 {e.__class__.__name__}: {str(e)[:100]}"))
        if tx.delta is not None and ids_before is not None:
            after = await asyncio.to_thread(tx.delta.snapshot)
            rows.append(tx.delta.verify(ids_before, after))
        bad = [r for r in rows if r.get("evaluated", True) and not r["ok"]]
        if not ok:
            code = _code_from_message(str(msg))
            if not bad:   # executor said no but the world did change as declared → trust the oracle, report the discrepancy
                return self._finish(tx, TxStatus.COMMITTED, "OK", f"执行器报告失败（{str(msg)[:80]}）但独立 Oracle 证明世界已按预期变化", rows, t0)
            return self._finish(tx, TxStatus.FAILED, code, str(msg), rows, t0)
        if bad:
            return self._finish(tx, TxStatus.NO_EFFECT, "ACTION_NO_EFFECT", "动作执行成功但独立 Oracle 未证明世界变化：" + "；".join(f"{r['name']}:{str(r['detail'])[:60]}" for r in bad), rows, t0)
        return self._finish(tx, TxStatus.COMMITTED, "OK", str(msg), rows, t0)
