@dataclass(frozen=True)
class MessageRequest:
    recipient: str = ""
    body: str = ""
    app: str = "wechat"
    raw: str = ""

    @property
    def missing(self) -> tuple:
        return tuple(k for k, v in (("recipient", self.recipient), ("body", self.body)) if not v.strip())

    @property
    def complete(self) -> bool:
        return not self.missing


@dataclass
class ClarifyResult:
    status: str  # ok | needs_clarification
    request: MessageRequest
    missing: tuple = ()
    question: str = ""


def _clean(s: str) -> str:
    return unicodedata.normalize("NFKC", s).strip().strip("，,。.！!？? \t\r\n") if s else ""


def _is_generic(b: str) -> bool:
    x = _clean(b).lower()
    x = re.sub(r"^(?:一条|一个|个|条)", "", x)
    return (not x) or x in GENERIC_BODY or bool(re.fullmatch(r"(?:一条|一个|个|条|些|几)?(?:信息|消息|微信|短信|句话|段话|内容)", x))


def is_message_task(task: str) -> bool:
    t = task.strip()
    if NOT_MSG.search(t):
        return False
    return bool(MSG_INTENT.search(t))


def parse_message_request(task: str) -> Optional[MessageRequest]:
    """None => not a messaging task.  Otherwise a (possibly incomplete) request; NEVER invents a recipient or body."""
    if not is_message_task(task):
        return None
    t = PREFIX.sub("", task.strip())
    recipient = ""
    for p in RECIPIENT_PATS:
        m = p.search(t)
        if m:
            r = _clean(m.group("r"))
            r = re.sub(r"(?:的)?(?:微信|聊天|对话|窗口)$", "", r)
            r = re.sub(r"^(?:微信联系人|微信好友|联系人|好友)\s*[:：是为]?\s*", "", r)  # v18: role words are not part of the name
            if r and r not in ("他", "她", "ta", "TA", "对方", "别人", "某人", "朋友", "好友", "联系人", "人") and not _is_generic(r):
                recipient = r
                break
    body = ""
    for p in BODY_PATS:
        m = p.search(t)
        if m:
            b = _clean(m.group("b"))
            if recipient and b.startswith(recipient):
                b = _clean(b[len(recipient):])
            if b and not _is_generic(b) and b != recipient:
                body = b
                break
    return MessageRequest(recipient=recipient, body=body, raw=task)


def clarify(task: str) -> Optional[ClarifyResult]:
    """Hard precondition (MessageSendGoal): None => not messaging; else status ok / needs_clarification."""
    req = parse_message_request(task)
    if req is None:
        return None
    if req.complete:
        return ClarifyResult("ok", req)
    ask = []
    if "recipient" in req.missing:
        ask.append("收件联系人（发给谁）")
    if "body" in req.missing:
        ask.append("消息正文（具体发什么）")
    q = ("NEEDS_CLARIFICATION：任务缺少 " + " 与 ".join(ask) + "。为防止发错人或擅自补全内容（例如凭空补一句“你好”），系统不会自行猜测，也没有执行任何界面操作。\n"
         "请用完整句子重新下达，例如：给老虎不抓鼠发消息：晚上七点开会")
    return ClarifyResult("needs_clarification", req, req.missing, q)


