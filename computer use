    fn locks_for(&self, req: &Request) -> Locks {
        let get = |k: &str| req.params.get(k).or_else(|| req.top.get(k));
        let expect_hwnd = get("expect_hwnd").and_then(|v| v.as_i64().or_else(|| v.as_str().and_then(|s| s.parse().ok())));
        let expect_fp = get("expect_fp").and_then(|v| v.as_str()).map(|s| s.to_string());
        let mut l = Locks { expect_hwnd, expect_fp: expect_fp.clone(), ..Default::default() };
        if expect_hwnd.is_some() {
            l.cur_hwnd = Some(self.platform.foreground());
        }
        if expect_fp.is_some() {
            let scr = self.platform.screen_rect();
            let r = req.params.get("expect_region").map(|e| region(e, scr)).unwrap_or(scr);
            if let Ok(f) = self.platform.capture_frame(r, 16, false) {
                l.cur_fp = ahash_hex(&f.sig);
