if (-not $NoStart) {
    if ($exe -and $IsWindows -and -not (Get-Process dscu-driver -ErrorAction SilentlyContinue)) { Start-Process $exe -ArgumentList 'serve' -WindowStyle Hidden; Start-Sleep -Milliseconds 600 }
    if ($IsWindows) { Rec 'Named Pipe \\.\pipe\dscu-driver-v1' ([bool]([IO.Directory]::GetFiles('\\.\pipe\') -match 'dscu-driver-v1')) }
}
[void](New-Item -ItemType Directory -Force (Join-Path $Root 'reports'))
$report.finished = (Get-Date).ToString('o'); $report.ok = -not (@($report.steps | Where-Object { -not $_.ok }).Count)
$report | ConvertTo-Json -Depth 5 | Set-Content (Join-Path $Root 'reports/up-v10.json') -Encoding UTF8
Write-Host "`nDSCU v10 up: $(if ($report.ok) { 'ALL GREEN' } else { 'FAILURES — see above' })" -ForegroundColor $(if ($report.ok) { 'Green' } else { 'Red' })
exit $(if ($report.ok) { 0 } else { 1 })
