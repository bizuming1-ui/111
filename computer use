//! Rust mirror of schemas/protocol.v1.json — error codes, snapshot_epoch clock, idempotent action ledger.
//! `tests/test_v11.py::ContractTests` greps these constants and fails the build if they drift from the schema.
use serde_json::{json, Value};
use std::collections::{HashMap, VecDeque};

pub const PROTOCOL_VERSION: u64 = 1;
pub const CHANNELS: [&str; 5] = ["cli", "cdp", "uia", "jab", "vision"];
pub const ZONES: [&str; 5] = ["Toolbar", "Row", "Modal", "Page", "Unknown"];
pub const ERROR_CODES: [&str; 15] = [
    "OK", "STALE_EPOCH", "STALE_REF", "OCCLUDED", "QUOTA_DONE", "SECURITY_DENIED", "REPEAT_NOEFFECT",
    "AMBIGUOUS_TARGET", "SELF_DRAWN_ESCAPE", "IDEMPOTENT_REPLAY", "DRIVER_OFFLINE", "TIMEOUT",
    "UNSUPPORTED", "ARTIFACT_INVALID", "INTERNAL",
];

/// Monotonic structural-change counter. Any UIA tree / window / DOM restructuring bumps it.
#[derive(Debug, Default, Clone)]
pub struct EpochClock { epoch: u64 }
impl EpochClock {
    pub fn get(&self) -> u64 { self.epoch }
    pub fn bump(&mut self) -> u64 { self.epoch += 1; self.epoch }
}

pub enum Gate { Proceed, Replay(Value), Reject(Value) }

/// Idempotency + optimistic lock in one place: a replayed `action_id` returns the cached result (never re-executes a
/// click), a stale `expect_epoch` is rejected before any input is injected.
#[derive(Debug, Default)]
pub struct ActionLedger { done: HashMap<u64, Value>, order: VecDeque<u64>, last_id: u64 }

pub fn result(action_id: u64, ok: bool, code: &str, message: &str, epoch: u64) -> Value {
    json!({"v": PROTOCOL_VERSION, "action_id": action_id, "ok": ok, "code": code, "message": message, "epoch": epoch})
}

impl ActionLedger {
    pub fn begin(&mut self, action_id: u64, expect_epoch: Option<u64>, clock: &EpochClock) -> Gate {
        if let Some(prev) = self.done.get(&action_id) {
            let mut v = prev.clone();
            v["code"] = json!("IDEMPOTENT_REPLAY");
            return Gate::Replay(v);
        }
        if action_id < self.last_id {
            return Gate::Reject(result(action_id, false, "STALE_REF", "action_id older than last executed", clock.get()));
        }
        if let Some(e) = expect_epoch {
            if e != clock.get() {
                return Gate::Reject(result(action_id, false, "STALE_EPOCH", "snapshot_epoch moved; re-observe", clock.get()));
            }
        }
        Gate::Proceed
    }
    pub fn commit(&mut self, action_id: u64, res: &Value) {
        self.last_id = self.last_id.max(action_id);
        self.done.insert(action_id, res.clone());
        self.order.push_back(action_id);
        while self.order.len() > 256 { if let Some(o) = self.order.pop_front() { self.done.remove(&o); } }
    }
}

