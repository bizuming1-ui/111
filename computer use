        $i = $Text.IndexOf('{', $m.Index); $d = 0; $j = $i
        while ($j -lt $Text.Length) { $c = $Text[$j]; if ($c -eq '{') { $d++ } elseif ($c -eq '}') { $d--; if ($d -eq 0) { break } }; $j++ }
        $body = $Text.Substring($i + 1, [Math]::Max(0, $j - $i - 1)); $set = [System.Collections.Generic.HashSet[string]]::new()
        foreach ($mm in [regex]::Matches($body, 'public\s+static\s+(?:extern\s+|readonly\s+|volatile\s+)*[\w<>\[\],\.\s]+?\s+(\w+)\s*(?:\(|=|;|\{)')) { [void]$set.Add($mm.Groups[1].Value) }
        $out[$m.Groups[1].Value] = $set
    }
    return $out
}
