//! Named-pipe NDJSON server. One thread per client; ALL requests are funnelled through a single engine thread
//! (UIA/D3D11 COM objects live on exactly one thread - no cross-apartment surprises).
use serde_json::{json, Value};
use std::fs::File;
use std::io::{BufRead, BufReader, Write};
use std::os::windows::io::{FromRawHandle, RawHandle};
use std::sync::mpsc::{channel, Sender};
use std::thread;
use windows::core::PCWSTR;
use windows::Win32::Foundation::*;
use windows::Win32::Storage::FileSystem::PIPE_ACCESS_DUPLEX;
use windows::Win32::System::Pipes::*;

pub type Job = (Value, Sender<Value>);

pub fn serve(pipe_name: &str, tx: Sender<Job>, token: Option<String>) -> ! {
    let wide: Vec<u16> = pipe_name.encode_utf16().chain(std::iter::once(0)).collect();
    eprintln!("[dscu-driver] listening on {pipe_name}");
    loop {
        let h = unsafe {
            CreateNamedPipeW(
                PCWSTR(wide.as_ptr()),
                PIPE_ACCESS_DUPLEX,
                PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
                PIPE_UNLIMITED_INSTANCES,
                1 << 20,
                1 << 20,
                0,
                None,
            )
        };
        if h.is_invalid() {
            eprintln!("[dscu-driver] CreateNamedPipeW failed");
            std::thread::sleep(std::time::Duration::from_millis(500));
            continue;
        }
        let connected = unsafe { ConnectNamedPipe(h, None) };
        let ok = connected.is_ok() || unsafe { GetLastErrorCode() } == ERROR_PIPE_CONNECTED.0;
        if !ok {
            unsafe {
                let _ = CloseHandle(h);
            }
            continue;
        }
        let file = unsafe { File::from_raw_handle(h.0 as RawHandle) };
        let tx2 = tx.clone();
        let tok = token.clone();
        thread::spawn(move || client_loop(file, tx2, tok));
    }
}

unsafe fn GetLastErrorCode() -> u32 {
    windows::Win32::Foundation::GetLastError().0
}

fn client_loop(file: File, tx: Sender<Job>, token: Option<String>) {
    let Ok(mut w) = file.try_clone() else { return };
    let r = BufReader::with_capacity(1 << 16, file);
    let mut authed = token.is_none();
    for line in r.lines() {
        let Ok(line) = line else { break };
        if line.trim().is_empty() {
            continue;
        }
        let req: Value = match serde_json::from_str(&line) {
            Ok(v) => v,
            Err(e) => {
                let _ = writeln!(w, "{}", json!({"type":"error","ok":false,"code":"INTERNAL","message":format!("bad json: {e}")}));
                continue;
            }
        };
        if !authed {
            if req["type"] == "hello" && Some(req["token"].as_str().unwrap_or("").to_string()) == token {
                authed = true;
            } else {
                let _ = writeln!(w, "{}", json!({"type":"error","id":req["id"],"ok":false,"code":"SECURITY_DENIED","message":"missing/invalid session token"}));
                continue;
            }
        }
        let (rtx, rrx) = channel();
        if tx.send((req.clone(), rtx)).is_err() {
            break;
        }
        match rrx.recv_timeout(std::time::Duration::from_secs(120)) {
            Ok(resp) => {
                let quit = resp["type"] == "bye";
                if writeln!(w, "{}", resp).is_err() || w.flush().is_err() {
                    break;
                }
                if quit {
                    std::process::exit(0);
                }
            }
            Err(_) => {
                let _ = writeln!(w, "{}", json!({"type":"error","id":req["id"],"ok":false,"code":"TIMEOUT","message":"engine timeout"}));
            }
        }
    }
}
