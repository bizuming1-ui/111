def _ppt_pages(task: str) -> int:
    m = re.search(r"(\d{1,2}|[一二两三四五六七八九十])\s*(?:页|张|个幻灯片|slides?)", task or "", re.I)
    if not m:
        return 1
    g = m.group(1)
    return int(g) if g.isdigit() else _CNP.get(g, 1)


def inspect_pptx(path: Path) -> dict[str, Any]:
    """Independent PPTX oracle.  python-pptx when installed, otherwise a zero-dependency zipfile+XML reader (same numbers)."""
    import zipfile

    info: dict[str, Any] = {"slides": 0, "empty": [], "engine": ""}
    try:
        from pptx import Presentation  # type: ignore

        prs = Presentation(str(path))
        info["engine"] = "python-pptx"
        for i, sl in enumerate(prs.slides, 1):
            has_text = any(getattr(sh, "has_text_frame", False) and sh.text_frame.text.strip() for sh in sl.shapes)
            has_media = any(sh.shape_type in (13, 16, 3, 19) or getattr(sh, "has_chart", False) or getattr(sh, "has_table", False) for sh in sl.shapes)
            info["slides"] += 1
            if not (has_text or has_media):
                info["empty"].append(i)
        return info
    except ImportError:
        pass
    with zipfile.ZipFile(path) as z:
        info["engine"] = "zip-xml"
        names = sorted((n for n in z.namelist() if re.fullmatch(r"ppt/slides/slide\d+\.xml", n)), key=lambda n: int(re.search(r"(\d+)", n.rsplit("/", 1)[-1]).group(1)))  # type: ignore[union-attr]
        for i, n in enumerate(names, 1):
            xml = z.read(n).decode("utf-8", "replace")
            txt = "".join(re.findall(r"<a:t>([^<]*)</a:t>", xml)).strip()
            media = bool(re.search(r"<p:pic>|<p:graphicFrame>|r:embed=|<c:chart", xml))
            info["slides"] += 1
            if not (txt or media):
                info["empty"].append(i)
    return info


def check_pptx(path: Path, min_slides: int = 1) -> list[Check]:
    if not path.exists():
        return [Check("ppt_slide_count", False, f"文件不存在: {path}", "ppt", source="python-pptx"), Check("ppt_slides_nonempty", False, "文件不存在", "ppt", source="python-pptx")]
    try:
        info = inspect_pptx(path)
    except Exception as e:  # noqa: BLE001
        return [Check("ppt_slide_count", False, f"PPTX 无法解析: {str(e)[:80]}", "ppt", source="python-pptx"), Check("ppt_slides_nonempty", False, "PPTX 无法解析", "ppt", source="python-pptx")]
    return [Check("ppt_slide_count", info["slides"] >= max(1, min_slides), f"{info['slides']} 页（要求 ≥{max(1, min_slides)}，引擎 {info['engine']}）", "ppt", source=info["engine"]),
            Check("ppt_slides_nonempty", not info["empty"] and info["slides"] > 0, "每页均有非空文本/媒体" if not info["empty"] else f"空白页: {info['empty'][:8]}", "ppt", source=info["engine"])]
