"""Zero-trust gate in front of every action: untrusted-content sanitising, risk classification, HITL with default-deny,
and a denial memory so a refused target is never retried 3x (the log #9 failure mode)."""
from __future__ import annotations

import asyncio
import re
import sys
import unicodedata
from dataclasses import dataclass
from typing import Any

from .state import DELETE_WORDS, TaskState

INJECTION = re.compile(
    r"ignore (all |any )?(previous|prior|above) (instructions|prompts)|disregard .{0,30}instructions|system prompt|you are now|"
    r"忽略(之前|以上|上面|所有).{0,8}(指令|提示|规则)|无视.{0,6}(指令|规则)|新的指令|<\s*/?system\s*>|assistant:\s*|\bsudo\b.{0,20}rm\b", re.I)
ZERO_WIDTH = dict.fromkeys(map(ord, "\u200b\u200c\u200d\u2060\ufeff\u202a\u202b\u202c\u202d\u202e"), None)
SENSITIVE_NAMES = re.compile(r"登录|登陆|sign.?in|log.?in|支付|付款|pay\b|checkout|提交订单|转账|transfer|确认购买|buy now", re.I)
PRIVATE = re.compile(r"^(localhost|.*\.local|.*\.internal|10\.|127\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.|169\.254\.)")


def sanitize_untrusted(text: str) -> tuple[str, int]:
    t = unicodedata.normalize("NFKC", text).translate(ZERO_WIDTH)
    hits = len(INJECTION.findall(t))
    return INJECTION.sub("[已屏蔽的注入语句]", t), hits


@dataclass
class Risk:
    kind: str
    target: str
    why: str
    pre_authorized: bool = False


def classify(action: dict[str, Any], st: TaskState, element_name: str = "") -> Risk | None:
    a = action.get("action", "")
    if a in ("cdp_navigate", "navigate"):
        from urllib.parse import urlparse

        host = (urlparse(str(action.get("url", ""))).hostname or "").lower()
        if host and PRIVATE.match(host):
            return Risk("private_nav", host, f"目标是内网/本机地址 {host}")
    if a in ("click", "toolbar_action", "double_click"):
        nm = element_name or str(action.get("label", ""))
        if SENSITIVE_NAMES.search(nm):
            return Risk("sensitive_submit", nm, f"控件「{nm}」涉及登录/支付/提交")
        if DELETE_WORDS.search(nm):
            return Risk("delete", nm, f"控件「{nm}」会删除数据", pre_authorized=bool(DELETE_WORDS.search(st.task)))
    if a == "run_ps_safe":
        return Risk("script", str(action.get("command", ""))[:60], "执行受限 PowerShell 脚本（AST 白名单 + CLM）", pre_authorized=True)
    return None


async def ask_human(prompt: str, timeout: float = 20.0) -> bool:
    """Console HITL. Default deny: timeout, EOF, non-interactive stdin and anything but y/yes/是 all refuse."""
    if not sys.stdin or not sys.stdin.isatty():
        return False
    print(f"  🛡 需要人工确认: {prompt}（{int(timeout)} 秒内输入 y 同意，其余/超时=拒绝）: ", end="", flush=True)
    loop = asyncio.get_running_loop()
    fut = loop.run_in_executor(None, sys.stdin.readline)
    try:
        ans = (await asyncio.wait_for(fut, timeout)).strip().lower()
    except asyncio.TimeoutError:
        print("（超时，已拒绝）")
        return False
    return ans in ("y", "yes", "是", "同意")


async def gate(action: dict[str, Any], st: TaskState, element_name: str = "", interactive: bool = True) -> tuple[bool, str, dict[str, Any]]:
    """Returns (allowed, reason, extra_args_for_executor)."""
    r = classify(action, st, element_name)
    if r is None:
        return True, "", {}
    key = f"{r.kind}:{r.target}"
    if key in st.blocked_targets:
        return False, f"[SECURITY_DENIED] 「{r.target}」已被拒绝过（{st.blocked_targets[key]}），不要重试同一目标：请用 ask_user 询问用户、换一条不经过它的路径，或 fail 并说明。", {}
    if r.pre_authorized:
        return True, "", {}
    ok = await ask_human(r.why) if interactive else False
    if not ok:
        st.blocked_targets[key] = "人工拒绝/超时"
        return False, f"[SECURITY_HITL_DENIED] {r.why}：未获确认，已记入拒绝清单（不会再重复尝试）。", {}
    return True, "", ({"allow_private": True} if r.kind == "private_nav" else {})
