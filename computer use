def E(n: int, role: str, name: str, zone: str, rect, row=None, states=()) -> Element:  # noqa: ANN001
    return Element(ref_id=f"@1:e{n}", role=role, name=name, rect=list(rect), zone=zone, stable_key=f"k{n}", states=list(states), row=row)


def explorer_obs(selected: tuple[int, ...] = (), names=("EdgeGameAssist.msix", "VERSION", "相机.txt")) -> Observation:
    els = [E(1, "button", "删除", "Toolbar", (10, 10, 60, 30)), E(2, "button", "还原", "Toolbar", (80, 10, 60, 30))]
    for i, nm in enumerate(names, 1):
        els.append(E(10 + i, "listitem", nm, "Row", (100, 100 + 30 * i, 600, 28), row=i, states=("selected",) if i in selected else ()))
    return Observation(id="o1", ok=True, channel="uia", snapshot_epoch=1, hwnd=5, elements=els)


def gate_for(obs: Observation, step: int = 3) -> tuple[IdentityGate, dict]:
    reg = StableObjectRegistry()
    reg.observe_rows(obs.elements, step)
    g = IdentityGate(reg)
    g.note_observation(obs, step)
    return g, {e_.ref_id: e_ for e_ in obs.elements}


