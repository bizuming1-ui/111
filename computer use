}
function ConvertFrom-ChineseNumber([string]$s) {
    if ($s -match '^\d+$') { return [int]$s }
    $d = @{ '零' = 0; '一' = 1; '二' = 2; '两' = 2; '三' = 3; '四' = 4; '五' = 5; '六' = 6; '七' = 7; '八' = 8; '九' = 9 }
    $total = 0; $cur = 0
    foreach ($ch in $s.ToCharArray()) {
        $c = [string]$ch
        if ($d.ContainsKey($c)) { $cur = $d[$c] }
        elseif ($c -eq '十') { if ($cur -eq 0) { $cur = 1 }; $total += $cur * 10; $cur = 0 }
        elseif ($c -eq '百') { if ($cur -eq 0) { $cur = 1 }; $total += $cur * 100; $cur = 0 }
        else { return 0 }
    }
    return ($total + $cur)
}
function Get-TaskQuantity([string]$t) {
    # 从任务文本里识别「要处理几个」：前10个 / 前面10个 / 前十封 / 10 封邮件 / first 10 / top 5。「第3个」不算数量。
    if ([string]::IsNullOrWhiteSpace($t)) { return 0 }
    # 只对「选择 / 删除 / 归档 / 标记 / 移动」类任务生效，避免「打开一个记事本」被当成 N=1
    if ($t -notmatch '(?i)(删|刪|delete|remove|勾|选中|選取|选择|選擇|select|archive|归档|歸檔|封存|垃圾|trash|标记|標記|mark|移动|移至|移到|move)') { return 0 }
    $num = '(\d{1,3}|[零一二两三四五六七八九十百]{1,4})'
    $pats = @(
        "(?:最?前面?|头|first|top)\s*$num",
        "(?<![第\d零一二两三四五六七八九十百])$num\s*(?:个|個|封|条|條|项|項|则|則|份|篇)",
        "(?<![第\d])$num\s+(?:emails?|mails?|messages?|items?|conversations?|rows?)"
    )
    foreach ($p in $pats) {
        if ($t -match "(?i)$p") {
            $v = ConvertFrom-ChineseNumber $Matches[1]
            if ($v -gt 0) { return [int]$v }
        }
    }
    return 0
}
function ConvertTo-RowList([string]$spec, [int]$max) {
    # "1-10" / "1,3,5-7" / "1到10" → 升序去重的行号数组；超出列表行数直接报错（不猜）
    $s = (("$spec" -replace '[，、；;]', ',') -replace '[～~—–至到]', '-') -replace '\s+', ''
    if ($s -notmatch '^\d+(-\d+)?(,\d+(-\d+)?)*$') { throw "rows 格式不对：'$spec'（示例：`"1-10`" 或 `"1,3,5-7`"）" }
    $set = [System.Collections.Generic.SortedSet[int]]::new()
    foreach ($part in $s.Split(',')) {
        if ($part -match '^(\d+)-(\d+)$') {
            $lo = [int]$Matches[1]; $hi = [int]$Matches[2]
            if ($lo -gt $hi) { throw "rows 区间写反了：'$part'" }
            for ($i = $lo; $i -le $hi; $i++) { [void]$set.Add($i) }
        }
        else { [void]$set.Add([int]$part) }
    }
    if ($set.Count -gt 200) { throw 'rows 一次最多 200 行' }
    foreach ($i in $set) {
        if ($i -lt 1) { throw 'rows 从 1 开始编号' }
        if ($max -gt 0 -and $i -gt $max) { throw "列表只识别到 $max 行（含视口外），没有第 $i 行；请先翻页/滚动后重新观察，或缩小范围" }
    }
    return , ([int[]]@($set))
}
function Format-RowRanges($idx) {
    $arr = @($idx | ForEach-Object { [int]$_ } | Sort-Object -Unique)
    if ($arr.Count -eq 0) { return '无' }
    $out = New-Object System.Collections.Generic.List[string]
    $s0 = $arr[0]; $p0 = $arr[0]
    for ($i = 1; $i -le $arr.Count; $i++) {
        if ($i -lt $arr.Count -and $arr[$i] -eq ($p0 + 1)) { $p0 = $arr[$i]; continue }
        if ($s0 -eq $p0) { $out.Add("R$s0") } else { $out.Add("R$s0-R$p0") }
        if ($i -lt $arr.Count) { $s0 = $arr[$i]; $p0 = $arr[$i] }
    }
    return ($out -join ',')
}
function Join-RowCheckboxes($rows, $cbs) {
    # 纯几何：每个复选框归入包含其中心点的候选行（宽度至少是复选框的 3 倍）。Chrome 把表格的「行」和「单元格」都报成 DataItem，
    # 所以在「高度像一行」的候选里取最宽的（= 整行而不是单元格）；都不像一行时取面积最小的。同一行取最左边的复选框。
    # 然后做表格一致性过滤：宽度 / 左边界偏离中位数的「行」（例如工具栏里的项）剔除，其复选框归入 Master（通常是「全选」框）。
    $map = @{}
    $master = New-Object System.Collections.Generic.List[object]
    foreach ($cb in $cbs) {
        $cx = [double]$cb.L + [double]$cb.W / 2.0; $cy = [double]$cb.T + [double]$cb.H / 2.0
        $hMax = [Math]::Max(4.0 * [double]$cb.H, 120.0)
        $best = -1; $bestW = -1.0; $alt = -1; $altA = [double]::MaxValue
        for ($i = 0; $i -lt $rows.Count; $i++) {
            $rw = $rows[$i]
            if ([double]$rw.W -lt (3.0 * [double]$cb.W)) { continue }
            if ($cx -ge $rw.L -and $cx -le ($rw.L + $rw.W) -and $cy -ge $rw.T -and $cy -le ($rw.T + $rw.H)) {
                if ([double]$rw.H -le $hMax) { if ([double]$rw.W -gt $bestW) { $bestW = [double]$rw.W; $best = $i } }
                else { $ar = [double]$rw.W * [double]$rw.H; if ($ar -lt $altA) { $altA = $ar; $alt = $i } }
            }
        }
        if ($best -lt 0) { $best = $alt }
        if ($best -lt 0) { $master.Add($cb); continue }
        if (-not $map.ContainsKey($best) -or [double]$cb.L -lt [double]$map[$best].L) {
            if ($map.ContainsKey($best)) { $master.Add($map[$best]) }
            $map[$best] = $cb
        }
        else { $master.Add($cb) }
    }
    $list = New-Object System.Collections.Generic.List[object]
    foreach ($key in @($map.Keys)) { $list.Add([pscustomobject]@{ Row = $rows[[int]$key]; Cb = $map[$key]; Text = ''; Index = 0; Key = '' }) }
    if ($list.Count -ge 3) {
        $ws = @($list | ForEach-Object { [double]$_.Row.W } | Sort-Object); $ls = @($list | ForEach-Object { [double]$_.Row.L } | Sort-Object)
        $mw = $ws[[int][Math]::Floor($ws.Count / 2)]; $ml = $ls[[int][Math]::Floor($ls.Count / 2)]
        $keep = New-Object System.Collections.Generic.List[object]
        foreach ($e in $list) {
            if ([Math]::Abs([double]$e.Row.W - $mw) -le (0.15 * $mw) -and [Math]::Abs([double]$e.Row.L - $ml) -le 24) { $keep.Add($e) } else { $master.Add($e.Cb) }
        }
        $list = $keep
    }
    $sorted = @($list | Sort-Object -Property @{ Expression = { [double]$_.Row.T } }, @{ Expression = { [double]$_.Row.L } })
    $n = 0
    foreach ($r in $sorted) { $n++; $r.Index = $n }
    return [pscustomobject]@{ Rows = $sorted; Master = $master.ToArray() }
}
function Set-RowKeys($rows) {
    # 行身份 = 行摘要文字 + 同文字序号；没有文字时退化为行号
    $seen = @{}
    foreach ($r in $rows) {
        $b = if ($r.Text) { "$($r.Text)" } else { "#$($r.Index)" }
        $seen[$b] = 1 + [int]$seen[$b]
        $r.Key = "$b#$($seen[$b])"
    }
}
function Get-RuntimeKey($el) { try { return ((@($el.GetRuntimeId())) -join '.') } catch { return '' } }
function Get-RowTexts($rows) {
    # 行本身没有名称时（Gmail 的行就是这样），取「首行与末行的最近公共祖先」下的全部 Text，按几何归入各行
    $AE = [System.Windows.Automation.AutomationElement]
    $w = [System.Windows.Automation.TreeWalker]::ControlViewWalker
    $cnt = @($rows).Count
    if ($cnt -eq 0) { return @() }
    $firstEl = $rows[0].Row.El; $lastEl = $rows[$cnt - 1].Row.El
    $anc = @{}; $cont = $null
    try {
        $cur = $w.GetParent($firstEl)
        for ($i = 0; $i -lt 8 -and $null -ne $cur; $i++) { $rk = Get-RuntimeKey $cur; if ($rk) { $anc[$rk] = $true }; $cur = $w.GetParent($cur) }
        $cur = $w.GetParent($lastEl)
        for ($i = 0; $i -lt 8 -and $null -ne $cur; $i++) { $rk = Get-RuntimeKey $cur; if ($rk -and $anc.ContainsKey($rk)) { $cont = $cur; break }; $cur = $w.GetParent($cur) }
    }
    catch { $cont = $null }
    if ($null -eq $cont) { return @() }
    $col = $null; $act = $null
    try {
        $cr = [System.Windows.Automation.CacheRequest]::new()
        $cr.Add($AE::NameProperty); $cr.Add($AE::BoundingRectangleProperty)
        $act = $cr.Activate()
        $tc = [System.Windows.Automation.PropertyCondition]::new($AE::ControlTypeProperty, [System.Windows.Automation.ControlType]::Text)
        $col = $cont.FindAll([System.Windows.Automation.TreeScope]::Descendants, $tc)
    }
    catch { $col = $null }
    finally { if ($act) { $act.Dispose() } }
    if ($null -eq $col) { return @() }
    $out = New-Object System.Collections.Generic.List[object]
    $k = 0
    foreach ($el in $col) {
        $k++; if ($k -gt 4000) { break }
        try {
            $c = $el.Cached
            $nm = "$($c.Name)".Trim()
            if ($nm -eq '') { continue }
            $rc = $c.BoundingRectangle
            if ($rc.IsEmpty) { continue }
            $out.Add([pscustomobject]@{ Name = (Limit-Text $nm 40); cx = $rc.Left + $rc.Width / 2.0; cy = $rc.Top + $rc.Height / 2.0; L = $rc.Left })
        }
        catch { continue }
    }
    return $out.ToArray()
}
function Get-RowModel([IntPtr]$hwnd) {
    # 列表行模型：CheckBox + DataItem/ListItem/TreeItem 一次缓存取回（不加 IsOffscreen 过滤，所以视口外的行也在），
    # 复选框按几何归行；行摘要来自行名称或行内文字。返回 Rows（R1..Rn）与 Master（不属于任何行的复选框）。
    $empty = [pscustomobject]@{ Rows = @(); Master = @() }
    if ($hwnd -eq [IntPtr]::Zero) { return $empty }
    $AE = [System.Windows.Automation.AutomationElement]
    try { $root = $AE::FromHandle($hwnd) } catch { return $empty }
    $CT = [System.Windows.Automation.ControlType]
    $conds = @(foreach ($tn in @('CheckBox', 'DataItem', 'ListItem', 'TreeItem')) { [System.Windows.Automation.PropertyCondition]::new($AE::ControlTypeProperty, $CT::$tn) })
    $cond = [System.Windows.Automation.OrCondition]::new([System.Windows.Automation.Condition[]]$conds)
    $TogP = [System.Windows.Automation.TogglePattern]::ToggleStateProperty
    $col = $null; $act = $null
    try {
        $cr = [System.Windows.Automation.CacheRequest]::new()
        foreach ($p in @($AE::NameProperty, $AE::AutomationIdProperty, $AE::ControlTypeProperty, $AE::BoundingRectangleProperty,
                $AE::IsOffscreenProperty, $AE::IsEnabledProperty, $AE::IsTogglePatternAvailableProperty,
                $AE::IsInvokePatternAvailableProperty, $AE::IsSelectionItemPatternAvailableProperty, $TogP)) { $cr.Add($p) }
        $act = $cr.Activate()
        $col = $root.FindAll([System.Windows.Automation.TreeScope]::Descendants, $cond)
    }
    catch { $col = $null }
    finally { if ($act) { $act.Dispose() } }
    if ($null -eq $col) { return $empty }
    $wr = [DsNative4]::WinRect($hwnd)
    $rows = New-Object System.Collections.Generic.List[object]
    $cbs = New-Object System.Collections.Generic.List[object]
    $k = 0
    foreach ($el in $col) {
        $k++; if ($k -gt $script:ScanCap) { break }
        try {
            $c = $el.Cached
            $rc = $c.BoundingRectangle
            if ($rc.IsEmpty -or $rc.Width -lt 4 -or $rc.Height -lt 4) { continue }
            if (($rc.Left + $rc.Width) -lt $wr[0] -or $rc.Left -gt $wr[2]) { continue }   # 与前台窗口水平方向不相交（隐藏面板等）
            $type = ($c.ControlType.ProgrammaticName -replace '^ControlType\.', '')
            $o = [pscustomobject]@{
                El = $el; Type = $type; Name = "$($c.Name)"; AutoId = "$($c.AutomationId)"
                L = [double]$rc.Left; T = [double]$rc.Top; W = [double]$rc.Width; H = [double]$rc.Height
                Off = [bool]$c.IsOffscreen; Enabled = [bool]$c.IsEnabled; State = ''; Tog = $false; Pats = @()
            }
            if ($type -eq 'CheckBox') {
                try {
                    if ($el.GetCachedPropertyValue($AE::IsTogglePatternAvailableProperty) -eq $true) {
                        $o.Tog = $true
                        $tv = $el.GetCachedPropertyValue($TogP)
                        if ($tv -is [System.Windows.Automation.ToggleState]) { $o.State = "$tv".ToLower() }
                    }
                }
                catch { }
                $cbs.Add($o)
            }
            else {
                $pp = @()
                try { if ($el.GetCachedPropertyValue($AE::IsSelectionItemPatternAvailableProperty) -eq $true) { $pp += 'sel' } } catch { }
                try { if ($el.GetCachedPropertyValue($AE::IsInvokePatternAvailableProperty) -eq $true) { $pp += 'inv' } } catch { }
                $o.Pats = $pp
                $rows.Add($o)
            }
        }
        catch { continue }
    }
    if ($cbs.Count -eq 0) { return $empty }
    if ($rows.Count -eq 0) { return [pscustomobject]@{ Rows = @(); Master = $cbs.ToArray() } }
    $j = Join-RowCheckboxes $rows $cbs
    if (@($j.Rows).Count -gt 0) {
        $need = @($j.Rows | Where-Object { [string]::IsNullOrWhiteSpace($_.Row.Name) }).Count
        $texts = @()
        if ($need -gt 0) { $texts = @(Get-RowTexts $j.Rows) }
        $buckets = @{}
        foreach ($tx in $texts) {
            foreach ($rw in $j.Rows) {
                $rr = $rw.Row
                if ($tx.cx -ge $rr.L -and $tx.cx -le ($rr.L + $rr.W) -and $tx.cy -ge $rr.T -and $tx.cy -le ($rr.T + $rr.H)) {
                    if (-not $buckets.ContainsKey($rw.Index)) { $buckets[$rw.Index] = New-Object System.Collections.Generic.List[object] }
                    $buckets[$rw.Index].Add($tx)
                    break
                }
            }
        }
        foreach ($rw in $j.Rows) {
            if (-not [string]::IsNullOrWhiteSpace($rw.Row.Name)) { $rw.Text = Limit-Text $rw.Row.Name 120; continue }
            $names = New-Object System.Collections.Generic.List[string]
            if ($buckets.ContainsKey($rw.Index)) {
                foreach ($tx in @($buckets[$rw.Index] | Sort-Object -Property L)) { if (-not $names.Contains($tx.Name)) { $names.Add($tx.Name) } }
            }
            $rw.Text = Limit-Text ($names -join ' · ') 120
        }
        Set-RowKeys $j.Rows
    }
    return $j
}
function ConvertTo-RowCbItem($row) {
    $cb = $row.Cb
    $nm = "$($cb.Name)"; if ([string]::IsNullOrWhiteSpace($nm)) { $nm = "$($cb.AutoId)" }
    $pats = @(); if ($cb.Tog) { $pats += 'tog' }
    return [pscustomobject]@{
        Type = 'CheckBox'; Name = (Limit-Text $nm 80); FullName = "$($cb.Name)"; Value = ''; State = $cb.State
        Enabled = [bool]$cb.Enabled; Focus = $false; Hwnd = 0; Pat = $pats; El = $cb.El
        cx = [int]($cb.L + $cb.W / 2); cy = [int]($cb.T + $cb.H / 2); L = [int]$cb.L; T = [int]$cb.T; W = [int]$cb.W; H = [int]$cb.H
        IsMaster = $false; RowIdx = [int]$row.Index; RowText = "$($row.Text)"; Off = [bool]$row.Row.Off
    }
}
function ConvertTo-RowItem($row) {
    $rw = $row.Row
    $nm = "$($rw.Name)"; if ([string]::IsNullOrWhiteSpace($nm)) { $nm = "$($rw.AutoId)" }
    return [pscustomobject]@{
        Type = $rw.Type; Name = (Limit-Text $nm 80); FullName = "$($rw.Name)"; Value = ''; State = ''
        Enabled = [bool]$rw.Enabled; Focus = $false; Hwnd = 0; Pat = @($rw.Pats); El = $rw.El
        cx = [int]($rw.L + $rw.W / 2); cy = [int]($rw.T + $rw.H / 2); L = [int]$rw.L; T = [int]$rw.T; W = [int]$rw.W; H = [int]$rw.H
        IsMaster = $false; RowIdx = [int]$row.Index; RowText = "$($row.Text)"; Off = [bool]$rw.Off
    }
}
function Get-PrecisePoint($item, $r) {
    # 物理点击的落点：TryGetClickablePoint + 矩形内若干候选点，逐个做「严格命中测试」（实时命中的必须是目标本身或其后代）
    $cands = New-Object System.Collections.Generic.List[object]
    try {
        $pt = [System.Windows.Point]::new(0, 0)
        if ($item.El.TryGetClickablePoint([ref]$pt)) { $cands.Add(@([int][Math]::Round($pt.X), [int][Math]::Round($pt.Y))) }
    }
    catch { }
    foreach ($f in @(@(0.5, 0.5), @(0.35, 0.5), @(0.65, 0.5), @(0.5, 0.3), @(0.5, 0.7))) {
        $cands.Add(@([int][Math]::Round($r.Left + $r.Width * $f[0]), [int][Math]::Round($r.Top + $r.Height * $f[1])))
    }
    $tried = 0
    foreach ($c in $cands) {
        if ($c[0] -lt $r.Left -or $c[0] -gt ($r.Left + $r.Width) -or $c[1] -lt $r.Top -or $c[1] -gt ($r.Top + $r.Height)) { continue }
        $tried++
        if (Test-HitTarget $item $c[0] $c[1] -Strict) { return @{ x = $c[0]; y = $c[1]; verified = $true } }
        if ($tried -ge 4) { break }
    }
    return @{ x = [int]($r.Left + $r.Width / 2); y = [int]($r.Top + $r.Height / 2); verified = $false }
}
function Invoke-ScrollIntoView($el) {
    try {
        $sp = $el.GetCurrentPattern([System.Windows.Automation.ScrollItemPattern]::Pattern)
        $sp.ScrollIntoView()
        Start-Sleep -Milliseconds 250
        return $true
    }
    catch { return $false }
}
function Get-LiveToggle($item) {
    try { return "$($item.El.GetCurrentPattern([System.Windows.Automation.TogglePattern]::Pattern).Current.ToggleState)".ToLower() }
    catch { return '' }
}
function Wait-ToggleState($item, [string]$want, [int]$timeoutMs) {
    # 网页复选框是异步更新的（Gmail 常见 100~500 ms）：轮询到目标状态或超时，返回最后读到的状态
    $end = (Get-Date).AddMilliseconds($timeoutMs)
    $st = Get-LiveToggle $item
    while ($st -ne $want -and (Get-Date) -lt $end) {
        Start-Sleep -Milliseconds 60
        $st = Get-LiveToggle $item
    }
    return $st
}
function Assert-ItemFresh($item, [int]$n) {
    # 和 Resolve-Target 相同的身份核对（名称 + 收紧后的漂移容差），但允许控件在视口外（UIA 不需要可见）
    $cur = $null
    try { $cur = $item.El.Current; $rc = $cur.BoundingRectangle }
    catch {
        if (-not (Update-ItemElement $item)) { throw "控件 [$n] 已不存在（界面已变化），请重新观察后再操作" }
        try { $cur = $item.El.Current; $rc = $cur.BoundingRectangle } catch { throw "控件 [$n] 已不存在（界面已变化），请重新观察后再操作" }
    }
    if ($rc.IsEmpty) { throw "控件 [$n] 已不可用（无位置信息），请重新观察" }
    $live = $cur.Name
    if ([string]::IsNullOrWhiteSpace($live) -and $item.Type -ne 'Text') { $live = $cur.AutomationId }
    if ($item.Name -and (Limit-Text $live 80) -ne $item.Name) { throw "控件 [$n] 的名称已变化，界面已变化，请重新观察" }
    $drift = [Math]::Sqrt([Math]::Pow(($rc.Left + $rc.Width / 2) - $item.cx, 2) + [Math]::Pow(($rc.Top + $rc.Height / 2) - $item.cy, 2))
    $tol = Get-DriftTolerance $item
    if ($drift -gt $tol) { throw "控件 [$n] 位置已偏移 $([int]$drift) 像素（容差 $tol），界面已变化，请重新观察" }
}
function Invoke-PhysicalOnItem($item, [string]$label) {
    $cur = $item.El.Current
    $rc = $cur.BoundingRectangle
    if ($rc.IsEmpty -or [bool]$cur.IsOffscreen) {
        if (-not (Invoke-ScrollIntoView $item.El)) { throw "$label 在视口外，且无法自动滚动到可见区域" }
        $cur = $item.El.Current; $rc = $cur.BoundingRectangle
        if ($rc.IsEmpty -or [bool]$cur.IsOffscreen) { throw "$label 滚动后仍不可见" }
    }
    $pp = Get-PrecisePoint $item $rc
    $t = @{ x = $pp.x; y = $pp.y; label = $label; item = $item }
    Move-VirtualCursor $t.x $t.y
    Assert-PhysicalReady $t
    Set-CursorPulse 0
    [DsNative4]::PhysicalClick($t.x, $t.y, 0, 1, $true)
    return [bool]$pp.verified
}
function Set-CheckState($item, [bool]$on, [string]$label) {
    # 幂等设定复选框状态（不是切换）：已是目标状态就不动；UIA Toggle → 轮询读回 → 仍不对再用命中核验过的物理点击 → 再读回。
    $want = if ($on) { 'on' } else { 'off' }
    $s0 = Get-LiveToggle $item
    if ($s0 -eq $want) {
        return [pscustomobject]@{ Ok = $true; Changed = $false; State = $s0; Via = '已是目标状态，未操作' }
    }
    $via = New-Object System.Collections.Generic.List[string]
    try {
        $lc = $item.El.Current
        if (-not [bool]$lc.IsOffscreen) { $lr = $lc.BoundingRectangle; if (-not $lr.IsEmpty) { Move-VirtualCursor ([int]($lr.Left + $lr.Width / 2)) ([int]($lr.Top + $lr.Height / 2)) } }
    }
    catch { }
    $st = $s0
    if ($script:Mode -in 'Auto', 'Uia' -and ($item.Pat -contains 'tog' -or $item.Type -eq 'CheckBox')) {
        for ($k = 0; $k -lt 2 -and $st -ne $want; $k++) {
            $before = $st
            try { $item.El.GetCurrentPattern([System.Windows.Automation.TogglePattern]::Pattern).Toggle(); $via.Add('UIA Toggle') } catch { break }
            Set-CursorPulse 0
            $st = Wait-ToggleState $item $want 1500
            if ($st -eq $before) { break }   # 没有任何变化：不再盲目切换，交给下一层
        }
    }
    if ($st -ne $want -and $script:Mode -ne 'Uia') {
        Start-Sleep -Milliseconds 400
        $st = Get-LiveToggle $item   # 再读一次：防止迟到的异步生效被下一层「再切一次」抵消
        if ($st -ne $want) {
            if ($script:Mode -eq 'Message') {
                if ($item.Hwnd -eq 0 -or -not (Test-MessageFriendly $item.Hwnd)) { throw "$label 无法用窗口消息操作（请改用 mode auto）" }
                $mr = $item.El.Current.BoundingRectangle
                [void][DsNative4]::PostClick([IntPtr]$item.Hwnd, [int]($mr.Left + $mr.Width / 2), [int]($mr.Top + $mr.Height / 2), 0, 1)
                $via.Add('窗口消息')
            }
            else {
                $ver = Invoke-PhysicalOnItem $item $label
                $via.Add($(if ($ver) { '物理点击(落点已核验)' } else { '物理点击(落点未核验)' }))
            }
            $st = Wait-ToggleState $item $want 1500
        }
    }
    return [pscustomobject]@{ Ok = ($st -eq $want); Changed = $true; State = $st; Via = ($via -join '→') }
}
function Invoke-CheckAction($a, [bool]$on) {
    $ids = @()
    if ($null -ne $a.ids) { $ids = @($a.ids) } elseif (Test-IdValue $a.id) { $ids = @($a.id) }
    $want = if ($on) { 'on' } else { 'off' }
    $parts = New-Object System.Collections.Generic.List[string]
    $bad = 0
    foreach ($i in $ids) {
        Test-Abort
        $n = [int]"$i"
        $item = $script:Elements[$n]
        Assert-ItemFresh $item $n
        $res = Set-CheckState $item $on "[$n]"
        if (-not $res.Ok) { $bad++ }
        $tag = if (-not $res.Changed) { "已是$want" } elseif ($res.Ok) { "→$($res.State)✓" } else { "→$($res.State)✗($($res.Via))" }
        $parts.Add("[$n]$tag")
        Start-Sleep -Milliseconds 40
    }
    $verb = if ($on) { 'check' } else { 'uncheck' }
    $verdict = if ($bad -eq 0) { "全部读回为 $want ✓" } else { "$bad 个未达成 ✗，请重新观察后处理" }
    return "$verb $($ids.Count) 个：$($parts -join ' ')；$verdict"
}
function Invoke-SelectRows($a) {
    # 按「列表行」R 编号精确勾选：幂等设定、默认独占（其他行取消）、闭环核验（重新扫描，按冻结的行身份核对，不符纠正），
    # 通过后再隔 0.8 秒复扫一次确认稳定（防止迟到的异步切换在「✓」之后又把状态改掉）。
    $spec = "$($a.rows)"
    $exclusive = $true
    if ($null -ne $a.exclusive -and "$($a.exclusive)" -ne '') { $exclusive = Test-True $a.exclusive }
    $m = Get-RowModel $script:ObsHwnd
    $total = @($m.Rows).Count
    if ($total -eq 0) { throw '当前前台窗口没有识别到「带复选框的列表行」，无法 select_rows（请重新观察，或改用 check）' }
    $want = ConvertTo-RowList $spec $total
    $useKeys = (@($m.Rows | Where-Object { $_.Text }).Count -eq $total)
    # 任务内指代一致性：同一任务里再次 select_rows 同一范围时，沿用首次冻结的行身份（中途到达的新邮件不会被算进「前 N 个」）
    $memoNote = ''
    if ($useKeys -and $script:SelectMemo -and $script:SelectMemo.Spec -eq $spec) {
        $idxByKey = @{}
        foreach ($row in $m.Rows) { $idxByKey[$row.Key] = [int]$row.Index }
        $mapped = @($script:SelectMemo.Keys | Where-Object { $idxByKey.ContainsKey($_) } | ForEach-Object { [int]$idxByKey[$_] } | Sort-Object)
        if ($mapped.Count -eq @($script:SelectMemo.Keys).Count -and ($mapped -join ',') -ne ($want -join ',')) {
            $want = [int[]]$mapped
            $memoNote = "（列表在本任务中途有变化：沿用首次选择时冻结的行身份，现在是 $(Format-RowRanges $want)）"
        }
    }
    if ($useKeys -and -not ($script:SelectMemo -and $script:SelectMemo.Spec -eq $spec)) {
        $script:SelectMemo = [pscustomobject]@{ Spec = $spec; Keys = @($want | ForEach-Object { $m.Rows[$_ - 1].Key }) }
    }
    $wantSet = [System.Collections.Generic.HashSet[int]]::new()
    foreach ($i in $want) { [void]$wantSet.Add([int]$i) }
    $frozen = @{}
    foreach ($i in $want) { $frozen[$m.Rows[$i - 1].Key] = $i }
    $changed = 0
    foreach ($row in $m.Rows) {
        Test-Abort
        $isT = $wantSet.Contains([int]$row.Index)
        $isOn = ($row.Cb.State -eq 'on')
        if ($isT -eq $isOn) { continue }
        if (-not $isT -and -not $exclusive) { continue }
        # 网页重绘会让元素引用失效：单行出错不中止，交给下面的「重新扫描 + 核验 + 纠正」处理
        try { [void](Set-CheckState (ConvertTo-RowCbItem $row) $isT "R$($row.Index)") } catch { if ($_.Exception.Message -like '触发保护*') { throw } }
        $changed++
    }
    $note = ''
    $missing = @(); $extra = @(); $onNow = @(); $stable = $false
    for ($pass = 1; $pass -le 3; $pass++) {
        Wait-Safe 350
        $v = Get-RowModel $script:ObsHwnd
        $byKey = $useKeys
        if ($byKey) {
            $found = @($v.Rows | Where-Object { $frozen.ContainsKey($_.Key) }).Count
            if ($found -lt [Math]::Ceiling($want.Count / 2.0)) { $byKey = $false; $note = '（行文字在操作后有变化，已改按行号核验）' }
            elseif ($found -lt $want.Count) { $note = "（有 $($want.Count - $found) 个目标行已不在列表中）" }
        }
        $missing = @(); $extra = @(); $onNow = @()
        foreach ($row in $v.Rows) {
            $isT = if ($byKey) { $frozen.ContainsKey($row.Key) } else { $wantSet.Contains([int]$row.Index) }
            $isOn = ($row.Cb.State -eq 'on')
            if ($isOn) { $onNow += [int]$row.Index }
            if ($isT -and -not $isOn) { $missing += $row }
            elseif ((-not $isT) -and $isOn -and $exclusive) { $extra += $row }
        }
        if (($missing.Count + $extra.Count) -eq 0) {
            Wait-Safe 800
            $v2 = Get-RowModel $script:ObsHwnd
            $on2 = @($v2.Rows | Where-Object { $_.Cb.State -eq 'on' } | ForEach-Object { [int]$_.Index })
            if (($on2 -join ',') -eq ($onNow -join ',')) { $stable = $true; break }
            continue   # 0.8 秒内又有变化（迟到的异步切换）：下一轮重新核对并纠正
        }
        if ($pass -eq 3) { break }
        foreach ($row in @($missing) + @($extra)) {
            $wantOn = $missing -contains $row
            try { [void](Set-CheckState (ConvertTo-RowCbItem $row) $wantOn "R$($row.Index)") } catch { if ($_.Exception.Message -like '触发保护*') { throw } }
            $changed++
        }
    }
    $tgt = Format-RowRanges $want
    if ($stable -and ($missing.Count + $extra.Count) -eq 0) {
        $tail = if ($exclusive) { '，其他行均未勾选' } else { '' }
        return "select_rows $spec：目标 $($want.Count) 行（$tgt），本次改动 $changed 个复选框；✓ 闭环验证通过（0.8 秒后复扫一致）：当前共勾选 $($onNow.Count) 行（$(Format-RowRanges $onNow)）$tail$note$memoNote"
    }
    $mi = Format-RowRanges @($missing | ForEach-Object { [int]$_.Index })
    $ex = Format-RowRanges @($extra | ForEach-Object { [int]$_.Index })
    $why = if (($missing.Count + $extra.Count) -eq 0) { '勾选状态在复扫时仍在变化（页面迟到的异步更新）' } else { "未勾上 $mi；多勾了 $ex" }
    return "select_rows $spec：✗ 未完全达成（已自动纠正）：$why；当前勾选 $($onNow.Count) 行（$(Format-RowRanges $onNow)）$note$memoNote。请 wait 1 秒后再 select_rows 一次，此时不要点删除"
}
function Test-InterlockDecision([int]$qty, [string]$name, [string]$type, [bool]$isMaster, [int]$rowCount, [int]$onCount, [bool]$inRow) {
    # 纯判定函数（自检可直接测）：返回 $null 表示放行，否则返回拒绝原因
    if ($qty -le 0 -or $rowCount -le 0) { return $null }
    $nm = "$name".Trim()
    if ($isMaster -and $rowCount -gt $qty) { return "安全联锁：任务只要求 $qty 个，禁止点击「全选」复选框（列表共 $rowCount 行）；请用 select_rows 精确勾选第 1-$qty 行" }
    if ($nm -match $script:SelectAllPattern -and $rowCount -gt $qty) { return "安全联锁：任务只要求 $qty 个，禁止使用「$nm」（会选中全部 $rowCount 行）；请用 select_rows 精确勾选第 1-$qty 行" }
    if ($nm -match $script:DestructivePattern) {
        if ($inRow -and $qty -ne 1) { return "安全联锁：「$(Limit-Text $nm 16)」位于某一行内，只会处理那一行，而任务要求 $qty 个；请先 select_rows 勾选，再点工具栏上的按钮" }
        if (-not $inRow -and $onCount -ne $qty) { return "安全联锁：任务要求处理 $qty 个，但列表当前实际勾选 $onCount 个，已拒绝「$(Limit-Text $nm 16)」（未发送任何输入）；请先用 select_rows 精确勾选第 1-$qty 行，看到 ✓ 闭环验证通过后再删除" }
    }
    return $null
}
function Find-ItemAt([int]$x, [int]$y) {
    $best = $null; $bestA = [double]::MaxValue
    foreach ($kv in $script:Elements.GetEnumerator()) {
        $it = $kv.Value
        if ($it.Off) { continue }   # 视口外的行：未裁剪的矩形可能与屏幕上别的控件重叠
        if ($x -ge $it.L -and $x -le ($it.L + $it.W) -and $y -ge $it.T -and $y -le ($it.T + $it.H)) {
            $ar = [double]$it.W * [double]$it.H
            if ($ar -lt $bestA) { $bestA = $ar; $best = $it }
        }
    }
    return $best
}
function Assert-BulkInterlock($a, [string]$kind) {
    # 只在「任务有明确数量」且目标看起来是 删除/归档/全选 时才额外扫描一次列表；-NoSafety 可关闭
    if ($NoSafety -or $script:TaskQty -le 0) { return }
    $targets = New-Object System.Collections.Generic.List[object]
    if ($kind -in 'click', 'double_click', 'check', 'click_many') {
        $idList = @()
        if ($null -ne $a.ids) { $idList = @($a.ids) } elseif (Test-IdValue $a.id) { $idList = @($a.id) }
        foreach ($i in $idList) { if ((Test-IdValue $i) -and $script:Elements.ContainsKey([int]"$i")) { $targets.Add($script:Elements[[int]"$i"]) } }
        if ($idList.Count -eq 0 -and (Test-NumValue $a.x) -and (Test-NumValue $a.y)) { $hitItem = Find-ItemAt ([int]$a.x) ([int]$a.y); if ($hitItem) { $targets.Add($hitItem) } }
    }
    elseif ($kind -in 'key', 'hotkey') {
        if ("$($a.keys)" -match '(?i)(^|[\s+])(delete|del)(\s|$)|shift\+3') {
            $targets.Add([pscustomobject]@{ Type = 'Key'; FullName = 'delete'; Name = 'delete'; IsMaster = $false; L = 0; T = 0; W = 0; H = 0 })
        }
    }
    if ($targets.Count -eq 0) { return }
    $need = $false
    foreach ($t in $targets) { $nm = "$($t.FullName)"; if (-not $nm) { $nm = "$($t.Name)" }; if ($nm -match $script:DestructivePattern -or $nm -match $script:SelectAllPattern -or [bool]$t.IsMaster) { $need = $true } }
    if (-not $need) { return }
    $m = Get-RowModel $script:ObsHwnd
    $rowCount = @($m.Rows).Count
    if ($rowCount -eq 0) { return }
    $onCount = @($m.Rows | Where-Object { $_.Cb.State -eq 'on' }).Count
    foreach ($t in $targets) {
        $nm = "$($t.FullName)"; if (-not $nm) { $nm = "$($t.Name)" }
        $inRow = ($t.W -gt 0 -and (Test-InAnyRect $t @($m.Rows | ForEach-Object { $_.Row })))
        $why = Test-InterlockDecision $script:TaskQty $nm "$($t.Type)" ([bool]$t.IsMaster) $rowCount $onCount $inRow
        if ($why) { throw $why }
    }
}
#endregion
#region ---------- 发送前校验（Schema） ----------
$script:ActionNames = @('click', 'click_many', 'check', 'uncheck', 'select_rows', 'double_click', 'right_click', 'middle_click', 'hover', 'drag', 'type', 'key', 'hotkey',
    'scroll', 'launch', 'focus_window', 'wait', 'run_powershell', 'done', 'fail')
function Test-IdValue($v) { return ($null -ne $v -and "$v" -match '^\d+$') }
function Test-NumValue($v) { return ($null -ne $v -and "$v" -ne '' -and $null -ne ("$v" -as [double])) }
function Test-ActionUsesId($a) {
    return [bool]((Test-IdValue $a.id) -or ($null -ne $a.ids) -or (Test-IdValue $a.from_id) -or (Test-IdValue $a.to_id))
}
function Test-ActionSchema($a, [int]$index) {
    # 返回 $null 表示合法，否则返回原因。任何一个动作不合法，整批都不执行。
    # v4.1：批量里允许使用 id（执行每个动作前都会实时重新核对控件：名称 + 位置 + 可见 + 可用，不符就中止其余动作）。
    $k = "$($a.action)".ToLower().Trim()
    if ($k -notin $script:ActionNames) { return "未知动作 '$($a.action)'" }
    if (($k -in 'done', 'fail') -and $index -gt 1) {
        return "$k 必须单独输出（放在其他动作之后等于没看到结果就宣布结束）；请先执行动作，下一轮看到结果后再 $k"
    }
    switch ($k) {
        { $_ -in 'click', 'double_click', 'right_click', 'middle_click', 'hover' } {
            if (Test-IdValue $a.id) {
                if (-not $script:Elements.ContainsKey([int]"$($a.id)")) { return "元素编号 $($a.id) 不存在" }
            }
            elseif (-not ((Test-NumValue $a.x) -and (Test-NumValue $a.y))) { return '需要 id，或同时提供 x 和 y' }
        }
        'click_many' {
            $ids = @($a.ids)
            if ($ids.Count -lt 1 -or $ids.Count -gt 20) { return 'click_many 需要 1~20 个 ids' }
            foreach ($i in $ids) {
                if (-not (Test-IdValue $i)) { return "click_many 的 ids 里有非法编号 '$i'" }
                if (-not $script:Elements.ContainsKey([int]"$i")) { return "元素编号 $i 不存在" }
            }
        }
        { $_ -in 'check', 'uncheck' } {
            $cids = @()
            if ($null -ne $a.ids) { $cids = @($a.ids) } elseif (Test-IdValue $a.id) { $cids = @($a.id) }
            if ($cids.Count -lt 1 -or $cids.Count -gt 60) { return "$k 需要 id 或 1~60 个 ids" }
            foreach ($i in $cids) {
                if (-not (Test-IdValue $i)) { return "$k 的 ids 里有非法编号 '$i'" }
                if (-not $script:Elements.ContainsKey([int]"$i")) { return "元素编号 $i 不存在" }
                $ci = $script:Elements[[int]"$i"]
                if ($ci.Type -ne 'CheckBox' -and $ci.Pat -notcontains 'tog') { return "元素 $i 是 $($ci.Type)，不是复选框/开关，不能 $k" }
            }
        }
        'select_rows' {
            if ([string]::IsNullOrWhiteSpace("$($a.rows)")) { return 'select_rows 需要 rows，例如 "1-10"' }
            try { [void](ConvertTo-RowList "$($a.rows)" 0) } catch { return $_.Exception.Message }
        }
        'drag' {
            foreach ($end in @(@('from_id', 'from_x', 'from_y'), @('to_id', 'to_x', 'to_y'))) {
                $hasId = Test-IdValue $a.($end[0])
                if ($hasId) {
                    if (-not $script:Elements.ContainsKey([int]"$($a.($end[0]))")) { return "元素编号 $($a.($end[0])) 不存在" }
                }
                elseif (-not ((Test-NumValue $a.($end[1])) -and (Test-NumValue $a.($end[2])))) { return "drag 需要 $($end[0]) 或 $($end[1])+$($end[2])" }
            }
        }
        'type' {
            if ([string]::IsNullOrEmpty("$($a.text)")) { return 'type 需要非空 text' }
            if ("$($a.text)".Length -gt 20000) { return 'type 的 text 过长（>20000）' }
            if ($null -ne $a.id -and "$($a.id)" -ne '') {
                if (-not (Test-IdValue $a.id)) { return 'id 必须是数字' }
                if (-not $script:Elements.ContainsKey([int]"$($a.id)")) { return "元素编号 $($a.id) 不存在" }
            }
        }
        { $_ -in 'key', 'hotkey' } {
            $seq = ("$($a.keys)" -replace '\s*\+\s*', '+').Trim()
            if ($seq -eq '') { return 'key 需要 keys' }
            foreach ($tok in @($seq -split '\s+' | Where-Object { $_ })) {
                foreach ($part in @($tok.Split('+') | Where-Object { $_ })) {
                    try { [void](Resolve-VK $part) } catch { return $_.Exception.Message }
                }
            }
        }
        'scroll' {
            if ("$($a.direction)".ToLower() -notin 'up', 'down') { return "scroll 的 direction 只能是 up 或 down" }
            if (Test-IdValue $a.id) {
                if (-not $script:Elements.ContainsKey([int]"$($a.id)")) { return "元素编号 $($a.id) 不存在" }
            }
        }
        'launch' { if ([string]::IsNullOrWhiteSpace("$($a.target)")) { return 'launch 需要 target' } }
        'focus_window' { if ([string]::IsNullOrWhiteSpace("$($a.title)")) { return 'focus_window 需要 title' } }
        'run_powershell' {
            if ($NoShell) { return '已使用 -NoShell，禁止 run_powershell' }
            if ([string]::IsNullOrWhiteSpace("$($a.command)")) { return 'run_powershell 需要 command' }
        }
        'wait' { if ($null -ne $a.seconds -and "$($a.seconds)" -ne '' -and -not (Test-NumValue $a.seconds)) { return 'wait 的 seconds 必须是数字' } }
    }
    return $null
}
#endregion
#region ---------- 动作执行（分层精确） ----------
function Test-HitTarget($item, [int]$x, [int]$y, [switch]$Strict) {
    # 目标点处「实际」的 UIA 元素必须是目标本身、其后代，或其近亲祖先。
    # -Strict（坐标吸附用）：只接受「命中元素本身或其后代」。
    # 非 Strict（物理点击前核对）：跨窗口遮挡已由 RootAt 严格拦截；同窗口内只拦截菜单 / 弹出窗口类遮挡，避免 Chrome 页面里的误判。
    try {
        $AE = [System.Windows.Automation.AutomationElement]
        $hit = $AE::FromPoint([System.Windows.Point]::new([double]$x, [double]$y))
        if ($null -eq $hit) { return (-not $Strict) }
        $w = [System.Windows.Automation.TreeWalker]::ControlViewWalker
        $cur = $hit
        for ($i = 0; $i -lt 10 -and $null -ne $cur; $i++) {
            if ([System.Windows.Automation.Automation]::Compare($cur, $item.El)) { return $true }
            $cur = $w.GetParent($cur)
        }
        if ($Strict) { return $false }
        $cur = $item.El
        for ($i = 0; $i -lt 3 -and $null -ne $cur; $i++) {
            $cur = $w.GetParent($cur)
            if ($null -ne $cur -and [System.Windows.Automation.Automation]::Compare($cur, $hit)) { return $true }
        }
        $ht = ($hit.Current.ControlType.ProgrammaticName -replace '^ControlType\.', '')
        if ($ht -in @('Menu', 'MenuItem', 'Window')) { return $false }
        return $true
    }
    catch { return $true }   # 无法核验时不误杀
}
function Find-ElementAtPoint([int]$x, [int]$y) {
    # 坐标 → 已观察控件：点必须落在某个带 UIA 模式的控件矩形内，且「实时」命中的确实是它（Strict），取面积最小者
    if ($script:Mode -notin 'Auto', 'Uia') { return $null }
    try {
        $best = $null; $bestId = 0; $bestArea = [double]::MaxValue
        foreach ($kv in $script:Elements.GetEnumerator()) {
            $it = $kv.Value
            if ($it.Type -eq 'Text' -or $it.Pat.Count -eq 0 -or $it.Off) { continue }
            if ($x -ge $it.L -and $x -le ($it.L + $it.W) -and $y -ge $it.T -and $y -le ($it.T + $it.H)) {
                $area = [double]$it.W * [double]$it.H
                if ($area -lt $bestArea) { $best = $it; $bestId = [int]$kv.Key; $bestArea = $area }
            }
        }
        if ($null -ne $best -and (Test-HitTarget $best $x $y -Strict)) { return @{ Id = $bestId; Item = $best } }
    }
    catch { }
    return $null
}
function Resolve-Target($a) {
    $vx = [DsNative4]::VirtX(); $vy = [DsNative4]::VirtY(); $vw = [DsNative4]::VirtW(); $vh = [DsNative4]::VirtH()
    if (Test-IdValue $a.id) {
        $n = [int]"$($a.id)"
        if (-not $script:Elements.ContainsKey($n)) { throw "元素编号 $n 不存在（当前只有 $($script:Elements.Count) 个元素）" }
        $item = $script:Elements[$n]
        # 发送前重新核对：控件还在、没被隐藏、没被禁用、名称没变、位置没有大幅漂移 —— 并使用「此刻」的精确坐标
        $liveName = ''; $r = $null; $enabled = $true; $offscreen = $false
        try {
            $cur = $item.El.Current
            $r = $cur.BoundingRectangle
            $enabled = [bool]$cur.IsEnabled
            $offscreen = [bool]$cur.IsOffscreen
            $liveName = $cur.Name
            if ([string]::IsNullOrWhiteSpace($liveName) -and $item.Type -ne 'Text') { $liveName = $cur.AutomationId }
        }
        catch {
            # v4.1：元素引用失效（网页重绘常见）时，先按名称+类型+就近位置重新找回，再核对
            if (Update-ItemElement $item) {
                try {
                    $cur = $item.El.Current
                    $r = $cur.BoundingRectangle
                    $enabled = [bool]$cur.IsEnabled
                    $offscreen = [bool]$cur.IsOffscreen
                    $liveName = $cur.Name
                    if ([string]::IsNullOrWhiteSpace($liveName) -and $item.Type -ne 'Text') { $liveName = $cur.AutomationId }
                }
                catch { throw "控件 [$n] $($item.Type) `"$($item.Name)`" 已不存在（界面已变化），请重新观察后再操作" }
            }
            else { throw "控件 [$n] $($item.Type) `"$($item.Name)`" 已不存在（界面已变化），请重新观察后再操作" }
        }
        if ($r.IsEmpty -or $offscreen) { throw "控件 [$n] `"$($item.Name)`" 已不可见（视口外的列表行请用 select_rows / check，无需先滚动），请重新观察" }
        if (-not $enabled) { throw "控件 [$n] `"$($item.Name)`" 当前被禁用，点击不会有效果" }
        if ($item.Name -and (Limit-Text $liveName 80) -ne $item.Name) { throw "控件 [$n] 的名称已由 `"$($item.Name)`" 变为 `"$(Limit-Text $liveName 40)`"，界面已变化，请重新观察" }
        $lx = [int]($r.Left + $r.Width / 2); $ly = [int]($r.Top + $r.Height / 2)
        $drift = [Math]::Sqrt([Math]::Pow($lx - $item.cx, 2) + [Math]::Pow($ly - $item.cy, 2))
        $tol = Get-DriftTolerance $item
        if ($drift -gt $tol) { throw "控件 [$n] 位置已偏移 $([int]$drift) 像素（容差 $tol），界面已变化，请重新观察" }
        if ($lx -le 1 -and $ly -le 1) { throw '目标坐标位于屏幕左上角保护区，拒绝操作。' }
        return @{ x = $lx; y = $ly; label = "[$n] $($item.Type) $($item.Name)"; item = $item; byId = $true }
    }
    if ((Test-NumValue $a.x) -and (Test-NumValue $a.y)) {
        $px = [Math]::Min([Math]::Max([int]$a.x, $vx + 2), $vx + $vw - 3)
        $py = [Math]::Min([Math]::Max([int]$a.y, $vy + 2), $vy + $vh - 3)
        if ($px -le 1 -and $py -le 1) { throw '目标坐标位于屏幕左上角保护区，拒绝操作。' }
        $snap = Find-ElementAtPoint $px $py
        if ($snap) {
            return @{ x = $px; y = $py; label = "($px,$py) ≈ [$($snap.Id)] $($snap.Item.Type) $($snap.Item.Name)"; item = $snap.Item }
        }
        return @{ x = $px; y = $py; label = "($px,$py)"; item = $null }
    }
    throw '需要提供 id，或者 x 和 y 坐标'
}
function Update-ItemElement($item) {
    # 重新定位控件：同名同类型的候选里取离原位置最近的，且必须在 80 像素以内
    if ([string]::IsNullOrWhiteSpace($item.FullName)) { return $false }
    try {
        $AE = [System.Windows.Automation.AutomationElement]
        $root = $AE::FromHandle($script:ObsHwnd)
        $c1 = [System.Windows.Automation.PropertyCondition]::new($AE::NameProperty, [string]$item.FullName)
        $ctName = [string]$item.Type
        $c2 = [System.Windows.Automation.PropertyCondition]::new($AE::ControlTypeProperty, [System.Windows.Automation.ControlType]::$ctName)
        $cond = [System.Windows.Automation.AndCondition]::new($c1, $c2)
        $col = $root.FindAll([System.Windows.Automation.TreeScope]::Descendants, $cond)
        $best = $null; $bestD = [double]::MaxValue
        foreach ($el in $col) {
            try {
                $r = $el.Current.BoundingRectangle
                if ($r.IsEmpty) { continue }
                $d = [Math]::Sqrt([Math]::Pow(($r.Left + $r.Width / 2) - $item.cx, 2) + [Math]::Pow(($r.Top + $r.Height / 2) - $item.cy, 2))
                if ($d -lt $bestD) { $bestD = $d; $best = $el }
            }
            catch { continue }
        }
        if ($null -ne $best -and $bestD -le (Get-DriftTolerance $item)) { $item.El = $best; return $true }
    }
    catch { }
    return $false
}
function Test-HasTarget($a) { return ((Test-IdValue $a.id) -or ((Test-NumValue $a.x) -and (Test-NumValue $a.y))) }
function Assert-PhysicalReady($t) {
    Wait-UserIdle
    $hit = [DsNative4]::RootAt($t.x, $t.y)
    if ($script:Cur -and $hit -eq $script:Cur.Hwnd) { return }
    if ($hit -ne [IntPtr]::Zero -and (Test-IsConsoleWindow $hit)) { throw '目标点位于运行本脚本的控制台窗口上，已取消（避免误点自己）。' }
    if ($t.item) {
        $expect = [DsNative4]::Root($script:ObsHwnd)
        if ($hit -ne $expect) {
            throw "目标点 ($($t.x),$($t.y)) 当前被其他窗口遮挡 [$([DsNative4]::WinClass($hit)) / $(Limit-Text ([DsNative4]::WinText($hit)) 30)]，已取消点击（未发送任何输入）。"
        }
        if (-not (Test-HitTarget $t.item $t.x $t.y)) { throw "目标点 ($($t.x),$($t.y)) 处被菜单 / 弹出层遮挡，实际不是 $($t.label)，已取消点击。" }
    }
}
function Test-MessageFriendly([int]$hwnd) {
    # 排除已知会忽略 PostMessage 鼠标消息的框架
    if ($hwnd -eq 0) { return $false }
    $root = [DsNative4]::Root([IntPtr]$hwnd)
    $cls = [DsNative4]::WinClass($root)
    return ($cls -notmatch '^(Chrome_|MozillaWindowClass|ApplicationFrameWindow|Windows\.UI\.|WinUIDesktop|Qt\d*QWindow|SunAwt|ConsoleWindowClass|CASCADIA|Shell_TrayWnd|XamlExplorerHostIslandWindow)')
}
function Invoke-UiaClickOnce($item) {
    $el = $item.El
    $order = @(switch ($item.Type) {
            'CheckBox' { 'tog', 'sel', 'inv' }
            'RadioButton' { 'sel', 'inv', 'tog' }
            { $_ -in 'ListItem', 'TabItem', 'DataItem', 'TreeItem' } { 'sel', 'inv', 'exp' }
            'ComboBox' { 'exp', 'inv' }
            'Edit' { 'focus' }
            default { 'inv', 'tog', 'sel', 'exp' }
        })
    foreach ($o in $order) {
        if ($o -eq 'focus') {
            try { $el.SetFocus(); return 'UIA 聚焦' } catch { continue }
        }
        if ($item.Pat -notcontains $o) { continue }
        try {
            switch ($o) {
                'inv' {
                    $p = $el.GetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern)
                    if (Invoke-Worker { param($p) $p.Invoke() } $p 1500) { return 'UIA Invoke' }
                    return 'UIA Invoke（1.5 秒内未返回，可能弹出了对话框）'
                }
                'tog' {
                    $p = $el.GetCurrentPattern([System.Windows.Automation.TogglePattern]::Pattern)
                    $was = "$($p.Current.ToggleState)".ToLower()
                    $p.Toggle()
                    $now = $was
                    $tEnd = (Get-Date).AddMilliseconds(1200)
                    do {
                        Start-Sleep -Milliseconds 60
                        try { $now = "$($p.Current.ToggleState)".ToLower() } catch { break }
                    } while ($now -eq $was -and (Get-Date) -lt $tEnd)
                    $script:LastClickState = $now
                    $conf = if ($now -eq $was) { '（1.2 秒内读回未变化，可能未生效）' } else { '' }
                    return "UIA Toggle：$was → 读回 $now$conf"
                }
                'sel' {
                    $p = $el.GetCurrentPattern([System.Windows.Automation.SelectionItemPattern]::Pattern)
                    $p.Select()
                    $script:LastClickState = 'selected'
                    return 'UIA Select'
                }
                'exp' {
                    $p = $el.GetCurrentPattern([System.Windows.Automation.ExpandCollapsePattern]::Pattern)
                    if ("$($p.Current.ExpandCollapseState)" -eq 'Expanded') { $p.Collapse() } else { $p.Expand() }
                    return 'UIA ExpandCollapse'
                }
            }
        }
        catch { continue }
    }
    return $null
}
function Invoke-UiaClick($item) {
    # v4.1：失败后先重新定位控件再试一次（网页重绘会让旧的元素引用失效），两次都失败才交给下一层
    $script:LastClickState = ''
    for ($attempt = 1; $attempt -le 2; $attempt++) {
        $m = Invoke-UiaClickOnce $item
        if ($m) { return $m }
        if ($attempt -eq 1) { Start-Sleep -Milliseconds 120; [void](Update-ItemElement $item) }
    }
    return $null
}
function Invoke-PointerAction([string]$kind, $a) {
    $t = Resolve-Target $a
    Move-VirtualCursor $t.x $t.y
    $item = $t.item
    if ($kind -eq 'hover') {
        Assert-PhysicalReady $t
        Set-CursorPulse 2
        [DsNative4]::PhysicalHover($t.x, $t.y, 450)
        return "已悬停 $($t.label)（真实鼠标仅借用 0.45 秒后已归位）"
    }
    $btn = switch ($kind) { 'right_click' { 1 } 'middle_click' { 2 } default { 0 } }
    $n = if ($kind -eq 'double_click') { 2 } else { 1 }
    $fallback = ''
    # ---- 第 1 层：UIA 模式（不动鼠标、不用键盘）----
    $script:LastClickState = ''
    if ($script:Mode -in 'Auto', 'Uia') {
        if ($item -and $kind -eq 'click') {
            $m = Invoke-UiaClick $item
            if ($m) {
                Set-CursorPulse 0
                Start-Sleep -Milliseconds 80
                return "已点击 $($t.label)（$m；真实鼠标未被占用）"
            }
            $fallback = '（UIA 两次尝试均失败，已降级）'
        }
        if ($script:Mode -eq 'Uia') { throw "-InputMode Uia：$kind $($t.label) 无法通过无障碍接口完成" }
    }
    # ---- 第 2 层：窗口消息（仅限有独立 HWND 的经典控件）----
    $msgHwnd = [IntPtr]::Zero
    if ($script:Mode -eq 'Message') {
        if ($item -and $item.Hwnd -ne 0) { $msgHwnd = [IntPtr]$item.Hwnd }
        else { $msgHwnd = [DsNative4]::DeepChildAt([DsNative4]::RootAt($t.x, $t.y), $t.x, $t.y) }
        if ($msgHwnd -eq [IntPtr]::Zero) { throw "找不到 ($($t.x),$($t.y)) 处的窗口句柄，无法发送窗口消息" }
    }
    elseif ($script:Mode -eq 'Auto' -and $item -and $item.Hwnd -ne 0 -and (Test-MessageFriendly $item.Hwnd)) {
        $msgHwnd = [IntPtr]$item.Hwnd
    }
    if ($msgHwnd -ne [IntPtr]::Zero) {
        if (Test-IsConsoleWindow $msgHwnd) { throw '目标是运行本脚本的控制台，已取消。' }
        if ([DsNative4]::PostClick($msgHwnd, $t.x, $t.y, $btn, $n)) {
            Set-CursorPulse $(if ($btn -eq 1) { 1 } else { 0 })
            Start-Sleep -Milliseconds 80
            return "已发送窗口消息 $kind $($t.label)（真实鼠标未被占用；消息方式无法确认生效，请以下一步观察为准）$fallback"
        }
        if ($script:Mode -eq 'Message') { throw '窗口消息发送失败' }
    }
    # ---- 第 3 层：物理输入（先让位、再校验、借用后归位）----
    $hitNote = ''
    if ($item -and $t.byId) {
        # v4.2：不盲点矩形中心，挑一个「严格命中测试」通过的落点
        try {
            $lr = $item.El.Current.BoundingRectangle
            if (-not $lr.IsEmpty) {
                $pp = Get-PrecisePoint $item $lr
                $t.x = $pp.x; $t.y = $pp.y
                $hitNote = if ($pp.verified) { '；落点已核验命中目标' } else { '；落点未能核验' }
                Move-VirtualCursor $t.x $t.y
            }
        }
        catch { }
    }
    Assert-PhysicalReady $t
    Set-CursorPulse $(if ($btn -eq 1) { 1 } else { 0 })
    if ($n -eq 2) { Start-Sleep -Milliseconds 90; Set-CursorPulse 0 }
    [DsNative4]::PhysicalClick($t.x, $t.y, $btn, $n, $true)
