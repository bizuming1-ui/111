                    if (wantVisible && !moving && !pressed && now - lastActivity > 3500 && now - rs > 600) wantVisible = false;
                    vis = wantVisible;
                }
                double target = vis ? 255.0 : 0.0;
                if (Math.Abs(target - opacity) > 0.5) {
                    double kf = 1 - Math.Exp(-dt / 70.0);
                    opacity += (target - opacity) * kf;
                    if (Math.Abs(target - opacity) < 1.0) opacity = target;
                }
                int opa = (int)Math.Round(opacity);
                double age = now - rs;
                bool rippleActive = age >= 0 && age < RippleDur;
                bool fx = rippleActive || pr;
                bool animating = mv || fx || opa != (int)target;
                if (opa > 0 || lastOpa > 0) {
                    bool contentChange = fx || bitsHaveFx;
                    if (contentChange) {
                        Array.Copy(sprite, frame, sprite.Length);
                        if (rippleActive) {
                            double tt = age / RippleDur;
                            double e = 1 - Math.Pow(1 - tt, 3);
                            double cr = 47.0 / 255.0, cg = 123.0 / 255.0, cb = 1.0;
                            if (rk == 1) { cr = 1.0; cg = 150.0 / 255.0; cb = 40.0 / 255.0; }
                            else if (rk == 2) { cr = 50.0 / 255.0; cg = 200.0 / 255.0; cb = 120.0 / 255.0; }
                            DrawRing(frame, (8 + 30 * e) * scale, 2.4 * scale, 0.9 * (1 - tt), 0.22 * (1 - tt), cr, cg, cb);
                        }
                        if (pr) DrawRing(frame, 10 * scale, 2.0 * scale, 0.75, 0.15, 47.0 / 255.0, 123.0 / 255.0, 1.0);
                        Marshal.Copy(frame, 0, bits, frame.Length);
                        bitsHaveFx = fx;
                    } else if (firstFrame) {
                        Marshal.Copy(sprite, 0, bits, sprite.Length);
                    }
                    int ox = (int)Math.Round(px) - half, oy = (int)Math.Round(py) - half;
                    if (contentChange || firstFrame || ox != lastOx || oy != lastOy || opa != lastOpa) {
                        POINT dst = new POINT(); dst.X = ox; dst.Y = oy;
                        SIZE sz = new SIZE(); sz.cx = size; sz.cy = size;
                        POINT src = new POINT();
                        BLENDFUNCTION bf = new BLENDFUNCTION(); bf.BlendOp = 0; bf.BlendFlags = 0; bf.SourceConstantAlpha = (byte)opa; bf.AlphaFormat = 1;
                        UpdateLayeredWindow(Hwnd, IntPtr.Zero, ref dst, ref sz, memDc, ref src, 0, ref bf, 2u);
                        lastOx = ox; lastOy = oy; lastOpa = opa; firstFrame = false;
                        Frames++;
                        if (mv && lastMoving) { double gap = now - lastRender; if (gap > MaxGapMs) MaxGapMs = gap; }
                        lastRender = now;
                    }
                } else { lastOpa = opa; }
                lastMoving = mv;
                if (now - lastTop > 600) { lastTop = now; SetWindowPos(Hwnd, new IntPtr(-1), 0, 0, 0, 0, 0x13u); }
                if (animating) {
                    int hr = 1;
                    try { hr = DwmFlush(); } catch { hr = 1; }
                    if (hr != 0) Thread.Sleep(6);
                } else { Thread.Sleep(10); }
            }
        } catch (Exception ex) { Error = ex.Message; }
        finally {
            try { if (Hwnd != IntPtr.Zero) DestroyWindow(Hwnd); } catch { }
            try { if (oldObj != IntPtr.Zero) SelectObject(memDc, oldObj); } catch { }
            try { if (bmp != IntPtr.Zero) DeleteObject(bmp); } catch { }
            try { if (memDc != IntPtr.Zero) DeleteDC(memDc); } catch { }
            try { if (screenDc != IntPtr.Zero) ReleaseDC(IntPtr.Zero, screenDc); } catch { }
            if (timer) { try { timeEndPeriod(1); } catch { } }
            ready.Set();
        }
    }
