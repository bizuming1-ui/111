function Get-V10ZoneOf($b, $rows, [double]$vh, [double]$vw) {
    # 返回 @{ Zone = 'Toolbar'|'Row'; Row = n }
    if ($b.ancestorToolbar -eq $true -or $b.ancestorFixedSticky -eq $true) { return [pscustomobject]@{ Zone = 'Toolbar'; Row = 0 } }
    $real = @($rows | Where-Object { Test-V10RealRow $_ $vh $vw })
    if ($null -ne $b.ancestorRowIdx -and "$($b.ancestorRowIdx)" -ne '') {
        $r = @($real | Where-Object { [int]$_.idx -eq [int]$b.ancestorRowIdx }) | Select-Object -First 1
        if ($r -and [double]$b.box.h -le ([double]$r.box.h * 1.2)) { return [pscustomobject]@{ Zone = 'Row'; Row = [int]$r.idx } }
    }
    $cx = [double]$b.box.l + [double]$b.box.w / 2.0; $cy = [double]$b.box.t + [double]$b.box.h / 2.0
    $hit = @($real | Where-Object { $cx -ge $_.box.l -and $cx -le ($_.box.l + $_.box.w) -and $cy -ge $_.box.t -and $cy -le ($_.box.t + $_.box.h) } | Sort-Object { [double]$_.box.h }) | Select-Object -First 1
