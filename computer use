// Isolated-browser takeover: never touches the user's daily profile. Attach if our debug port is up, else launch a
// dedicated Chrome/Edge with --user-data-dir + --remote-debugging-port, then attach per-tab sessions.
import { spawn } from "node:child_process";
import { existsSync, mkdirSync } from "node:fs";
import { join } from "node:path";
import { CdpSession, NetTracker } from "./cdp.js";
import { PErr, sleep } from "./protocol.js";

export interface Tab {
  targetId: string;
  s: CdpSession;
  net: NetTracker;
  navEpoch: number;   // bumps on every main-frame navigation
  docEpoch: number;   // bumps on DOM.documentUpdated
  epoch: number;      // observation counter (the protocol snapshot_epoch)
  refs: Map<number, Map<string, { backendNodeId: number; stable_key: string; navEpoch: number }>>;
}

export function findBrowser(): string | null {
  const env = process.env.DSCU_CHROME;
  if (env && existsSync(env)) return env;
  const pf = process.env["ProgramFiles"] ?? "C:\\Program Files";
  const pf86 = process.env["ProgramFiles(x86)"] ?? "C:\\Program Files (x86)";
  const la = process.env["LOCALAPPDATA"] ?? "";
  const cands = [
    join(pf, "Google\\Chrome\\Application\\chrome.exe"), join(pf86, "Google\\Chrome\\Application\\chrome.exe"), join(la, "Google\\Chrome\\Application\\chrome.exe"),
    join(pf86, "Microsoft\\Edge\\Application\\msedge.exe"), join(pf, "Microsoft\\Edge\\Application\\msedge.exe"),
    "/usr/bin/google-chrome", "/usr/bin/chromium", "/usr/bin/chromium-browser",
  ];
  return cands.find((p) => p && existsSync(p)) ?? null;
}

export class BrowserManager {
  tabs = new Map<string, Tab>();
  activeId: string | null = null;
  spawned = false;
  constructor(public port: number, public profileDir: string, public allowLaunch = true) {}

  private async json(path: string): Promise<any> {
    const r = await fetch(`http://127.0.0.1:${this.port}${path}`, { signal: AbortSignal.timeout(2500) });
    return r.json();
  }

  async up(): Promise<boolean> {
    try { await this.json("/json/version"); return true; } catch { return false; }
  }

  async ensure(): Promise<{ attached: boolean; launched: boolean; exe?: string }> {
    if (await this.up()) return { attached: true, launched: false };
    if (!this.allowLaunch) throw new PErr("NOT_FOUND", `no browser with --remote-debugging-port=${this.port} and launching is disabled`);
    const exe = findBrowser();
    if (!exe) throw new PErr("NOT_FOUND", "Chrome/Edge not found (set DSCU_CHROME to the executable path)");
    mkdirSync(this.profileDir, { recursive: true });
    const extra = (process.env.DSCU_CHROME_ARGS ?? "").split(/\s+/).filter(Boolean);
    const args = [
      `--remote-debugging-port=${this.port}`, "--remote-debugging-address=127.0.0.1", `--user-data-dir=${this.profileDir}`,
      "--no-first-run", "--no-default-browser-check", "--force-renderer-accessibility", "--disable-background-timer-throttling",
      "--disable-renderer-backgrounding", "--disable-backgrounding-occluded-windows", ...extra, "about:blank",
    ];
    const child = spawn(exe, args, { detached: true, stdio: "ignore" });
    child.unref();
    this.spawned = true;
    for (let i = 0; i < 60; i++) { if (await this.up()) return { attached: true, launched: true, exe }; await sleep(250); }
    throw new PErr("TIMEOUT", "browser did not expose the debugging port within 15s");
  }

  async listPages(): Promise<any[]> {
    const l = await this.json("/json/list");
    return l.filter((t: any) => t.type === "page" && !String(t.url).startsWith("devtools://"));
  }

  async tab(target?: { url?: string; title?: string; target_id?: string }): Promise<Tab> {
    await this.ensure();
    const pages = await this.listPages();
    if (pages.length === 0) {
      await fetch(`http://127.0.0.1:${this.port}/json/new?about:blank`, { method: "PUT" }).catch(() => undefined);
      return this.tab(target);
    }
    let pick = pages[0];
    if (target?.target_id) pick = pages.find((p) => p.id === target.target_id) ?? pick;
    else if (target?.url) pick = pages.find((p) => String(p.url).includes(target.url!)) ?? pick;
    else if (target?.title) pick = pages.find((p) => String(p.title).toLowerCase().includes(target.title!.toLowerCase())) ?? pick;
    else if (this.activeId) pick = pages.find((p) => p.id === this.activeId) ?? pick;
    this.activeId = pick.id;
    const have = this.tabs.get(pick.id);
    if (have && !have.s.closed) return have;
    const s = await CdpSession.connect(pick.webSocketDebuggerUrl);
    const tab: Tab = { targetId: pick.id, s, net: new NetTracker(s), navEpoch: 0, docEpoch: 0, epoch: 0, refs: new Map() };
    s.on("Page.frameNavigated", (p) => { if (!p.frame?.parentId) tab.navEpoch++; });
    s.on("DOM.documentUpdated", () => { tab.docEpoch++; });
    await Promise.all([s.send("Page.enable"), s.send("DOM.enable"), s.send("Network.enable"), s.send("Runtime.enable"), s.send("Accessibility.enable")]);
    this.tabs.set(pick.id, tab);
    return tab;
  }

  async bringToFront(tab: Tab) { await tab.s.send("Page.bringToFront").catch(() => undefined); }
}
