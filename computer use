#region ===================== 引导器：校验 → 释放 → 构建 → 启动 =====================
function Expand-Dscu {
    $bad = @(); $written = 0
    foreach ($f in $script:Manifest) {
        $t = ($f.Text -replace "`r`n", "`n")
        $hash = [Convert]::ToHexString([System.Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($t))).ToLowerInvariant()
        if ($hash -ne $f.Sha) { $bad += $f.Rel; continue }
        $p = Join-Path $script:Root $f.Rel
        $want = $t + "`n"
        if ((Test-Path $p) -and ([IO.File]::ReadAllText($p) -ceq $want)) { continue }
        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $p) | Out-Null
        [IO.File]::WriteAllText($p, $want, [Text.UTF8Encoding]::new($false))
        $written++
    }
    if ($bad.Count -gt 0) {
        Write-Host "✖ 以下 $($bad.Count) 个文件 SHA-256 校验失败（粘贴被终端截断/改写）：" -ForegroundColor Red
        $bad | ForEach-Object { Write-Host "   $_" -ForegroundColor Red }
        Write-Host '  建议：用 Windows Terminal 粘贴；或在网页上点「下载 .ps1」后执行  pwsh -File .\computer-use-v15.ps1' -ForegroundColor Yellow
        throw 'integrity check failed'
    }
    Write-Host ("  ✓ Monorepo 已就绪：{0} 个文件校验通过（本次写入 {1} 个）→ {2}" -f $script:Manifest.Count, $written, $script:Root) -ForegroundColor Green
    return $written
}

function Test-DscuBuilt {
    return ((Test-Path (Join-Path $script:Root '.venv/Scripts/python.exe')) -and (Test-Path (Join-Path $script:Root 'bin/build-info.json')))
}

function Invoke-DscuBuild([int]$Changed) {
    $argsB = @()
    if ($env:DSCU_WITH_RUST -eq '1') { $argsB += '-WithRust' }
    $needTools = -not ((Get-Command python -ErrorAction SilentlyContinue) -or (Get-Command py -ErrorAction SilentlyContinue)) -or -not (Get-Command node -ErrorAction SilentlyContinue)
    if ($needTools) {
        $ans = if ($env:DSCU_AUTOINSTALL -eq '1') { 'y' } else { Read-Host '检测到缺少 Python 3.12 / Node.js LTS。是否用 winget 自动安装？[Y/n]' }
        if ($ans -notmatch '^[nN]') { $argsB += '-InstallTools' }
    }
    Write-Host '▶ 首次构建（约 1–3 分钟；Rust 编译另需工具链）...' -ForegroundColor Cyan
    & (Join-Path $script:Root 'scripts/build_step1.ps1') -Root $script:Root @argsB
    if ($LASTEXITCODE -ne 0 -and -not (Test-DscuBuilt)) { throw '构建失败，请查看上方输出。' }
}

