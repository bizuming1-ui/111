            rss = psutil.Process().memory_info().rss / 1048576
        except Exception:
            pass
        return {"type": "hello_ack", "ok": True, "peer": "py-native", "version": "14.0.0", "caps": ["uia_ref", "sendinput", "verified_foreground", "occlusion", "dxcam_stream", "fg_probe", "guard_focus", "runtime_id"], "rss_mb": rss}

    async def handle(self, req: dict[str, Any]) -> dict[str, Any]:
        t = req.get("type")
        if t == "hello":
            r = await self.hello()
            r["id"] = req.get("id")
            return r
        if not IS_WIN:
            return {"type": "error", "id": req.get("id"), "ok": False, "code": "UNSUPPORTED", "message": "native driver is Windows-only"}
        return await asyncio.to_thread(self._handle_sync, req)

    def _handle_sync(self, req: dict[str, Any]) -> dict[str, Any]:
        t = req.get("type")
        if t == "observe":
            return self._observe(req)
        if t == "action":
            return self._action(req)
        if t == "fg_probe":
            r = self.fg_probe()
            r.update(type="fg_probe_result", id=req.get("id"), ok=True)
            return r
        if t == "guard_focus":
            r = self.guard_focus(int(req.get("hwnd") or 0))
            r.update(type="guard_focus_result", id=req.get("id"))
            return r
        if t == "capture_bench":
            ms, fresh = [], []
            backend, reason = "NONE", None
            for _ in range(int(req.get("frames", 100))):
                s = self._grab()
                ms.append(s["frame_ms"])
                if not s.get("timed_out_reused_frame"):
                    fresh.append(s["frame_ms"])
                backend, reason = s["capture_backend"], reason or s.get("fallback_reason")
                time.sleep(0.016 if req.get("pace", True) else 0)
            ms.sort()
            fresh.sort()
            pc = lambda a, p: a[min(len(a) - 1, round((len(a) - 1) * p))] if a else 0.0  # noqa: E731
            return {"type": "capture_bench_result", "id": req.get("id"), "backend": backend, "frames": len(ms), "p50_ms": pc(ms, .5), "p95_ms": pc(ms, .95), "p99_ms": pc(ms, .99),
                    "fresh_frames": len(fresh), "p50_fresh_ms": pc(fresh, .5), "fallback_reason": reason}
        if t == "shutdown":
            return {"type": "bye", "id": req.get("id"), "ok": True}
        return {"type": "error", "id": req.get("id"), "ok": False, "code": "UNSUPPORTED", "message": f"unknown type {t}"}

    def _observe(self, req: dict[str, Any]) -> dict[str, Any]:
        t0 = time.perf_counter()
        wins = self.windows()
        fg = self._fg()
        tgt = None
        if req.get("hwnd"):
            tgt = next((w for w in wins if w["hwnd"] == req["hwnd"]), None)
        if tgt is None:
            tgt = next((w for w in wins if w["hwnd"] == fg and not w["own_console"] and w["class"] not in SHELL), None) or next(
                (w for w in wins if not w["own_console"] and not w["minimized"] and not w["cloaked"] and w["class"] not in SHELL and w["title"]), None)
        for w in wins:
            if (tgt and w["hwnd"] == tgt["hwnd"]) or w["hwnd"] == fg:
                w["occluded_by"] = self._occluders(w, wins)
        stats = self._grab()
        env: dict[str, Any] = {"type": "observation", "id": req.get("id"), "ok": True, "channel": "uia", "snapshot_epoch": self.epoch, "hwnd": tgt["hwnd"] if tgt else 0,
                               "title": tgt["title"] if tgt else "", "process": tgt["process"] if tgt else "", "fg_hwnd": fg, "windows": wins[:40], "elements": [],
                               "dxgi_stats": stats, "screen": {"w": stats.get("width"), "h": stats.get("height")}}
        uia_ms = 0.0
        if req.get("channel") == "jab":
            env["ok"], env["error"] = False, {"code": "UNSUPPORTED", "message": "JAB not available in py-native driver"}
        elif req.get("channel") != "dxgi_vision" and tgt:
