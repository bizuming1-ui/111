function Get-NativeError($err) {
    # .NET 方法抛出的异常会被 PowerShell 包成「Exception calling ...」；还原成原始中文消息，「触发保护 / 让出控制权」等判断才认得出
    $e = $err.Exception
    while ($null -ne $e.InnerException) { $e = $e.InnerException }
    return $e.Message
}
