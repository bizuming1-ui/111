class ObjectRegistry:
    """Epoch-bound store of the *current* UnifiedObjectRef list.  Older epochs are retained read-only (for WorldStateDiff) but can never be acted on."""

    def __init__(self, min_action_conf: float = 0.5, keep_epochs: int = 4) -> None:
        self.epoch = 0
        self.objects: dict = {}
        self.history: dict = {}
        self.min_conf = min_action_conf
        self.keep = keep_epochs
        self.frozen: Optional[FrozenSet] = None

    def ingest(self, objs: list, epoch: int) -> None:
        self.epoch = int(epoch)
        self.objects = {o.object_id: o for o in objs}
        self.history[self.epoch] = dict(self.objects)
        for e in sorted(self.history)[:-self.keep]:
            self.history.pop(e, None)

    def get(self, object_id: str, epoch: Optional[int] = None) -> Optional[UnifiedObjectRef]:
        return (self.history.get(epoch, {}) if epoch is not None else self.objects).get(object_id)

    def require_current(self, object_id: str, epoch: int) -> UnifiedObjectRef:
        if int(epoch) != self.epoch:
            raise StaleSnapshotEpoch(f"snapshot_epoch={epoch} 不是当前 epoch={self.epoch}：拒绝对旧快照对象 {object_id} 执行动作，请重新观察")
        o = self.objects.get(object_id)
        if o is None:
            raise KeyError(f"object_id {object_id} 不在当前快照中")
        return o

    def resolve_point(self, x: float, y: float) -> Optional[UnifiedObjectRef]:
        """smallest object whose bbox contains the point; structured objects win ties (a toolbar trash icon inside a row band is the icon, not the row)."""
        hits = [o for o in self.objects.values() if point_in(o.visual_bbox, x, y)]
        if not hits:
            return None
        return min(hits, key=lambda o: (rect_area(o.visual_bbox), 0 if o.has_structured_evidence else 1))

    def by_role(self, action_role: str) -> list:
        return [o for o in self.objects.values() if o.action_role == action_role]

    def freeze(self, object_ids: Iterable[str], epoch: int) -> FrozenSet:
        ids = []
        labels = {}
        for oid in object_ids:
            o = self.require_current(oid, epoch)
            d = self.authorize(o, destructive=True)
            if not d.ok:
                raise PermissionError(f"{oid}: {d.code} {d.reason}")
            ids.append(oid)
            labels[oid] = (o.accessible_name or o.business_identity)[:60]
        fp = hashlib.sha256("|".join(sorted(ids)).encode()).hexdigest()[:12]
        self.frozen = FrozenSet(int(epoch), tuple(ids), fp, labels)
        return self.frozen

    def authorize(self, o: UnifiedObjectRef, destructive: bool = False) -> ObjectDecision:
        """OCR/DML candidates may be *clicked for navigation* but never get destructive authority without a business identity from DOM/UIA."""
        if o.confidence < self.min_conf:
            return ObjectDecision(False, "LOW_CONFIDENCE", f"confidence={o.confidence:.2f} < {self.min_conf}")
        if destructive and not o.verified_identity and o.action_role == "target":
            return ObjectDecision(False, "VISUAL_ONLY_NO_BUSINESS_IDENTITY", f"{o.object_id} 仅由 {'+'.join(o.sources) or '?'} 产生，没有 DOM/UIA 业务身份核验：禁止破坏性授权（可降级为需人工确认）")
        if destructive and o.candidate_only and o.action_role != "target":
            return ObjectDecision(False, "VISUAL_ONLY_NO_BUSINESS_IDENTITY", f"{o.object_id} 是纯视觉候选，禁止破坏性授权")
        return ObjectDecision(True, "OK")


