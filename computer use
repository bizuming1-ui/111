      hit = document.elementFromPoint(x, y); ok = !!hit && (hit === o2.cb || o2.cb.contains(hit) || hit.contains(o2.cb));
    }
    return JSON.stringify({ ok: true, x: x, y: y, c: state(o2.cb), hit: ok });
  }
