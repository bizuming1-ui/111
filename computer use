      if (infos.some((x) => x.targetId === this.targetId)) {
        // late-discovery safety net: a page that appeared (opener = active) but whose event we have not processed yet
        const fresh = infos.find((x) => x.type === "page" && x.openerId === this.targetId && !this.pages.has(x.targetId) && !IGNORE_URL.test(String(x.url)));
        if (fresh) { this.pages.set(fresh.targetId, { targetId: fresh.targetId, url: String(fresh.url), title: String(fresh.title ?? ""), openerId: fresh.openerId, created: Date.now() }); this.flipTo(fresh.targetId, "safety-net"); await this.pending; }
        if (!this.session) { this.session = await this.ensureSession(this.targetId); }
        return;
      }
    }
    const t = await this.cdp.send("Target.getTargets");
    const pages = (t.targetInfos as Json[]).filter((x) => x.type === "page" && !IGNORE_URL.test(String(x.url)));
    if (pages.length) { this.flipTo(pages[pages.length - 1].targetId, "ensurePage"); await this.pending; }
    else { const c = await this.cdp.send("Target.createTarget", { url: "about:blank" }); this.flipTo(c.targetId, "createTarget"); await this.pending; }
  }

  async tabs(): Promise<Json[]> {
    const t = await this.cdp.send("Target.getTargets");
    return (t.targetInfos as Json[]).filter((x) => x.type === "page" && !IGNORE_URL.test(String(x.url))).map((x, i) => ({ index: i + 1, target_id: x.targetId, url: x.url, title: x.title, active: x.targetId === this.targetId, opener: x.openerId ?? "" }));
  }

  ev<T = any>(expression: string, returnByValue = true): Promise<T> {
    return this.cdp.send("Runtime.evaluate", { expression, returnByValue, awaitPromise: true }, this.session).then((r) => r.result?.value as T);
  }

  /** Wait-CdpSettled: ignore long-lived requests (SSE / long-poll / beacons / websockets) - Gmail never reaches inflight==0. */
  relevantInflight(): number {
    const now = Date.now();
    let n = 0;
    for (const r of this.inflight.values()) {
      const age = now - r.t;
      if (age > 4000) continue;
      if (r.s && r.s !== this.session) continue;
      if (/^(WebSocket|EventSource|Ping|Beacon|Other|Media|Prefetch|CSPViolationReport)$/.test(r.type)) continue;
      if (/\/(gen_204|collect|beacon|ping|telemetry|log|events?|batchexecute|channel)\b/i.test(r.url)) continue;
      n++;
    }
    return n;
  }

  async settled(timeoutMs = 5000, quietMs = 350) {
    const t0 = Date.now();
    let quietSince = 0;
    let reason = "timeout";
    let rs = "";
    while (Date.now() - t0 < timeoutMs) {
      const [state, mutAge] = await Promise.all([
        this.ev<string>("document.readyState").catch(() => ""),
        this.ev<number>("performance.now()-(window.__dscu_mut||0)").catch(() => 9999),
      ]);
      rs = state;
      const quiet = state === "complete" && this.relevantInflight() === 0 && mutAge > 250;
      if (quiet) { if (!quietSince) quietSince = Date.now(); if (Date.now() - quietSince >= quietMs) { reason = "quiet"; break; } }
      else quietSince = 0;
      await new Promise((r) => setTimeout(r, 60));
    }
    return { settled: reason === "quiet", waited_ms: Date.now() - t0, inflight: this.relevantInflight(), inflight_total: this.inflight.size, readyState: rs, reason };
  }

  async scrollProbe(): Promise<string> {
    return (await this.ev<string>(`(()=>{const SC=${SCROLLABLES_FN};const l=SC();return JSON.stringify([Math.round(window.scrollY),...l.slice(0,3).map(e=>Math.round(e.scrollTop))])})()`).catch(() => "")) ?? "";
  }

  async page() {
    const info = await this.ev<{ url: string; title: string; vp?: Json }>("({url:location.href,title:document.title,vp:{dpr:window.devicePixelRatio,innerWidth:window.innerWidth,innerHeight:window.innerHeight,screenX:window.screenX,screenY:window.screenY,outerWidth:window.outerWidth,outerHeight:window.outerHeight}})").catch(() => ({ url: "", title: "", vp: undefined }));
    return info;
  }

  async observe(req: Json): Promise<Json> {
    try { return await this.observeOnce(req); }
    catch (e) {
      if (!Daemon.isConnErr(e) && !/timeout/i.test(String((e as Error)?.message ?? e))) throw e;
      await this.heal(`observe: ${String((e as Error)?.message ?? e)}`, Daemon.isConnErr(e));
      return await this.observeOnce(req);
    }
  }

  async observeOnce(req: Json): Promise<Json> {
    const t0 = performance.now();
    if (this.cdp.closed) await this.heal("observe: ws closed", true);
    await this.ensurePage();
    const st = await this.settled(Number(req.settle_ms ?? 1500), 200);
    const snap = await takeSnapshot(this.cdp, this.session, ++this.epoch, Number(req.max_elements ?? 250));
    this.refs = snap.refs;
    const pg = await this.page();
    return {
      type: "observation", id: req.id, ok: true, channel: "cdp", snapshot_epoch: this.epoch, hwnd: 0,
      title: pg.title, url: pg.url, process: "browser", elements: snap.elements,
      settled: st.settled, inflight: st.inflight,
      telemetry: { ...snap.stats, settle_ms: st.waited_ms, total_ms: Math.round(performance.now() - t0), browser: this.browser, viewport: pg.vp, target_id: this.targetId, tabs: this.pages.size, last_switch: this.lastSwitch },
    };
  }

  res(req: Json, ok: boolean, code: string, message: string, effect: Json = {}, t0 = performance.now()): Json {
    return { type: "action_result", id: req.id, action_id: req.action_id, ok, code, message, effect, idempotent_replay: false, latency_ms: Math.round((performance.now() - t0) * 10) / 10 };
  }

  resolve(req: Json): Ref | Json {
    const ref = String(req.ref ?? "");
    const m = /^@(\d+):/.exec(ref);
    if (!m || Number(m[1]) !== this.epoch || (req.expect_epoch !== undefined && Number(req.expect_epoch) !== this.epoch))
      return this.res(req, false, "STALE_EPOCH", `ref ${ref} is from epoch ${m?.[1]}, current epoch ${this.epoch} (page navigated or re-observed)`);
    const r = this.refs.get(ref);
    return r ?? this.res(req, false, "NOT_FOUND", `ref ${ref} unknown`);
  }

  async point(r: Ref): Promise<{ x: number; y: number } | string> {
    await this.cdp.send("DOM.scrollIntoViewIfNeeded", { backendNodeId: r.backendNodeId }, this.session).catch(() => {});
    const q = await this.cdp.send("DOM.getContentQuads", { backendNodeId: r.backendNodeId }, this.session).catch(() => ({ quads: [] }));
    const quad: number[] | undefined = q.quads?.[0];
    if (!quad) return "element has no layout box";
    const xs = [quad[0], quad[2], quad[4], quad[6]], ys = [quad[1], quad[3], quad[5], quad[7]];
    const x = (Math.min(...xs) + Math.max(...xs)) / 2, y = (Math.min(...ys) + Math.max(...ys)) / 2;
    const obj = await this.cdp.send("DOM.resolveNode", { backendNodeId: r.backendNodeId }, this.session).catch(() => null);
    if (obj?.object?.objectId) {
      const hit = await this.cdp.send("Runtime.callFunctionOn", {
        objectId: obj.object.objectId, returnByValue: true, arguments: [{ value: x }, { value: y }],
        functionDeclaration: "function(x,y){if(this.ownerDocument!==document)return 'ok';const r=this.getRootNode();const t=(r.elementFromPoint?r.elementFromPoint(x,y):document.elementFromPoint(x,y));if(!t)return 'none';if(t===this||this.contains(t)||t.contains(this))return 'ok';return 'occluded:'+t.tagName+'#'+(t.id||'')+'.'+String(t.className).slice(0,40);}",
      }, this.session).catch(() => null);
      const v = hit?.result?.value;
      if (typeof v === "string" && v.startsWith("occluded")) return v;
    }
    return { x, y };
  }

  async mouse(x: number, y: number, button = "left", count = 1) {
    const s = this.session;
    await this.cdp.send("Input.dispatchMouseEvent", { type: "mouseMoved", x, y }, s);
    for (let i = 1; i <= count; i++) {
      await this.cdp.send("Input.dispatchMouseEvent", { type: "mousePressed", x, y, button, clickCount: i }, s);
      await this.cdp.send("Input.dispatchMouseEvent", { type: "mouseReleased", x, y, button, clickCount: i }, s);
    }
  }

  async key(keys: string) {
    const map: Record<string, [string, number]> = {
      enter: ["Enter", 13], tab: ["Tab", 9], esc: ["Escape", 27], escape: ["Escape", 27], backspace: ["Backspace", 8], delete: ["Delete", 46],
      up: ["ArrowUp", 38], down: ["ArrowDown", 40], left: ["ArrowLeft", 37], right: ["ArrowRight", 39], space: [" ", 32],
      pagedown: ["PageDown", 34], pageup: ["PageUp", 33], home: ["Home", 36], end: ["End", 35],
    };
    for (const chord of keys.split(/\s+/).filter(Boolean)) {
      const parts = chord.toLowerCase().split("+");
      const k = parts.pop()!;
      let mods = 0;
      for (const p of parts) mods |= p === "alt" ? 1 : p === "ctrl" || p === "control" ? 2 : p === "meta" || p === "win" ? 4 : p === "shift" ? 8 : 0;
      const [key, vk] = map[k] ?? [k.length === 1 ? k : k, k.length === 1 ? k.toUpperCase().charCodeAt(0) : 0];
      const commands = mods === 2 && k === "a" ? ["selectAll"] : mods === 2 && k === "c" ? ["copy"] : mods === 2 && k === "v" ? ["paste"] : undefined;
      const base: Json = { key, code: key.length === 1 ? `Key${key.toUpperCase()}` : key, windowsVirtualKeyCode: vk, modifiers: mods };
      await this.cdp.send("Input.dispatchKeyEvent", { type: "keyDown", ...base, commands, text: mods === 0 && key.length === 1 ? key : key === "Enter" ? "\r" : undefined }, this.session);
      await this.cdp.send("Input.dispatchKeyEvent", { type: "keyUp", ...base }, this.session);
    }
  }

  static SAFE_REPLAY = new Set(["navigate", "key", "scroll", "scroll_into_view", "tabs", "switch_tab", "wait_selector", "wait_settled", "probe"]);

  async action(req: Json): Promise<Json> {
    const t0 = performance.now();
    const aid = String(req.action_id ?? "");
    if (aid && this.replay.has(aid)) return { ...this.replay.get(aid)!, id: req.id, idempotent_replay: true };
    let out: Json;
    try { if (this.cdp.closed) await this.heal("action: ws closed", true); out = await this.actionInner(req, t0); }
    catch (e) {
      const msg = String((e as Error).message ?? e);
      if (Daemon.isConnErr(e) || /timeout/i.test(msg)) {
        let healed: Json | null = null;
        try { healed = await this.heal(`action ${req.action}: ${msg}`, Daemon.isConnErr(e)); } catch (he) { healed = { error: String((he as Error)?.message ?? he) }; }
        if (healed && !healed.error && Daemon.SAFE_REPLAY.has(String(req.action))) {
          try { out = await this.actionInner(req, t0); out.effect = { ...(out.effect ?? {}), self_healed: true, heal: this.lastHeal }; }
          catch (e2) { out = this.res(req, false, "INTERNAL", String((e2 as Error).message ?? e2), { healed: true }, t0); }
        } else if (healed && !healed.error) {
          out = this.res(req, false, "STALE_EPOCH", `CDP 连接已断开并自愈重连（epoch=${this.epoch}，${this.lastHeal.browser_respawned ? "浏览器已按原 Profile 重新拉起并恢复页面" : "已重新附着"}）；旧元素 ref 已失效，请重新观察后再操作`, { healed: true, heal: this.lastHeal }, t0);
        } else {
          out = this.res(req, false, /timeout/i.test(msg) && !healed ? "TIMEOUT" : "INTERNAL", `${msg}（自愈失败：${healed?.error ?? "n/a"}）`, {}, t0);
        }
      } else {
        out = this.res(req, false, /timeout/i.test(msg) ? "TIMEOUT" : "INTERNAL", msg, {}, t0);
      }
    }
    if (aid && out.code !== "STALE_EPOCH") { this.replay.set(aid, out); if (this.replay.size > 512) this.replay.delete(this.replay.keys().next().value as string); }
    return out;
  }

  async actionInner(req: Json, t0: number): Promise<Json> {
    await this.ensurePage();
    const a = String(req.action);
    const before = await this.page();
    const eff: Json = { url_before: before.url, title_before: before.title, epoch_before: this.epoch };
    const done = async (message: string, wait = true): Promise<Json> => {
      const st = wait ? await this.settled(Number(req.timeout_ms ?? 2500), 250) : null;
      const after = await this.page();
      eff.url_after = after.url; eff.title_after = after.title; eff.settled = st?.settled; eff.settle_ms = st?.waited_ms; eff.inflight = st?.inflight;
      eff.page_changed = after.url !== before.url || after.title !== before.title;
      return this.res(req, true, "OK", message, eff, t0);
    };
    switch (a) {
      case "navigate": {
        const url = String(req.url ?? "");
        if (!/^https?:\/\//i.test(url) && url !== "about:blank") return this.res(req, false, "SECURITY_DENIED", "only http(s) URLs may be navigated", eff, t0);
        const r = await this.cdp.send("Page.navigate", { url }, this.session);
        if (r.errorText) return this.res(req, false, "INTERNAL", `navigate error: ${r.errorText}`, eff, t0);
        await this.cdp.send("Page.bringToFront", {}, this.session).catch(() => {});
        return done(`navigated to ${url}`);
      }
      case "tabs": { eff.tabs = await this.tabs(); eff.last_switch = this.lastSwitch; eff.active_target = this.targetId; return done(`${(eff.tabs as Json[]).length} tab(s)`, false); }
      case "switch_tab": {
        const list = await this.tabs();
        const pick = req.target_id ? list.find((x) => x.target_id === req.target_id) : req.url_contains ? list.find((x) => String(x.url).includes(String(req.url_contains))) : req.index ? list[Number(req.index) - 1] : undefined;
        if (!pick) return this.res(req, false, "NOT_FOUND", `no such tab (have ${list.length}): ${list.map((x) => x.index + ":" + String(x.url).slice(0, 40)).join(" | ")}`, eff, t0);
        this.flipTo(pick.target_id, "manual-switch");
        await this.pending;
        eff.last_switch = this.lastSwitch;
        return done(`switched to tab ${pick.index} ${String(pick.url).slice(0, 60)}`, false);
      }
      case "probe": {
        const needles = JSON.stringify((req.needles as string[] | undefined) ?? []);
        const info = await this.ev<Json>(`(()=>{const nd=${needles};const body=((document.body&&document.body.innerText)||'').slice(0,300000);return {url:location.href,title:document.title,readyState:document.readyState,body_len:body.length,inputs:[...document.querySelectorAll('input,textarea')].map(e=>e.value).filter(Boolean).slice(0,10),needles:Object.fromEntries(nd.map(n=>[n,body.includes(n)])),has_video_player:!!document.querySelector('video,xg-video-container,[class*=player]'),h1:(document.querySelector('h1')||{}).innerText||''}})()`);
        Object.assign(eff, info ?? {}, { tabs: this.pages.size, active_target: this.targetId, last_switch: this.lastSwitch });
        return this.res(req, true, "OK", `probe ${String(info?.url ?? "").slice(0, 80)}`, eff, t0);
      }
      case "eval": {  // test-harness only (evals/): disabled unless the PARENT process set DSCU_ALLOW_EVAL=1; never exposed to the model
        if (process.env.DSCU_ALLOW_EVAL !== "1") return this.res(req, false, "SECURITY_DENIED", "eval is disabled", eff, t0);
        const v = await this.ev<unknown>(String(req.expression ?? "null"));
        eff.value = typeof v === "string" ? v.slice(0, 2000) : (v ?? null);
        return done("eval ok", true);
      }
      case "wait_settled": return done("settled check", true);
      case "wait_selector": {
        const sel = JSON.stringify(String(req.selector ?? "")), txt = JSON.stringify(String(req.text ?? ""));
        const js = `(()=>{const t=${txt};const q=(root)=>{let f=null;try{f=root.querySelector(${sel})}catch(e){return null};if(f&&(!t||(f.innerText||'').includes(t)))return f;for(const e of root.querySelectorAll('*')){if(e.shadowRoot){const r=q(e.shadowRoot);if(r)return r}}return null};const el=q(document);if(!el)return false;const b=el.getBoundingClientRect();return b.width>0&&b.height>0})()`;
        const end = Date.now() + Number(req.timeout_ms ?? 8000);
        while (Date.now() < end) { if (await this.ev<boolean>(js).catch(() => false)) return done(`selector present: ${req.selector}`, false); await new Promise((r) => setTimeout(r, 150)); }
        return this.res(req, false, "TIMEOUT", `selector not found within timeout (404 / login wall / different DOM?): ${req.selector}`, eff, t0);
      }
      case "key": await this.key(String(req.keys ?? "")); return done(`keys ${req.keys}`);
      case "scroll": {
        const sgn = req.direction === "up" ? -1 : 1;
        const dy = sgn * Number(req.amount ?? 5) * 100;
        const before = await this.scrollProbe();
        await this.cdp.send("Input.dispatchMouseEvent", { type: "mouseWheel", x: 400, y: 400, deltaX: 0, deltaY: dy }, this.session);
        await new Promise((r) => setTimeout(r, 140));
        let after = await this.scrollProbe();
        let method = "wheel";
        if (after === before) {  // wheel had no effect (inner scroll container / overflow:hidden body / focus elsewhere)
          const m = await this.ev<string>(`(()=>{const SC=${SCROLLABLES_FN};const l=SC();const el=l[0];if(!el){window.scrollBy(0,${dy});return 'window'}el.scrollBy({top:${dy},behavior:'instant'});return 'container:'+el.tagName+'#'+(el.id||'')+'.'+String(el.className).slice(0,30)})()`).catch(() => "none");
          method = String(m);
          await new Promise((r) => setTimeout(r, 120));
          after = await this.scrollProbe();
          if (after === before) {  // focus the container and send keys
            await this.ev(`(()=>{const SC=${SCROLLABLES_FN};const el=SC()[0];if(el){el.setAttribute('tabindex','-1');el.focus()}})()`).catch(() => {});
            await this.key(sgn > 0 ? (Number(req.amount ?? 5) >= 15 ? "end" : "pagedown") : (Number(req.amount ?? 5) >= 15 ? "home" : "pageup"));
            await new Promise((r) => setTimeout(r, 160));
            after = await this.scrollProbe();
            method = "focus+" + (sgn > 0 ? "PageDown/End" : "PageUp/Home");
          }
        }
        eff.scroll = { method, before, after, moved: before !== after };
        if (before === after) return this.res(req, false, "NOT_FOUND", `scroll 无效：滚轮/容器 scrollBy/焦点按键 均未使页面移动（${before}）；页面可能已到达边界`, eff, t0);
        return done(`scrolled ${req.direction} via ${method}`, true);
      }
      case "scroll_into_view": {
        if (req.ref) {
          const r = this.resolve(req);
          if ("type" in r && (r as Json).type === "action_result") return r as Json;
          await this.cdp.send("DOM.scrollIntoViewIfNeeded", { backendNodeId: (r as Ref).backendNodeId }, this.session);
          return done(`scrollIntoView ${req.ref}`, true);
        }
        const txt = JSON.stringify(String(req.text ?? ""));
        const ok = await this.ev<boolean>(`(()=>{const t=${txt};if(!t)return false;const w=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let n;while((n=w.nextNode())){if(n.nodeValue&&n.nodeValue.includes(t)&&n.parentElement){n.parentElement.scrollIntoView({block:'center',inline:'nearest'});return true}}return false})()`).catch(() => false);
        if (!ok) return this.res(req, false, "NOT_FOUND", `scroll_into_view: 页面文本中未找到 ${req.text}`, eff, t0);
        return done(`scrollIntoView text=${req.text}`, true);
      }
      case "click": case "double_click": case "right_click": case "hover": case "invoke": case "type": case "set_value": {
        const r = this.resolve(req);
        if ("type" in r && (r as Json).type === "action_result") return r as Json;
        const ref = r as Ref;
        if (a === "type" || a === "set_value") {
          await this.cdp.send("DOM.focus", { backendNodeId: ref.backendNodeId }, this.session).catch(() => {});
          if (req.clear !== false) await this.key("ctrl+a");
          await this.cdp.send("Input.insertText", { text: String(req.text ?? "") }, this.session);
          const obj = await this.cdp.send("DOM.resolveNode", { backendNodeId: ref.backendNodeId }, this.session).catch(() => null);
          if (obj?.object?.objectId) {
            const rb = await this.cdp.send("Runtime.callFunctionOn", { objectId: obj.object.objectId, returnByValue: true, functionDeclaration: "function(){return this.value!==undefined?this.value:this.innerText}" }, this.session).catch(() => null);
            eff.readback = String(rb?.result?.value ?? "").slice(0, 200);
          }
          if (req.enter) await this.key("enter");
          return done(`typed ${String(req.text ?? "").length} chars (trusted CDP input)`);
        }
        const p = await this.point(ref);
        if (typeof p === "string") return this.res(req, false, p.startsWith("occluded") ? "OCCLUDED" : "NOT_FOUND", p, eff, t0);
        await this.mouse(p.x, p.y, a === "right_click" ? "right" : "left", a === "double_click" ? 2 : a === "hover" ? 0 : 1);
        eff.point = [Math.round(p.x), Math.round(p.y)];
        return done(`${a} ${req.ref} '${ref.name}' (trusted CDP input)`);
      }
      default: return this.res(req, false, "UNSUPPORTED", `unknown action ${a}`, eff, t0);
    }
  }

  async handle(req: Json): Promise<Json> {
    switch (req.type) {
      case "hello": return { type: "hello_ack", id: req.id, ok: true, peer: "cdp-daemon", version: "15.0.0", caps: ["ax_dom_fusion", "zones", "epoch_refs", "settled", "trusted_input", "multi_tab_auto_attach", "profile_modes", "probe", "self_heal", "scroll_container", "scroll_into_view", "target_crash_recovery"], rss_mb: Math.round(process.memoryUsage().rss / 1048576), browser: this.browser, port: PORT, profile_mode: PROFILE_MODE, profile_dir: PROFILE, browser_pids: this.browserPid ? [this.browserPid] : [], tabs: this.pages.size };
      case "status": return { type: "status", id: req.id, ok: true, reconnects: this.reconnects, crashes: this.crashes, epoch: this.epoch, browser: this.browser, browser_pids: this.browserPid ? [this.browserPid] : [], tabs: this.pages.size, ws_open: !this.cdp.closed, healing: !!this.healing, heartbeat_ms: this.hbMs, last_heal: this.lastHeal, last_urls: this.lastUrls };
      case "heal": { try { const h = await this.heal(String(req.reason ?? "client request"), req.force === true); return { type: "heal_result", id: req.id, ok: true, ...h, browser_pids: this.browserPid ? [this.browserPid] : [], epoch: this.epoch }; } catch (e) { return { type: "error", id: req.id, ok: false, code: "INTERNAL", message: String((e as Error).message ?? e) }; } }
      case "observe": return this.observe(req);
      case "action": return this.action(req);
      case "shutdown": {
        this.shuttingDown = true; if (this.hb) clearInterval(this.hb);
        if (PROFILE_MODE === "ephemeral") { try { await this.cdp.send("Browser.close", {}, undefined, 2000); } catch { /* ignore */ } setTimeout(() => { try { rmSync(PROFILE, { recursive: true, force: true, maxRetries: 8, retryDelay: 250 }); } catch { /* best effort */ } process.exit(0); }, 600); }
        else setTimeout(() => process.exit(0), 50);
        return { type: "bye", id: req.id, ok: true };
      }
      default: return { type: "error", id: req.id, ok: false, code: "UNSUPPORTED", message: `unknown type ${req.type}` };
    }
  }
}

async function main() {
  const d = new Daemon();
  await d.start();
  const server = net.createServer((sock) => {
    let buf = "";
    let authed = TOKEN === "";
    sock.setEncoding("utf8");
    sock.on("data", (chunk: string) => {
      buf += chunk;
      let i: number;
      while ((i = buf.indexOf("\n")) >= 0) {
        const line = buf.slice(0, i).trim();
        buf = buf.slice(i + 1);
        if (!line) continue;
        let req: Json;
        try { req = JSON.parse(line); } catch { sock.write(JSON.stringify({ type: "error", ok: false, code: "INTERNAL", message: "bad json" }) + "\n"); continue; }
        if (!authed) {
