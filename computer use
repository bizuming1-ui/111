Add-DscuFile 'scripts/build_step1.ps1' '1b95f3e9acfdcd32a56cc4926fa04a929c7957713209e6b08078ef0408e24fcb' @'
#Requires -Version 7.0
<#
.SYNOPSIS
  One-click build/start/verify for the unified agent monorepo (Python brain + Rust dscu-driver + TS cdp-daemon).
.EXAMPLE
  pwsh scripts/build_step1.ps1                 # build what the machine can build, explicit tier report
  pwsh scripts/build_step1.ps1 -InstallTools   # winget-install Python 3.12 / Node LTS when missing
  pwsh scripts/build_step1.ps1 -WithRust       # also winget-install Rustup + VS Build Tools (several GB) and build dscu-driver.exe
  pwsh scripts/build_step1.ps1 -Verify         # run tests/verify_step1_live.py afterwards
#>
param(
    [string]$Root = (Split-Path -Parent $PSScriptRoot),
    [switch]$InstallTools, [switch]$WithRust, [switch]$SkipRust, [switch]$Verify, [switch]$Start, [switch]$Llm
)
$ErrorActionPreference = 'Stop'
function Step($m) { Write-Host "▶ $m" -ForegroundColor Cyan }
function Warn($m) { Write-Host "  ⚠ $m" -ForegroundColor Yellow }
function Ok($m) { Write-Host "  ✓ $m" -ForegroundColor Green }
function Refresh-Path { $env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User') }
function Winget-Install($id, $extra = @()) {
    if (-not (Get-Command winget -ErrorAction SilentlyContinue)) { Warn "winget 不可用，请手动安装 $id"; return $false }
    winget install -e --id $id --accept-source-agreements --accept-package-agreements @extra | Out-Host
    Refresh-Path; return $true
}
Set-Location $Root
$info = [ordered]@{ built = (Get-Date).ToString('s'); python = $null; node = $null; rust_driver = $false; tier = 'py-native' }

# ---------------------------------------------------------------- Python
Step 'Python (>=3.10, recommended 3.12)'
function Find-Python {
    foreach ($c in @(@('py', '-3.12'), @('py', '-3.13'), @('py', '-3.11'), @('py', '-3.10'), @('python'), @('python3'))) {
        $exe = Get-Command $c[0] -ErrorAction SilentlyContinue
        if (-not $exe) { continue }
        try {
            $args2 = @(); if ($c.Count -gt 1) { $args2 += $c[1] }
            $v = & $c[0] @args2 -c "import sys;print('%d.%d'%sys.version_info[:2])" 2>$null
            if ($v -and [version]$v -ge [version]'3.10') { return , @($c[0], $args2) }
        } catch { }
    }
    return $null
}
$py = Find-Python
if (-not $py -and $InstallTools) { Winget-Install 'Python.Python.3.12' | Out-Null; $py = Find-Python }
if (-not $py) { throw "未找到 Python >= 3.10。运行：winget install -e --id Python.Python.3.12 ，或加 -InstallTools 重试。" }
$pyExe = $py[0]; $pyPre = @($py[1])
$info.python = (& $pyExe @pyPre -c "import sys;print(sys.version.split()[0])")
Ok "Python $($info.python)"
$venv = Join-Path $Root '.venv'
if (-not (Test-Path "$venv\Scripts\python.exe")) { Step '创建 venv'; & $pyExe @pyPre -m venv $venv }
$vpy = "$venv\Scripts\python.exe"
Step '安装 Python 依赖'
& $vpy -m pip install -q --disable-pip-version-check -r (Join-Path $Root 'requirements.txt')
if ($LASTEXITCODE -ne 0) { throw 'pip install 失败' }
Ok 'pydantic / httpx / psutil / pillow'

# ---------------------------------------------------------------- Node (CDP daemon)
Step 'Node.js (>=22.6，用于 TS CDP 守护进程，无需 npm install)'
function Node-Ok { $n = Get-Command node -ErrorAction SilentlyContinue; if (-not $n) { return $false }; $v = (& node -v).TrimStart('v'); return ([version]($v -replace '^(\d+\.\d+).*', '$1') -ge [version]'22.6') }
if (-not (Node-Ok) -and $InstallTools) { Winget-Install 'OpenJS.NodeJS.LTS' | Out-Null }
