    $b = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
    $bmp = New-Object System.Drawing.Bitmap $b.Width, $b.Height
    $g = [System.Drawing.Graphics]::FromImage($bmp)
    try {
        $g.CopyFromScreen($b.Location, [System.Drawing.Point]::Empty, $b.Size)
        $bmp.Save($path, [System.Drawing.Imaging.ImageFormat]::Png)
    }
    finally { $g.Dispose(); $bmp.Dispose() }
}
function Test-Abort {
    $p = [DsNative4]::CursorPos()
    if ($p[0] -le 0 -and $p[1] -le 0) { throw '触发保护：鼠标位于屏幕左上角，已紧急停止当前任务。' }
    $ctrl = [DsNative4]::GetAsyncKeyState(0x11) -band 0x8000
    $alt = [DsNative4]::GetAsyncKeyState(0x12) -band 0x8000
    $q = [DsNative4]::GetAsyncKeyState(0x51) -band 0x8000
    if ($ctrl -and $alt -and $q) { throw '触发保护：检测到 Ctrl+Alt+Q，已紧急停止当前任务。' }
}
function Wait-Safe([int]$ms) {
    $end = (Get-Date).AddMilliseconds($ms)
    while ((Get-Date) -lt $end) {
        Test-Abort
        $remain = [int](($end - (Get-Date)).TotalMilliseconds)
        Start-Sleep -Milliseconds ([Math]::Min(100, [Math]::Max(1, $remain)))
    }
}
function Reset-AbortState {
    try {
        $w = [DsNative4]::PrimaryW(); $h = [DsNative4]::PrimaryH()
        $pos = [DsNative4]::CursorPos()
        if ($pos[0] -le 5 -and $pos[1] -le 5) { [DsNative4]::SetCursor([int]($w / 2), [int]($h / 2)) }
        $end = (Get-Date).AddSeconds(4)
        while ((Get-Date) -lt $end) {
            $ctrl = [DsNative4]::GetAsyncKeyState(0x11) -band 0x8000
            $alt = [DsNative4]::GetAsyncKeyState(0x12) -band 0x8000
            $q = [DsNative4]::GetAsyncKeyState(0x51) -band 0x8000
            if (-not ($ctrl -and $alt -and $q)) { break }
            Start-Sleep -Milliseconds 100
        }
    }
    catch { }
}
function Restore-Console {
    if ($script:ConsoleHwnd -eq [IntPtr]::Zero) { return }
    try { [void][DsNative4]::Activate($script:ConsoleHwnd) } catch { }
}
function Wait-UserIdle {
    # 用户正在用键鼠时让出控制权：避免我们的物理输入和你的操作交错
    $end = (Get-Date).AddSeconds(8)
    while ([DsNative4]::UserIdleMs() -lt $IdleMs) {
        Test-Abort
        if ((Get-Date) -gt $end) { throw '你正在使用键盘/鼠标，为避免冲突已让出控制权（本次物理输入未发送）；请稍后让模型重试。' }
        Start-Sleep -Milliseconds 40
    }
}
function Test-IsConsoleWindow([IntPtr]$h) {
    if ($script:ConsoleHwnd -eq [IntPtr]::Zero -or $h -eq [IntPtr]::Zero) { return $false }
    return ([DsNative4]::Root($h) -eq [DsNative4]::Root($script:ConsoleHwnd))
}
function Wait-UiSettled([int]$minMs = 150, [int]$maxMs = 1200) {
    # 操作之后等界面「稳定」：前台窗口与标题连续两次采样一致即返回（页面/弹窗仍在加载时多等一会儿）
    $end = (Get-Date).AddMilliseconds($maxMs)
    Start-Sleep -Milliseconds $minMs
    $fg = [DsNative4]::GetForegroundWindow()
    $last = "$fg|$([DsNative4]::WinText($fg))"
    while ((Get-Date) -lt $end) {
        Test-Abort
        Start-Sleep -Milliseconds 150
        $fg = [DsNative4]::GetForegroundWindow()
        $now = "$fg|$([DsNative4]::WinText($fg))"
        if ($now -eq $last) { break }
        $last = $now
    }
}
function New-KeySet($arr) {
    $h = [System.Collections.Generic.HashSet[string]]::new()
    foreach ($k in $arr) { [void]$h.Add([string]$k) }
    return , $h
}
function Get-ObservationDiff($prevKeys, $curKeys, [string]$prevTitle, [string]$curTitle) {
    # 对比两轮观察：标题变化 + 新增/消失的控件（控件键 = 类型|名称|状态，所以勾选/取消勾选也会体现）
    if ($null -eq $prevKeys) { return '' }
    $added = @($curKeys | Where-Object { -not $prevKeys.Contains($_) })
    $removed = @($prevKeys | Where-Object { -not $curKeys.Contains($_) })
    $parts = New-Object System.Collections.Generic.List[string]
    if ($prevTitle -ne $curTitle) { $parts.Add("前台窗口标题: [$(Limit-Text $prevTitle 40)] → [$(Limit-Text $curTitle 40)]") }
    if ($added.Count -eq 0 -and $removed.Count -eq 0) {
        if ($parts.Count -eq 0) { $parts.Add('控件列表与上一轮完全相同（上一步可能没有生效，或页面仍在加载）') }
        else { $parts.Add('控件列表与上一轮相同') }
    }
    else {
        if ($added.Count -gt 0) {
            $ex = ($added | Select-Object -First 5 | ForEach-Object { Limit-Text (($_ -replace '#\d+$', '') -replace '\|', ' ') 45 }) -join ' ； '
            $parts.Add("新增 $($added.Count) 个: $ex")
        }
        if ($removed.Count -gt 0) {
            $ex = ($removed | Select-Object -First 5 | ForEach-Object { Limit-Text (($_ -replace '#\d+$', '') -replace '\|', ' ') 45 }) -join ' ； '
            $parts.Add("消失 $($removed.Count) 个: $ex")
        }
    }
    return ($parts -join "`n  ")
}
