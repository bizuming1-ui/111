    out: list[tuple] = []
    for pol, c in clause_events(task):
        if pol != "DELETE_OR_CLEAR":
            continue
        for m in WIN_PATH.findall(c):
            out.append(("path", Path(m)))
        for m in FOLDER_NAME_RX.finditer(c):
            nm = m.group("name").strip("“”\"'.")
            if not nm or nm in GENERIC_NAMES:
                continue
            out.append(("name", layer0.known_folder(m.group("folder")), nm))
    if not out and task_polarity(task) == "DELETE_OR_CLEAR" and re.search(r"文件|记事本|文档|file|txt", task, re.I):
