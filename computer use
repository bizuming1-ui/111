fn pi(p: &Value, k: &str) -> Option<i64> {
    match p.get(k) {
        Some(Value::Number(n)) => n.as_i64().or_else(|| n.as_f64().map(|f| f as i64)),
        Some(Value::String(s)) => s.trim().parse().ok(),
        _ => None,
    }
}
fn ps<'a>(p: &'a Value, k: &str) -> Option<&'a str> {
    p.get(k).and_then(|v| v.as_str())
}
fn pb(p: &Value, k: &str) -> bool {
    p.get(k).and_then(|v| v.as_bool()).unwrap_or(false)
}

pub fn is_mutating(m: &str) -> bool {
    matches!(m, "uia.act" | "jab.act" | "notifications.dismiss" | "system.open_surface") || m.starts_with("input.")
}

fn plane_of(m: &str) -> &'static str {
    match m.split('.').next().unwrap_or("") {
        "capture" => "capture",
        "uia" | "window" => "uia",
        "jab" => "jab",
        "notifications" | "system" | "input" => "input",
        _ => "ipc",
    }
}

fn map_perr(e: PErr) -> RpcError {
    match e {
        PErr::OutOfBounds(m) => RpcError::new(ErrKind::OutOfBounds, m),
        PErr::NotFound(m) => RpcError::new(ErrKind::NotFound, m),
        PErr::Unsupported(m) => RpcError::new(ErrKind::PlatformUnsupported, m),
        PErr::Timeout(m) => RpcError::new(ErrKind::Timeout, m),
        PErr::NoPattern(m) => RpcError::new(ErrKind::PolicyDenied, m),
        PErr::Stale(m) => RpcError::new(ErrKind::StaleRef, m).with_data(json!({ "reason": "element_missing" })),
        PErr::Ambiguous(c) => RpcError::new(ErrKind::AmbiguousTarget, "several live elements match").with_data(json!({ "candidates": c })),
        PErr::Other(m) => RpcError::new(ErrKind::Internal, m),
    }
}

fn region(p: &Value, scr: Rect) -> Rect {
    let w = pi(p, "w").unwrap_or(scr.w as i64) as i32;
    let h = pi(p, "h").unwrap_or(scr.h as i64) as i32;
    Rect { x: pi(p, "x").unwrap_or(scr.x as i64) as i32, y: pi(p, "y").unwrap_or(scr.y as i64) as i32, w, h }
}

impl Engine {
    pub fn new(platform: Arc<dyn Platform>, cfg: EngineConfig) -> Engine {
        let trace = format!("{:032x}", (now_ns() as u128) << 32 | std::process::id() as u128);
        let st = State {
            idem: IdemState::default(),
            store: Store::new(6),
            rec: Recorder::new(trace),
            mem: MemGuard::new(cfg.memory_floor_mb),
            sidecar: SidecarTtl::new(cfg.sidecar_ttl_sec),
            last_mem_ms: 0,
            last_action_id: 0,
        };
        Engine { platform, cfg, st: Mutex::new(st), shutdown: AtomicBool::new(false), mock_hook: Mutex::new(None) }
    }

    pub fn platform_shutdown(&self) {
        self.platform.sidecar_stop();
    }

    pub fn set_mock_hook(&self, f: Box<dyn Fn(i64, &str) + Send + Sync>) {
        *self.mock_hook.lock().unwrap() = Some(f);
    }

    /// Called ~1/s by the daemon: updates the UMA guard and returns side effects to perform ("unload_sidecar").
    pub fn tick(&self) -> Vec<&'static str> {
        let avail = self.platform.avail_memory_mb();
        let mut st = self.st.lock().unwrap();
        let tr = st.mem.update(avail);
        st.last_mem_ms = now_ms();
        let force = st.mem.tripped;
        let mut acts = vec![];
        if st.sidecar.should_unload(now_ms(), force) {
            drop(st);
            self.platform.sidecar_stop();
            st = self.st.lock().unwrap();
            acts.push("unload_sidecar");
        }
        if tr == Transition::Tripped {
            acts.push("memory_trip");
        }
        acts
    }

    pub fn handle_line(&self, line: &str) -> String {
        match parse_request(line) {
            Err((id, e)) => err_response(&id, &e),
            Ok(req) => {
                let t0 = Instant::now();
                let res = self.handle(&req);
                let ms = t0.elapsed().as_secs_f64() * 1000.0;
                self.st.lock().unwrap().rec.add(plane_of(&req.method), &req.method, ms, now_ns(), req.action_id.unwrap_or(0));
                match res {
                    Ok(v) => ok_response(&req.id, v),
                    Err(e) => err_response(&req.id, &e),
                }
            }
        }
    }

    fn authorize(&self, req: &Request) -> Result<bool, RpcError> {
        let Some(tok) = &self.cfg.token else { return Ok(true) };
        match &req.auth {
            Some(a) if ct_eq(a, tok) => Ok(true),
            Some(_) => Err(RpcError::new(ErrKind::AuthFailed, "invalid auth token")),
            None if matches!(req.method.as_str(), "driver.ping" | "driver.info") => Ok(false), // public, minimal answers only
            None => Err(RpcError::new(ErrKind::AuthRequired, "auth token required (see %LOCALAPPDATA%\\DeepSeekComputerUse\\driver.token)")),
