class Harness:
    def __init__(self, run_dir: Path, tier: str, allow_exec: bool = False, allow_destructive: bool = False, cdp_port: int = 9222) -> None:
        self.run_dir, self.tier = run_dir, tier
        self.allow_exec, self.allow_destructive, self.cdp_port = allow_exec, allow_destructive, cdp_port
        self.brain: Any = None

