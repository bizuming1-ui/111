//! dscu.dll C-ABI.  RULE: every export is wrapped in `catch_unwind` -> a Rust panic can never cross the FFI boundary
//! (requires panic = "unwind" in the release profile).  Error codes: see include/dscu_shm.h.
use crate::{app_resolve, shm};
use serde_json::Value;
use std::ffi::{c_char, CStr};
use std::panic::{catch_unwind, AssertUnwindSafe};

pub const DSCU_OK: i32 = 0;
pub const DSCU_ERR_ARG: i32 = -1;
pub const DSCU_ERR_BUF: i32 = -2;
pub const DSCU_ERR_PANIC: i32 = -100;

macro_rules! guard { ($body:expr) => { match catch_unwind(AssertUnwindSafe(|| $body)) { Ok(v) => v, Err(_) => DSCU_ERR_PANIC } }; }

/// Decode + validate one NDJSON request line (pure; the cargo-fuzz target hammers this).
pub fn decode_line(b: &[u8]) -> Result<Value, &'static str> {
    if b.len() > (1 << 20) { return Err("line too long"); }
    let v: Value = serde_json::from_slice(b).map_err(|_| "bad json")?;
    if !v.is_object() { return Err("not an object"); }
    if v.get("cmd").map(|c| c.is_string()).unwrap_or(false) || v.get("action").map(|c| c.is_string()).unwrap_or(false) { Ok(v) } else { Err("missing cmd/action") }
}

#[no_mangle] pub extern "C" fn dscu_abi_version() -> u32 { 12 }

/// Decode a request; writes the normalised compact JSON to `out` (NUL-terminated). Returns bytes written or a negative code.
#[no_mangle]
pub unsafe extern "C" fn dscu_protocol_decode(buf: *const u8, len: usize, out: *mut c_char, cap: usize) -> i32 {
    guard!({
        if buf.is_null() || out.is_null() { return DSCU_ERR_ARG; }
        match decode_line(std::slice::from_raw_parts(buf, len)) {
            Ok(v) => { let s = v.to_string(); if s.len() + 1 > cap { return DSCU_ERR_BUF; } std::ptr::copy_nonoverlapping(s.as_ptr(), out as *mut u8, s.len()); *out.add(s.len()) = 0; s.len() as i32 }
            Err(_) => DSCU_ERR_ARG,
        }
    })
}

