"""
v18.1 Action Transaction — every side effect is a strongly-typed 2-phase transaction.

    PREPARE   : preconditions (object identity/epoch via WorldModel, foreground/HWND hooks) + authorization policy + idempotency check     → nothing has changed yet
    COMMIT    : journal(prepared) → execute → journal(executed) → ExpectedWorldDelta + Postcondition oracle rows                          → committed | no_effect | failed
    A transaction only reports `committed` when INDEPENDENT evidence proves the world changed exactly as declared (no collateral change).

Key properties
  * IdempotencyKey = sha256(goal_id | op | target identity) — a replay of an already-committed key never re-executes; for IRREVERSIBLE ops a replay whose oracle no longer holds is refused.
  * Safety balance (用户授予最高权限，但不可逆操作仍须身份校验)：reversible work is never refused; irreversible work (permanent delete / send / pay) needs (a) explicit
    authorization compiled from the task text, (b) the target identity ∈ the goal's frozen set, (c) a human confirmation only when the selection is broad (DSCU_IRREVERSIBLE_CONFIRM=auto|always|never).
  * The system never "reaches completion" by altering the target or skipping a step: a failed oracle is `ACTION_NO_EFFECT`, not success.
  * Append-only JSONL ledger (flush+fsync per phase) → crash forensics; complements the v16.2 WAL.
"""
from __future__ import annotations

import asyncio
import hashlib
import json
import os
import re
import time
from dataclasses import dataclass, field
from enum import Enum
from pathlib import Path
from typing import Any, Awaitable, Callable, Optional

from .world_model import WorldObjectRef

Rows = list[dict[str, Any]]


class TxStatus(str, Enum):
    COMMITTED = "committed"
    REPLAYED = "replayed"
    PRECONDITION_FAILED = "precondition_failed"
    DENIED = "denied"
    DECLINED = "declined"
    NO_EFFECT = "no_effect"
    FAILED = "failed"


class Reversibility(str, Enum):
    REVERSIBLE = "reversible"
    IRREVERSIBLE = "irreversible"


def row(name: str, ok: bool, detail: str, *, evaluated: bool = True, source: str = "") -> dict[str, Any]:
    """Same row shape as recycle_bin._row so Layer-0 oracles and transactions share one evidence vocabulary."""
    return {"name": name, "ok": ok, "detail": detail, "kind": "tx", "evaluated": evaluated, "source": source}


def idempotency_key(goal_id: str, op: str, target_identity: str) -> str:
    return hashlib.sha256(f"{goal_id}|{op}|{target_identity}".encode()).hexdigest()[:24]


@dataclass
class Precondition:
    name: str
    check: Callable[[], tuple[bool, str, str]]   # → (ok, ErrorCode, detail)


@dataclass
class ExpectedWorldDelta:
    """The declared change of ONE container: exactly `removed` identities leave, exactly `added` identities arrive, nothing else moves."""
    container: str
    snapshot: Callable[[], set[str]]
    removed: frozenset = frozenset()
    added: frozenset = frozenset()
    allow_added: bool = True      # unrelated arrivals (another app dropping a file) must not turn a proven deletion into a failure; collateral REMOVALS always fail

    def verify(self, before: set[str], after: set[str]) -> dict[str, Any]:
        got_removed, got_added = before - after, after - before
        ok = got_removed == set(self.removed) and (self.allow_added or got_added == set(self.added))
        extra = (got_removed - set(self.removed)) | ((got_added - set(self.added)) if not self.allow_added else set())
        miss = (set(self.removed) - got_removed) | (set(self.added) - got_added)
        return row("world_delta_exact", ok, f"{self.container}: 预期 -{len(self.removed)}/+{len(self.added)}；实际 -{len(got_removed)}/+{len(got_added)}"
                   + (f"；意外变化 {sorted(extra)[:2]}" if extra else "") + (f"；缺失变化 {sorted(miss)[:2]}" if miss else ""), source="WorldModel")


