"""Optional AMD Radeon 780M onnxruntime-directml sidecar.  MemoryFloorMB=4096, 180 s idle unload, no CUDA dependency
(a remote-CUDA endpoint slot is reserved but disabled by default)."""
from __future__ import annotations
import time
from dataclasses import dataclass, field

MEMORY_FLOOR_MB = 4096
IDLE_UNLOAD_S = 180.0


def available_mb() -> int:
    try:
        import ctypes

        class MEMSTAT(ctypes.Structure):
            _fields_ = [("dwLength", ctypes.c_ulong), ("dwMemoryLoad", ctypes.c_ulong), ("ullTotalPhys", ctypes.c_ulonglong),
                        ("ullAvailPhys", ctypes.c_ulonglong), ("ullTotalPageFile", ctypes.c_ulonglong),
                        ("ullAvailPageFile", ctypes.c_ulonglong), ("ullTotalVirtual", ctypes.c_ulonglong),
                        ("ullAvailVirtual", ctypes.c_ulonglong), ("ullAvailExtendedVirtual", ctypes.c_ulonglong)]
        st = MEMSTAT(); st.dwLength = ctypes.sizeof(MEMSTAT)
        ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(st))        # type: ignore[attr-defined]
        return int(st.ullAvailPhys // (1024 * 1024))
    except Exception:  # noqa: BLE001
        try:
            for ln in open("/proc/meminfo"):
                if ln.startswith("MemAvailable:"):
                    return int(ln.split()[1]) // 1024
        except OSError:
            pass
    return 8192


@dataclass
class DirectMlSidecar:
    model_path: str = ""
    clock: callable = time.monotonic
    mem_probe: callable = available_mb
    remote_cuda_url: str = ""               # reserved: remote CUDA inference endpoint (disabled)
    session: object | None = None
    last_use: float = 0.0
    loads: int = 0
    unloads: int = 0
    refused: int = 0

    def _providers(self) -> list[str]:
        return ["DmlExecutionProvider", "CPUExecutionProvider"]

    def acquire(self):
        if self.mem_probe() < MEMORY_FLOOR_MB:
            self.refused += 1
            raise MemoryError(f"MemoryFloorMB={MEMORY_FLOOR_MB} breached; sidecar load refused")
        if self.session is None:
            try:
                import onnxruntime as ort  # type: ignore
                self.session = ort.InferenceSession(self.model_path, providers=self._providers()) if self.model_path else object()
            except ImportError:
                self.session = object()     # CPU-less stub: keeps the lifecycle testable without the wheel
            self.loads += 1
        self.last_use = self.clock()
        return self.session

    def reap(self) -> bool:
        if self.session is not None and self.clock() - self.last_use >= IDLE_UNLOAD_S:
            self.session = None; self.unloads += 1
            return True
        return False
