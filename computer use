//! IPC control-plane decoder + action ledger (idempotency / optimistic locks). Mirrors docs/PROTOCOL.md of dscu-driver-v1.
use crate::ahash::hamming_hex;
use std::collections::HashMap;

pub const MAX_LINE: usize = 4 * 1024 * 1024;

#[derive(Debug, PartialEq, Eq, Clone)]
pub enum IpcErr {
    Oversize,
    NotUtf8,
    Parse,
    InvalidRequest(&'static str),
    UnsupportedVersion(i64),
}
impl IpcErr {
    pub fn code(&self) -> i32 {
        match self {
            IpcErr::Oversize | IpcErr::InvalidRequest(_) => -32600,
            IpcErr::NotUtf8 | IpcErr::Parse => -32700,
            IpcErr::UnsupportedVersion(_) => 4001,
        }
    }
    pub fn kind(&self) -> &'static str {
        match self {
            IpcErr::Oversize | IpcErr::InvalidRequest(_) => "INVALID_REQUEST",
            IpcErr::NotUtf8 | IpcErr::Parse => "PARSE_ERROR",
            IpcErr::UnsupportedVersion(_) => "UNSUPPORTED_VERSION",
        }
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Envelope {
    pub id: Option<i64>,
    pub method: String,
    pub action_id: Option<u64>,
    pub expect_hwnd: Option<u64>,
    pub expect_fp: Option<String>,
    pub params: serde_json::Value,
}

/// `^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$`
pub fn valid_method(m: &str) -> bool {
    let mut parts = 0;
    for seg in m.split('.') {
        let mut ch = seg.chars();
        match ch.next() {
            Some(c) if c.is_ascii_lowercase() => {}
            _ => return false,
        }
        if !ch.all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_') {
            return false;
        }
        parts += 1;
    }
    parts >= 2
}

pub fn decode_line(line: &[u8]) -> Result<Envelope, IpcErr> {
    if line.len() > MAX_LINE {
        return Err(IpcErr::Oversize);
    }
    let s = std::str::from_utf8(line).map_err(|_| IpcErr::NotUtf8)?;
    let v: serde_json::Value = serde_json::from_str(s.trim()).map_err(|_| IpcErr::Parse)?;
    let o = v.as_object().ok_or(IpcErr::InvalidRequest("not an object"))?;
    if let Some(ver) = o.get("v") {
        match ver.as_i64() {
            Some(1) => {}
            Some(n) => return Err(IpcErr::UnsupportedVersion(n)),
            None => return Err(IpcErr::InvalidRequest("v not integer")),
        }
    }
    let method = o.get("method").and_then(|m| m.as_str()).ok_or(IpcErr::InvalidRequest("method missing"))?;
    if !valid_method(method) {
        return Err(IpcErr::InvalidRequest("method syntax"));
    }
    let action_id = match o.get("action_id") {
        None | Some(serde_json::Value::Null) => None,
        Some(a) => Some(a.as_u64().ok_or(IpcErr::InvalidRequest("action_id"))?),
    };
    let expect_hwnd = match o.get("expect_hwnd") {
        None | Some(serde_json::Value::Null) => None,
        Some(a) => Some(a.as_u64().ok_or(IpcErr::InvalidRequest("expect_hwnd"))?),
    };
    let expect_fp = match o.get("expect_fp") {
        None | Some(serde_json::Value::Null) => None,
        Some(a) => {
            let t = a.as_str().ok_or(IpcErr::InvalidRequest("expect_fp"))?;
            if t.len() != 16 || !t.chars().all(|c| c.is_ascii_hexdigit()) {
                return Err(IpcErr::InvalidRequest("expect_fp"));
            }
            Some(t.to_ascii_lowercase())
        }
    };
    Ok(Envelope {
        id: o.get("id").and_then(|i| i.as_i64()),
        method: method.to_string(),
        action_id,
        expect_hwnd,
        expect_fp,
        params: o.get("params").cloned().unwrap_or(serde_json::Value::Null),
    })
}

#[derive(Debug, PartialEq, Eq, Clone, Copy)]
pub enum Verdict {
    Ok,
    IdempotentReplay,
    StaleActionId,
    StaleHwnd,
    StaleRegion,
}
impl Verdict {
    pub fn code(&self) -> i32 {
        match self { Verdict::Ok => 0, Verdict::IdempotentReplay => 4090, Verdict::StaleActionId => 4091, Verdict::StaleHwnd => 4092, Verdict::StaleRegion => 4093 }
    }
    /// Drift (not a duplicate) means: re-snapshot the local region, never click blindly.
    pub fn needs_resnapshot(&self) -> bool { matches!(self, Verdict::StaleHwnd | Verdict::StaleRegion) }
}

#[derive(Default)]
pub struct ActionLedger {
    max: u64,
    seen: HashMap<u64, u64>,
}
impl ActionLedger {
    pub fn new() -> Self { Self::default() }
    pub fn max_committed(&self) -> u64 { self.max }
    /// Checks the three contracts; commits `action_id` only when everything passes.
    pub fn check_commit(&mut self, action_id: Option<u64>, req_fp: u64, expect_hwnd: Option<u64>, cur_hwnd: u64, expect_fp: Option<&str>, cur_fp: Option<&str>) -> Verdict {
        if let Some(id) = action_id {
            if id <= self.max {
                return if self.seen.get(&id) == Some(&req_fp) { Verdict::IdempotentReplay } else { Verdict::StaleActionId };
            }
        }
        if let Some(h) = expect_hwnd {
            if h != cur_hwnd { return Verdict::StaleHwnd; }
        }
        if let (Some(e), Some(c)) = (expect_fp, cur_fp) {
            if hamming_hex(e, c) > 10 { return Verdict::StaleRegion; }
        }
        if let Some(id) = action_id {
            self.max = id;
            self.seen.insert(id, req_fp);
            if self.seen.len() > 4096 {
                let floor = self.max.saturating_sub(2048);
                self.seen.retain(|k, _| *k >= floor);
            }
        }
        Verdict::Ok
    }
}
