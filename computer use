@dataclass
class AuthorizedTargetSet:
    """Frozen, immutable-by-convention set of business-object identities that the task is allowed to touch."""

    ids: frozenset[str] = frozenset()
    kind: str = "web_row"  # web_row | gmail_message | file
    expected_state: str = "gone"
    epoch_frozen: int = 0
    source: str = "registry"  # registry | gmail_api | dom
    labels: dict[str, str] = field(default_factory=dict)

