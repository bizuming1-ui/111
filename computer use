#[derive(Debug, Clone)]
pub struct RpcError {
    pub kind: ErrKind,
    pub message: String,
    pub data: Option<Value>,
}

impl RpcError {
    pub fn new(kind: ErrKind, message: impl Into<String>) -> Self {
        RpcError { kind, message: message.into(), data: None }
    }
    pub fn with_data(mut self, data: Value) -> Self {
        self.data = Some(data);
        self
    }
}

#[derive(Debug, Clone)]
pub struct Request {
    pub id: Value,
    pub method: String,
    pub params: Value,
    pub action_id: Option<u64>,
    pub auth: Option<String>,
    pub v: u64,
    pub top: Map<String, Value>,
}

/// `^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$` (identical to Test-IpcEnvelope in the client)
pub fn method_valid(m: &str) -> bool {
    let parts: Vec<&str> = m.split('.').collect();
    if parts.len() < 2 {
        return false;
    }
    parts.iter().all(|p| {
        let mut ch = p.chars();
        match ch.next() {
            Some(c) if c.is_ascii_lowercase() => ch.all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_'),
            _ => false,
        }
    })
}

fn as_uint(v: &Value) -> Option<u64> {
    match v {
        Value::Number(n) => n.as_u64().or_else(|| n.as_f64().filter(|f| *f >= 0.0 && f.fract() == 0.0).map(|f| f as u64)),
        Value::String(s) if !s.is_empty() && s.chars().all(|c| c.is_ascii_digit()) => s.parse().ok(),
        _ => None,
    }
}

/// Parse one NDJSON line. On failure returns the best-known id (for the error response) and the error.
pub fn parse_request(line: &str) -> Result<Request, (Value, RpcError)> {
    if line.len() > MAX_LINE_BYTES {
        return Err((Value::Null, RpcError::new(ErrKind::InvalidRequest, "line too large")));
    }
    let v: Value = serde_json::from_str(line.trim_start_matches('\u{feff}'))
        .map_err(|e| (Value::Null, RpcError::new(ErrKind::ParseError, format!("invalid JSON: {e}"))))?;
    let obj = match v {
        Value::Object(m) => m,
        _ => return Err((Value::Null, RpcError::new(ErrKind::InvalidRequest, "request must be a JSON object"))),
    };
    let id = obj.get("id").cloned().unwrap_or(Value::Null);
    let bad = |m: String| (id.clone(), RpcError::new(ErrKind::InvalidRequest, m));
    match &id {
        Value::Null => {}
        v if as_uint(v).is_some() || v.is_string() => {}
        _ => return Err(bad("id must be uint or string".into())),
    }
    let ver = match obj.get("v") {
        None | Some(Value::Null) => PROTOCOL_VERSION, // legacy dialect 3
        Some(x) => match as_uint(x) {
            Some(n) => n,
            None => return Err(bad("v must be uint".into())),
        },
    };
    if ver != PROTOCOL_VERSION {
        return Err((id.clone(), RpcError::new(ErrKind::UnsupportedVersion, format!("unsupported version '{ver}', server speaks v={PROTOCOL_VERSION}"))));
    }
    let method = match obj.get("method") {
        Some(Value::String(s)) => s.clone(),
        _ => return Err(bad("method missing".into())),
    };
    if !method_valid(&method) {
        return Err((id.clone(), RpcError::new(ErrKind::MethodNotFound, format!("bad method '{method}'"))));
    }
    let action_id = match obj.get("action_id") {
        None | Some(Value::Null) => None,
        Some(x) => match as_uint(x) {
            Some(n) => Some(n),
            None => return Err(bad("action_id must be uint".into())),
        },
    };
    let params = match obj.get("params") {
        None | Some(Value::Null) => Value::Object(Map::new()),
        Some(p @ Value::Object(_)) => p.clone(),
        Some(_) => return Err((id.clone(), RpcError::new(ErrKind::InvalidParams, "params must be an object"))),
    };
    let auth = obj.get("auth").and_then(|a| a.as_str()).map(|s| s.to_string());
    Ok(Request { id, method, params, action_id, auth, v: ver, top: obj })
}

pub fn ok_response(id: &Value, result: Value) -> String {
    json!({ "jsonrpc": "2.0", "v": PROTOCOL_VERSION, "id": id, "result": result }).to_string()
}

pub fn err_response(id: &Value, e: &RpcError) -> String {
    let mut data = match &e.data {
        Some(Value::Object(m)) => m.clone(),
        Some(other) => {
            let mut m = Map::new();
            m.insert("detail".into(), other.clone());
            m
        }
        None => Map::new(),
    };
    data.insert("kind".into(), json!(e.kind.name()));
    json!({
        "jsonrpc": "2.0", "v": PROTOCOL_VERSION, "id": id,
        // The v7.1 client prints "driver error <code>: <message>" -> keep the symbolic name in the message
        "error": { "code": e.kind.code(), "message": format!("{}: {}", e.kind.name(), e.message), "data": Value::Object(data) }
    })
    .to_string()
}

/// Constant-time string comparison (token check).
pub fn ct_eq(a: &str, b: &str) -> bool {
    let (a, b) = (a.as_bytes(), b.as_bytes());
    let mut diff = (a.len() ^ b.len()) as u8;
    for i in 0..a.len().max(b.len()) {
        diff |= a.get(i).copied().unwrap_or(0) ^ b.get(i).copied().unwrap_or(0);
    }
    diff == 0
}

/// Stable 64-bit FNV-1a, hex16 (request fingerprints; not a security primitive).
pub fn fnv_hex(s: &str) -> String {
    let mut h: u64 = 0xcbf29ce484222325;
    for b in s.as_bytes() {
        h ^= *b as u64;
        h = h.wrapping_mul(0x100000001b3);
    }
    format!("{h:016x}")
}

