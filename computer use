# ---------- ① 复合数量配额队列 ----------
function New-V92Quota([string]$Text) {
    $q = Get-TaskQuantities $Text
    $b = @($q.Batches)
    if ($b.Count -eq 0) { return $null }
    return [pscustomobject]@{
        Original = [int[]]$b; Remaining = [System.Collections.Generic.List[int]]::new([int[]]$b); Total = [int]$q.Total
        Done = 0; Pending = $null; Log = [System.Collections.Generic.List[string]]::new()
    }
}
function Get-V92AllowedCounts($Quota) {
    # 允许的「当前勾选数」= 任意未完成的子批次配额 ∪ 相邻剩余批次的前缀和（含剩余总配额）
    $set = [System.Collections.Generic.SortedSet[int]]::new()
    if ($null -ne $Quota) {
        $acc = 0
        foreach ($v in $Quota.Remaining) { [void]$set.Add([int]$v); $acc += [int]$v; [void]$set.Add($acc) }
    }
    return [int[]]@($set)
}
function Format-V92Quota($Quota) {
    if ($null -eq $Quota) { return '' }
    $o = (@($Quota.Original) -join '+'); $r = $(if ($Quota.Remaining.Count -gt 0) { (@($Quota.Remaining) -join '+') } else { '无' })
    return "配额队列 [$o]（总目标 $($Quota.Total)），已确认删除 $($Quota.Done)，剩余 [$r]"
}
function Register-V92QuotaDelete($Quota, [int]$Count, [string]$SelFp) {
    # 乐观登记：本次「删除」放行时先占用对应子批次；下一次联锁检查时按「勾选集合是否变化」确认 / 回滚（见 Resolve-V92QuotaPending）
    if ($null -eq $Quota -or $Count -le 0) { return }
    $before = @($Quota.Remaining)
    $rem = $Quota.Remaining
    $i = $rem.IndexOf([int]$Count)
    if ($i -ge 0) { $rem.RemoveAt($i) }
    else {
        $acc = 0; $k = -1
        for ($j = 0; $j -lt $rem.Count; $j++) { $acc += $rem[$j]; if ($acc -eq $Count) { $k = $j; break } }
        if ($k -ge 0) { $rem.RemoveRange(0, $k + 1) }
        elseif ($Count -ge $acc) { $rem.Clear() }
    }
    $Quota.Pending = [pscustomobject]@{ Count = [int]$Count; Sel = "$SelFp"; Before = $before }
    $Quota.Log.Add("登记 $Count → 剩余 [$((@($rem)) -join '+')]")
}
function Resolve-V92QuotaPending($Quota, [string]$SelFp) {
    # 勾选集合与登记时完全相同 = 上一次「删除」根本没发生（被其他守卫拦截 / 点击落空）→ 回滚配额；集合已变 = 删除已生效 → 提交
    if ($null -eq $Quota -or $null -eq $Quota.Pending) { return 'none' }
    $p = $Quota.Pending; $Quota.Pending = $null
    if ($SelFp -and $SelFp -eq $p.Sel) {
        $Quota.Remaining.Clear(); foreach ($v in $p.Before) { $Quota.Remaining.Add([int]$v) }
        $Quota.Log.Add("回滚 $($p.Count)（勾选集合未变，删除未生效）"); $script:V92.QuotaRollback++
        return 'rollback'
    }
    $Quota.Done += [int]$p.Count; $Quota.Log.Add("确认 $($p.Count)")
    return 'commit'
}
function Get-V92QuotaNote {
    $q = $script:V92.Quota
