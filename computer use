def _kill_tree(pid: int) -> bool:
    import psutil

    try:
        p = psutil.Process(pid)
        for c in p.children(recursive=True):
            try:
                c.kill()
            except psutil.Error:
                pass
        p.kill()
        return True
    except psutil.Error:
