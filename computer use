"""NDJSON transports to the native planes: loopback TCP (TS cdp-daemon) and Windows Named Pipe (Rust dscu-driver)."""
from __future__ import annotations

import asyncio
import json
import os
from typing import Awaitable, Callable, Protocol

DRIVER_PIPE = r"\\.\pipe\dscu-driver-v1"


class Transport(Protocol):
    async def call(self, msg: dict, timeout: float = 10.0) -> dict: ...


class TcpTransport:
    def __init__(self, host: str = "127.0.0.1", port: int = 9333):
        self.host, self.port = host, port
        self._lock = asyncio.Lock()

    async def call(self, msg: dict, timeout: float = 10.0) -> dict:
        async with self._lock:
            try:
                r, w = await asyncio.wait_for(asyncio.open_connection(self.host, self.port), timeout)
                w.write((json.dumps(msg, ensure_ascii=False) + "\n").encode())
                await w.drain()
                line = await asyncio.wait_for(r.readline(), timeout)
                w.close()
                return json.loads(line) if line else {"ok": False, "code": "DRIVER_OFFLINE", "error": "empty reply"}
            except (OSError, asyncio.TimeoutError) as e:
                return {"ok": False, "code": "DRIVER_OFFLINE", "error": str(e)}


class PipeTransport:
    """Blocking byte-mode named pipe wrapped in a worker thread (no pywin32 needed)."""

    def __init__(self, name: str = DRIVER_PIPE):
        self.name = name
        self._f = None
        self._lock = asyncio.Lock()

    def _call_blocking(self, msg: dict) -> dict:
        if self._f is None:
            self._f = open(self.name, "r+b", buffering=0)
        self._f.write((json.dumps(msg, ensure_ascii=False) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = self._f.read(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf) if buf else {"ok": False, "code": "DRIVER_OFFLINE", "error": "eof"}

    async def call(self, msg: dict, timeout: float = 10.0) -> dict:
        if os.name != "nt":
            return {"ok": False, "code": "DRIVER_OFFLINE", "error": "named pipes are Windows-only"}
        async with self._lock:
            try:
                return await asyncio.wait_for(asyncio.to_thread(self._call_blocking, msg), timeout)
            except (OSError, asyncio.TimeoutError, ValueError) as e:
                self._f = None
                return {"ok": False, "code": "DRIVER_OFFLINE", "error": str(e)}


class MockTransport:
    def __init__(self, handler: Callable[[dict], dict | Awaitable[dict]]):
        self.handler, self.calls = handler, []

    async def call(self, msg: dict, timeout: float = 10.0) -> dict:
        self.calls.append(msg)
        r = self.handler(msg)
        return await r if asyncio.iscoroutine(r) else r
