SELF_DRAWN_PROCS = {"weixin.exe", "wechat.exe", "wechatappex.exe", "wxwork.exe", "qq.exe", "qqnt.exe", "dingtalk.exe", "feishu.exe", "lark.exe",
                    "telegram.exe", "discord.exe", "steam.exe", "cloudmusic.exe", "qqmusic.exe", "wps.exe", "wpp.exe", "et.exe"}
ACTION_WORDS = re.compile(r"^(select|star|archive|delete|more|checkbox|选择|星标|归档|删除|更多|标记|snooze|mark)", re.I)
CLICKS = ("click", "double_click", "right_click")


def h64(s: str) -> str:
    return hashlib.blake2b(s.encode("utf-8", "ignore"), digest_size=8).hexdigest()


def sha256_file(path: str | Path, limit: int = 256 * 1024 * 1024) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        n = 0
        while True:
            b = f.read(1 << 20)
            if not b:
                break
            h.update(b)
            n += len(b)
            if n > limit:
                break
    return h.hexdigest()


def _extra(e: Element, name: str) -> str:
    ex = getattr(e, "model_extra", None) or {}
    v = ex.get(name)
    return str(v) if v not in (None, "") else ""


# ================================================================================ stable object identity
# ---- v17.1: row identity must NOT depend on transient UI state words.
# v17.0 log task #14: the row accessible name is "未講， Sender , Subject" before ticking and "已經揀選， 未讀， Sender , Subject" after ticking -> a different
# signature -> a different stable_id -> "[OBJECT_IDENTITY_MISMATCH] 已勾选行中有 5 个不在授权目标集".  Identity is now computed from state-stripped text.
_STATE_WORDS = (r"已經揀選|已选择|已選取|已選擇|已勾选|已勾選|已被選取|未讀|未读|已讀|已读|已加星號|已加星标|已加星|未加星號|未加星标|加星號|加星标|已標示為重要|已标记为重要|標示為重要|标记为重要|不重要|重要|"
                r"selected|unselected|unread|read|starred|not starred|important|not important|muted|snoozed|checked|unchecked|"
                r"選取|选取|选中|選擇|已存檔|已归档|已封存")
_STATE_PREFIX_RX = re.compile(rf"^\s*(?:(?:{_STATE_WORDS})\s*[，,、:：;；]\s*)+", re.I)
_STATE_ONLY_RX = re.compile(rf"^\s*(?:(?:{_STATE_WORDS})\s*[，,、:：;；]?\s*)+$", re.I)


def norm_row_text(s: str) -> str:
    """Strip leading state words (selected / unread / starred / important in zh-TW, zh-CN, en) and collapse whitespace. '' => the part was pure state."""
    s = " ".join((s or "").split())
    if _STATE_ONLY_RX.match(s):
        return ""
    prev = None
    while prev != s:
        prev = s
        s = _STATE_PREFIX_RX.sub("", s).strip()
    return s


@dataclass
class StableObject:
    stable_id: str
    kind: str  # web_row | file | uia | generic
    label: str
    original_state: str = "present"
    current_state: str = "present"
    expected_state: Optional[str] = None
    is_target: bool = False
    locator: dict[str, Any] = field(default_factory=dict)
    first_step: int = 0
    last_seen_step: int = 0
    history: list[str] = field(default_factory=list)

    def set_state(self, state: str, step: int) -> None:
        if state != self.current_state:
            self.history.append(f"s{step}:{self.current_state}->{state}")
            self.current_state = state

    @property
    def satisfied(self) -> bool:
        return self.expected_state is None or self.current_state == self.expected_state


@dataclass
class Preflight:
    ok: bool
    reason: str = ""
    stable_id: str = ""
    drifted: bool = False
