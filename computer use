class CheckpointStore:
    def __init__(self, root: str | Path):
        self.root = Path(root)
        self.root.mkdir(parents=True, exist_ok=True)

    def save(self, task_id: str, state: dict | TaskCheckpointState) -> Path:
        payload = state.to_dict() if isinstance(state, TaskCheckpointState) else state
        p = self.root / f"ckpt-{task_id}.json"
        fd, tmp = tempfile.mkstemp(dir=self.root)
        os.close(fd)
        Path(tmp).write_text(json.dumps(payload, ensure_ascii=False, indent=2), "utf-8")
        os.replace(tmp, p)
        return p

    def load(self, task_id: str) -> dict | None:
        p = self.root / f"ckpt-{task_id}.json"
        return json.loads(p.read_text("utf-8")) if p.exists() else None

    def resume_or_rollback(self, task_id: str) -> dict[str, Any] | None:
        loaded = self.load(task_id)
        if not loaded:
            return None
        loaded["resumed"] = True
        loaded["local_rollback_sequence"] = ["esc", "ctrl+z"]
        return loaded

