    # ------------------------------------------------------------------ peer contract
    def _browser_pids(self) -> list[int]:
        """v16.1 PID scope: the attached browser's process tree ONLY (v16.0 returned every chrome.exe + msedge.exe -> an unattached Edge in the foreground skipped UIA)."""
        ts, cached = self._pid_cache
        if time.time() - ts < 1.5:
            return cached
        pids: list[int] = []
        pid = self.attached_browser_pid
        if pid and pid_alive(pid):
            pids = process_tree_pids(pid)
        else:
            if self.mode in (CLEAN_MODE, "browser-url", "ws", "autoconnect") and (self.debug_port or self.mode == CLEAN_MODE):
                np_ = find_browser_pid_by_port(self.debug_port or DEFAULT_PORT)  # the browser was relaunched -> new pid
                if np_:
                    self.attached_browser_pid, pids, self.scope_mode = np_, process_tree_pids(np_), "pid-tree"
            if not pids and self.attached_browser_exe:
                pids, self.scope_mode = pids_by_exe(self.attached_browser_exe), "exe"
        self._pid_cache = (time.time(), pids)
        return pids

    def scope_info(self) -> dict[str, Any]:
        pids = self._browser_pids()
        return {"attached_browser_pid": self.attached_browser_pid, "attached_browser_exe": self.attached_browser_exe, "scope_mode": self.scope_mode, "browser_pids": pids}

    def is_attached_pid(self, pid: int) -> bool:
        return int(pid or 0) in set(self._browser_pids())

    def _rss_mb(self) -> float:
        try:
            import psutil

            tot = 0.0
            if self.client and self.client.proc and self.client.proc.pid:
                pr = psutil.Process(self.client.proc.pid)
                tot += pr.memory_info().rss
                for c in pr.children(recursive=True):
                    tot += c.memory_info().rss
            return round(tot / 1048576, 1)
        except Exception:  # noqa: BLE001
            return 0.0

    async def hello(self, **_: Any) -> dict[str, Any]:
        return {"type": "hello_ack", "ok": True, "peer": "chrome-devtools-mcp", "version": VERSION, "caps": ["take_snapshot_uid", "network_diag", "console_diag", "supervisor", "multi_page", "upload_file", "drag", "pid_scope"],
                "browser": f"chrome-devtools-mcp({self.mode})", "profile_mode": self.mode, "requested_mode": self.requested_mode,
                "profile_dir": (self.launcher.profile if self.launcher else self._profile_dir()), "debug_port": self.debug_port, "clean_error": self.clean_error,
                "webdriver": self.stealth.get("webdriver"), "stealth": self.stealth, **self.scope_info(), "rss_mb": self._rss_mb(),
                "server": (self.client.server_info if self.client else {}), "tools": len(self.client.tools) if self.client else 0, "privacy_flags": FORCED_FLAGS}

    async def status(self) -> dict[str, Any]:
        return {"type": "status", "ok": True, "reconnects": self.restarts, "crashes": self.crashes, "epoch": self.epoch, "browser": f"chrome-devtools-mcp({self.mode})",
                **self.scope_info(), "tabs": len(self.pages), "active_target": str(self.page_id), "last_diag": self.last_diag, "stats": dict(self.stats),
                "mode": self.mode, "requested_mode": self.requested_mode, "webdriver": self.stealth.get("webdriver"), "last_restart_reason": self.last_restart_reason, "clean_error": self.clean_error}

    async def heal(self, reason: str, force: bool = False) -> dict[str, Any]:
        t0 = time.perf_counter()
        if not force and not self.lost:
            try:
                await self.refresh_pages()
                await self._tool("take_snapshot", 25)  # a healthy round-trip proves the page session is alive
                return {"type": "heal_result", "ok": True, "healed": False, "epoch": self.epoch, "browser_pids": self._browser_pids()}
            except McpError:
                if await self.soft_heal(reason or "heal"):
                    return {"type": "heal_result", "ok": True, "healed": True, "level": "soft", "epoch": self.epoch, **self.scope_info()}
        info = await self.restart(reason or "heal", force)
        return {"type": "heal_result", "ok": True, **info, "epoch": self.epoch, "browser_pids": self._browser_pids(), "ms": int((time.perf_counter() - t0) * 1000)}

    async def call(self, obj: dict[str, Any], timeout: float = 30.0) -> dict[str, Any]:
        """NdjsonClient-compatible entry point used by DriverHub."""
        from .ipc_client import IpcError

        t = str(obj.get("type", ""))
        try:
            if t == "hello":
                out = await asyncio.wait_for(self.hello(), timeout)
            elif t == "status":
                out = await self.status()
            elif t == "heal":
                out = await asyncio.wait_for(self.heal(str(obj.get("reason", "")), bool(obj.get("force"))), max(timeout, 90))
            elif t == "observe":
                out = await asyncio.wait_for(self.observe(obj), timeout)
            elif t == "action":
                out = await asyncio.wait_for(self.action(obj), timeout)
            elif t == "shutdown":
                await self.aclose()
                out = {"type": "bye", "ok": True}
            else:
                out = {"type": "error", "ok": False, "code": "UNSUPPORTED", "message": f"unknown type {t}"}
        except asyncio.TimeoutError:
            raise IpcError(f"chrome-devtools-mcp: no reply to {t}/{obj.get('action')} within {timeout}s")
        except McpTransportError as e:
            raise IpcError(f"chrome-devtools-mcp: connection lost ({e})")
        except McpError as e:
            out = {"type": "error", "ok": False, "code": "INTERNAL", "message": str(e)[:500]}
        out.setdefault("id", obj.get("id"))
        return out

    def close(self) -> None:  # sync, like NdjsonClient.close() (DriverHub calls it after the shutdown message)
        if self.client and self.client.proc and self.client.proc.returncode is None:
            try:
                self.client.proc.kill()
            except Exception:  # noqa: BLE001
                pass
