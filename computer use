function Initialize-Runtime {
    if ($null -eq $script:Pool) {
        $script:Pool = [runspacefactory]::CreateRunspacePool(1, 4)
        $script:Pool.Open()
    }
    if (-not $NoOverlay -and $null -eq $script:Cur) {
        try {
            $o = [DsOverlay]::new()
            $p = [DsNative4]::CursorPos()
            if ($o.Start([DsNative4]::DpiScale(), $p[0], $p[1])) { $script:Cur = $o }
            else { Write-Host "  虚拟鼠标启动失败（动作仍可执行，只是没有可视光标）: $($o.Error)" -ForegroundColor DarkYellow }
        }
        catch { Write-Host "  虚拟鼠标启动失败: $($_.Exception.Message)" -ForegroundColor DarkYellow }
    }
}
function Stop-Runtime {
    try { if ($script:Cur) { $script:Cur.Stop(); $script:Cur = $null } } catch { }
    try { if ($script:Pool) { $script:Pool.Close(); $script:Pool.Dispose(); $script:Pool = $null } } catch { }
}
function Move-VirtualCursor([int]$x, [int]$y) {
    $c = $script:Cur
    if ($null -eq $c) { return }
    $dx = $x - $c.X; $dy = $y - $c.Y
    $d = [Math]::Sqrt($dx * $dx + $dy * $dy)
    # Fitts 定律形态：时间随距离对数增长
    $ms = if ($d -lt 2) { 0 } else { [int]([Math]::Min(700.0, [Math]::Max(150.0, 110.0 + 120.0 * [Math]::Log2(1.0 + $d / 50.0))) / $CursorSpeed) }
    $c.MoveTo([double]$x, [double]$y, $ms)
    while (-not $c.WaitIdle(40)) { Test-Abort }
}
function Set-CursorPulse([int]$kind) { if ($script:Cur) { $script:Cur.Pulse($kind) } }
function Invoke-Worker([scriptblock]$Script, $Arg, [int]$TimeoutMs) {
    # 在预热的运行空间池里执行可能阻塞的 UIA 调用（例如会弹模态框的 Invoke）；超时返回 $false，不卡住主流程
    $ps = [powershell]::Create()
    $ps.RunspacePool = $script:Pool
    [void]$ps.AddScript('param($f, $x) $ErrorActionPreference = "Stop"; & ([scriptblock]::Create($f)) $x').AddArgument($Script.ToString()).AddArgument($Arg)
    $ar = $ps.BeginInvoke()
    if ($ar.AsyncWaitHandle.WaitOne($TimeoutMs)) {
        try { [void]$ps.EndInvoke($ar) } finally { $ps.Dispose() }
        return $true
    }
    return $false
}
