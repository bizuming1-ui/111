"""Cross-language transport: newline-delimited JSON over TCP loopback (cdp-daemon) / Windows Named Pipe (dscu-driver)."""
from __future__ import annotations
import asyncio
import json
import sys


async def request(endpoint: str, msg: dict, timeout: float = 5.0) -> dict:
    """endpoint: 'tcp://127.0.0.1:9333' or r'\\\\.\\pipe\\dscu-driver-v1'."""
    if endpoint.startswith("tcp://"):
        host, port = endpoint[6:].split(":")
        r, w = await asyncio.wait_for(asyncio.open_connection(host, int(port)), timeout)
    elif sys.platform == "win32":
