//! UIA collection (Windows) feeding snapshot::build.  Headless-first: ElementFromHandle(hwnd) — never SetForegroundWindow, never SendInput.
use crate::snapshot::RawNode;

#[cfg(windows)]
pub fn collect_foreground(max: usize) -> Result<Vec<RawNode>, String> {
    use windows::Win32::System::Com::*;
    use windows::Win32::UI::Accessibility::*;
    use windows::Win32::UI::WindowsAndMessaging::GetForegroundWindow;
    unsafe {
        let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
        let uia: IUIAutomation = CoCreateInstance(&CUIAutomation, None, CLSCTX_INPROC_SERVER).map_err(|e| e.to_string())?;
        let root = uia.ElementFromHandle(GetForegroundWindow()).map_err(|e| e.to_string())?;
        let cond = uia.CreateTrueCondition().map_err(|e| e.to_string())?;
        let arr = root.FindAll(TreeScope_Subtree, &cond).map_err(|e| e.to_string())?;
        let n = arr.Length().map_err(|e| e.to_string())?.max(0) as usize;
        let mut out = Vec::with_capacity(n.min(max));
        for i in 0..n.min(max) {
            let e = arr.GetElement(i as i32).map_err(|e| e.to_string())?;
            let r = e.CurrentBoundingRectangle().map_err(|e| e.to_string())?;
            let ct = e.CurrentControlType().map_err(|e| e.to_string())?.0;
            let (role, interactive) = match ct { 50000 => ("Button", true), 50002 => ("CheckBox", true), 50004 => ("Edit", true), 50005 => ("Hyperlink", true), 50007 => ("ListItem", false),
                50008 => ("List", false), 50011 => ("MenuItem", true), 50013 => ("RadioButton", true), 50018 => ("Tab", false), 50019 => ("TabItem", true), 50021 => ("ToolBar", false),
                50032 => ("Window", false), 50026 => ("Group", false), 50033 => ("Pane", false), _ => ("Other", false) };
            let name = e.CurrentName().map(|b| b.to_string()).unwrap_or_default();
            out.push(RawNode { role: role.into(), name, l: r.left, t: r.top, w: r.right - r.left, h: r.bottom - r.top, interactive });
        }
        Ok(out)
    }
}
#[cfg(not(windows))]
pub fn collect_foreground(_max: usize) -> Result<Vec<RawNode>, String> {
    Ok(vec![RawNode { role: "Window".into(), name: "synthetic".into(), l: 0, t: 0, w: 1920, h: 1200, interactive: false },
            RawNode { role: "Button".into(), name: "Delete".into(), l: 10, t: 10, w: 30, h: 30, interactive: true }])
}

/// Java Access Bridge probe (WindowsAccessBridge-64.dll) — dynamic load, never a hard dependency.
pub fn probe_jab() -> serde_json::Value {
    #[cfg(windows)]
    unsafe {
        use windows::core::{s, w};
        use windows::Win32::System::LibraryLoader::{GetProcAddress, LoadLibraryW};
        match LoadLibraryW(w!("WindowsAccessBridge-64.dll")) {
            Ok(h) => return serde_json::json!({"present": true, "initializeAccessBridge": GetProcAddress(h, s!("initializeAccessBridge")).is_some()}),
            Err(_) => return serde_json::json!({"present": false}),
        }
    }
    #[cfg(not(windows))]
    serde_json::json!({"present": false, "note": "windows-only"})
}
