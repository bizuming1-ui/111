/* dscu_shm.h — Win32 shared-memory frame ring (v12). Single writer (dscu-driver / vision-engine), N readers, tear-free via seqlock.
 * Mapping name: Local\dscu-v12-ring   (CreateFileMappingW + MapViewOfFile).  Byte layout is identical in Rust (shm.rs) and C++.
 *
 *  offset  size  header (64 B)                 slot i @ 64 + i*(64+slot_bytes):  slot header (64 B) then pixels (BGRA8, stride bytes/row)
 *  0       8     magic "DSV12RNG"              0   8  seq        seqlock counter: odd = writer inside, even = stable
 *  8       4     version (=1)                  8   8  frame_no   monotonically increasing
 *  12      4     slots                         16  4  w
 *  16      8     slot_bytes                    20  4  h
 *  24      8     write_seq (atomic, last n)    24  4  stride
 *  32      32    reserved                      28  4  fmt        0 = BGRA8, 1 = GRAY8
 *                                              32  8  ahash      64-bit aHash of the frame (computed on GPU / AVX2)
 *                                              40  16 dirty      int32 x0,y0,x1,y1 union dirty rect (x1<=x0 => none)
 *                                              56  8  reserved
 * Reader: s1=seq(acquire); if(s1&1) retry; copy; fence(acquire); s2=seq; accept iff s1==s2.
 */
#pragma once
#include <stdint.h>
#ifdef __cplusplus
extern "C" {
#endif
#define DSCU_SHM_MAGIC "DSV12RNG"
#define DSCU_SHM_HDR 64u
#define DSCU_SHM_SHDR 64u
typedef struct DscuShmHeader { char magic[8]; uint32_t version; uint32_t slots; uint64_t slot_bytes; volatile uint64_t write_seq; uint8_t reserved[32]; } DscuShmHeader;
typedef struct DscuSlotHeader { volatile uint64_t seq; uint64_t frame_no; uint32_t w, h, stride, fmt; uint64_t ahash; int32_t dirty[4]; uint8_t reserved[8]; } DscuSlotHeader;
