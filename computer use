    if name == "wait_for":
        txt = " ".join(map(str, a.get("text") or []))
        if txt and (txt in snapshot_text(p) or txt in p["url"]):
            return ok("Element matching one of " + txt + " found.")
        return err("Timed out after " + str(a.get("timeout")) + "ms waiting for text")
    if name == "list_network_requests":
        if "broken" in p["url"]:
            return ok("## Network requests\nreqid=1 GET " + p["url"] + " [404]\nreqid=2 GET http://x/app.js [500]\nreqid=3 GET http://x/ok.css [200]")
        return ok("## Network requests\nreqid=1 GET " + p["url"] + " [200]")
    if name == "list_console_messages":
        if "broken" in p["url"]:
