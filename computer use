"""Optional local UI-element detector on the AMD Radeon 780M iGPU via onnxruntime-directml.

Design constraints (honest by construction):
  * OPTIONAL: pip install onnxruntime-directml  +  an ONNX detector at %DSCU_DML_MODEL% (or <root>/models/ui_detector.onnx).  No model -> status
    "model_missing"; this module NEVER fabricates detections.
  * MemoryFloorMB = 4096: the model is only loaded while >= 4096 MB of physical RAM is still free (the 780M shares system RAM).
  * Idle unload after 180 s: session + buffers are released so the resident footprint of the agent stays < 260 MB.
  * Works without Rust/MSVC: pure Python + numpy, called from the py-native path.
"""
from __future__ import annotations

import os
import threading
import time
from pathlib import Path
from typing import Any, Optional

MEMORY_FLOOR_MB = 4096
IDLE_UNLOAD_S = 180.0


def _root() -> Path:
    return Path(os.environ.get("DSCU_ROOT") or Path(__file__).resolve().parents[1])


def _free_mb() -> float:
    try:
        import psutil

        return psutil.virtual_memory().available / 1048576
    except Exception:
        return 0.0


def _nms(boxes: Any, scores: Any, thr: float = 0.5) -> list[int]:
    import numpy as np

    x1, y1, x2, y2 = boxes[:, 0], boxes[:, 1], boxes[:, 2], boxes[:, 3]
    areas = (x2 - x1).clip(0) * (y2 - y1).clip(0)
    order = scores.argsort()[::-1]
    keep: list[int] = []
    while order.size:
        i = int(order[0])
        keep.append(i)
        xx1, yy1 = np.maximum(x1[i], x1[order[1:]]), np.maximum(y1[i], y1[order[1:]])
        xx2, yy2 = np.minimum(x2[i], x2[order[1:]]), np.minimum(y2[i], y2[order[1:]])
        inter = (xx2 - xx1).clip(0) * (yy2 - yy1).clip(0)
        iou = inter / (areas[i] + areas[order[1:]] - inter + 1e-9)
        order = order[1:][iou <= thr]
    return keep


class DmlDetector:
    def __init__(self, model: Optional[Path] = None) -> None:
        self.model_path = Path(model or os.environ.get("DSCU_DML_MODEL") or _root() / "models" / "ui_detector.onnx")
        self.sess: Any = None
        self.provider = ""
        self.last_use = 0.0
        self.lock = threading.Lock()
        self.timer: Optional[threading.Timer] = None
        self.reason = ""

    # ------------------------------------------------------------------ lifecycle
    def status(self) -> dict[str, Any]:
        d: dict[str, Any] = {"memory_floor_mb": MEMORY_FLOOR_MB, "idle_unload_s": IDLE_UNLOAD_S, "free_mb": round(_free_mb()), "model": str(self.model_path),
                             "model_exists": self.model_path.exists(), "loaded": self.sess is not None, "provider": self.provider, "reason": self.reason}
        try:
            import onnxruntime as ort

            d["ort_version"] = ort.__version__
            d["providers"] = ort.get_available_providers()
            d["directml"] = "DmlExecutionProvider" in d["providers"]
        except Exception as e:  # noqa: BLE001
            d["ort_version"], d["providers"], d["directml"] = None, [], False
            d["reason"] = d["reason"] or f"onnxruntime not installed ({e.__class__.__name__}); pip install onnxruntime-directml"
        if not d["model_exists"] and not d["reason"]:
            d["reason"] = "model_missing"
        return d

    def load(self) -> bool:
        with self.lock:
            if self.sess is not None:
                self.last_use = time.time()
                return True
            if not self.model_path.exists():
                self.reason = f"model_missing: {self.model_path}"
                return False
            if _free_mb() < MEMORY_FLOOR_MB:
                self.reason = f"memory_floor: free {_free_mb():.0f} MB < {MEMORY_FLOOR_MB} MB"
                return False
            try:
                import onnxruntime as ort

                prov = [p for p in ("DmlExecutionProvider", "CPUExecutionProvider") if p in ort.get_available_providers()]
                so = ort.SessionOptions()
                so.enable_mem_pattern = False  # DirectML requirement
                so.execution_mode = ort.ExecutionMode.ORT_SEQUENTIAL
                self.sess = ort.InferenceSession(str(self.model_path), sess_options=so, providers=prov)
                self.provider = self.sess.get_providers()[0]
                self.reason = ""
            except Exception as e:  # noqa: BLE001
                self.reason = f"load_failed: {e}"
                self.sess = None
                return False
            self.last_use = time.time()
            self._arm_timer()
            return True

    def _arm_timer(self) -> None:
        if self.timer:
            self.timer.cancel()
        self.timer = threading.Timer(IDLE_UNLOAD_S + 1, self._idle_check)
        self.timer.daemon = True
        self.timer.start()

    def _idle_check(self) -> None:
        if self.sess is not None and time.time() - self.last_use >= IDLE_UNLOAD_S:
            self.unload("idle>180s")
        elif self.sess is not None:
            self._arm_timer()

    def unload(self, why: str = "manual") -> None:
        with self.lock:
            self.sess = None
            self.reason = f"unloaded: {why}"
        import gc

        gc.collect()

    # ------------------------------------------------------------------ inference
    def detect(self, image: Any, conf: float = 0.35, iou: float = 0.5) -> list[dict[str, Any]]:
        """image: PIL.Image or HxWx3 uint8 RGB ndarray -> [{'box':[x,y,w,h], 'score':f, 'cls':int}] in source-image pixels. [] + reason when unavailable."""
        import numpy as np

        if not self.load():
            return []
        arr = np.asarray(image.convert("RGB") if hasattr(image, "convert") else image)
        H, W = arr.shape[:2]
        inp = self.sess.get_inputs()[0]
        shp = [d if isinstance(d, int) and d > 0 else 640 for d in inp.shape[2:4]] or [640, 640]
        sh, sw = shp[0], shp[1]
        from PIL import Image

        im = Image.fromarray(arr).resize((sw, sh))
        x = (np.asarray(im, dtype=np.float32) / 255.0).transpose(2, 0, 1)[None]
        t0 = time.perf_counter()
        out = self.sess.run(None, {inp.name: x})[0]
        self.last_use = time.time()
        p = out[0]
        if p.shape[0] < p.shape[1]:  # [4+nc, N] -> [N, 4+nc]
            p = p.T
        scores_all = p[:, 4:]
        cls = scores_all.argmax(1)
        sc = scores_all.max(1)
        m = sc >= conf
        p, cls, sc = p[m], cls[m], sc[m]
        if not len(p):
            return []
        cx, cy, w, h = p[:, 0], p[:, 1], p[:, 2], p[:, 3]
        boxes = np.stack([cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2], 1)
        keep = _nms(boxes, sc, iou)
        kx, ky = W / sw, H / sh
        res = [{"box": [int(boxes[i, 0] * kx), int(boxes[i, 1] * ky), int((boxes[i, 2] - boxes[i, 0]) * kx), int((boxes[i, 3] - boxes[i, 1]) * ky)], "score": float(sc[i]), "cls": int(cls[i])} for i in keep[:100]]
        self.infer_ms = (time.perf_counter() - t0) * 1000
        return res


_default: Optional[DmlDetector] = None


def get() -> DmlDetector:
    global _default
    if _default is None:
        _default = DmlDetector()
    return _default


def status_text() -> str:
    s = get().status()
    return ("  DML 视觉侧车：" + ("✅ DirectML 可用" if s["directml"] else "⚠ DirectML 不可用") + f" · 模型{'存在' if s['model_exists'] else '缺失'}（{s['model']}） · 已加载={s['loaded']} · provider={s['provider'] or '-'}\n"
            f"  内存地板 {s['memory_floor_mb']} MB（当前空闲 {s['free_mb']} MB） · 空闲 {s['idle_unload_s']:.0f}s 自动卸载 · 原因：{s['reason'] or 'ok'}\n"
            "  启用：pip install onnxruntime-directml ，并把 ONNX 检测模型放到 models/ui_detector.onnx（或设置 DSCU_DML_MODEL）。无模型时系统完整运行，不会伪造检测结果。")


if __name__ == "__main__":
    print(status_text())
