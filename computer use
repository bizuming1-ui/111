def mail_elements(rows: list[tuple[str, str, str]], checked: set[int] = frozenset()) -> list[Element]:
    out: list[Element] = []
    for i, (snd, sub, ts) in enumerate(rows, 1):
        base = {"rect": [10, 40 * i, 300, 30], "zone": "Row", "row": i}
        out.append(Element(ref_id=f"@1:c{i}a", role="checkbox", name="", stable_key=f"cb{i}", states=["checked"] if i in checked else [], **base))
        out.append(Element(ref_id=f"@1:c{i}b", role="link", name=f"{snd} {sub} {ts}", stable_key=f"lk{i}", **base))
    return out


