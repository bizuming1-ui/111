"""Brain.run_task end-to-end on Linux/CI: REAL TS cdp-daemon + REAL headless Chrome + the REAL orchestrator loop.
Only two things are scripted, and both are declared here (not in the orchestrator): the Windows-only Rust driver is replaced
by a stub that reports a chrome.exe foreground window, and the LLM replies from a script (the production DeepSeek client,
prompt layout and JSON parser are still exercised). Verifies the ledger / quota interlock / quota-zero convergence on a
Gmail-shaped page: "删除前面5个和后面2个邮件" -> exactly 7 rows removed, never 8."""
from __future__ import annotations

import asyncio
import functools
import http.server
import json
import os
import sys
import threading
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from agent_brain.deepseek_client import DeepSeekClient, Reply  # noqa: E402
from agent_brain.orchestrator import Brain  # noqa: E402
from agent_brain.protocol import ActionResult, parse_observation  # noqa: E402
from agent_brain.supervisor import Config  # noqa: E402

PORT_HTTP, PORT_IPC, PORT_CDP = 47960, 47961, 9361


class StubDriver:
    connected = True

    def __init__(self) -> None:
        self.latencies: dict = {}

    async def call(self, kind, req=None, timeout=30):
        return {"name": "stub-driver(linux-ci)", "capture_backend": "GDI", "fallback_reason": "STUB"} if kind == "info" else {"pong": True}

    async def observe(self, req=None, timeout=30):
        return parse_observation({"v": 1, "source": "dscu-driver", "channel": "dxgi_vision", "snapshot_epoch": 1, "ts_ms": int(time.time() * 1000), "hwnd": 4242, "title": "Fixture Inbox - Google Chrome",
                                  "process": "chrome.exe", "elements": [], "mem_free_mb": 8000, "dxgi_stats": {"capture_backend": "GDI", "fallback_reason": "STUB", "frame_ms": 1.0, "dirty_rects_count": 0}, "screen_ahash": "0123456789abcdef"})

    async def act(self, a, timeout=45):
        return ActionResult(action_id=a.action_id, ok=True)

    def stats(self):
        return {}

    async def close(self):
        return None


SCRIPT = [
    {"thought": "进入收件箱", "step": 1, "expect": "出现邮件行", "action": "cdp_navigate", "url": f"http://127.0.0.1:{PORT_HTTP}/inbox.html"},
    {"thought": "先勾选前5封", "step": 2, "expect": "R1-R5勾选", "action": "select_rows", "rows": "1-5"},
    {"thought": "删除", "step": 3, "expect": "删除5封", "action": "toolbar_action", "label": "delete"},
    {"thought": "再选末尾2封", "step": 4, "expect": "R末尾2行勾选", "action": "select_rows", "rows": "last:2"},
    {"thought": "尝试多删(应被联锁拦截不会发生)", "step": 5, "expect": "", "action": "select_rows", "rows": "1-5"},
    {"thought": "删除末尾2封", "step": 6, "expect": "删除2封", "action": "select_rows", "rows": "last:2"},
    {"thought": "点删除", "step": 7, "expect": "删除2封", "action": "toolbar_action", "label": "delete"},
    {"thought": "不应被调用", "step": 8, "expect": "", "action": "done", "summary": "should not be reached because the ledger converges first"},
]


class ScriptedLLM(DeepSeekClient):
    def __init__(self) -> None:
        super().__init__("test-key")
        self.i = 0
        self.prompts: list[str] = []

    async def chat(self, messages, vision=False, json_mode=True, max_tokens=None, timeout=60.0):
        self.prompts.append(json.dumps(messages, ensure_ascii=False))
        d = SCRIPT[min(self.i, len(SCRIPT) - 1)]
        self.i += 1
        u = {"prompt_tokens": 5000, "prompt_cache_hit_tokens": 3500, "prompt_cache_miss_tokens": 1500, "completion_tokens": 40}
        self.usage.add(u, 1.0)
        return Reply(json.dumps(d, ensure_ascii=False), u, 1.0, "scripted-deepseek-chat")


async def main() -> int:
    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(ROOT / "tests" / "fixtures"))
    httpd = http.server.ThreadingHTTPServer(("127.0.0.1", PORT_HTTP), handler)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    os.environ["DSCU_CDP_PORT"] = str(PORT_CDP)
    cfg = Config(cdp_addr=f"tcp://127.0.0.1:{PORT_IPC}", cdp_port=PORT_CDP)
    brain = Brain(None, cfg=cfg, interactive=False, approved_hosts=("127.0.0.1",))

    async def fake_driver():
        return StubDriver()

    brain.sup.start_driver = fake_driver  # type: ignore[method-assign]
    brain.llm = ScriptedLLM()
    await brain.start()
    # make the stub look like a browser-foreground so the CDP channel is used (real measurement path)
    r = await brain.run_task("打开 gmail，删除前面5个和后面2个邮件", max_steps=12)
    obs = await brain.cdp.observe({"want": {"settle": True}})  # type: ignore[union-attr]
    left = len([e for e in obs.elements if e.role == "checkbox"])
    stable_prefix = len({p.split('"role": "user"')[1][:400] for p in brain.llm.prompts[:3]})  # type: ignore[union-attr]
    ok = r.ok and left == 5 and brain.llm.i <= 8  # type: ignore[union-attr]
    print(f"\nRESULT ok={r.ok} summary={r.summary!r} rows_left={left} (expected 5) llm_calls={brain.llm.i}")  # type: ignore[union-attr]
    print("PASS" if ok else "FAIL")
    sys.stdout.flush()
    await brain.stop()
    os._exit(0 if ok else 1)


if __name__ == "__main__":
    asyncio.run(main())
