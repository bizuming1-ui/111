                L = [int]$L; T = [int]$T; W = [int][Math]::Max(2.0, $W); H = [int][Math]::Max(2.0, $H); cx = [int]($L + $W / 2.0); cy = [int]($T + $H / 2.0)
                Tag = $(if ($z.Zone -eq 'Toolbar') { '[Zone: Toolbar]' } else { "[Zone: Row[$($z.Row)]]" })
                CssX = [double]$b.box.l + [double]$b.box.w / 2.0; CssY = [double]$b.box.t + [double]$b.box.h / 2.0
            })
    }
    return @($list.ToArray())
}
function Update-V10ZoneMap($Origin) {
    $raw = $null
    try { $raw = Invoke-V10ZoneCollect } catch { if ("$($_.Exception.Message)" -like '触发保护*') { throw }; $raw = $null }
    if ($null -eq $raw) { $script:V10.ZoneMap = @(); return }
    $script:V10.ZoneMap = @(ConvertTo-V10ZoneMap $raw $Origin)
    $script:V10.ViewH = [double]$raw.vh * $(if ($Origin) { [double]$Origin.Scale } else { 1.0 })
    $script:V10.Cdp = $true
}
$script:V10Orig_GetV92CdpRowModel = ${function:Get-V92CdpRowModel}
function Get-V92CdpRowModel($CdpObs) {
    $m = & $script:V10Orig_GetV92CdpRowModel $CdpObs
    if ($null -ne $m -and $null -ne $CdpObs) { try { Update-V10ZoneMap $CdpObs.Origin } catch { if ("$($_.Exception.Message)" -like '触发保护*') { throw } } }
    return $m
}
function Get-V10ItemZone($t) {
    if ($null -eq $t -or @($script:V10.ZoneMap).Count -eq 0) { return $null }
    $cx = [double]$t.L + [double]$t.W / 2.0; $cy = [double]$t.T + [double]$t.H / 2.0
    $best = $null; $bd = 1e9
    foreach ($z in @($script:V10.ZoneMap)) {
        $d = [Math]::Abs($z.cx - $cx) + [Math]::Abs($z.cy - $cy)
        if ($d -lt $bd -and $d -le [Math]::Max(10.0, [Math]::Min([double]$z.W, [double]$z.H) * 0.6)) { $bd = $d; $best = $z }
    }
    return $best
}
function Find-V10ZoneAtPoint([int]$x, [int]$y) {
    $best = $null; $ba = 1e12
    foreach ($z in @($script:V10.ZoneMap)) {
        if ($x -ge ($z.L - 4) -and $x -le ($z.L + $z.W + 4) -and $y -ge ($z.T - 4) -and $y -le ($z.T + $z.H + 4)) { $a = [double]$z.W * [double]$z.H; if ($a -lt $ba) { $ba = $a; $best = $z } }
    }
    return $best
}
function Find-V10ToolbarTwin([string]$name) {
    $n = "$name".Trim()
    $c = @($script:V10.ZoneMap | Where-Object { $_.Zone -eq 'Toolbar' -and $_.Visible -and $_.Name -eq $n } | Sort-Object { [int][bool]$_.Covered })
    if ($c.Count -eq 0) { $c = @($script:V10.ZoneMap | Where-Object { $_.Zone -eq 'Toolbar' -and $_.Visible -and "$($_.Name)" -match $script:DestructivePattern -and "$n" -match $script:DestructivePattern } | Sort-Object { [int][bool]$_.Covered }) }
    return ($c | Select-Object -First 1)
}
$script:V10Orig_TestTargetInRow = ${function:Test-TargetInRow}
function Test-TargetInRow($t, $modelRows) {
    # Zone 模型优先（DOM 事实）；没有 Zone 信息时回退 v4.3 逻辑，但先剔除「超大伪行」（高度 > 视口 30% 的容器）
    $z = Get-V10ItemZone $t
