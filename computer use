    async def run(self) -> dict:
        t0 = time.perf_counter()
        d = self.router.route(self.task)
        if d.layer == 0 and d.intent:
            return await self._run_l0_save(d, t0)
        return await self._gui_loop(d, t0)

    async def _run_l0_save(self, d: Decision, t0: float) -> dict:
        it = d.intent
        folder = self.security.folder_for(it.folder_key)
        if not folder:
            return await self._gui_loop(Decision(4, "fallback", "known folder unavailable"), t0)
        res, _ = await self._do(0, self._req("save_text", folder=folder, name=it.name, content=it.content))
        if not res.ok:
            return self._finish("fail", f"save_text failed: {res.code} {res.message}", 0, t0)
        path = res.data["path"]
        await self._do(0, self._req("open_app", path=path))                      # cosmetic, never fatal
        ver, _ = await self._do(0, self._req("verify_text_file", path=path, expect_text=it.content or None))
        if not ver.ok:
            return self._finish("fail", f"verification failed: {ver.message}", 0, t0)
        return self._finish("done", f"已保存并核验：{path}（{res.data['bytes']} 字节）", 0, t0)

    async def _gui_loop(self, d: Decision, t0: float) -> dict:
        layer = d.layer if d.layer in self.executors else next((l for l in (1, 2, 3, 4) if l in self.executors), 0)
        ex = self.executors[layer]
        if self.policy_llm is None:
            return self._finish("fail", "no LLM policy configured", layer, t0)
        note = ""
        for _ in range(self.max_steps):
            obs = await ex.observe()
            self.sm.on_observation(obs)
            act = await self.policy_llm({"task": self.task, "history": self.history, "obs": obs, "note": note})
            name = str(act.get("action", "")).lower()
            if name == "done":
                return self._finish("done", str(act.get("summary", "")), layer, t0)
            if name == "fail":
                return self._finish("fail", str(act.get("reason", "")), layer, t0)
            args = {k: v for k, v in act.items() if k not in ("action", "thought", "target", "step", "expect")}
            req = self._req(name, obs, target=act.get("target") or act.get("ref"), **args)
            res, v = await self._do(layer, req, obs)
            note = v.message if (v and v.message and v.code != "OK") else ""
            if getattr(v, "terminal", None):
                return self._finish(v.terminal, v.summary, layer, t0)
            if self.sm.phase == Phase.ESCAPE and self.sm.pending_plan:
                plan, self.sm.pending_plan, self.sm.phase = self.sm.pending_plan, None, Phase.ACT
                for a in plan.actions:
                    await self._do(layer, self._req(a["action"], obs, **{k: x for k, x in a.items() if k != "action"}), obs)
                note = plan.note
        return self._finish("fail", f"max steps {self.max_steps} reached", layer, t0)
