$script:V11Orig_InvokeActionCore = ${function:Invoke-ActionCore}
function Invoke-ActionCore($a, [string]$kind) {
    if ($kind -eq 'locate_file') { return (Invoke-V11LocateFile $a) }
    if ($kind -eq 'save_text') { return (Invoke-V11SaveTextAction $a) }
    if ($kind -in 'select_rows', 'check', 'uncheck', 'toolbar_action' -and (Test-V11QuotaZero)) {
        $s = Complete-V11QuotaZero
        if ($s) { return $s }
    }
    $r = $null
    try { $r = & $script:V11Orig_InvokeActionCore $a $kind }
    catch {
        $m = "$($_.Exception.Message)"
        if ($m -match 'No node with given id found|DOM\.resolveNode') {
            $script:V11.Epoch++; $script:V11.StaleFix++
            throw "[STALE_EPOCH] 页面已重绘，界面已变化：旧节点编号作废（snapshot_epoch=$($script:V11.Epoch)）。请直接重新观察并使用新编号；不要再用旧编号。"
        }
        throw
