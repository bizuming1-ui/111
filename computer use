def enum_monitors() -> list[Monitor]:
    """Real monitors (virtual-desktop physical px; negative origins preserved) with effective DPI per monitor."""
    if not IS_WIN:
        return []
    from ctypes import wintypes

    class MONITORINFO(ctypes.Structure):
        _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", wintypes.RECT), ("rcWork", wintypes.RECT), ("dwFlags", wintypes.DWORD)]

    out: list[Monitor] = []
    user32 = ctypes.windll.user32
    proc = ctypes.WINFUNCTYPE(ctypes.c_int, wintypes.HANDLE, wintypes.HDC, ctypes.POINTER(wintypes.RECT), wintypes.LPARAM)

    def cb(hmon: Any, _hdc: Any, _rc: Any, _lp: Any) -> int:
        mi = MONITORINFO()
        mi.cbSize = ctypes.sizeof(MONITORINFO)
        if user32.GetMonitorInfoW(hmon, ctypes.byref(mi)):
            dx, dy = ctypes.c_uint(96), ctypes.c_uint(96)
            try:
                ctypes.windll.shcore.GetDpiForMonitor(hmon, 0, ctypes.byref(dx), ctypes.byref(dy))  # MDT_EFFECTIVE_DPI
            except Exception:  # noqa: BLE001
                pass
            r = mi.rcMonitor
            out.append(Monitor(len(out), r.left, r.top, r.right, r.bottom, int(dx.value or 96), bool(mi.dwFlags & 1)))
        return 1

    try:
        user32.EnumDisplayMonitors(None, None, proc(cb), 0)
    except Exception:  # noqa: BLE001
        return []
    return out


def _pid_tree(pid: int) -> set[int]:
    try:
