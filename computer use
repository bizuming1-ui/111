"""v16.2 Write-Ahead-Log transaction with crash recovery.

Lifecycle of every irreversible operation (one JSONL record per transition, fsync'ed BEFORE the side effect starts):
    created -> frozen_targets -> confirmed -> started -> unknown | verifying -> committed | failed        (+ paused_for_user: human adjudication)

Startup recovery (Brain.start): every transaction whose last phase is started / unknown / verifying is resolved against an EXTERNAL read-only oracle
(file really gone? mail really in TRASH? recycle bin really empty?):
    oracle proves applied      -> committed  (NEVER replayed)
    oracle proves NOT applied  -> resume_allowed (replay only for the ids/paths that are proven untouched, after a fresh HITL confirmation)
    oracle cannot decide       -> paused_for_user (human decides; irreversible actions are never blindly replayed)
"""
from __future__ import annotations

import json
import os
import threading
import time
import uuid
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Callable, Optional

from .state_machine import IRREVERSIBLE, TaskTransaction, TxEntry

PHASES = ("created", "frozen_targets", "confirmed", "started", "unknown", "verifying", "committed", "failed", "paused_for_user")
PENDING = ("started", "unknown", "verifying")
TERMINAL = ("committed", "failed", "paused_for_user")
_NEXT: dict[str, tuple[str, ...]] = {
    "created": ("frozen_targets", "failed"),
    "frozen_targets": ("confirmed", "failed"),
    "confirmed": ("started", "failed"),
    "started": ("unknown", "verifying", "committed", "failed", "paused_for_user"),
    "unknown": ("verifying", "committed", "failed", "paused_for_user"),
    "verifying": ("committed", "failed", "unknown", "paused_for_user"),
    "committed": (),
    "failed": (),
    "paused_for_user": ("committed", "failed"),
}
APPLIED, NOT_APPLIED, PARTIAL, UNKNOWN = "applied", "not_applied", "partial", "unknown"


class WalError(RuntimeError):
    pass


@dataclass
class WalRecord:
    txid: str
    seq: int
    phase: str
    kind: str = "generic"  # gmail_trash | file_recycle | recycle_empty | gui_action | generic
    task: str = ""
    targets: list[str] = field(default_factory=list)
    probe: dict[str, Any] = field(default_factory=dict)  # declarative oracle spec, e.g. {"type":"file_absent","paths":[...]}
    meta: dict[str, Any] = field(default_factory=dict)
    note: str = ""
    t: float = field(default_factory=time.time)
    pid: int = field(default_factory=os.getpid)
    v: int = 2


class WriteAheadLog:
    """Append-only JSONL, one fsync per record, torn-tail tolerant (a crash mid-write leaves at most one partial last line which is ignored)."""

    def __init__(self, path: Path, fsync: bool = True) -> None:
        self.path = Path(path)
        self.fsync = fsync
        self._lock = threading.Lock()
        self.torn_lines = 0
        self.writes = 0

    def append(self, rec: WalRecord) -> None:
        line = json.dumps(rec.__dict__, ensure_ascii=False, default=str) + "\n"
        with self._lock:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            with open(self.path, "ab+") as f:
                f.seek(0, os.SEEK_END)
                if f.tell() > 0:
                    f.seek(-1, os.SEEK_END)
                    if f.read(1) != b"\n":  # torn tail from a crash mid-write: terminate it so this record is never glued onto it
                        f.write(b"\n")
                f.write(line.encode("utf-8"))
                f.flush()
                if self.fsync:
                    os.fsync(f.fileno())
            self.writes += 1

    def read(self) -> list[WalRecord]:
        out: list[WalRecord] = []
        self.torn_lines = 0
        if not self.path.exists():
            return out
        for raw in self.path.read_bytes().split(b"\n"):
            if not raw.strip():
                continue
            try:
                d = json.loads(raw.decode("utf-8"))
                if d.get("v") == 2 and d.get("phase") in PHASES:
                    out.append(WalRecord(**{k: d[k] for k in WalRecord.__dataclass_fields__ if k in d}))
            except (ValueError, UnicodeDecodeError, TypeError):
                self.torn_lines += 1
        return out

    def latest(self) -> dict[str, WalRecord]:
        """Last record per txid; targets/probe/meta/kind are inherited from the most informative earlier records."""
        by: dict[str, WalRecord] = {}
        for r in self.read():
            prev = by.get(r.txid)
            if prev is not None:
                r.kind = r.kind if r.kind != "generic" else prev.kind
                r.task = r.task or prev.task
                r.targets = r.targets or prev.targets
                r.probe = r.probe or prev.probe
                r.meta = {**prev.meta, **r.meta}
            by[r.txid] = r
        return by

    def pending(self) -> list[WalRecord]:
        return [r for r in self.latest().values() if r.phase in PENDING]


class WalTransaction(TaskTransaction):
    """Drop-in replacement for state_machine.TaskTransaction (same intend/settle/commit/abort API) + explicit irreversible-operation lifecycle."""

    def __init__(self, wal: WriteAheadLog | Path | None = None, task: str = "") -> None:
        super().__init__(None)
        self.wal = wal if isinstance(wal, WriteAheadLog) else WriteAheadLog(Path(wal)) if wal else None
        self.task = task
        self.ops: dict[str, str] = {}  # txid -> current phase
        self._gui: dict[int, str] = {}  # TxEntry.seq -> txid
        self.unverified_reason = ""

    # ---------------------------------------------------------------- explicit lifecycle
    def _write(self, txid: str, phase: str, **kw: Any) -> WalRecord:
        cur = self.ops.get(txid)
        if cur is None and phase != "created":
            raise WalError(f"unknown txid {txid}")
        if cur is not None and phase not in _NEXT[cur]:
            raise WalError(f"illegal WAL transition {cur} -> {phase} for {txid}")
        seq = int(time.time() * 1e6)
        rec = WalRecord(txid=txid, seq=seq, phase=phase, task=kw.pop("task", self.task), **kw)
        if self.wal:
            self.wal.append(rec)
        self.ops[txid] = phase
        return rec

    def create(self, kind: str, probe: dict[str, Any] | None = None, meta: dict[str, Any] | None = None) -> str:
        txid = uuid.uuid4().hex[:16]
        self._write(txid, "created", kind=kind, probe=probe or {}, meta=meta or {})
        return txid

    def freeze(self, txid: str, targets: list[str], probe: dict[str, Any] | None = None, meta: dict[str, Any] | None = None) -> None:
        self._write(txid, "frozen_targets", targets=list(targets), probe=probe or {}, meta=meta or {})

    def confirm(self, txid: str, note: str = "") -> None:
        self._write(txid, "confirmed", note=note)

    def start(self, txid: str) -> None:
        """MUST be called (and returns only after fsync) BEFORE the irreversible side effect is issued."""
        self._write(txid, "started")

    def mark_unknown(self, txid: str, note: str = "") -> None:
        self._write(txid, "unknown", note=note)

    def verifying(self, txid: str, note: str = "") -> None:
        self._write(txid, "verifying", note=note)

    def finish(self, txid: str, ok: bool, note: str = "") -> None:
        self._write(txid, "committed" if ok else "failed", note=note)

    def pause(self, txid: str, note: str = "") -> None:
        self._write(txid, "paused_for_user", note=note)

    # ---------------------------------------------------------------- legacy GUI-action path (TaskTransaction API)
    def intend(self, step: int, sig: str, action: dict[str, Any], label: str = "") -> Optional[str]:
        msg = super().intend(step, sig, action, label)
        if msg is None and self.entries and self.entries[-1].irreversible and self.wal:
            e = self.entries[-1]
            txid = self.create("gui_action", probe={"type": "none"}, meta={"sig": sig[:200], "step": step, "action": str(action.get("action", ""))})
            self.freeze(txid, [sig[:200]])
            self.confirm(txid, "implicit(gate-approved)")
            self.start(txid)
            self._gui[e.seq] = txid
        return msg

    def settle(self, ok: bool, effect: str = "") -> None:
        super().settle(ok, effect)
        if not self.entries:
            return
        e = self.entries[-1]
        txid = self._gui.pop(e.seq, None)
        if txid and self.ops.get(txid) == "started":
            if ok and effect != "none":
                self.verifying(txid, effect)
                self.finish(txid, True, effect)
            elif not ok:
                self.finish(txid, False, effect or "error")
            else:
                self.mark_unknown(txid, "effect=none")

    def commit(self) -> None:
        super().commit()

    def mark_unverified(self, reason: str) -> None:
        """Task ended with coverage != full: the transaction is deliberately NOT committed."""
        self.state = "unverified"
        self.unverified_reason = reason


