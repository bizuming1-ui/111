"""Hard Action-Space Masking (v12).  NOT a prompt: a gate in the executor path that *physically refuses* banned clicks.

Semantics (single spec, mirrored 1:1 in PowerShell `Test-V12ActionMasked` and the TS emulator; fixture-checked):

  modes     open -> vision -> keyboard           (escalation)  ...  effective action -> open
  observe   a click-class action with NO pixel effect, repeated on the same target twice (REPEAT_NOEFFECT /
            SELF_DRAWN_ESCAPE) bans that element_id AND a 48 px disc around its coordinates.
            1st block  -> mode `vision`   (clicks need fresh `vision_grounded`, banned targets are refused)
            2nd block, or 2 refused attempts at a banned target -> mode `keyboard` (ALL click-class actions refused)
  keyboard  needs >= 1 non-click exploration step (key/type/focus_window/vision_inspect/ocr/inspect/app_resolve) and
            then a `vision_grounded` click outside every banned disc, which moves the machine back to `vision`.
"""
from __future__ import annotations

import math
from dataclasses import dataclass, field

CLICK_KINDS = frozenset({"click", "double_click", "right_click", "hover", "drag"})
EXPLORE_KINDS = frozenset({"key", "type", "focus_window", "vision_inspect", "ocr", "inspect", "app_resolve", "launch", "scroll"})
BAN_RADIUS = 48.0
ALLOWED_IN_KEYBOARD = ("key", "type", "focus_window", "vision_inspect", "ocr", "inspect", "app_resolve", "launch", "replan", "wait")


@dataclass
class GateDecision:
    allow: bool
    code: str = "OK"            # OK | ACTION_MASKED
    reason: str = ""            # BANNED_ID | BANNED_RECT | KEYBOARD_ONLY | NEED_GROUNDING
    mode: str = "open"
    message: str = ""
    allowed_kinds: tuple[str, ...] = ()


@dataclass
class ActionGate:
    mode: str = "open"
    banned_ids: set[str] = field(default_factory=set)
    banned_rects: list[tuple[float, float, float]] = field(default_factory=list)
    noeffect: dict[str, int] = field(default_factory=dict)
    blocks: int = 0
    mask_hits: int = 0
    kb_steps: int = 0
    masked_total: int = 0
    switches: int = 0

    # ------------------------------------------------------------------ helpers
    @staticmethod
    def _key(act: dict) -> str:
        if act.get("id") not in (None, ""):
            return f"id:{act['id']}"
        if act.get("x") is not None and act.get("y") is not None:
            return f"xy:{round(float(act['x']) / 8)}:{round(float(act['y']) / 8)}"
        return ""

    def _in_rect(self, act: dict) -> bool:
        if act.get("x") is None or act.get("y") is None:
            return False
        x, y = float(act["x"]), float(act["y"])
        return any(math.hypot(x - bx, y - by) <= r for bx, by, r in self.banned_rects)

    def _set(self, mode: str) -> None:
        if mode != self.mode:
            self.mode = mode
            self.switches += 1
        self.kb_steps = 0

    # ------------------------------------------------------------------ gate (pre-action)
    def check(self, act: dict) -> GateDecision:
        kind = str(act.get("action", "")).lower()
        if kind not in CLICK_KINDS:
            if self.mode == "keyboard" and kind in EXPLORE_KINDS:
                self.kb_steps += 1
            return GateDecision(True, mode=self.mode)
        if act.get("id") not in (None, "") and str(act["id"]) in self.banned_ids:
            return self._mask(act, "BANNED_ID", f"element_id={act['id']} 已被硬性封禁（无像素变化 ≥2 次）")
        if self._in_rect(act):
            return self._mask(act, "BANNED_RECT", f"坐标 ({act.get('x')},{act.get('y')}) 落在封禁圆盘（r={int(BAN_RADIUS)}px）内")
        if self.mode == "keyboard":
            if bool(act.get("vision_grounded")) and self.kb_steps >= 1:
                self._set("vision")                      # keyboard exploration done -> allow ONE grounded relocation
                return GateDecision(True, mode=self.mode)
            return self._mask(act, "KEYBOARD_ONLY", "状态机处于键盘导航空间：点击类动作被硬性屏蔽，请先 key/type/focus_window/vision_inspect 探索，再用 vision_grounded=true 重定位")
        if self.mode == "vision" and act.get("id") in (None, "") and act.get("x") is not None and not act.get("vision_grounded"):
            return self._mask(act, "NEED_GROUNDING", "视觉重定位空间：坐标点击必须来自最新截图的 vision_grounded=true")
        return GateDecision(True, mode=self.mode)

    def _mask(self, act: dict, reason: str, why: str) -> GateDecision:
        self.masked_total += 1
        if reason in ("BANNED_ID", "BANNED_RECT"):
            self.mask_hits += 1
            if self.mask_hits >= 2 and self.mode != "keyboard":
                self._set("keyboard")
        return GateDecision(False, "ACTION_MASKED", reason, self.mode,
                            f"[ACTION_MASKED:{reason}] {why}。当前空间={self.mode}；可用动作：{'/'.join(ALLOWED_IN_KEYBOARD)}；"
                            "点击仅在 vision_grounded 重定位后、且远离封禁点时放行。",
                            ALLOWED_IN_KEYBOARD)

    # ------------------------------------------------------------------ observe (post-action)
    def observe(self, act: dict, effective: bool) -> None:
        kind = str(act.get("action", "")).lower()
        if kind not in CLICK_KINDS:
            return
        if effective:
            self.mode, self.blocks, self.mask_hits, self.kb_steps = "open", 0, 0, 0
            self.banned_ids.clear(); self.banned_rects.clear(); self.noeffect.clear()
            return
        k = self._key(act)
        if not k:
            return
        self.noeffect[k] = self.noeffect.get(k, 0) + 1
        if self.noeffect[k] >= 2 and (act.get("id") not in (None, "") and str(act["id"]) not in self.banned_ids or not self._in_rect(act)):
            self.blocks += 1
            if act.get("id") not in (None, ""):
                self.banned_ids.add(str(act["id"]))
            if act.get("x") is not None and act.get("y") is not None:
                self.banned_rects.append((float(act["x"]), float(act["y"]), BAN_RADIUS))
            self._set("vision" if self.blocks == 1 else "keyboard")

    def ban_from_error(self, act: dict, text: str) -> None:
        """PowerShell parity: ingest `[REPEAT_NOEFFECT] click (x,y)` / `[SELF_DRAWN_ESCAPE]` text and ban immediately."""
        import re
        m = re.search(r"\((-?\d+),\s*(-?\d+)\)", text)
        a = dict(act)
        if m:
            a["x"], a["y"] = int(m.group(1)), int(m.group(2))
        self.noeffect[self._key(a)] = max(2, self.noeffect.get(self._key(a), 0))
        self.observe(a, False)

    def reset(self) -> None:
        self.__init__()  # type: ignore[misc]

    def snapshot(self) -> dict:
        return {"mode": self.mode, "banned_ids": sorted(self.banned_ids), "banned_rects": self.banned_rects,
                "blocks": self.blocks, "masked_total": self.masked_total, "switches": self.switches}
