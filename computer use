# ====================================================================================================================== 4. Action Transaction
class TestActionTransaction(unittest.TestCase):
    def _tx(self, calls: list[str], rev: atx.Reversibility = atx.Reversibility.REVERSIBLE, ok_world: bool = True, target=None):
        state = {"v": 1}
        w = WorldModel()

        def execute() -> tuple[bool, str]:
            calls.append("exec")
            if ok_world:
                state["v"] = 0
            return True, "ok"

        return atx.ActionTransaction("g1", "op", target, execute, rev, [], None, None, lambda ctx: [atx.row("state_changed", state["v"] == 0, f"v={state['v']}")], note="n1"), w

    def test_idempotent_replay_never_reexecutes(self) -> None:
        calls: list[str] = []
        eng = atx.TxEngine()
        tx, _ = self._tx(calls)
        self.assertEqual(asyncio.run(eng.run(tx)).status, atx.TxStatus.COMMITTED)
        r2 = asyncio.run(eng.run(tx))
        self.assertEqual((r2.status, calls), (atx.TxStatus.REPLAYED, ["exec"]))

    def test_no_effect_is_not_success(self) -> None:
        calls: list[str] = []
        tx, _ = self._tx(calls, ok_world=False)
        r = asyncio.run(atx.TxEngine().run(tx))
        self.assertEqual((r.status, r.code), (atx.TxStatus.NO_EFFECT, "ACTION_NO_EFFECT"))

    def test_irreversible_needs_text_authorization_and_identity(self) -> None:
        env = Env(["a.txt"])
        try:
            ref = env.world.refresh("recyclebin")[0]
            calls: list[str] = []
            tx, _ = self._tx(calls, atx.Reversibility.IRREVERSIBLE, target=ref)
            eng = atx.TxEngine()
            r = asyncio.run(eng.run(tx, authorized_text=False, frozen_ids={ref.identity}))
            self.assertEqual((r.status, r.code, calls), (atx.TxStatus.DENIED, "SECURITY_DENIED", []))
            r = asyncio.run(eng.run(tx, authorized_text=True, frozen_ids={"bin:other"}))
            self.assertEqual((r.status, r.code, calls), (atx.TxStatus.DENIED, "OBJECT_IDENTITY_MISMATCH", []))    # never swap the target to "finish"
            r = asyncio.run(eng.run(tx, authorized_text=True, frozen_ids={ref.identity}))
            self.assertEqual((r.status, calls), (atx.TxStatus.COMMITTED, ["exec"]))
        finally:
            env.close()

    def test_collateral_damage_is_detected(self) -> None:
        env = Env(["a.txt", "b.txt", "c.txt"])
        try:
            refs = env.world.refresh("recyclebin")
            be = env.backend

            def evil() -> tuple[bool, str]:   # deletes a.txt (target) AND b.txt (collateral)
                be.items = [i for i in be.items if i.name == "c.txt"]
                return True, "ok"

            tx = atx.ActionTransaction("g", "bin_purge", refs[0], evil, atx.Reversibility.REVERSIBLE, [], atx.ExpectedWorldDelta("recyclebin", lambda: env.world.identity_set("recyclebin"), frozenset({refs[0].identity})))
            r = asyncio.run(atx.TxEngine().run(tx))
            self.assertEqual(r.status, atx.TxStatus.NO_EFFECT)
            self.assertTrue(any(x["name"] == "world_delta_exact" and not x["ok"] for x in r.rows))
        finally:
            env.close()

    def test_ledger_is_durable_and_survives_restart(self) -> None:
        d = Path(tempfile.mkdtemp())
        try:
            calls: list[str] = []
            tx, _ = self._tx(calls)
            eng = atx.TxEngine(atx.TxLedger(d / "tx.jsonl"))
            asyncio.run(eng.run(tx))
            lines = (d / "tx.jsonl").read_text(encoding="utf-8").splitlines()
            self.assertEqual([json.loads(x)["phase"] for x in lines], ["prepared", "executed", "committed"])
            self.assertIsNotNone(atx.TxLedger(d / "tx.jsonl").committed(tx.key))
        finally:
            shutil.rmtree(d, ignore_errors=True)


