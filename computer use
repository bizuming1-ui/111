        self.assertEqual(status, "completed_verified", "\n".join(out))
        self.assertEqual(brain.llm.calls, 0)
        self.assertEqual((Path(home) / "Desktop" / "bzm.txt").read_text(encoding="utf-8"), "你好啊啊啊")
        self.assertIn("窗口标题已确认", "\n".join(out))


if __name__ == "__main__":
