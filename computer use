        $cW = [int][Math]::Max(2.0, [Math]::Round([double]$r.cw * $sc)); $cH = [int][Math]::Max(2.0, [Math]::Round([double]$r.ch * $sc))
        $bid = 0
        foreach ($ci in $cbItems) { if ($ci.cx -ge ($cL - 3) -and $ci.cx -le ($cL + $cW + 3) -and $ci.cy -ge ($cT - 3) -and $ci.cy -le ($cT + $cH + 3)) { $bid = [int]$ci.Bid; break } }
        $rowItem = $null; $bestA = -1.0
        foreach ($oi in $others) { if ($oi.cx -ge $L -and $oi.cx -le ($L + $W) -and $oi.cy -ge $T -and $oi.cy -le ($T + $H)) { $a = [double]$oi.W * [double]$oi.H; if ($a -gt $bestA) { $bestA = $a; $rowItem = $oi } } }
        $st = if ($r.c -eq $true) { 'on' } elseif ("$($r.c)" -eq 'mixed') { 'mixed' } else { 'off' }
        $nm = "$($r.nm)"; if ([string]::IsNullOrWhiteSpace($nm)) { $nm = "R$n 复选框" }
        $cb = [pscustomobject]@{ Type = 'CheckBox'; Name = $nm; AutoId = ''; State = $st; Enabled = [bool]$r.en; Tog = $false; El = $null; L = $cL; T = $cT; W = $cW; H = $cH; Off = [bool]$r.off; Cdp = $true; Bid = $bid }
        $rw = [pscustomobject]@{ Type = 'DataItem'; Name = "$($r.t)"; AutoId = ''; Enabled = $true; Pats = @(); El = $null; L = $L; T = $T; W = $W; H = $H; Off = [bool]$r.off; Cdp = $true }
        $rows.Add([pscustomobject]@{ Index = $n; Key = ''; Text = (Limit-Text "$($r.t)" 120); Cb = $cb; Row = $rw; Cdp = $true; CdpIdx = [int]$r.i; RowItem = $rowItem })
    }
    if ($rows.Count -gt 0) { try { Set-RowKeys $rows } catch { foreach ($rr in $rows) { $rr.Key = "$($rr.Text)#$($rr.Index)" } } }
    $master = [System.Collections.Generic.List[object]]::new()
    foreach ($m in @($Raw.master)) {
        $master.Add([pscustomobject]@{ Type = 'CheckBox'; Name = "$($m.nm)"; AutoId = ''; State = $(if ($m.c -eq $true) { 'on' } else { 'off' }); Enabled = $true; Tog = $false; El = $null
                L = [int][Math]::Round($ox + [double]$m.cl * $sc); T = [int][Math]::Round($oy + [double]$m.ct * $sc); W = [int][Math]::Max(2.0, [Math]::Round([double]$m.cw * $sc)); H = [int][Math]::Max(2.0, [Math]::Round([double]$m.ch * $sc)); Off = $false; Cdp = $true; Bid = 0 })
    }
    return [pscustomobject]@{ Rows = $rows.ToArray(); Master = $master.ToArray(); Cdp = $true }
}
function Get-V92CdpRowModel($CdpObs) {
    if ($null -eq $CdpObs) { return $null }
