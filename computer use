//! agent-desktop-grade accessibility snapshots: snapshot-scoped immutable refs (`@s8f3k2p9:e8`),
//! fail-closed resolution (STALE_REF / AMBIGUOUS_TARGET), progressive disclosure (`--skeleton`, `--root <ref>`).
use crate::protocol::{ErrKind, RpcError};
use crate::tree::{RawNode, WindowInfo};
use serde::{Deserialize, Serialize};
use serde_json::json;
use std::collections::{HashMap, VecDeque};

#[derive(Clone, Debug, Default, Serialize, Deserialize)]
pub struct Node {
    pub n: u32,
    pub key: String,
    pub role: String,
    pub name: String,
    pub automation_id: String,
    pub class: String,
    pub rect: [i32; 4],
    pub enabled: bool,
    pub password: bool,
    pub patterns: Vec<String>,
    pub value: Option<String>,
    pub source: String,
    pub children: Vec<Node>,
}

/// Immutable record behind a ref; everything needed to re-find the element later.
#[derive(Clone, Debug, Default, Serialize, Deserialize)]
pub struct RefEntry {
    pub n: u32,
    pub key: String,
    pub role: String,
    pub name: String,
    pub automation_id: String,
    pub class: String,
    pub rect: [i32; 4],
    pub source: String,
    pub patterns: Vec<String>,
    pub password: bool,
    pub window_id: i64,
}

pub struct Snapshot {
    pub id: String,
    pub window: WindowInfo,
    pub root: Node,
    pub entries: HashMap<u32, RefEntry>,
    pub paths: HashMap<u32, Vec<usize>>,
    pub total: usize,
    pub created_ms: u64,
}

pub struct Rendered {
    pub text: String,
    pub nodes_shown: usize,
    pub truncated: usize,
    pub tokens: usize,
}

const ACTIONABLE: [&str; 7] = ["invoke", "toggle", "value", "selection_item", "expand_collapse", "scroll", "range_value"];

fn keep_self(r: &RawNode) -> bool {
    !r.name.trim().is_empty() || !r.automation_id.is_empty() || r.patterns.iter().any(|p| ACTIONABLE.contains(&p.as_str()))
}

fn prune(r: &RawNode, include_offscreen: bool, budget: &mut usize) -> Vec<Node> {
    if r.offscreen && !include_offscreen {
        return vec![];
    }
    let mut kids: Vec<Node> = Vec::new();
    for c in &r.children {
        if *budget == 0 {
            break;
        }
        kids.extend(prune(c, include_offscreen, budget));
    }
    if keep_self(r) && *budget > 0 {
        *budget -= 1;
        vec![Node {
            n: 0,
            key: r.key.clone(),
            role: r.role.clone(),
            name: r.name.clone(),
            automation_id: r.automation_id.clone(),
            class: r.class.clone(),
            rect: r.rect,
            enabled: r.enabled,
            password: r.password,
            patterns: r.patterns.clone(),
            value: if r.password { None } else { r.value.clone() },
            source: r.source.clone(),
            children: kids,
        }]
    } else {
        kids // unnamed layout wrapper: promote children (this alone removes most UIA depth noise)
    }
}

fn number(n: &mut Node, counter: &mut u32, path: &mut Vec<usize>, paths: &mut HashMap<u32, Vec<usize>>) {
    *counter += 1;
    n.n = *counter;
    paths.insert(n.n, path.clone());
    for (i, c) in n.children.iter_mut().enumerate() {
        path.push(i);
        number(c, counter, path, paths);
        path.pop();
    }
}

fn collect(n: &Node, window_id: i64, out: &mut HashMap<u32, RefEntry>) {
    out.insert(
        n.n,
        RefEntry {
            n: n.n,
            key: n.key.clone(),
            role: n.role.clone(),
            name: n.name.clone(),
            automation_id: n.automation_id.clone(),
            class: n.class.clone(),
            rect: n.rect,
            source: n.source.clone(),
            patterns: n.patterns.clone(),
            password: n.password,
            window_id,
        },
    );
    for c in &n.children {
        collect(c, window_id, out);
    }
}

fn count(n: &Node) -> usize {
    1 + n.children.iter().map(count).sum::<usize>()
}

/// CJK/other wide chars cost ~1 token, ASCII ~0.25, plus 1 per line (conservative; same formula in the TS simulator).
pub fn est_tokens(s: &str) -> usize {
    let (mut ascii, mut wide, mut lines) = (0usize, 0usize, 1usize);
    for c in s.chars() {
        if c == '\n' {
            lines += 1;
        } else if c.is_ascii() {
            ascii += 1;
        } else {
            wide += 1;
        }
    }
    (ascii + 3) / 4 + wide + lines
}

fn clean(s: &str, max: usize) -> String {
    let t: String = s.chars().map(|c| if c == '\r' || c == '\n' || c == '\t' { ' ' } else if c == '"' { '\'' } else { c }).collect();
    let t = t.trim();
    if t.chars().count() > max {
        let mut o: String = t.chars().take(max).collect();
        o.push('~');
        o
    } else {
        t.to_string()
    }
}

fn hint(n: &Node) -> &'static str {
    for p in &n.patterns {
        match p.as_str() {
            "invoke" => return " <click>",
            "value" => return " <type>",
            "toggle" => return " <toggle>",
            "expand_collapse" => return " <expand>",
            "selection_item" => return " <select>",
            "scroll" => return " <scroll>",
            _ => {}
        }
    }
    ""
}

impl Snapshot {
    pub fn build(id: String, window: WindowInfo, raw: &RawNode, max_nodes: usize, include_offscreen: bool, now_ms: u64) -> Snapshot {
        let mut budget = max_nodes.max(1);
        let mut roots = prune(raw, include_offscreen, &mut budget);
        let mut root = if roots.len() == 1 {
            roots.pop().unwrap()
        } else {
            Node { role: "window".into(), name: window.title.clone(), enabled: true, source: raw.source.clone(), children: roots, rect: window.rect, ..Default::default() }
        };
        let (mut counter, mut paths) = (0u32, HashMap::new());
        number(&mut root, &mut counter, &mut Vec::new(), &mut paths);
        let mut entries = HashMap::new();
        collect(&root, window.window_id, &mut entries);
        let total = count(&root);
        Snapshot { id, window, root, entries, paths, total, created_ms: now_ms }
    }

    pub fn node(&self, n: u32) -> Option<&Node> {
        let path = self.paths.get(&n)?;
        let mut cur = &self.root;
        for i in path {
            cur = cur.children.get(*i)?;
        }
        Some(cur)
    }

    pub fn ref_str(&self, n: u32) -> String {
        format!("@{}:e{}", self.id, n)
    }

    /// `depth`: None = full subtree, Some(d) = skeleton (levels 0..=d, truncated containers annotated with `[+N children]`).
    pub fn render(&self, root: Option<u32>, depth: Option<usize>) -> Result<Rendered, RpcError> {
        let start = match root {
            None => &self.root,
            Some(n) => self.node(n).ok_or_else(|| RpcError::new(ErrKind::StaleRef, format!("unknown ref e{n} in snapshot {}", self.id)).with_data(json!({ "reason": "unknown_ref" })))?,
        };
        let mut lines: Vec<String> = Vec::new();
        let (mut shown, mut truncated) = (0usize, 0usize);
        fn walk(s: &Snapshot, n: &Node, d: usize, depth: Option<usize>, lines: &mut Vec<String>, shown: &mut usize, trunc: &mut usize) {
            let mut l = String::new();
            for _ in 0..d {
                l.push_str("  ");
            }
            l.push_str(&n.role);
            if !n.name.trim().is_empty() {
                l.push_str(&format!(" \"{}\"", clean(&n.name, 60)));
            }
            l.push_str(&format!(" {}", s.ref_str(n.n)));
            if !n.enabled {
                l.push_str(" [disabled]");
            }
            if let Some(v) = &n.value {
                if !v.is_empty() && !n.password {
                    l.push_str(&format!(" [value=\"{}\"]", clean(v, 40)));
                }
            }
            if n.password {
                l.push_str(" [password]");
            }
            l.push_str(hint(n));
            let cut = depth.map(|m| d >= m).unwrap_or(false) && !n.children.is_empty();
            if cut {
                l.push_str(&format!(" [+{} children]", n.children.len()));
                *trunc += 1;
            }
            lines.push(l);
            *shown += 1;
            if !cut {
                for c in &n.children {
                    walk(s, c, d + 1, depth, lines, shown, trunc);
                }
            }
        }
        walk(self, start, 0, depth, &mut lines, &mut shown, &mut truncated);
        let header = format!(
            "# window {} \"{}\" proc={} snapshot={} nodes={} shown={}{}",
            self.window.window_id,
            clean(&self.window.title, 60),
            self.window.process,
            self.id,
            self.total,
            shown,
            if truncated > 0 { format!(" truncated={truncated} (drill down: root=\"{}:eN\")", format_args!("@{}", self.id)) } else { String::new() }
        );
        let text = format!("{header}\n{}", lines.join("\n"));
        let tokens = est_tokens(&text);
        Ok(Rendered { text, nodes_shown: shown, truncated, tokens })
    }
}

pub struct Store {
    snaps: VecDeque<Snapshot>,
    cap: usize,
    counter: u64,
}

impl Store {
    pub fn new(cap: usize) -> Self {
        Store { snaps: VecDeque::new(), cap: cap.max(2), counter: 0 }
    }
    /// 's' + 7 base36 chars, e.g. `s8f3k2p9`.
    pub fn new_id(&mut self, seed: u64) -> String {
        self.counter += 1;
        let mut h = seed ^ (self.counter.wrapping_mul(0x9E3779B97F4A7C15));
        h ^= h >> 33;
        h = h.wrapping_mul(0xff51afd7ed558ccd);
        h ^= h >> 29;
        const D: &[u8] = b"0123456789abcdefghijklmnopqrstuvwxyz";
        let mut s = String::from("s");
        for _ in 0..7 {
            s.push(D[(h % 36) as usize] as char);
            h /= 36;
        }
        s
    }
    pub fn insert(&mut self, s: Snapshot) {
        self.snaps.push_back(s);
        while self.snaps.len() > self.cap {
            self.snaps.pop_front();
        }
    }
    pub fn get(&self, id: &str) -> Option<&Snapshot> {
        self.snaps.iter().find(|s| s.id == id)
    }
    pub fn len(&self) -> usize {
        self.snaps.len()
    }
}

/// `@s8f3k2p9:e8` (leading '@' optional) -> ("s8f3k2p9", 8)
pub fn parse_ref(r: &str) -> Result<(String, u32), RpcError> {
    let bad = || RpcError::new(ErrKind::InvalidParams, format!("malformed ref '{r}', expected @<snapshot>:e<N>"));
    let t = r.trim().trim_start_matches('@');
    let (sid, e) = t.split_once(":e").ok_or_else(bad)?;
    if sid.len() != 8 || !sid.starts_with('s') || !sid.bytes().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit()) {
        return Err(bad());
    }
    let n: u32 = e.parse().map_err(|_| bad())?;
    if n == 0 {
        return Err(bad());
    }
    Ok((sid.to_string(), n))
}

/// The snapshot's window must still exist with the same identity; otherwise STALE_REF (never guess).
pub fn validate_window(snap: &Snapshot, live: &[WindowInfo]) -> Result<WindowInfo, RpcError> {
    let w = live.iter().find(|w| w.window_id == snap.window.window_id).ok_or_else(|| {
        RpcError::new(ErrKind::StaleRef, format!("window {} of snapshot {} no longer exists", snap.window.window_id, snap.id)).with_data(json!({ "reason": "window_closed" }))
    })?;
    if w.pid != snap.window.pid || w.class != snap.window.class {
        return Err(RpcError::new(ErrKind::StaleRef, format!("window handle {} was recycled by another process/class", w.window_id)).with_data(json!({ "reason": "window_recycled" })));
    }
    Ok(w.clone())
}

#[derive(Clone, Debug)]
pub struct LiveCand {
    pub index: usize,
    pub key: String,
    pub role: String,
    pub name: String,
    pub automation_id: String,
    pub rect: [i32; 4],
}

/// Pure fail-closed matching of a ref entry against live candidates (used by every Platform::act).
/// 1) unique runtime-key match  2) unique (automation_id+role[+name]) match  3) unique (role+name) match.
/// Zero -> STALE_REF, several -> AMBIGUOUS_TARGET with candidate list.
pub fn pick_match(e: &RefEntry, live: &[LiveCand]) -> Result<usize, RpcError> {
    let by = |f: &dyn Fn(&LiveCand) -> bool| -> Vec<&LiveCand> { live.iter().filter(|c| f(c)).collect() };
    let k = by(&|c| !e.key.is_empty() && c.key == e.key);
    if k.len() == 1 {
        return Ok(k[0].index);
    }
    let a = if !e.automation_id.is_empty() { by(&|c| c.automation_id == e.automation_id && c.role == e.role && (e.name.is_empty() || c.name == e.name)) } else { vec![] };
    if a.len() == 1 {
        return Ok(a[0].index);
    }
    let rn = if !e.name.is_empty() { by(&|c| c.role == e.role && c.name == e.name) } else { vec![] };
    let pool = if a.len() > 1 { a } else if k.len() > 1 { k } else { rn };
    match pool.len() {
        1 => Ok(pool[0].index),
        0 => Err(RpcError::new(ErrKind::StaleRef, format!("element e{} ({} \"{}\") no longer exists in the live UI tree", e.n, e.role, clean(&e.name, 40))).with_data(json!({ "reason": "element_missing" }))),
        n => Err(RpcError::new(ErrKind::AmbiguousTarget, format!("{n} live elements match e{}; re-snapshot or narrow with --root", e.n)).with_data(json!({
            "candidates": pool.iter().take(8).map(|c| json!({ "index": c.index, "role": c.role, "name": c.name, "rect": c.rect, "window_id": e.window_id })).collect::<Vec<_>>()
        }))),
    }
}

