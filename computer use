const ROW_Q: &str = "qwertyuiop[]";
const ROW_A: &str = "asdfghjkl;'`";
const ROW_Z: &str = "zxcvbnm,./";
const DIGITS: &str = "1234567890-=";
const SHIFT_DIGITS: &str = "!@#$%^&*()_+";
const SHIFT_ROW_Q: &str = "QWERTYUIOP{}";
const SHIFT_ROW_A: &str = "ASDFGHJKL:\"~";
const SHIFT_ROW_Z: &str = "ZXCVBNM<>?";

fn idx(table: &str, c: char) -> Option<u16> {
    table.chars().position(|t| t == c).map(|i| i as u16)
}

pub fn for_char(c: char) -> Option<KeyStroke> {
    let k = |scan, shift| Some(KeyStroke { scan, shift });
    match c {
        ' ' => return k(0x39, false),
        '\n' => return k(0x1C, false),
        '\t' => return k(0x0F, false),
        '\\' => return k(0x2B, false),
        '|' => return k(0x2B, true),
        _ => {}
    }
    if let Some(i) = idx(DIGITS, c) { return k(0x02 + i, false); }
    if let Some(i) = idx(SHIFT_DIGITS, c) { return k(0x02 + i, true); }
    if let Some(i) = idx(ROW_Q, c) { return k(0x10 + i, false); }
    if let Some(i) = idx(SHIFT_ROW_Q, c) { return k(0x10 + i, true); }
    if let Some(i) = idx(ROW_A, c) { return k(0x1E + i, false); }
    if let Some(i) = idx(SHIFT_ROW_A, c) { return k(0x1E + i, true); }
    if let Some(i) = idx(ROW_Z, c) { return k(0x2C + i, false); }
    if let Some(i) = idx(SHIFT_ROW_Z, c) { return k(0x2C + i, true); }
    None
}

pub fn plan_text(s: &str) -> Vec<Ev> {
    let mut out = Vec::with_capacity(s.len() * 2);
    for c in s.chars() {
        match for_char(c) {
            Some(ks) => {
                if ks.shift { out.push(Ev::Scan { code: SC_LSHIFT, up: false }); }
                out.push(Ev::Scan { code: ks.scan, up: false });
                out.push(Ev::Scan { code: ks.scan, up: true });
                if ks.shift { out.push(Ev::Scan { code: SC_LSHIFT, up: true }); }
            }
            None => {
                let mut buf = [0u16; 2];
                for u in c.encode_utf16(&mut buf).iter() {
                    out.push(Ev::Unicode { unit: *u, up: false });
                    out.push(Ev::Unicode { unit: *u, up: true });
                }
            }
        }
    }
    out
}
