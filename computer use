from agent_brain.protocol import ActionRequest, ActionResult, ObservationEnvelope, Ref  # noqa: E402
from agent_brain.router import Router                                    # noqa: E402

# ------------------------------------------------------------------------------------------------- Mock Gmail
class MockGmail:
    """CDP-like list page. refs are bound to an epoch; touching a ref from before the last structural change is the
    analogue of `CDP DOM.resolveNode: No node with given id found` (emitted as STALE_EPOCH, never reaching the browser)."""

    def __init__(self, n: int = 50):
        self.rows = [{"id": 1000 + i, "text": f"mail-{i + 1}"} for i in range(n)]
        self.selected: set[int] = set()
        self.epoch = 1
        self.deleted: list[str] = []
        self.node_ids = {r["id"] for r in self.rows}

    async def observe(self) -> ObservationEnvelope:
        refs = [Ref(f"cdp:{r['id']}", "checkbox", r["text"], "Row", self.epoch, None, i + 1) for i, r in enumerate(self.rows[:12])]
        refs.append(Ref("cdp:toolbar-delete", "button", "删除", "Toolbar", self.epoch))
        return ObservationEnvelope("cdp", self.epoch, refs, window_title="收件箱 - Gmail", process="chrome",
                                   row_count=len(self.rows), text=f"rows={len(self.rows)} selected={len(self.selected)}")

    def _pick(self, spec: str) -> list[dict]:
        out: list[dict] = []
        for part in re.split(r"[,，]", spec):
            m = re.fullmatch(r"\s*(\d+)\s*-\s*(\d+)\s*", part) or re.fullmatch(r"\s*(\d+)\s*", part)
            if not m:
                continue
            a = int(m.group(1)); b = int(m.group(2)) if m.lastindex == 2 else a
            out += self.rows[a - 1:b]
        return out

    async def act(self, req: ActionRequest) -> ActionResult:
        a, rid = req.args or {}, req.action_id
        if req.action in ("cdp_navigate", "navigate"):
            self.epoch += 1
            return ActionResult(rid, True, "OK", "navigated", True, self.epoch)
        if req.action == "select_rows":
            self.selected = {r["id"] for r in self._pick(str(a.get("rows", "")))}
            return ActionResult(rid, True, "OK", f"selected {len(self.selected)}", True, self.epoch)
        if req.action in ("check", "uncheck"):
            nid = int(str(req.target).split(":")[1])
            if nid not in self.node_ids:
                return ActionResult(rid, False, "STALE_EPOCH", "CDP DOM.resolveNode: No node with given id found", False, self.epoch)
            (self.selected.add if req.action == "check" else self.selected.discard)(nid)
            return ActionResult(rid, True, "OK", req.action, True, self.epoch)
        if req.action == "toolbar_action":
            gone = [r for r in self.rows if r["id"] in self.selected]
            self.rows = [r for r in self.rows if r["id"] not in self.selected]
            self.deleted += [r["text"] for r in gone]
            self.node_ids -= {r["id"] for r in gone}
            self.selected.clear(); self.epoch += 1
            return ActionResult(rid, True, "OK", f"deleted {len(gone)}", True, self.epoch, data={"selected_texts": [r["text"] for r in gone]})
        return ActionResult(rid, False, "UNSUPPORTED", req.action)


def gmail_policy():
