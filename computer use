fn do_key(s: &str) -> Result<(), String> { input::win::chord(s) }
#[cfg(not(windows))]
fn do_key(s: &str) -> Result<(), String> { input::parse_chord(s).map(|_| ()) }
#[cfg(windows)]
fn do_type(s: &str) -> Result<(), String> { input::win::type_text(s) }
#[cfg(not(windows))]
fn do_type(_s: &str) -> Result<(), String> { Err("input injection is Windows-only".into()) }
