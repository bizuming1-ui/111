function Invoke-V10Command([string]$Line) {
    $parts = @(($Line.Trim() -split '\s+', 3)); $sub = if ($parts.Count -gt 1) { $parts[1].ToLower() } else { 'status' }; $rest = if ($parts.Count -gt 2) { $parts[2] } else { '' }
    switch ($sub) {
        'status' { Write-Host (Get-V10BannerLine) -ForegroundColor Cyan; Write-Host (Get-V10StatsLine) -ForegroundColor DarkGray }
        'regress' { [void](Invoke-V10Regression) }
        'extract' { $x = Export-V10Workspace $rest; Write-Host "已释放 $($x.Files) 个文件 → $($x.Dir)" -ForegroundColor Green }
        'up' { Invoke-V10Up $rest }
        'verify' { $x = Export-V10Workspace ''; $py = $(if (Get-Command python3 -ErrorAction SilentlyContinue) { 'python3' } else { 'python' }); & $py (Join-Path $x.Dir 'tests/verify_v10.py') }
        'key' { if (-not $rest) { Write-Host '用法：v10 key <键序列>，例如  v10 key #' -ForegroundColor Yellow } else { try { Write-Host (Resolve-KeyChord $rest) -ForegroundColor Green } catch { Write-Host $_.Exception.Message -ForegroundColor Red } } }
        'quota' { if (-not $rest) { Write-Host '用法：v10 quota <任务文本>' -ForegroundColor Yellow } else { $qq = New-V92Quota $rest; if ($qq) { Write-Host (Format-V92Quota $qq) -ForegroundColor Green; Write-Host "允许的勾选数: $((@(Get-V92AllowedCounts $qq)) -join ' / ')" -ForegroundColor DarkGray } else { Write-Host '未识别到数量' -ForegroundColor DarkGray } } }
        'cli' {
            if ($rest -match '^(?i)list') { Write-Host (Invoke-V10CliList) -ForegroundColor Cyan }
            elseif ($rest -match '^(?i)route\s+(.+)$') { $t = Get-V10CliRoute $Matches[1]; Write-Host $(if ($t) { "Layer 0 命中：$($t.Name)（$($t.Kind)）" } else { '未命中 Layer 0，走 GUI 层 L1~L4' }) -ForegroundColor Cyan }
            else { Write-Host '用法：v10 cli list | v10 cli route <任务文本>' -ForegroundColor Yellow }
        }
        'zone' { foreach ($z in @($script:V10.ZoneMap)) { Write-Host ("  {0} 「{1}」 visible={2} covered={3} @({4},{5})" -f $z.Tag, $z.Name, $z.Visible, $z.Covered, $z.cx, $z.cy) } ; if (@($script:V10.ZoneMap).Count -eq 0) { Write-Host '（当前无 Zone 数据：需在 CDP 列表页执行过一步观察）' -ForegroundColor DarkGray } }
        default { Write-Host 'v10 命令：status | regress | extract [目录] | up [skiptests] [sign] | verify | key <键> | quota <文本> | cli list|route <文本> | zone' -ForegroundColor Yellow }
    }
}
