"""Zero-trust path policy with Intent-Scoped Path Grants.

v10 log task #1: the user said "保存在桌面" but the jail only knew the per-task workspace, so every legitimate
verification (`Get-ChildItem C:\\Users\\..\\Desktop`) came back [SECURITY_AST_VIOLATION path_violation outside_workspace]
and 60 steps were burnt.  Fix: grants are derived ONLY from the user's own task text (never from observations / web
pages / tool output), are exact known-folder roots, carry only read+write (never delete/exec), and the sensitive-path
deny-list is evaluated BEFORE any grant.
"""
from __future__ import annotations

import os
import re
from dataclasses import dataclass, field
from pathlib import Path

FORBIDDEN_EXT = {".exe", ".dll", ".bat", ".cmd", ".ps1", ".psm1", ".vbs", ".vbe", ".js", ".jse", ".wsf", ".msi",
                 ".scr", ".lnk", ".com", ".hta", ".reg", ".cpl", ".pif", ".jar"}
RESERVED = {"con", "prn", "aux", "nul", *(f"com{i}" for i in range(1, 10)), *(f"lpt{i}" for i in range(1, 10))}

SENSITIVE = [
    ("windows_dir", re.compile(r"(?i)^[a-z]:[\\/]Windows([\\/]|$)")),
    ("program_files", re.compile(r"(?i)^[a-z]:[\\/]Program Files( \(x86\))?([\\/]|$)")),
    ("program_data", re.compile(r"(?i)^[a-z]:[\\/]ProgramData([\\/]|$)")),
    ("system32", re.compile(r"(?i)[\\/]System32([\\/]|$)")),
    ("user_appdata", re.compile(r"(?i)^[a-z]:[\\/]Users[\\/][^\\/]+[\\/]AppData([\\/]|$)")),
    ("user_secret_dir", re.compile(r"(?i)[\\/]\.(ssh|aws|azure|kube|gnupg|docker|config)([\\/]|$)")),
    ("user_hive", re.compile(r"(?i)NTUSER\.DAT")),
    ("credential_file", re.compile(r"(?i)(^|[\\/])(id_rsa|id_ed25519|id_ecdsa|\.git-credentials|\.netrc|\.npmrc|\.pypirc|"
                                   r"ntds\.dit|Login Data|Cookies|Web Data|Local State|credentials\.json|secrets\.json)(\.pub)?$")),
    ("key_material", re.compile(r"(?i)\.(pfx|p12|ppk|kdbx|keystore|jks)$")),
    ("posix_system", re.compile(r"^/(etc|proc|sys|boot|root|var/lib|usr/bin|usr/sbin|bin|sbin)([/]|$)")),
]

# task keyword -> known-folder key (Chinese substring match; English with word boundaries)
INTENT_FOLDERS: dict[str, tuple[str, ...]] = {
    "desktop": ("桌面", "desktop"),
    "documents": ("文档", "我的文档", "documents"),
    "downloads": ("下载", "downloads"),
    "pictures": ("图片", "pictures"),
    "music": ("音乐", "music"),
    "videos": ("视频", "videos"),
}
_GUIDS = {
    "desktop": "B4BFCC3A-DB2C-424C-B029-7FE99A87C641",
    "documents": "FDD39AD0-238F-46AF-ADB4-6C85480369C7",
    "downloads": "374DE290-123F-4565-9164-39C4925E467B",
    "pictures": "33E28130-4E1E-4676-835A-98395C3BC3BB",
    "music": "4BD8D571-6D19-48D3-BE97-422220080E43",
    "videos": "18989B1D-99B5-455B-841C-AB7C74E4DDFC",
}


class SecurityDenied(Exception):
    code = "SECURITY_DENIED"

    def __init__(self, reason: str, detail: str = ""):
        super().__init__(f"SECURITY_DENIED[{reason}] {detail}".strip())
        self.reason = reason


def known_folder(key: str) -> Path | None:
    """Real shell location (OneDrive-redirect aware on Windows via SHGetKnownFolderPath)."""
    if os.name == "nt":
        try:
            import ctypes
            from ctypes import wintypes

            class GUID(ctypes.Structure):
                _fields_ = [("a", wintypes.DWORD), ("b", wintypes.WORD), ("c", wintypes.WORD), ("d", ctypes.c_ubyte * 8)]

            import uuid
            u = uuid.UUID(_GUIDS[key])
            g = GUID(u.time_low, u.time_mid, u.time_hi_version, (ctypes.c_ubyte * 8)(*u.bytes[8:]))
            out = ctypes.c_wchar_p()
            if ctypes.windll.shell32.SHGetKnownFolderPath(ctypes.byref(g), 0, None, ctypes.byref(out)) == 0:
                p = Path(out.value)
                ctypes.windll.ole32.CoTaskMemFree(out)
                return p
        except Exception:
            pass
    p = Path.home() / key.capitalize()
    return p


@dataclass(frozen=True)
class Grant:
    root: str
    ops: tuple[str, ...] = ("read", "write")
    reason: str = ""


@dataclass
class SecurityPolicy:
    workspace: str
    folders: dict[str, str] | None = None          # injectable for tests: key -> absolute path
    grants: list[Grant] = field(default_factory=list)
    events: list[dict] = field(default_factory=list)

    # ---- grants -------------------------------------------------------------------------------------------
    def _folder(self, key: str) -> str | None:
        if self.folders is not None:
            return self.folders.get(key)
        p = known_folder(key)
        return str(p) if p else None

    def folder_for(self, key: str) -> str | None:
        return self._folder(key)

    def grant_from_intent(self, task_text: str) -> list[Grant]:
        """Called once at task init with the USER's text. Idempotent. Returns the newly added grants."""
        added: list[Grant] = []
        low = task_text.lower()
        for key, words in INTENT_FOLDERS.items():
            hit = any((w in task_text) if re.search(r"[\u4e00-\u9fff]", w) else re.search(rf"\b{re.escape(w)}\b", low)
                      for w in words)
            if not hit:
                continue
            root = self._folder(key)
            if not root:
                continue
            real = os.path.realpath(root)
            if self._sensitive(real):
                continue
            g = Grant(real, ("read", "write"), f"user intent mentions {words[0]}")
            if g not in self.grants:
                self.grants.append(g); added.append(g)
                self.events.append({"event": "grant", "root": real, "ops": g.ops, "why": g.reason})
        return added

    def grant_from_observation(self, text: str) -> list[Grant]:
        """Observations / web pages / tool output can NEVER widen privileges (prompt-injection firewall)."""
        self.events.append({"event": "grant_refused", "source": "observation", "text": text[:80]})
        return []

    # ---- checks -------------------------------------------------------------------------------------------
    @staticmethod
    def _sensitive(full: str) -> str | None:
        norm = full.replace("\\", "/")
        for name, rx in SENSITIVE:
            if rx.search(full) or rx.search(norm):
                return name
        return None

    @staticmethod
    def _inside(child: str, root: str) -> bool:
        c, r = os.path.normcase(os.path.realpath(child)), os.path.normcase(os.path.realpath(root))
        return c == r or c.startswith(r.rstrip("\\/") + os.sep)

    def check(self, path: str, op: str = "write") -> Path:
        if not path or "\x00" in path:
            raise SecurityDenied("empty_or_nul", repr(path))
        if re.search(r"(^|[\\/])\.\.([\\/]|$)", path):
            raise SecurityDenied("traversal", path)
        if re.match(r"^[\\/]{2}", path) or re.match(r"(?i)^[a-z]:[\\/]{2}[?.]", path):
            raise SecurityDenied("unc_or_device", path)
        tail = path[2:] if re.match(r"^[A-Za-z]:", path) else path
        if ":" in tail:
            raise SecurityDenied("alternate_data_stream", path)
        if re.search(r"[*?<>|\"]", path):
            raise SecurityDenied("wildcard_or_illegal_char", path)
        stem = re.split(r"[\\/]", path)[-1].split(".")[0].strip().lower()
        if stem in RESERVED:
            raise SecurityDenied("reserved_device_name", path)
        if op not in ("read", "write", "delete", "exec"):
            raise SecurityDenied("unknown_op", op)
        base = Path(self.workspace)
        p = Path(path)
        full = os.path.realpath(p if p.is_absolute() else base / p)   # follows symlinks / junctions
        sens = self._sensitive(full)
        if sens:
            raise SecurityDenied("sensitive:" + sens, full)
        ext = Path(full).suffix.lower()
        if op in ("write", "exec") and ext in FORBIDDEN_EXT:
            raise SecurityDenied("forbidden_extension", ext)
        if self._inside(full, self.workspace):
            return Path(full)
        for g in self.grants:
            if op in g.ops and self._inside(full, g.root):
                return Path(full)
        raise SecurityDenied("outside_workspace", f"{op} {full}")

    def allowed(self, path: str, op: str = "write") -> bool:
        try:
            self.check(path, op); return True
        except SecurityDenied:
            return False

    def grant_roots(self) -> list[str]:
        return [g.root for g in self.grants]
