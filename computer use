//! Strict single-RPC subtree fetch: IUIAutomationCacheRequest(TreeScope_Subtree) with pre-registered properties and patterns.
use crate::cache_spec::{PATTERN_IDS, PROPERTY_IDS};
use windows::core::Result;
use windows::Win32::Foundation::HWND;
use windows::Win32::System::Com::{CoCreateInstance, CoInitializeEx, CLSCTX_INPROC_SERVER, COINIT_MULTITHREADED};
use windows::Win32::UI::Accessibility::*;

pub fn build_cache_request(a: &IUIAutomation, live_elements: bool) -> Result<IUIAutomationCacheRequest> {
    unsafe {
        let req = a.CreateCacheRequest()?;
        for p in PROPERTY_IDS { req.AddProperty(UIA_PROPERTY_ID(*p))?; }
        for p in PATTERN_IDS { req.AddPattern(UIA_PATTERN_ID(*p))?; }
        req.SetTreeScope(TreeScope_Subtree)?;
        req.SetAutomationElementMode(if live_elements { AutomationElementMode_Full } else { AutomationElementMode_None })?;
        req.SetTreeFilter(&a.ControlViewCondition()?)?;
        Ok(req)
    }
}

fn count(e: &IUIAutomationElement) -> usize {
    unsafe {
        let mut n = 1;
        if let Ok(kids) = e.GetCachedChildren() {
            for i in 0..kids.Length().unwrap_or(0) {
                if let Ok(k) = kids.GetElement(i) { n += count(&k); }
            }
        }
        n
    }
}

/// Number of control-view nodes fetched with exactly ONE cross-process call (used by `-VerifyPhase7` micro-benchmarks).
pub fn cached_subtree_count(hwnd: isize) -> Result<usize> {
    unsafe {
        let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
        let a: IUIAutomation = CoCreateInstance(&CUIAutomation8, None, CLSCTX_INPROC_SERVER)?;
        let req = build_cache_request(&a, false)?;
        let root = a.ElementFromHandleBuildCache(HWND(hwnd as *mut _), &req)?;
        Ok(count(&root))
    }
}
