class Brain:
    workspace: str
    user_home: str | None = None
    taint: TaintedContext = field(default_factory=TaintedContext)
    cli: CliRouter | None = None
    skills: SkillStore | None = None
    ckpt: CheckpointStore | None = None
    router: FiveLayerRouter = field(default_factory=FiveLayerRouter)

    def __post_init__(self):
        os.makedirs(self.workspace, exist_ok=True)
        self.cli = self.cli or CliRouter(self.workspace, self.taint)
        self.skills = self.skills or SkillStore(os.path.join(self.workspace, "skills.jsonl"))
        self.ckpt = self.ckpt or CheckpointStore(os.path.join(self.workspace, "checkpoints"))

    async def run_task(
        self,
        task: str,
        cli_args: list[str] | None = None,
        expect: list[dict] | None = None,
        execute_state_machine: bool = False,
    ) -> dict:
        t0 = time.perf_counter()
        intent_engine = IntentPathGrantEngine.from_user_intent(task, self.workspace, user_home=self.user_home)
        self.cli.intent_engine = intent_engine
        tool = self.cli.route(task)
        dec = self.router.route(
            task,
            cli_hit=tool is not None,
            cdp_up=True,
            uia_controls=None,
            stalled=False,
            blocked_streak=0,
        )
        if dec.layer == 0 and tool and cli_args is not None and tool.kind != "native-safe-file":
            res = await self.cli.run(tool, cli_args, expect)
            self.ckpt.save("last", {"task": task, "layer": 0, "result": res.as_dict()})
            if res.ok:
                self.skills.add(task, [" ".join(cli_args)], "L0")
            return {
                "layer": dec.as_dict(),
                "result": res.as_dict(),
                "intent_granted_roots": [str(p) for p in intent_engine.granted_roots.values()],
                "seconds": round(time.perf_counter() - t0, 3),
                "quota": None,
            }
        if execute_state_machine:
            sm = UnifiedAgentStateMachine(self.workspace, user_home=self.user_home)
            trace = sm.run_deterministic_task(task)
            return {
                "layer": dec.as_dict(),
                "trace": trace,
                "intent_granted_roots": trace["intent_granted_paths"],
                "quota": trace["quota_summary"],
                "seconds": round(time.perf_counter() - t0, 3),
            }
        q = Quota.from_task(task)
        return {
            "layer": dec.as_dict(),
            "intent_granted_roots": [str(p) for p in intent_engine.granted_roots.values()],
            "quota": q.fmt() if q else None,
            "seconds": round(time.perf_counter() - t0, 3),
