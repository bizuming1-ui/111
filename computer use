// Minimal CDP client (Node >= 22 global WebSocket) + isolated browser takeover.
import { spawn } from "node:child_process";
import { existsSync } from "node:fs";

type Json = Record<string, any>;
type Pending = { resolve: (v: any) => void; reject: (e: Error) => void; method: string; timer: NodeJS.Timeout };

export class Cdp {
  private ws!: WebSocket;
  private seq = 0;
  private pending = new Map<number, Pending>();
  private handlers = new Map<string, Array<(p: Json, sessionId?: string) => void>>();
  closed = false;
  onClose?: () => void;

  static async connect(wsUrl: string): Promise<Cdp> {
    const c = new Cdp();
    c.ws = new WebSocket(wsUrl);
    await new Promise<void>((res, rej) => {
      c.ws.addEventListener("open", () => res(), { once: true });
      c.ws.addEventListener("error", () => rej(new Error("CDP websocket error")), { once: true });
    });
    c.ws.addEventListener("message", (ev: MessageEvent) => c.onMessage(String(ev.data)));
    c.ws.addEventListener("close", () => {
      c.closed = true;
      for (const [, p] of c.pending) { clearTimeout(p.timer); p.reject(new Error("CDP closed")); }
      c.pending.clear();
      try { c.onClose?.(); } catch { /* ignore */ }
    });
    return c;
  }

  private onMessage(raw: string) {
    let m: Json;
    try { m = JSON.parse(raw); } catch { return; }
    if (m.id !== undefined) {
      const p = this.pending.get(m.id);
      if (!p) return;
      this.pending.delete(m.id);
      clearTimeout(p.timer);
      if (m.error) p.reject(new Error(`${p.method}: ${m.error.message ?? JSON.stringify(m.error)}`));
      else p.resolve(m.result ?? {});
    } else if (m.method) {
      for (const h of this.handlers.get(m.method) ?? []) { try { h(m.params ?? {}, m.sessionId); } catch { /* handler isolation */ } }
    }
  }

  on(method: string, cb: (p: Json, sessionId?: string) => void) {
    const l = this.handlers.get(method) ?? [];
    l.push(cb);
    this.handlers.set(method, l);
  }

  send(method: string, params: Json = {}, sessionId?: string, timeoutMs = 15000): Promise<any> {
    if (this.closed) return Promise.reject(new Error("CDP closed"));
    const id = ++this.seq;
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => { this.pending.delete(id); reject(new Error(`${method}: timeout ${timeoutMs}ms`)); }, timeoutMs);
      this.pending.set(id, { resolve, reject, method, timer });
      const msg: Json = { id, method, params };
      if (sessionId) msg.sessionId = sessionId;
      this.ws.send(JSON.stringify(msg));
    });
  }

  close() { try { this.ws.close(); } catch { /* ignore */ } }
}

export function findBrowser(): string | null {
  const env = process.env;
  const c = [
    env.DSCU_BROWSER,
    `${env["ProgramFiles"]}\\Google\\Chrome\\Application\\chrome.exe`,
    `${env["ProgramFiles(x86)"]}\\Google\\Chrome\\Application\\chrome.exe`,
    `${env["LocalAppData"]}\\Google\\Chrome\\Application\\chrome.exe`,
    `${env["ProgramFiles(x86)"]}\\Microsoft\\Edge\\Application\\msedge.exe`,
    `${env["ProgramFiles"]}\\Microsoft\\Edge\\Application\\msedge.exe`,
    "/usr/bin/google-chrome", "/usr/bin/chromium", "/usr/bin/chromium-browser",
  ];
  for (const p of c) if (p && existsSync(p)) return p;
  return null;
}

async function version(port: number): Promise<Json | null> {
  try {
    const r = await fetch(`http://127.0.0.1:${port}/json/version`, { signal: AbortSignal.timeout(1200) });
    return r.ok ? ((await r.json()) as Json) : null;
  } catch { return null; }
}

/** Refuse to ever touch the user's MAIN browser profile (cookies / passwords / sync).  Only dedicated automation dirs are allowed. */
const MAIN_PROFILE = /(google[\\/]chrome|microsoft[\\/]edge|bravesoftware[\\/]brave-browser|chromium|vivaldi|opera software)[\\/]+(user data|opera stable)?[\\/]*$|[\\/]\.config[\\/](google-chrome|chromium|microsoft-edge)[\\/]*$/i;
export function isMainBrowserProfile(dir: string): boolean {
  const d = dir.replace(/[\\/]+$/, "");
  return MAIN_PROFILE.test(d + "/") || /user data$/i.test(d) && !/(auth_profile|deepseek|dscu|ephemeral|browser-profile)/i.test(d);
}

/** Isolated takeover: dedicated user-data-dir (required by Chrome >= 136 for remote debugging) + fixed port.
 *  persistent: %LOCALAPPDATA%\\DeepSeekComputerUse\\auth_profile  (log in once, reused)      ephemeral: throw-away temp dir (red-team / sandbox evals). */
export async function ensureBrowser(port: number, profileDir: string): Promise<{ ws: string; browser: string; spawned: boolean; pid: number }> {
  let v = await version(port);
  let spawned = false;
  let pid = 0;
  if (!v) {
    if (isMainBrowserProfile(profileDir)) throw new Error(`refusing to use the main browser profile directory: ${profileDir}`);
    const exe = findBrowser();
    if (!exe) throw new Error("no Chrome/Edge found (set DSCU_BROWSER)");
    const args = [
      `--remote-debugging-port=${port}`, `--user-data-dir=${profileDir}`, "--remote-allow-origins=*",
      "--no-first-run", "--no-default-browser-check", "--force-renderer-accessibility",
      "--disable-features=Translate,MediaRouter", "--disable-background-timer-throttling", "--disable-renderer-backgrounding",
      "--disable-backgrounding-occluded-windows", "--window-size=1400,950", "about:blank",
    ];
    if (process.platform === "linux" && process.env.DSCU_HEADLESS === "1") args.unshift("--headless=new", "--no-sandbox");
    const child = spawn(exe, args, { detached: true, stdio: "ignore" });
    pid = child.pid ?? 0;
    child.unref();
    spawned = true;
    for (let i = 0; i < 60 && !v; i++) { await new Promise((r) => setTimeout(r, 250)); v = await version(port); }
    if (!v) throw new Error(`browser did not expose CDP on :${port}`);
  }
  return { ws: v.webSocketDebuggerUrl as string, browser: String(v.Browser ?? ""), spawned, pid };
}
