        self.rows = [{"thread_id": f"#thread-f:18{7000000000000000 + i * 7919}", "sender": f"sender{i}", "subject": f"subject {i}", "time": f"10:{i:02d}", "checked": False} for i in range(n)]
        self.trash: list = []
        self.faults, self.epoch, self.flaky_done = set(faults), 0, set()
        self.keyboard_ok = "keyboard_disabled" not in self.faults
        self.fired = 0

    def _ident(self, r: dict) -> str:
        return GS.row_business_identity(r)

    async def snapshot(self):
        self.epoch += 1
        rows = []
        for i, r in enumerate(self.rows):
            rows.append({**r, "rect": [10, 120 + i * 40, 900, 36], "row": i + 1})
        if "virtual_tail" in self.faults and len(rows) > 3:
            rows = rows[:-1] if self.epoch % 2 == 0 else rows  # the last row flickers in and out between snapshots (virtualised list)
        tb = [{"name": "删除", "rect": [100, 80, 36, 36], "ref": "btn-del"}] if (any(r["checked"] for r in self.rows) and "toolbar_missing" not in self.faults) else []
        return GS.GmailSnapshot(self.epoch, "https://mail.google.com/mail/u/0/#inbox", rows, tb, True)

    async def tick(self, identity: str, mode: str = "click") -> bool:
        for r in self.rows:
            if self._ident(r) == identity:
                if "flaky_checkbox" in self.faults and mode == "click" and identity not in self.flaky_done:
                    self.flaky_done.add(identity)
                    return True  # driver says OK, nothing happened
                r["checked"] = True
                return True
        return False

    def _delete_checked(self) -> bool:
        sel = [r for r in self.rows if r["checked"]]
        if not sel:
            return False
        self.trash += sel
        self.rows = [r for r in self.rows if not r["checked"]]
        self.fired += 1
        return True

    async def click_trigger(self, name: str, ref: str) -> bool:
        return self._delete_checked()

    async def press_delete(self) -> bool:
        return self._delete_checked() if self.keyboard_ok else False

    async def verify(self, identities: list) -> dict:
        inbox = {self._ident(r) for r in self.rows}
        tr = {self._ident(r) for r in self.trash}
        return {i: {"gone": i not in inbox, "trash": (i in tr)} for i in identities}


