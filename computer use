    if ($script:ObsHwnd -ne [IntPtr]::Zero -and $fg -ne $script:ObsHwnd) {
        throw "前台窗口已变化（观察时 [$([DsNative61]::WinText($script:ObsHwnd))]，现在 [$([DsNative61]::WinText($fg))]），为避免输入到错误窗口已取消，请重新观察。"
