            lastSig48x32 = sig;
            lastDirtyRects = dirtyBlocks;
            if (sw != null) { sw.Stop(); lastCaptureUs = sw.ElapsedTicks * 1000000L / Stopwatch.Frequency; }
            return sig;
        } finally {
            small.UnlockBits(data);
        }
    }

    // 7. LockBits 指针级局部区域采样（替代 Start-EffectProbe / Complete-EffectProbe 的 576 次 GetPixel）
    public static byte[] FastRegionSample(int l, int t, int w, int h, int step) {
        if (w < 8 || h < 8 || step < 1) return null;
        try {
            using (Bitmap bmp = new Bitmap(w, h, PixelFormat.Format24bppRgb)) {
                using (Graphics g = Graphics.FromImage(bmp)) {
                    g.CopyFromScreen(l, t, 0, 0, new Size(w, h), CopyPixelOperation.SourceCopy);
                }
                BitmapData data = bmp.LockBits(new Rectangle(0, 0, w, h), ImageLockMode.ReadOnly, PixelFormat.Format24bppRgb);
                try {
                    int stride = Math.Abs(data.Stride);
                    byte[] raw = new byte[stride * h];
                    Marshal.Copy(data.Scan0, raw, 0, raw.Length);
                    int nx = (w + step - 1) / step;
                    int ny = (h + step - 1) / step;
                    byte[] buf = new byte[nx * ny * 3];
                    int k = 0;
                    for (int y = 0; y < h; y += step) {
                        int rowOff = y * stride;
                        for (int x = 0; x < w; x += step) {
                            int px = rowOff + x * 3;
                            buf[k++] = raw[px + 2]; // R
                            buf[k++] = raw[px + 1]; // G
                            buf[k++] = raw[px];     // B
                        }
                    }
                    return buf;
                } finally {
                    bmp.UnlockBits(data);
                }
            }
        } catch { return null; }
    }

    // 8. Named Pipe IPC 协议帧构建与客户端探测（对接 Rust/C++20 driver-core）
    public static string BuildPipeRpc(int id, string method, string paramsJson) {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"method\":\"" + method + "\",\"params\":" + (string.IsNullOrEmpty(paramsJson) ? "{}" : paramsJson) + "}";
    }

    public static string TryCallNamedPipe(string pipeName, string requestJson, int timeoutMs = 40) {
        if (string.IsNullOrEmpty(pipeName)) return null;
        try {
            using (var client = new NamedPipeClientStream(".", pipeName, PipeDirection.InOut, PipeOptions.Asynchronous)) {
                client.Connect(timeoutMs);
                byte[] reqBytes = Encoding.UTF8.GetBytes(requestJson + "\n");
                client.Write(reqBytes, 0, reqBytes.Length);
                client.Flush();
                using (var sr = new StreamReader(client, Encoding.UTF8, false, 4096, true)) {
                    return sr.ReadLine();
                }
            }
        } catch { return null; }
    }
}
