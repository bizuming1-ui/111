use crate::scancode::Ev;
use std::mem::size_of;
use windows::Win32::UI::Input::KeyboardAndMouse::{
    SendInput, INPUT, INPUT_0, INPUT_KEYBOARD, KEYBDINPUT, KEYBD_EVENT_FLAGS, KEYEVENTF_KEYUP, KEYEVENTF_SCANCODE, KEYEVENTF_UNICODE, VIRTUAL_KEY,
};

fn key(code: u16, flags: KEYBD_EVENT_FLAGS) -> INPUT {
    INPUT { r#type: INPUT_KEYBOARD, Anonymous: INPUT_0 { ki: KEYBDINPUT { wVk: VIRTUAL_KEY(0), wScan: code, dwFlags: flags, time: 0, dwExtraInfo: 0 } } }
}

/// Inject a planned event list with physical scan codes (KEYEVENTF_SCANCODE) / Unicode units. Returns events accepted by the OS.
pub fn send_events(evs: &[Ev]) -> u32 {
    let inputs: Vec<INPUT> = evs
        .iter()
        .map(|e| match *e {
            Ev::Scan { code, up } => key(code, KEYEVENTF_SCANCODE | if up { KEYEVENTF_KEYUP } else { KEYBD_EVENT_FLAGS(0) }),
            Ev::Unicode { unit, up } => key(unit, KEYEVENTF_UNICODE | if up { KEYEVENTF_KEYUP } else { KEYBD_EVENT_FLAGS(0) }),
        })
        .collect();
    if inputs.is_empty() {
        return 0;
    }
    unsafe { SendInput(&inputs, size_of::<INPUT>() as i32) }
}
