"""Uncertainty-adaptive routing for UNKNOWN software (v12) — no per-app rules, only observation entropy + action-effect ratio.

  U = 0.6 * (1 - effect_ratio) + 0.4 * blind(inter)      blind = max(0, 1 - inter/6)
  inter < 6                      -> UIA blind spot  -> vision (local GPU if sidecar up & UMA healthy, else cloud flash)
  zero-pixel streak >= 2         -> vision relocation
  zero-pixel streak >= 4 or U>=.8-> keyboard exploration (Tab / accelerators / Ctrl+F) alongside vision
"""
from __future__ import annotations

import math
from collections import deque
from dataclasses import dataclass, field

UIA_BLIND_THRESHOLD = 6


def shannon(p: float) -> float:
    if p <= 0.0 or p >= 1.0:
        return 0.0
    return -(p * math.log2(p) + (1 - p) * math.log2(1 - p))


@dataclass
class RouteDecision:
    route: str            # normal | vision_local | vision_cloud | keyboard_explore
    reason: str
    uncertainty: float
    effect_ratio: float
    entropy_bits: float
    zero_streak: int


@dataclass
class EntropyRouter:
    window: int = 6
    effects: deque = field(default_factory=lambda: deque(maxlen=6))
    zero_streak: int = 0
    switches: int = 0
    last: str = "normal"

    def record(self, effective: bool) -> None:
        self.effects.append(1 if effective else 0)
        self.zero_streak = 0 if effective else self.zero_streak + 1

    def effect_ratio(self) -> float:
        return 1.0 if not self.effects else sum(self.effects) / len(self.effects)

    def route(self, inter: int, *, uma_tripped: bool = False, local_up: bool = False, zero_streak: int | None = None) -> RouteDecision:
        zs = self.zero_streak if zero_streak is None else zero_streak
        p = self.effect_ratio() if zero_streak is None else (0.0 if zs >= 2 else 1.0)
        blind = max(0.0, 1.0 - inter / UIA_BLIND_THRESHOLD)
        u = round(0.6 * (1 - p) + 0.4 * blind, 3)
        vision = "vision_local" if (local_up and not uma_tripped) else "vision_cloud"
        if zs >= 4 or u >= 0.8:
            r, why = "keyboard_explore", f"zero_pixel_streak={zs} U={u}"
        elif inter < UIA_BLIND_THRESHOLD:
            r, why = vision, f"uia_blind inter={inter}<{UIA_BLIND_THRESHOLD}"
        elif zs >= 2:
            r, why = vision, f"zero_pixel_streak={zs}"
        else:
            r, why = "normal", "observable"
        if r != self.last:
            self.switches += 1
            self.last = r
        return RouteDecision(r, why, u, round(p, 3), round(shannon(p), 3), zs)
