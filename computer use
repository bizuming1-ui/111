// Minimal CDP client (Node >= 22 global WebSocket; zero npm runtime dependencies) + Wait-CdpSettled network tracker.
import { PErr, sleep } from "./protocol.js";

type Pending = { resolve: (v: any) => void; reject: (e: Error) => void; timer: NodeJS.Timeout; method: string };

export class CdpSession {
  private ws!: WebSocket;
  private seq = 0;
  private pending = new Map<number, Pending>();
  private listeners = new Map<string, Set<(p: any) => void>>();
  closed = false;

  static async connect(url: string): Promise<CdpSession> {
    const s = new CdpSession();
    await new Promise<void>((resolve, reject) => {
      const ws = new WebSocket(url);
      s.ws = ws;
      const t = setTimeout(() => reject(new PErr("TIMEOUT", "CDP websocket connect timeout")), 8000);
      ws.onopen = () => { clearTimeout(t); resolve(); };
      ws.onerror = () => { clearTimeout(t); reject(new PErr("INTERNAL", "CDP websocket error")); };
      ws.onmessage = (ev: MessageEvent) => s.onMessage(String(ev.data));
      ws.onclose = () => {
        s.closed = true;
        for (const [, p] of s.pending) { clearTimeout(p.timer); p.reject(new PErr("INTERNAL", "CDP socket closed")); }
        s.pending.clear();
      };
    });
    return s;
  }

  private onMessage(raw: string) {
    let m: any;
    try { m = JSON.parse(raw); } catch { return; }
    if (m.id !== undefined) {
      const p = this.pending.get(m.id);
      if (!p) return;
      this.pending.delete(m.id);
      clearTimeout(p.timer);
      if (m.error) p.reject(new PErr("INTERNAL", `${p.method}: ${m.error.message ?? "error"}`, m.error));
      else p.resolve(m.result);
    } else if (m.method) {
      this.listeners.get(m.method)?.forEach((fn) => { try { fn(m.params); } catch { /* listener errors never break the pump */ } });
    }
  }

  send<T = any>(method: string, params: object = {}, timeoutMs = 15000): Promise<T> {
    if (this.closed) return Promise.reject(new PErr("INTERNAL", "CDP session closed"));
    const id = ++this.seq;
    return new Promise<T>((resolve, reject) => {
      const timer = setTimeout(() => { this.pending.delete(id); reject(new PErr("TIMEOUT", `${method} timed out after ${timeoutMs}ms`)); }, timeoutMs);
      this.pending.set(id, { resolve, reject, timer, method });
      this.ws.send(JSON.stringify({ id, method, params }));
    });
  }

  on(ev: string, fn: (p: any) => void) {
    if (!this.listeners.has(ev)) this.listeners.set(ev, new Set());
    this.listeners.get(ev)!.add(fn);
  }

  close() { try { this.ws.close(); } catch { /* ignore */ } }
}

/** Counts in-flight requests the way a human perceives "page is still loading": long-lived streams don't count. */
export class NetTracker {
  private live = new Map<string, { t: number; type: string }>();
  lastActivity = Date.now();
  sawNetwork = false;

  constructor(s: CdpSession) {
    s.on("Network.requestWillBeSent", (p) => {
      this.live.set(p.requestId, { t: Date.now(), type: String(p.type ?? "") });
      this.lastActivity = Date.now();
      this.sawNetwork = true;
    });
    const done = (p: any) => { this.live.delete(p.requestId); this.lastActivity = Date.now(); };
    s.on("Network.loadingFinished", done);
    s.on("Network.loadingFailed", done);
    s.on("Network.webSocketCreated", (p) => this.live.delete(p.requestId));
    s.on("Network.eventSourceMessageReceived", (p) => this.live.delete(p.requestId));
  }

  inflight(): number {
    const now = Date.now();
    let n = 0;
    for (const [id, r] of this.live) {
      if (["WebSocket", "EventSource", "Ping", "Media", "CSPViolationReport"].includes(r.type)) continue;
      if (now - r.t > 10000) { this.live.delete(id); continue; } // long-poll / beacon: evicted
      n++;
    }
    return n;
  }
}

export interface SettleResult { settled: boolean; ms: number; inflight: number; ready_state: string }

/** Wait-CdpSettled: readyState==='complete' AND in-flight==0 AND quiet window (250ms after network, 120ms pure UI). */
export async function waitSettled(s: CdpSession, net: NetTracker, opts: { timeoutMs?: number; quietNetMs?: number; quietUiMs?: number; pollMs?: number } = {}): Promise<SettleResult> {
  const { timeoutMs = 5000, quietNetMs = 250, quietUiMs = 120, pollMs = 80 } = opts;
  const t0 = Date.now();
  let rs = "unknown";
  for (;;) {
    try {
      const r = await s.send("Runtime.evaluate", { expression: "document.readyState", returnByValue: true }, 3000);
      rs = String(r?.result?.value ?? "unknown");
    } catch { rs = "unknown"; }
    const quiet = Date.now() - net.lastActivity;
    const need = net.sawNetwork ? quietNetMs : quietUiMs;
    if (rs === "complete" && net.inflight() === 0 && quiet >= need) {
      return { settled: true, ms: Date.now() - t0, inflight: 0, ready_state: rs };
    }
    if (Date.now() - t0 >= timeoutMs) return { settled: false, ms: Date.now() - t0, inflight: net.inflight(), ready_state: rs };
    await sleep(pollMs);
  }
}
