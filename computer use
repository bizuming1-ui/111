import difflib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import unicodedata
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Callable, Iterable, Optional

IS_WIN = sys.platform == "win32"
RECYCLE_CLSID = "645ff040-5081-101b-9f08-00aa002f954e"
VIEW_TITLES = {"recyclebin": ("回收站", "recycle bin"), "desktop": ("桌面", "desktop"), "downloads": ("下载", "downloads"), "documents": ("文档", "documents")}
NOISE = re.compile(r"^的|的$|^(?:那个|这个|那份|这份|那条|这条)|(?:的)?(?:文件夹|文件|文档|记事本|文本)$|(?:txt)$|桌面上的|桌面里的|桌面上|桌面里|回收站里面|回收站里|回收站中|回收站内|回收站", re.I)
GENERIC = {"", "文件", "东西", "它", "他", "这个", "那个", "全部", "所有", "一个", "文档", "file", "files", "it", "this", "that"}


# ================================================================================ helpers
def norm(s: str) -> str:
    return unicodedata.normalize("NFKC", str(s or "")).strip().strip("“”\"'「」『』").lower()


def stem_of(name: str) -> str:
    n = norm(name)
    return n.rsplit(".", 1)[0] if re.search(r"\.[a-z0-9]{1,6}$", n) else n


def _score(query: str, name: str) -> float:
    """0..1 similarity of a spoken/typed file reference to a real file name (no LLM, deterministic)."""
    q, full = norm(query), norm(name)
    st = stem_of(name)
    if not q:
        return 0.0
    if q == full:
        return 1.0
    if q == st:
        return 0.99
    if st.startswith(q) or q.startswith(st) and len(st) >= 2:
        return 0.93
    if q in st:
        return 0.88
    if st and st in q and len(st) >= 2:
        return 0.86
    r = difflib.SequenceMatcher(None, q, st).ratio()
    return round(r * 0.84, 3) if r >= 0.85 else 0.0


def clean_reference(raw: str) -> str:
    """'相机文件' / '桌面上的相机' / '相机.txt' -> '相机' (keeps an explicit extension when the user typed one)."""
    s = norm(raw)
    m = re.search(r"([^\s\\/:*?\"<>|，,。；;]+\.[a-z0-9]{1,6})\b", s)
    if m:
        return m.group(1)
    s = NOISE.sub("", s)
    s = re.sub(r"[，,。；;！!？?\s]+", "", s)
    return s


# ================================================================================ data model
@dataclass
class BinItem:
    name: str  # full display name incl. extension (e.g. 相机.txt)
    original: str = ""  # original full path (folder + name) if the shell exposes it
    bin_path: str = ""  # backing `$R….ext` path inside C:\$Recycle.Bin\<SID>\
    size: int = 0
    deleted: str = ""
    is_dir: bool = False

    @property
    def stem(self) -> str:
        return stem_of(self.name)

    def brief(self) -> str:
        return f"{self.name}（原位置 {self.original or '未知'}；{self.size}B；删除于 {self.deleted or '?'}）"


@dataclass
class FindResult:
    status: str  # unique | ambiguous | suggest | none
    items: list[BinItem] = field(default_factory=list)
    query: str = ""
    scores: list[float] = field(default_factory=list)

    @property
    def item(self) -> Optional[BinItem]:
        return self.items[0] if self.status == "unique" and self.items else None


@dataclass
class ShellWin:
    hwnd: int = 0
    name: str = ""
    url: str = ""
    path: str = ""
    cls: str = ""
    visible: bool = False
    process: str = ""


