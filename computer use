                if RegEnumKeyExW(k, i, PWSTR(name.as_mut_ptr()), &mut len, None, PWSTR::null(), None, None) != ERROR_SUCCESS { break; }
                let mut sk = HKEY::default();
                if RegOpenKeyExW(k, PCWSTR(name.as_ptr()), 0, KEY_READ, &mut sk) == ERROR_SUCCESS { out.push((s16(&name), sk)); }
