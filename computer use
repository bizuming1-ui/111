"""Async NDJSON IPC client. Transports: pipe://NAME (Windows Proactor overlapped pipe - cancellable, no thread parking),
tcp://host:port and unix://path (dev / CI). One in-flight request per connection, request-order responses, auto-reconnect,
per-call latency telemetry (the P50/P99 lines in the run report come from here, not from guesses)."""
from __future__ import annotations

import asyncio
import json
import sys
import time
from typing import Any

from .protocol import ObservationEnvelope, ProtocolError, parse_action_result, parse_observation, ActionRequest, ActionResult


class IpcError(Exception):
    def __init__(self, code: str, message: str, retryable: bool = False, data: Any = None):
        super().__init__(f"[{code}] {message}")
        self.code, self.message, self.retryable, self.data = code, message, retryable, data


class _LineProto(asyncio.Protocol):
    def __init__(self) -> None:
        self.buf = bytearray()
        self.q: asyncio.Queue[bytes | None] = asyncio.Queue()
        self.transport: asyncio.BaseTransport | None = None

    def connection_made(self, transport: asyncio.BaseTransport) -> None:
        self.transport = transport

    def data_received(self, data: bytes) -> None:
        self.buf.extend(data)
        while True:
            i = self.buf.find(b"\n")
            if i < 0:
                break
            line = bytes(self.buf[:i])
            del self.buf[: i + 1]
            self.q.put_nowait(line)

    def connection_lost(self, exc: Exception | None) -> None:
        self.q.put_nowait(None)


def percentile(vals: list[float], p: float) -> float:
    if not vals:
        return 0.0
    s = sorted(vals)
    return s[min(len(s) - 1, max(0, round((len(s) - 1) * p)))]


class IpcClient:
    def __init__(self, address: str, name: str = "ipc") -> None:
        self.address, self.name = address, name
        self._next = 0
        self._lock = asyncio.Lock()
        self._proto: _LineProto | None = None
        self._writer: asyncio.StreamWriter | None = None
        self._reader: asyncio.StreamReader | None = None
        self.latencies: dict[str, list[float]] = {}

    async def connect(self, retries: int = 40, delay: float = 0.15) -> None:
        last: Exception | None = None
        for _ in range(retries):
            try:
                await self._open()
                return
            except (OSError, FileNotFoundError, asyncio.TimeoutError) as e:
                last = e
                await asyncio.sleep(delay)
        raise IpcError("INTERNAL", f"cannot connect to {self.address}: {last}")

    async def _open(self) -> None:
        kind, _, rest = self.address.partition("://")
        loop = asyncio.get_running_loop()
        if kind == "pipe":
            if sys.platform != "win32":
                raise OSError("pipe:// transport needs Windows")
            path = rest if rest.startswith("\\\\") else "\\\\.\\pipe\\" + rest
            _, self._proto = await loop.create_pipe_connection(_LineProto, path)  # type: ignore[attr-defined]
        elif kind == "tcp":
            host, _, port = rest.partition(":")
            self._reader, self._writer = await asyncio.open_connection(host, int(port), limit=16 << 20)
        elif kind == "unix":
            self._reader, self._writer = await asyncio.open_unix_connection(rest, limit=16 << 20)
        else:
            raise ValueError(f"unknown transport {self.address}")

    async def close(self) -> None:
        if self._writer:
            self._writer.close()
        if self._proto and self._proto.transport:
            self._proto.transport.close()
        self._writer = self._reader = self._proto = None

    @property
    def connected(self) -> bool:
        return self._writer is not None or self._proto is not None

    async def _roundtrip(self, frame: bytes, timeout: float) -> bytes:
        if self._proto is not None:
            assert self._proto.transport is not None
            self._proto.transport.write(frame)  # type: ignore[attr-defined]
            line = await asyncio.wait_for(self._proto.q.get(), timeout)
        else:
            assert self._writer is not None and self._reader is not None
            self._writer.write(frame)
            await self._writer.drain()
            line = await asyncio.wait_for(self._reader.readline(), timeout)
        if not line:
            raise ConnectionError("peer closed the connection")
        return line

    async def call(self, kind: str, req: dict[str, Any] | None = None, timeout: float = 30.0) -> dict[str, Any]:
        async with self._lock:
            if not self.connected:
                await self.connect(retries=8)
            self._next += 1
            fid = self._next
            frame = (json.dumps({"v": 1, "id": fid, "kind": kind, "req": req or {}}, ensure_ascii=False) + "\n").encode("utf-8")
            t0 = time.perf_counter()
            try:
                line = await self._roundtrip(frame, timeout)
            except (ConnectionError, OSError, asyncio.TimeoutError) as e:
                await self.close()  # a timed-out connection is desynchronised: drop it, reconnect on next call
                raise IpcError("TIMEOUT" if isinstance(e, asyncio.TimeoutError) else "INTERNAL", f"{self.name} {kind}: {e!r}", retryable=True) from e
            dt = (time.perf_counter() - t0) * 1000
            self.latencies.setdefault(kind, []).append(dt)
            try:
                resp = json.loads(line)
            except json.JSONDecodeError as e:
                raise ProtocolError(f"{self.name}: non-JSON frame: {line[:80]!r}") from e
            if resp.get("id") != fid:
                await self.close()
                raise ProtocolError(f"{self.name}: response id {resp.get('id')} != request id {fid} (desync)")
            if not resp.get("ok"):
                err = resp.get("error") or {}
                raise IpcError(err.get("code", "INTERNAL"), err.get("message", "error"), bool(err.get("retryable")), err.get("data"))
            return resp.get("result") or {}

    # ── typed helpers ──
    async def ping(self) -> dict[str, Any]:
        return await self.call("ping", timeout=3)

    async def info(self) -> dict[str, Any]:
        return await self.call("info", timeout=5)

    async def observe(self, req: dict[str, Any] | None = None, timeout: float = 30.0) -> ObservationEnvelope:
        return parse_observation(await self.call("observe", req, timeout))

    async def act(self, a: ActionRequest, timeout: float = 45.0) -> ActionResult:
        return parse_action_result(await self.call("action", a.model_dump(exclude_none=True), timeout))

    def stats(self) -> dict[str, dict[str, float]]:
        return {k: {"n": len(v), "p50": percentile(v, 0.5), "p99": percentile(v, 0.99)} for k, v in self.latencies.items()}
