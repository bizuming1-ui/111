    fn m_capture(&self, method: &str, p: &Value) -> Result<Value, RpcError> {
        let scr = self.platform.screen_rect();
        let r = region(p, scr);
        let max_px = self.st.lock().unwrap().mem.max_capture_pixels();
        if (r.w.max(0) as u64) * (r.h.max(0) as u64) > max_px {
            return Err(RpcError::new(ErrKind::MemoryFloor, format!("region {}x{} exceeds the {} px cap (UMA memory guard)", r.w, r.h, max_px)));
        }
        let timeout = pi(p, "timeoutMs").unwrap_or(16).clamp(0, 2000) as u32;
        let f = self.platform.capture_frame(r, timeout, method == "capture.frame").map_err(map_perr)?;
        let ah = ahash_hex(&f.sig).unwrap_or_default();
        let dirty: Vec<Value> = f.dirty_rects.iter().map(|d| json!(d)).collect();
        match method {
            "capture.frame" => Ok(json!({
                "section": f.section, "width": f.width, "height": f.height, "stride": f.stride, "format": "bgra8",
                "backend": f.backend, "fresh": f.fresh, "dirty_rects": dirty, "dirty_count": f.dirty_rects.len(), "move_rects": f.move_rects,
                "ahash": ah, "acquire_us": f.acquire_us, "readback_us": f.readback_us
            })),
            "capture.signature" => Ok(json!({ "sig_b64": b64_encode(&f.sig), "ahash": ah, "width": f.width, "height": f.height, "dirty_count": f.dirty_rects.len(),
                "backend": f.backend, "acquire_us": f.acquire_us, "readback_us": f.readback_us })),
            _ => Ok(json!({ "ahash": ah, "backend": f.backend })),
        }
    }

    fn m_bench(&self, p: &Value) -> Result<Value, RpcError> {
        let n = pi(p, "n").unwrap_or(200).clamp(1, 2000) as usize;
        let scr = self.platform.screen_rect();
        let r = Rect { x: 0, y: 0, w: pi(p, "w").unwrap_or(scr.w as i64).clamp(16, scr.w as i64) as i32, h: pi(p, "h").unwrap_or(scr.h as i64).clamp(16, scr.h as i64) as i32 };
        let publish = pb(p, "publish");
        let (mut tot, mut acq, mut backend) = (Vec::with_capacity(n), Vec::with_capacity(n), String::new());
        for _ in 0..n {
            let t = Instant::now();
            let f = self.platform.capture_frame(r, 16, publish).map_err(map_perr)?;
            tot.push(t.elapsed().as_secs_f64() * 1000.0);
            acq.push((f.acquire_us + f.readback_us) as f64 / 1000.0);
            backend = f.backend;
        }
        let mean = tot.iter().sum::<f64>() / n as f64;
        Ok(json!({ "n": n, "region": [r.w, r.h], "backend": backend, "p50_ms": percentile(&tot, 50.0), "p99_ms": percentile(&tot, 99.0), "mean_ms": (mean * 100.0).round() / 100.0,
            "gpu_p50_ms": percentile(&acq, 50.0), "gpu_p99_ms": percentile(&acq, 99.0) }))
    }

    fn m_snapshot(&self, p: &Value) -> Result<Value, RpcError> {
        let t0 = Instant::now();
        let skeleton = pb(p, "skeleton");
        let depth_req = pi(p, "depth").map(|d| d.clamp(0, 12) as usize);
        let depth = if skeleton || depth_req.is_some() { Some(depth_req.unwrap_or(3)) } else { None };
        let include_off = pb(p, "include_offscreen");
        if let Some(r) = ps(p, "root") {
            let (sid, n) = parse_ref(r)?;
            let live = self.platform.windows();
            let st = self.st.lock().unwrap();
            let snap = st.store.get(&sid).ok_or_else(|| RpcError::new(ErrKind::StaleRef, format!("snapshot {sid} expired or unknown")).with_data(json!({ "reason": "snapshot_expired" })))?;
            let w = validate_window(snap, &live)?;
            let rendered = snap.render(Some(n), depth)?;
            let full = snap.render(Some(n), None)?;
            return Ok(Self::snapshot_json(snap, &w.brief(), &rendered, full.tokens, t0.elapsed().as_secs_f64() * 1000.0, Some(n)));
        }
        let sel = Selector { window_id: pi(p, "window_id"), app: ps(p, "app").map(String::from), title: ps(p, "title").map(String::from) };
        let wins = self.platform.windows();
        let w = select_window(&sel, &wins, self.platform.foreground())?;
        let mut max_nodes = pi(p, "max_nodes").unwrap_or(5000).clamp(50, 20000) as usize;
        if self.st.lock().unwrap().mem.tripped {
            max_nodes = max_nodes.min(1500);
        }
        let raw = self.platform.scan_window(&w, max_nodes).map_err(map_perr)?;
        let scan_ms = t0.elapsed().as_secs_f64() * 1000.0;
        let mut st = self.st.lock().unwrap();
        let id = st.store.new_id(w.window_id as u64 ^ now_ns());
        let snap = Snapshot::build(id, w.clone(), &raw, max_nodes, include_off, now_ms());
        let rendered = snap.render(None, depth)?;
        let full = if depth.is_some() { snap.render(None, None)?.tokens } else { rendered.tokens };
        let out = Self::snapshot_json(&snap, &w.brief(), &rendered, full, scan_ms, None);
        st.store.insert(snap);
        Ok(out)
    }

    fn snapshot_json(snap: &Snapshot, w: &Value, r: &crate::uia_ref::Rendered, full_tokens: usize, scan_ms: f64, root: Option<u32>) -> Value {
        let compression = if full_tokens > 0 { (100.0 * (1.0 - r.tokens as f64 / full_tokens as f64)).round() } else { 0.0 };
        json!({
            "snapshot_id": snap.id, "window": w, "root": root.map(|n| snap.ref_str(n)), "text": r.text, "source": snap.root.source,
            "nodes_total": snap.total, "nodes_shown": r.nodes_shown, "truncated_containers": r.truncated,
            "tokens_est": r.tokens, "full_tokens_est": full_tokens, "compression_pct": compression,
            "refs": { "first": 1, "last": snap.total }, "scan_ms": (scan_ms * 100.0).round() / 100.0
        })
    }

    fn entry_for(&self, p: &Value) -> Result<(crate::uia_ref::RefEntry, crate::tree::WindowInfo, bool), RpcError> {
        let r = ps(p, "ref").ok_or_else(|| RpcError::new(ErrKind::InvalidParams, "ref required"))?;
        let (sid, n) = parse_ref(r)?;
        let live = self.platform.windows();
        let st = self.st.lock().unwrap();
        let snap = st.store.get(&sid).ok_or_else(|| RpcError::new(ErrKind::StaleRef, format!("snapshot {sid} expired or unknown")).with_data(json!({ "reason": "snapshot_expired" })))?;
        let w = validate_window(snap, &live)?;
        let e = snap.entries.get(&n).cloned().ok_or_else(|| RpcError::new(ErrKind::StaleRef, format!("unknown ref e{n}")).with_data(json!({ "reason": "unknown_ref" })))?;
        let enabled = snap.node(n).map(|x| x.enabled).unwrap_or(true);
        Ok((e, w, enabled))
    }

    fn m_resolve(&self, p: &Value) -> Result<Value, RpcError> {
        let (e, w, enabled) = self.entry_for(p)?;
        let op = ps(p, "op").unwrap_or("click");
        let strat = policy::decide(&w, &e, op, pb(p, "headed"));
        let live = self.platform.act(&w, &e, &ActOp { kind: "locate".into(), pattern: String::new(), ..Default::default() }).map_err(map_perr)?;
        Ok(json!({ "ref": ps(p, "ref"), "role": e.role, "name": e.name, "enabled": enabled, "window": w.brief(), "rect": live.rect.unwrap_or(e.rect),
            "strategy": match strat { Strategy::Pattern(x) => json!({ "kind": "uia_pattern", "pattern": x }), Strategy::Physical(r) => json!({ "kind": "physical", "reason": r }) } }))
    }

    fn m_act(&self, p: &Value) -> Result<Value, RpcError> {
        let (e, w, enabled) = self.entry_for(p)?;
        let op = ps(p, "op").unwrap_or("click");
        if !["click", "set_value", "toggle", "select", "expand", "collapse", "scroll", "focus"].contains(&op) {
            return Err(RpcError::new(ErrKind::InvalidParams, format!("unknown op '{op}'")));
        }
        if !enabled && op != "focus" {
            return Err(RpcError::new(ErrKind::PolicyDenied, "element is disabled"));
        }
        if op == "set_value" && ps(p, "text").is_none() {
            return Err(RpcError::new(ErrKind::InvalidParams, "text required for set_value"));
        }
        let headed = pb(p, "headed");
        let mut physical_reason = None;
        if let Strategy::Pattern(pat) = policy::decide(&w, &e, op, headed) {
            let aop = ActOp { kind: op.into(), text: ps(p, "text").map(String::from), pattern: pat.into(), amount: pi(p, "amount").unwrap_or(0) as i32 };
            match self.platform.act(&w, &e, &aop) {
                Ok(r) => {
                    return Ok(json!({ "ref": ps(p, "ref"), "strategy": "uia_pattern", "pattern": r.pattern, "headless": true, "focus_stolen": false, "mouse_moved": false,
                        "rect": r.rect, "text_len": ps(p, "text").map(|t| t.chars().count()) })); // never echo the text
                }
                Err(PErr::NoPattern(_)) => physical_reason = Some("pattern_unavailable_at_runtime"),
                Err(x) => return Err(map_perr(x)),
            }
        } else if let Strategy::Physical(r) = policy::decide(&w, &e, op, headed) {
            physical_reason = Some(r);
        }
        let loc = self.platform.act(&w, &e, &ActOp { kind: "locate".into(), ..Default::default() }).map_err(map_perr)?;
        let rc = loc.rect.unwrap_or(e.rect);
        Ok(json!({ "ref": ps(p, "ref"), "strategy": "physical", "reason": physical_reason, "headless": false, "rect": rc,
            "point": [(rc[0] + rc[2]) / 2, (rc[1] + rc[3]) / 2], "dispatch": "DsNative61", "text_len": ps(p, "text").map(|t| t.chars().count()) }))
    }
}

