#[test]
fn ring_concurrent_never_returns_torn_frames() {
    let (_h, v) = ring::HeapRing::new(4, 1024).unwrap();
    let v = std::sync::Arc::new(v);
    let p = v.clone();
    let prod = std::thread::spawn(move || {
        let m = ring::FrameMeta { kind: 1, format: 1, ..Default::default() };
        for n in 1..=30_000u64 { let b = (n % 251) as u8; p.publish(&m, &vec![b; 1024]).unwrap(); }
    });
    let (mut last, mut out, mut got) = (0u64, Vec::new(), 0u64);
    while last < 30_000 {
        match v.read_latest(last, &mut out) {
            Ok(Some(r)) => { assert!(out.iter().all(|b| *b == (r.seq % 251) as u8), "torn frame accepted at seq {}", r.seq); last = r.seq; got += 1; }
            Ok(None) | Err(ring::RingErr::Torn) => std::thread::yield_now(),
            Err(e) => panic!("{e:?}"),
        }
    }
    prod.join().unwrap();
    assert!(got > 10);
}
