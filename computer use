$script:CdpSrc = @'
using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.Net.WebSockets;
using System.Text;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;

// v6.3：CDP 客户端（纯 BCL：ClientWebSocket + System.Text.Json）。接收循环 / JSON-RPC 分发 / 在途请求计数全部在 C# 线程里完成，
// 不会有 PowerShell 脚本块在非 Runspace 线程上回调（那会抛 "There is no Runspace available"）。
public sealed class DsCdp63 : IDisposable {
    ClientWebSocket ws; CancellationTokenSource cts;
    readonly ConcurrentDictionary<int, TaskCompletionSource<string>> pending = new ConcurrentDictionary<int, TaskCompletionSource<string>>();
    readonly ConcurrentDictionary<string, long> inflight = new ConcurrentDictionary<string, long>();
    readonly object sendLock = new object();
    int nextId; long epoch, docEpoch, lastEvt;
    public volatile bool Connected;
    public volatile bool DialogOpen;
    public string DialogInfo = "";
    public string LastError = "";
    public string WsUrl = "";
    public int Sent;
    public static readonly JsonDocumentOptions Jo = new JsonDocumentOptions { MaxDepth = 4096, AllowTrailingCommas = true };
    // 页面侧辅助：鼠标位置记录（用于「光标 → 视口坐标」闭环校准）
    const string HookJs = "(()=>{if(!window.__dsM){window.__dsM={x:-1,y:-1,t:0};addEventListener('mousemove',e=>{window.__dsM={x:e.clientX,y:e.clientY,t:performance.now()}},true)}})()";

    public long Epoch { get { return Interlocked.Read(ref epoch); } }
    public long DocEpoch { get { return Interlocked.Read(ref docEpoch); } }
    public long LastEventTick { get { return Interlocked.Read(ref lastEvt); } }

    // ===== JSON-RPC 编解码（静态，可离线自检）=====
    public static string BuildRequest(int id, string method, string paramsJson) {
        return "{\"id\":" + id + ",\"method\":\"" + method + "\",\"params\":" + (string.IsNullOrEmpty(paramsJson) ? "{}" : paramsJson) + "}";
    }
    public static int IdOf(string msg) {
        if (msg == null || !msg.StartsWith("{\"id\":", StringComparison.Ordinal)) return -1;
        int j = 6, v = 0, n = 0;
        while (j < msg.Length && msg[j] >= '0' && msg[j] <= '9') { v = v * 10 + (msg[j] - '0'); j++; n++; }
        return n > 0 ? v : -1;
    }
    public static string ErrorOf(string msg) {
        if (string.IsNullOrEmpty(msg)) return "空响应";
        int k = msg.IndexOf("\"error\":", 0, Math.Min(msg.Length, 48), StringComparison.Ordinal);
        if (k < 0) return null;
        try { using (var d = JsonDocument.Parse(msg, Jo)) { JsonElement e; if (d.RootElement.TryGetProperty("error", out e)) { JsonElement m; return e.TryGetProperty("message", out m) ? m.GetString() : e.GetRawText(); } } } catch { }
        return "未知错误";
    }
    public static string ResultOf(string msg) {
        try { using (var d = JsonDocument.Parse(msg, Jo)) { JsonElement r; return d.RootElement.TryGetProperty("result", out r) ? r.GetRawText() : "{}"; } } catch { return "{}"; }
    }

    // ===== 连接 =====
    public void Connect(string url, int timeoutMs) {
        Close();
        var sock = new ClientWebSocket();
        var c = new CancellationTokenSource();
        using (var t = new CancellationTokenSource(timeoutMs)) { sock.ConnectAsync(new Uri(url), t.Token).GetAwaiter().GetResult(); }
        ws = sock; cts = c; WsUrl = url; LastError = ""; DialogOpen = false; inflight.Clear();
        Connected = true;
        var tk = Task.Run(() => RecvLoop(sock, c.Token));
        Call("Network.enable", "{}", 4000);
        Call("Page.enable", "{}", 4000);
        try { Call("Page.addScriptToEvaluateOnNewDocument", "{\"source\":" + JsonSerializer.Serialize(HookJs) + "}", 3000); } catch { }
        try { Call("Runtime.evaluate", "{\"expression\":" + JsonSerializer.Serialize(HookJs) + "}", 3000); } catch { }
    }
    public void Close() {
        Connected = false;
        try { if (cts != null) cts.Cancel(); } catch { }
        try { if (ws != null) ws.Abort(); } catch { }
        try { if (ws != null) ws.Dispose(); } catch { }
        ws = null; cts = null;
        FailAll("连接已关闭");
    }
    public void Dispose() { Close(); }
    void FailAll(string why) {
        foreach (var k in pending.Keys) { TaskCompletionSource<string> t; if (pending.TryRemove(k, out t)) t.TrySetException(new InvalidOperationException(why)); }
    }
    void RecvLoop(ClientWebSocket sock, CancellationToken ct) {
        var buf = new byte[65536]; var ms = new MemoryStream();
        try {
            while (!ct.IsCancellationRequested && sock.State == WebSocketState.Open) {
                ms.SetLength(0);
                WebSocketReceiveResult r; bool closed = false;
                do {
                    r = sock.ReceiveAsync(new ArraySegment<byte>(buf), ct).GetAwaiter().GetResult();
                    if (r.MessageType == WebSocketMessageType.Close) { closed = true; break; }
                    ms.Write(buf, 0, r.Count);
                } while (!r.EndOfMessage);
                if (closed) break;
                Dispatch(Encoding.UTF8.GetString(ms.GetBuffer(), 0, (int)ms.Length));
            }
        } catch (Exception e) { if (!ct.IsCancellationRequested) LastError = e.Message; }
        if (ws == sock) { Connected = false; }
        FailAll("CDP 连接已断开" + (string.IsNullOrEmpty(LastError) ? "" : "：" + LastError));
    }
    void Dispatch(string msg) {
        int id = IdOf(msg);
        if (id >= 0) { TaskCompletionSource<string> t; if (pending.TryRemove(id, out t)) t.TrySetResult(msg); return; }
        OnEvent(msg);
    }
    static string Str(string msg, string key) {
        int i = msg.IndexOf(key, StringComparison.Ordinal); if (i < 0) return null;
        i += key.Length; int j = msg.IndexOf('"', i); return j < 0 ? null : msg.Substring(i, j - i);
    }
    void Touch(bool nav) {
        Interlocked.Increment(ref epoch); Interlocked.Exchange(ref lastEvt, Environment.TickCount64);
        if (nav) Interlocked.Increment(ref docEpoch);
    }
    // 事件处理（也供离线自检 FeedEvent 调用）
    public void OnEvent(string msg) {
        int i = msg.IndexOf("\"method\":\"", StringComparison.Ordinal); if (i < 0) return;
        i += 10; int j = msg.IndexOf('"', i); if (j < 0) return;
        string m = msg.Substring(i, j - i);
        switch (m) {
            case "Network.requestWillBeSent": {
                try {
                    using (var d = JsonDocument.Parse(msg, Jo)) {
                        var p = d.RootElement.GetProperty("params");
                        string rid = p.GetProperty("requestId").GetString(), type = "", url = "";
                        JsonElement e;
                        if (p.TryGetProperty("type", out e)) type = e.GetString() ?? "";
                        if (p.TryGetProperty("request", out e) && e.TryGetProperty("url", out e)) url = e.GetString() ?? "";
                        // 长连接 / 流媒体 / 信标不算「页面还在加载」
                        if (type == "WebSocket" || type == "EventSource" || type == "Ping" || type == "Media" || type == "Prefetch" || type == "CSPViolationReport" || type == "Preflight" || type == "SignedExchange") return;
                        if (url.StartsWith("data:", StringComparison.Ordinal) || url.StartsWith("blob:", StringComparison.Ordinal)) return;
                        inflight[rid] = Environment.TickCount64;
                        Touch(type == "Document");
                    }
                } catch { }
                break; }
            case "Network.loadingFinished":
            case "Network.loadingFailed": {
                string rid = Str(msg, "\"requestId\":\"");
                long t0; if (rid != null && inflight.TryRemove(rid, out t0)) Touch(false);
                break; }
            case "Page.frameNavigated":
            case "Page.frameStartedNavigating":
            case "Page.frameStartedLoading": Touch(true); break;
            case "Page.navigatedWithinDocument": Touch(false); break;
            case "Page.javascriptDialogOpening": DialogOpen = true; DialogInfo = (Str(msg, "\"type\":\"") ?? "dialog") + ": " + (Str(msg, "\"message\":\"") ?? ""); break;
            case "Page.javascriptDialogClosed": DialogOpen = false; break;
            case "Inspector.detached": case "Inspector.targetCrashed": Connected = false; LastError = m; break;
        }
    }
    public void FeedEvent(string json) { OnEvent(json); }
    public void ResetNet() { inflight.Clear(); }
    // 在途请求数：超过 staleMs 仍未结束的请求视为后台长轮询，不再计入（否则永远等不到「安静」）
    public int InFlight(int staleMs) {
        long now = Environment.TickCount64; int n = 0;
        foreach (var kv in inflight) { long age = now - kv.Value; if (age > 120000) { long x; inflight.TryRemove(kv.Key, out x); } else if (age < staleMs) n++; }
        return n;
    }

    // ===== 请求 / 响应（线程安全；Batch 一次性发出全部请求再统一等待 = 管线化）=====
    Task<string> Post(string method, string paramsJson) {
        if (!Connected || ws == null) throw new InvalidOperationException("CDP 未连接");
        int id = Interlocked.Increment(ref nextId);
        var tcs = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
        pending[id] = tcs;
        tcs.Task.ContinueWith(t => { var x = t.Exception; }, TaskContinuationOptions.OnlyOnFaulted);
        var bytes = Encoding.UTF8.GetBytes(BuildRequest(id, method, paramsJson));
        try { lock (sendLock) { ws.SendAsync(new ArraySegment<byte>(bytes), WebSocketMessageType.Text, true, cts.Token).GetAwaiter().GetResult(); } Interlocked.Increment(ref Sent); }
        catch { TaskCompletionSource<string> d; pending.TryRemove(id, out d); throw; }
        return tcs.Task;
    }
    public string Call(string method, string paramsJson, int timeoutMs) {
        var t = Post(method, paramsJson);
