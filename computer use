                return content
            empties += 1; self.stats["empty"] += 1
            if empties == 1:                                   # fast local retry: no backoff, more headroom, no JSON mode, thinking off
                self.stats["fast_retry"] += 1
                max_tok = min(max_tok * 2, 8192); jm = False; think_off = True
            elif empties == 2:                                 # failover: backup endpoint
                self.stats["failover"] += 1; base = self.backup_base.rstrip("/")
            else:
                break
        raise EmptyContent("API returned empty content 3x")
