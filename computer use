function Invoke-DriverCommand([string]$Line) {
    $parts = @(($Line.Trim() -split '\s+', 3))
    $sub = if ($parts.Count -gt 1) { $parts[1].ToLower() } else { 'status' }
    $rest = if ($parts.Count -gt 2) { $parts[2] } else { '' }
    switch ($sub) {
        'build' { [void](Build-DscuDriver) }
        'extract' { $x = Export-DscuDriverSource $rest; Write-Host "已释放 $($x.Files) 个文件 → $($x.Dir)" -ForegroundColor Green }
        'start' {
            if (Start-DscuDriver) { $i = $script:Drv.Info; Write-Host "dscu-driver 在线：v$($i.version) adapter=[$($i.platform.adapter)] uiAccess=$($i.platform.ui_access) jab=$($i.platform.jab)" -ForegroundColor Green }
            else { Write-Host '启动失败：未找到已编译驱动（先 driver build），或管道被占用。' -ForegroundColor Yellow }
        }
        'stop' { Stop-DscuDriver; Write-Host '已请求驱动退出。' -ForegroundColor DarkGray }
        'status' {
            $exe = Find-DscuDriverExe
            $on = (-not $NoDriver) -and (Connect-DsDriver)
            Write-Host ("驱动：{0}    二进制：{1}" -f $(if ($on) { "在线 v$($script:Drv.Info.version) [$($script:Drv.Info.platform.adapter)] uiAccess=$($script:Drv.Info.platform.ui_access)" } else { '离线（PowerShell/C# 路径生效，零影响）' }), $(if ($exe) { $exe } else { '未编译（driver build）' })) -ForegroundColor Cyan
        }
        'snapshot' {
            $app = $null; $root = $null; $skel = $false; $wid = [long]0
            foreach ($tok in @($rest -split '\s+' | Where-Object { $_ })) {
                if ($tok -match '^(skeleton|--skeleton)$') { $skel = $true }
                elseif ($tok -match '^(root=|--root=)?(@s[0-9a-z]{7}:e\d+)$') { $root = $Matches[2] }
                elseif ($tok -match '^window=(\d+)$') { $wid = [long]$Matches[1] }
                else { $app = $tok -replace '^app=', '' }
            }
            $r = Invoke-DscuSnapshot $app $root -Skel:$skel $wid
            if ($r) {
                Write-Host $r.text
                Write-Host ("[快照 {0}] 节点 {1}/{2} · ≈{3} token（完整树 ≈{4} token，压缩 {5}%）· 扫描 {6} ms · 来源 {7}" -f $r.snapshot_id, $r.nodes_shown, $r.nodes_total, $r.tokens_est, $r.full_tokens_est, $r.compression_pct, $r.scan_ms, $r.source) -ForegroundColor DarkGray
            }
        }
        'act' {
            $m = [regex]::Match($rest, '^(@s[0-9a-z]{7}:e\d+)\s*(\w+)?\s*(.*)$')
            if (-not $m.Success) { Write-Host '用法：driver act @s8f3k2p9:e8 [click|set_value|toggle|select|expand|focus|scroll] [文本]' -ForegroundColor Yellow }
            else {
                $op = if ($m.Groups[2].Value) { $m.Groups[2].Value } else { 'click' }
                $r = if ($m.Groups[3].Value) { Invoke-DscuAct $m.Groups[1].Value $op -Text $m.Groups[3].Value } else { Invoke-DscuAct $m.Groups[1].Value $op }
                if ($r.Ok) { Write-Host ($r.Data | ConvertTo-Json -Depth 5 -Compress) -ForegroundColor Green } else { Write-Host "[$($r.Kind)] $($r.Message)" -ForegroundColor Red }
            }
        }
        'call' {
            $m = [regex]::Match($rest, '^(\S+)\s*(.*)$')
            if (-not $m.Success) { Write-Host '用法：driver call <method> [{"json":"params"}]' -ForegroundColor Yellow }
            else {
                $pp = if ($m.Groups[2].Value) { $m.Groups[2].Value | ConvertFrom-Json -AsHashtable } else { @{} }
                $o = Invoke-DscuRaw $m.Groups[1].Value $pp 60000
                $o | ConvertTo-Json -Depth 12
            }
        }
        'setup-uiaccess' { Invoke-DscuSetupUiAccess }
        'verify' { Invoke-DscuVerifyPhase6 }
        'save-self' { $d = Save-DscuSelf; if ($d) { Write-Host "已保存脚本：$d" -ForegroundColor Green } else { Write-Host '无法自动保存；请在网页点「下载 .ps1」保存为 UTF-8 文件。' -ForegroundColor Yellow } }
        default {
            Write-Host 'driver 命令：build | start | stop | status | snapshot [应用名] [skeleton] [root=@s…:eN] [window=<id>] | act @ref [op] [文本] | call <method> [json] | setup-uiaccess | verify | extract [目录] | save-self' -ForegroundColor Cyan
        }
    }
}
