[CmdletBinding(SupportsShouldProcess)]
param(
    [string]$DriverExe = (Join-Path $env:LOCALAPPDATA 'DeepSeekComputerUse\dscu-driver\bin\dscu-driver.exe'),
    [string]$InstallDir = (Join-Path $env:ProgramFiles 'DeepSeekComputerUse'),
