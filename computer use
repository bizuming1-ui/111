}
VALID_PLANES = {"L0_CLI", "L1_CDP", "L2_UIA_JAB", "L3_DXGI_DML", "L4_VISION_SOM", "BRAIN"}
REF_PATTERN = re.compile(r"^@s(\d+):e(\d+)$")


@dataclass
