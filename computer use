"""Long-task Checkpoint & Resume + local rollback planning.

Atomic JSON snapshots after every verified step (os.replace, fsync) so a crash / API outage / Ctrl+C loses at most one
step.  `resume()` rebuilds the history prefix in the SAME order, which keeps the DeepSeek KV prefix cache hit-rate
(static system + stable task + history prefix are byte-identical; only the volatile observation changes).
Rollback is *local*: Esc -> Ctrl+Z -> re-observe, never a blind restart.
"""
from __future__ import annotations

import json
import os
import tempfile
import time
from dataclasses import asdict, dataclass, field
from pathlib import Path


@dataclass
class TaskCheckpoint:
    task_id: str
    task: str
    layer: int = 4
    step: int = 0
    epoch: int = 0
    history: list[str] = field(default_factory=list)
    quota: dict | None = None
    grants: list[str] = field(default_factory=list)
    escape_level: int = 0
    banned: list[list[float]] = field(default_factory=list)
    done: bool = False
    ts: float = field(default_factory=time.time)


class CheckpointStore:
    def __init__(self, root: str):
        self.root = Path(root)
        self.root.mkdir(parents=True, exist_ok=True)

    def _p(self, task_id: str) -> Path:
        return self.root / f"ckpt-{task_id}.json"

    def save(self, ck: TaskCheckpoint | str, state: dict | None = None) -> Path:
        """save(TaskCheckpoint) or v10-style save(task_id, dict)."""
        if isinstance(ck, str):
            data, tid = state or {}, ck
        else:
            data, tid = asdict(ck), ck.task_id
        p = self._p(tid)
        fd, tmp = tempfile.mkstemp(dir=self.root)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False); f.flush(); os.fsync(f.fileno())
        os.replace(tmp, p)
        return p

    def load(self, task_id: str) -> dict | None:
        p = self._p(task_id)
        return json.loads(p.read_text("utf-8")) if p.exists() else None

    def resume(self, task_id: str) -> TaskCheckpoint | None:
        d = self.load(task_id)
        if not d or d.get("done"):
            return None
        known = {k: d[k] for k in TaskCheckpoint.__dataclass_fields__ if k in d}
        return TaskCheckpoint(**known)

    def latest_unfinished(self) -> TaskCheckpoint | None:
        best = None
        for p in self.root.glob("ckpt-*.json"):
            try:
                d = json.loads(p.read_text("utf-8"))
            except (OSError, ValueError):
                continue
            if not d.get("done") and (best is None or d.get("ts", 0) > best.get("ts", 0)):
                best = d
        return self.resume(best["task_id"]) if best and "task_id" in best else None

    @staticmethod
    def rollback_plan(no_effect_streak: int, last_action: str) -> list[dict]:
        if no_effect_streak < 2:
            return []
        plan = [{"action": "key", "keys": "esc"}]
        if last_action in ("type", "key", "paste"):
            plan.append({"action": "key", "keys": "ctrl+z"})
        return plan + [{"action": "observe"}]

    @staticmethod
    def rollback_hint(no_effect_streak: int) -> str:
        return "优先 Esc / Ctrl+Z 回滚上一步误操作，再换一种定位方式" if no_effect_streak >= 2 else ""
