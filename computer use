}
try { [void][CU.Native]::SetProcessDPIAware() } catch { }

$script:HasUia = $false
try { Add-Type -AssemblyName UIAutomationClient, UIAutomationTypes; $script:HasUia = $true } catch { }

# ------------------------------ config -------------------------------
$script:Api      = if ($env:DEEPSEEK_BASE_URL) { $env:DEEPSEEK_BASE_URL.TrimEnd('/') } else { 'https://api.deepseek.com' }
$script:Model    = if ($env:CU_MODEL) { $env:CU_MODEL } else { 'deepseek-chat' }
$script:MaxSteps = if ($env:CU_STEPS) { [int]$env:CU_STEPS } else { 30 }
$script:Yolo     = ($env:CU_YOLO -eq '1')
$script:Port     = 9222
$script:Delay    = 600
$script:Key      = $env:DEEPSEEK_API_KEY
$script:Els      = @()
$script:UiaCond  = $null
$script:BrowserProcs = @('chrome', 'msedge', 'brave')
$script:Danger = '(?i)(\b(remove-item|rm|del|erase|rd|rmdir|format|diskpart|shutdown|restart-computer|stop-computer|set-executionpolicy|remove-itemproperty|stop-process|taskkill|invoke-webrequest|iwr|irm|curl|wget|iex|invoke-expression|schtasks|bcdedit|cipher)\b|reg(\.exe)?\s+(add|delete)|net\s+user)'

$script:VK = @{
    'ctrl' = 0x11; 'control' = 0x11; 'alt' = 0x12; 'shift' = 0x10; 'win' = 0x5B
    'enter' = 0x0D; 'tab' = 0x09; 'esc' = 0x1B; 'escape' = 0x1B; 'backspace' = 0x08
    'delete' = 0x2E; 'del' = 0x2E; 'insert' = 0x2D; 'space' = 0x20
    'up' = 0x26; 'down' = 0x28; 'left' = 0x25; 'right' = 0x27
    'home' = 0x24; 'end' = 0x23; 'pageup' = 0x21; 'pagedown' = 0x22
}

$script:Sys = @'
You control a Windows PC through PowerShell. Reply with ONE JSON object only:
{"thought":"max 25 words","actions":[...],"done":false,"answer":""}
Set done=true and fill answer (in the user's language) when finished or impossible.
Max 4 actions per reply. Batch several only when no new observation is needed between them.
Each turn you receive: screen size, foreground window, window list, [BROWSER] page text + numbered elements, [UI] numbered desktop elements. Ids are valid ONLY for the current observation.
Actions:
{"a":"b_goto","url":"..."}   open URL in the automated browser (preferred for anything on the web)
{"a":"b_click","id":N}
{"a":"b_type","id":N,"text":"...","enter":true}   fill an input, optionally press Enter
{"a":"b_scroll","dy":600}   pixels, positive=down
{"a":"click"|"dblclick"|"rclick","id":N}   desktop element, or with "x":X,"y":Y
{"a":"type","text":"...","enter":false}   paste text into the focused desktop control
{"a":"key","keys":"ctrl+l"}   e.g. win, alt+f4, ctrl+shift+t, enter, f5, ctrl+a
{"a":"scroll","dy":3}   mouse wheel clicks, positive=down
{"a":"open","target":"notepad | calc | https://... | C:\\path\\file.txt"}
{"a":"focus","title":"part of window title"}
{"a":"wait","s":2}
{"a":"ps","cmd":"PowerShell 7 command"}   returns its output; best for files, processes, system info
Rules: use ps for file/system work, b_* for web pages, desktop actions for native apps. The first foreground window is the terminal that runs you: never type into it. Never repeat a failing action unchanged. Never invent ids. If a result says FAIL, adapt.
'@

$script:SnapJs = @'
(function(){
  var q='a,button,input,textarea,select,summary,[role=button],[role=link],[role=tab],[role=menuitem],[role=checkbox],[onclick],[contenteditable=true]';
  var out=[]; window.__cu=[];
  var all=document.querySelectorAll(q);
  for (var i=0;i<all.length && out.length<60;i++){
    var e=all[i], r=e.getBoundingClientRect();
    if (r.width<4||r.height<4||r.bottom<0||r.top>innerHeight) continue;
    var cs=getComputedStyle(e); if (cs.visibility==='hidden'||cs.display==='none') continue;
    var t=(e.innerText||e.value||e.placeholder||e.getAttribute('aria-label')||e.title||e.alt||'').trim().replace(/\s+/g,' ').slice(0,60);
    var n=window.__cu.length; window.__cu.push(e);
    out.push('['+n+'] '+e.tagName.toLowerCase()+(e.type?':'+e.type:'')+' '+t+(e.href?' -> '+String(e.href).slice(0,80):''));
  }
  return JSON.stringify({url:location.href,title:document.title,text:(document.body?document.body.innerText:'').replace(/\s+/g,' ').slice(0,1200),els:out});
})()
'@

# ------------------------------ helpers ------------------------------
function CU-Cut($s, [int]$n) {
    $s = [string]$s
    if ($s.Length -gt $n) { return $s.Substring(0, $n) }
    return $s
}

function CU-Failsafe {
    $p = [System.Windows.Forms.Cursor]::Position
    if ($p.X -le 0 -and $p.Y -le 0) { throw 'FAILSAFE' }
}

function CU-Confirm([string]$what) {
    if ($script:Yolo) { return $true }
    Write-Host "  ! Risky: $(CU-Cut $what 200)" -ForegroundColor Red
    return ((Read-Host '  Allow? [y/N]') -match '^(y|yes)$')
}

# --------------------------- mouse / keyboard ------------------------
function CU-Mouse([int]$x, [int]$y, [string]$kind = 'left', [int]$n = 1) {
    [void][CU.Native]::SetCursorPos($x, $y)
    Start-Sleep -Milliseconds 80
    if ($kind -eq 'right') { $d = 0x8; $u = 0x10 } else { $d = 0x2; $u = 0x4 }
    for ($i = 0; $i -lt $n; $i++) {
        [CU.Native]::mouse_event($d, 0, 0, 0, [UIntPtr]::Zero)
        Start-Sleep -Milliseconds 40
        [CU.Native]::mouse_event($u, 0, 0, 0, [UIntPtr]::Zero)
        Start-Sleep -Milliseconds 70
    }
}

function CU-Key([string]$combo) {
    $ext = @(0x26, 0x28, 0x25, 0x27, 0x24, 0x23, 0x21, 0x22, 0x2D, 0x2E)
    $codes = @()
    foreach ($part in ($combo.ToLower() -split '\+')) {
        $k = $part.Trim()
        if ($script:VK.ContainsKey($k)) { $codes += [int]$script:VK[$k] }
        elseif ($k -match '^f([1-9]|1[0-2])$') { $codes += (0x6F + [int]$Matches[1]) }
        elseif ($k -match '^[a-z0-9]$') { $codes += [int][char]$k.ToUpper() }
        else { throw "unknown key '$k'" }
    }
    foreach ($c in $codes) {
        $f = 0; if ($ext -contains $c) { $f = 1 }
        [CU.Native]::keybd_event([byte]$c, 0, $f, [UIntPtr]::Zero)
        Start-Sleep -Milliseconds 25
    }
    $rev = $codes[($codes.Count - 1)..0]
    foreach ($c in $rev) {
        $f = 2; if ($ext -contains $c) { $f = 3 }
        [CU.Native]::keybd_event([byte]$c, 0, $f, [UIntPtr]::Zero)
        Start-Sleep -Milliseconds 25
    }
}

function CU-Type([string]$text) {
    $old = $null
    try { $old = Get-Clipboard -Raw } catch { }
    Set-Clipboard -Value $text
    Start-Sleep -Milliseconds 100
    CU-Key 'ctrl+v'
    Start-Sleep -Milliseconds 300
    if ($old) { try { Set-Clipboard -Value $old } catch { } }
}

function CU-Fg {
    $h = [CU.Native]::GetForegroundWindow()
    $name = ''
    try { $name = (Get-Process -Id ([CU.Native]::PidOf($h))).ProcessName } catch { }
    return [pscustomobject]@{ H = $h; Title = [CU.Native]::Title($h); Proc = $name }
}

function CU-Focus([string]$title) {
    $p = Get-Process | Where-Object {
        $_.MainWindowHandle -ne 0 -and $_.MainWindowTitle.IndexOf($title, [StringComparison]::OrdinalIgnoreCase) -ge 0
    } | Select-Object -First 1
    if (-not $p) { throw "no window matching '$title'" }
    [CU.Native]::keybd_event(0x12, 0, 0, [UIntPtr]::Zero)
    [CU.Native]::keybd_event(0x12, 0, 2, [UIntPtr]::Zero)
    if ([CU.Native]::IsIconic($p.MainWindowHandle)) { [void][CU.Native]::ShowWindow($p.MainWindowHandle, 9) }
    [void][CU.Native]::SetForegroundWindow($p.MainWindowHandle)
    Start-Sleep -Milliseconds 400
    return "focused '$($p.MainWindowTitle)'"
}

# ------------------------- UI Automation (desktop) -------------------
function CU-Ui {
    $script:Els = @()
    if (-not $script:HasUia) { return @() }
    $lines = @()
    try {
        $fg = [CU.Native]::GetForegroundWindow()
        if ($fg -eq [IntPtr]::Zero) { return @() }
        $A = [System.Windows.Automation.AutomationElement]
        $root = $A::FromHandle($fg)
        if (-not $script:UiaCond) {
            $props = @()
            foreach ($t in 'Button', 'Edit', 'MenuItem', 'Hyperlink', 'ListItem', 'TabItem', 'CheckBox', 'ComboBox', 'RadioButton', 'TreeItem', 'SplitButton') {
                $props += [System.Windows.Automation.PropertyCondition]::new($A::ControlTypeProperty, [System.Windows.Automation.ControlType]::$t)
            }
            $script:UiaCond = [System.Windows.Automation.OrCondition]::new([System.Windows.Automation.Condition[]]$props)
        }
        $found = $root.FindAll([System.Windows.Automation.TreeScope]::Descendants, $script:UiaCond)
        $limit = [Math]::Min($found.Count, 250)
        $i = 0
        for ($k = 0; $k -lt $limit -and $i -lt 50; $k++) {
            $c = $found[$k].Current
            if ($c.IsOffscreen -or -not $c.IsEnabled) { continue }
            $r = $c.BoundingRectangle
            if ($r.IsEmpty -or $r.Width -lt 3 -or $r.Height -lt 3) { continue }
            $type = $c.ControlType.ProgrammaticName -replace 'ControlType\.', ''
            $name = CU-Cut (($c.Name -replace '\s+', ' ').Trim()) 50
            if (-not $name -and $type -ne 'Edit') { continue }
            $script:Els += , @([int]($r.X + $r.Width / 2), [int]($r.Y + $r.Height / 2))
            $lines += "[$i] $type '$name'"
            $i++
        }
    } catch { $lines += "(UI Automation error: $(CU-Cut $_.Exception.Message 120))" }
    return $lines
}

# ----------------------- browser (DevTools protocol) -----------------
function CU-CdpTab {
    try {
        $tabs = Invoke-RestMethod -Uri "http://127.0.0.1:$($script:Port)/json/list" -TimeoutSec 2
    } catch { return $null }
    return ($tabs | Where-Object { $_.type -eq 'page' -and $_.webSocketDebuggerUrl -and $_.url -notlike 'devtools:*' } | Select-Object -First 1)
}

function CU-FindBrowser {
    $cands = @(
        "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
        "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
        "$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe",
        "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
        "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe"
    )
    return ($cands | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1)
}

function CU-LaunchBrowser([string]$url) {
    $exe = CU-FindBrowser
    if (-not $exe) { throw 'Chrome or Edge not found' }
    $profileDir = Join-Path $env:LOCALAPPDATA 'cu-profile'
    $argList = @(
        "--remote-debugging-port=$($script:Port)",
        '--remote-allow-origins=*',
        ('--user-data-dir="' + $profileDir + '"'),
        '--no-first-run', '--no-default-browser-check',
        $url
    )
    Start-Process -FilePath $exe -ArgumentList $argList
    for ($i = 0; $i -lt 40; $i++) {
        Start-Sleep -Milliseconds 500
        if (CU-CdpTab) { return }
    }
    throw 'browser debug port did not open'
}

function CU-Cdp([string]$method, $cdpParams = @{}) {
    $tab = CU-CdpTab
    if (-not $tab) { throw 'no automated browser tab - use b_goto first' }
    $ws = [System.Net.WebSockets.ClientWebSocket]::new()
    $cts = [Threading.CancellationTokenSource]::new(25000)
    try {
        $ws.ConnectAsync([Uri]$tab.webSocketDebuggerUrl, $cts.Token).GetAwaiter().GetResult()
        $json = @{ id = 1; method = $method; params = $cdpParams } | ConvertTo-Json -Depth 12 -Compress
        $bytes = [Text.Encoding]::UTF8.GetBytes($json)
        $type = [System.Net.WebSockets.WebSocketMessageType]::Text
        $ws.SendAsync([ArraySegment[byte]]::new($bytes), $type, $true, $cts.Token).GetAwaiter().GetResult()
        $buf = [byte[]]::new(65536)
        while ($true) {
            $ms = [IO.MemoryStream]::new()
            do {
                $r = $ws.ReceiveAsync([ArraySegment[byte]]::new($buf), $cts.Token).GetAwaiter().GetResult()
                $ms.Write($buf, 0, $r.Count)
            } until ($r.EndOfMessage)
            $msg = [Text.Encoding]::UTF8.GetString($ms.ToArray()) | ConvertFrom-Json
            if ($msg.id -eq 1) {
                if ($msg.error) { throw "CDP error: $($msg.error.message)" }
                return $msg.result
            }
        }
    } finally { $ws.Dispose(); $cts.Dispose() }
}

function CU-Js([string]$js) {
    $r = CU-Cdp 'Runtime.evaluate' @{ expression = $js; returnByValue = $true; awaitPromise = $true }
    if ($r.exceptionDetails) { throw "JS error: $(CU-Cut $r.exceptionDetails.exception.description 200)" }
    return $r.result.value
}

function CU-Goto([string]$url) {
    if ($url -notmatch '^[a-zA-Z][a-zA-Z0-9+.-]*:') { $url = "https://$url" }
    if (-not (CU-CdpTab)) { CU-LaunchBrowser $url }
    else { [void](CU-Cdp 'Page.navigate' @{ url = $url }) }
    Start-Sleep -Milliseconds 900
    for ($i = 0; $i -lt 20; $i++) {
        try { if ((CU-Js 'document.readyState') -eq 'complete') { break } } catch { }
        Start-Sleep -Milliseconds 500
    }
}

function CU-BrowserType([int]$id, [string]$text, [bool]$enter) {
    $lit = ConvertTo-Json -InputObject $text -Compress
    $js = '(function(){var e=window.__cu&&window.__cu[' + $id + '];if(!e)return "no such element";' +
          'e.scrollIntoView({block:"center"});e.focus();var v=' + $lit + ';' +
          'var d=Object.getOwnPropertyDescriptor(Object.getPrototypeOf(e),"value");' +
          'if(d&&d.set){d.set.call(e,v);}else{e.textContent=v;}' +
          'e.dispatchEvent(new Event("input",{bubbles:true}));e.dispatchEvent(new Event("change",{bubbles:true}));return "ok";})()'
    $res = CU-Js $js
    if ($res -ne 'ok') { throw $res }
    if ($enter) {
        [void](CU-Cdp 'Input.dispatchKeyEvent' @{ type = 'keyDown'; key = 'Enter'; code = 'Enter'; windowsVirtualKeyCode = 13; text = "`r" })
        [void](CU-Cdp 'Input.dispatchKeyEvent' @{ type = 'keyUp'; key = 'Enter'; code = 'Enter'; windowsVirtualKeyCode = 13 })
        Start-Sleep -Milliseconds 1200
    }
}

# ------------------------------ run PowerShell -----------------------
function CU-Ps([string]$cmd) {
    if ($cmd -match $script:Danger) {
        if (-not (CU-Confirm $cmd)) { return 'DENIED by user' }
    }
    $j = Start-Job -ScriptBlock {
        param($c)
        try { Invoke-Expression $c 2>&1 | Out-String } catch { "ERROR: $_" }
    } -ArgumentList $cmd
    if (Wait-Job $j -Timeout 60) { $o = Receive-Job $j } else { $o = 'ERROR: timeout after 60s'; Stop-Job $j }
    Remove-Job $j -Force
    $o = (($o | Out-String).Trim())
    if (-not $o) { $o = '(no output)' }
    return (CU-Cut $o 1500)
}

# ------------------------------ observation --------------------------
function CU-Observe {
    $fg = CU-Fg
    $scr = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
    $mp = [System.Windows.Forms.Cursor]::Position
    $L = [System.Collections.Generic.List[string]]::new()
    $L.Add("Screen $($scr.Width)x$($scr.Height) | Mouse $($mp.X),$($mp.Y)")
    $L.Add("Foreground: $($fg.Proc) | $(CU-Cut $fg.Title 80)")
    $wins = @(Get-Process | Where-Object { $_.MainWindowTitle } | Select-Object -First 12 | ForEach-Object { "$($_.ProcessName): $(CU-Cut $_.MainWindowTitle 50)" })
    $L.Add('Windows: ' + ($wins -join ' ; '))
    $inBrowser = $false
    if (CU-CdpTab) {
        try {
            $pg = (CU-Js $script:SnapJs) | ConvertFrom-Json
            $L.Add("[BROWSER] $($pg.url) | $($pg.title)")
            $L.Add("page text: $($pg.text)")
            foreach ($e in $pg.els) { $L.Add([string]$e) }
            $inBrowser = ($script:BrowserProcs -contains $fg.Proc)
        } catch { $L.Add("[BROWSER] error: $(CU-Cut $_.Exception.Message 150)") }
    }
    if (-not $inBrowser) {
        $ui = @(CU-Ui)
        if ($ui.Count -gt 0) { $L.Add('[UI] foreground window elements:'); foreach ($u in $ui) { $L.Add($u) } }
        else { $L.Add('[UI] none detected - use keyboard or x,y') }
    }
    return ($L -join "`n")
}

# ------------------------------ actions ------------------------------
function CU-Resolve($a) {
    if ($null -ne $a.id) {
        $i = [int]$a.id
        if ($i -lt 0 -or $i -ge $script:Els.Count) { throw "bad element id $i" }
        return @($script:Els[$i][0], $script:Els[$i][1])
    }
    if ($null -ne $a.x -and $null -ne $a.y) { return @([int]$a.x, [int]$a.y) }
    throw 'need id or x,y'
}

function CU-Do($a) {
    CU-Failsafe
    $t = [string]$a.a
    switch ($t) {
        'b_goto' { CU-Goto ([string]$a.url); return ('now at ' + (CU-Js 'location.href')) }
        'b_click' {
            $n = [int]$a.id
            $res = CU-Js ('(function(){var e=window.__cu&&window.__cu[' + $n + '];if(!e)return "no such element";e.scrollIntoView({block:"center"});if(e.focus)e.focus();e.click();return "ok";})()')
            if ($res -ne 'ok') { throw $res }
            Start-Sleep -Milliseconds 800
            return 'clicked'
        }
        'b_type' { CU-BrowserType ([int]$a.id) ([string]$a.text) ([bool]$a.enter); return 'typed' }
        'b_scroll' { [void](CU-Js ('window.scrollBy(0,' + [int]$a.dy + ')')); return 'scrolled' }
        'click' { $p = CU-Resolve $a; CU-Mouse $p[0] $p[1] 'left' 1; return "clicked $($p[0]),$($p[1])" }
        'dblclick' { $p = CU-Resolve $a; CU-Mouse $p[0] $p[1] 'left' 2; return "double-clicked $($p[0]),$($p[1])" }
        'rclick' { $p = CU-Resolve $a; CU-Mouse $p[0] $p[1] 'right' 1; return "right-clicked $($p[0]),$($p[1])" }
        'type' { CU-Type ([string]$a.text); if ($a.enter) { CU-Key 'enter' }; return 'typed' }
        'key' { CU-Key ([string]$a.keys); return 'ok' }
        'scroll' {
            if ($null -ne $a.x -and $null -ne $a.y) { [void][CU.Native]::SetCursorPos([int]$a.x, [int]$a.y) }
            [CU.Native]::mouse_event(0x800, 0, 0, (-120 * [int]$a.dy), [UIntPtr]::Zero)
            return 'scrolled'
        }
        'open' {
            $tg = [string]$a.target
            if ($tg -match '^https?://') { CU-Goto $tg; return ('opened ' + $tg) }
            if ($tg -match '[\\/].*\.(ps1|bat|cmd|vbs|msi|exe|scr)$') {
                if (-not (CU-Confirm "open $tg")) { return 'DENIED by user' }
            }
            Start-Process $tg
            Start-Sleep -Milliseconds 1500
            return "started $tg"
        }
        'focus' { return (CU-Focus ([string]$a.title)) }
        'wait' { Start-Sleep -Milliseconds ([int]([Math]::Min([double]$a.s, 15) * 1000)); return 'waited' }
        'ps' { return (CU-Ps ([string]$a.cmd)) }
        default { throw "unknown action '$t'" }
    }
}

# ------------------------------ LLM ----------------------------------
function CU-Llm($msgs) {
    $body = @{
        model = $script:Model; messages = @($msgs); temperature = 0; max_tokens = 800
        response_format = @{ type = 'json_object' }
    } | ConvertTo-Json -Depth 10 -Compress
    $bytes = [Text.Encoding]::UTF8.GetBytes($body)
    for ($i = 1; $i -le 3; $i++) {
        try {
            $r = Invoke-RestMethod -Uri "$($script:Api)/chat/completions" -Method Post `
                -Headers @{ Authorization = "Bearer $($script:Key)" } -ContentType 'application/json' -Body $bytes -TimeoutSec 120
            $u = $r.usage
            if ($u) { Write-Host ('    tokens: in {0} (cache hit {1}) out {2}' -f $u.prompt_tokens, $u.prompt_cache_hit_tokens, $u.completion_tokens) -ForegroundColor DarkGray }
            return [string]$r.choices[0].message.content
        } catch {
            $m = "$($_.Exception.Message) $($_.ErrorDetails.Message)"
            if ($m -match '401|402|403|Authentication|Insufficient') { throw "DeepSeek rejected the request: $m" }
            if ($i -eq 3) { throw "DeepSeek API failed: $m" }
            Write-Host "    API retry $i : $(CU-Cut $m 150)" -ForegroundColor DarkYellow
            Start-Sleep -Seconds (2 * $i)
        }
    }
}

function CU-Parse([string]$raw) {
    if (-not $raw) { return $null }
    $s = $raw.Trim()
    $i = $s.IndexOf('{'); $j = $s.LastIndexOf('}')
    if ($i -lt 0 -or $j -le $i) { return $null }
    try { return ($s.Substring($i, $j - $i + 1) | ConvertFrom-Json) } catch { return $null }
}

# ------------------------------ agent loop ---------------------------
function CU-Run([string]$task) {
    $hist = [System.Collections.Generic.List[object]]::new()
    $lastSig = ''; $same = 0
    $p = [System.Windows.Forms.Cursor]::Position
    if ($p.X -le 0 -and $p.Y -le 0) { [void][CU.Native]::SetCursorPos(300, 300) }

    for ($step = 1; $step -le $script:MaxSteps; $step++) {
        $obs = CU-Observe
        $msgs = [System.Collections.Generic.List[object]]::new()
        $msgs.Add(@{ role = 'system'; content = $script:Sys })
        $items = @($hist | Select-Object -Last 14)
        if ($items.Count -eq 0) {
            $msgs.Add(@{ role = 'user'; content = "TASK: $task`n`nOBSERVATION (step $step):`n$obs" })
        } else {
            $msgs.Add(@{ role = 'user'; content = "TASK: $task" })
            for ($k = 0; $k -lt $items.Count; $k++) {
                $msgs.Add(@{ role = 'assistant'; content = $items[$k].act })
                $res = $items[$k].res
                if ($k -eq $items.Count - 1) { $res = "$res`n`nOBSERVATION (step $step):`n$obs" }
                $msgs.Add(@{ role = 'user'; content = $res })
            }
        }

        $raw = CU-Llm $msgs
        $plan = CU-Parse $raw
        if (-not $plan) {
            Write-Host "[$step] model returned invalid JSON, retrying" -ForegroundColor DarkYellow
            $hist.Add(@{ act = (CU-Cut $raw 600); res = 'Invalid JSON. Reply with ONE JSON object only.' })
            continue
        }
        Write-Host "[$step] $($plan.thought)" -ForegroundColor Cyan
        if ($plan.done) { Write-Host "`nDONE: $($plan.answer)" -ForegroundColor Green; return }

        $acts = @($plan.actions | Select-Object -First 4)
        if ($acts.Count -eq 0) {
            $hist.Add(@{ act = $raw; res = 'No actions given. Provide actions or set done=true.' })
            continue
        }

        $results = @(); $sig = ''
        foreach ($a in $acts) {
            $desc = $a | ConvertTo-Json -Compress -Depth 5
            $sig += $desc
            Write-Host "    > $(CU-Cut $desc 160)" -ForegroundColor Yellow
            try {
                $out = CU-Do $a
                $results += "OK $($a.a): $(CU-Cut ([string]$out) 1500)"
                Write-Host "      $(CU-Cut ([string]$out) 160)" -ForegroundColor DarkGray
            } catch {
                if ($_.Exception.Message -eq 'FAILSAFE') { Write-Host "`nABORTED by failsafe (mouse in top-left corner)." -ForegroundColor Red; return }
                $results += "FAIL $($a.a): $(CU-Cut $_.Exception.Message 300)"
                Write-Host "      FAIL: $(CU-Cut $_.Exception.Message 160)" -ForegroundColor Red
                break
            }
            Start-Sleep -Milliseconds $script:Delay
        }

        if ($sig -eq $lastSig) { $same++ } else { $same = 0; $lastSig = $sig }
        if ($same -ge 4) { Write-Host "`nStopped: same actions repeated without progress." -ForegroundColor Red; return }
        $resText = 'RESULTS: ' + ($results -join ' | ')
        if ($same -ge 2) { $resText += ' | WARNING: you repeated the same actions with no progress. Try a different approach or finish with done=true.' }
        $hist.Add(@{ act = $raw; res = $resText })
    }
    Write-Host "`nStopped: reached $($script:MaxSteps) steps. Set CU_STEPS to allow more." -ForegroundColor Red
}

# ------------------------------ self test ----------------------------
function CU-Check([string]$name, [bool]$ok, [string]$info = '') {
    $tag = if ($ok) { 'OK  ' } else { 'FAIL' }
    $col = if ($ok) { 'Green' } else { 'Red' }
    Write-Host ("  [{0}] {1,-18} {2}" -f $tag, $name, $info) -ForegroundColor $col
}

function CU-SelfTest {
    Write-Host 'Self test' -ForegroundColor Cyan
    CU-Check 'PowerShell 7+' ($PSVersionTable.PSVersion.Major -ge 7) "$($PSVersionTable.PSVersion)"
    CU-Check 'Windows' ($IsWindows) ''
    CU-Check 'user32 native' ([bool]('CU.Native' -as [type])) ''
    $scr = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
    CU-Check 'screen' ($scr.Width -gt 0) "$($scr.Width)x$($scr.Height)"
    $clipOk = $false
    try { Set-Clipboard -Value 'cu-test'; $clipOk = ((Get-Clipboard -Raw).Trim() -eq 'cu-test') } catch { }
    CU-Check 'clipboard' $clipOk ''
    CU-Check 'UI Automation' $script:HasUia ''
    if ($script:HasUia) { $n = @(CU-Ui).Count; CU-Check 'UIA read' ($n -ge 0) "$n elements in foreground window" }
    $b = CU-FindBrowser
    CU-Check 'Chrome/Edge' ([bool]$b) "$b"
    $apiOk = $false; $info = ''
    try {
        $m = [System.Collections.Generic.List[object]]::new()
        $m.Add(@{ role = 'user'; content = 'Reply with this JSON only: {"ok":true}' })
        $p = CU-Parse (CU-Llm $m)
        $apiOk = [bool]($p -and $p.ok); $info = $script:Model
    } catch { $info = CU-Cut $_.Exception.Message 160 }
    CU-Check 'DeepSeek API' $apiOk $info
}

# ------------------------------ entry --------------------------------
function Start-CU {
    param([string]$Task = '')
    $ErrorActionPreference = 'Stop'
    Write-Host ''
    Write-Host '  CU 2.0 - DeepSeek Computer Use' -ForegroundColor Cyan
    Write-Host '  Failsafe: move mouse to the top-left corner. Ctrl+C stops.' -ForegroundColor DarkGray
    if ($PSVersionTable.PSVersion.Major -lt 7) { Write-Host 'PowerShell 7+ is required.' -ForegroundColor Red; return }
    if (-not $IsWindows) { Write-Host 'Windows only.' -ForegroundColor Red; return }

    if (-not $script:Key) {
        $sec = Read-Host 'DeepSeek API key (sk-...)' -AsSecureString
        $script:Key = ConvertFrom-SecureString -SecureString $sec -AsPlainText
    }
    if (-not $script:Key) { Write-Host 'No API key.' -ForegroundColor Red; return }

    if ($Task.Trim() -eq '/test') { CU-SelfTest; return }

    while ($true) {
        if (-not $Task.Trim()) {
            Write-Host ''
            $Task = Read-Host 'Task (empty = quit, /test = self test)'
            if (-not $Task.Trim()) { break }
            if ($Task.Trim() -eq '/test') { CU-SelfTest; $Task = ''; continue }
        }
        try { CU-Run $Task } catch { Write-Host "ERROR: $($_.Exception.Message)" -ForegroundColor Red }
        $Task = ''
    }
    Write-Host 'Bye.' -ForegroundColor DarkGray
}

Start-CU -Task ($args -join ' ')
