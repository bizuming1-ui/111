function Get-Pct([double[]]$v, [double]$p) { if ($v.Count -eq 0) { return $null }; $s = $v | Sort-Object; $i = [Math]::Min($s.Count - 1, [Math]::Max(0, [int][Math]::Ceiling($p / 100.0 * $s.Count) - 1)); return [Math]::Round($s[$i], 2) }
if ($OtlpFile -and (Test-Path -LiteralPath $OtlpFile)) {
    $cap = [System.Collections.Generic.List[double]]::new()
    try {
        $doc = Get-Content -LiteralPath $OtlpFile -Raw | ConvertFrom-Json -Depth 30
        foreach ($rs in @($doc.resourceSpans)) { foreach ($ss in @($rs.scopeSpans)) { foreach ($sp in @($ss.spans)) {
                    $plane = ''; foreach ($at in @($sp.attributes)) { if ($at.key -match 'plane') { $plane = "$($at.value.stringValue)" } }
                    if ($plane -eq 'capture' -or $sp.name -match '^capture') { $cap.Add(([double]$sp.endTimeUnixNano - [double]$sp.startTimeUnixNano) / 1e6) } } } }
    }
    catch { Rec 'gate' 'OTLP 解析' 'FAIL' $_.Exception.Message }
    if ($cap.Count -gt 0) {
        $p50 = Get-Pct $cap 50; $p99 = Get-Pct $cap 99
        Rec 'gate' "OTLP capture 跨度 P99 < 5 ms（基线 GDI P99 41.66 ms）" $(if ($p99 -lt 5) { 'PASS' } else { 'FAIL' }) "n=$($cap.Count) P50=$p50 ms P99=$p99 ms"
        Metric 'capture P50 / P99 (ms)' '17.59 / 41.66（GDI）' "$p50 / $p99" '前=日志任务 #1；后=-OtlpFile'
    }
    else { Rec 'gate' 'OTLP capture 跨度' 'SKIP' '文件里没有 capture 平面的 span（先 driver start，再跑任务，再 -ExportOtel）' }
}
else { Rec 'gate' 'OTLP capture P99 < 5 ms' 'SKIP' '需要 -OtlpFile <任务期间导出的 OTLP JSON>（driver 在线时 capture 走 DXGI 零拷贝）' }

$canRun = $ScriptPath -and (Test-Path -LiteralPath $ScriptPath) -and $IsWindows
if ($Gates -and $canRun) {
    $pw = (Get-Process -Id $PID).Path
    $out = & $pw -NoProfile -ExecutionPolicy Bypass -File $ScriptPath -VerifyPhase7 2>&1 | Out-String
    Rec 'gate' 'v9 verify（-VerifyPhase7）：无 FAIL' $(if ($LASTEXITCODE -eq 0 -and $out -notmatch '\[FAIL\]') { 'PASS' } else { 'FAIL' }) (Limit-Text (($out -split "`n" | Where-Object { $_ -match 'PASS|FAIL|SKIP' } | Select-Object -Last 1)) 120)
    $gold = Join-Path ([System.IO.Path]::GetTempPath()) 'dscu-regress-golden.json'
    & $pw -NoProfile -ExecutionPolicy Bypass -File $ScriptPath -RedTeam -NoDriver -NoSpans -GoldenTrace $gold *> $null
    $gv = & $pw -NoProfile -ExecutionPolicy Bypass -File $ScriptPath -VerifyGolden $gold 2>&1 | Out-String
    Rec 'gate' '-VerifyGolden：Golden-Trace 100% 等价（新动作不改变既有裁决）' $(if ($LASTEXITCODE -eq 0) { 'PASS' } else { 'FAIL' }) (Limit-Text ($gv -replace '\s+', ' ') 120)
}
elseif ($Gates) { Rec 'gate' 'v9 verify / -VerifyGolden' 'SKIP' '需要 Windows + -ScriptPath <保存的脚本文件>' }

if ($Live) {
    if (-not $canRun) { Rec 'live' '实机端到端' 'SKIP' '需要 Windows + -ScriptPath' }
    elseif (-not $env:DEEPSEEK_API_KEY) { Rec 'live' '实机端到端' 'SKIP' '需要环境变量 DEEPSEEK_API_KEY' }
    else {
        $pw = (Get-Process -Id $PID).Path
        foreach ($case in @(@{ n = 'A 记事本保存'; t = $taskA; max = 14 }, @{ n = 'B 抖音热榜'; t = $taskB; max = 8 })) {
            Write-Host "  实机运行：$($case.n) ..." -ForegroundColor Cyan
            $o = & $pw -NoProfile -ExecutionPolicy Bypass -File $ScriptPath -Task $case.t -Once 2>&1 | Out-String
            $steps = ([regex]::Matches($o, '── 第 (\d+) 步 ──') | ForEach-Object { [int]$_.Groups[1].Value } | Measure-Object -Maximum).Maximum
            $done = $o -match '✔ 完成'; $ast = ([regex]::Matches($o, 'SECURITY_AST_VIOLATION')).Count; $rep = ([regex]::Matches($o, 'REPEAT_EFFECT')).Count
            $cdpN = ([regex]::Matches($o, 'Perception: CDP')).Count; $stall = ([regex]::Matches($o, 'SEMANTIC_STALL|语义停滞')).Count
            Rec 'live' "$($case.n)：成功且步数 ≤ $($case.max)，0 次 AST 误拦 / 0 次 REPEAT_EFFECT" $(if ($done -and $steps -le $case.max -and $ast -eq 0 -and $rep -eq 0) { 'PASS' } else { 'FAIL' }) "steps=$steps done=$done ast=$ast repeat=$rep cdp感知轮=$cdpN stall=$stall"
            if ($case.n -like 'B*') { Metric '热榜任务模型步数（实测）' '32 步失败' "$steps 步 $(if ($done) { '成功' } else { '未完成' })" '后=-Live 实机' }
            if ($ReportDir) { [void][System.IO.Directory]::CreateDirectory($ReportDir); $o | Set-Content -LiteralPath (Join-Path $ReportDir ("live-" + ($case.n -replace '\W', '_') + '.log')) -Encoding UTF8 }
        }
    }
}

# =============================================================================================
# 量化对比报告
# =============================================================================================
Write-Host "`n量化对比（运行日志 → v9.1）" -ForegroundColor Cyan
foreach ($k in $metrics.Keys) { $m = $metrics[$k]; Write-Host ("  {0,-34} 前: {1,-22} 后: {2,-26} [{3}]" -f $k, $m.Before, $m.After, $m.Source) }
$pass = @($rows | Where-Object Status -eq 'PASS').Count; $fail = @($rows | Where-Object Status -eq 'FAIL').Count; $skip = @($rows | Where-Object Status -eq 'SKIP').Count
Write-Host ("`n结果：PASS {0} · FAIL {1} · SKIP {2}（SKIP = 缺少 Windows / 驱动 / 密钥等条件，不计为通过）" -f $pass, $fail, $skip) -ForegroundColor $(if ($fail -eq 0) { 'Green' } else { 'Red' })
if ($ReportDir -or $Json) {
    $dir = if ($ReportDir) { $ReportDir } else { Join-Path ([System.IO.Path]::GetTempPath()) 'dscu-regress' }
    [void][System.IO.Directory]::CreateDirectory($dir)
    $path = Join-Path $dir ("log-regression-{0}.json" -f (Get-Date -Format 'yyyyMMdd-HHmmss'))
    [pscustomobject]@{ version = '9.1-phase7.1'; pass = $pass; fail = $fail; skip = $skip; metrics = $metrics; rows = $rows } | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath $path -Encoding UTF8
    Write-Host "报告：$path" -ForegroundColor DarkGray
}
if ($InSession) { return [pscustomobject]@{ Pass = $pass; Fail = $fail; Skip = $skip } }
exit $(if ($fail -eq 0) { 0 } else { 1 })
#=#=# FILE: scripts/build-and-run-v92.ps1
#Requires -Version 7.0
<#
.SYNOPSIS
  DeepSeek Computer Use v9.2 — 一键「释放 → 编译 → 测试 → 启动 → 联动自检」：
    Rust   crates/dscu-driver   （IDXGIOutputDuplication 共享内存环 DsV9Ring · UIA/JAB · uiAccess 签名穿透 · WindowsAccessBridge-64.dll 探测）
    TS     packages/cdp-daemon  （独立轻量 CDP 守护：navigate / waitSelector / rows 行模型）
    Python agent-brain          （asyncio 大脑：复合数量配额 / 状态条件账本 / 空响应自愈 / Micro-Reflection，仅标准库）
  接管命名管道 \\.\pipe\dscu-driver-v1；常驻内存（dscu-driver.exe + cdp-daemon）< 150 MB；MemoryFloorMB=4096 硬熔断；Radeon 780M 视觉侧车懒加载 + 180s 空闲卸载。
  缺任何工具链 = 明确 SKIP（computer use 自动回退 GDI / 内置 DsCdp63，功能不受影响）；绝不假 PASS。
.EXAMPLE   pwsh -File scripts\build-and-run-v92.ps1                 # 完整
.EXAMPLE   pwsh -File scripts\build-and-run-v92.ps1 -AutoInstall    # 缺 Rust / Node / Python 时用 winget 安装（需要联网，VS BuildTools 约 2–6 GB）
.EXAMPLE   pwsh -File scripts\build-and-run-v92.ps1 -SignUiAccess   # 额外做 uiAccess="true" 签名部署（管理员，安装到 %ProgramFiles%\DeepSeekComputerUse）
#>
[CmdletBinding()]
param(
    [string]$Root = (Split-Path -Parent $PSScriptRoot),
    [switch]$SkipTests, [switch]$NoStart, [switch]$NoDriver, [switch]$NoCdp, [switch]$NoBrain,
    [switch]$AutoInstall, [switch]$SignUiAccess,
    [int]$CdpPort = 9222, [int]$MemBudgetMB = 150, [int]$MemoryFloorMB = 4096
)
$ErrorActionPreference = 'Continue'
$rows = [System.Collections.Generic.List[object]]::new()
function Rec([string]$Name, [string]$Status, [string]$Detail = '') {
    $rows.Add([pscustomobject]@{ Name = $Name; Status = $Status; Detail = $Detail })
    $c = @{ PASS = 'Green'; FAIL = 'Red'; SKIP = 'DarkYellow'; INFO = 'Cyan' }[$Status]
    Write-Host (' [{0}] {1}  {2}' -f $Status, $Name, $Detail) -ForegroundColor $c
}
function Has([string]$n) { [bool](Get-Command $n -ErrorAction SilentlyContinue) }
function Update-SessionPath { $env:Path = ([Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User')) + ';' + (Join-Path $env:USERPROFILE '.cargo\bin') }
function Tail([string]$s, [int]$n = 3) { (($s -split "`n" | Where-Object { $_.Trim() } | Select-Object -Last $n) -join ' | ') }
$bin = Join-Path $env:LOCALAPPDATA 'DeepSeekComputerUse\dscu-driver\bin'
$started = [System.Collections.Generic.List[System.Diagnostics.Process]]::new()
Write-Host "v9.2 build-and-run  root=$Root" -ForegroundColor Cyan

# ---------- 1) 工具链探测（可选 winget 自动安装） ----------
if ($AutoInstall -and (Has 'winget')) {
    $want = @()
    if (-not (Has 'cargo') -and -not (Test-Path (Join-Path $env:USERPROFILE '.cargo\bin\cargo.exe'))) { $want += @('Rustlang.Rustup') }
    if (-not (Has 'node')) { $want += 'OpenJS.NodeJS.LTS' }
    if (-not (Has 'python') -and -not (Has 'py')) { $want += 'Python.Python.3.12' }
    foreach ($id in $want) { Write-Host "  winget install $id ..." -ForegroundColor DarkGray; winget install --id $id -e --silent --accept-package-agreements --accept-source-agreements | Out-Null }
    $vsw = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe'
    $hasMsvc = (Test-Path $vsw) -and [bool](& $vsw -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath 2>$null)
    if (-not $hasMsvc) { Write-Host '  安装 VS 2022 BuildTools（C++ 工作负载，较大）...' -ForegroundColor DarkGray; winget install --id Microsoft.VisualStudio.2022.BuildTools -e --silent --accept-package-agreements --accept-source-agreements --override '--quiet --wait --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended' | Out-Null }
    Update-SessionPath
    if (Has 'rustup') { rustup default stable-x86_64-pc-windows-msvc 2>&1 | Out-Null }
}
elseif ($AutoInstall) { Rec 'winget' 'SKIP' '未找到 winget，请手动安装 Rust / Node LTS / Python 3.12' }
Update-SessionPath
$cargo = Get-Command cargo -ErrorAction SilentlyContinue
$nodeVer = $null; if (Has 'node') { try { $nodeVer = [version]((node -v).TrimStart('v')) } catch { } }
$py = $null; foreach ($cand in @('python', 'py')) { if (-not $py -and (Has $cand)) { $py = $cand } }
$pyVer = $null; if ($py) { try { $pyVer = [version]((& $py -c 'import sys;print("%d.%d.%d"%sys.version_info[:3])').Trim()) } catch { } }
$vsw2 = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe'
$msvc = (Test-Path $vsw2) -and [bool](& $vsw2 -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath 2>$null)
Rec 'cargo (Rust)' $(if ($cargo) { 'PASS' } else { 'SKIP' }) $(if ($cargo) { (& $cargo.Source --version) } else { '安装：winget install Rustlang.Rustup（或加 -AutoInstall）' })
Rec 'MSVC 链接器（C++ BuildTools）' $(if ($msvc) { 'PASS' } else { 'SKIP' }) $(if ($msvc) { '已安装' } else { 'Rust windows-msvc 目标需要；winget install Microsoft.VisualStudio.2022.BuildTools' })
Rec 'node >= 22.6' $(if ($nodeVer -and $nodeVer -ge [version]'22.6') { 'PASS' } else { 'SKIP' }) $(if ($nodeVer) { "node $nodeVer" } else { '安装：winget install OpenJS.NodeJS.LTS' })
Rec 'python >= 3.10' $(if ($pyVer -and $pyVer -ge [version]'3.10') { 'PASS' } else { 'SKIP' }) $(if ($pyVer) { "python $pyVer" } else { '安装：winget install Python.Python.3.12' })
$jab = @((Join-Path $env:SystemRoot 'System32\WindowsAccessBridge-64.dll'), $(if ($env:JAVA_HOME) { Join-Path $env:JAVA_HOME 'bin\WindowsAccessBridge-64.dll' })) | Where-Object { $_ -and (Test-Path -LiteralPath $_) } | Select-Object -First 1
Rec 'WindowsAccessBridge-64.dll（Java Access Bridge）' $(if ($jab) { 'PASS' } else { 'INFO' }) $(if ($jab) { $jab } else { '未检测到：Java Swing/AWT 应用将经 UIA 兜底；需要时 jabswitch -enable' })

# ---------- 2) Rust 原生驱动 ----------
$drvWs = Join-Path $Root 'crates\dscu-driver'
$nodeOk = [bool]($nodeVer -and $nodeVer -ge [version]'22.6')
if (-not $NoDriver -and $cargo -and (Test-Path -LiteralPath $drvWs)) {
    Push-Location $drvWs
    try {
        if (-not $SkipTests) {
            $out = & $cargo.Source test -p dscu-core --release -q 2>&1 | Out-String
            Rec 'cargo test -p dscu-core（协议 / 幂等 / aHash 对拍 / 内存熔断 / v9.2 数量配额 quota.rs）' $(if ($LASTEXITCODE -eq 0) { 'PASS' } else { 'FAIL' }) (Tail (($out -split "`n" | Where-Object { $_ -match 'test result|error' }) -join "`n"))
        }
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $out = & $cargo.Source build --release -p dscu-daemon -p dscu-ffi 2>&1 | Out-String
        $okb = ($LASTEXITCODE -eq 0)
        Rec 'cargo build --release（dscu-driver.exe：DXGI IDXGIOutputDuplication 共享内存环 + UIA/JAB）' $(if ($okb) { 'PASS' } else { 'FAIL' }) $(if ($okb) { "$([int]$sw.Elapsed.TotalSeconds)s" } else { Tail $out 4 })
        if ($okb) {
            [void][System.IO.Directory]::CreateDirectory($bin)
            Get-Process dscu-driver -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
            Start-Sleep -Milliseconds 300
            Copy-Item -LiteralPath (Join-Path $drvWs 'target\release\dscu-driver.exe') -Destination $bin -Force
            if (Test-Path -LiteralPath (Join-Path $drvWs 'target\release\dscu.dll')) { Copy-Item -LiteralPath (Join-Path $drvWs 'target\release\dscu.dll') -Destination $bin -Force }
            Rec '部署 dscu-driver' 'PASS' "$bin\dscu-driver.exe"
            if ($SignUiAccess) {
                $sua = Join-Path $Root 'crates\scripts\setup-uiaccess.ps1'
                if (-not (Test-Path -LiteralPath $sua)) { $sua = Join-Path $drvWs 'scripts\setup-uiaccess.ps1' }
                $isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
                if (-not $isAdmin) { Rec 'uiAccess 签名穿透' 'SKIP' '需要管理员 PowerShell（右键「以管理员身份运行」后重跑 -SignUiAccess）' }
                elseif (-not (Test-Path -LiteralPath $sua)) { Rec 'uiAccess 签名穿透' 'SKIP' "找不到 setup-uiaccess.ps1" }
                else { $o = & pwsh -NoProfile -ExecutionPolicy Bypass -File $sua -DriverExe (Join-Path $bin 'dscu-driver.exe') 2>&1 | Out-String; Rec 'uiAccess 签名穿透（mt.exe 清单 + signtool + %ProgramFiles% 安全位置）' $(if ($LASTEXITCODE -eq 0) { 'PASS' } else { 'FAIL' }) (Tail $o 2) }
            }
        }
    }
    finally { Pop-Location }
}
elseif (-not $NoDriver) { Rec '驱动编译' 'SKIP' $(if (-not $cargo) { '未装 Rust（computer use 自动回退 GDI 抓屏，功能不受影响）' } else { "找不到 $drvWs" }) }

# ---------- 3) TypeScript CDP 守护 ----------
$cdpDir = Join-Path $Root 'packages\cdp-daemon'
if (-not $NoCdp -and $nodeOk -and (Test-Path -LiteralPath $cdpDir)) {
    Push-Location $cdpDir
    try {
        if (-not $SkipTests) {
            $out = & node --experimental-transform-types --no-warnings --test 'test/bridge.test.ts' 'test/actions.test.ts' 'test/rows.test.ts' 2>&1 | Out-String
            $m = [regex]::Match($out, '# pass (\d+)[\s\S]*?# fail (\d+)')
            Rec 'node:test cdp-daemon（navigate / waitSelector / settled / 污点 / v9.2 行模型 rows）' $(if ($m.Success -and $m.Groups[2].Value -eq '0') { 'PASS' } else { 'FAIL' }) "pass=$($m.Groups[1].Value) fail=$($m.Groups[2].Value)"
        }
        & node --no-warnings build-dist.mjs 2>&1 | Out-Null
        Rec 'cdp-daemon 预编译为纯 JS（常驻 RSS 约 45 MB）' $(if (Test-Path -LiteralPath (Join-Path $cdpDir 'dist\index.js')) { 'PASS' } else { 'FAIL' }) 'dist/*.js'
    }
    finally { Pop-Location }
}
elseif (-not $NoCdp) { Rec 'CDP 守护' 'SKIP' $(if (-not $nodeOk) { '需要 node >= 22.6（computer use 自带 DsCdp63 C# 引擎，功能不受影响）' } else { "找不到 $cdpDir" }) }

# ---------- 4) Python agent-brain ----------
$brainDir = Join-Path $Root 'agent-brain'
$pyOk = [bool]($pyVer -and $pyVer -ge [version]'3.10')
if (-not $NoBrain -and $pyOk -and (Test-Path -LiteralPath $brainDir)) {
    if (-not $SkipTests) {
        Push-Location $brainDir
        try { $out = & $py -m unittest discover -s tests 2>&1 | Out-String; Rec 'python unittest agent-brain（配额 / 状态账本 / 空响应重试 / Micro-Reflection）' $(if ($LASTEXITCODE -eq 0) { 'PASS' } else { 'FAIL' }) (Tail $out 2) }
        finally { Pop-Location }
    }
}
elseif (-not $NoBrain) { Rec 'agent-brain' 'SKIP' $(if (-not $pyOk) { '需要 python >= 3.10（PowerShell 内置同一套 v9.2 认知层，功能不受影响）' } else { "找不到 $brainDir" }) }

# ---------- 5) 启动并接管管道 ----------
if (-not $NoStart) {
    $drvExe = Join-Path $bin 'dscu-driver.exe'
    if (-not $NoDriver -and (Test-Path -LiteralPath $drvExe)) {
        Get-Process dscu-driver -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
        $p = Start-Process -FilePath $drvExe -ArgumentList @('--memory-floor-mb', "$MemoryFloorMB", '--sidecar-ttl', '180') -WindowStyle Hidden -PassThru
        $started.Add($p); Rec "启动 dscu-driver（MemoryFloorMB=$MemoryFloorMB 硬熔断；Radeon 780M 侧车懒加载 + 180s 空闲卸载）" 'INFO' "pid=$($p.Id)"
    }
    if (-not $NoCdp -and $nodeOk -and (Test-Path -LiteralPath (Join-Path $cdpDir 'dist\index.js'))) {
        Get-CimInstance Win32_Process -Filter "Name='node.exe'" -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -match 'cdp-daemon|dist[\\/]index\.js' -and $_.CommandLine -match 'max-old-space-size=64' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }
        $psi = [System.Diagnostics.ProcessStartInfo]::new('node'); $psi.WorkingDirectory = $cdpDir; $psi.UseShellExecute = $false; $psi.CreateNoWindow = $true
        foreach ($a in @('--no-warnings', '--max-old-space-size=64', 'dist/index.js')) { [void]$psi.ArgumentList.Add($a) }
        $psi.Environment['DSCU_CDP_PORT'] = "$CdpPort"
        $p = [System.Diagnostics.Process]::Start($psi); $started.Add($p); Rec '启动 cdp-daemon（Node，--max-old-space-size=64）' 'INFO' "pid=$($p.Id) CDP :$CdpPort"
    }
    if ($started.Count -gt 0) {
        Start-Sleep -Milliseconds 2500
        $pipes = @(); try { $pipes = [System.IO.Directory]::GetFiles('\\.\pipe\') } catch { }
        foreach ($pn in @(@{ n = 'dscu-driver-v1'; on = ((-not $NoDriver) -and (Test-Path -LiteralPath $drvExe)) }, @{ n = 'dscu-cdp-bridge-v1'; on = ((-not $NoCdp) -and $nodeOk) })) {
            if (-not $pn.on) { continue }
            $hit = @($pipes | Where-Object { $_ -like "*$($pn.n)" }).Count -gt 0
            Rec "命名管道 \\.\pipe\$($pn.n)" $(if ($hit) { 'PASS' } else { 'FAIL' }) $(if ($hit) { '在线（已接管）' } else { '未出现（进程可能已退出：检查杀软 / 端口占用）' })
        }
        # JSON-RPC 握手 + capture.frame 往返 P50（驱动在线时实测；DXGI 共享内存环，不经管道拷贝像素）
        if (@($pipes | Where-Object { $_ -like '*dscu-driver-v1' }).Count -gt 0) {
            try {
                $cl = [System.IO.Pipes.NamedPipeClientStream]::new('.', 'dscu-driver-v1', [System.IO.Pipes.PipeDirection]::InOut); $cl.Connect(3000)
                $wr = [System.IO.StreamWriter]::new($cl, [System.Text.UTF8Encoding]::new($false)); $wr.AutoFlush = $true; $rd = [System.IO.StreamReader]::new($cl, [System.Text.Encoding]::UTF8)
                $tokF = Join-Path $env:LOCALAPPDATA 'DeepSeekComputerUse\driver.token'; $tok = if (Test-Path -LiteralPath $tokF) { (Get-Content -LiteralPath $tokF -Raw).Trim() } else { '' }
                $call = { param($id, $m, $pr) $wr.WriteLine((@{ jsonrpc = '2.0'; v = 1; id = $id; method = $m; params = $pr; auth = $tok } | ConvertTo-Json -Compress -Depth 5)); $rd.ReadLine() | ConvertFrom-Json }
                $pg = & $call 1 'driver.ping' @{}
                Rec 'JSON-RPC 握手 driver.ping' $(if ($pg.result) { 'PASS' } else { 'FAIL' }) (($pg | ConvertTo-Json -Compress -Depth 4).Substring(0, [Math]::Min(120, ($pg | ConvertTo-Json -Compress -Depth 4).Length)))
                $ts = [System.Collections.Generic.List[double]]::new(); $okc = 0; $errMsg = ''
                for ($i = 0; $i -lt 48; $i++) {
                    $sw = [System.Diagnostics.Stopwatch]::StartNew(); $r = & $call (10 + $i) 'capture.frame' @{ x = 0; y = 0; w = 640; h = 360; timeoutMs = 250 }; $ms = $sw.Elapsed.TotalMilliseconds
                    if ($r.result) { $okc++; if ($i -ge 8) { $ts.Add($ms) } } elseif (-not $errMsg) { $errMsg = "$($r.error.message)" }
