"""Executors = the hands of each layer.  All speak ObservationEnvelope / ActionRequest / ActionResult."""
from __future__ import annotations

import asyncio
import os
import subprocess
import time
from typing import Protocol

from .native_files import locate_file, save_text, verify_text_file
from .protocol import ActionRequest, ActionResult, ErrorCode, ObservationEnvelope, Ref
from .security import SecurityDenied, SecurityPolicy
from .transport import Transport


class Executor(Protocol):
    async def observe(self) -> ObservationEnvelope: ...
    async def act(self, req: ActionRequest) -> ActionResult: ...


def _res(req: ActionRequest, ok: bool, code: str = "OK", msg: str = "", t0: float = 0.0, **kw) -> ActionResult:
    return ActionResult(req.action_id, ok, code, msg, elapsed_ms=round((time.perf_counter() - t0) * 1000, 2), **kw)


class NativeFileExecutor:
    """Layer 0 (native safe file primitives).  Every path goes through SecurityPolicy first."""

    def __init__(self, policy: SecurityPolicy):
        self.policy = policy

    async def observe(self) -> ObservationEnvelope:
        return ObservationEnvelope("cli", 0, [], text="native-file layer (no GUI)")

    async def act(self, req: ActionRequest) -> ActionResult:
        t0 = time.perf_counter()
        a = req.args or {}
        try:
            if req.action == "save_text":
                r = await asyncio.to_thread(save_text, self.policy, a["folder"], a["name"], a.get("content", ""),
                                            on_exists=a.get("on_exists", "rename"))
                return _res(req, r["ok"], "OK" if r["ok"] else ErrorCode.ARTIFACT_INVALID.value,
                            f"saved {r['path']} ({r['bytes']} bytes{', renamed' if r['renamed'] else ''})", t0, data=r)
            if req.action == "verify_text_file":
                self.policy.check(a["path"], "read")
                r = await asyncio.to_thread(verify_text_file, a["path"], a.get("expect_text"))
                return _res(req, r["ok"], "OK" if r["ok"] else ErrorCode.ARTIFACT_INVALID.value, str(r), t0, data=r)
            if req.action == "locate_file":
                r = await asyncio.to_thread(locate_file, self.policy, a["name"])
                return _res(req, bool(r), "OK" if r else ErrorCode.ARTIFACT_INVALID.value, f"{len(r)} match(es)", t0,
                            data={"matches": r})
            if req.action == "open_app":                          # cosmetic: show the saved file in its app
                path = self.policy.check(a["path"], "read")
                if os.name == "nt":
                    exe = a.get("exe", "notepad.exe")
                    subprocess.Popen([exe, str(path)], close_fds=True)         # list argv: no shell, no injection
                return _res(req, True, "OK", f"opened {path.name}", t0)
        except SecurityDenied as e:
            return _res(req, False, ErrorCode.SECURITY_DENIED.value, str(e), t0)
        except (KeyError, OSError, FileExistsError) as e:
            return _res(req, False, ErrorCode.INTERNAL.value, f"{type(e).__name__}: {e}", t0)
        return _res(req, False, ErrorCode.UNSUPPORTED.value, f"native layer cannot do {req.action}", t0)


class _WireExecutor:
    layer_channel = "uia"

    def __init__(self, transport: Transport):
        self.t = transport

    @staticmethod
    def _env(channel: str, r: dict) -> ObservationEnvelope:
        refs = [Ref(x["ref"], x.get("role", ""), x.get("name", ""), x.get("zone", "Unknown"), int(x.get("epoch", 0)),
                    x.get("box"), x.get("row")) for x in r.get("refs", [])]
        return ObservationEnvelope(channel, int(r.get("epoch", r.get("snapshot_epoch", 0))), refs,
                                   window_title=r.get("window_title", ""), process=r.get("process", ""),
                                   fingerprint=r.get("fingerprint", ""), row_count=r.get("row_count"), text=r.get("text", ""))

    async def observe(self) -> ObservationEnvelope:
        r = await self.t.call({"cmd": "snapshot"})
        if not r.get("ok", False):
            return ObservationEnvelope(self.layer_channel, 0, [], text=f"observe failed: {r.get('error', r.get('code'))}")
        return self._env(self.layer_channel, r)

    async def act(self, req: ActionRequest) -> ActionResult:
        t0 = time.perf_counter()
        msg = {"cmd": "act", "v": 1, "action_id": req.action_id, "action": req.action, "target": req.target,
               "args": req.args, "expect_epoch": req.expect_epoch}
        r = await self.t.call({k: v for k, v in msg.items() if v is not None}, 15.0)
        ok = bool(r.get("ok"))
        return ActionResult(req.action_id, ok, r.get("code", "OK" if ok else ErrorCode.INTERNAL.value),
                            str(r.get("message", r.get("error", ""))), r.get("effect_changed"), r.get("epoch"),
                            round((time.perf_counter() - t0) * 1000, 2), r.get("data", {}))


class CdpExecutor(_WireExecutor):
    layer_channel = "cdp"


class DriverExecutor(_WireExecutor):
    layer_channel = "uia"
