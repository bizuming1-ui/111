"""STEP 1 LIVE ACCEPTANCE - no mocks. Run on the target Windows machine AFTER scripts\\build_step1.ps1.
  python tests\\verify_step1_live.py [--url https://example.com] [--frames 100]
Proves, with real telemetry printed to the console and saved to verify_step1_report.json:
  1. REAL DXGI takeover : capture_backend=DXGI, 100-frame P50 < 5 ms  (explicit GDI fallback reason if it ever falls back)
  2. REAL Python control: Brain.run_task drives Chrome (TS CDP: navigate + live DOM) and Notepad (Rust UIA/SendInput: type + save)
  3. REAL resource water-line: Python + Rust + TS resident memory < 220 MB (Chrome / Notepad themselves are the apps under control)"""
from __future__ import annotations

import argparse
import asyncio
import json
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from agent_brain import memwatch  # noqa: E402
from agent_brain.ipc_client import IpcClient  # noqa: E402
from agent_brain.orchestrator import Brain  # noqa: E402
from agent_brain.protocol import ActionRequest  # noqa: E402

P50_LIMIT_MS, MEM_LIMIT_MB = 5.0, 220.0
report: dict = {"ts": time.strftime("%Y-%m-%d %H:%M:%S"), "checks": {}}


def verdict(name: str, ok: bool, detail: str) -> bool:
    report["checks"][name] = {"pass": ok, "detail": detail}
    print(f"\n[{'PASS' if ok else 'FAIL'}] {name}\n       {detail}")
    return ok


async def activity(addr: str, seconds: float) -> None:
    """Generate REAL desktop changes during the benchmark (typing into the focused Notepad) so fresh DXGI frames occur."""
    c = IpcClient(addr, "activity")
    await c.connect(retries=5)
    t0 = time.perf_counter()
    while time.perf_counter() - t0 < seconds:
        await c.act(ActionRequest.new("type", args={"text": "dxgi frame stimulus ", "per_char_ms": 25}))
        await asyncio.sleep(0.05)
    await c.close()


async def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--url", default="https://example.com")
    ap.add_argument("--frames", type=int, default=100)
    a = ap.parse_args()
    if sys.platform != "win32":
        print("This acceptance test must run on Windows (DXGI / UIA / SendInput). For Linux CI use tests/live_cdp_test.py")
        return 2
    brain = Brain(api_key=None, interactive=False, prefer_layer0=False)
    await brain.start()
    ok_all = True
    try:
        info = brain.driver_info
        if brain.using_fallback:
            ok_all &= verdict("0. native driver present", False, "dscu-driver.exe is not running (Python ctypes fallback active). Run scripts\\build_step1.ps1 first.")
            return 1
        # ── Check 1: DXGI takeover ──
        await brain.act(ActionRequest.new("launch", args={"target": "notepad.exe"}), "driver")
        await asyncio.sleep(1.5)
        stim = asyncio.create_task(activity(brain.cfg.driver_addr, 4.0))
        bench = await brain.driver.call("bench", {"frames": a.frames, "readback": True, "w": 640, "h": 360, "pace_ms": 8}, timeout=120)
        await stim
        print("\n── dscu-driver bench ──\n" + json.dumps(bench, ensure_ascii=False, indent=2))
        report["bench"] = bench
        dx = bench["capture_backend"] == "DXGI" and bench["gdi_frames"] == 0
        ok_all &= verdict("1. REAL DXGI takeover", dx and bench["p50_ms"] < P50_LIMIT_MS,
                          f"capture_backend={bench['capture_backend']} adapter={bench.get('adapter')} frames={bench['frames']} P50={bench['p50_ms']:.2f}ms P95={bench['p95_ms']:.2f}ms "
                          f"fresh_frames={bench['fresh_frames']} (fresh P50={bench['fresh_p50_ms']:.2f}ms) dirty_rects_total={bench['dirty_rects_total']} fallback_reason={bench.get('fallback_reason')}")
        # ── Check 2: Python brain drives Chrome (TS CDP) and Notepad (Rust UIA/SendInput) ──
        r1 = await brain.run_task(f"用 Chrome 打开 {a.url} 并读取标题", mode="skill")
        report["chrome"] = r1.detail
        ok_chrome = r1.ok and bool(r1.detail.get("title")) and r1.detail.get("elements", 0) > 0
        ok_all &= verdict("2a. Python Brain -> TS CDP -> real Chrome (navigate + live DOM)", ok_chrome, f"title={r1.detail.get('title')!r} url={r1.detail.get('url')} elements={r1.detail.get('elements')} cdp_timing={r1.detail.get('timing')}")
        name = f"dscu_verify_{int(time.time())}"
        text = "DSCU Step1 live: 统一大脑 · Rust UIA/SendInput"
        r2 = await brain.run_task(f"打开一个记事本，输入{text}，命名为{name}，保存在桌面", mode="skill")
        report["notepad"] = r2.detail
        ok_all &= verdict("2b. Python Brain -> Rust UIA/SendInput -> real Notepad (type + save + byte verify)", r2.ok, json.dumps(r2.detail.get("stat", r2.detail), ensure_ascii=False)[:300])
        # ── Check 3: resident memory of the whole multi-language stack ──
        await asyncio.sleep(0.5)
        pids = dict(brain.sup.pids())
        if not pids:  # processes were started by build_step1.ps1: ask them for their own pid
            pids["dscu-driver"] = int((await brain.driver.call("info")).get("pid", 0))
            if brain.cdp:
                pids["cdp-daemon"] = int((await brain.cdp.call("info")).get("pid", 0))
        mem = memwatch.stack_report(pids)
        report["memory_mb"] = mem
        ok_all &= verdict("3. resident memory water-line", mem["total"] < MEM_LIMIT_MB, f"total={mem['total']} MB (limit {MEM_LIMIT_MB}) breakdown={mem}  | old single-file PowerShell peak was 812 MB; host free RAM now {memwatch.free_mb()} MB")
        print(f"\nlatency (driver): {json.dumps(brain.driver.stats(), ensure_ascii=False)}")
        report["latency"] = {"driver": brain.driver.stats(), "cdp": brain.cdp.stats() if brain.cdp else {}}
    finally:
        report["pass"] = ok_all
        (ROOT / "verify_step1_report.json").write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
        await brain.stop()
    print("\n" + ("=== STEP 1 ACCEPTED: all 3 live checks passed ===" if ok_all else "=== STEP 1 NOT ACCEPTED: see FAIL lines above ==="))
    return 0 if ok_all else 1


if __name__ == "__main__":
    sys.exit(asyncio.run(main()))
