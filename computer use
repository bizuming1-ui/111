//! Wire protocol v1 helpers (schemas/protocol_v1.json is the single source of truth).
//! Frame (NDJSON, one JSON object per line, UTF-8, LF):
//!   request : {"v":1,"id":N,"kind":"ping|info|observe|action|bench|shutdown","req":{...}}
//!   response: {"v":1,"id":N,"ok":true,"result":{...}}  |  {"v":1,"id":N,"ok":false,"error":{"code","message","retryable","data"}}
use serde_json::{json, Value};

#[derive(Debug, Clone)]
pub struct PErr {
    pub code: String,
    pub message: String,
    pub data: Option<Value>,
}

pub fn perr(code: &str, message: &str) -> PErr {
    PErr { code: code.to_string(), message: message.to_string(), data: None }
}

impl PErr {
    pub fn retryable(&self) -> bool {
        matches!(self.code.as_str(), "STALE_EPOCH" | "OCCLUDED" | "TIMEOUT" | "STALE_HWND")
    }
    pub fn to_json(&self) -> Value {
        json!({"code": self.code, "message": self.message, "retryable": self.retryable(), "data": self.data})
    }
}

pub fn ok_frame(id: &Value, result: Value) -> Value {
    json!({"v": 1, "id": id, "ok": true, "result": result})
}

pub fn err_frame(id: &Value, e: &PErr) -> Value {
    json!({"v": 1, "id": id, "ok": false, "error": e.to_json()})
}
