Layer 4: deepseek-flash SoM (`1.1s` low-latency vision fallback with circuit breaker)"""
from __future__ import annotations
from dataclasses import dataclass, asdict
import re

BROWSER_RX = re.compile(
    r"(chrome|edge|brave|gmail|网页|浏览器|http|\.com|抖音|b站|bilibili|youtube|google|邮箱|收件箱)", re.I
)
SELF_DRAWN_RX = re.compile(
    r"(微信|weixin|wechat|qq|钉钉|dingtalk|飞书|feishu|游戏|画布|canvas|webgl|远程桌面)", re.I
)


@dataclass
class LayerDecision:
    layer: int
    name: str
    channel: str
    reason: str
    directml_allowed: bool = True
    vision_detail: str = "low"

    def as_dict(self) -> dict[str, object]:
        return asdict(self)


class FiveLayerRouter:
    """Unified 5-Layer Execution Router for DSCU v11.0."""

    def __init__(self, min_free_mb: int = 4096):
        self.min_free_mb = min_free_mb

    def route(
        self,
        task: str,
        *,
        cli_hit: bool = False,
        cdp_up: bool = True,
        uia_controls: int | None = None,
        stalled: bool = False,
        blocked_streak: int = 0,
        free_mem_mb: int = 8192,
        escape_stage: int = 0,
        quota_zero: bool = False,
    ) -> LayerDecision:
        dml_ok = free_mem_mb >= self.min_free_mb

        # Layer 0: CLI-Anything / Native Safe File short-circuits GUI completely
        if cli_hit:
            return LayerDecision(
                layer=0,
                name="Layer 0 (CLI-Anything / Native Safe File)",
                channel="cli",
                reason="Matched deterministic CLI-Anything tool or Intent-Scoped Native Safe File primitive",
                directml_allowed=dml_ok,
            )

        # Layer 1: Browser / Electron via TS CDP Daemon (never escalate to Vision when Quota-Zero is reached)
        if BROWSER_RX.search(task) and cdp_up:
            if quota_zero or blocked_streak < 3:
                return LayerDecision(
                    layer=1,
                    name="Layer 1 (TS CDP Daemon)",
                    channel="cdp",
                    reason="Browser/Electron task routed to async CDP daemon with snapshot_epoch lock",
                    directml_allowed=dml_ok,
                )

        # Layer 3 / Layer 4: Self-drawn app (WeChat) or UIA blind spot (< 6 controls)
        if SELF_DRAWN_RX.search(task) or (uia_controls is not None and uia_controls < 6):
            if escape_stage == 2:
                return LayerDecision(
                    layer=4,
                    name="Layer 4 (deepseek-flash SoM 2x Crop)",
                    channel="vision",
                    reason="Self-Drawn Escape Stage 2: 2x target region high-DPI crop (detail=original) + virtual SoM",
                    directml_allowed=dml_ok,
                    vision_detail="original",
                )
            if not stalled and blocked_streak < 2:
                return LayerDecision(
                    layer=3,
                    name="Layer 3 (Rust DXGI + DirectML Sidecar)" if dml_ok else "Layer 3 (Rust DXGI Zero-Copy)",
                    channel="vision",
                    reason=f"Self-drawn UI / UIA blind spot (<6 controls); DXGI <5ms capture (free_mem={free_mem_mb}MB, dml={dml_ok})",
                    directml_allowed=dml_ok,
                    vision_detail="low",
                )
            return LayerDecision(
                layer=4,
                name="Layer 4 (deepseek-flash SoM)",
                channel="vision",
                reason=f"Self-drawn UI stalled/blocked={blocked_streak}; escalating to 1.1s deepseek-flash SoM",
                directml_allowed=dml_ok,
                vision_detail="original" if blocked_streak >= 2 else "low",
