function Write-Log([hashtable]$entry) {
    if ($ObserveOnly -or -not $script:LogFile) { return }
    try {
        $entry['time'] = (Get-Date).ToString('o')
        $entry['taskNo'] = $script:TaskNo
        $line = $entry | ConvertTo-Json -Compress -Depth 6
        # v6.4：常驻 StreamWriter（不再每行打开 / 关闭文件）+ SHA-256 哈希链（chain = H(prev + line)，任何一行被篡改 / 删除都会让后续链断裂）
        if ($null -eq $script:LogWriter) {
            $fs = [System.IO.FileStream]::new($script:LogFile, [System.IO.FileMode]::Append, [System.IO.FileAccess]::Write, [System.IO.FileShare]::ReadWrite)
            $script:LogWriter = [System.IO.StreamWriter]::new($fs, [System.Text.UTF8Encoding]::new($false)); $script:LogChain = ''
        }
        $hb = [System.Security.Cryptography.SHA256]::HashData([System.Text.Encoding]::UTF8.GetBytes($script:LogChain + $line))
        $script:LogChain = [Convert]::ToHexString($hb).Substring(0, 16)
        $script:LogWriter.WriteLine($line.Substring(0, $line.Length - 1) + ',"chain":"' + $script:LogChain + '"}')
        $script:LogWriter.Flush()
    }
    catch { }
}
