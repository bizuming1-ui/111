"""
v16.4 Runtime truth table: which driver is REALLY serving this session, and is DirectML REALLY doing detection?

Report item 9: the banner said `驱动=py-native` and `DirectML 侧车` but never said WHY Rust was off, nor that the DirectML model was the built-in *untrained*
Sobel-energy saliency network (= a heuristic, not a trained UI detector).  This module only reports facts it can measure:
  driver : rust-native | py-native   + reason (DSCU_FORCE_NATIVE / exe missing / build marker content / cargo present? / rust connect error)
  dml    : enabled(user model, DmlExecutionProvider) | disabled/heuristic_only (+ exact reason)  — never "enabled" for the built-in untrained network.
Results are JSON-serialisable (audit_report.json embeds them) and rendered as single log lines for the banner and for every task settlement.
"""
from __future__ import annotations

import json
import os
import shutil
from pathlib import Path
from typing import Any


def _read_marker(root: Path) -> dict[str, Any]:
    p = root / "bin" / "driver-build.json"
    try:
        return json.loads(p.read_text(encoding="utf-8")) if p.exists() else {}
    except Exception:  # noqa: BLE001
        return {"unreadable": True}


def driver_report(hub: Any, cfg: Any) -> dict[str, Any]:
    kind = str(getattr(hub, "driver_kind", "none"))
    root = Path(str(getattr(cfg, "root", ".")))
    exe = Path(str(getattr(cfg, "driver_exe", root / "bin" / "dscu-driver.exe")))
    hello = getattr(hub, "driver_hello", {}) or {}
    marker = _read_marker(root)
    reasons: list[str] = []
    if kind != "rust-native":
        if getattr(cfg, "force_native", False):
            reasons.append("DSCU_FORCE_NATIVE=1")
        if not exe.exists():
            reasons.append(f"未找到 {exe.name}（尚未编译）")
            if marker:
                reasons.append(f"上次构建标记: toolchain={marker.get('toolchain')} reason={str(marker.get('reason', ''))[:80]}")
            elif not shutil.which("cargo"):
                reasons.append("未检测到 cargo/Rust 工具链（运行 DSCU_MODE=build-driver 一键安装 GNU 工具链，无需 Visual Studio）")
            else:
                reasons.append("检测到 cargo 但从未构建（DSCU_MODE=build-driver 或 DSCU_DRIVER_RETRY=1）")
        if hello.get("rust_error"):
            reasons.append(f"Rust 驱动启动/握手失败: {str(hello['rust_error'])[:100]}")
    return {"tier": kind, "rust_active": kind == "rust-native", "exe": str(exe), "exe_exists": exe.exists(), "marker": marker, "reasons": reasons,
            "hello": {k: hello.get(k) for k in ("peer", "version", "uiaccess", "elevated", "dxgi_active", "dxgi_reason") if k in hello}}


def dml_report() -> dict[str, Any]:
    """v17: facts only.  state = enabled (TRAINED model bound to DmlExecutionProvider) | cpu_fallback | disabled (+ exact reason)."""
    out: dict[str, Any] = {"state": "disabled", "provider": None, "model": None, "model_kind": None, "reason": "", "inferences": 0, "ort_providers": [], "sha256": "",
                           "p50_ms": 0.0, "p95_ms": 0.0}
    if os.environ.get("DSCU_DML") == "0":
        out["reason"] = "DSCU_DML=0（已关闭）"
        return out
    try:
        from sidecar import dml_detector as dml

        d = dml.get()
        ev, stt = d.evidence(), d.status()
        lat = ev.get("latency_ms", {})
        out.update(state=ev.get("state", "disabled"), provider=ev.get("execution_provider_bound"), model=ev.get("model_file"), model_kind=ev.get("model_kind"), inferences=ev.get("inferences", 0),
                   ort_providers=stt.get("providers", []), dml_available=bool(stt.get("directml")), sha256=ev.get("model_sha256", ""), p50_ms=lat.get("p50", 0.0), p95_ms=lat.get("p95", 0.0),
                   adapter=ev.get("adapter", ""), text_calls=ev.get("text_route_calls", 0), escalations=ev.get("vision_escalations", 0))
        if out["state"] != "enabled":
            why = []
            if not stt.get("model_exists"):
                why.append("模型未下载（DSCU_MODE=dml-init 自动下载并校验 SHA-256）")
            if not stt.get("directml"):
                why.append(f"onnxruntime 无 DmlExecutionProvider（providers={stt.get('providers')}）；{stt.get('reason') or ''}".strip("；"))
            if ev.get("reason"):
                why.append(str(ev["reason"])[:120])
            out["reason"] = "；".join(why) or "未加载（首次视觉轮/启动预热时加载）"
        else:
