using System;
using System.Runtime.InteropServices;
using System.Text;
// v6.3：Chromium 视口真实物理矩形（DPI 感知进程下的物理像素）
public static class DsWin63 {
    [StructLayout(LayoutKind.Sequential)] struct RECT { public int L, T, R, B; }
    [StructLayout(LayoutKind.Sequential)] struct PT { public int X, Y; }
    delegate bool EnumProc(IntPtr h, IntPtr l);
    [DllImport("user32.dll")] static extern bool GetClientRect(IntPtr h, out RECT r);
    [DllImport("user32.dll")] static extern bool ClientToScreen(IntPtr h, ref PT p);
    [DllImport("user32.dll")] static extern bool EnumChildWindows(IntPtr h, EnumProc cb, IntPtr l);
    [DllImport("user32.dll")] static extern bool IsWindowVisible(IntPtr h);
    [DllImport("user32.dll")] static extern bool GetWindowRect(IntPtr h, out RECT r);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] static extern int GetClassName(IntPtr h, StringBuilder sb, int n);
    public static int[] ClientRect(IntPtr h) {
        RECT r; if (!GetClientRect(h, out r)) return null;
        PT p = new PT(); p.X = 0; p.Y = 0; if (!ClientToScreen(h, ref p)) return null;
        return new int[] { p.X, p.Y, r.R - r.L, r.B - r.T };
    }
    public static int[] RenderRect(IntPtr top) {
        int[] best = null; long bestA = 0;
        EnumProc cb = delegate (IntPtr h, IntPtr l) {
            StringBuilder sb = new StringBuilder(64); GetClassName(h, sb, 64);
            if (sb.ToString() == "Chrome_RenderWidgetHostHWND" && IsWindowVisible(h)) {
                RECT r; if (GetWindowRect(h, out r)) { long a = (long)(r.R - r.L) * (r.B - r.T); if (a > bestA) { bestA = a; best = new int[] { r.L, r.T, r.R - r.L, r.B - r.T }; } }
            }
            return true;
        };
        EnumChildWindows(top, cb, IntPtr.Zero);
        GC.KeepAlive(cb);
        return best;
    }
}
