            ("平均耗时 s", "mean_s", False, ""), ("P95 s", "p95_s", False, ""), ("P99 s", "p99_s", False, ""), ("平均步数", "mean_steps", False, ""), ("CDP 自愈次数", "cdp_heals", True, "")]
    print(f"{'指标':<14}{A['version']:>12}{B['version']:>12}   Δ   判定\n" + "-" * 62)
