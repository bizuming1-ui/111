    x, y = point
    if target is None:
        return HitReport(False, V_TARGET_GONE, 0, point, detail="目标窗口已不存在")
    rep = HitReport(False, V_NO_WINDOW, target.hwnd, point, hit_hwnd=hit_hwnd, hit_root=hit_root.hwnd if hit_root else 0, target_rect=target.rect,
