    # ------------------------------------------------------------------ sanity
    @staticmethod
    def _sanity(st: Any, obs: Any) -> list[Check]:
        out: list[Check] = []
        if obs is not None:
            bad = [w for w in obs.windows if w.process.lower() in CRASH_PROCS or CRASH_TITLES.search(w.title or "")]
            out.append(Check("no_crash_window", not bad, "无崩溃/错误报告窗口" if not bad else f"存在 {bad[0].process}:{bad[0].title[:30]}", "sanity"))
        led = getattr(st, "ledger", [])
        if led:
            e = led[-1]
            bad = e.code != "OK" and e.action.get("action") not in ("wait", "vision_inspect", "cdp_wait_selector")
            out.append(Check("last_action_ok", not bad, f"{e.sig[:40]}→{e.code}/{e.effect}", "sanity"))
        return out

    # ------------------------------------------------------------------ entry points
    async def verify_done(self, task: str, summary: str, st: Any, obs: Any, quantity: Optional[int] = None) -> Verdict:
        checks: list[Check] = []
        for p, content in self._derive_files(task, summary):
            checks += self.check_file(p, expect_text=content)
            if p.exists():
                o = self.reg.register_file(p)
                o.set_state("sha256:" + sha256_file(p)[:16], getattr(st, "step", 0))
        checks += await self._web_checks(task, summary)
        checks += await self._quota_checks(task, quantity, obs)
        checks += await asyncio.to_thread(self._recycle_checks, task)
        substantive = [c for c in checks if c.kind in ("file", "cdp", "quota", "recycle")]
        checks += self._sanity(st, obs)
        bad = [c for c in checks if not c.ok]
        cov = "full" if substantive and len(substantive) >= 2 else "partial" if substantive else "none"
        v = Verdict(ok=not bad, checks=checks, coverage=cov)
        if bad:
            v.diagnosis = "独立验证器未放行：" + "；".join(f"{c.name}: {c.detail}" for c in bad)[:600]
            self.rejections += 1
        else:
            self.passes += 1
            if cov == "none":
                v.diagnosis = "UNVERIFIED：任务没有可程序化核对的终态（仅放行了崩溃窗口/末步错误的健全性检查）"
        self.last = v
        return v

    def verify_written_file(self, path: Path, data: bytes) -> Verdict:
        cs = self.check_file(path, expect_bytes=data)
        bad = [c for c in cs if not c.ok]
        v = Verdict(ok=not bad, checks=cs, coverage="full", diagnosis="" if not bad else "；".join(f"{c.name}:{c.detail}" for c in bad))
        if bad:
            self.rejections += 1
        else:
            self.passes += 1
            o = self.reg.register_file(path)
            o.set_state("sha256:" + sha256_file(path)[:16], 0)
        self.last = v
        return v
