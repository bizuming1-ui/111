        "pid": { "type": "integer" }, "class": { "type": "string" }, "rect": { "$ref": "#/$defs/Rect" },
        "z": { "type": "integer", "description": "0 = top of z-order" },
        "minimized": { "type": "boolean" }, "topmost": { "type": "boolean" }, "cloaked": { "type": "boolean" },
        "occluded_by": { "type": "array", "items": { "type": "integer" } },
        "own_console": { "type": "boolean" }
      }
