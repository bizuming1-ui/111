//! dscu-driver: the native half of the unified agent. Serves \\.\pipe\dscu-driver-v1 (NDJSON, protocol v1).
//!   dscu-driver.exe                       run the daemon
//!   dscu-driver.exe --selftest-dxgi 100   capture N frames, print JSON telemetry, exit (non-zero if not DXGI)
//!   dscu-driver.exe --pipe NAME           custom pipe name
mod dxgi;
mod input;
mod pipe_server;
mod protocol;
mod sys;
mod uia_ref;

use std::collections::HashMap;
use std::sync::atomic::{AtomicBool, AtomicI64};
use std::sync::{Arc, Mutex};

fn arg_val(args: &[String], k: &str) -> Option<String> {
    args.iter().position(|a| a == k).and_then(|i| args.get(i + 1).cloned())
}

fn main() {
    let args: Vec<String> = std::env::args().collect();
    sys::init_dpi();
    if args.iter().any(|a| a == "--version") {
        println!("dscu-driver {}", env!("CARGO_PKG_VERSION"));
        return;
    }
    if let Some(n) = arg_val(&args, "--selftest-dxgi") {
        let n: usize = n.parse().unwrap_or(100);
        let mut cap = dxgi::Capturer::new();
        let mut all = vec![];
        let mut fresh = vec![];
        let mut backend = "DXGI";
        for _ in 0..n {
            match cap.capture(Some(dxgi::Rect { x: 0, y: 0, w: 640, h: 360 }), true, 0) {
                Ok((s, _)) => {
                    if s.backend != "DXGI" {
                        backend = "GDI";
                    }
                    if s.fresh {
                        fresh.push(s.frame_ms);
                    }
                    all.push(s.frame_ms);
                }
                Err(e) => {
                    eprintln!("capture error: {e}");
                    std::process::exit(2);
                }
            }
        }
        let p50 = dxgi::percentile(&mut all.clone(), 0.5);
        println!("{}", serde_json::json!({"capture_backend": backend, "fallback_reason": cap.fallback_reason, "adapter": cap.adapter, "frames": n, "p50_ms": p50, "p95_ms": dxgi::percentile(&mut all, 0.95), "fresh_frames": fresh.len(), "fresh_p50_ms": dxgi::percentile(&mut fresh, 0.5)}));
        std::process::exit(if backend == "DXGI" { 0 } else { 3 });
    }
    let pipe = arg_val(&args, "--pipe").unwrap_or_else(|| "dscu-driver-v1".to_string());
    let job = input::JobGuard::create(1024).ok();
    let st = Arc::new(pipe_server::State {
        cap: Mutex::new(dxgi::Capturer::new()),
        uia: uia_ref::spawn(),
        idem: Mutex::new(HashMap::new()),
        job,
        last_target: AtomicI64::new(0),
        shutdown: AtomicBool::new(false),
        started: std::time::Instant::now(),
        pipe: pipe.clone(),
    });
    {
        let c = st.cap.lock().unwrap();
        eprintln!("[dscu-driver] pipe=\\\\.\\pipe\\{pipe} backend={} adapter={:?} fallback_reason={:?} uiaccess={} elevated={:?}", c.backend_name(), c.adapter, c.fallback_reason, sys::has_uiaccess(), sys::is_elevated(0));
    }
    if let Err(e) = pipe_server::serve(&pipe, st) {
        eprintln!("[dscu-driver] fatal: {e}");
        std::process::exit(1);
    }
}
