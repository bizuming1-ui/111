function Split-V10Chord([string]$chord) {
    $c = $chord.Trim()
    if ($c -eq '+') { return [string[]]@('+') }
    $parts = [System.Collections.Generic.List[string]]::new(); $buf = ''
    foreach ($ch in $c.ToCharArray()) {
        if ([string]$ch -eq '+') { if ($buf -eq '') { $parts.Add('+') } else { $parts.Add($buf); $buf = '' } }
        else { $buf += [string]$ch }
    }
    if ($buf -ne '') { $parts.Add($buf) }
