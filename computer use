class RealtimeController:
    """Deterministic closed-loop interaction.  `port` is an async object providing:
         foreground() -> int           focus(hwnd) -> bool          hit_root(x, y) -> int           move(x, y)         button(x, y, double=False)
         key(keys)                     type_text(text)              clipboard_get() -> str|None     clipboard_set(text)
         ime_open(hwnd) -> bool        ime_close(hwnd) -> bool      read_text(rect|None) -> str     frame_sig(rect|None) -> str    sleep(s)"""

    def __init__(self, port: Any, budget: Optional[Budget] = None, telemetry: Optional[Telemetry] = None, humanize: bool = False) -> None:
        self.port = port
        self.b = budget or Budget()
        self.tel = telemetry or Telemetry()
        self.humanize = humanize
