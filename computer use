"""Process supervisor: starts the Rust driver and the TS CDP daemon inside a Python-owned Windows JobObject
(KILL_ON_JOB_CLOSE: if the brain dies, the whole tree dies - no orphan processes holding memory). Health-checks both."""
from __future__ import annotations

import asyncio
import os
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

from .ipc_client import IpcClient, IpcError


def default_driver_addr() -> str:
    return "pipe://dscu-driver-v1" if sys.platform == "win32" else "tcp://127.0.0.1:47931"


def default_cdp_addr() -> str:
    return "pipe://dscu-cdp-v1" if sys.platform == "win32" else "unix:///tmp/dscu-cdp-v1.sock"


@dataclass
class Config:
    root: Path = field(default_factory=lambda: Path(os.environ.get("DSCU_ROOT", Path(__file__).resolve().parent.parent)))
    driver_addr: str = field(default_factory=lambda: os.environ.get("DSCU_DRIVER_ADDR", default_driver_addr()))
    cdp_addr: str = field(default_factory=lambda: os.environ.get("DSCU_CDP_ADDR", default_cdp_addr()))
    driver_exe: str = field(default_factory=lambda: os.environ.get("DSCU_DRIVER_EXE", ""))
    node_exe: str = field(default_factory=lambda: os.environ.get("DSCU_NODE", "node"))
    cdp_port: int = int(os.environ.get("DSCU_CDP_PORT", "9333"))
    spawn: bool = os.environ.get("DSCU_NO_SPAWN", "") == ""

    def resolve_driver_exe(self) -> str | None:
        cands = [self.driver_exe, str(self.root / "bin" / "dscu-driver.exe"), str(self.root / "crates" / "dscu-driver" / "target" / "release" / "dscu-driver.exe")]
        return next((c for c in cands if c and Path(c).exists()), None)


class _Job:
    """Windows JobObject (ctypes). No-op elsewhere."""

    def __init__(self) -> None:
        self.h = None
        if sys.platform != "win32":
            return
        import ctypes
        from ctypes import wintypes

        k = ctypes.WinDLL("kernel32", use_last_error=True)
        k.CreateJobObjectW.restype = wintypes.HANDLE
        h = k.CreateJobObjectW(None, None)

        class BASIC(ctypes.Structure):
            _fields_ = [("PerProcessUserTimeLimit", ctypes.c_int64), ("PerJobUserTimeLimit", ctypes.c_int64), ("LimitFlags", wintypes.DWORD), ("MinimumWorkingSetSize", ctypes.c_size_t),
                        ("MaximumWorkingSetSize", ctypes.c_size_t), ("ActiveProcessLimit", wintypes.DWORD), ("Affinity", ctypes.c_size_t), ("PriorityClass", wintypes.DWORD), ("SchedulingClass", wintypes.DWORD)]

        class IOC(ctypes.Structure):
            _fields_ = [(n, ctypes.c_ulonglong) for n in ("a", "b", "c", "d", "e", "f")]

        class EXT(ctypes.Structure):
            _fields_ = [("Basic", BASIC), ("Io", IOC), ("ProcessMemoryLimit", ctypes.c_size_t), ("JobMemoryLimit", ctypes.c_size_t), ("PeakProcessMemoryUsed", ctypes.c_size_t), ("PeakJobMemoryUsed", ctypes.c_size_t)]

        e = EXT()
        e.Basic.LimitFlags = 0x2000  # KILL_ON_JOB_CLOSE
        if k.SetInformationJobObject(h, 9, ctypes.byref(e), ctypes.sizeof(e)):
            self.h, self._k = h, k

    def assign(self, proc: subprocess.Popen) -> bool:
        if not self.h:
            return False
        import ctypes
        from ctypes import wintypes

        self._k.OpenProcess.restype = wintypes.HANDLE
        ph = self._k.OpenProcess(0x0100 | 0x0001, False, proc.pid)  # SET_QUOTA | TERMINATE
        return bool(ph and self._k.AssignProcessToJobObject(self.h, ph))


class Supervisor:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.job = _Job()
        self.procs: dict[str, subprocess.Popen] = {}
        self.log_dir = Path(os.environ.get("LOCALAPPDATA", str(Path.home()))) / "DeepSeekComputerUse" / "logs"

    def _spawn(self, name: str, argv: list[str]) -> None:
        self.log_dir.mkdir(parents=True, exist_ok=True)
        log = open(self.log_dir / f"{name}.log", "ab")
        flags = 0x08000000 if sys.platform == "win32" else 0  # CREATE_NO_WINDOW
        p = subprocess.Popen(argv, stdout=log, stderr=log, stdin=subprocess.DEVNULL, creationflags=flags)
        self.job.assign(p)
        self.procs[name] = p

    async def start_driver(self) -> IpcClient | None:
        c = IpcClient(self.cfg.driver_addr, "driver")
        try:
            await c.connect(retries=2, delay=0.1)
            return c
        except IpcError:
            pass
        exe = self.cfg.resolve_driver_exe()
        if not exe or not self.cfg.spawn or sys.platform != "win32":
            return None
        self._spawn("dscu-driver", [exe])
        try:
            await c.connect(retries=60, delay=0.15)
            return c
        except IpcError:
            return None

    async def start_cdp(self) -> IpcClient | None:
        c = IpcClient(self.cfg.cdp_addr, "cdp")
        try:
            await c.connect(retries=2, delay=0.1)
            return c
        except IpcError:
            pass
        dist = self.cfg.root / "packages" / "cdp-daemon" / "dist" / "index.js"
        if not dist.exists() or not self.cfg.spawn:
            return None
        argv = [self.cfg.node_exe, str(dist), "--port", str(self.cfg.cdp_port)]
        if self.cfg.cdp_addr.startswith("tcp://"):
            argv += ["--tcp", self.cfg.cdp_addr.split("://", 1)[1]]
        self._spawn("cdp-daemon", argv)
        try:
            await c.connect(retries=60, delay=0.15)
            return c
        except IpcError:
            return None

    def pids(self) -> dict[str, int]:
        return {n: p.pid for n, p in self.procs.items() if p.poll() is None}

    async def stop(self, driver: IpcClient | None, cdp: IpcClient | None) -> None:
        for c in (driver, cdp):
            if c and c.connected:
                try:
                    await c.call("shutdown", timeout=2)
                except Exception:  # noqa: BLE001 - best effort
                    pass
        await asyncio.sleep(0.1)
        for p in self.procs.values():
            if p.poll() is None:
                p.terminate()
