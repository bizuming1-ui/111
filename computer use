//! Windows-semantics path jail (port of the v7.1 `Assert-SafePath` rules; pure string logic, no filesystem access).
//! Rejects: `..` traversal, UNC / device namespace / ADS, reserved device names, 8.3 short names,
//! drive-relative paths, `~` expansion, wildcard chars, trailing dot/space, control chars.
pub fn check(root: &str, candidate: &str) -> Result<String, String> {
    if candidate.trim().is_empty() {
        return Err("empty path".into());
    }
    if candidate.chars().any(|c| (c as u32) < 32 || c == '\u{7f}') {
        return Err("control character in path".into());
    }
    let c = candidate.replace('/', "\\");
    if c.starts_with("\\\\") {
        return Err("UNC / device namespace path".into());
    }
    if c.starts_with('~') {
        return Err("tilde expansion".into());
    }
    if c.chars().any(|ch| matches!(ch, '*' | '?' | '"' | '<' | '>' | '|')) {
        return Err("wildcard or illegal character".into());
    }
    let bytes = c.as_bytes();
    let has_drive = bytes.len() >= 2 && bytes[0].is_ascii_alphabetic() && bytes[1] == b':';
    if has_drive && !(bytes.len() >= 3 && bytes[2] == b'\\') {
        return Err("drive-relative path".into());
    }
    let rest = if has_drive { &c[2..] } else { &c[..] };
    if rest.contains(':') {
        return Err("alternate data stream".into());
    }
    let root_n = root.replace('/', "\\");
    let root_n = root_n.trim_end_matches('\\').to_string();
    let full = if has_drive { c.clone() } else { format!("{}\\{}", root_n, c.trim_start_matches('\\')) };
    let mut parts: Vec<String> = Vec::new();
    for (i, seg) in full.split('\\').enumerate() {
        if i == 0 && seg.len() == 2 && seg.ends_with(':') {
            parts.push(seg.to_string());
            continue;
        }
        match seg {
            "" | "." => continue,
            ".." => return Err("parent traversal".into()),
            _ => {}
        }
        if seg.ends_with('.') || seg.ends_with(' ') {
            return Err("trailing dot or space".into());
        }
        let stem = seg.split('.').next().unwrap_or("").to_ascii_uppercase();
        let reserved = ["CON", "PRN", "AUX", "NUL", "CONIN$", "CONOUT$"].contains(&stem.as_str())
            || ((stem.starts_with("COM") || stem.starts_with("LPT")) && stem.len() == 4 && stem.as_bytes()[3].is_ascii_digit() && stem.as_bytes()[3] != b'0');
        if reserved {
            return Err(format!("reserved device name '{seg}'"));
        }
        if let Some(p) = seg.find('~') {
            if seg[p + 1..].chars().next().map(|d| d.is_ascii_digit()).unwrap_or(false) {
                return Err("8.3 short name".into());
            }
        }
        parts.push(seg.to_string());
    }
    let norm = parts.join("\\");
    let rl = root_n.to_ascii_lowercase();
    let nl = norm.to_ascii_lowercase();
    if nl == rl || nl.starts_with(&format!("{rl}\\")) {
        Ok(norm)
    } else {
        Err("outside workspace root".into())
    }
}

