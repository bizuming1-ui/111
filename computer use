#=#=# FILE: dscu-driver/crates/dscu-win32/src/notify.rs
//! System notification + shell surface primitives (inspired by agent-desktop):
//! toasts are discovered through UIA (`Windows.UI.Core.CoreWindow` "New notification"), dismissed by invoking their Close button;
//! shell surfaces are opened from a strict allow-list (hotkeys via SendInput, `ms-settings:` via ShellExecute).
use crate::{sys, uia};
use dscu_core::platform::{ActOp, Notification, PErr};
use dscu_core::tree::RawNode;
use dscu_core::uia_ref::RefEntry;
use windows::core::PCWSTR;
use windows::Win32::UI::Input::KeyboardAndMouse::*;
use windows::Win32::UI::Shell::ShellExecuteW;
use windows::Win32::UI::WindowsAndMessaging::SW_SHOWNORMAL;

fn is_toast(w: &dscu_core::tree::WindowInfo) -> bool {
    let t = w.title.to_lowercase();
    w.class == "Windows.UI.Core.CoreWindow" && (t.contains("notification") || t.contains("通知") || t.contains("toast"))
}

fn texts(n: &RawNode, out: &mut Vec<String>, buttons: &mut Vec<String>) {
    if !n.name.trim().is_empty() {
        match n.role.as_str() {
            "text" => out.push(n.name.clone()),
            "button" => buttons.push(n.name.clone()),
            _ => {}
        }
    }
    n.children.iter().for_each(|c| texts(c, out, buttons));
}

pub fn list() -> Result<Vec<Notification>, PErr> {
    let mut res = vec![];
    for w in sys::list_windows().into_iter().filter(is_toast) {
        if let Ok(tree) = uia::scan(w.window_id, 800) {
            let (mut t, mut b) = (vec![], vec![]);
            texts(&tree, &mut t, &mut b);
            res.push(Notification { id: format!("toast:{}", w.window_id), app: t.first().cloned().unwrap_or_default(), title: t.get(1).cloned().unwrap_or_default(), body: t.iter().skip(2).cloned().collect::<Vec<_>>().join(" "), actions: b });
        }
    }
    Ok(res)
}

pub fn dismiss(id: &str) -> Result<(), PErr> {
    let hwnd: i64 = id.strip_prefix("toast:").and_then(|s| s.parse().ok()).ok_or_else(|| PErr::NotFound(format!("notification {id}")))?;
    let w = sys::list_windows().into_iter().find(|w| w.window_id == hwnd && is_toast(w)).ok_or_else(|| PErr::NotFound(format!("notification {id}")))?;
    let tree = uia::scan(hwnd, 800)?;
    fn find(n: &RawNode) -> Option<&RawNode> {
        let l = n.name.to_lowercase();
        if n.role == "button" && (l.contains("close") || l.contains("dismiss") || l.contains("关闭") || l.contains("清除")) {
            return Some(n);
        }
        n.children.iter().find_map(find)
    }
    let b = find(&tree).ok_or_else(|| PErr::NoPattern("no Close/Dismiss button in toast".into()))?;
    let entry = RefEntry { key: b.key.clone(), role: b.role.clone(), name: b.name.clone(), automation_id: b.automation_id.clone(), patterns: b.patterns.clone(), source: "uia".into(), window_id: hwnd, ..Default::default() };
    uia::act(&w, &entry, &ActOp { kind: "click".into(), pattern: "invoke".into(), ..Default::default() }).map(|_| ())
}

fn hotkey(vks: &[VIRTUAL_KEY]) -> Result<(), PErr> {
    let mk = |vk: VIRTUAL_KEY, up: bool| INPUT {
        r#type: INPUT_KEYBOARD,
        Anonymous: INPUT_0 { ki: KEYBDINPUT { wVk: vk, wScan: 0, dwFlags: if up { KEYEVENTF_KEYUP } else { KEYBD_EVENT_FLAGS(0) }, time: 0, dwExtraInfo: 0 } },
    };
    let mut v: Vec<INPUT> = vks.iter().map(|k| mk(*k, false)).collect();
    v.extend(vks.iter().rev().map(|k| mk(*k, true)));
    let n = unsafe { SendInput(&v, std::mem::size_of::<INPUT>() as i32) };
    if n as usize == v.len() { Ok(()) } else { Err(PErr::Other("SendInput blocked (UIPI? install the uiAccess build)".into())) }
}

pub fn open_surface(name: &str) -> Result<(), PErr> {
    let (base, arg) = name.split_once(':').unwrap_or((name, ""));
    match base {
        "notification_center" => hotkey(&[VK_LWIN, VK_N]),
        "quick_settings" | "action_center" => hotkey(&[VK_LWIN, VK_A]),
        "task_manager" => hotkey(&[VK_CONTROL, VK_SHIFT, VK_ESCAPE]),
        "run" => hotkey(&[VK_LWIN, VK_R]),
        "search" => hotkey(&[VK_LWIN, VK_S]),
        "widgets" => hotkey(&[VK_LWIN, VK_W]),
        "desktop" => hotkey(&[VK_LWIN, VK_D]),
        "file_explorer" => hotkey(&[VK_LWIN, VK_E]),
        "start" => hotkey(&[VK_LWIN]),
        "settings" => {
            let uri: Vec<u16> = format!("ms-settings:{arg}").encode_utf16().chain(std::iter::once(0)).collect();
            let op: Vec<u16> = "open\0".encode_utf16().collect();
            let r = unsafe { ShellExecuteW(None, PCWSTR(op.as_ptr()), PCWSTR(uri.as_ptr()), PCWSTR::null(), PCWSTR::null(), SW_SHOWNORMAL) };
            if r.0 as isize > 32 { Ok(()) } else { Err(PErr::Other(format!("ShellExecute failed ({})", r.0 as isize))) }
        }
        _ => Err(PErr::Unsupported(format!("surface {name}"))),
    }
}
