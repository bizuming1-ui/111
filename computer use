@dataclass
class Usage:
    prompt_hit: int = 0
    prompt_miss: int = 0
    completion: int = 0
    calls: int = 0
    api_ms: float = 0.0
    empty_retries: int = 0
    backup_used: int = 0

    def add(self, u: dict[str, Any], ms: float) -> None:
        hit = int(u.get("prompt_cache_hit_tokens", 0) or 0)
        miss = int(u.get("prompt_cache_miss_tokens", max(0, int(u.get("prompt_tokens", 0) or 0) - hit)) or 0)
        self.prompt_hit += hit
        self.prompt_miss += miss
        self.completion += int(u.get("completion_tokens", 0) or 0)
        self.calls += 1
        self.api_ms += ms

    @property
    def hit_rate(self) -> float:
        t = self.prompt_hit + self.prompt_miss
        return self.prompt_hit / t if t else 0.0


@dataclass
class Reply:
    text: str
    usage: dict[str, Any]
    ms: float
    model: str
    finish: str = ""

    @property
    def hit_rate(self) -> float:
        h = int(self.usage.get("prompt_cache_hit_tokens", 0) or 0)
        m = int(self.usage.get("prompt_cache_miss_tokens", 0) or 0)
        return h / (h + m) if h + m else 0.0


class DeepSeekError(Exception):
    pass


class DeepSeekClient:
    def __init__(self, api_key: str, base: str = "https://api.deepseek.com", model: str = "deepseek-chat", vision_model: str = "deepseek-flash", max_tokens: int = 700):
        self.key, self.base, self.model, self.vision_model, self.max_tokens = api_key, base.rstrip("/"), model, vision_model, max_tokens
        self.backup = os.environ.get("DEEPSEEK_BACKUP_BASE_URL", "").rstrip("/")
        self.usage = Usage()

    @staticmethod
    def build_messages(task_block: str, history: str, tail: str, image_b64: str | None = None, mime: str = "image/jpeg") -> list[dict[str, Any]]:
        """Prefix-cache layout: [SYSTEM const][task+plan stable][history block-window][ack][volatile tail (+image)]."""
        tail_content: Any = tail
        if image_b64:
            tail_content = [{"type": "text", "text": tail}, {"type": "image_url", "image_url": {"url": f"data:{mime};base64,{image_b64}"}}]
        return [
            {"role": "system", "content": SYSTEM_PREFIX},
            {"role": "user", "content": task_block + "\n【已执行】\n" + history},
            {"role": "assistant", "content": "已理解，等待本轮观察。"},
            {"role": "user", "content": tail_content},
        ]

    def _post(self, base: str, payload: dict[str, Any], timeout: float) -> dict[str, Any]:
        req = urllib.request.Request(base + "/chat/completions", data=json.dumps(payload).encode("utf-8"), method="POST",
                                     headers={"Content-Type": "application/json", "Authorization": f"Bearer {self.key}"})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return json.loads(r.read().decode("utf-8"))
        except urllib.error.HTTPError as e:
            body = e.read().decode("utf-8", "replace")[:300]
            raise DeepSeekError(f"HTTP {e.code}: {body}") from e
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            raise DeepSeekError(f"network: {e}") from e

    async def chat(self, messages: list[dict[str, Any]], vision: bool = False, json_mode: bool = True, max_tokens: int | None = None, timeout: float = 60.0) -> Reply:
        model = self.vision_model if vision else self.model
        payload: dict[str, Any] = {"model": model, "messages": messages, "max_tokens": max_tokens or self.max_tokens, "temperature": 0.1, "stream": False}
        if json_mode and not vision:
            payload["response_format"] = {"type": "json_object"}
        last: Exception | None = None
        bases = [self.base] + ([self.backup] if self.backup else [])
        for attempt in range(4):
            base = bases[min(attempt // 2, len(bases) - 1)] if len(bases) > 1 else bases[0]
            if base != self.base:
                self.usage.backup_used += 1
            t0 = time.perf_counter()
            try:
                d = await asyncio.to_thread(self._post, base, payload, timeout)
            except DeepSeekError as e:
                last = e
                if "HTTP 4" in str(e) and "HTTP 429" not in str(e):
                    raise
                await asyncio.sleep(min(6, 0.8 * 2**attempt))
                continue
            ms = (time.perf_counter() - t0) * 1000
            ch = (d.get("choices") or [{}])[0]
            text = ((ch.get("message") or {}).get("content") or "").strip()
            if not text:  # API empty-body self-heal: retry (backup endpoint on the 3rd try)
                self.usage.empty_retries += 1
                last = DeepSeekError("empty response")
                await asyncio.sleep(0.5 * (attempt + 1))
                continue
            self.usage.add(d.get("usage") or {}, ms)
            return Reply(text, d.get("usage") or {}, ms, model, ch.get("finish_reason", ""))
        raise DeepSeekError(f"DeepSeek call failed after retries: {last}")


def extract_json(text: str) -> dict[str, Any]:
    """First balanced JSON object in `text` (models sometimes wrap or append prose)."""
    s = text.strip()
    s = re.sub(r"^```(?:json)?\s*|\s*```$", "", s)
    start = s.find("{")
    if start < 0:
        raise ValueError("no JSON object in model output")
    depth, in_str, esc = 0, False, False
    for i in range(start, len(s)):
        c = s[i]
        if in_str:
            esc = (c == "\\") and not esc
            if c == '"' and not esc:
                in_str = False
            elif c != "\\":
                esc = False
            continue
        if c == '"':
            in_str = True
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return json.loads(s[start : i + 1])
    raise ValueError("unterminated JSON object in model output")
