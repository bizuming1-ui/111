"""THE brain. One asyncio orchestrator drives the Rust dscu-driver and the TS cdp-daemon over the unified protocol.
There is no canned perception anywhere in this file: channel, stalled, blocked_streak, free memory and the CDP state
are measured every step (see PerceptionHub). Unit-test scenarios live in tests/unit/."""
from __future__ import annotations

import asyncio
import base64
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Callable

from . import layer0, memwatch, policy, skills
from .deepseek_client import DeepSeekClient, DeepSeekError, Reply, extract_json
from .ipc_client import IpcClient, IpcError, percentile
from .native_fallback import NativeFallbackDriver
from .perception import Perception, PerceptionHub
from .protocol import ActionRequest, ActionResult, ErrorCode
from .router import Route, route
from .state import DELETE_WORDS, Quota, Record, TaskState, history_window
from .supervisor import Config, Supervisor

READ_ONLY = {"wait", "file_stat", "dir_list", "ask_user", "replan"}
TOGGLE_LIKE = re.compile(r"点赞|收藏|关注|like|follow|favorite|勾选|checkbox|toggle|播放|暂停|play|pause", re.I)


class BrainError(Exception):
    pass


@dataclass
class TaskResult:
    ok: bool
    summary: str
    steps: int
    seconds: float
    layer: str
    routes: list[dict[str, Any]] = field(default_factory=list)
    llm_calls: int = 0
    tokens_in: int = 0
    hit_rate: float = 0.0
    detail: dict[str, Any] = field(default_factory=dict)


class Brain:
    def __init__(self, api_key: str | None = None, cfg: Config | None = None, interactive: bool = True, prefer_layer0: bool = True,
                 approved_hosts: tuple[str, ...] = (), model: str = "deepseek-chat", vision_model: str = "deepseek-flash", out: Callable[[str], None] = print):
        self.cfg = cfg or Config()
        self.interactive, self.prefer_layer0, self.out = interactive, prefer_layer0, out
        self.cfg_approved_hosts = {h.lower() for h in approved_hosts}
        self.sup = Supervisor(self.cfg)
        self.driver: Any = None
        self.cdp: IpcClient | None = None
        self.hub: PerceptionHub | None = None
        self.llm = DeepSeekClient(api_key, model=model, vision_model=vision_model) if api_key else None
        self.task_no = 0
        self.driver_info: dict[str, Any] = {}
        ts = time.strftime("%Y%m%d-%H%M%S")
        base = Path(os.environ.get("LOCALAPPDATA", str(Path.home()))) / "DeepSeekComputerUse" / "workspace" / ts
        self.workspace = base
        self.runlog = base / "run.jsonl"
        self.act_ms: dict[str, list[float]] = {"driver": [], "cdp": []}
        self.using_fallback = False

    # ───────────────────────────── lifecycle ─────────────────────────────
    async def start(self) -> None:
        self.workspace.mkdir(parents=True, exist_ok=True)
        drv = await self.sup.start_driver()
        if drv is None:
            try:
                drv = NativeFallbackDriver()
                self.using_fallback = True
                self.out("  ⚠ 未发现 dscu-driver.exe（Rust 原生驱动）：已启用 Python ctypes 兼容桥（GDI 抓屏 / 无 UIA）。运行 scripts\\build_step1.ps1 编译真·DXGI 驱动。")
            except RuntimeError as e:
                raise BrainError(f"no native driver available: {e}") from e
        self.driver = drv
        self.cdp = await self.sup.start_cdp()
        self.hub = PerceptionHub(self.driver, self.cdp)
        await self.hub.probe_cdp()
        self.driver_info = await self.driver.call("info", timeout=5)
        d = self.driver_info
        self.out(f"  驱动: {d.get('name')} v{d.get('version', '-')} · 抓屏后端={d.get('capture_backend')}（{d.get('adapter') or '-'}）{('回退原因=' + str(d.get('fallback_reason'))) if d.get('fallback_reason') else ''} · UIAccess={d.get('uiaccess')} · CDP 守护={'在线' if self.hub.cdp_up else '离线'}")

    async def stop(self) -> None:
        await self.sup.stop(self.driver if isinstance(self.driver, IpcClient) else None, self.cdp)

    # ───────────────────────────── helpers ─────────────────────────────
    def _log(self, ev: dict[str, Any]) -> None:
        try:
            with open(self.runlog, "a", encoding="utf-8") as f:
                f.write(json.dumps({"ts": time.time(), **ev}, ensure_ascii=False) + "\n")
        except OSError:
            pass

    async def act(self, req: ActionRequest, who: str = "driver") -> ActionResult:
        client = self.cdp if who == "cdp" else self.driver
        if client is None:
            return ActionResult(action_id=req.action_id, ok=False, error_code=ErrorCode.NOT_FOUND, detail=f"{who} is not running")
        t0 = time.perf_counter()
        try:
            r = await client.act(req)
        except IpcError as e:
            r = ActionResult(action_id=req.action_id, ok=False, error_code=ErrorCode(e.code) if e.code in ErrorCode.__members__ else ErrorCode.INTERNAL, detail=e.message, retryable=e.retryable)
        self.act_ms[who].append((time.perf_counter() - t0) * 1000)
        self._log({"type": "action", "who": who, "op": req.op, "ok": r.ok, "code": str(r.error_code.value) if r.error_code else None, "ms": self.act_ms[who][-1]})
        return r

    def _screen_xy(self, x: float, y: float, p: Perception) -> tuple[int, int]:
        sh = (p.driver_env.screenshot if p.driver_env else None)
        if sh and sh.source_rect and sh.scale:
            return int(sh.source_rect.x + x / sh.scale), int(sh.source_rect.y + y / sh.scale)
        return int(x), int(y)

    async def _ps_safe(self, command: str) -> dict[str, Any]:
        script = self.cfg.root / "workers" / "ps_safe_worker.ps1"
        if not script.exists():
            return {"ok": False, "error": "workers/ps_safe_worker.ps1 missing"}
        b64 = base64.b64encode(command.encode("utf-8")).decode()
        ws = str(self.workspace / "ps")
        try:
            p = await asyncio.create_subprocess_exec("pwsh", "-NoProfile", "-NonInteractive", "-File", str(script), "-CommandB64", b64, "-Workspace", ws, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
            so, se = await asyncio.wait_for(p.communicate(), 60)
            return json.loads(so.decode("utf-8", "replace").strip().splitlines()[-1])
        except Exception as e:  # noqa: BLE001
            return {"ok": False, "error": f"ps worker: {e}"}

    # ───────────────────────────── task entry ─────────────────────────────
    async def run_task(self, task: str, mode: str = "auto", max_steps: int = 25) -> TaskResult:
        if self.hub is None:
            await self.start()
        assert self.hub is not None
        self.task_no += 1
        st = TaskState(task=task, task_no=self.task_no, workspace=self.workspace / f"task{self.task_no:02d}", quota=Quota.from_task(task))
        self.out(f"\n╭─ 任务 #{st.task_no} ─────────────────────────")
        if st.quota:
            self.out(f"  （安全联锁：数量配额 {st.quota.fmt()}；删除/归档前会核对已勾选行数与未完成批次）")
        t0 = time.perf_counter()
        usage0 = (self.llm.usage.calls, self.llm.usage.prompt_hit + self.llm.usage.prompt_miss) if self.llm else (0, 0)
        res: TaskResult | None = None
        try:
            # Layer 0 + skills use REAL measurements too: the route is computed from the live probe, not from constants.
            intent = layer0.parse_save_intent(task)
            if mode in ("auto", "skill") and intent is not None:
                if self.prefer_layer0 and mode == "auto":
                    res = await self._layer0_save(task, intent, st)
                else:
                    res = await self._skill_notepad(task, intent, st)
            if res is None and mode in ("auto", "skill"):
                m = skills.URL_RE.search(task)
                if m and re.search(r"chrome|浏览器|edge|打开|navigate|读取|访问", task, re.I) and (mode == "skill" or self.llm is None):
                    res = await self._skill_chrome(task, m.group(0).rstrip("/") if m.group(0).count("/") > 2 else m.group(0), st)
            if res is None:
                if self.llm is None:
                    res = TaskResult(False, "该任务需要 LLM 决策：请设置 DEEPSEEK_API_KEY（确定性技能/Layer 0 不需要）", 0, 0, "none")
                else:
                    res = await self._llm_loop(st, max_steps)
        except Exception as e:  # noqa: BLE001
            res = TaskResult(False, f"内部错误: {type(e).__name__}: {e}", st.step, 0, "error")
        res.seconds = time.perf_counter() - t0
        if self.llm:
            res.llm_calls = self.llm.usage.calls - usage0[0]
            res.hit_rate = self.llm.usage.hit_rate
        self.out(("✔ 完成: " if res.ok else "✘ 失败: ") + res.summary)
        self.out(f"本任务耗时: {res.seconds:.0f} 秒" if res.seconds >= 1 else f"本任务耗时: {res.seconds * 1000:.0f} ms")
        self._telemetry(st, res)
        self.out(f"╰─ 任务 #{st.task_no} 结束（{'done' if res.ok else 'fail'}）──────────")
        self._log({"type": "task", "task": task, "ok": res.ok, "summary": res.summary, "seconds": res.seconds, "steps": res.steps, "layer": res.layer})
        return res

    def _telemetry(self, st: TaskState, res: TaskResult) -> None:
        h = self.hub
        assert h is not None
        n_dxgi = sum(1 for b, _ in h.dxgi_samples if b == "DXGI")
        n_gdi = len(h.dxgi_samples) - n_dxgi
        avg = lambda b: (sum(m for bb, m in h.dxgi_samples if bb == b) / max(1, sum(1 for bb, _ in h.dxgi_samples if bb == b)))  # noqa: E731
        mem = memwatch.stack_report(self.sup.pids())
        parts = [f"capture {percentile(h.cap_ms, .5):.2f}/{percentile(h.cap_ms, .99):.2f}(n={len(h.cap_ms)})"]
        if h.cdp_ms:
            parts.append(f"cdp {percentile(h.cdp_ms, .5):.0f}/{percentile(h.cdp_ms, .99):.0f}(n={len(h.cdp_ms)})")
        if h.uia_ms:
            parts.append(f"uia {percentile(h.uia_ms, .5):.0f}/{percentile(h.uia_ms, .99):.0f}(n={len(h.uia_ms)})")
        for w in ("driver", "cdp"):
            if self.act_ms[w]:
                parts.append(f"act-{w} {percentile(self.act_ms[w], .5):.0f}/{percentile(self.act_ms[w], .99):.0f}(n={len(self.act_ms[w])})")
        self.out("  延迟 P50/P99(ms)：" + " · ".join(parts))
        self.out(f"  屏幕采集：DXGI {n_dxgi} 次 均 {avg('DXGI'):.2f}ms · GDI {n_gdi} 次 均 {avg('GDI'):.1f}ms；内存：可用 {memwatch.free_mb()} MB · 全栈常驻 {mem.get('total')} MB（" + " / ".join(f"{k} {v}" for k, v in mem.items() if k != "total") + "）")
        if self.llm and self.llm.usage.calls:
            u = self.llm.usage
            self.out(f"  模型调用 {u.calls} 次 · 输入 {u.prompt_hit + u.prompt_miss} tok（前缀缓存命中 {u.hit_rate * 100:.0f}%）· 输出 {u.completion} tok · API 累计 {u.api_ms / 1000:.1f} 秒 · 空响应重试 {u.empty_retries}")
        if st.quota:
            self.out(f"  配额账本：{st.quota.fmt()}")

    # ───────────────────────────── Layer 0 / skills ─────────────────────────────
    async def _layer0_save(self, task: str, intent: layer0.SaveIntent, st: TaskState) -> TaskResult:
        assert self.hub is not None
        probe = await self.driver.observe({"want": {"uia": False, "windows": False, "ahash": False}})
        r = route(task, cli_hit=True, cdp_up=self.hub.cdp_up, fg_is_browser=False, uia_controls=0, stalled=False, blocked_streak=0, free_mem_mb=probe.mem_free_mb)
        self.out(f"── 第 1 步 ──\n  [Layer {r.layer}: Native Safe File] {r.reason}")
        out = layer0.save_text(intent.folder_word, intent.name, intent.text, task)
        self.out(f"  动作: action=save_text folder={intent.folder_word} name={intent.name} chars={out['chars']}\n  结果: {'✅' if out['ok'] else '❌'} 已写入 {out['path']}（{out['bytes']} 字节 UTF-8，无 BOM，字节级回读{'一致' if out['readback_equal'] else '不一致'}）")
        steps = 1
        if intent.open_notepad and out["ok"]:
            r2 = await self.act(ActionRequest.new("launch", args={"target": "notepad.exe", "args": f'"{out["path"]}"'}), "driver")
            steps += 1
            self.out(f"── 第 2 步 ──\n  动作: action=open_file app=notepad\n  结果: {'已在记事本中展示' if r2.ok else r2.error_code}")
        return TaskResult(bool(out["ok"]), f"已保存并核验：{out['path']}（{out['bytes']} 字节；Layer 0，0 次 LLM 调用）", steps, 0, "L0", [r.as_dict()], detail=out)

    async def _skill_notepad(self, task: str, intent: layer0.SaveIntent, st: TaskState) -> TaskResult:
        self.out("── Skill: 记事本 GUI 保存（Rust UIA / SendInput，实机驱动）──")
        out = await skills.notepad_gui_save(self, intent, task)
        for s in out["steps"]:
            self.out("  · " + s)
        return TaskResult(bool(out["ok"]), out.get("path", out.get("error", "")) if out["ok"] else str(out.get("error")), len(out["steps"]), 0, "L2-skill", detail=out)

    async def _skill_chrome(self, task: str, url: str, st: TaskState) -> TaskResult:
        self.out("── Skill: Chrome 导航并读取实时 DOM（TS CDP 守护）──")
        out = await skills.chrome_navigate_read(self, url)
        if out.get("ok"):
            self.out(f"  · URL={out['url']} 标题「{out['title']}」 控件={out['elements']} 标题行={out['headings']}\n  · CDP 耗时: {out.get('timing')}")
        return TaskResult(bool(out.get("ok")), (f"{out['title']} @ {out['url']}" if out.get("ok") else str(out.get("error"))), 2, 0, "L1-skill", detail=out)

    # ───────────────────────────── LLM loop ─────────────────────────────
    async def _llm_loop(self, st: TaskState, max_steps: int) -> TaskResult:
        assert self.hub is not None and self.llm is not None
        hub, llm = self.hub, self.llm
        plan = ""
        if len(st.task) > 24 and re.search(r"[，,；;、]|然后|并且|再", st.task):
            try:
                r = await llm.chat([{"role": "system", "content": "你是任务规划器。用≤6条简短步骤列出完成任务的方法与核实证据，纯文本，不要 JSON。"}, {"role": "user", "content": st.task}], json_mode=False, max_tokens=300)
                plan = r.text
                self.out("【执行计划】\n" + "\n".join("  " + l for l in plan.splitlines()[:8]))
            except DeepSeekError as e:
                self.out(f"  （规划失败，直接执行: {e}）")
        st.plan = plan
        pending: Record | None = None
        pending_sig = ""
        last_route: Route | None = None
        need_shot = False
        for step in range(1, max_steps + 1):
            st.step = step
            self.out(f"── 第 {step} 步 ──")
            perc = await hub.observe(want_screenshot=need_shot)
            if pending is not None:  # finalise the previous action's effect with a REAL before/after comparison
                pending.effect = "effective" if perc.sig != pending_sig else "no_effect"
                st.ledger.add(pending)
                pending = None
            free = perc.driver_env.mem_free_mb if perc.driver_env else None
            rt = route(st.task, cli_hit=False, cdp_up=perc.cdp_up, fg_is_browser=perc.fg_is_browser, uia_controls=perc.uia_count, stalled=hub.stalled(), blocked_streak=st.ledger.blocked_streak(), free_mem_mb=free)
            if rt.layer == 4 and not need_shot and (perc.driver_env and perc.driver_env.screenshot is None):
                need_shot = True
                perc = await hub.observe(want_screenshot=True)
            else:
                need_shot = rt.layer == 4
            last_route = rt
            st.layer_trace.append(rt.as_dict())
            ds = perc.primary.dxgi_stats or (perc.driver_env.dxgi_stats if perc.driver_env else None)
            self.out(f"  [Perception: {perc.channel.upper()}] 可交互控件 {perc.uia_count} 个 · 路由 L{rt.layer}/{rt.name}（{rt.reason}）" + (f" · {ds.capture_backend} {ds.frame_ms:.2f}ms 脏矩形 {ds.dirty_rects_count}" if ds else ""))
            if perc.errors:
                self.out("  观察告警: " + " | ".join(perc.errors))
            if perc.injection_hits:
                self.out(f"  🛡 已屏蔽 {perc.injection_hits} 处疑似提示词注入（网页内容为不可信数据）")
            # quota-zero auto-convergence: no LLM call when the ledger already proves the goal
            if st.quota and st.quota.deleted > 0 and st.quota.remaining == 0:
                self.out("  思考: 账本确认全部配额已完成，立即收敛（本步免 LLM 调用）")
                return TaskResult(True, f"[Quota-Zero 收尾] 配额 {st.quota.fmt()}，目标已完成", step, 0, f"L{rt.layer}", st.layer_trace)
            task_block = f"【当前任务】{st.task}\n" + (f"【执行计划】\n{st.plan}\n" if st.plan else "") + (f"【数量配额账本】{st.quota.fmt()}\n" if st.quota else "")
            if st.blocked_targets:
                task_block += "【已拒绝目标（禁止重试）】" + "; ".join(f"{k}（{v}）" for k, v in st.blocked_targets.items()) + "\n"
            if st.user_answers:
                task_block += "【用户补充回答】" + " / ".join(st.user_answers) + "\n"
            tail = f"【最新观察·第{step}步】\n{perc.text}\n【相对上一轮的界面变化】{perc.diff}\n【动作账本】\n{st.ledger.lines()}"
            if rt.layer == 4:
                tail += "\n【视觉模式】附图为前台窗口截图；click 用 x,y 为【图像像素坐标】，系统会换算为屏幕坐标。"
            if st.ledger.records and st.ledger.blocked_streak() >= 2:
                tail += f"\n⚠ 已连续 {st.ledger.blocked_streak()} 步无效/失败：必须换方法（快捷键/视觉/ask_user），不要重复同一动作。"
            img = perc.driver_env.screenshot.b64 if (rt.layer == 4 and perc.driver_env and perc.driver_env.screenshot) else None
            msgs = llm.build_messages(task_block, history_window(st.history), tail, img)
            td0 = time.perf_counter()
            try:
                reply: Reply = await llm.chat(msgs, vision=img is not None)
                decision = extract_json(reply.text)
            except (DeepSeekError, ValueError) as e:
                self.out(f"  决策失败: {e}")
                st.history.append(f"第{step}步 决策失败: {str(e)[:60]}")
                if step >= 3 and st.ledger.blocked_streak() >= 2:
                    return TaskResult(False, f"模型连续不可用: {e}", step, 0, f"L{rt.layer}", st.layer_trace)
                continue
            dec_ms = (time.perf_counter() - td0) * 1000
            u = reply.usage
            self.out(f"  耗时: 感知 {perc.ms.get('total', 0):.0f}ms · 决策 {dec_ms:.0f}ms（{reply.model}） · Token 入 {u.get('prompt_tokens', 0)}（缓存命中 {reply.hit_rate * 100:.0f}%）出 {u.get('completion_tokens', 0)}")
            self.out(f"  思考: {decision.get('thought', '')}\n  预期: {decision.get('expect', '')}")
            actions = decision.get("actions") if isinstance(decision.get("actions"), list) else [decision]
            for i, a in enumerate(actions[:6]):
                op = str(a.get("action", ""))
                if op == "done":
                    ev = self._done_check(st, str(a.get("summary", "")))
                    if ev:
                        self.out(f"  动作: action=done → 拒绝（{ev}）")
                        st.history.append(f"第{step}步 done 被拒: {ev}")
                        break
                    return TaskResult(True, str(a.get("summary", "完成")), step, 0, f"L{rt.layer}", st.layer_trace)
                if op == "fail":
                    return TaskResult(False, str(a.get("reason", "无法完成")), step, 0, f"L{rt.layer}", st.layer_trace)
                if op == "replan":
                    st.history.append(f"第{step}步 replan: {a.get('reason', '')[:60]}")
                    self.out("  动作: action=replan")
                    continue
                brief = " ".join(f"{k}={str(v)[:40]}" for k, v in a.items() if k not in ("action", "thought", "expect", "step"))
                self.out(f"  动作{f' {i + 1}/{len(actions)}' if len(actions) > 1 else ''}: action={op} {brief}")
                sig = self._sig(a, perc)
                ok, msg, code = await self._execute(a, perc, st, sig)
                self.out(("  结果: " if ok else "  执行出错: ") + msg)
                st.history.append(f"第{step}步 {op} {brief[:50]} → {'OK' if ok else 'ERR ' + (code or '')}: {msg[:90]}")
                if op in READ_ONLY:
                    st.ledger.add(Record(step, sig, op, ok, "effective" if ok else "failed", code))
                elif not ok:
                    st.ledger.add(Record(step, sig, op, False, "failed", code))
                else:
                    pending, pending_sig = Record(step, sig, op, True, "unverified", None), perc.sig
                if not ok:
                    break
            st.checkpoint()
            await asyncio.sleep(0.05)
        return TaskResult(False, f"已达最大步数 {max_steps}", max_steps, 0, f"L{last_route.layer}" if last_route else "-", st.layer_trace)

    def _done_check(self, st: TaskState, summary: str) -> str:
        if st.quota and st.quota.remaining > 0:
            return f"配额未完成 {st.quota.fmt()}"
        if not summary or len(summary) < 6:
            return "summary 必须写出完成证据"
        mutating = [r for r in st.ledger.records if r.op not in READ_ONLY]
        if mutating and not any(r.effect == "effective" for r in mutating):
            return "没有任何一步被验证为生效（账本全为无效/失败）"
        return ""

    def _sig(self, a: dict[str, Any], p: Perception) -> str:
        it = p.item(int(a["id"])) if str(a.get("id", "")).isdigit() else None
        tgt = it.el.stable_key if it else f"{a.get('x')},{a.get('y')}" if a.get("x") is not None else str(a.get("url") or a.get("keys") or a.get("label") or a.get("rows") or a.get("text", ""))[:40]
        return f"{a.get('action')}:{tgt}"

    # ───────────────────────────── executor ─────────────────────────────
    async def _execute(self, a: dict[str, Any], p: Perception, st: TaskState, sig: str) -> tuple[bool, str, str | None]:
        op = str(a.get("action", ""))
        it = p.item(int(a["id"])) if str(a.get("id", "")).isdigit() else None
        if f"sig:{sig}" in st.blocked_targets:
            return False, f"[BLOCKED] 同一动作已因 {st.blocked_targets[f'sig:{sig}']} 被拒绝，重试无意义，请换方法。", "SECURITY_DENIED"
        extra: dict[str, Any] = {}
        host = ""
        if op in ("cdp_navigate", "navigate"):
            host = (re.sub(r"^https?://", "", str(a.get("url", ""))).split("/")[0].split(":")[0]).lower()
        if host and host in self.cfg_approved_hosts:
            extra["allow_private"] = True
        else:
            allowed, why, extra = await policy.gate(a, st, it.el.name if it else "", self.interactive)
            if not allowed:
                return False, why, "SECURITY_DENIED"
        # numeric interlock for delete-like toolbar buttons (the ledger, not the LLM, counts)
        if op == "toolbar_action" and st.quota and DELETE_WORDS.search(str(a.get("label", ""))):
            pb = st.pending_batch
            if pb is None or len(st.last_selected) != pb.n:
                return False, f"[INTERLOCK] 已勾选 {len(st.last_selected)} 行，与待删批次不符；配额 {st.quota.fmt()}。请先 select_rows 精确勾选。", "SECURITY_DENIED"
        ep_d = p.driver_env.snapshot_epoch if p.driver_env else None
        ep_c = p.cdp_env.snapshot_epoch if p.cdp_env else None
        use_cdp = p.channel == "cdp" and self.cdp is not None

        async def go(req: ActionRequest, who: str) -> ActionResult:
            r = await self.act(req, who)
            if r.error_code and r.error_code.value == "OCCLUDED" and p.hwnd:  # self-heal once: bring the window forward and retry
                await self.act(ActionRequest.new("focus_window", args={"hwnd": p.hwnd}), "driver")
                r = await self.act(ActionRequest.new(req.op, req.target, req.args, expect_epoch=req.expect_epoch, expect_hwnd=req.expect_hwnd), who)
            return r

        def fmt(r: ActionResult) -> tuple[bool, str, str | None]:
            code = r.error_code.value if r.error_code else None
            if r.ok:
                extras = {k: v for k, v in r.model_dump().items() if k in ("strategy", "url", "title", "settled", "settle_ms", "readback", "point", "checked", "readback_match", "pattern", "clicked") and v is not None}
                return True, f"{op} OK {json.dumps(extras, ensure_ascii=False)[:230]}", None
            hint = {"STALE_EPOCH": "界面已变化，请重新观察", "OCCLUDED": "被其他窗口遮挡", "UIPI_DENIED": "目标是管理员窗口：请运行 scripts\\setup-uiaccess.ps1，不要重试", "AMBIGUOUS_TARGET": "目标不唯一：用 ask_user 询问或换更精确的目标", "SECURITY_DENIED": "策略拒绝，同一动作重试无意义"}.get(code or "", "")
            if code in ("SECURITY_DENIED", "UIPI_DENIED"):
                st.blocked_targets[f"sig:{sig}"] = code or ""
            return False, f"[{code}] {r.detail} {hint}", code

        try:
            if op in ("click", "double_click", "right_click", "hover"):
                if it:
                    who = "cdp" if it.source == "cdp" else "driver"
                    return fmt(await go(ActionRequest.new(op, {"ref_id": it.el.ref_id}, {}, expect_epoch=ep_c if who == "cdp" else ep_d, expect_hwnd=None if who == "cdp" else p.hwnd), who))
                if a.get("x") is None:
                    return False, "click 需要 id 或 x,y", "INVALID_REQUEST"
                sx, sy = self._screen_xy(float(a["x"]), float(a["y"]), p)
                return fmt(await go(ActionRequest.new(op, {"point": {"x": sx, "y": sy}}, {}, expect_hwnd=p.hwnd), "driver"))
            if op == "type":
                text = str(a.get("text", ""))
                if it:
                    who = "cdp" if it.source == "cdp" else "driver"
                    return fmt(await go(ActionRequest.new("type", {"ref_id": it.el.ref_id}, {"text": text, "clear": bool(a.get("clear", True)), "enter": bool(a.get("enter", False))}, expect_epoch=ep_c if who == "cdp" else ep_d, expect_hwnd=None if who == "cdp" else p.hwnd), who))
                r = await go(ActionRequest.new("type", args={"text": text, "enter": bool(a.get("enter", False))}, expect_hwnd=p.hwnd), "driver")
                return fmt(r)
            if op == "key":
                return fmt(await go(ActionRequest.new("key", args={"keys": str(a.get("keys", ""))}, expect_hwnd=None if use_cdp else p.hwnd), "cdp" if use_cdp else "driver"))
            if op == "scroll":
                return fmt(await go(ActionRequest.new("scroll", args={"direction": a.get("direction", "down"), "amount": int(a.get("amount", 3))}, expect_hwnd=None if use_cdp else p.hwnd), "cdp" if use_cdp else "driver"))
            if op == "launch":
                return fmt(await go(ActionRequest.new("launch", args={"target": str(a.get("target", "")), "args": str(a.get("args", ""))}), "driver"))
            if op == "focus_window":
                return fmt(await go(ActionRequest.new("focus_window", args={"title": a.get("title"), "process": a.get("process")}), "driver"))
            if op in ("cdp_navigate", "navigate"):
                if self.cdp is None:
                    return False, "CDP 守护未运行，改用 launch 打开网址", "NOT_FOUND"
                return fmt(await go(ActionRequest.new("navigate", args={"url": str(a.get("url", "")), **extra}), "cdp"))
            if op in ("cdp_wait_selector", "cdp_back", "select_rows", "toolbar_action"):
                if self.cdp is None:
                    return False, "该动作需要 CDP 守护", "NOT_FOUND"
                m = {"cdp_wait_selector": "wait_selector", "cdp_back": "back"}.get(op, op)
                args = {k: v for k, v in a.items() if k not in ("action", "thought", "expect", "step")}
                if op == "select_rows" and st.quota:
                    nb = next((b for b in st.quota.batches if not b.done and b.rows_spec() == str(a.get("rows"))), None)
                    cnt = _count_rows(str(a.get("rows")))
                    if nb is None and cnt is not None and cnt > st.quota.remaining:
                        return False, f"[INTERLOCK] 选择 {cnt} 行超过剩余配额 {st.quota.remaining}（{st.quota.fmt()}）", "SECURITY_DENIED"
                    st.pending_batch = nb
                r = await go(ActionRequest.new(m, args=args), "cdp")
                if r.ok and op == "select_rows":
                    rb = getattr(r, "readback", None) or {}
                    st.last_selected = list(rb.get("checked_rows", []))
                if r.ok and op == "toolbar_action" and st.quota and DELETE_WORDS.search(str(a.get("label", ""))):
                    pb = st.pending_batch
                    if pb is not None:
                        pb.done = True
                        st.quota.deleted += pb.n
                        st.last_selected = []
                        st.pending_batch = None
                return fmt(r)
            if op == "save_text":
                out = layer0.save_text(str(a.get("folder", "")), str(a.get("name", "")), str(a.get("text", "")), st.task)
                return bool(out["ok"]), json.dumps(out, ensure_ascii=False), None if out["ok"] else "INTERNAL"
            if op == "file_stat":
                return True, json.dumps(layer0.file_stat(str(a.get("path", "")), a.get("expect_text")), ensure_ascii=False), None
            if op == "dir_list":
                d = Path(os.path.expandvars(str(a.get("path", "")))).expanduser()
                names = sorted(d.glob(str(a.get("pattern", "*"))), key=lambda x: x.stat().st_mtime, reverse=True)[:30] if d.exists() else []
                return True, json.dumps([x.name for x in names], ensure_ascii=False), None
            if op == "run_ps_safe":
                r = await self._ps_safe(str(a.get("command", "")))
                return bool(r.get("ok")), json.dumps(r, ensure_ascii=False)[:300], None if r.get("ok") else "SECURITY_DENIED"
            if op == "wait":
                await asyncio.sleep(min(10.0, float(a.get("seconds", 1))))
                return True, "已等待", None
            if op == "ask_user":
                q = str(a.get("question", ""))
                if not self.interactive or not sys.stdin or not sys.stdin.isatty():
                    return False, "无法询问用户（非交互）：请 fail 并说明需要的信息", "UNSUPPORTED"
                self.out(f"  ❓ {q}")
                ans = await asyncio.get_running_loop().run_in_executor(None, sys.stdin.readline)
                st.user_answers.append(ans.strip())
                return True, f"用户回答: {ans.strip()}", None
            return False, f"未知动作 {op}", "UNSUPPORTED"
        except (layer0.PathDenied, OSError) as e:
            return False, f"[SECURITY_DENIED] {e}", "SECURITY_DENIED"


def _count_rows(spec: str) -> int | None:
    n = 0
    for part in re.split(r"[,，\s]+", spec):
        m = re.fullmatch(r"(\d+)-(\d+)", part)
        if m:
            n += int(m.group(2)) - int(m.group(1)) + 1
        elif re.fullmatch(r"\d+", part):
            n += 1
        elif (m := re.fullmatch(r"last:(\d+)", part)):
            n += int(m.group(1))
        else:
            return None
    return n
