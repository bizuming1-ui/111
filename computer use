                if name == "cli_help":
                    out = await asyncio.to_thread(cli_anything.help_text, tool)
                    return ActionResult(ok=bool(out), code=Code.OK if out else Code.NOT_FOUND, message=out[:1800] or f"未发现工具 {tool}")
                res = await asyncio.to_thread(cli_anything.run_json, tool, str(a.get("args", "")), int(a.get("timeout", 120)))
                return ActionResult(ok=res.ok, code=Code.OK if res.ok else Code.INTERNAL, message=res.render()[:1800])
            if name in ("inspect", "ocr"):
                return ActionResult(ok=False, code=Code.UNSUPPORTED, message=f"{name} 未内置；请用 vision_inspect（坐标网格截图）")
        except IpcError as e:
            return ActionResult(ok=False, code=Code.INTERNAL, message=f"IPC: {e}")
        return ActionResult(ok=False, code=Code.UNSUPPORTED, message=f"未知动作 {name}")

    async def _select_rows(self, spec: str, b: Bundle, st: TaskState) -> ActionResult:
        want: set[int] = set()
        for part in re.split(r"[,，]", spec):
            m = re.fullmatch(r"\s*(\d+)\s*(?:-\s*(\d+))?\s*", part)
            if m:
                want |= set(range(int(m.group(1)), int(m.group(2) or m.group(1)) + 1))
        if not want:
            return ActionResult(ok=False, code=Code.NOT_FOUND, message="rows 格式如 1-5")
        notes: list[str] = []
        if self.registry.targets_locked:
            want, notes = self.registry.translate_rows(want, b.obs.elements)
            if not want:
                return ActionResult(ok=True, code=Code.OK, message="；".join(notes) or "无目标行需要选择")
            self.counters["stable_translate"] += 1
        _items = {e.row: e for e in b.obs.elements if e.zone == "Row" and e.row and e.role.lower() in ("listitem", "dataitem", "treeitem") and not e.is_cdp}
        _has_box = any(e.zone == "Row" and e.role.lower() == "checkbox" for e in b.obs.elements)
        if _items and not _has_box:  # v17: Explorer DirectUIHWND / UIItemsView / Recycle Bin / mail lists -> SelectionItemPattern + IsSelected read-back
            return await self._uia_select_rows(want, _items, b, st, notes)
        for attempt in range(2):
            nb = b if attempt == 0 else await self.observe(st, forced="cdp")
            boxes = {e.row: e for e in nb.obs.elements if e.zone == "Row" and e.role.lower() == "checkbox" and e.row}
            todo = [e for r_, e in boxes.items() if (r_ in want) != ("checked" in e.states)]
            for e in todo:
                r = await (self._cdp("click", ref=e.ref_id, expect_epoch=nb.epoch_cdp) if e.is_cdp else self._drv("click", nb, ref=e.ref_id, expect_epoch=nb.drv.snapshot_epoch, expect_hwnd=self._target_hwnd(nb)))
                if not r.ok:
                    return ActionResult(ok=False, code=r.code, message=f"select_rows 点击 R{e.row} 失败: {r.message}")
            await asyncio.sleep(0.8)
            vb = await self.observe(st, forced="cdp" if self.hub.cdp_up else None)
            checked = {e.row for e in vb.obs.elements if e.zone == "Row" and e.role.lower() == "checkbox" and "checked" in e.states}
            if checked == want:
                self.registry.observe_rows(vb.obs.elements, st.step)
                return ActionResult(ok=True, code=Code.OK, message=f"select_rows {spec}：✓ 闭环验证通过（复扫一致）：当前共勾选 {len(checked)} 行（R{sorted(checked)}）" + ("；" + "；".join(notes) if notes else ""))
            b = vb
        return ActionResult(ok=False, code=Code.INTERNAL, message=f"select_rows 闭环未通过：期望 {sorted(want)}，实际 {sorted(checked)}")

    async def _uia_select_rows(self, want: set[int], items: dict[int, Any], b: Bundle, st: TaskState, notes: list[str]) -> ActionResult:
        order = sorted(want)
        missing = [r for r in order if r not in items]
        if missing:
            return ActionResult(ok=False, code=Code.NOT_FOUND, message=f"select_rows：当前观察中没有 R{missing}（可选行 {sorted(items)[:20]}）")
        mech: list[str] = []
        for i, row in enumerate(order):
            e = items[row]
            r = await self._drv("select", b, ref=e.ref_id, multi=(i > 0), expect_epoch=b.drv.snapshot_epoch, expect_hwnd=self._target_hwnd(b))
            if r.ok:
                mech.append(f"R{row}:{r.effect.get('mechanism', 'SelectionItemPattern')}")
                continue
            r = await self._drv("click", b, ref=e.ref_id, expect_epoch=b.drv.snapshot_epoch, expect_hwnd=self._target_hwnd(b))  # physical fallback
            if not r.ok:
                return ActionResult(ok=False, code=r.code, message=f"select_rows R{row} 失败（SelectionItemPattern 与物理点击均失败）: {r.message}")
            mech.append(f"R{row}:click")
        await asyncio.sleep(0.35)
        vb = await self.observe(st, forced=None)
        sel_rows = {e.row for e in vb.obs.elements if e.zone == "Row" and e.row and e.role.lower() in ("listitem", "dataitem", "treeitem") and "selected" in e.states}
        want_names = {items[r].name for r in want}
        sel_names = {e.name for e in vb.obs.elements if e.zone == "Row" and e.row and e.role.lower() in ("listitem", "dataitem", "treeitem") and "selected" in e.states}
        if sel_rows == want or (sel_names and sel_names == want_names):
            self.registry.observe_rows(vb.obs.elements, st.step)
            if DESTRUCTIVE_TASK.search(st.task):  # freeze the selected business objects as the authorised TargetSet
                from .stable_object import checked_row_ids

                for sid in checked_row_ids(self.registry, vb.obs.elements):
                    o = self.registry.objects.get(sid)
                    if o is not None:
                        o.is_target, o.expected_state = True, o.expected_state or "gone"
                self.registry.targets_locked = bool(any(o.is_target for o in self.registry.objects.values()))
            return ActionResult(ok=True, code=Code.OK, message=f"select_rows {sorted(want)}：✓ UIA SelectionItemPattern 选中并回读 IsSelected=True（{', '.join(mech)}）；当前选中 {sorted(sel_rows)}（{', '.join(sorted(sel_names))[:80]}）" + ("；" + "；".join(notes) if notes else ""))
        return ActionResult(ok=False, code=Code.INTERNAL, message=f"select_rows 闭环未通过：期望 {sorted(want)}（{sorted(want_names)}），回读选中 {sorted(sel_rows)}（{sorted(sel_names)}）")

    # ------------------------------------------------------------------ v17: DirectML structured list -> cheap text model first, vision only when ambiguous
    def _dml_route(self, st: TaskState, b: Bundle) -> tuple[str, bool]:
        """-> (note appended to the observation, send_image).  send_image=False => deepseek-chat (0.8 s) decides from the [id] Box(x,y,w,h) text list."""
        try:
            from sidecar import dml_detector as _d

            det = _d.get()
            last = det.last or {}
            if not last or time.time() - float(last.get("ts", 0)) > 4.0 or not (det.state == "enabled" or det.allow_cpu):
                return "", True
            note = "【DirectML 候选框+文本（OmniParser icon_detect·Radeon DML；屏幕物理坐标；格式 [id] Box(x,y,w,h) 文本；点击请用 x,y 并加 vision_grounded:true）】\n" + str(last.get("text", ""))
            streak = int(getattr(st, "_dml_streak", 0))
            if last.get("ambiguous") or streak >= 3 or getattr(st, "stalled_steps", 0) >= 2:
                det.escalations += 1
                st._dml_streak = 0  # type: ignore[attr-defined]
                self.counters["dml_escalations"] += 1
                return note, True
            st._dml_streak = streak + 1  # type: ignore[attr-defined]
            det.text_calls += 1
            self.counters["dml_text_calls"] += 1
            return note, False
        except Exception:  # noqa: BLE001
            return "", True

    # ------------------------------------------------------------------ v16.1: AUTH_WALL human hand-off
    def _detect_wall(self, b: Bundle) -> Optional[AuthWall]:
        o = b.obs
        url = str(o.url or "")
        if not url and (b.channel == "cdp" or getattr(b, "fg_attached", False)):
            url = str(getattr(getattr(self.hub, "_mcp", None), "last_url", "") or "")  # latched vision turns carry no URL
        if not url and not o.elements:
            return None
        if not (b.channel == "cdp" or getattr(b, "fg_attached", False) or o.url):
            return None  # the wall is not what the agent is looking at (e.g. Notepad in front)
        texts = [e.name for e in o.elements[:150] if e.name]
        return detect_auth_wall(url, str(o.title or ""), texts)

    @staticmethod
    def _ask_enter() -> str:
        try:
            return input("  👉 请在浏览器中手动完成登录/2FA 后回到此处按【回车】继续（输入 s 回车 = 放弃本任务）：")
        except (EOFError, KeyboardInterrupt):
            return "s"

    @staticmethod
    def _auth_popup(wall: AuthWall) -> Optional[str]:
        """Non-blocking always-on-top notice (Windows).  Closed automatically once the human pressed Enter in the terminal."""
        if sys.platform != "win32" or os.environ.get("DSCU_AUTH_POPUP", "1") == "0":
            return None
        import ctypes
        import threading

        title = "DSCU · AUTH_WALL_HANDOFF"
        msg = f"检测到 {wall.label}\n\n请在浏览器里手动完成一次登录 / 2FA，然后回到 PowerShell 按回车继续。\n（本窗口会在你按回车后自动关闭）"
        threading.Thread(target=lambda: ctypes.windll.user32.MessageBoxW(0, msg, title, 0x40 | 0x40000), daemon=True).start()
        return title

    @staticmethod
    def _auth_popup_close(title: Optional[str]) -> None:
        if not title or sys.platform != "win32":
            return
        try:
            import ctypes

            h = ctypes.windll.user32.FindWindowW(None, title)
            if h:
                ctypes.windll.user32.PostMessageW(h, 0x10, 0, 0)
        except Exception:  # noqa: BLE001
            pass

    async def _focus_attached_browser(self, b: Bundle) -> None:
        try:
            pids, apid, aexe = self.perception.scope()
            ws = [{"hwnd": w.hwnd, "title": w.title, "class": w.cls or "", "process": w.process, "pid": w.pid, "rect": w.rect, "z": w.z, "minimized": bool(w.minimized),
                   "cloaked": bool(w.cloaked), "own_console": bool(w.own_console)} for w in b.drv.windows]
            cand = procnames.rank_main_window(ws, pids | ({apid} if apid else set()), {aexe} if aexe else set())
            if cand:
                await self._focus(b, hwnd=cand[0]["hwnd"])
            elif aexe:
                await self._drv("focus_window", b, title=aexe)
        except Exception:  # noqa: BLE001
            pass

    async def _auth_wall_gate(self, st: TaskState, b: Bundle) -> Optional[tuple[Bundle, Optional[tuple[str, str]], str]]:
        """AUTH_WALL_HANDOFF: the page is a login / account-chooser / 2FA wall or Google's `signin/rejected`.  Stop clicking (v16.0 burned 15 steps), ask the human ONCE,
        re-snapshot, verify the wall is gone, continue.  Returns None when there is no wall, else (bundle, terminal-or-None, note-for-the-model)."""
        if os.environ.get("DSCU_AUTH_WALL", "1") == "0":
            return None
        wall = self._detect_wall(b)
        if wall is None:
            return None
        guard: AuthWallGuard = getattr(st, "auth_guard", None) or AuthWallGuard(max_handoffs=int(os.environ.get("DSCU_AUTH_MAX_HANDOFFS", "2")))
        st.auth_guard = guard  # type: ignore[attr-defined]
        interactive = sys.stdin is not None and sys.stdin.isatty() and os.environ.get("DSCU_NONINTERACTIVE") != "1"
        cur = b
        while wall is not None:
            self.counters["auth_wall_detected"] += 1
            if not guard.allow(wall):
                msg = f"[AUTH_WALL] {wall.label} 仍未解除（已人工交接 {guard.handoffs} 次）。请先确认 `v16 browser`：navigator.webdriver 必须为 false；仍被拒绝请改用 DSCU_MCP_MODE=autoconnect。"
                self.say(f"  🛑 {msg}")
                return cur, ("blocked_needs_human", msg), ""
            guard.record(wall)
            self.counters["auth_wall_handoffs"] += 1
            wd = (getattr(self.hub, "cdp_hello", {}) or {}).get("webdriver")
            for ln in auth_banner(wall, mode=str((getattr(self.hub, "cdp_hello", {}) or {}).get("profile_mode", "")), webdriver=wd, attempt=guard.handoffs, maxn=guard.max_handoffs):
                self.say(ln)
            if not interactive:
                msg = f"[AUTH_WALL_HANDOFF] {wall.label}：非交互终端，无法等待人工登录；请在浏览器中完成登录后重新下达任务。"
                return cur, ("blocked_needs_human", msg), ""
            await self._focus_attached_browser(cur)
            pop = self._auth_popup(wall)
            ans = await asyncio.to_thread(self._ask_enter)
            self._auth_popup_close(pop)
            if ans.strip().lower() in ("s", "skip", "q", "n", "放弃"):
                return cur, ("blocked_needs_human", f"用户放弃 AUTH_WALL 人工登录（{wall.label}）"), ""
            await asyncio.sleep(0.8)
            cur = await self.observe(st, forced="cdp" if self.hub.cdp_up else None)
            _, cur.els = render_elements(cur.obs)
            wall = self._detect_wall(cur)
        st.stalled_steps = st.blocked_streak = 0
        st.loop_hits.clear()
        st.masks.clear()
        self.say("  ✓ AUTH_WALL 已解除（重新快照验证通过）→ 继续任务")
        return cur, None, "[AUTH_WALL_RESOLVED] 用户已手动完成登录/验证，页面已离开登录墙；请在最新观察上继续原任务，不要再重复登录步骤。"

    # ------------------------------------------------------------------ v16.2: HITL + WAL crash recovery + production Gmail two-phase lane
    async def _hitl(self, lines: list[str], question: str) -> bool:
        for ln in lines:
            self.say(ln)
        if self.auto_confirm:
            self.say(f"  ✓ HITL 自动确认（DSCU_AUTO_CONFIRM=1）：{question}")
            return True
        _prev_fg = foreground_hwnd()
        try:
            if self.confirm_fn is not None:
                ans = self.confirm_fn(question)
            else:
                ans = await asyncio.to_thread(input, f"  👉 {question} ")
        except (EOFError, KeyboardInterrupt):
            return False
        _ok = parse_confirmation(ans)  # v18: '我说出了，是发给老虎不抓鼠、y' is a YES; 'n' / '不' / '算了' are NOs
        if _ok and _prev_fg and self.confirm_fn is None:  # the terminal prompt stole the foreground: give it back (v17.1 log: next click missed)
            try:
                await self._drv("focus_window", None, hwnd=int(_prev_fg))
            except Exception:  # noqa: BLE001
                pass
        return _ok

    def _v18_pre(self, a: dict[str, Any], step: int) -> Optional[ActionResult]:
        """v18 evidence gate, BEFORE execution: a path that already proved fruitless (WorldStateDiff = empty) is refused without a model round-trip."""
        msg = self.v18.pre(a, step)
        if msg is None:
            return None
        self.counters["gate_denied"] += 1
        return ActionResult(ok=False, code=Code.SECURITY_DENIED, message=msg)

    async def _v18_dom_trigger(self, key: str, o: Observation, st: TaskState) -> Optional[ActionResult]:
        """v18 [P0-2/P1-4]: Action TRIGGER resolved from the live DOM by semantics (never by pixel), released only when >=1 frozen Target is selected."""
        m = getattr(self.hub, "_mcp", None)
        if m is None or not hasattr(m, "eval_js") or not re.search(r"删除|delete|trash|垃圾|归档|archive|移除", key, re.I):
            return None
        from .stable_object import checked_row_ids

        sel = checked_row_ids(self.registry, o.elements)
        if not sel:
            return ActionResult(ok=False, code=Code.NOT_FOUND, message="[v18 Target/Trigger] 当前没有处于 selected 的目标行：先 select_rows 选中并冻结目标，再点击工具栏触发器")
        if self.registry.targets_locked:
            allowed = self.gate.targets()
            stray = [s_ for s_ in sel if s_ not in allowed]
            if stray:
                return ActionResult(ok=False, code=Code.OBJECT_IDENTITY_MISMATCH, message=f"[v18 Target/Trigger] 有 {len(stray)} 个未授权行也处于选中状态，拒绝点击触发器")
        words = ["删除", "delete", "move to trash", "移至垃圾箱", "移到垃圾箱"] if re.search(r"删除|delete|trash|垃圾|移除", key, re.I) else ["归档", "archive", "存档"]
        js = ("() => { const W = " + json.dumps(words, ensure_ascii=False) + ".map(s => s.toLowerCase());"
              " const vis = e => { const r = e.getBoundingClientRect(), s = getComputedStyle(e); return r.width > 4 && r.height > 4 && s.visibility !== 'hidden' && s.display !== 'none' && r.bottom > 0 && r.top < innerHeight; };"
              " const c = [...document.querySelectorAll('[role=button],[role=menuitem],button,[data-tooltip],[aria-label]')].filter(vis).filter(e => !e.closest('tr[role=row]') && !e.closest('[role=navigation]')"
              " && !e.closest('[role=link]') && e.getAttribute('role') !== 'link' && W.some(k => ((e.getAttribute('aria-label') || '') + '|' + (e.getAttribute('data-tooltip') || '') + '|' + (e.innerText || '')).toLowerCase().includes(k)));"
              " if (!c.length) return {ok: false, n: 0}; const e = c[0], r = e.getBoundingClientRect();"
              " const o = {bubbles: true, cancelable: true, clientX: r.x + r.width / 2, clientY: r.y + r.height / 2, view: window};"
              " for (const t of ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click']) e.dispatchEvent(new (t.startsWith('pointer') ? PointerEvent : MouseEvent)(t, o));"
              " return {ok: true, n: c.length, name: e.getAttribute('aria-label') || e.getAttribute('data-tooltip') || e.innerText}; }")
        try:
            r = await m.eval_js(js, timeout=15.0)
        except Exception:  # noqa: BLE001
            return None
        if isinstance(r, dict) and r.get("ok"):
            self.counters["v18_dom_trigger"] += 1
            return ActionResult(ok=True, code=Code.OK, message=f"[v18 DOM Trigger] 按 DOM 语义精确点击工具栏「{str(r.get('name'))[:20]}」（{len(sel)} 个冻结目标已选中；下一轮逐项核验 gone）")
        return None

