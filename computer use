class RecoveryPlaybook:
    """Self-drawn apps (WeChat, QQ, DingTalk ...) expose no UIA tree; unknown pages give the model no ground truth.
    Two consecutive clicks without any observable change => walk the ladder (each rung is tried once, then the next):
        0 activate_check  : verified foreground of the target window (top-most activation check)
        1 hotkey_probe    : app hotkey (Ctrl+F search focus) instead of pixel-hunting
        2 zoom_relocate   : crop the target area, 2x upscale, detail=original -> re-locate by vision
        3 rollback        : Esc / Ctrl+Z to return to a known state, then re-plan
    After the last rung fails twice more => hand over to the human with the evidence."""

    STAGES = ("activate_check", "hotkey_probe", "zoom_relocate", "rollback")

    def __init__(self) -> None:
        self.noeffect = 0
        self.stage = -1
        self.exhausted = 0
        self.log: list[str] = []

    @staticmethod
    def is_self_drawn(process: str, n_uia_controls: int, channel: str) -> bool:
        p = (process or "").lower()
        return p in SELF_DRAWN_PROCS or (channel in ("uia", "dxgi_vision") and n_uia_controls < 6 and p not in ("explorer.exe", ""))

    def reset(self) -> None:
        self.noeffect, self.stage, self.exhausted = 0, -1, 0

    def feed(self, action: dict[str, Any], effect: str, obs: Observation, last_xy: Optional[tuple[int, int]] = None) -> Optional[Intervention]:
        name = action.get("action", "")
        if effect == "confirmed":
            self.reset()
            return None
        if name not in CLICKS or effect not in ("none",):
            return None
        self.noeffect += 1
        fg = obs.fg_window()
        proc = fg.process if fg else ""
        if self.noeffect < 2 or not (self.is_self_drawn(proc, len(obs.elements), obs.channel) or obs.channel == "dxgi_vision" or len(obs.elements) < 6):
            return None
        self.noeffect = 0
        self.stage += 1
        if self.stage >= len(self.STAGES):
            self.exhausted += 1
            self.stage = len(self.STAGES) - 1
            if self.exhausted >= 2:
                return Intervention("escalate_human", f"恢复剧本 4 级全部用尽仍无变化（{proc or '未知应用'}）：交还给人并附证据。", escalate_human=True)
        st = self.STAGES[self.stage]
        self.log.append(st)
        fgh = fg.hwnd if fg else 0
        if st == "activate_check":
            return Intervention(st, f"【恢复剧本 1/4 置顶激活检查】连续 2 次点击无变化（{proc}）。系统已验证式激活前台窗口；请用最新观察判断点击是否落在了正确窗口。",
                                [{"action": "focus_window", "hwnd": fgh}] if fgh else [])
        if st == "hotkey_probe":
            return Intervention(st, "【恢复剧本 2/4 快捷键探测】自绘界面像素点击无效：系统已发送 Ctrl+F 探测搜索框；请 vision_inspect 确认搜索框是否出现后再 type，不要继续盲点。",
                                [{"action": "key", "keys": "ctrl+f"}], {"detail": "low", "reason": "hotkey_probe: confirm search box"})
        if st == "zoom_relocate":
            x, y = last_xy or ((fg.rect[0] + fg.rect[2] // 2, fg.rect[1] + fg.rect[3] // 2) if fg else (960, 540))
            cw, ch = 640, 420
            sx, sy = (fg.rect[0], fg.rect[1]) if fg else (0, 0)
            reg = [max(sx, x - cw // 2), max(sy, y - ch // 2), cw, ch]
            return Intervention(st, f"【恢复剧本 3/4 局部 2x 高清重定位】已在点击点附近裁剪 {cw}x{ch} 区域并 2x 放大（detail=original）；请只根据这张图里的刻度重新定位目标。",
                                [], {"detail": "original", "crop_region": reg, "zoom": 2.0, "reason": "zoom_relocate"})
        return Intervention("rollback", "【恢复剧本 4/4 回滚】已发送 Esc 退出可能的错误状态；请重新规划（不要沿用刚才的点击坐标）。",
                            [{"action": "key", "keys": "esc"}] + ([{"action": "key", "keys": "ctrl+z"}] if action.get("action") == "type" else []))
