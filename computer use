            if not ok:
                return self._deny("TRIGGER_SEMANTICS_FAILED", why)
            if not o.has_structured_evidence and not req.human_attested:
                return self._deny("TRIGGER_VISUAL_ONLY", f"触发器 {o.object_id} 仅由视觉通道（{'+'.join(o.sources)}）识别：需 DOM/UIA 佐证或人工确认")
            self.stats["released_trigger"] += 1
            self.stats["oib_avoided"] += 1
            return GateVerdict(True, "RELEASED_TRIGGER", f"{why}；{len(sel)}/{len(frozen)} 个冻结目标已选中，且无越界选中", (f"epoch={req.snapshot_epoch}", f"trigger={o.object_id}"))
