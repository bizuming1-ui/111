"""v18.0 [P0-3] Real WeChat (Weixin.exe / WeChat.exe) — whole-pipeline perception on the REAL window + non-destructive calibration.

Why a new skill: v17.1 only ever passed against `FakeWeChat`.  On the real window three assumptions broke (see the run log):
  · fixed-offset geometry (search box / editor) drifts with window size, DPI and the Weixin 4.x layout  →  we now CALIBRATE from DirectML boxes + OCR
  · the contact name was parsed with a stray "联系人" prefix, searched verbatim → 0 hits  →  parser fixed (message_send) + exact-name guard here
  · when the target chat was ALREADY open the skill still searched, found nothing, and fell into a blind LLM click loop  →  header-first short-circuit
  · retrying a search that produced no new pixels burned tokens  →  Evidence-Gated: no new OCR evidence ⇒ close the strategy and switch

Pipeline (each step writes its proof into MessageSession; every step is independently verified):
  1 locate the search box        (DML box / OCR "搜索" anchor, else proportional geometry — never a fixed drifting coordinate)
  2 locate + FREEZE the contact  (UnifiedObjectRef from OCR+DML list rows; exact-name, section-aware; ambiguity ⇒ refuse)
  3 read the chat HEADER and verify it EQUALS the contact (single chat)         → promotes the candidate to a verified business identity
  4 click the editor, write the draft, read it back through clipboard sentinel AND OCR        (steps 1-4 = the `--dry-run-no-send` acceptance)
  5 production only: HITL → send → independent right-hand bubble proof (before/after count)

CLI:   python -m agent_brain.skills.wechat_real --contact <name> --body <text> --dry-run-no-send [--json]
"""
from __future__ import annotations

import argparse
import asyncio
import json
import os
import sys
import time
from dataclasses import dataclass, field
from typing import Any, Iterable, Optional

from . import message_send as ms
from ..unified_object import Cand, ObjectFusionEngine, ObjectRegistry, UnifiedObjectRef, norm, rect_area

_SEARCH_HINT = ("搜索", "search", "查找")


# ------------------------------------------------------------------------------------------------------------------------ pure calibration
@dataclass
class Calibration:
    search_xy: tuple
    input_xy: tuple
    search_src: str
    input_src: str
    notes: list = field(default_factory=list)

    @property
    def evidence(self) -> str:
        return f"搜索框@{self.search_xy}[{self.search_src}] 输入框@{self.input_xy}[{self.input_src}]"


def _items(raw: Iterable[Any]) -> list:
    out = []
    for it in raw or []:
        if isinstance(it, dict) and it.get("box") and len(it["box"]) == 4:
            out.append({"box": [int(v) for v in it["box"]], "text": str(it.get("text") or ""), "cls": it.get("cls", -1), "src": it.get("text_src", "")})
    return out


def locate_search_box(items: Iterable[Any], geo: "ms.WeChatGeometry") -> tuple:
    """-> (x, y, source).  OCR anchor ('搜索') in the top-left band > widest DML box in that band > proportional fallback (geometry only as the LAST resort)."""
    band = [geo.x + geo.d(54), geo.y, geo.d(300), geo.d(120)]
    inb = [i for i in _items(items) if ms.WeChatGeometry.inside(band, i["box"][0] + i["box"][2] / 2, i["box"][1] + i["box"][3] / 2)]
    for i in inb:
        if any(h in i["text"].lower() for h in _SEARCH_HINT) and len(i["text"]) <= 12:
            b = i["box"]
            return int(b[0] + b[2] * (0.5 if b[2] > geo.d(120) else 1.6)), int(b[1] + b[3] / 2), "ocr_anchor"
    boxes = [i for i in inb if i["cls"] != -1 and i["box"][2] >= geo.d(110) and i["box"][3] <= geo.d(60) and i["box"][2] / max(1, i["box"][3]) > 2.5]
    if boxes:
        b = max(boxes, key=lambda i: i["box"][2])["box"]
        return int(b[0] + b[2] / 2), int(b[1] + b[3] / 2), "dml_box"
    return int(geo.x + geo.d(54) + geo.d(130)), int(geo.y + geo.d(38)), "geometry_fallback"


def locate_input_box(items: Iterable[Any], geo: "ms.WeChatGeometry") -> tuple:
    """-> (x, y, source).  The editor is the large DML region inside the bottom of the chat pane; click in its UPPER-MIDDLE third (never the bottom edge:
    in the v17.1 log the model clicked y=1360 on the strip *below* the editor and nothing happened)."""
    pane = [geo.chat_x0, geo.y + int(geo.h * 0.55), geo.x + geo.w - geo.chat_x0, int(geo.h * 0.45)]
    boxes = []
    for i in _items(items):
        b = i["box"]
        cx, cy = b[0] + b[2] / 2, b[1] + b[3] / 2
        if i["cls"] != -1 and ms.WeChatGeometry.inside(pane, cx, cy) and b[2] >= pane[2] * 0.55 and b[3] >= geo.d(40):
            boxes.append(b)
    if boxes:
        b = max(boxes, key=lambda r: rect_area(r))
        return int(b[0] + b[2] * 0.42), int(b[1] + b[3] * 0.35), "dml_box"
    for i in _items(items):  # OCR anchor: the send button label sits at the editor's bottom-right
        if ms.cj(i["text"]) in (ms.cj("发送(S)"), ms.cj("发送")) and ms.WeChatGeometry.inside(pane, i["box"][0], i["box"][1]):
            return int(geo.chat_x0 + (geo.x + geo.w - geo.chat_x0) * 0.40), int(i["box"][1] - geo.d(70)), "ocr_send_anchor"
    x, y = geo.input_click
    return x, y, "geometry_fallback"


def header_titles(lines: Iterable["ms.TextLine"], geo: "ms.WeChatGeometry") -> list:
    return [l.text.strip() for l in sorted((l for l in lines if geo.in_header(l)), key=lambda l: (l.rect[1], l.rect[0])) if l.text.strip()]


def freeze_contact_object(raw_items: Iterable[Any], recipient: str, cand_line: "ms.TextLine", geo: "ms.WeChatGeometry", epoch: int, hwnd: int) -> UnifiedObjectRef:
    """fuse the DML boxes + OCR lines of the result list into UnifiedObjectRefs and return the one that IS the picked contact row (a *candidate* until the header proves it)."""
    its = _items(raw_items)
    ocr = [Cand("ocr", tuple(i["box"]), i["text"], "text") for i in its if i["cls"] == -1 or not i["src"] == "dml"]
    dml = [Cand("dml", tuple(i["box"]), "", "icon" if i["cls"] != -1 else "unknown", cls="icon") for i in its if i["cls"] != -1]
    objs = ObjectFusionEngine().fuse(snapshot_epoch=epoch, application_id="wechat", window_id=hwnd, ocr=ocr, dml=dml)
    best = None
    for o in objs:
        if norm(o.accessible_name) == norm(recipient) and ms.WeChatGeometry.inside(list(o.visual_bbox), cand_line.cx, cand_line.cy):
            best = o
            break
    if best is None:
        best = UnifiedObjectRef(object_id="uo:wechat-contact", application_id="wechat", window_id=hwnd, snapshot_epoch=epoch, semantic_role="listitem", accessible_name=cand_line.text.strip(),
                                business_identity="", dom_identity="", uia_identity="", visual_bbox=tuple(cand_line.rect), coordinate_space="screen_physical", confidence=0.55,
                                last_seen=time.time(), action_role="target", sources=("ocr",), candidate_only=True)
    best.action_role = "target"
    return best


# ------------------------------------------------------------------------------------------------------------------------ the skill
class WeChatRealSkill(ms.WeChatSkill):
    def __init__(self, io: Any, session: "ms.MessageSession", say: Any = None, poll: float = 0.55, dry_run: bool = False, controller: Any = None) -> None:
        super().__init__(io, session, say, poll)
        self.dry_run = dry_run or os.environ.get("DSCU_WECHAT_DRYRUN", "0") == "1"
        self.controller = controller
        self.cal: Optional[Calibration] = None
        self.registry = ObjectRegistry()
        self.contact_obj: Optional[UnifiedObjectRef] = None
        self.steps: list = []        # [(name, ok, evidence, ms)] — the machine-readable acceptance record
        self.no_evidence_stops = 0

    # -- instrumentation ------------------------------------------------------------------------------------------------
    def _step(self, name: str, ok: bool, evidence: str, t0: float) -> None:
        self.steps.append({"step": name, "ok": bool(ok), "evidence": evidence[:300], "ms": round((time.perf_counter() - t0) * 1000, 1)})
        self._log(f"{'✓' if ok else '✗'} [{name}] {evidence[:200]}")

    async def _click(self, x: int, y: int) -> None:
        if self.controller is not None:
            try:
                await self.controller.click(int(x), int(y), self.hwnd)
                return
            except Exception as e:  # noqa: BLE001  — fall back to the proven IO path (it has its own WindowManager hit-test)
                self._log(f"⚠ 实时控制器点击失败（{type(e).__name__}: {str(e)[:80]}）→ 回退到驱动点击")
        await self.io.click(int(x), int(y))

    def _digest(self, lines: Iterable["ms.TextLine"]) -> str:
        return "|".join(sorted(norm(l.text) for l in lines))

