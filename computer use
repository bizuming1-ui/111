class CoordinateNormalizer:
    """Stateless conversions between CSS / PHYS / DXGI; round-half-away-from-zero so negative coordinates do not bias by 1 px."""

    @staticmethod
    def _r(v: float) -> int:
        return int(math.floor(v + 0.5)) if v >= 0 else -int(math.floor(-v + 0.5))

    # ---- CSS <-> PHYS
    def css_to_phys(self, g: ViewportGeometry, x: float, y: float) -> tuple[int, int]:
        return self._r(g.origin_x + x * g.dpr), self._r(g.origin_y + y * g.dpr)

    def phys_to_css(self, g: ViewportGeometry, px: float, py: float) -> tuple[float, float]:
        return (px - g.origin_x) / g.dpr, (py - g.origin_y) / g.dpr

    def css_rect_to_phys(self, g: ViewportGeometry, r: Iterable[float]) -> list[int]:
        x, y, w, h = list(r)[:4]
        x0, y0 = g.origin_x + x * g.dpr, g.origin_y + y * g.dpr
        x1, y1 = g.origin_x + (x + w) * g.dpr, g.origin_y + (y + h) * g.dpr
        return [self._r(x0), self._r(y0), max(0, self._r(x1) - self._r(x0)), max(0, self._r(y1) - self._r(y0))]

    def css_center_phys(self, g: ViewportGeometry, r: Iterable[float]) -> tuple[int, int]:
        x, y, w, h = list(r)[:4]
        return self.css_to_phys(g, x + w / 2.0, y + h / 2.0)

    # ---- PHYS <-> DXGI (screenshot of one monitor, optionally scaled)
    def phys_to_dxgi(self, mon: Monitor, px: float, py: float, scale: float = 1.0) -> tuple[int, int]:
        return self._r((px - mon.left) * scale), self._r((py - mon.top) * scale)

    def dxgi_to_phys(self, mon: Monitor, sx: float, sy: float, scale: float = 1.0) -> tuple[int, int]:
        return self._r(sx / scale + mon.left), self._r(sy / scale + mon.top)

    def scale_for(self, mon: Monitor, shot_w: int) -> float:
        return shot_w / float(mon.width) if mon.width else 1.0

    # ---- a click that lands outside the web contents must never be issued
    def inside_viewport(self, g: ViewportGeometry, px: int, py: int) -> bool:
        x, y, w, h = g.phys_rect
        return x <= px < x + w and y <= py < y + h

