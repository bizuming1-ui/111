@_v18_dc
class WorldStateDiff:
    added: list = _v18_field(default_factory=list)       # object ids that appeared
    removed: list = _v18_field(default_factory=list)     # object ids that vanished
    mutated: list = _v18_field(default_factory=list)     # (object_id, before, after)
    still_valid: list = _v18_field(default_factory=list) # object ids that exist in BOTH snapshots (refs that remain usable)
    context_changed: bool = False
    irreversible_done: list = _v18_field(default_factory=list)  # action keys that already ran and MUST NOT be replayed

    @property
    def empty(self) -> bool:
        return not (self.added or self.removed or self.mutated or self.context_changed)

    def summary(self) -> str:
        if self.empty:
            return "WorldStateDiff=∅（无任何新证据）"
        return (f"WorldStateDiff: +{len(self.added)} −{len(self.removed)} Δ{len(self.mutated)}" + (" · 上下文变化" if self.context_changed else "")
                + f" · 仍有效 {len(self.still_valid)}" + (f" · 不可重放 {len(self.irreversible_done)}" if self.irreversible_done else ""))

    def as_dict(self) -> dict:
        return {"added": self.added[:20], "removed": self.removed[:20], "mutated": [list(m) for m in self.mutated[:20]], "still_valid": len(self.still_valid),
                "context_changed": self.context_changed, "irreversible_done": self.irreversible_done, "empty": self.empty}


def compute_world_diff(before: WorldSnapshot, after: WorldSnapshot, ledger: Optional["IrreversibleLedger"] = None) -> WorldStateDiff:
    b, a = before.objects, after.objects
    added = sorted(set(a) - set(b))
    removed = sorted(set(b) - set(a))
    both = sorted(set(a) & set(b))
    mutated = [(k, b[k], a[k]) for k in both if b[k] != a[k]]
    return WorldStateDiff(added, removed, mutated, [k for k in both if b[k] == a[k]], before.context != after.context,
                          list(ledger.keys()) if ledger is not None else [])


class IrreversibleLedger:
    """Remembers actions whose effect cannot be undone (send / delete / pay).  A replay is refused even if the model asks again."""

    def __init__(self) -> None:
        self._done: dict = {}

    def record(self, key: str, evidence: str = "") -> None:
        self._done[key] = evidence

    def done(self, key: str) -> bool:
        return key in self._done

    def keys(self) -> list:
        return list(self._done)

    def assert_not_replay(self, key: str) -> tuple:
        if key in self._done:
            return False, f"不可逆动作 {key} 已执行（证据: {self._done[key][:60]}），绝不重放"
        return True, ""

    def clear(self) -> None:
        self._done.clear()


@_v18_dc(frozen=True)
class FallbackDecision:
    kind: str          # continue | stop_path | switch_strategy | backtrack | handoff
    reason: str
    next_strategy: str = ""
    forbid_signature: str = ""


class EvidenceGatedFallback:
    """Decides what to do after an action from (ok?, WorldStateDiff).  Token-saving by construction: a path that produced no new evidence is NEVER retried."""

    DEFAULT_LADDER = ("skill_deterministic", "structured_ref", "keyboard_shortcut", "vision_grounded", "human_handoff")

    def __init__(self, ladder: Optional[tuple] = None, max_no_evidence: int = 1) -> None:
        self.ladder = tuple(ladder or self.DEFAULT_LADDER)
        self.level = 0
        self.max_no_evidence = max(1, max_no_evidence)
        self.streak: dict = {}
        self.forbidden: set = set()
        self.ledger = IrreversibleLedger()
        self.stats = {"steps": 0, "stopped_no_evidence": 0, "switched": 0, "handoffs": 0, "replays_blocked": 0, "tokens_saved_est": 0}

    def reset(self) -> None:
        self.level = 0
        self.streak.clear()
        self.forbidden.clear()
        self.ledger.clear()
        self.stats = {k: 0 for k in self.stats}

    @property
    def strategy(self) -> str:
        return self.ladder[min(self.level, len(self.ladder) - 1)]

    def pre_check(self, signature: str, irreversible_key: str = "") -> Optional[FallbackDecision]:
        """call BEFORE executing: a signature that already proved fruitless, or an irreversible action already done, is refused without an LLM round-trip."""
        if irreversible_key:
            ok, why = self.ledger.assert_not_replay(irreversible_key)
            if not ok:
                self.stats["replays_blocked"] += 1
                return FallbackDecision("stop_path", why, forbid_signature=signature)
        if signature in self.forbidden:
            self.stats["stopped_no_evidence"] += 1
            self.stats["tokens_saved_est"] += 3500
            return FallbackDecision("switch_strategy", f"路径 {signature[:48]} 此前没有产生任何新证据（WorldStateDiff=∅），已关闭；换策略 → {self.strategy}", self.strategy, signature)
        return None

    def after_action(self, signature: str, ok: bool, diff: WorldStateDiff, irreversible_key: str = "", evidence: str = "") -> FallbackDecision:
        self.stats["steps"] += 1
        if ok and irreversible_key and not diff.empty:
            self.ledger.record(irreversible_key, evidence or diff.summary())
        if not diff.empty:
            self.streak[signature] = 0
            return FallbackDecision("continue", "产生了新证据：" + diff.summary())
        # ---- empty diff
        n = self.streak.get(signature, 0) + 1
        self.streak[signature] = n
        if ok:  # the driver said OK but the world did not move: an unverified 'success' is not evidence either
            reason = "动作返回 OK 但世界状态无任何变化（疑似落点无效/被拦截）"
        else:
            reason = "动作失败且世界状态无任何变化"
        limit = 1 if not ok else self.max_no_evidence  # a FAILED action with no new evidence is dead at once; an 'OK' one that changed nothing gets one more look
        if n < limit:
            return FallbackDecision("continue", reason + f"（第 {n}/{limit} 次，仍允许一次）")
        self.forbidden.add(signature)
        self.stats["stopped_no_evidence"] += 1
        self.stats["tokens_saved_est"] += 3500
        if self.level + 1 >= len(self.ladder) - 1 and self.strategy != "human_handoff":
            self.level = len(self.ladder) - 1
            self.stats["handoffs"] += 1
            return FallbackDecision("handoff", reason + "；策略阶梯已用尽 → 交还人类（不再消耗 Token）", "human_handoff", signature)
        if self.strategy == "human_handoff":
            self.stats["handoffs"] += 1
            return FallbackDecision("handoff", reason, "human_handoff", signature)
        self.level += 1
        self.stats["switched"] += 1
        return FallbackDecision("switch_strategy", reason + f"；无新证据 → 立即停止该路径并切换策略：{self.ladder[self.level - 1]} → {self.strategy}", self.strategy, signature)

    def backtrack_hint(self, diff: WorldStateDiff) -> str:
        """precise back-off: undo only what the diff proves was changed and is reversible; never touch irreversible ones."""
        if diff.empty:
            return "无需回退：世界未变化"
        parts = []
        if diff.added:
            parts.append(f"新增 {len(diff.added)} 个对象（如弹窗/搜索面板）→ 先 Esc 关闭再继续")
        if diff.mutated:
            parts.append(f"{len(diff.mutated)} 个对象状态被改变 → 只回退这些对象")
        if diff.irreversible_done:
            parts.append("以下不可逆动作已执行，禁止回退/重放：" + "、".join(diff.irreversible_done[:4]))
        return "；".join(parts) or "上下文变化（导航）→ 返回上一页即可"
