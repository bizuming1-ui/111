    return "[V12·STATE] mode=$($v.Mode) route=$($rd.Route)($($rd.Reason)) U=$($rd.U) 效果比=$($rd.EffectRatio) 熵=$($rd.EntropyBits)bit | 已封禁 id=[$(@($v.BannedIds) -join ',')] 坐标=[$rects]（硬性屏蔽，点击会被拒绝）| $guide"
