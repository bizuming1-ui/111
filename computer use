        try:
            suites[name] = fn(args)
        except Exception as e:  # noqa: BLE001
            rec = Rec(name)
            rec("suite crashed", False, f"{type(e).__name__}: {e}\n{traceback.format_exc()[-600:]}")
            suites[name] = rec
    g, c, w, m, s = (suites[k] for k in ("verification_gate", "coordinate_bypass", "wal_crash_recovery", "gmail_composite", "stability"))
    metrics = {
        "false_success_rate_gate": round(getattr(g, "false_success_rate", 1.0), 6),
        "coordinate_bypass_block_rate": round(getattr(c, "block_rate", 0.0), 6),
        "crash_resume_correctness": round(getattr(w, "correctness", 0.0), 6),
