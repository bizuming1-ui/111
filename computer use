class FakeBin(rb.ShellBackend):
    def __init__(self, names: list[str] | None = None, desktop: Path | None = None) -> None:
        self.items: list[rb.BinItem] = []
        self.delete_calls: list[str] = []
        self.restore_calls: list[str] = []
        self.fail_delete: dict[str, list[str]] = {}   # name → queue of behaviours: 'deny' | 'noop'
        self.channel = "fake.NameSpace(10)"
        self._n = 0
        for nm in names or []:
            self.add(nm, str(desktop / nm) if desktop else f"C:\\Users\\u\\Downloads\\{nm}")

    def add(self, name: str, original: str, deleted: str = "2026/11/28 18:10") -> rb.BinItem:
        self._n += 1
        it = rb.BinItem(name=name, original=original, bin_path=f"C:\\$Recycle.Bin\\S-1-5-21\\$R{self._n:04d}{Path(name).suffix}", size=6 + self._n, deleted=deleted)
        self.items.append(it)
        return it

    def list_items(self) -> list[rb.BinItem]:
        return [rb.BinItem(i.name, i.original, i.bin_path, i.size, i.deleted, i.is_dir) for i in self.items]

    def windows(self) -> list[rb.ShellWin]:
        return []

    def count_api(self) -> int:
        return len(self.items)

    def delete_store(self, item: rb.BinItem) -> tuple[bool, str]:
        self.delete_calls.append(item.bin_path)
        q = self.fail_delete.get(item.name)
        if q:
            mode = q.pop(0)
            if mode == "deny":
                return False, "[SECURITY_DENIED] 回收站后备存储受系统策略保护"
            if mode == "noop":
                return True, "已永久删除（假装）"
        self.items = [i for i in self.items if i.bin_path != item.bin_path]
        return True, "已永久删除回收站后备存储（$R + $I）"

    def restore(self, item: rb.BinItem) -> tuple[bool, str]:
        self.restore_calls.append(item.bin_path)
        self.items = [i for i in self.items if i.bin_path != item.bin_path]
        if item.original:
            Path(item.original).parent.mkdir(parents=True, exist_ok=True)
            Path(item.original).write_text("restored", encoding="utf-8")
        return True, "已还原"


class FakeFx:
