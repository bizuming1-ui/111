pub const PROTOCOL_VERSION: u64 = 1;
pub const MAX_LINE_BYTES: usize = 4 * 1024 * 1024;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ErrKind {
    ParseError,
    InvalidRequest,
    MethodNotFound,
    InvalidParams,
    UnsupportedVersion,
    AuthRequired,
    AuthFailed,
    NotFound,
    PolicyDenied,
    SecurityPathViolation,
    IdempotentReplay,
    StaleActionId,
