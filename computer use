//! Deterministic 1,000,000-iteration mutation smoke fuzz of the IPC decoder + FFI surface + ring attach (runs in `cargo test --release`).
//! The coverage-guided version lives in fuzz/ (cargo +nightly fuzz run ipc_decode -- -runs=1000000).
use dscu_v9::{ffi, ipc, ring};

struct Rng(u64);
impl Rng {
    fn next(&mut self) -> u64 { self.0 ^= self.0 << 13; self.0 ^= self.0 >> 7; self.0 ^= self.0 << 17; self.0 }
}

#[test]
fn million_mutations_zero_crash() {
    let seeds: Vec<Vec<u8>> = vec![
        br#"{"jsonrpc":"2.0","v":1,"id":1,"method":"capture.frame","params":{"x":0}}"#.to_vec(),
        br#"{"v":1,"id":2,"method":"uia.act","action_id":7,"expect_hwnd":263466,"expect_fp":"00ff00ff00ff00ff","params":{"ref":"@s8f3k2p9:e8"}}"#.to_vec(),
        b"\xff\xfe\x00{[[[".to_vec(), vec![], vec![b'{'; 64],
    ];
    let mut r = Rng(0x9E37_79B9_7F4A_7C15);
    let (mut ok, mut rejected) = (0u64, 0u64);
    let mut led = ipc::ActionLedger::new();
    for i in 0..1_000_000u64 {
        let mut d = seeds[(r.next() % seeds.len() as u64) as usize].clone();
        for _ in 0..(r.next() % 6) {
            match r.next() % 4 {
                0 if !d.is_empty() => { let p = (r.next() % d.len() as u64) as usize; d[p] = r.next() as u8; }
                1 if !d.is_empty() => { let p = (r.next() % d.len() as u64) as usize; d.remove(p); }
                2 => { let p = (r.next() % (d.len() as u64 + 1)) as usize; d.insert(p, r.next() as u8); }
                _ => { let n = (r.next() % 8) as usize; d.extend((0..n).map(|_| r.next() as u8)); }
            }
        }
        match ipc::decode_line(&d) {
            Ok(e) => { ok += 1; let _ = led.check_commit(e.action_id, i, e.expect_hwnd, 5, e.expect_fp.as_deref(), Some("0000000000000000")); }
            Err(_) => rejected += 1,
        }
        unsafe {
            let mut h = 0u64;
            let _ = ffi::dscu9_ahash(d.as_ptr(), d.len(), &mut h);
            let _ = ffi::dscu9_ipc_validate(d.as_ptr(), d.len());
            if i % 16 == 0 && d.len() >= 4 { let (mut s, mut f) = (0u16, 0u8); let _ = ffi::dscu9_scancode(u32::from_le_bytes([d[0], d[1], d[2], d[3]]), &mut s, &mut f); }
            if i % 64 == 0 {
                let mut mem = vec![0u64; d.len() / 8 + 9];
                std::ptr::copy_nonoverlapping(d.as_ptr(), mem.as_mut_ptr() as *mut u8, d.len());
                if let Ok(v) = ring::RingView::attach(mem.as_mut_ptr() as *mut u8, d.len()) { let mut out = Vec::new(); let _ = v.read_latest(0, &mut out); }
            }
        }
    }
    println!("fuzz-smoke: 1,000,000 iterations, accepted={ok} rejected={rejected}, 0 panics");
    assert!(ok > 1000 && rejected > 1000);
}
