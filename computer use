export function resolveTarget(tab: Tab, target: any, expectEpoch?: number): number {
  if (target?.ref_id) {
    const p = parseRef(String(target.ref_id));
    if (!p) throw new PErr("INVALID_REQUEST", "bad ref_id");
    if (expectEpoch !== undefined && expectEpoch !== p.epoch) throw new PErr("STALE_EPOCH", `expect_epoch ${expectEpoch} != ref epoch ${p.epoch}`);
    if (p.epoch !== tab.epoch) throw new PErr("STALE_EPOCH", `ref epoch ${p.epoch} < current ${tab.epoch}; re-observe`);
