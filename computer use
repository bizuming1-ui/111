//! SendInput injector with full US-layout symbol mapping (`#` = Shift+3, v10 log: Resolve-VK rejected `#`),
//! chords, Unicode typing (CJK without touching the IME) and absolute clicks.
//! The chord parser is portable & unit-tested; the injector is `cfg(windows)`.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Key { pub vk: u16, pub shift: bool }

fn named_vk(n: &str) -> Option<u16> {
    Some(match n {
        "enter" | "return" => 0x0D, "esc" | "escape" => 0x1B, "tab" => 0x09, "space" => 0x20, "backspace" | "back" => 0x08,
        "delete" | "del" => 0x2E, "home" => 0x24, "end" => 0x23, "pageup" | "pgup" => 0x21, "pagedown" | "pgdn" => 0x22,
        "up" => 0x26, "down" => 0x28, "left" => 0x25, "right" => 0x27, "insert" => 0x2D, "win" | "lwin" => 0x5B,
        "ctrl" | "control" => 0x11, "shift" => 0x10, "alt" | "menu" => 0x12,
        _ => return None,
    })
}

/// US keyboard: char -> (virtual key, needs shift)
pub fn char_key(c: char) -> Option<Key> {
    let k = |vk: u16, shift: bool| Some(Key { vk, shift });
    match c {
        'a'..='z' => k(c.to_ascii_uppercase() as u16, false),
        'A'..='Z' => k(c as u16, true),
        '0'..='9' => k(c as u16, false),
        ')' => k(0x30, true), '!' => k(0x31, true), '@' => k(0x32, true), '#' => k(0x33, true), '$' => k(0x34, true),
        '%' => k(0x35, true), '^' => k(0x36, true), '&' => k(0x37, true), '*' => k(0x38, true), '(' => k(0x39, true),
        ' ' => k(0x20, false),
        ';' => k(0xBA, false), ':' => k(0xBA, true), '=' => k(0xBB, false), '+' => k(0xBB, true), ',' => k(0xBC, false),
        '<' => k(0xBC, true), '-' => k(0xBD, false), '_' => k(0xBD, true), '.' => k(0xBE, false), '>' => k(0xBE, true),
        '/' => k(0xBF, false), '?' => k(0xBF, true), '`' => k(0xC0, false), '~' => k(0xC0, true), '[' => k(0xDB, false),
        '{' => k(0xDB, true), '\\' => k(0xDC, false), '|' => k(0xDC, true), ']' => k(0xDD, false), '}' => k(0xDD, true),
        '\'' => k(0xDE, false), '"' => k(0xDE, true),
        _ => None,
    }
}

/// "ctrl+shift+s" / "#" / "ctrl+#" -> (modifier vks, final key)
pub fn parse_chord(s: &str) -> Result<(Vec<u16>, Key), String> {
    let s = s.trim();
    if s.is_empty() { return Err("empty chord".into()); }
    let parts: Vec<&str> = if s.chars().count() == 1 { vec![s] } else { s.split('+').filter(|p| !p.is_empty()).collect() };
    let mut mods: Vec<u16> = vec![];
    let mut last: Option<Key> = None;
    for (i, p) in parts.iter().enumerate() {
        let lower = p.to_lowercase();
        let is_last = i == parts.len() - 1;
        if !is_last {
            match named_vk(&lower) { Some(v) if matches!(v, 0x10 | 0x11 | 0x12 | 0x5B) => mods.push(v), _ => return Err(format!("bad modifier {p:?}")) }
        } else if let Some(v) = named_vk(&lower) {
            last = Some(Key { vk: v, shift: false });
        } else if lower.len() == 2 && lower.starts_with('f') && lower[1..].parse::<u16>().map(|n| (1..=9).contains(&n)).unwrap_or(false) {
            last = Some(Key { vk: 0x70 + lower[1..].parse::<u16>().unwrap() - 1, shift: false });
        } else if lower.len() == 3 && lower.starts_with('f') && matches!(lower[1..].parse::<u16>(), Ok(10..=12)) {
            last = Some(Key { vk: 0x70 + lower[1..].parse::<u16>().unwrap() - 1, shift: false });
        } else if p.chars().count() == 1 {
            last = Some(char_key(p.chars().next().unwrap()).ok_or_else(|| format!("unmappable key {p:?}"))?);
        } else { return Err(format!("unknown key {p:?}")); }
    }
    let key = last.ok_or("no key")?;
    if key.shift && !mods.contains(&0x10) { mods.push(0x10); }
    Ok((mods, Key { vk: key.vk, shift: false }))
}

