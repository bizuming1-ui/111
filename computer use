        for root in [std::env::var("ProgramData").unwrap_or_default() + r"\Microsoft\Windows\Start Menu\Programs", std::env::var("APPDATA").unwrap_or_default() + r"\Microsoft\Windows\Start Menu\Programs"] { walk_lnk(std::path::Path::new(&root), &mut out, &mut budget); }
