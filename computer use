"""Real-time perception hub. Every step it asks the live sources (Rust driver always; TS CDP daemon when the foreground
is a browser) and DERIVES channel / stalled / blocked_streak from what came back. Nothing here is a canned value."""
from __future__ import annotations

import asyncio
import hashlib
import time
from dataclasses import dataclass, field
from typing import Any

from .ipc_client import IpcClient, IpcError
from .policy import sanitize_untrusted
from .protocol import Element, ObservationEnvelope
from .router import BROWSER_PROCS


@dataclass
class Item:
    id: int
    el: Element
    source: str  # "cdp" | "driver"


@dataclass
class Perception:
    channel: str
    primary: ObservationEnvelope
    driver_env: ObservationEnvelope | None
    cdp_env: ObservationEnvelope | None
    items: list[Item]
    text: str
    sig: str
    ahash: str | None
    uia_count: int
    fg_is_browser: bool
    cdp_up: bool
    ms: dict[str, float] = field(default_factory=dict)
    errors: list[str] = field(default_factory=list)
    injection_hits: int = 0
    diff: str = ""

    @property
    def hwnd(self) -> int:
        return (self.driver_env or self.primary).hwnd

    @property
    def title(self) -> str:
        return (self.cdp_env.page.title if self.cdp_env and self.cdp_env.page else "") or (self.driver_env or self.primary).title

    @property
    def epoch_for(self) -> dict[str, int]:
        d: dict[str, int] = {}
        if self.driver_env:
            d["driver"] = self.driver_env.snapshot_epoch
        if self.cdp_env:
            d["cdp"] = self.cdp_env.snapshot_epoch
        return d

    def item(self, i: int) -> Item | None:
        return next((x for x in self.items if x.id == i), None)


def _fmt(it: Item, tainted: bool) -> tuple[str, int]:
    e = it.el
    name, hits = (sanitize_untrusted(e.name)) if tainted else (e.name, 0)
    parts = [f"[{it.id}] {e.role} \"{name}\""]
    if e.value:
        v, h2 = sanitize_untrusted(e.value) if tainted else (e.value, 0)
        hits += h2
        parts.append(f"value=\"{v}\"")
    if e.checked:
        parts.append("✓勾选")
    if e.occluded:
        parts.append("⊘遮挡")
    if e.focused:
        parts.append("★焦点")
    if e.patterns:
        parts.append("{" + ",".join(e.patterns) + "}")
    parts.append(f"[Zone: {e.zone}]")
    if e.row_index:
        parts.append(f"R{e.row_index}")
    cx, cy = e.rect.center
    parts.append(f"@({cx},{cy})")
    return " ".join(parts), hits


class PerceptionHub:
    def __init__(self, driver: IpcClient | Any, cdp: IpcClient | None, max_lines: int = 70):
        self.driver, self.cdp, self.max_lines = driver, cdp, max_lines
        self.cdp_up = cdp is not None and cdp.connected
        self.prev: Perception | None = None
        self.same_count = 0
        self.dxgi_samples: list[tuple[str, float]] = []
        self.cap_ms: list[float] = []
        self.uia_ms: list[float] = []
        self.cdp_ms: list[float] = []

    async def probe_cdp(self) -> bool:
        if self.cdp is None:
            return False
        try:
            if not self.cdp.connected:
                await self.cdp.connect(retries=2, delay=0.05)
            await self.cdp.ping()
            self.cdp_up = True
        except (IpcError, OSError):
            self.cdp_up = False
        return self.cdp_up

    async def observe(self, want_screenshot: bool = False, target: dict[str, Any] | None = None, skeleton: bool = False, max_nodes: int = 300) -> Perception:
        t0 = time.perf_counter()
        errors: list[str] = []
        ms: dict[str, float] = {}
        # 1) cheap driver probe: foreground window, process, DXGI telemetry, ahash (always real, always first)
        light = await self.driver.observe({"want": {"uia": False, "windows": True, "ahash": True}, "target": target or {}}, timeout=10)
        ms["probe"] = (time.perf_counter() - t0) * 1000
        if light.dxgi_stats:
            self.dxgi_samples.append((light.dxgi_stats.capture_backend, light.dxgi_stats.frame_ms))
            self.cap_ms.append(light.dxgi_stats.frame_ms)
        fg_proc = (light.process or "").lower()
        fg_is_browser = fg_proc in BROWSER_PROCS
        cdp_env: ObservationEnvelope | None = None
        driver_env: ObservationEnvelope = light
        uia_count = 0
        # 2) browser foreground -> CDP daemon (AX+DOM fusion, Toolbar/Row zones, settled)
        if fg_is_browser:
            if await self.probe_cdp():
                t1 = time.perf_counter()
                try:
                    assert self.cdp is not None
                    cdp_env = await self.cdp.observe({"want": {"settle": True, "max_nodes": max_nodes, "skeleton": skeleton}}, timeout=25)
                    ms["cdp"] = (time.perf_counter() - t1) * 1000
                    self.cdp_ms.append(ms["cdp"])
                except (IpcError, Exception) as e:  # noqa: BLE001
                    errors.append(f"cdp: {e}")
            else:
                errors.append("cdp daemon unreachable (browser has no debugging port yet)")
        # 3) UIA snapshot when we are not on a CDP page (or CDP produced nothing)
        if cdp_env is None or cdp_env.element_count == 0:
            t2 = time.perf_counter()
            try:
                driver_env = await self.driver.observe({"want": {"uia": True, "skeleton": skeleton, "max_nodes": max_nodes, "windows": False, "ahash": True, "screenshot": want_screenshot}, "target": {"hwnd": light.hwnd} if light.hwnd else (target or {})}, timeout=30)
                ms["uia"] = (time.perf_counter() - t2) * 1000
                self.uia_ms.append(driver_env.collected_ms if driver_env.collected_ms else ms["uia"])
                uia_count = driver_env.element_count
                if driver_env.dxgi_stats:
                    self.dxgi_samples.append((driver_env.dxgi_stats.capture_backend, driver_env.dxgi_stats.frame_ms))
            except IpcError as e:
                errors.append(f"driver.uia: {e}")
        elif want_screenshot:
            driver_env = await self.driver.observe({"want": {"uia": False, "windows": False, "screenshot": True, "screenshot_scope": "window"}, "target": {"hwnd": light.hwnd}}, timeout=20)
        # channel is derived from what actually came back
        if cdp_env is not None and cdp_env.element_count > 0:
            channel, primary = "cdp", cdp_env
        else:
            primary = driver_env
            channel = driver_env.channel
            if driver_env.element_count < 6 and channel == "uia":
                channel = "dxgi_vision"
        items: list[Item] = []
        for src, env in (("cdp", cdp_env), ("driver", driver_env)):
            if env is None or (src == "driver" and channel == "cdp"):
                continue
            for el in env.elements:
                if el.zone != "Modal" and el.occluded and src == "cdp":
                    continue
                items.append(Item(len(items) + 1, el, src))
        items = items[: self.max_lines]
        p = Perception(channel, primary, driver_env, cdp_env, items, "", "", driver_env.screen_ahash or light.screen_ahash, uia_count if channel != "cdp" else (cdp_env.element_count if cdp_env else 0),
                       fg_is_browser, self.cdp_up, ms, errors)
        p.text, p.injection_hits = self._render(p)
        p.sig = hashlib.sha1(("|".join([p.title, p.channel] + sorted(i.el.stable_key for i in items[:60])) + (p.ahash or "")).encode()).hexdigest()[:16]
        p.diff = self._diff(p)
        self.same_count = self.same_count + 1 if self.prev and self.prev.sig == p.sig else 0
        self.prev = p
        ms["total"] = (time.perf_counter() - t0) * 1000
        return p

    def _render(self, p: Perception) -> tuple[str, int]:
        tainted = p.channel == "cdp" or p.primary.taint
        lines: list[str] = []
        hits = 0
        for it in p.items:
            s, h = _fmt(it, tainted)
            lines.append(s)
            hits += h
        d = p.driver_env or p.primary
        head = [f"前台窗口: [{d.title}] 进程={d.process} hwnd={d.hwnd} 通道={p.channel}"]
        if p.cdp_env and p.cdp_env.page:
            pg = p.cdp_env.page
            t, h = sanitize_untrusted(pg.title)
            hits += h
            head.append(f"页面: {pg.url} 标题「{t}」 readyState={pg.ready_state} 在途请求={pg.inflight}")
        if d.dxgi_stats:
            s = d.dxgi_stats
            head.append(f"屏幕: {s.capture_backend} {s.frame_ms:.1f}ms 脏矩形={s.dirty_rects_count}" + (f" 回退原因={s.fallback_reason}" if s.fallback_reason else ""))
        if d.windows:
            head.append("其他窗口: " + "; ".join(f"{w.get('process')}:{str(w.get('title'))[:24]}" for w in d.windows[:8]))
        if p.errors:
            head.append("观察告警: " + " | ".join(p.errors))
        body = "\n".join(lines) if lines else "（无可交互控件：请使用视觉通道 / 快捷键）"
        txt = "\n".join(head) + "\n控件:\n" + body
        if hits:
            txt += f"\n⚠ 已屏蔽 {hits} 处疑似提示词注入（网页内容不可信）。"
        return txt, hits

    def _diff(self, p: Perception) -> str:
        if not self.prev:
            return "（首轮观察）"
        o = self.prev
        out = []
        if o.title != p.title:
            out.append(f"标题: 「{o.title[:30]}」→「{p.title[:30]}」")
        if o.channel != p.channel:
            out.append(f"通道: {o.channel}→{p.channel}")
        a = {(i.el.role, i.el.name) for i in o.items}
        b = {(i.el.role, i.el.name) for i in p.items}
        new = [f"{r}「{n[:20]}」" for r, n in list(b - a)[:5]]
        gone = [f"{r}「{n[:20]}」" for r, n in list(a - b)[:5]]
        if new:
            out.append("新增: " + ", ".join(new))
        if gone:
            out.append("消失: " + ", ".join(gone))
        if o.ahash and p.ahash and o.ahash != p.ahash:
            out.append(f"屏幕像素变化(ahash {bin(int(o.ahash, 16) ^ int(p.ahash, 16)).count('1')} 位)")
        return "；".join(out) if out else "控件列表与屏幕与上一轮完全相同（上一步可能没生效或页面仍在加载）"

    def stalled(self) -> bool:
        return self.same_count >= 2
