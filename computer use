        lock (gate) {
            double now = sw.Elapsed.TotalMilliseconds;
            x0 = curX; y0 = curY; x1 = x; y1 = y;
            double dx = x1 - x0, dy = y1 - y0;
            double d = Math.Sqrt(dx * dx + dy * dy);
            if (d < 1.0 || durationMs <= 0) {
                curX = x; curY = y; moving = false;
            } else {
                double nx = -dy / d, ny = dx / d;
                flip = -flip;
                double off = Math.Min(60.0 * scale, d * 0.10) * flip;
                c1x = x0 + dx * 0.30 + nx * off; c1y = y0 + dy * 0.30 + ny * off;
                c2x = x0 + dx * 0.72 + nx * off * 0.5; c2y = y0 + dy * 0.72 + ny * off * 0.5;
                t0 = now; dur = durationMs; moving = true;
            }
            wantVisible = true; lastActivity = now;
        }
    }
    public bool WaitIdle(int timeoutMs) {
        double end = sw.Elapsed.TotalMilliseconds + timeoutMs;
        while (moving) {
            if (sw.Elapsed.TotalMilliseconds > end) return false;
            Thread.Sleep(2);
        }
        return true;
    }
    public void Follow(double x, double y) {
        lock (gate) { curX = x; curY = y; moving = false; wantVisible = true; lastActivity = sw.Elapsed.TotalMilliseconds; }
    }
    public void Pulse(int kind) {
        lock (gate) { rippleStart = sw.Elapsed.TotalMilliseconds; rippleKind = kind; wantVisible = true; lastActivity = rippleStart; }
    }
    public void SetPressed(bool p) {
        lock (gate) { pressed = p; wantVisible = true; lastActivity = sw.Elapsed.TotalMilliseconds; }
    }
    static double Clamp(double v, double lo, double hi) { return v < lo ? lo : (v > hi ? hi : v); }
    static int Pack(double a, double r, double g, double b) {
        int A = (int)(Clamp(a, 0, 1) * 255 + 0.5);
        int R = (int)(Clamp(r, 0, 1) * 255 + 0.5);
        int G = (int)(Clamp(g, 0, 1) * 255 + 0.5);
        int B = (int)(Clamp(b, 0, 1) * 255 + 0.5);
        return (A << 24) | (R << 16) | (G << 8) | B;
    }
    static double SignedDist(double[] px, double[] py, double x, double y) {
        int n = px.Length; double best = double.MaxValue; bool inside = false;
        for (int i = 0, j = n - 1; i < n; j = i++) {
            double ax = px[j], ay = py[j], bx = px[i], by = py[i];
            if (((ay > y) != (by > y)) && (x < (bx - ax) * (y - ay) / (by - ay) + ax)) inside = !inside;
            double vx = bx - ax, vy = by - ay, wx = x - ax, wy = y - ay;
            double len2 = vx * vx + vy * vy;
            double t = len2 > 0 ? (wx * vx + wy * vy) / len2 : 0;
            t = Clamp(t, 0, 1);
            double ex = x - (ax + t * vx), ey = y - (ay + t * vy);
            double dd = Math.Sqrt(ex * ex + ey * ey);
            if (dd < best) best = dd;
        }
        return inside ? -best : best;
    }
    // 箭头精灵：有符号距离场做解析抗锯齿；蓝色主体 + 白色描边 + 柔和阴影（和真实指针一眼可分辨）
    void BuildSprite() {
        sprite = new int[size * size];
        double k = scale * 1.15;
        double[] ax = { 0, 0, 4.2, 7.3, 10.2, 7.4, 12.8 };
        double[] ay = { 0, 18.0, 14.0, 20.8, 19.5, 12.6, 12.6 };
        for (int i = 0; i < ax.Length; i++) { ax[i] *= k; ay[i] *= k; }
        double bw = 1.5 * scale, blur = 3.2 * scale, sx = 1.2 * scale, sy = 2.2 * scale;
        double cr = 47.0 / 255.0, cg = 123.0 / 255.0, cb = 1.0;
        for (int iy = 0; iy < size; iy++) {
            for (int ix = 0; ix < size; ix++) {
                double x = ix + 0.5 - half, y = iy + 0.5 - half;
                if (x < -8 * scale || y < -8 * scale || x > 28 * scale || y > 34 * scale) continue;
                double dd = SignedDist(ax, ay, x, y);
                double outer = Clamp(0.5 - (dd - bw), 0, 1);
                double inner = Clamp(0.5 - dd, 0, 1);
                double f = outer > 0.0001 ? Math.Min(1.0, inner / outer) : 0;
                double ds = SignedDist(ax, ay, x - sx, y - sy);
                double c = Clamp(1.0 - (ds - bw) / blur, 0, 1);
                double sh = 0.40 * c * c;
                double r = cr * f + (1 - f), g = cg * f + (1 - f), b = cb * f + (1 - f);
                double outA = outer + sh * (1 - outer);
                sprite[iy * size + ix] = Pack(outA, r * outer, g * outer, b * outer);
            }
        }
    }
    void DrawRing(int[] f, double radius, double ringW, double alpha, double glow, double cr, double cg, double cb) {
        int lim = (int)Math.Ceiling(radius + ringW + 2);
        for (int dy = -lim; dy < lim; dy++) {
            for (int dx = -lim; dx < lim; dx++) {
                int px = half + dx, py = half + dy;
                if (px < 0 || py < 0 || px >= size || py >= size) continue;
                double rx = dx + 0.5, ry = dy + 0.5;
                double r = Math.Sqrt(rx * rx + ry * ry);
                double a = alpha * Clamp(1.0 - Math.Abs(r - radius) / ringW, 0, 1);
                if (r < radius) a += glow * (1.0 - r / radius);
                if (a <= 0.002) continue;
                if (a > 1) a = 1;
                int idx = py * size + px; int d = f[idx];
                double da = ((d >> 24) & 255) / 255.0, dr = ((d >> 16) & 255) / 255.0, dg = ((d >> 8) & 255) / 255.0, db = (d & 255) / 255.0;
                double ia = 1 - a;
                f[idx] = Pack(a + da * ia, cr * a + dr * ia, cg * a + dg * ia, cb * a + db * ia);
            }
        }
    }
    void Run() {
        IntPtr screenDc = IntPtr.Zero, memDc = IntPtr.Zero, bmp = IntPtr.Zero, oldObj = IntPtr.Zero, bits = IntPtr.Zero;
        bool timer = false;
        try {
            try { timeBeginPeriod(1); timer = true; } catch { }
            half = (int)Math.Round(46 * scale); size = half * 2;
            BuildSprite();
            frame = new int[size * size];
            // WS_EX_LAYERED | TRANSPARENT | TOPMOST | NOACTIVATE | TOOLWINDOW ；WS_POPUP ；借用系统 STATIC 类，无需自定义 WndProc
            Hwnd = CreateWindowEx(0x080800A8u, "STATIC", "DeepSeekVirtualCursor", 0x80000000u, 0, 0, size, size, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero);
            if (Hwnd == IntPtr.Zero) { Error = "CreateWindowEx 失败: " + Marshal.GetLastWin32Error(); return; }
            try { SetWindowDisplayAffinity(Hwnd, 0x11u); } catch { }   // 不出现在截图里
            BITMAPINFOHEADER bi = new BITMAPINFOHEADER();
            bi.biSize = 40; bi.biWidth = size; bi.biHeight = -size; bi.biPlanes = 1; bi.biBitCount = 32; bi.biCompression = 0;
            screenDc = GetDC(IntPtr.Zero);
            memDc = CreateCompatibleDC(screenDc);
            bmp = CreateDIBSection(memDc, ref bi, 0, out bits, IntPtr.Zero, 0);
            if (bmp == IntPtr.Zero || bits == IntPtr.Zero) { Error = "CreateDIBSection 失败"; return; }
            oldObj = SelectObject(memDc, bmp);
            ShowWindow(Hwnd, 4);
            Ok = true; ready.Set();
            double opacity = 0, lastLoop = sw.Elapsed.TotalMilliseconds, lastTop = lastLoop, lastRender = lastLoop;
            int lastOx = int.MinValue, lastOy = int.MinValue, lastOpa = -1;
            bool bitsHaveFx = false, firstFrame = true, lastMoving = false;
            while (!quit) {
                MSG m = new MSG();
                while (PeekMessage(out m, IntPtr.Zero, 0, 0, 1)) { TranslateMessage(ref m); DispatchMessage(ref m); }
                double now = sw.Elapsed.TotalMilliseconds;
                double dt = now - lastLoop; lastLoop = now;
                double px, py, rs; int rk; bool pr, vis, mv;
                lock (gate) {
                    if (moving) {
                        double t = (now - t0) / dur;
                        if (t >= 1.0) { moving = false; curX = x1; curY = y1; }
                        else {
                            double s = t * t * t * (10.0 + t * (-15.0 + 6.0 * t));   // 最小加加速度
                            double u = 1 - s;
                            curX = u * u * u * x0 + 3 * u * u * s * c1x + 3 * u * s * s * c2x + s * s * s * x1;
                            curY = u * u * u * y0 + 3 * u * u * s * c1y + 3 * u * s * s * c2y + s * s * s * y1;
                        }
                    }
                    px = curX; py = curY; rs = rippleStart; rk = rippleKind; pr = pressed; mv = moving;
                    if (wantVisible && !moving && !pressed && now - lastActivity > 3500 && now - rs > 600) wantVisible = false;
                    vis = wantVisible;
                }
                double target = vis ? 255.0 : 0.0;
                if (Math.Abs(target - opacity) > 0.5) {
                    double kf = 1 - Math.Exp(-dt / 70.0);
                    opacity += (target - opacity) * kf;
                    if (Math.Abs(target - opacity) < 1.0) opacity = target;
                }
                int opa = (int)Math.Round(opacity);
                double age = now - rs;
                bool rippleActive = age >= 0 && age < RippleDur;
                bool fx = rippleActive || pr;
                bool animating = mv || fx || opa != (int)target;
                if (opa > 0 || lastOpa > 0) {
                    bool contentChange = fx || bitsHaveFx;
                    if (contentChange) {
                        Array.Copy(sprite, frame, sprite.Length);
                        if (rippleActive) {
                            double tt = age / RippleDur;
                            double e = 1 - Math.Pow(1 - tt, 3);
                            double cr = 47.0 / 255.0, cg = 123.0 / 255.0, cb = 1.0;
                            if (rk == 1) { cr = 1.0; cg = 150.0 / 255.0; cb = 40.0 / 255.0; }
                            else if (rk == 2) { cr = 50.0 / 255.0; cg = 200.0 / 255.0; cb = 120.0 / 255.0; }
                            DrawRing(frame, (8 + 30 * e) * scale, 2.4 * scale, 0.9 * (1 - tt), 0.22 * (1 - tt), cr, cg, cb);
                        }
                        if (pr) DrawRing(frame, 10 * scale, 2.0 * scale, 0.75, 0.15, 47.0 / 255.0, 123.0 / 255.0, 1.0);
                        Marshal.Copy(frame, 0, bits, frame.Length);
                        bitsHaveFx = fx;
                    } else if (firstFrame) {
                        Marshal.Copy(sprite, 0, bits, sprite.Length);
                    }
                    int ox = (int)Math.Round(px) - half, oy = (int)Math.Round(py) - half;
                    if (contentChange || firstFrame || ox != lastOx || oy != lastOy || opa != lastOpa) {
                        POINT dst = new POINT(); dst.X = ox; dst.Y = oy;
                        SIZE sz = new SIZE(); sz.cx = size; sz.cy = size;
                        POINT src = new POINT();
                        BLENDFUNCTION bf = new BLENDFUNCTION(); bf.BlendOp = 0; bf.BlendFlags = 0; bf.SourceConstantAlpha = (byte)opa; bf.AlphaFormat = 1;
                        UpdateLayeredWindow(Hwnd, IntPtr.Zero, ref dst, ref sz, memDc, ref src, 0, ref bf, 2u);
                        lastOx = ox; lastOy = oy; lastOpa = opa; firstFrame = false;
                        Frames++;
                        if (mv && lastMoving) { double gap = now - lastRender; if (gap > MaxGapMs) MaxGapMs = gap; }
                        lastRender = now;
                    }
                } else { lastOpa = opa; }
                lastMoving = mv;
                if (now - lastTop > 600) { lastTop = now; SetWindowPos(Hwnd, new IntPtr(-1), 0, 0, 0, 0, 0x13u); }
                if (animating) {
                    int hr = 1;
                    try { hr = DwmFlush(); } catch { hr = 1; }
                    if (hr != 0) Thread.Sleep(6);
                } else { Thread.Sleep(10); }
            }
        } catch (Exception ex) { Error = ex.Message; }
        finally {
            try { if (Hwnd != IntPtr.Zero) DestroyWindow(Hwnd); } catch { }
            try { if (oldObj != IntPtr.Zero) SelectObject(memDc, oldObj); } catch { }
            try { if (bmp != IntPtr.Zero) DeleteObject(bmp); } catch { }
            try { if (memDc != IntPtr.Zero) DeleteDC(memDc); } catch { }
            try { if (screenDc != IntPtr.Zero) ReleaseDC(IntPtr.Zero, screenDc); } catch { }
            if (timer) { try { timeEndPeriod(1); } catch { } }
            ready.Set();
        }
    }
}
