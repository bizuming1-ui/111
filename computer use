            directive = self.ladder.evaluate(st, b.obs)
            _cdv = self.core.take_directive()  # v18.1: BlockedEdge list + next legal route + frozen target identities
            _note = (self.recovery.take_note() + ("\n" + _v18n if _v18n else "") + ("\n" + _cdv if _cdv else "")).strip()
            _deny = self.recovery.deny_summary()
