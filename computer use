def describe_occluders(obs: Observation, limit: int = 4) -> str:
    t = obs.target_window() or obs.fg_window()
    if not t or not t.occluded_by:
        return ""
    by = {w.hwnd: w for w in obs.windows}
    parts = []
    for h in t.occluded_by[:limit]:
        w = by.get(h)
        if w:
            parts.append(f"{w.process}:{w.title[:30]!r}{'(本控制台)' if w.own_console else ''}")
    return f"目标窗口 {t.process}「{t.title[:24]}」被 {len(t.occluded_by)} 个窗口遮挡：" + "；".join(parts)


class RecoveryLadder:
    """Turns raw evidence into an escalating, *measured* directive. Never repeats the same remedy blindly."""

    def evaluate(self, st: TaskState, obs: Observation) -> Directive:
        d = Directive()
        notes: list[str] = []
        st.tick_masks()
        crashes = st.update_crashes(obs)
        if crashes:
            procs = {c.split("|")[0] for c in crashes}
            worst = max([st.crashes[p] for p in procs] + [st.crashes.get(st.target_hint + ".exe", 0)])
            notes.append(f"检测到崩溃/错误报告窗口（{', '.join(sorted(procs))}，累计 {worst} 次）。这不是目标应用窗口：先点击该对话框自带的“确定/关闭”(取消“重启”勾选)，不要 alt+f4。")
            d.level = max(d.level, 1)
            if worst >= 3:
                d.escalate_human = True
                d.reason = f"目标应用反复崩溃 {worst} 次（{', '.join(sorted(procs))}）：继续重启只会空耗步数，需要人工修复该应用（重装/更新/清缓存）后重试。"
        occ = describe_occluders(obs)
        if occ:
            notes.append(occ)
            d.auto_remedy = "minimize_blockers"
        lp = st.detect_loop()
        if lp:
            kind, sig = lp
            st.loop_hits[sig] += 1
            n = st.loop_hits[sig]
            name = sig.split(":")[0]
            notes.append(f"【循环检测】动作 {sig} 已重复 ≥3 次且无可验证效果（第 {n} 次触发）。")
            d.level = max(d.level, min(n + 1, 4))
            if n == 1:
                st.masks[name] = 3
                d.masked.add(name)
                notes.append(f"系统已屏蔽 {name} 3 步。必须换方法：阅读上面的『遮挡/崩溃/前台』证据，做不同的事。")
            elif n == 2:
                st.masks[name] = 5
                d.force_channel = "dxgi_vision"
                d.auto_remedy = d.auto_remedy or "minimize_blockers"
                notes.append("第 2 次：已切到视觉通道并自动最小化遮挡窗口；仍失败请改用 launch/app_resolve 或点击任务栏图标。")
            else:
                d.escalate_human = True
                d.reason = f"同一动作 {sig} 循环 {n} 次仍无效，已用尽恢复阶梯（屏蔽→视觉→遮挡清理）。"
        if st.stalled_steps >= 2 and not d.force_channel:
            notes.append(f"连续 {st.stalled_steps} 步界面无变化（语义停滞）：换控件/换通道，不要重复。")
            if obs.channel == "uia" and not obs.elements:
                d.force_channel = "dxgi_vision"
        if st.blocked_streak >= 4:
            notes.append(f"连续 {st.blocked_streak} 步被拒绝/无效。")
            d.level = max(d.level, 3)
        if notes:
            d.text = "\n".join("· " + n for n in notes)
        return d
