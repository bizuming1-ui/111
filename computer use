def _find_client_secrets() -> list[Path]:
    out: list[Path] = []
    home = Path(os.path.expanduser("~"))
    for d in (home / "Downloads", home / "Desktop", home / "Documents", Path.cwd()):
        try:
            out += [p for p in d.glob("client_secret*.json") if p.is_file()]
        except OSError:
            pass
    return sorted(set(out), key=lambda p: p.stat().st_mtime, reverse=True)


