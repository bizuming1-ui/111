"""State-conditioned action ledger: key = (action, target signature, foreground hwnd, selection fingerprint, modal hash)."""
from __future__ import annotations
import math
from dataclasses import dataclass


@dataclass(frozen=True)
class Probe:
    kind: str
    pt: tuple[int, int] | None = None
    keys: str = ""
    title: str = ""
    hwnd: int = 0
    sel: str = ""
    modal: str = ""


@dataclass
class Entry:
    probe: Probe
    step: int
    outcome: str = "pending"   # changed | nochange | unknown | pending


def fnv1a(s: str) -> str:
    h = 2166136261
    b = s.encode("utf-16-le")   # PowerShell hashes UTF-16 code units
    for i in range(0, len(b), 2):
        h = ((h ^ (b[i] | (b[i + 1] << 8))) * 16777619) & 0xFFFFFFFF
    return f"{h:08x}"


def selection_fp(rows: list[tuple[str, bool]]) -> str:
    on = [(i, t) for i, (t, c) in enumerate(rows, 1) if c]
    if not on: return "sel:0"
    return f"sel:{len(on)}:{fnv1a('|'.join(t or f'#{i}' for i, t in on))}"


def match(e: Probe, p: Probe, ignore_state: bool = False) -> bool:
    if e.kind != p.kind or e.title != p.title: return False
    if not ignore_state:
        if e.sel != p.sel or e.modal != p.modal: return False
        if e.hwnd and p.hwnd and e.hwnd != p.hwnd: return False
    if p.kind in ("key", "hotkey"): return e.keys == p.keys
    if e.pt is None or p.pt is None: return False
    return math.dist(e.pt, p.pt) <= 36


class RepeatError(Exception):
    pass


class Ledger:
    def __init__(self) -> None:
        self.entries: list[Entry] = []
        self.state_refresh = 0

    def record(self, probe: Probe, step: int, outcome: str) -> None:
        self.entries.append(Entry(probe, step, outcome))

    def guard(self, probe: Probe, repeat: bool = False) -> Probe:
        hits = [e for e in self.entries if match(e.probe, probe)]
        if not hits:
            if any(match(e.probe, probe, ignore_state=True) for e in self.entries): self.state_refresh += 1
            return probe
        last = hits[-1]
        if sum(1 for e in hits if e.outcome == "nochange") >= 2: raise RepeatError("REPEAT_NOEFFECT")
        if last.outcome == "nochange": return probe
        if last.outcome == "changed" and not repeat: raise RepeatError("REPEAT_EFFECT")
        if last.outcome != "changed" and not repeat: raise RepeatError("REPEAT_UNVERIFIED")
        return probe
