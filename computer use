    def test_remaining_work_is_identity_based_and_consistent_with_world(self) -> None:
        env = Env(BIN6)
        try:
            g = compile_goal("删除回收站前面两个")
            assert g is not None
            sel = resolve_selection(g, env.world.refresh("recyclebin"))
            frozen = list(sel.refs)
            rw0 = recompute_remaining_work(g, frozen, env.world.refresh("recyclebin"))
            self.assertEqual((rw0.total, len(rw0.remaining), rw0.complete), (2, 2, False))
            env.backend.items = [i for i in env.backend.items if i.bin_path != frozen[0].bin_path]   # first one removed by ANYONE
            rw1 = recompute_remaining_work(g, frozen, env.world.refresh("recyclebin"))
            self.assertEqual(([r.identity for r in rw1.vanished], [r.identity for r in rw1.remaining]), ([frozen[0].identity], [frozen[1].identity]))
            rw2 = recompute_remaining_work(g, frozen, env.world.refresh("recyclebin"), committed={frozen[1].identity})
