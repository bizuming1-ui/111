    # -- cdp
    async def ensure_cdp(self) -> bool:
        if self._cdp and not self._cdp.lost:
            return True
        cfg = self.cfg
        node = shutil.which("node")
        if not node or not cfg.daemon_entry.exists():
            self.cdp_error = "node 或 cdp-daemon 缺失"
            return False
        prof = cfg.cdp_profile if cfg.cdp_profile in ("persistent", "ephemeral") else "persistent"
        pdir = cfg.auth_profile_dir if prof == "persistent" else cfg.data_dir / "ephemeral-profile"
        env = dict(os.environ, DSCU_TOKEN=self.token, DSCU_CDP_PORT=str(cfg.cdp_port), DSCU_PROFILE=str(pdir), DSCU_CDP_PROFILE=prof)
        c = NdjsonClient(cfg.cdp_pipe, "cdp-daemon", self.token)
        try:
            try:
                await c.connect(0.6)
            except IpcError:
                self.procs["cdp"] = spawn([node, "--max-old-space-size=96", "--experimental-strip-types", "--disable-warning=ExperimentalWarning", str(cfg.daemon_entry), "--pipe", cfg.cdp_pipe, "--cdp-profile", prof, "--profile-dir", str(pdir)], env, cfg.root, cfg.data_dir / "cdp-daemon.log")
                await c.connect(25)
            self.cdp_hello = await c.hello()
            self._cdp = c
            self.cdp_error = None
            return True
        except Exception as e:
            self.cdp_error = str(e)
            return False

    @property
    def cdp_up(self) -> bool:
        return bool(self._cdp and not self._cdp.lost)

    async def cdp_heal(self, reason: str, tries: int = 8, force: bool = False) -> bool:
        """Self-healing CDP: 500 ms back-off.  (1) daemon process gone -> respawn it with the same --cdp-profile;
        (2) daemon alive -> ask it to reconnect / relaunch the browser / re-attach the target (it bumps snapshot_epoch);
        (3) refresh `cdp_hello` (browser pids change after a relaunch -> FG-Gate must see the new pid)."""
        if self._heal_lock is None:
            self._heal_lock = asyncio.Lock()
        async with self._heal_lock:
            t0 = time.perf_counter()
            last = ""
            for attempt in range(1, tries + 1):
                try:
                    if self._cdp is None or self._cdp.lost:
                        self._cdp = None
                        if not await self.ensure_cdp():
                            raise IpcError(self.cdp_error or "ensure_cdp failed")
                    assert self._cdp is not None
                    r = await self._cdp.call({"type": "heal", "reason": reason[:160], "force": force}, 45)
                    if r.get("ok"):
                        try:
                            self.cdp_hello = await self._cdp.hello()
                        except Exception:  # noqa: BLE001
                            pass
                        ms = round((time.perf_counter() - t0) * 1000)
                        if r.get("healed"):
                            self.cdp_heals += 1
                            self.cdp_heal_log.append({"reason": reason[:120], "attempt": attempt, "ms": ms, "respawned": bool(r.get("browser_respawned")), "epoch": r.get("epoch")})
                        self.cdp_error = None
                        return True
                    last = str(r.get("message") or r)
                except Exception as e:  # noqa: BLE001
                    last = str(e)
                    if self._cdp is not None and self._cdp.lost:
                        self._cdp = None
                await asyncio.sleep(0.5)
            self.cdp_heal_fail += 1
            self.cdp_error = f"heal failed after {tries} attempts: {last}"
            return False

    async def cdp_status(self) -> dict[str, Any]:
        if not self.cdp_up:
            return {"up": False, "error": self.cdp_error}
        try:
            r = await self._cdp.call({"type": "status"}, 5)  # type: ignore[union-attr]
            return {"up": True, **{k: v for k, v in r.items() if k not in ("id", "type")}, "hub_heals": self.cdp_heals, "hub_heal_fail": self.cdp_heal_fail}
        except Exception as e:  # noqa: BLE001
            return {"up": False, "error": str(e)}

    async def cdp_observe(self, **kw: Any) -> Observation:
        last: Optional[BaseException] = None
        for attempt in (1, 2):
            try:
                if not self.cdp_up and not await self.cdp_heal("observe: link down"):
                    raise IpcError(self.cdp_error or "CDP unavailable")
                assert self._cdp
                return parse_observation(await self._cdp.call({"type": "observe", "id": new_id(), **kw}, 45))
            except (IpcError, RuntimeError) as e:
                last = e
                if attempt == 2 or not HEAL_RX.search(str(e)):
                    break
                if not await self.cdp_heal(str(e)):
                    break
        self.cdp_degraded += 1
        raise RuntimeError(f"[CDP_UNRECOVERABLE] {last}")

    async def cdp_action(self, req: dict[str, Any]) -> ActionResult:
        for attempt in (1, 2):
            try:
                if not self.cdp_up and not await self.cdp_heal("action: link down"):
                    return ActionResult(ok=False, code=Code.INTERNAL, message=f"[CDP_UNRECOVERABLE] {self.cdp_error}")
                assert self._cdp
                r = parse_result(await self._cdp.call({"type": "action", "id": new_id(), **req}, 70))
            except IpcError as e:
                if attempt == 2 or not HEAL_RX.search(str(e)) or not await self.cdp_heal(str(e)):
                    return ActionResult(ok=False, code=Code.INTERNAL, message=f"IPC: {e}")
                if str(req.get("action")) in SAFE_REPLAY:
                    req = {**req, "action_id": new_id("a")}
                    continue
                return ActionResult(ok=False, code=Code.STALE_EPOCH, message="CDP 连接已自愈重连；旧元素 ref 已失效，请重新观察后再操作")
            if (not r.ok) and r.code in (Code.INTERNAL, Code.TIMEOUT) and HEAL_RX.search(r.message or "") and attempt == 1:
                if await self.cdp_heal(r.message):
                    if str(req.get("action")) in SAFE_REPLAY:
                        req = {**req, "action_id": new_id("a")}
                        continue
                    return ActionResult(ok=False, code=Code.STALE_EPOCH, message="CDP 连接已自愈重连；旧元素 ref 已失效，请重新观察后再操作")
            return r
        return ActionResult(ok=False, code=Code.INTERNAL, message="CDP action failed after heal")

    # -- resources
    def rss_report(self) -> dict[str, float]:
        out: dict[str, float] = {}
        try:
            import psutil

            out["python"] = psutil.Process(os.getpid()).memory_info().rss / 1048576
            for k, p in self.procs.items():
                if p.poll() is None:
                    out[k] = psutil.Process(p.pid).memory_info().rss / 1048576
        except Exception:
            pass
        return out

    async def close(self) -> None:
        for c in (self._cdp, self._drv):
            if c and not c.lost:
                try:
                    await c.call({"type": "shutdown"}, 2)
                except Exception:
                    pass
                c.close()
        for p in self.procs.values():
            if p.poll() is None:
                p.terminate()
