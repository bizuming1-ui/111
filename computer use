def known_folder(name: str) -> Path:
    guid = {"desktop": "B4BFCC3A-DB2C-424C-B029-7FE99A87C641", "documents": "FDD39AD0-238F-46AF-ADB4-6C85480369C7", "downloads": "374DE290-123F-4565-9164-39C4925E467B"}[name]
    if IS_WIN:
        try:
            import ctypes
            from ctypes import wintypes

            class GUID(ctypes.Structure):
                _fields_ = [("a", wintypes.DWORD), ("b", wintypes.WORD), ("c", wintypes.WORD), ("d", ctypes.c_ubyte * 8)]

            g = GUID()
            ctypes.windll.ole32.CLSIDFromString(ctypes.c_wchar_p("{" + guid + "}"), ctypes.byref(g))
            out = ctypes.c_wchar_p()
            if ctypes.windll.shell32.SHGetKnownFolderPath(ctypes.byref(g), 0, None, ctypes.byref(out)) == 0 and out.value:
                return Path(out.value)
        except Exception:  # noqa: BLE001
            pass
    return Path.home() / name.capitalize()


_COM = ("$ErrorActionPreference='Stop';$ns=(New-Object -ComObject Shell.Application).NameSpace(10);$items=@($ns.Items());"
        "$names=@($items | Select-Object -First 80 | ForEach-Object { $_.Name });[Console]::Out.WriteLine((@{count=$items.Count;names=$names} | ConvertTo-Json -Compress))")


def recycle_status() -> dict[str, Any]:
    """Two independent channels: shell32!SHQueryRecycleBinW and COM Shell.Application.NameSpace(10)."""
    if not IS_WIN:
        return {"ok": False, "reason": "not_windows"}
    import ctypes
    import shutil
    import subprocess
    from ctypes import wintypes

    class Q(ctypes.Structure):
        _fields_ = [("cb", wintypes.DWORD), ("size", ctypes.c_longlong), ("n", ctypes.c_longlong)]

    q = Q()
    q.cb = ctypes.sizeof(q)
    api = int(q.n) if ctypes.windll.shell32.SHQueryRecycleBinW(None, ctypes.byref(q)) == 0 else None
    com, names = None, []
    exe = shutil.which("powershell.exe") or shutil.which("pwsh")
    if exe:
        try:
            p = subprocess.run([exe, "-NoProfile", "-NonInteractive", "-Command", _COM], capture_output=True, timeout=25, creationflags=0x08000000)
            j = json.loads(p.stdout.decode("utf-8", "replace").strip().splitlines()[-1])
            com, names = int(j["count"]), ([j["names"]] if isinstance(j["names"], str) else list(j["names"] or []))
        except Exception:  # noqa: BLE001
            pass
    src = {k: v for k, v in (("SHQueryRecycleBinW", api), ("COM.NameSpace(10)", com)) if v is not None}
    if not src:
        return {"ok": False, "reason": "no_channel"}
    return {"ok": True, "count": max(src.values()), "consistent": len(set(src.values())) == 1, "sources": src, "names": names}


def wait_recycle_count(expected: int, timeout: float = 6.0) -> dict[str, Any]:
    import time

    end = time.time() + timeout
    while True:
        st = recycle_status()
        if (st.get("ok") and st.get("count") == expected and st.get("consistent", True)) or time.time() >= end:
            return st
        time.sleep(0.4)


def recycle_file(path: str) -> tuple[bool, str]:
    if not IS_WIN:
        return False, "requires Windows"
    import ctypes
    from ctypes import wintypes

    class OP(ctypes.Structure):
        _fields_ = [("hwnd", wintypes.HWND), ("fn", wintypes.UINT), ("src", wintypes.LPCWSTR), ("dst", wintypes.LPCWSTR), ("flags", wintypes.WORD), ("abort", wintypes.BOOL),
                    ("map", ctypes.c_void_p), ("title", wintypes.LPCWSTR)]

    buf = ctypes.create_unicode_buffer(str(Path(path).resolve()) + "\0")
    op = OP()
    op.fn, op.src, op.flags = 3, ctypes.cast(buf, wintypes.LPCWSTR), 0x40 | 0x10 | 0x4 | 0x400
    rc = ctypes.windll.shell32.SHFileOperationW(ctypes.byref(op))
    return rc == 0 and not Path(path).exists(), f"SHFileOperationW rc={rc}"


def empty_recycle_bin() -> tuple[bool, str]:
    if not IS_WIN:
        return False, "requires Windows"
    import ctypes

    hr = ctypes.windll.shell32.SHEmptyRecycleBinW(None, None, 7) & 0xFFFFFFFF
    return hr in (0, 0x8000FFFF), f"hr=0x{hr:08X}"


class Ctx(dict):
    """Template variables: Desktop/Documents/Downloads/Workspace/Sandbox/Home/CdpPort (+ anything the task setup stores)."""

    @staticmethod
    def default(sandbox: Path | None = None, cdp_port: int = 9222) -> "Ctx":
        c = Ctx(Desktop=str(known_folder("desktop")), Documents=str(known_folder("documents")), Downloads=str(known_folder("downloads")), Home=str(Path.home()),
                Workspace=str((sandbox or ROOT / "workspace")), Sandbox=str(sandbox or ROOT / "workspace"), CdpPort=str(cdp_port))
        return c


def fmt(v: Any, ctx: dict[str, Any]) -> Any:
    if isinstance(v, str):
        for k, val in ctx.items():
            v = v.replace("{" + k + "}", str(val))
        return v
    if isinstance(v, list):
        return [fmt(x, ctx) for x in v]
    if isinstance(v, dict):
        return {k: fmt(x, ctx) for k, x in v.items()}
    return v


def _read_text(p: Path) -> str:
    return p.read_bytes().decode("utf-8", "replace").lstrip("\ufeff")


def v_file_exists(s: dict, ctx: Ctx) -> tuple[bool, str]:
    p = Path(s["path"])
    ok = p.exists() and (not s.get("min_size") or p.stat().st_size >= int(s["min_size"]))
    return ok, f"{p} exists={p.exists()}"


def v_file_absent(s: dict, ctx: Ctx) -> tuple[bool, str]:
    p = Path(s["path"])
    return (not p.exists()), f"{p} exists={p.exists()}"


def v_file_contains(s: dict, ctx: Ctx) -> tuple[bool, str]:
    p = Path(s["path"])
    if not p.exists():
        return False, f"{p} missing"
    t = _read_text(p)
    ok = all(x in t for x in ([s["text"]] if "text" in s else s.get("texts", [])))
    if s.get("equals") is not None:
        ok = ok and t.strip() == str(s["equals"]).strip()
    return ok, f"{p} len={len(t)}"


def v_file_sha256(s: dict, ctx: Ctx) -> tuple[bool, str]:
    p = Path(s["path"])
    if not p.exists():
        return False, f"{p} missing"
    d = hashlib.sha256(p.read_bytes()).hexdigest()
    return d == s["sha256"].lower(), f"sha256={d[:16]}"


def v_file_unchanged(s: dict, ctx: Ctx) -> tuple[bool, str]:  # misoperation guard: protected file must keep its content hash
    return v_file_sha256(s, ctx)


