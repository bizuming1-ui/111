#=#=# FILE: sidecar-dml-v9/omniparser_v2.py
"""Quantised OmniParser V2 (ONNX) runner for sidecar-dml. Loads lazily on the DirectML EP (Radeon 780M UMA) and obeys UmaCircuitGuard.
Usage:  python omniparser_v2.py --model models/omniparser_v2_int8.onnx --selftest
The model file is NOT shipped (licence/size): export + quantise it once with `python omniparser_v2.py --export-help`."""
from __future__ import annotations
import argparse, json, sys
from uma_guard import UmaCircuitGuard

EXPORT_HELP = """1) pip install onnxruntime-directml onnx onnxruntime-extensions huggingface_hub
2) huggingface-cli download microsoft/OmniParser-v2.0 --local-dir weights
3) export icon_detect (YOLOv8) :  yolo export model=weights/icon_detect/model.pt format=onnx opset=17 imgsz=640
4) quantise :  python -m onnxruntime.quantization.preprocess --input model.onnx --output model_pre.onnx
               python -c "from onnxruntime.quantization import quantize_dynamic, QuantType; quantize_dynamic('model_pre.onnx','omniparser_v2_int8.onnx',weight_type=QuantType.QUInt8)"
"""

class OmniParserV2:
    def __init__(self, model_path: str, guard: UmaCircuitGuard | None = None, providers: list[str] | None = None):
        self.model_path, self.guard = model_path, guard or UmaCircuitGuard()
        self.providers = providers or ["DmlExecutionProvider", "CPUExecutionProvider"]
        self._sess = None

    def available(self) -> bool:
        return self.guard.check()

    def _load(self):
        import onnxruntime as ort  # lazy: absent runtime => caller falls back to cloud deepseek-flash vision, zero error
        so = ort.SessionOptions(); so.enable_mem_pattern = False; so.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL
        self._sess = ort.InferenceSession(self.model_path, so, providers=self.providers)
        self.guard.loaded = True

    def detect(self, chw_float32):
        """Returns raw detector output, or None when the circuit is open / runtime missing (caller must fall back)."""
        if not self.guard.check():
            self._sess = None
            return None
        try:
            if self._sess is None:
                self._load()
            self.guard.touch()
            name = self._sess.get_inputs()[0].name
            return self._sess.run(None, {name: chw_float32})
        except Exception:
            return None

    def tick(self):
        if self.guard.reap_idle():
            self._sess = None

if __name__ == "__main__":
    ap = argparse.ArgumentParser(); ap.add_argument("--model"); ap.add_argument("--selftest", action="store_true"); ap.add_argument("--export-help", action="store_true")
    a = ap.parse_args()
    if a.export_help: print(EXPORT_HELP); sys.exit(0)
    g = UmaCircuitGuard(); print(json.dumps({"circuit_open": not g.check(), "floor_mb": g.floor_mb, "idle_ttl_s": g.idle_ttl_s}))
#=#=# FILE: sidecar-dml-v9/uma_guard.py
"""UmaCircuitGuard (Python twin of Test-UmaMemoryHealth / Update-MemoryGuard): 4096 MB trip line, +768 MB hysteresis, 180 s idle unload."""
from __future__ import annotations
import time
from dataclasses import dataclass, field
from typing import Callable

@dataclass
class UmaCircuitGuard:
    floor_mb: int = 4096
    hysteresis_mb: int = 768
    idle_ttl_s: float = 180.0
    probe: Callable[[], int] = field(default=lambda: _avail_mb())
    clock: Callable[[], float] = time.monotonic
    tripped: bool = False
    last_used: float = 0.0
    loaded: bool = False
    unloads: int = 0

    def check(self) -> bool:
        """Returns True when the local sidecar may run. Trip below floor; recover only above floor + hysteresis."""
        a = self.probe()
        if not self.tripped and a < self.floor_mb:
            self.tripped = True
        elif self.tripped and a >= self.floor_mb + self.hysteresis_mb:
            self.tripped = False
        if self.tripped and self.loaded:
            self.unload()
        return not self.tripped

    def touch(self) -> None:
        self.last_used = self.clock()

    def reap_idle(self) -> bool:
        if self.loaded and self.clock() - self.last_used >= self.idle_ttl_s:
            self.unload()
            return True
        return False

    def unload(self) -> None:
        self.loaded = False
        self.unloads += 1

def _avail_mb() -> int:
    try:
        import ctypes
        class MS(ctypes.Structure):
