SHIFT_SYMBOLS = {
    "!": "1", "@": "2", "#": "3", "$": "4", "%": "5", "^": "6", "&": "7", "*": "8", "(": "9", ")": "0",
    "_": "-", "+": "=", "{": "[", "}": "]", "|": "\\", ":": ";", '"': "'", "<": ",", ">": ".", "?": "/", "~": "`",
}
ALIASES = {
    "hash": "#", "pound": "#", "sharp": "#", "exclam": "!", "bang": "!", "at": "@", "dollar": "$", "percent": "%",
    "caret": "^", "ampersand": "&", "asterisk": "*", "star": "*", "lparen": "(", "rparen": ")", "underscore": "_",
    "plus": "+", "pipe": "|", "colon": ":", "dquote": '"', "less": "<", "greater": ">", "question": "?", "tilde": "~",
    "minus": "-", "dash": "-", "equals": "=", "equal": "=", "comma": ",", "period": ".", "dot": ".", "slash": "/",
    "backslash": "\\", "semicolon": ";", "quote": "'", "apostrophe": "'", "backtick": "`", "grave": "`",
    "lbracket": "[", "rbracket": "]", "pgup": "pageup", "pgdn": "pagedown", "pgdown": "pagedown", "spacebar": "space",
    "ctl": "ctrl", "control": "ctrl", "option": "alt", "cmd": "win", "windows": "win", "super": "win",
    "return": "enter", "escape": "esc", "del": "delete", "ins": "insert", "caps": "capslock",
}
MODIFIERS = {"ctrl", "alt", "shift", "win"}
NAMED = {"enter", "tab", "esc", "space", "backspace", "delete", "insert", "up", "down", "left", "right", "home",
         "end", "pageup", "pagedown", "apps", "printscreen", "capslock"}


def _split_chord(chord: str) -> list[str]:
    chord = chord.strip()
    if chord in ("+", "plus"):
        return ["+"]
    parts, buf = [], ""
    i = 0
    while i < len(chord):
        ch = chord[i]
        if ch == "+":
            if buf == "":                      # "ctrl++": the second '+' is the key itself
                parts.append("+")
            else:
                parts.append(buf)
                buf = ""
        else:
            buf += ch
        i += 1
    if buf:
        parts.append(buf)
    return parts


def resolve_key_chord(seq: str) -> str:
    """Normalise a whitespace-separated key sequence; raises ValueError on unknown keys."""
    out = []
    for chord in seq.strip().split():
        mods: list[str] = []
        keys: list[str] = []
        for raw in _split_chord(chord):
            tok = raw if len(raw) == 1 else raw.lower()
            tok = ALIASES.get(tok, tok) if len(tok) > 1 else tok
            if len(tok) == 1 and tok in SHIFT_SYMBOLS:
                if "shift" not in mods:
                    mods.append("shift")
                keys.append(SHIFT_SYMBOLS[tok])
            elif isinstance(tok, str) and tok.lower() in MODIFIERS:
                if tok.lower() not in mods:
                    mods.append(tok.lower())
            elif len(tok) == 1 and (tok.isalnum() or tok in "-=[];',./\\`"):
                keys.append(tok.lower())
            elif tok.lower() in NAMED or re.fullmatch(r"f([1-9]|1\d|2[0-4])", tok.lower()) \
